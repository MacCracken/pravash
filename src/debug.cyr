# Appends Rust's Debug of a non-Newtonian model: its variant as a struct of the variant's fields (`PowerLaw {
# consistency: .., power_index: .. }`), or `Unknown` for a kind outside the enum. 0, or -1 when the builder can't
# grow. Mirrors the derived `Debug`.
#must_use
fn non_newtonian_viscosity_debug(m: *PvNonNewtonianModel, sb, alternate): i64 {
    match m.kind {
        PV_NON_NEWTONIAN_VISCOSITY_POWER_LAW => {
            var rc = _pv_dd_open(sb, "PowerLaw", alternate);
            rc = rc | _pv_dd_ff(sb, "consistency", m.consistency, alternate, 0, 1);
            rc = rc | _pv_dd_ff(sb, "power_index", m.power_index, alternate, 0, 0);
            return rc | _pv_dd_close(sb, alternate, 0);
        }
        PV_NON_NEWTONIAN_VISCOSITY_BINGHAM => {
            var rc = _pv_dd_open(sb, "Bingham", alternate);
            rc = rc | _pv_dd_ff(sb, "yield_stress", m.yield_stress, alternate, 0, 1);
            rc = rc | _pv_dd_ff(sb, "plastic_viscosity", m.plastic_viscosity, alternate, 0, 0);
            return rc | _pv_dd_close(sb, alternate, 0);
        }
        PV_NON_NEWTONIAN_VISCOSITY_HERSCHEL_BULKLEY => {
            var rc = _pv_dd_open(sb, "HerschelBulkley", alternate);
            rc = rc | _pv_dd_ff(sb, "yield_stress", m.yield_stress, alternate, 0, 1);
            rc = rc | _pv_dd_ff(sb, "consistency", m.consistency, alternate, 0, 0);
            rc = rc | _pv_dd_ff(sb, "power_index", m.power_index, alternate, 0, 0);
            return rc | _pv_dd_close(sb, alternate, 0);
        }
        _ => { return _pv_jw(sb, "Unknown"); }
    }
    return 0;
}

# The Rust variant name of a secondary particle's kind (`"Foam"`), or "Unknown".
#must_use
fn _pv_secondary_type_name(k): i64 {
    match k {
        PV_SECONDARY_TYPE_FOAM => { return "Foam"; }
        PV_SECONDARY_TYPE_SPRAY => { return "Spray"; }
        PV_SECONDARY_TYPE_BUBBLE => { return "Bubble"; }
        _ => { return "Unknown"; }
    }
    return "Unknown";
}

# Appends Rust's Debug of a secondary particle's kind: the variant's name, in both forms. 0, or -1 when the builder
# can't grow. Mirrors the derived `Debug`.
#must_use
fn secondary_type_debug(k, sb, alternate): i64 {
    return _pv_jw(sb, _pv_secondary_type_name(k));
}

impl PvSecondaryParticle {
    # Appends Rust's `{:?}` (alternate 0) or `{:#?}` (1). 0, or -1 when the builder can't grow. Mirrors the derived
    # `Debug`.
    #must_use
    fn debug(self, sb, alternate): i64 {
        var rc = _pv_dd_open(sb, "SecondaryParticle", alternate);
        rc = rc | _pv_dd_vf(sb, "position", self.position, alternate, 0, 1);
        rc = rc | _pv_dd_vf(sb, "velocity", self.velocity, alternate, 0, 0);
        rc = rc | _pv_dd_ff(sb, "lifetime", self.lifetime, alternate, 0, 0);
        rc = rc | _pv_dd_tf(sb, "kind", _pv_secondary_type_name(self.kind), alternate, 0, 0);
        return rc | _pv_dd_close(sb, alternate, 0);
    }
}

# ── coupling, mpm ───────────────────────────────────────────────────────────────────

# A body shape at depth.
#must_use
fn _pv_dd_shape(s: *PvShape, sb, alt, depth): i64 {
    if (s.kind == PV_BODY_SHAPE_SPHERE) {
        var rc = _pv_dd_open(sb, "Sphere", alt);
        rc = rc | _pv_dd_ff(sb, "radius", s.radius, alt, depth, 1);
        return rc | _pv_dd_close(sb, alt, depth);
    }
    if (s.kind == PV_BODY_SHAPE_BOX) {
        var h[24];
        store64(&h, _pv_bits(s.half_extents.0));
        store64(&h + 8, _pv_bits(s.half_extents.1));
        store64(&h + 16, _pv_bits(s.half_extents.2));
        var rc = _pv_dd_open(sb, "Box", alt);
        rc = rc | _pv_dd_af(sb, "half_extents", &h, 3, alt, depth, 1);
        return rc | _pv_dd_close(sb, alt, depth);
    }
    return _pv_jw(sb, "Unknown");
}

# Appends Rust's Debug of a body shape: `Sphere { radius: .. }` or `Box { half_extents: [..] }`, or `Unknown` for a
# kind outside the enum. 0, or -1 when the builder can't grow. Mirrors the derived `Debug`.
#must_use
fn body_shape_debug(s: *PvShape, sb, alternate): i64 {
    return _pv_dd_shape(s, sb, alternate, 0);
}

impl PvRigidBody {
    # Appends Rust's `{:?}` (alternate 0) or `{:#?}` (1). 0, or -1 when the builder can't grow. Mirrors the derived
    # `Debug`.
    #must_use
    fn debug(self, sb, alternate): i64 {
        var shape: PvShape = self.shape;
        var rc = _pv_dd_open(sb, "RigidBody", alternate);
        rc = rc | _pv_dd_vf(sb, "position", self.position, alternate, 0, 1);
        rc = rc | _pv_dd_vf(sb, "velocity", self.velocity, alternate, 0, 0);
        rc = rc | _pv_dd_ff(sb, "mass", self.mass, alternate, 0, 0);
        rc = rc | _pv_dd_field(sb, "shape", alternate, 0, 0);
        rc = rc | _pv_dd_shape(&shape, sb, alternate, 1);
        rc = rc | _pv_dd_end(sb, alternate);
        rc = rc | _pv_dd_vf(sb, "force", self.force, alternate, 0, 0);
        return rc | _pv_dd_close(sb, alternate, 0);
    }
}

# A constitutive model at depth.
#must_use
fn _pv_dd_law(m: *PvConstitutiveLaw, sb, alt, depth): i64 {
    match m.kind {
        PV_CONSTITUTIVE_MODEL_FLUID => {
            var rc = _pv_dd_open(sb, "Fluid", alt);
            rc = rc | _pv_dd_ff(sb, "bulk_modulus", m.bulk_modulus, alt, depth, 1);
            rc = rc | _pv_dd_ff(sb, "viscosity", m.viscosity, alt, depth, 0);
            return rc | _pv_dd_close(sb, alt, depth);
        }
        PV_CONSTITUTIVE_MODEL_NEO_HOOKEAN => {
            var rc = _pv_dd_open(sb, "NeoHookean", alt);
            rc = rc | _pv_dd_ff(sb, "youngs_modulus", m.youngs_modulus, alt, depth, 1);
            rc = rc | _pv_dd_ff(sb, "poisson_ratio", m.poisson_ratio, alt, depth, 0);
            return rc | _pv_dd_close(sb, alt, depth);
        }
        PV_CONSTITUTIVE_MODEL_DRUCKER_PRAGER => {
            var rc = _pv_dd_open(sb, "DruckerPrager", alt);
            rc = rc | _pv_dd_ff(sb, "youngs_modulus", m.youngs_modulus, alt, depth, 1);
            rc = rc | _pv_dd_ff(sb, "poisson_ratio", m.poisson_ratio, alt, depth, 0);
            rc = rc | _pv_dd_ff(sb, "friction_angle", m.friction_angle, alt, depth, 0);
            return rc | _pv_dd_close(sb, alt, depth);
        }
        _ => { return _pv_jw(sb, "Unknown"); }
    }
    return 0;
}

# Appends Rust's Debug of a constitutive model: its variant as a struct of the variant's fields, or `Unknown` for a
# kind outside the enum. 0, or -1 when the builder can't grow. Mirrors the derived `Debug`.
#must_use
fn constitutive_model_debug(m: *PvConstitutiveLaw, sb, alternate): i64 {
    return _pv_dd_law(m, sb, alternate, 0);
}

impl PvMpmParticle {
    # Appends Rust's `{:?}` (alternate 0) or `{:#?}` (1): the deformation gradient as Rust's `[f64; 4]`, row-major.
    # 0, or -1 when the builder can't grow. Mirrors the derived `Debug`.
    #must_use
    fn debug(self, sb, alternate): i64 {
        var g[32];
        store64(&g, _pv_bits(self.deformation_grad.m00));
        store64(&g + 8, _pv_bits(self.deformation_grad.m01));
        store64(&g + 16, _pv_bits(self.deformation_grad.m10));
        store64(&g + 24, _pv_bits(self.deformation_grad.m11));
        var law: PvConstitutiveLaw = self.model;
        var rc = _pv_dd_open(sb, "MpmParticle", alternate);
        rc = rc | _pv_dd_af(sb, "deformation_grad", &g, 4, alternate, 0, 1);
        rc = rc | _pv_dd_field(sb, "model", alternate, 0, 0);
        rc = rc | _pv_dd_law(&law, sb, alternate, 1);
        rc = rc | _pv_dd_end(sb, alternate);
        rc = rc | _pv_dd_ff(sb, "volume_0", self.volume_0, alternate, 0, 0);
        return rc | _pv_dd_close(sb, alternate, 0);
    }
}

