        rc = rc | _pv_dd_f32f(sb, "buoyancy_alpha", self.buoyancy_alpha, alternate, 0, 0);
        rc = rc | _pv_dd_f32f(sb, "ambient_density", self.ambient_density, alternate, 0, 0);
        return rc | _pv_dd_close(sb, alternate, 0);
    }
}

