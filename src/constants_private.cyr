# ── Rust 1.3.0's src/sph.rs ──

# Minimum density floor to prevent division-by-zero in pressure/force calculations.
# Rust: `MIN_DENSITY: f64 = 1e-10`
var _PV_SPH_MIN_DENSITY: f64 = 0.0000000001;

# Colour-field normal magnitude, in units of `1/h`, below which a particle
# is treated as interior (no surface tension).
# Rust: `CSF_NORMAL_THRESHOLD: f64 = 0.1`
var _PV_SPH_CSF_NORMAL_THRESHOLD: f64 = 0.1;

# FALLBACK is not carried: the `PhaseProperties` literal local to `MultiPhaseConfig::get`, written in place.

# Rust: `CONVERGENCE_THRESHOLD: f64 = 1e-8`
var _PV_SPH_CONVERGENCE_THRESHOLD: f64 = 0.00000001;

# ── Rust 1.3.0's src/coupling.rs ──

