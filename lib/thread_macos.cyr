# thread_macos.cyr — macOS (Darwin) threading: REAL threads and a blocking channel on BOTH
# Mach-O targets (arm64 since v6.5.44, x86 since 6.6.19).
# Usage: included by lib/thread.cyr under #ifdef CYRIUS_TARGET_MACOS.
# Includes its own definers: fnptr.cyr, thread_local.cyr, mmap.cyr, atomic.cyr, sync.cyr.
#
# Darwin has no `clone(2)` and no futex. The two Mach-O writers produce structurally different
# binaries, so the THREAD START differs by arch while everything after it is shared:
#   arm64  EMITMACHO_ARM64 -> a dyld/LC_MAIN PIE linking libSystem. libpthread's initializer has
#          already spent the one-shot `bsdthread_register` (a raw register returns EINVAL there,
#          measured on ecb), so threads start through libSystem `pthread_create` (__got[5]).
#   x86    EMITMACHO_EXEC -> a static MH_NOUNDEFS/LC_UNIXTHREAD binary: no dyld, no libSystem,
#          no __got, so `pthread_create` is unreachable — and `bsdthread_register` is unspent.
#          Threads start through the raw `bsdthread_register` / `bsdthread_create` /
#          `bsdthread_terminate` routes (v6.5.43), with per-thread TLS in the gs base
#          (lib/thread_local.cyr). 6.6.19; before it x86 macOS ran every body INLINE.
# Shared by both: the control block's done word, `thread_join` parked on __ulock, and the
# locked, __ulock-parked channel below. Hence THREADS_CONCURRENT = CHAN_BLOCKING = 1 on both
# arches, and lib/thread.cyr's Linux contract holds here unchanged.
#
# The public surface MUST match lib/thread.cyr's so consumers stay target-agnostic:
# thread_create / thread_join / thread_create_detached / thread_is_done / gettid /
# chan_new / chan_send / chan_try_send / chan_recv / chan_try_recv / chan_close.
# History (the v6.5.11 serial fallback, the MAP_ANONYMOUS accident that masked a missing
# backend, the 6.6.16 channel repair): CHANGELOG [6.5.11] [6.5.44] [6.6.16] [6.6.19].
#
# The whole file is guarded by CYRIUS_TARGET_MACOS: it calls Darwin-only wrappers (bsdthread,
# __ulock), so on any other target it defines nothing rather than compiling to undefined calls
# (stdlib_modules_self_sufficient.sh includes every module alone on every target).
#ifdef CYRIUS_TARGET_MACOS
include "lib/fnptr.cyr"
# thread_local.cyr supplies thread_local_get/set, _TLOCAL_MAX_SLOTS (128) and the per-thread slot
# machinery each arm binds below (_tls_bind on arm64, _tls_gs_install on x86).
include "lib/thread_local.cyr"
# The x86 thread stack is a raw mmap with a PROT_NONE guard page (MAP_* / PROT_* / cyr_mprotect).
include "lib/mmap.cyr"
# atomic_fence / atomic_store publish the done word; the shared-heap flag lives there too.
include "lib/atomic.cyr"
# The channel's lock is lib/sync.cyr's macOS arm (lib/sync_macos.cyr, a __ulock lock).
include "lib/sync.cyr"

# THREADS_CONCURRENT: does thread_create produce a SECOND thread? (1 = concurrent with the
# caller; 0 = the body runs INLINE at create, on a serial peer.) CHAN_BLOCKING: is the channel the
# locked, parking ring of lib/thread.cyr's header? Both are 1 on both Mach-O arches since 6.6.19;
# a test that discriminates guards on these, never on a target name (the v6.5.36 lesson).
var THREADS_CONCURRENT = 1;
var CHAN_BLOCKING = 1;

#ifdef CYRIUS_ARCH_AARCH64
# ── arm64: libSystem pthread_create (v6.5.44) ──
# No trampoline is needed: a Darwin start routine is `void *(*)(void *)`, which is exactly the
# shape of a cyrius `fn body(arg): i64` — arg 1 in x0, result in x0, stock AAPCS64 prologue.

# Control block, 40 B: +0 done · +8 fp · +16 arg · +24 pthread_t · +32 the thread's TLS registry
# entry (lib/thread_local.cyr's _tls_claim).
# The HANDLE a caller holds IS this pointer, so `thread_is_done` reads +0 directly.
var _THR_CTL = 40;

# Thread entry. Runs on the new thread; `ctl` arrives in x0 as arg 1.
#
# ⚠ THE KEY IS BOUND BEFORE THE BODY RUNS: until then this thread's lookups find no entry.
# ⚠ THE WAKE MUST FOLLOW THE STORE, AND THE FENCE MUST PRECEDE IT. A joiner parks on the
# done word; publishing it after the wake would lose the wakeup permanently.
fn _thr_entry(ctl): i64 {
    var ent = load64(ctl + 32);
    _tls_bind(ent);
    fncall1(load64(ctl + 8), load64(ctl + 16));
    _tls_unbind(ent);
    atomic_fence();                 # release: the body's writes happen-before done=1
    atomic_store(ctl, 1);
    sys_ulock_wake(0x101, ctl, 0);  # UL_COMPARE_AND_WAIT | ULF_WAKE_ALL — wake every joiner
    return 0;
}

# Spawn. Returns the control block as an opaque handle, or 0 on failure.
#
# ⚠ NO TLS SNAPSHOT HERE, and its absence is the fix rather than an omission. A serial peer
# emulates isolation by saving/zeroing/restoring the caller's 128 slots around an INLINE call.
# With a real thread that is not merely unnecessary, it is a race on the caller's own slots.
# Isolation comes from a genuinely separate per-thread block (lib/thread_local.cyr).
# ⛔ The registry entry is claimed HERE, before the thread exists. If none can be had (every
# entry is held and no chunk can be allocated), the thread is refused (0). It never starts on
# another thread's slots, as a thread past the 64th live one did until 6.7.18. CHANGELOG [6.7.18]
fn thread_create(fp, arg): i64 {
    alloc_init();
    _threads_active = 1;            # arm the shared-heap lock BEFORE the thread can run
    var ctl = alloc(_THR_CTL);
    if (ctl == 0) { return 0; }
    var blk = alloc(_TLOCAL_MAX_SLOTS * 8);      # the const, as every slot store (6.7.9)
    if (blk == 0) { return 0; }
    var i = 0;
    while (i < _TLOCAL_MAX_SLOTS) {  # a fresh thread must see zeroed slots
        store64(blk + i * 8, 0);
        i = i + 1;
    }
    # The first thread_create runs while its caller is the only thread, so that caller is main.
    # A plain store: the new thread reads it after pthread_create, and no other thread exists yet.
    if (_tls_main == 0) { _tls_main = _thr_self(); }
    var ent = _tls_claim(blk);
    if (ent == 0) { return 0; }
    store64(ctl, 0);                # done
    store64(ctl + 8, fp);
    store64(ctl + 16, arg);
    store64(ctl + 24, 0);           # pthread_t out
    store64(ctl + 32, ent);
    atomic_fence();
    # pthread_create(&pthread_t, attr=NULL, _thr_entry, ctl) via __got[5]. 1700 is the
    # libSystem-routine sub-band (see src/frontend/parse/expr/factor.cyr) — NOT a BSD syscall number.
    var rc = syscall(1700, ctl + 24, 0, &_thr_entry, ctl);
    if (rc != 0) {
        _tls_unbind(ent);
        return 0;
    }
    return ctl;
}

# Current thread id. TPIDRRO_EL0 is thread-unique and non-zero on every Darwin thread — an
# identity, not a Mach port or a BSD tid, which is all the "distinct per thread" contract asks.
fn gettid(): i64 { return _thr_self(); }
#endif

#ifndef CYRIUS_ARCH_AARCH64
# ── x86: raw bsdthread, no libSystem (6.6.19) ──
# Measured on ach (Intel, macOS 13.7.8) from static cyrius x86 Mach-O probes; each point is
# load-bearing below:
#   1. bsdthread_register SUCCEEDS WITH POSITIVE FEATURE BITS (0x400001DF), not 0, so success is
#      `r >= 0`. It is ONE-SHOT per process and the registration is INHERITED ACROSS FORK: a
#      second register — in the same process or in a fork child — answers -EINVAL (-22), and
#      the child's bsdthread_create works without one. So -22 also means "ours, already done".
#      (Nothing else in lib/ registers; the x86 Mach-O writer links no libSystem that could.)
#   2. With PTHREAD_START_CUSTOM (0x01000000) the kernel uses OUR stack and returns the
#      `pthread` value it was given — here the control block, so success is `rc == ctl`.
#   3. The new thread enters the REGISTERED trampoline with rdi = pthread, rsi = mach port,
#      rdx = func, rcx = func_arg, r8 = stack, r9 = flags and rsp = stack — exactly cyrius x86's
#      SysV parameter spill order, so `_thr_start` below receives all six as plain params.
#   4. bsdthread_terminate(stackaddr, size, port, 0) unmaps the thread's OWN stack from inside
#      the kernel and never returns (a read of the stack after join faults). Join therefore
#      never munmaps, and a detached thread strands nothing but its 48-byte control block.
#   5. gs-base TLS set through machdep call 3 survives preemption (lib/thread_local.cyr).

# Control block, 48 B: +0 done · +8 fp · +16 arg · +24 map base · +32 map size · +40 TLS header.
# The HANDLE a caller holds IS this pointer, as on arm64, so join / is_done are shared below.
var _THR_CTL = 48;
var _THR_STACK = 2097152;            # lib/thread.cyr THREAD_STACK_SIZE parity (2 MiB)
var _THR_GUARD = 4096;               # one PROT_NONE page below the stack (the thread guard-page hardening item parity)
const _THR_HDR = ((_TLOCAL_MAX_SLOTS + 1) * 8 + 15) / 16 * 16;   # TLS header: word 0 + the slots, 16-rounded
var _thr_registered = 0;

# The registered trampoline. Runs on the new thread, on our stack, with no return address
# above it — so it must never return: bsdthread_terminate ends it.
#
# ⚠ THE gs INSTALL COMES FIRST: until it runs, this thread has no slot base.
# ⚠ THE WAKE MUST FOLLOW THE STORE, AND THE FENCE MUST PRECEDE IT (as on arm64).
# ⚠ base / size are read into locals BEFORE done = 1: they live in the control block, which the
#   joiner owns again once it sees done.
fn _thr_start(pth, port, func, ctl, stk, flags): i64 {
    _tls_gs_install(load64(ctl + 40));
    fncall1(func, load64(ctl + 16));
    var base = load64(ctl + 24);
    var size = load64(ctl + 32);
    atomic_fence();                 # release: the body's writes happen-before done=1
    atomic_store(ctl, 1);
    sys_ulock_wake(0x101, ctl, 0);  # UL_COMPARE_AND_WAIT | ULF_WAKE_ALL — wake every joiner
    while (1 == 1) {                # does not return on success; never fall off the stack top
        sys_bsdthread_terminate(base, size, port, 0);
    }
    return 0;
}

# Register `_thr_start` as this process's thread trampoline, once.
fn _thr_register(): i64 {
    if (_thr_registered == 1) { return 0; }
    var r = sys_bsdthread_register(&_thr_start, 0, 0, 0, 0, 0);
    if (r < 0) {
        if (r != 0 - 22) { return r; }   # -EINVAL = already registered (inherited across fork)
    }
    _thr_registered = 1;
    return 0;
}

# Spawn. Returns the control block as an opaque handle, or 0 on failure.
# The TLS header is carved from the TOP of the thread's own mapping (fresh anonymous pages read
# zero, so its slots start zeroed), and the stack grows down from just below it — so
# bsdthread_terminate's one unmap releases the stack and the slots together.
fn thread_create(fp, arg): i64 {
    alloc_init();
    if (_thr_register() < 0) { return 0; }
    if (_tls_gs_main() < 0) { return 0; }
    _threads_active = 1;            # arm the shared-heap lock BEFORE the thread can run
    var ctl = alloc(_THR_CTL);
    if (ctl == 0) { return 0; }
    var msize = _THR_STACK + _THR_GUARD;
    var base = syscall(SYS_MMAP, 0, msize, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, 0 - 1, 0);
    if (base < 0) { return 0; }
    cyr_mprotect(base, _THR_GUARD, PROT_NONE);
    var hdr = base + msize - _THR_HDR;
    store64(hdr, hdr + 8);          # word 0 = this thread's slot base
    store64(ctl, 0);                # done
    store64(ctl + 8, fp);
    store64(ctl + 16, arg);
    store64(ctl + 24, base);
    store64(ctl + 32, msize);
    store64(ctl + 40, hdr);
    atomic_fence();
    # rsp at entry = hdr - 8: 16-aligned less 8, i.e. exactly what a `call` leaves.
    var rc = sys_bsdthread_create(fp, ctl, hdr - 8, ctl, 0x01000000);
    if (rc != ctl) {
        syscall(SYS_MUNMAP, base, msize);
        return 0;
    }
    return ctl;
}

# Current thread id: SYS_GETTID (186), routed to Darwin's thread_selfid — distinct per thread.
fn gettid(): i64 { return syscall(SYS_GETTID); }
#endif

# ── Shared by both arches: the handle IS the control block, +0 its done word. ──

# Block until the thread finishes. -1 on a null handle, 0 on success.
#
# ⚠ ONE LOAD PER ITERATION, and it is the loop condition. Darwin has no CLONE_CHILD_CLEARTID,
# so the done word is published by the thread itself. Between the test and the park the thread
# may finish — __ulock then sees a value MISMATCH and returns immediately (0, not -EAGAIN), the
# loop re-tests and exits. That is why there is no lost-wakeup window.
# ⚠ A negative return is NOT fatal: __ulock_wait yields EFAULT/EINTR transiently under memory
# pressure and libpthread itself retries. The predicate is the word, not the return code.
fn thread_join(t): i64 {
    if (t == 0) { return 0 - 1; }
    while (load64(t) == 0) {
        sys_ulock_wait(1, t, 0, 0);   # park while the low 32 bits are still 0; 0 = forever
    }
    return 0;
}

# Detached spawn — 1 on success, 0 on failure. The control block is the only thing stranded:
# on x86 the thread's terminate frees its stack and TLS slots; on arm64 the pthread is created
# JOINABLE and never joined, so libpthread also retains its stack until exit (making it truly
# detached needs `_pthread_detach` bound into __got — not done yet).
fn thread_create_detached(fp, arg): i64 {
    if (thread_create(fp, arg) == 0) { return 0; }
    return 1;
}

# Completion test. -1 on a null handle, else 0/1.
# ⛔ VALID ONLY BEFORE `thread_join` — join consumes the handle (contract shared with
# lib/thread.cyr).
fn thread_is_done(t): i64 {
    if (t == 0) { return 0 - 1; }
    if (load64(t) == 0) { return 0; }
    return 1;
}

# ======================================================================
# Channel. The same 56-byte header as every backend:
#   { buf@0, cap@8, head@16, tail@24, count@32, mutex@40, closed@48 }
#
# The BLOCKING channel on both arches, because threads are real on both (THREADS_CONCURRENT = 1):
# arm64 since 6.6.16, x86 since 6.6.19 (which deleted the x86 serial ring with its inline bodies).
# ⛔ Through 6.6.15 arm64 kept the serial ring under real pthreads: no lock, a chan_recv
# that answered 0 when empty, and a chan_send that failed when full. A pool of workers looping
# on chan_recv read that 0 as "closed" and exited at once, so sandhi's pooled servers bound,
# listened and accepted on macOS but never served a request; and the ring's head, tail and
# count were updated by several threads with no lock (issue
# 2026-10-04-sandhi-macos-chan-serial-under-real-threads).
# Now the ring is locked (mutex@40 is lib/sync_macos.cyr's __ulock lock), and its waiters park on
# __ulock with the SAME eventcount that lib/thread.cyr runs over futex. Read that block for the
# protocol and for why it loses no wake-up. `buf` holds the cap slots, then the 32-byte wait
# block { rseq@0, sseq@8, rwait@16, swait@24 }.
# Where __ulock differs from futex (lib/sync_macos.cyr's notes, measured on ecb and ach):
#   - the argument order is (operation, addr, value, timeout_us);
#   - a value mismatch returns 0 at once (not -EAGAIN), and EINTR / EFAULT can come back
#     spuriously; the loop re-tests under the lock either way, so the return is ignored;
#   - a wake with nobody parked returns -ENOENT, the normal race outcome, also ignored;
#   - UL_COMPARE_AND_WAIT (1) compares the LOW 32 BITS, so the seq words wrap at 32 bits.
# CHANGELOG [6.6.16] [6.6.19]
# ======================================================================

# The wait block sits after the ring's cap slots.
fn _chan_wb(ch): i64 { return load64(ch) + load64(ch + 8) * 8; }

# Under the lock: register to park on the seq word at wb + seqoff, counted at wb + cntoff.
# Returns the seq value to park on.
fn _chan_enlist(wb, seqoff, cntoff): i64 {
    store64(wb + cntoff, load64(wb + cntoff) + 1);
    return load64(wb + seqoff);
}

# Under the lock, on re-locking after a park: drop that registration.
fn _chan_delist(wb, cntoff): i64 {
    store64(wb + cntoff, load64(wb + cntoff) - 1);
    return 0;
}

# Under the lock: if anyone is registered at wb + cntoff, advance their seq word and return 1
# (a wake is owed once the lock is dropped); otherwise return 0, and no syscall follows.
fn _chan_signal(wb, seqoff, cntoff): i64 {
    if (load64(wb + cntoff) == 0) { return 0; }
    store64(wb + seqoff, (load64(wb + seqoff) + 1) & 0xFFFFFFFF);
    return 1;
}

# Park on `word` while its low 32 bits still hold `seq`. UL_COMPARE_AND_WAIT, no timeout.
fn _chan_park(word, seq): i64 {
    sys_ulock_wait(1, word, seq, 0);
    return 0;
}

# Wake one thread parked on `word`, or every one when n > 1 (ULF_WAKE_ALL = 0x100).
fn _chan_wake(word, n): i64 {
    if (n > 1) { sys_ulock_wake(0x101, word, 0); return 0; }
    sys_ulock_wake(1, word, 0);
    return 0;
}

# Under the lock: append val. The caller checked count < cap.
fn _chan_put(ch, val): i64 {
    var cap = load64(ch + 8);
    var tail = load64(ch + 24);
    store64(load64(ch) + tail * 8, val);
    store64(ch + 24, (tail + 1) % cap);
    store64(ch + 32, load64(ch + 32) + 1);
    return 0;
}

# Under the lock: remove and return the oldest value. The caller checked count > 0.
fn _chan_take(ch): i64 {
    var cap = load64(ch + 8);
    var head = load64(ch + 16);
    var v = load64(load64(ch) + head * 8);
    store64(ch + 16, (head + 1) % cap);
    store64(ch + 32, load64(ch + 32) - 1);
    return v;
}

fn _chan_new_rt(cap): i64 {
    var ch = alloc(56);
    if (ch == 0) { return 0; }
    var buf = alloc(cap * 8 + 32);
    if (buf == 0) { return 0; }
    var mtx = mutex_new();
    if (mtx == 0) { return 0; }
    store64(ch, buf);          # buf
    store64(ch + 8, cap);      # cap
    store64(ch + 16, 0);       # head
    store64(ch + 24, 0);       # tail
    store64(ch + 32, 0);       # count
    store64(ch + 40, mtx);     # mutex (lib/sync_macos.cyr)
    store64(ch + 48, 0);       # closed
    var wb = buf + cap * 8;
    store64(wb, 0);            # rseq
    store64(wb + 8, 0);        # sseq
    store64(wb + 16, 0);       # rwait
    store64(wb + 24, 0);       # swait
    return ch;
}

fn _chan_send_rt(ch, val): i64 {
    var mtx = load64(ch + 40);
    var wb = _chan_wb(ch);
    var waited = 0;
    while (1 == 1) {
        mutex_lock(mtx);
        if (waited == 1) { _chan_delist(wb, 24); waited = 0; }
        if (load64(ch + 48) != 0) { mutex_unlock(mtx); return 0 - 1; }
        if (load64(ch + 32) < load64(ch + 8)) {
            _chan_put(ch, val);
            var w = _chan_signal(wb, 0, 16);    # a receiver registered on rseq?
            mutex_unlock(mtx);
            if (w == 1) { _chan_wake(wb, 1); }
            return 0;
        }
        var seq = _chan_enlist(wb, 8, 24);     # full: register on sseq / swait
        waited = 1;
        mutex_unlock(mtx);
        _chan_park(wb + 8, seq);
    }
    return 0;
}

fn _chan_try_send_rt(ch, val): i64 {
    var mtx = load64(ch + 40);
    var wb = _chan_wb(ch);
    mutex_lock(mtx);
    if (load64(ch + 48) != 0) { mutex_unlock(mtx); return 0 - 1; }
    if (load64(ch + 32) >= load64(ch + 8)) { mutex_unlock(mtx); return 0 - 2; }
    _chan_put(ch, val);
    var w = _chan_signal(wb, 0, 16);
    mutex_unlock(mtx);
    if (w == 1) { _chan_wake(wb, 1); }
    return 0;
}

fn _chan_recv_rt(ch): i64 {
    var mtx = load64(ch + 40);
    var wb = _chan_wb(ch);
    var waited = 0;
    while (1 == 1) {
        mutex_lock(mtx);
        if (waited == 1) { _chan_delist(wb, 16); waited = 0; }
        if (load64(ch + 32) > 0) {
            var v = _chan_take(ch);
            var w = _chan_signal(wb, 8, 24);    # a sender registered on sseq?
            mutex_unlock(mtx);
            if (w == 1) { _chan_wake(wb + 8, 1); }
            return v;
        }
        if (load64(ch + 48) != 0) { mutex_unlock(mtx); return 0; }
        var seq = _chan_enlist(wb, 0, 16);     # empty and open: register on rseq / rwait
        waited = 1;
        mutex_unlock(mtx);
        _chan_park(wb, seq);
    }
    return 0;
}

fn _chan_try_recv_rt(ch): i64 {
    var mtx = load64(ch + 40);
    var wb = _chan_wb(ch);
    mutex_lock(mtx);
    if (load64(ch + 32) == 0) { mutex_unlock(mtx); return 0; }
    var v = _chan_take(ch);
    var w = _chan_signal(wb, 8, 24);
    mutex_unlock(mtx);
    if (w == 1) { _chan_wake(wb + 8, 1); }
    return v;
}

fn _chan_close_rt(ch): i64 {
    var mtx = load64(ch + 40);
    var wb = _chan_wb(ch);
    mutex_lock(mtx);
    store64(ch + 48, 1);
    var wr = _chan_signal(wb, 0, 16);
    var ws = _chan_signal(wb, 8, 24);
    mutex_unlock(mtx);
    if (wr == 1) { _chan_wake(wb, 2); }        # every receiver
    if (ws == 1) { _chan_wake(wb + 8, 2); }    # every sender
    return 0;
}

# Create a channel with capacity `cap`; 0 if an allocation fails.
fn chan_new(cap): i64 {
    alloc_init();
    return _chan_new_rt(cap);
}
# Blocks while full; 0, or -1 once closed (lib/thread.cyr's contract).
fn chan_send(ch, val): i64 { return _chan_send_rt(ch, val); }
# Non-blocking send. Contract is IDENTICAL on all backends:
#    0 → enqueued · -1 → closed · -2 → full
fn chan_try_send(ch, val): i64 { return _chan_try_send_rt(ch, val); }
# Dequeue the oldest value (FIFO), or 0 if empty. Never blocks.
fn chan_try_recv(ch): i64 { return _chan_try_recv_rt(ch); }
# Blocks until a value arrives; 0 once the channel is closed AND empty.
fn chan_recv(ch): i64 { return _chan_recv_rt(ch); }
# Mark the channel closed and wake every parked sender and receiver.
fn chan_close(ch): i64 { return _chan_close_rt(ch); }
#endif
