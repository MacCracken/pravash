# thread_agnos.cyr — AGNOS (ring-3) threading: single-threaded SERIAL fallback.
# Usage: included by lib/thread.cyr under #ifdef CYRIUS_TARGET_AGNOS.
# Requires: alloc.cyr, fnptr.cyr, syscalls.cyr (sys_getpid).
#
# AGNOS's frozen syscall surface has no clone/futex — it's the cooperative-iron
# single-core model (true preemptive threads wait on the 1.46.x kstacks). So
# cyrius threads run SERIALLY here, mirroring the v6.0.53 Windows serial
# fallback (later superseded by real Win32 threads) and the macOS
# single-threaded thread_local model: thread_create runs the body INLINE and
# returns before join; mutexes are no-ops (no contention on one thread);
# channels are a plain FIFO ring (no lock). Consumers that use threads only for
# throughput — sigil's crypto batch workers each write to a distinct "bank"
# (bank 0 = main thread) — get CORRECT results, just unparallelized.
#
# The public surface MUST match lib/thread.cyr's so consumers stay
# target-agnostic: thread_create / thread_join / gettid / mutex_new /
# mutex_lock / mutex_unlock / chan_new / chan_send / chan_recv / chan_close /
# chan_try_recv.
#
# >>> include "lib/fnptr.cyr"
include "lib/fnptr.cyr"
# thread_local.cyr supplies thread_local_get/set + _TLOCAL_MAX_SLOTS (128), used
# by thread_create below to emulate per-thread TLS isolation. On a real system
# thread creation and TLS setup are coupled (thread.cyr's _thread_spawn uses
# CLONE_SETTLS to give the child a fresh block), so this dependency mirrors the
# real path. include-once dedupes if the consumer already pulled it.
include "lib/thread_local.cyr"

# v6.5.44 — THREADS_CONCURRENT: does thread_create actually produce a SECOND thread?
# 1 = the body runs concurrently with the caller; 0 = it runs INLINE at create (serial peer).
# ⛔ This exists because the concurrency corpus could not tell the two apart. Every test in it
# passed on macOS while bodies ran inline — a serial backend satisfies "the worker ran", "join
# returned 0" and "the count is exact". A test that DISCRIMINATES must be guarded by capability
# (never by target name, never by errno — the v6.5.36 lesson), and this is that capability.
var THREADS_CONCURRENT = 0;   # serial fallback (bodies run inline)
var CHAN_BLOCKING = 0;        # the serial ring: nothing waits (lib/thread.cyr's header; 6.6.16)

# Run the thread body INLINE (serial — there is no second thread). fp is a
# single-i64-param fn ptr; its result is discarded, matching the spawn-and-join
# throughput model (workers communicate via shared memory, not the join value).
#
# TLS isolation: a REAL spawned thread gets a FRESH, zeroed thread-local block
# (CLONE_SETTLS), so its thread_local_set writes never leak back into the
# parent. The serial path shares one process-global TLS array, so we emulate
# that contract — snapshot the caller's slots, hand the body a zeroed view, run
# it, then restore. Without this the body's thread-local writes (e.g. sigil's
# crypto-lane slot: a lane the body took for life would replace the caller's,
# whose own lane then stays held in sigil 3.13.14's pool forever; through 3.13.13
# the slot held crypto_bank_set's bank) would persist past join into the
# caller's slots — per-thread state a real thread never shares.
# Returns a fake non-zero handle so callers' null-checks pass + join is valid.
fn thread_create(fp, arg): i64 {
    _threads_active = 1;   # v6.3.17 PF-02: arm the shared-heap lock before the spawn
    # ⛔ v6.5.39 — THIS WINDOW WAS 16 WHILE `TLOCAL_MAX_SLOTS` IS 128. Slots 16..127 were
    # never snapshotted, never zeroed for the body, and never restored — so on this target a
    # thread body's writes to any slot >= 16 leaked straight back into the caller, which is
    # precisely the corruption the comment above says this code exists to prevent. The stale
    # value was documented as correct too ("TLOCAL_MAX_SLOTS (128)"), which is why reading the
    # comment did not catch it. Present identically in BOTH serial peers (macOS and agnos).
    # The buffer is sized by `thread_local.cyr`'s const _TLOCAL_MAX_SLOTS (6.7.6: an array size
    # is a const context since 6.7.2; until then it had to be a literal 128, a hand-kept copy of
    # the bound) and so are both loops (6.7.9 — they read the writable public var, so a program
    # that raised TLOCAL_MAX_SLOTS copied past this stack buffer), so neither can under-copy or
    # overrun.
    # `tests/gates/concurrency/tls_window_matches_max_slots.sh` pins both.
    var save: i64[_TLOCAL_MAX_SLOTS];
    var i = 0;
    while (i < _TLOCAL_MAX_SLOTS) {
        store64(&save + i * 8, thread_local_get(i));
        thread_local_set(i, 0);
        i = i + 1;
    }
    fncall1(fp, arg);
    i = 0;
    while (i < _TLOCAL_MAX_SLOTS) {
        thread_local_set(i, load64(&save + i * 8));
        i = i + 1;
    }
    return 1;
}

# Join is a no-op — the body already ran inline at thread_create. Mirrors
# thread.cyr's contract (-1 on a null handle, 0 on success).
fn thread_join(t): i64 {
    if (t == 0) { return 0 - 1; }
    return 0;
}

# v6.5.8: detached spawn. agnos runs the body INLINE at create (there is no second thread
# of control yet — see thread_create above), so by the time this returns the work is
# already finished and there is nothing to reclaim. Returns 1 on success, matching the
# boolean contract of the other two peers.
#
# ⚠ Delegating to thread_create is load-bearing, not laziness: it keeps the TLS
# save/restore around the inline call, without which a detached body's thread_local_set
# would persist into the caller's slots.
fn thread_create_detached(fp, arg): i64 {
    if (thread_create(fp, arg) == 0) { return 0; }
    return 1;
}

# v6.5.8: the body ran inline at create, so any valid handle is by definition finished.
# ⛔ VALID ONLY BEFORE `thread_join`. Join CONSUMES the handle — on Windows it
# CloseHandle()s it, so a post-join query inspects a closed handle and reports "not
# done" (caught on real cass hardware, by a test that asserted the wrong contract).
# The intended use is the reaper shape: poll while running, then join once this
# returns 1. After joining, the thread is done by definition and there is nothing
# left to ask.
fn thread_is_done(t): i64 {
    if (t == 0) { return 0 - 1; }
    return 1;
}

# Current thread id — the (single) process id on agnos.
fn gettid(): i64 { return sys_getpid(); }

# Mutex (MUTEX_SIZE + mutex_new/lock/unlock) now comes from lib/sync.cyr, whose
# agnos branch is this same single-threaded no-op lock (8-byte cell, null-checked;
# lock/unlock no-ops — there is never a contender). Moved to the single owner in
# v6.3.44 (issue 2026-07-03-duplicate-mutex-fns-thread-vs-sync-stdlib); thread.cyr
# includes sync.cyr at its top before routing here. The channel below uses it
# unchanged (single-threaded → no lock needed anyway).

# Channel — a plain FIFO ring (single-threaded → no lock needed). Same 56-byte
# layout as thread.cyr / thread_win.cyr ({buf@0, cap@8, head@16, tail@24,
# count@32, _@40, closed@48}); recv is non-blocking (0 when empty).
fn chan_new(cap): i64 {
    alloc_init();
    var ch = alloc(56);
    if (ch == 0) { return 0; }
    var buf = alloc(cap * 8);
    if (buf == 0) { return 0; }                                      # CHANGELOG [6.6.10]
    store64(ch, buf);          # buf
    store64(ch + 8, cap);      # cap
    store64(ch + 16, 0);       # head
    store64(ch + 24, 0);       # tail
    store64(ch + 32, 0);       # count
    store64(ch + 40, 0);       # (unused — no lock on the serial path)
    store64(ch + 48, 0);       # closed
    return ch;
}
# Enqueue val (FIFO ring). Returns 0, or -1 if the channel is full.
fn chan_send(ch, val): i64 {
    var cap = load64(ch + 8);
    var count = load64(ch + 32);
    if (count >= cap) { return 0 - 1; }
    var buf = load64(ch);
    var tail = load64(ch + 24);
    store64(buf + tail * 8, val);
    store64(ch + 24, (tail + 1) % cap);
    store64(ch + 32, count + 1);
    return 0;
}
# Non-blocking send (v6.4.84). Contract is IDENTICAL on all three backends:
#    0 → enqueued · -1 → closed · -2 → full
#
# ⚠ NOT an alias for this backend's `chan_send` (the issue's proposed fix suggested
# that, and it would have shipped a divergent contract). `chan_send` here returns
# **-1 when FULL** while the portable contract reserves -1 for CLOSED, and it never
# inspects `closed` (+48) at all — so a send on a closed channel silently succeeds.
# A consumer written against the Linux semantics would then be unable to distinguish
# "stop producing" from "drop this one", which is the whole purpose of the fn.
# No lock: agnos is the serial path (see chan_recv below).
fn chan_try_send(ch, val): i64 {
    if (load64(ch + 48) != 0) { return 0 - 1; }
    var cap = load64(ch + 8);
    var count = load64(ch + 32);
    if (count >= cap) { return 0 - 2; }
    var buf = load64(ch);
    var tail = load64(ch + 24);
    store64(buf + tail * 8, val);
    store64(ch + 24, (tail + 1) % cap);
    store64(ch + 32, count + 1);
    return 0;
}
# Dequeue the oldest value (FIFO), or 0 if empty (never blocks — a blocking
# recv would deadlock on a single thread with no concurrent sender).
fn chan_try_recv(ch): i64 {
    var count = load64(ch + 32);
    if (count == 0) { return 0; }
    var buf = load64(ch);
    var cap = load64(ch + 8);
    var head = load64(ch + 16);
    var val = load64(buf + head * 8);
    store64(ch + 16, (head + 1) % cap);
    store64(ch + 32, count - 1);
    return val;
}
# recv is non-blocking here (serial path — a blocking recv would deadlock
# with no concurrent sender); identical to try_recv.
fn chan_recv(ch): i64 { return chan_try_recv(ch); }
# Mark the channel closed.
fn chan_close(ch): i64 { store64(ch + 48, 1); return 0; }
