# ln 2 = LN2H + LN2M + LN2L (LN2H at 42 bits, so E·LN2H is exact for |E| < 2^11). C3 … C8: the
# Taylor coefficients 1/3, −1/4, 1/5, −1/6, 1/7, −1/8 of log1p(r) − r + r²/2. 1/ln 10 = IVH + IVM +
# IVL, and IVH = IVH1 + IVH2 (26 + 27 bits).
var _PV_CR_LN_LN2H = 0x3FE62E42FEFA3800;   # 0.6931471805598903
var _PV_CR_LN_LN2M = 0x3D2EF35793C76730;   # 5.497923018708371e-14
var _PV_CR_LN_LN2L = 0x398F97B57A079A19;   # 1.94704509238075e-31
var _PV_CR_LN_C3 = 0x3FD5555555555555;   # 0.3333333333333333
var _PV_CR_LN_C4 = 0xBFD0000000000000;   # -0.25
var _PV_CR_LN_C5 = 0x3FC999999999999A;   # 0.2
var _PV_CR_LN_C6 = 0xBFC5555555555555;   # -0.16666666666666666
var _PV_CR_LN_C7 = 0x3FC2492492492492;   # 0.14285714285714285
var _PV_CR_LN_C8 = 0xBFC0000000000000;   # -0.125
var _PV_CR_LN_IVH = 0x3FDBCB7B1526E50E;   # 0.4342944819032518
var _PV_CR_LN_IVM = 0x3C695355BAAAFAD3;   # 1.098319650216765e-17
var _PV_CR_LN_IVL = 0x38FEE191F71A3012;   # 3.717181233110959e-34
var _PV_CR_LN_IVH1 = 0x3FDBCB7B18000000;   # 0.4342944845557213
var _PV_CR_LN_IVH2 = 0xBE26C8D790000000;   # -2.652469466291052e-09

# (−1)^(k+1)/k for k = 2 … 16 as triple-doubles (index 3·(k − 2)): the accurate log1p series.
var _PV_CR_LN_ACC: i64[45] = {
    0xBFE0000000000000, 0x0000000000000000, 0x0000000000000000,
    0x3FD5555555555555, 0x3C75555555555555, 0x3915555555555555,
    0xBFD0000000000000, 0x0000000000000000, 0x0000000000000000,
    0x3FC999999999999A, 0xBC6999999999999A, 0x390999999999999A,
    0xBFC5555555555555, 0xBC65555555555555, 0xB905555555555555,
    0x3FC2492492492492, 0x3C62492492492492, 0x3902492492492492,
    0xBFC0000000000000, 0x0000000000000000, 0x0000000000000000,
    0x3FBC71C71C71C71C, 0x3C5C71C71C71C71C, 0x38FC71C71C71C71C,
    0xBFB999999999999A, 0x3C5999999999999A, 0xB8F999999999999A,
    0x3FB745D1745D1746, 0xBC4745D1745D1746, 0x38D745D1745D1746,
    0xBFB5555555555555, 0xBC55555555555555, 0xB8F5555555555555,
    0x3FB3B13B13B13B14, 0xBC53B13B13B13B14, 0x38F3B13B13B13B14,
    0xBFB2492492492492, 0xBC52492492492492, 0xB8F2492492492492,
    0x3FB1111111111111, 0x3C31111111111111, 0x38B1111111111111,
    0xBFB0000000000000, 0x0000000000000000, 0x0000000000000000
};

# --- crlog.cyr ---

# crlog.cyr — correctly rounded ln and log10 (ADR 0004).
#
# Vendored from kimiya's src/mathx.cyr (its ADR 0006, M3c-2a: the ln and log10 functions and the triple-double
# helpers they use) with the `_pv_cr_` prefix on the entry points and `_pv_crl_` on the helpers: keep the two in
# step. kimiya's TwoSum, FastTwoSum and TwoProduct are the same operations as src/crmath.cyr's, so this file
# calls those (`_pv_cr_two_sum`, `_pv_cr_fast_two_sum`, `_pv_cr_two_prod`). pravash calls ln and log10 through
# src/mathx.cyr's `_pv_ln` and `_pv_log10`, never directly.
#
# UPSTREAM(L1): ganita:docs/development/issues/2026-11-09-correctly-rounded-exp-sin-cos-hypot.md
#   replace with ganita's correctly rounded ln and log10 once they ship (the mathx wrappers switch, this file and
#   src/crlog_data.cyr go); parity: the f64::ln and f64::log10 rows of tests/golden/math.tsv at 0 ulp against the
#   corrected oracle tests/golden/math.cr.tsv.

# +∞ (0x7FF0000000000000), a compile-time constant.
const _PV_CRL_INF = 1.0 / 0.0;

# The quiet NaN Rust's f64::NAN is (0x7FF8000000000000). The parity rules match any NaN.
#must_use
fn _pv_crl_nan(): f64 {
    var n: f64 = 0x7FF8000000000000;
    return n;
}

# ── the method (kimiya's ADR 0006) ─────────────────────────────────────────────────────────────
# Each is round-to-nearest-even of the exact value for every double argument, the exact cases included, from
# + − × ÷ and integer bit operations only (no stdlib transcendental, no FMA): the same bits on every target.
# Ziv's strategy:
# - a fast path: table-driven reduction, a short polynomial, a result hi + lo with a proven error bound ε,
#   and a rounding test that returns RN(hi + lo) only when hi + (lo − ε) and hi + (lo + ε) round to the
#   same double. RN is monotone and the true value lies between those two sums (ε is the proven bound plus
#   the rounding error of lo ± ε), so equal ends mean the true value rounds to them;
# - an accurate path when the test fails: the same reduction in triple-double, rounded once by _pv_crl_rn3
#   (exact rounding of a sum of three doubles). Its relative error is below 2^-135 by the operation count
#   (each triple-double step below 2^-153 of its operands, at most 40 steps, at most 1.3 bits of
#   cancellation; the tables and constants to 2^-145 or better), measured 2^-150 against 400-bit MPFR. That
#   is past the hardest cases known: Lefèvre and Muller's binary64 worst cases ("Worst cases for correct
#   rounding of the elementary functions in double precision", 2003 database, Properties 1 and 2) need a
#   mantissa distance of 2^-118 for ln; a relative error r gives a mantissa distance below 2r. No table was
#   found for log10; 2^-135 is 18 bits past its expected hardest case (about 2^-(53 + 64) for 2^64
#   arguments) and past every hard case kimiya's verification found.
# The tables are src/crlog_data.cyr (generated by scripts/oracle/lntables.py from MPFR, with the bit-count
# properties below asserted). Two private entry points per function serve tests/crmath.tcyr (kimiya's
# scripts/oracle/cr_verify.py checks the same code against MPFR on x86_64 ELF, x86_64 PE and aarch64):
# _pv_cr_<f>_acc(x) is the whole function by the accurate path alone (also the fast path's fallback), and
# _pv_cr_<f>_fast(x) returns (the fast path's result, 1) or (0, 0) when its rounding test fails, so the
# fallback rate is measured without any state. No global is written: every function here is pure.

# RO(a + b): a + b rounded to odd (of the two doubles around an inexact sum, the one with an odd last
# bit; exact sums are returned as they are). TwoSum's error e gives the side of the exact sum; an inexact
# sum is never 0, so the bit step stays in range.
#must_use
fn _pv_crl_ro_sum(a: f64, b: f64): f64 {
    var s, e = _pv_cr_two_sum(a, b);
    if (e == 0.0) { return s; }
    var sb = load64(&s);
    if ((sb & 1) != 0) { return s; }
    var up = 0;
    if (e > 0.0) { up = 1; }
    var pos = 0;
    if (s > 0.0) { pos = 1; }
    if (up == pos) { sb = sb + 1; } else { sb = sb - 1; }   # away from zero is the larger magnitude word
    var r: f64 = sb;
    return r;
}

# RN(a + b + c) exactly, for any three doubles without underflow in the TwoSums: Boldo and Melquiond's
# rounding-to-odd algorithm ("Emulation of FMA and correctly rounded sums", IEEE TC 2008): b + c = uh + ul
# and a + uh = th + tl exactly, then RN(th + RO(tl + ul)). (300,000 adversarial triples — ties, near-ties,
# binade edges, cancellation — agree with exact rational rounding.)
#must_use
fn _pv_crl_rn3(a: f64, b: f64, c: f64): f64 {
    var uh, ul = _pv_cr_two_sum(b, c);
    var th, tl = _pv_cr_two_sum(a, uh);
    var v: f64 = _pv_crl_ro_sum(tl, ul);
    var z: f64 = th + v;
    return z;
}

# Triple-doubles (h, m, l), normalised (|m| ≲ ulp(h), |l| ≲ ulp(m)). Every step is TwoSum or TwoProduct
# (exact) except the rounded sums of the third-order terms and the dropped products below 2^-158 of the
# result, so each operation's error is below 2^-155·max(|a|, |b|) for a sum and 2^-153·|a·b| for a
# product. The renormalising TwoSums keep the sum exact whatever the magnitudes, so a cancellation costs
# only its relative factor.
#must_use
fn _pv_crl_td_add(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64): (f64, f64, f64) {
    var s0, e0 = _pv_cr_two_sum(a0, b0);
    var s1, e1 = _pv_cr_two_sum(a1, b1);
    var s2: f64 = a2 + b2;
    var t1, f1 = _pv_cr_two_sum(e0, s1);
    var t2: f64 = (f1 + e1) + s2;
    var h, u = _pv_cr_two_sum(s0, t1);
    var m, l = _pv_cr_two_sum(u, t2);
    return (h, m, l);
}

# (a0, a1, a2) + d.
#must_use
fn _pv_crl_td_add_d(a0: f64, a1: f64, a2: f64, d: f64): (f64, f64, f64) {
    var s0, e0 = _pv_cr_two_sum(a0, d);
    var t1, f1 = _pv_cr_two_sum(e0, a1);
    var t2: f64 = f1 + a2;
    var h, u = _pv_cr_two_sum(s0, t1);
    var m, l = _pv_cr_two_sum(u, t2);
    return (h, m, l);
}

# (a0, a1, a2)·(b0, b1, b2): a0b0, a0b1, a1b0 exact (TwoProduct), the 2^-106 terms rounded, the 2^-159 ones
# (a1b2, a2b1, a2b2) dropped.
#must_use
fn _pv_crl_td_mul(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64): (f64, f64, f64) {
    var p0, q0 = _pv_cr_two_prod(a0, b0);
    var p1, q1 = _pv_cr_two_prod(a0, b1);
    var p2, q2 = _pv_cr_two_prod(a1, b0);
    var r: f64 = ((a0 * b2) + (a1 * b1)) + (a2 * b0);
    var s1, e1 = _pv_cr_two_sum(p1, p2);
    var s2, e2 = _pv_cr_two_sum(q0, s1);
    var t: f64 = (((e1 + e2) + q1) + q2) + r;
    var h, u = _pv_cr_two_sum(p0, s2);
    var m, l = _pv_cr_two_sum(u, t);
    return (h, m, l);
}

# (a0, a1, a2)·d for a double d.
#must_use
fn _pv_crl_td_mul_d(a0: f64, a1: f64, a2: f64, d: f64): (f64, f64, f64) {
    var p0, q0 = _pv_cr_two_prod(a0, d);
    var p1, q1 = _pv_cr_two_prod(a1, d);
    var r: f64 = a2 * d;
    var s, e = _pv_cr_two_sum(q0, p1);
    var t: f64 = (e + q1) + r;
    var h, u = _pv_cr_two_sum(p0, s);
    var m, l = _pv_cr_two_sum(u, t);
    return (h, m, l);
}

# ── ln and log10 ────────────────────────────────────────────────────────────────────────────────
#
# Reduction: t = bits(x) − 0x3FE7FC0000000000, E = t >> 52 (arithmetic), j = bits 43 … 51 of t, so
# x = 2^E·m with m in [0.7495, 1.4990) and E·ln2 + ln m never cancels (|ln m| ≤ 0.405 < ln 2). On interval j,
# c_j ≈ 1/m is short (a multiple of 2^-9 or 2^-10) and r = m·c_j − 1 is exact with |r| < 2^-9 (the generator
# asserts both): m = mh + ml (mh = m's top 25 bits), mh·c − 1 is exact (Sterbenz), ml·c is exact, and their
# sum is the representable r. ln x = E·ln2 + L_j + log1p(r), L_j = −ln c_j (0 on interval 256, where c = 1).
# Fast path: r = ra + rb (Veltkamp, ra at 26 bits) so r²/2 = ra²/2 (exact) + rb·(ra + rb/2) (2^-80·|r| of
# error); log1p(r) − r + r²/2 = r³·(1/3 − r/4 + … − r⁵/8) (Estrin, relative error 4·2^-53; truncation
# |r|⁹/9 < 2^-84); hi + lo = the three
# Fast2Sums of E·LN2H + Lh, + r, − ra²/2 plus the small terms. The test's bound is absolute, from the computed
# terms: err = 2^-49·|p| + 2^-83·|hi| + 2^-93·|E| covers p's own error and truncation (2^-50.6·|p|), the six
# roundings of lo (each below 2^-53 of a partial sum: 2^-51.4·|p|, 2^-84.4·|hi| for the t2, Ll and d terms,
# 2^-95.4·|E| for E·LN2M) with E·LN2M's rounding (2^-97·|E|) and the dropped E·LN2L (2^-102·|E|), and the
# test's own rounding of lo ∓ err (2^-53·|lo|); what is left over covers log10's extra roundings, 2^-52.4·|lo|
# (|lo| is below |p| + 2^-44·|E| + 2^-43.3·|hi|). It is relative to r near 1 (interval 256, where p, t2 and
# the d terms all scale with r) and about 2^-77 elsewhere (measured error 2^-69.9 relative at E = 0 next to
# interval 256 and 2^-81.2 at E ≠ 0, over 100,000 arguments). pow needs exactly this absolute form: the
# error of y·ln x is |y|·err. ln(1) = +0 falls out (every term is ±0 and their sum +0).
# log10 = ln·(1/ln 10): hi + lo times IVH + IVM (Dekker's product, IVH pre-split 26 + 27 bits), with the
# bound carried over (_pv_cr_log10_fast). log10(10^k) = k for k = 0 … 22 comes out of the fast path: k is a
# double, ulp/2 from every midpoint. ln x and log10 x are exact only there (and ln at x = 1): log10 x rational means
# x = 10^(p/q) with q | p, and 10^n is a double only for n = 0 … 22; nothing else is exact or a tie.

# The ln fast core for the bits ui of a positive normal x (ebias −54 for a subnormal pre-scaled by 2^54):
# (hi, lo, err) with |hi + lo − ln x| < err minus the test's own rounding (the bound above).
#must_use
fn _pv_crl_ln_core(ui, ebias): (f64, f64, f64) {
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_PV_CR_LN_T + ti);
    var lh: f64 = load64(&_PV_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_PV_CR_LN_T + ti + 16);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var cc: f64 = r * 134217729.0;
    var ra: f64 = cc - (cc - r);
    var rb: f64 = r - ra;
    var t1: f64 = -0.5 * (ra * ra);             # −ra²/2, exact
    var nrb: f64 = -rb;
    var t2: f64 = nrb * (ra + (0.5 * rb));
    var c3: f64 = _PV_CR_LN_C3;
    var c4: f64 = _PV_CR_LN_C4;
    var c5: f64 = _PV_CR_LN_C5;
    var c6: f64 = _PV_CR_LN_C6;
    var c7: f64 = _PV_CR_LN_C7;
    var c8: f64 = _PV_CR_LN_C8;
    var z: f64 = r * r;
    var pz: f64 = ((c3 + (r * c4)) + (z * (c5 + (r * c6)))) + ((z * z) * (c7 + (r * c8)));   # Estrin
    var p: f64 = (z * r) * pz;
    var e = e0 + ebias;
    var ef: f64 = f64_from(e);
    var ln2h: f64 = _PV_CR_LN_LN2H;
    var ln2m: f64 = _PV_CR_LN_LN2M;
    var a: f64 = ef * ln2h;                      # exact: LN2H has 42 bits, |E| < 2^11
    var s0: f64 = a + lh;
    var d0: f64 = lh - (s0 - a);
    var s1: f64 = s0 + r;
    var d1: f64 = r - (s1 - s0);
    var s2: f64 = s1 + t1;
    var d2: f64 = t1 - (s2 - s1);
    var lo: f64 = (((ef * ln2m) + lm) + (t2 + p)) + ((d0 + d1) + d2);   # short chains (latency)
    var ap: f64 = f64_abs(p);
    var ah: f64 = f64_abs(s2);
    var ae: f64 = f64_abs(ef);
    var k49: f64 = 0x3CE0000000000000;          # 2^-49
    var k83: f64 = 0x3AC0000000000000;          # 2^-83
    var k93: f64 = 0x3A20000000000000;          # 2^-93
    var err: f64 = ((ap * k49) + (ah * k83)) + (ae * k93);
    return (s2, lo, err);
}

# ln(x), correctly rounded. ln(1) = +0, ln(±0) = −∞, ln(+∞) = +∞, NaN for NaN and x < 0 (−∞ included).
#must_use
fn _pv_cr_ln(x: f64): f64 {
    var ui = load64(&x);
    # x ≤ 0 (the sign bit), subnormal, ∞ or NaN: ui − bits(DBL_MIN) is at least bits(∞) − bits(DBL_MIN) as an
    # unsigned word (the unsigned range test of kimiya's _km_cr_exp).
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {
        var w, okw = _pv_cr_ln_fast(x);
        if (okw == 1) { return w; }
        var zw: f64 = _pv_cr_ln_acc(x);
        return zw;
    }
    # _pv_crl_ln_core's body, inline (a call and its three-value return cost about 4 ns here).
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_PV_CR_LN_T + ti);
    var lh: f64 = load64(&_PV_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_PV_CR_LN_T + ti + 16);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var cc: f64 = r * 134217729.0;
    var ra: f64 = cc - (cc - r);
    var rb: f64 = r - ra;
    var t1: f64 = -0.5 * (ra * ra);             # −ra²/2, exact
    var nrb: f64 = -rb;
    var t2: f64 = nrb * (ra + (0.5 * rb));
    var c3: f64 = _PV_CR_LN_C3;
    var c4: f64 = _PV_CR_LN_C4;
    var c5: f64 = _PV_CR_LN_C5;
    var c6: f64 = _PV_CR_LN_C6;
    var c7: f64 = _PV_CR_LN_C7;
    var c8: f64 = _PV_CR_LN_C8;
    var z: f64 = r * r;
    var pz: f64 = ((c3 + (r * c4)) + (z * (c5 + (r * c6)))) + ((z * z) * (c7 + (r * c8)));   # Estrin
    var p: f64 = (z * r) * pz;
    var e = e0;
    var ef: f64 = f64_from(e);
    var ln2h: f64 = _PV_CR_LN_LN2H;
    var ln2m: f64 = _PV_CR_LN_LN2M;
    var a: f64 = ef * ln2h;                      # exact: LN2H has 42 bits, |E| < 2^11
    var s0: f64 = a + lh;
    var d0: f64 = lh - (s0 - a);
    var s1: f64 = s0 + r;
    var d1: f64 = r - (s1 - s0);
    var s2: f64 = s1 + t1;
    var d2: f64 = t1 - (s2 - s1);
    var lo: f64 = (((ef * ln2m) + lm) + (t2 + p)) + ((d0 + d1) + d2);   # short chains (latency)
    var ap: f64 = f64_abs(p);
    var ah: f64 = f64_abs(s2);
    var ae: f64 = f64_abs(ef);
    var k49: f64 = 0x3CE0000000000000;          # 2^-49
    var k83: f64 = 0x3AC0000000000000;          # 2^-83
    var k93: f64 = 0x3A20000000000000;          # 2^-93
    var err: f64 = ((ap * k49) + (ah * k83)) + (ae * k93);
    var u: f64 = s2 + (lo - err);
    var v: f64 = s2 + (lo + err);
    if (u == v) { return u; }
    var za: f64 = _pv_cr_ln_acc(x);
    return za;
}

# The fast path alone, for every x (as kimiya's _km_cr_exp_fast): the specials, a subnormal x scaled exactly by 2^54,
# then the core and its test, the operations of _pv_cr_ln's inline path.
#must_use
fn _pv_cr_ln_fast(x: f64): (f64, i64) {
    var ui = load64(&x);
    var eb = 0;
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {
        if (x != x) { return (x, 1); }
        if (x == 0.0) {
            var m1: f64 = -1.0;
            var ninf: f64 = m1 / 0.0;
            return (ninf, 1);
        }
        if (x < 0.0) {
            var nan: f64 = _pv_crl_nan();           # the same quiet NaN on every target
            return (nan, 1);
        }
        if (x == _PV_CRL_INF) { return (x, 1); }
        var p54: f64 = 0x4350000000000000;      # 2^54
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var hi, lo, err = _pv_crl_ln_core(ui, eb);
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u == v) { return (u, 1); }
    return (0.0, 0);
}

# The accurate ln of a positive finite x ≠ 1 as a triple-double at out[0..2]: the fast path's E, j and the
# exact r; log1p(r) by Horner in triple-double on the exact r to r^16/16 (truncation 2^-144·|r|);
# E·ln 2 = E·LN2H (exact) + E·LN2M (TwoProduct) + E·LN2L (rounded, 2^-138); then E·ln2 + L_j + log1p(r)
# with at most 1.3 bits of cancellation. Measured relative error 2^-150.
fn _pv_crl_ln_acc_td(x: f64, out) {
    var ui = load64(&x);
    var eb = 0;
    if (ui < 0x0010000000000000) {
        var p54: f64 = 0x4350000000000000;
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_PV_CR_LN_T + ti);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var sh: f64 = load64(&_PV_CR_LN_ACC + 336);     # −1/16 (index 3·(16 − 2))
    var sm: f64 = load64(&_PV_CR_LN_ACC + 344);
    var sl: f64 = load64(&_PV_CR_LN_ACC + 352);
    var n = 15;
    while (n >= 2) {
        var th, tm, tl = _pv_crl_td_mul_d(sh, sm, sl, r);
        var off = (n - 2) * 24;
        var ch: f64 = load64(&_PV_CR_LN_ACC + off);
        var cm: f64 = load64(&_PV_CR_LN_ACC + off + 8);
        var cl: f64 = load64(&_PV_CR_LN_ACC + off + 16);
        var uh, um, ul = _pv_crl_td_add(ch, cm, cl, th, tm, tl);
        sh = uh;
        sm = um;
        sl = ul;
        n = n - 1;
    }
    var vh, vm, vl = _pv_crl_td_mul_d(sh, sm, sl, r);
    var wh, wm, wl = _pv_crl_td_add_d(vh, vm, vl, 1.0);
    var ph, pm, pl = _pv_crl_td_mul_d(wh, wm, wl, r);       # log1p(r)
    var lh: f64 = load64(&_PV_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_PV_CR_LN_T + ti + 16);
    var ll: f64 = load64(&_PV_CR_LN_T + ti + 24);
    var ef: f64 = f64_from(e0 + eb);
    var ln2h: f64 = _PV_CR_LN_LN2H;
    var ln2m: f64 = _PV_CR_LN_LN2M;
    var ln2l: f64 = _PV_CR_LN_LN2L;
    var a0: f64 = ef * ln2h;
    var a1, a1e = _pv_cr_two_prod(ef, ln2m);
    var a2: f64 = ef * ln2l;
    var h0, u0 = _pv_cr_fast_two_sum(a0, a1);
    var a12: f64 = a1e + a2;
    var m0, l0 = _pv_cr_two_sum(u0, a12);
    var bh, bm, bl = _pv_crl_td_add(h0, m0, l0, lh, lm, ll);
    var zh, zm, zl = _pv_crl_td_add(bh, bm, bl, ph, pm, pl);
    store64(out, zh);
    store64(out + 8, zm);
    store64(out + 16, zl);
}

# ln by the accurate path alone, for every x.
#must_use
fn _pv_cr_ln_acc(x: f64): f64 {
    if (x != x) { return x; }
    if (x == 0.0) {
        var m1: f64 = -1.0;
        var ninf: f64 = m1 / 0.0;
        return ninf;
    }
    if (x < 0.0) {
        var nan: f64 = _pv_crl_nan();               # the same quiet NaN on every target
        return nan;
    }
    if (x == _PV_CRL_INF) { return x; }
    if (x == 1.0) { return 0.0; }
    var buf: f64[3];
    _pv_crl_ln_acc_td(x, &buf);
    var r: f64 = _pv_crl_rn3(buf[0], buf[1], buf[2]);
    return r;
}

# log10(x), correctly rounded. log10(10^k) = k (k = 0 … 22), log10(1) = +0, log10(±0) = −∞, log10(+∞) = +∞,
# NaN for NaN and x < 0. The ln core's (hi, lo, ε), then (hi + lo)·(IVH + IVM) (Dekker's product with IVH
# pre-split) and the rounding test, else the accurate path.
#must_use
fn _pv_cr_log10(x: f64): f64 {
    var ui = load64(&x);
    var eb = 0;
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {   # as in _pv_cr_ln
        if (x != x) { return x; }
        if (x == 0.0) {
            var m1: f64 = -1.0;
            var ninf: f64 = m1 / 0.0;
            return ninf;
        }
        if (x < 0.0) {
            var nan: f64 = _pv_crl_nan();
            return nan;
        }
        if (x == _PV_CRL_INF) { return x; }
        var p54: f64 = 0x4350000000000000;          # a subnormal x, scaled exactly by 2^54
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var hi, lo, eln = _pv_crl_ln_core(ui, eb);
    var ivh: f64 = _PV_CR_LN_IVH;
    var ivm: f64 = _PV_CR_LN_IVM;
    var i1: f64 = _PV_CR_LN_IVH1;
    var i2: f64 = _PV_CR_LN_IVH2;
    var ph: f64 = hi * ivh;
    var c: f64 = 134217729.0 * hi;
    var h1: f64 = c - (c - hi);
    var h2: f64 = hi - h1;
    var pe: f64 = ((((h1 * i1) - ph) + (h1 * i2)) + (h2 * i1)) + (h2 * i2);
    var pl: f64 = pe + ((hi * ivm) + (lo * ivh));
    # The error: 0.4343·(ln's error) plus the product's roundings (hi·IVM, lo·IVH, pl's sum, the test's own:
    # below 2^-52.4·|lo| + 2^-101·|ph|, which eln's slack and 0.5 − 0.4343 cover) and IVL (2^-111·|ln x|):
    # err10 = eln/2 + 2^-100·|ph|.
    var ap: f64 = f64_abs(ph);
    var k100: f64 = 0x39B0000000000000;     # 2^-100
    var err: f64 = (eln * 0.5) + (ap * k100);
    var u: f64 = ph + (pl - err);
    var v: f64 = ph + (pl + err);
    if (u == v) { return u; }
    var z: f64 = _pv_cr_log10_acc(x);
    return z;
}

# The fast path alone: (its result, 1), or (0, 0) when its rounding test fails; the same operations as
# _pv_cr_log10 (used by tests/crmath.tcyr).
#must_use
fn _pv_cr_log10_fast(x: f64): (f64, i64) {
    var ui = load64(&x);
    var eb = 0;
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {   # as in _pv_cr_ln
        if (x != x) { return (x, 1); }
        if (x == 0.0) {
            var m1: f64 = -1.0;
            var ninf: f64 = m1 / 0.0;
            return (ninf, 1);
        }
        if (x < 0.0) {
            var nan: f64 = _pv_crl_nan();
            return (nan, 1);
        }
        if (x == _PV_CRL_INF) { return (x, 1); }
        var p54: f64 = 0x4350000000000000;          # a subnormal x, scaled exactly by 2^54
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var hi, lo, eln = _pv_crl_ln_core(ui, eb);
    var ivh: f64 = _PV_CR_LN_IVH;
    var ivm: f64 = _PV_CR_LN_IVM;
    var i1: f64 = _PV_CR_LN_IVH1;
    var i2: f64 = _PV_CR_LN_IVH2;
    var ph: f64 = hi * ivh;
    var c: f64 = 134217729.0 * hi;
    var h1: f64 = c - (c - hi);
    var h2: f64 = hi - h1;
    var pe: f64 = ((((h1 * i1) - ph) + (h1 * i2)) + (h2 * i1)) + (h2 * i2);
    var pl: f64 = pe + ((hi * ivm) + (lo * ivh));
    # The error: 0.4343·(ln's error) plus the product's roundings (hi·IVM, lo·IVH, pl's sum, the test's own:
    # below 2^-52.4·|lo| + 2^-101·|ph|, which eln's slack and 0.5 − 0.4343 cover) and IVL (2^-111·|ln x|):
    # err10 = eln/2 + 2^-100·|ph|.
    var ap: f64 = f64_abs(ph);
    var k100: f64 = 0x39B0000000000000;     # 2^-100
    var err: f64 = (eln * 0.5) + (ap * k100);
    var u: f64 = ph + (pl - err);
    var v: f64 = ph + (pl + err);
    if (u == v) { return (u, 1); }
    return (0.0, 0);
}

# log10 by the accurate path alone: the triple-double ln times 1/ln 10 = IVH + IVM + IVL.
#must_use
fn _pv_cr_log10_acc(x: f64): f64 {
    if (x != x) { return x; }
    if (x == 0.0) {
        var m1: f64 = -1.0;
        var ninf: f64 = m1 / 0.0;
        return ninf;
    }
    if (x < 0.0) {
        var nan: f64 = _pv_crl_nan();               # the same quiet NaN on every target
        return nan;
    }
    if (x == _PV_CRL_INF) { return x; }
    if (x == 1.0) { return 0.0; }
    var buf: f64[3];
    _pv_crl_ln_acc_td(x, &buf);
    var ivh: f64 = _PV_CR_LN_IVH;
    var ivm: f64 = _PV_CR_LN_IVM;
    var ivl: f64 = _PV_CR_LN_IVL;
    var zh, zm, zl = _pv_crl_td_mul(buf[0], buf[1], buf[2], ivh, ivm, ivl);
    var r: f64 = _pv_crl_rn3(zh, zm, zl);
    return r;
}

# --- mathx.cyr ---

# mathx.cyr — pravash's math helpers: Rust std semantics on top of the Cyrius builtins.
#
# Port plan §7.1; docs/development/port-parity.md §1–§2. Each helper mirrors one std f64 operation as rustc
# 1.99.1 compiles it, and is pinned by tests/golden/math.tsv:
# - min / max / clamp ignore a NaN operand as Rust does (the stdlib f64_min / f64_max ignore a NaN only as the
#   first operand);
# - the predicates have no public stdlib counterpart;
# - to_radians and the literal-exponent powi are Rust's exact operation order;
# - the casts saturate as Rust's `as` does (f64_to is the i64 conversion: no saturation to i32 / u32, and a
#   negative stays negative).
# The transcendentals are correctly rounded (ADR 0004): exp, sin, cos, sin_cos, hypot, powf and atan2 on
# src/crmath.cyr, ln and log10 on src/crlog.cyr (both ledger L1, with their own UPSTREAM notes), cbrt on ganita's,
# which already is. Every class C row of tests/golden/math.tsv is 0 ulp from the corrected oracle
# (tests/golden/math.cr.tsv).
#
# UPSTREAM(L2): cyrius:docs/development/issues/2026-11-11-f64-min-max-drop-nan-only-as-first-operand.md
#   replace each helper with the stdlib's minNum / maxNum, predicates and saturating converts once they ship;
#   parity: the f64::min, max, clamp, is_nan, is_finite, as_usize, as_u32 rows of tests/golden/math.tsv (class A).
# Adapted from impetus's src/mathx.cyr (its `_im_` helpers).

# π/180 as Rust folds `consts::PI / 180.0`: the double nearest, pinned by the to_radians rows.
var _PV_RADS_PER_DEG: f64 = 0.017453292519943295;

# The bits of an f64 as an integer word: an untyped parameter, an i64 return. Inlined: every store of an f64 through
# `store64` passes through it (M6 part b: 1.15× on the FLIP step).
#must_use
#inline
fn _pv_bits(x): i64 {
    return x;
}

# 1 when x is NaN. Mirrors `f64::is_nan`.
#must_use
fn _pv_is_nan(x: f64): i64 {
    if (x != x) { return 1; }
    return 0;
}

# 1 when x is neither infinite nor NaN (x − x is 0 only then). Mirrors `f64::is_finite`.
#must_use
fn _pv_is_finite(x: f64): i64 {
    var d: f64 = x - x;
    if (d == 0.0) { return 1; }
    return 0;
}

# The smaller of x and y, ignoring a NaN operand (NaN only when both are). Equal operands, +0 and −0 included,
# give y, as rustc 1.99.1's `x.min(y)` does. Mirrors `f64::min`.
#must_use
fn _pv_min(x: f64, y: f64): f64 {
    if (x != x) { return y; }
    if (y != y) { return x; }
    if (x < y) { return x; }
    return y;
}

# The larger of x and y, ignoring a NaN operand (NaN only when both are). Equal operands give y. Mirrors
# `f64::max`.
#must_use
fn _pv_max(x: f64, y: f64): f64 {
    if (x != x) { return y; }
    if (y != y) { return x; }
    if (x > y) { return x; }
    return y;
}

# x restricted to [lo, hi]: lo when x < lo, hi when x > hi, else x (a NaN x stays NaN). Rust panics on lo > hi
# or a NaN bound; every caller passes valid bounds. Mirrors `f64::clamp`.
#must_use
fn _pv_clamp(x: f64, lo: f64, hi: f64): f64 {
    var r: f64 = x;
    if (r < lo) { r = lo; }
    if (r > hi) { r = hi; }
    return r;
}

# Degrees to radians: one multiply by the folded π/180. Mirrors `f64::to_radians`.
#must_use
fn _pv_to_radians(x: f64): f64 {
    var r: f64 = x * _PV_RADS_PER_DEG;
    return r;
}

# x², as LLVM expands a literal `x.powi(2)`.
#must_use
fn _pv_powi2(x: f64): f64 {
    var r: f64 = x * x;
    return r;
}

# x⁸, as LLVM expands a literal `x.powi(8)`: three squarings, ((x²)²)².
#must_use
fn _pv_powi8(x: f64): f64 {
    var x2: f64 = x * x;
    var x4: f64 = x2 * x2;
    var r: f64 = x4 * x4;
    return r;
}

# `x as i32`: toward zero, saturating at i32::MIN / i32::MAX, NaN → 0. The result as a sign-extended word.
#must_use
fn _pv_as_i32(x: f64): i64 {
    if (x != x) { return 0; }
    if (x >= 2147483647.0) { return 2147483647; }
    if (x <= -2147483648.0) { return 0 - 2147483648; }
    return f64_to(x);
}

# `x as i64`: toward zero, saturating at i64::MIN / i64::MAX, NaN → 0 (hisab 3.4.1's `_sh_cell_coord` cast).
#must_use
fn _pv_as_i64(x: f64): i64 {
    if (x != x) { return 0; }
    if (x >= 9223372036854775808.0) { return 9223372036854775807; }
    var lo: f64 = -9223372036854775808.0;
    if (x <= lo) { return 0 - 9223372036854775807 - 1; }
    return f64_to(x);
}

# `x as u32`: toward zero, saturating at 0 and u32::MAX, NaN → 0.
#must_use
fn _pv_as_u32(x: f64): i64 {
    if (x != x) { return 0; }
    if (x <= 0.0) { return 0; }
    if (x >= 4294967295.0) { return 4294967295; }
    return f64_to(x);
}

# `x as usize` on a 64-bit target: toward zero, saturating at 0 and u64::MAX, NaN → 0. The result is the 64-bit
# word, so a value at or above 2^63 reads negative as an i64.
#must_use
fn _pv_as_usize(x: f64): i64 {
    if (x != x) { return 0; }
    if (x <= 0.0) { return 0; }
    if (x >= 18446744073709551616.0) { return 0 - 1; }
    if (x >= 9223372036854775808.0) {
        var hi: f64 = x - 9223372036854775808.0;
        return f64_to(hi) | 0x8000000000000000;
    }
    return f64_to(x);
}

# e^x, correctly rounded (src/crmath.cyr). Stands for `f64::exp`.
#must_use
fn _pv_exp(x: f64): f64 {
    var r: f64 = _pv_cr_exp(x);
    return r;
}

# ln x, correctly rounded (src/crlog.cyr). Stands for `f64::ln`.
#must_use
fn _pv_ln(x: f64): f64 {
    var r: f64 = _pv_cr_ln(x);
    return r;
}

# log₁₀ x, correctly rounded (src/crlog.cyr); log10(10^k) = k exactly for k = 0 … 22. Stands for `f64::log10`.
#must_use
fn _pv_log10(x: f64): f64 {
    var r: f64 = _pv_cr_log10(x);
    return r;
}

# x^y, correctly rounded (src/crmath.cyr), C99 Annex F's specials. Stands for `f64::powf`.
#must_use
fn _pv_powf(x: f64, y: f64): f64 {
    var r: f64 = _pv_cr_pow(x, y);
    return r;
}

# ∛x, correctly rounded: ganita's, which equals the oracle's compiler_builtins cbrt on every row
# (port-parity §3). Stands for `f64::cbrt`.
#must_use
fn _pv_cbrt(x: f64): f64 {
    var r: f64 = ganita_f64_cbrt(x);
    return r;
}

# √(x² + y²), correctly rounded (src/crmath.cyr), without overflow or underflow in the squares. Stands for
# `f64::hypot`.
#must_use
fn _pv_hypot(x: f64, y: f64): f64 {
    var r: f64 = _pv_cr_hypot(x, y);
    return r;
}

# (sin x, cos x), each correctly rounded (src/crmath.cyr). Stands for `f64::sin_cos`, which is Rust's
# (x.sin(), x.cos()). Read as `var s, c = _pv_sin_cos(x);` and bind each to an f64 local.
#must_use
fn _pv_sin_cos(x: f64) {
    var s, c = _pv_cr_sin_cos(x);
    var sv: f64 = s;
    var cv: f64 = c;
    return (sv, cv);
}

# sin x, correctly rounded (src/crmath.cyr). Stands for `f64::sin`.
#must_use
fn _pv_sin(x: f64): f64 {
    var r: f64 = _pv_cr_sin(x);
    return r;
}

# cos x, correctly rounded (src/crmath.cyr). Stands for `f64::cos`.
#must_use
fn _pv_cos(x: f64): f64 {
    var r: f64 = _pv_cr_cos(x);
    return r;
}

# The angle of (x, y) in [−π, π], correctly rounded (src/crmath.cyr), C99 Annex F's specials and signs of zero
# included. Stands for `y.atan2(x)`.
#must_use
fn _pv_atan2(y: f64, x: f64): f64 {
    var r: f64 = _pv_cr_atan2(y, x);
    return r;
}

# x mod y, exact, with the sign of x: C's fmod, which Rust's `%` on f64 lowers to. Invalid (y = ±0, x = ±∞) gives
# x's NaN quieted when x is one, else the default NaN 0xFFF8000000000000 (glibc's bits); a NaN y is y quieted;
# |x| < |y| gives x, and a zero remainder x's signed zero. Integer bit operations only (fdlibm's e_fmod shape:
# shift-subtract once per binade of exponent gap, then renormalise), so the bits are the same on every target.
# Transcribed from hisab 3.4.1's `f64_fmod`, which is exact (its CHANGELOG 3.4.0: an exact rational oracle and
# glibc 2.44 over 18,400 pairs). Stands for `x % y` (the periodic grid sampler).
#
# UPSTREAM(L14): ganita:docs/development/issues/2026-11-11-no-fmod.md
#   replace with ganita's fmod once it ships (hisab's is test-scope here); parity: the f64::rem rows of
#   tests/golden/math.tsv (class A) and the periodic FluidGrid::step rows of tests/golden/grid.tsv.
#must_use
fn _pv_fmod(x, y) {
    var hy = y & 0x7FFFFFFFFFFFFFFF;
    var sx = x & 0x8000000000000000;
    var hx = x & 0x7FFFFFFFFFFFFFFF;
    if (hy == 0) {
        if (hx > 0x7FF0000000000000) { return x | 0x0008000000000000; }
        return 0xFFF8000000000000;
    }
    if (hx >= 0x7FF0000000000000 || hy > 0x7FF0000000000000) {
        if (hx > 0x7FF0000000000000) { return x | 0x0008000000000000; }
        if (hy > 0x7FF0000000000000) { return y | 0x0008000000000000; }
        return 0xFFF8000000000000;
    }
    if (hx < hy) { return x; }
    var ex = hx >> 52;
    var mx = hx & 0x000FFFFFFFFFFFFF;
    if (ex == 0) { ex = 1; } else { mx = mx | 0x0010000000000000; }
    var ey = hy >> 52;
    var my = hy & 0x000FFFFFFFFFFFFF;
    if (ey == 0) {
        ey = 1;
        while (my < 0x0010000000000000) {
            my = my << 1;
            ey = ey - 1;
        }
    } else {
        my = my | 0x0010000000000000;
    }
    var n = ex - ey;
    var t = 0;
    while (n > 0) {
        t = mx - my;
        mx = (t + (my & (0 - (t >> 63)))) << 1;
        n = n - 1;
    }
    t = mx - my;
    mx = t + (my & (0 - (t >> 63)));
    if (mx == 0) { return sx; }
    while (mx < 0x0010000000000000) {
        mx = mx << 1;
        ey = ey - 1;
    }
    if (ey >= 1) { return sx | (ey << 52) | (mx & 0x000FFFFFFFFFFFFF); }
    return sx | (mx >> (1 - ey));
}

# --- logging.cyr ---

# logging.cyr — rust-old/src/logging.rs (M7 part b): pravash's tracing on sakshi, and the init helpers.
#
# Rust's pravash traces through `tracing`: a TRACE span on each operation (`sph::step{n=10}`) and a WARN event where an
# input is ignored, under the targets `pravash::<module>`; `logging::init*` installs a subscriber. Here they go
# through sakshi (ADR 0002 #28). A span is a sakshi span named as tracing's fmt layer renders one, `name{k=v k=v}`,
# entered only when its target enables TRACE; an event is a sakshi WARN line, `pravash::<module>: <message> k=v`. A
# consumer configures sakshi (its level, output, hook) and sees pravash's spans and events among its own: until
# pravash's init runs, every target follows sakshi's level.
#
# `logging_init()` and `logging_init_with_level(level, len)` mirror `init` and `init_with_level`: the first call wins
# (Rust's `try_init`), and sakshi then writes to stdout, as the fmt layer does. Each target's level is what
# tracing-subscriber 0.3.23's `EnvFilter` decides: PRAVASH_LOG parsed strictly when it is set (set to "", it enables
# nothing), and the default parsed leniently when it is unset or doesn't parse (an invalid directive dropped, error
# when none is left). A directive is `target=level`, `target` or `level` (a name in any case, 0–5, or "" for error);
# the longest target that prefixes a target's name decides, a directive without one last, and the last of two equal
# ones wins. The parse is EnvFilter's state machine, quirks kept: it walks the trimmed directive but slices the
# untrimmed one. Directives with a span name or fields (`[span]`, `{field}`) are checked as syntax and decide nothing:
# sakshi has no span-scoped filter, and a field filter matches no field-less callsite (ADR 0002 #28).
#
# `logging_init_profiling(guard)` mirrors `init_profiling`: a chrome://tracing Trace Event file `trace-<unix µs>.json`
# in the working directory, written through a sakshi hook until `PvFlushGuard_drop` (ledger L11).
#
# UPSTREAM(L11): sakshi:docs/development/issues/2026-11-11-no-chrome-trace-export.md — replace the hook writer with
#   sakshi's Trace Event exporter once it ships; parity: tests/logging.tcyr's trace-file group.
#
# Not thread-safe while tracing: sakshi has one span stack per process (its single-threaded contract). pravash's
# worker pool enters no span and emits no event.

# The targets, in name order: `pravash::<module>` for each module that traces.
const _PV_LOG_COMMON = 0;
const _PV_LOG_COUPLING = 1;
const _PV_LOG_GRID = 2;
const _PV_LOG_MPM = 3;
const _PV_LOG_PHASE_FIELD = 4;
const _PV_LOG_SHALLOW = 5;
const _PV_LOG_SPH = 6;
const _PV_LOG_VOF = 7;
const _PV_LOG_TARGETS = 8;

# The levels, as tracing's LevelFilter and sakshi number them: an event of level L is enabled under level M when
# L ≤ M (OFF 0 enables nothing).
const _PV_LOG_ERROR = 1;
const _PV_LOG_WARN = 2;
const _PV_LOG_TRACE = 5;

# A target's name, or "" outside the list.
#must_use
fn _pv_log_target_name(t): i64 {
    match t {
        0 => { return "pravash::common"; }
        1 => { return "pravash::coupling"; }
        2 => { return "pravash::grid"; }
        3 => { return "pravash::mpm"; }
        4 => { return "pravash::phase_field"; }
        5 => { return "pravash::shallow"; }
        6 => { return "pravash::sph"; }
        7 => { return "pravash::vof"; }
        _ => { return ""; }
    }
    return "";
}

# Each target's level once pravash's init has set them (`_pv_log_filtered` 1), else unused.
var _pv_log_levels: i64[8];
var _pv_log_filtered = 0;
var _pv_log_init_done = 0;

# The level target t enables: pravash's filter once its init ran, else sakshi's level.
#must_use
fn _pv_log_level(t): i64 {
    if (_pv_log_filtered == 1) { return _pv_log_levels[t]; }
    return sakshi_get_level();
}

# ── the filter ──────────────────────────────────────────────────────────────────────

# 1 when byte c is ASCII whitespace (str::trim's, for the bytes an environment variable holds).
#must_use
fn _pv_log_ws(c): i64 {
    if (c == 32 || (c >= 9 && c <= 13)) { return 1; }
    return 0;
}

# The level LevelFilter::from_str reads from the n bytes at p (an unsigned integer 0–5 with an optional `+`, a level
# name in any case, or "" for error), or -1.
#must_use
fn _pv_log_parse_level(p, n): i64 {
    if (n == 0) { return _PV_LOG_ERROR; }
    var i = 0;
    if (load8(p) == 43 && n > 1) { i = 1; }
    var v = 0;
    var digits = 1;
    for (var k = i; k < n; k = k + 1) {
        var c = load8(p + k);
        if (c < 48 || c > 57) {
            digits = 0;
        } elif (v < 100) {
            v = v * 10 + (c - 48);
        }
    }
    if (digits == 1) {
        if (v <= 5) { return v; }
        return 0 - 1;
    }
    if (n == 3 && _pv_log_ieq(p, "off", 3) == 1) { return 0; }
    if (n == 5 && _pv_log_ieq(p, "error", 5) == 1) { return 1; }
    if (n == 4 && _pv_log_ieq(p, "warn", 4) == 1) { return 2; }
    if (n == 4 && _pv_log_ieq(p, "info", 4) == 1) { return 3; }
    if (n == 5 && _pv_log_ieq(p, "debug", 5) == 1) { return 4; }
    if (n == 5 && _pv_log_ieq(p, "trace", 5) == 1) { return 5; }
    return 0 - 1;
}

# 1 when the n bytes at p equal the lowercase ASCII word w, ignoring case.
#must_use
fn _pv_log_ieq(p, w, n): i64 {
    for (var k = 0; k < n; k = k + 1) {
        var c = load8(p + k);
        if (c >= 65 && c <= 90) { c = c + 32; }
        if (c != load8(w + k)) { return 0; }
    }
    return 1;
}

# 1 when byte c may start a directive's target or level (Rust's `-`, `:`, `_` or alphanumeric; a non-ASCII byte
# counts as alphanumeric, as most such characters are).
#must_use
fn _pv_log_word_byte(c): i64 {
    if (c == 45 || c == 58 || c == 95 || c >= 128) { return 1; }
    if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)) { return 1; }
    return 0;
}

# One directive (the m bytes at s, untrimmed, holding no comma), as EnvFilter's Directive::parse reads it, into the
# words at w: w[0] its level, w[1] its target's pointer (0 for none), w[2] the target's length. Returns 0 for a static
# directive, 1 for one with a span name or fields (w unset), or -1 for one that doesn't parse.
fn _pv_log_directive(s, m, w): i64 {
    var a = 0;
    while (a < m && _pv_log_ws(load8(s + a)) == 1) { a = a + 1; }
    var b = m;
    while (b > a && _pv_log_ws(load8(s + b - 1)) == 1) { b = b - 1; }
    # The states (Rust's ParseState): 0 Start, 1 LevelOrTarget, 2 Span, 3 Field, 4 Fields, 5 Target, 6 Level.
    var st = 0;
    var mark = 0;
    var dynamic = 0;
    store64(w + 8, 0);
    store64(w + 16, 0);
    # The walk's index k counts the trimmed bytes; slices index the untrimmed ones (Rust's `from[start..i]`).
    for (var k = 0; k < b - a; k = k + 1) {
        var c = load8(s + a + k);
        if (st == 0) {
            if (c == 91) {
                st = 2;
                mark = k + 1;
            } elif (_pv_log_word_byte(c) == 1) {
                st = 1;
                mark = k;
            } else {
                return 0 - 1;
            }
        } elif (st == 1) {
            if (c == 61) {
                store64(w + 8, s + mark);
                store64(w + 16, k - mark);
                st = 6;
                mark = k + 1;
            } elif (c == 91) {
                store64(w + 8, s + mark);
                store64(w + 16, k - mark);
                st = 2;
                mark = k + 1;
            }
        } elif (st == 2) {
            if (c == 93) {
                dynamic = 1;
                st = 5;
            } elif (c == 123) {
                dynamic = 1;
                st = 3;
                mark = k + 1;
            }
        } elif (st == 3) {
            if (c == 125) {
                if (k == mark) { return 0 - 1; }
                st = 4;
            }
        } elif (st == 4) {
            if (c != 93) { return 0 - 1; }
            st = 5;
        } elif (st == 5) {
            if (c != 61) { return 0 - 1; }
            st = 6;
            mark = k + 1;
        }
    }
    if (st == 1) {
        # `level` or `target`: a word that reads as a level is one, any other a target at trace.
        var lv = _pv_log_parse_level(s + mark, m - mark);
        if (lv >= 0) {
            store64(w, lv);
        } else {
            store64(w, _PV_LOG_TRACE);
            store64(w + 8, s + mark);
            store64(w + 16, m - mark);
        }
    } elif (st == 6) {
        var lv2 = _pv_log_parse_level(s + mark, m - mark);
        if (m == mark) { lv2 = _PV_LOG_TRACE; }
        if (lv2 < 0) { return 0 - 1; }
        store64(w, lv2);
    } elif (st == 5) {
        store64(w, _PV_LOG_TRACE);
    } elif (st == 0) {
        # An all-whitespace directive: Rust's loop never runs and the Start state ends in error.
        return 0 - 1;
    } else {
        return 0 - 1;
    }
    return dynamic;
}

# Applies the static directive at w to the per-target (rank, level) words at best (two per target): the directive
# decides target t when its target prefixes t's name and is at least as long as the deciding one so far (a directive
# without a target ranks -1, below any).
fn _pv_log_apply(w, best) {
    var tp = load64(w + 8);
    var tn = load64(w + 16);
    var rank = 0 - 1;
    if (tp != 0) { rank = tn; }
    for (var t = 0; t < _PV_LOG_TARGETS; t = t + 1) {
        var name = _pv_log_target_name(t);
        var hit = 1;
        if (tp != 0 && tn > 0) {
            if (tn > strlen(name) || memeq(name, tp, tn) != 1) { hit = 0; }
        }
        if (hit == 1 && rank >= load64(best + t * 16)) {
            store64(best + t * 16, rank);
            store64(best + t * 16 + 8, load64(w));
        }
    }
    return 0;
}

# The directives in the n bytes at p into the per-target levels at out (8 words): EnvFilter's `parse` (strict 1:
# returns 0, out untouched, when one directive doesn't parse) or `parse_lossy` (0: skips it, and makes the filter
# error when nothing is left). Returns 1 when out was set.
fn _pv_log_parse(p, n, strict, out): i64 {
    var best[128];
    for (var t = 0; t < _PV_LOG_TARGETS; t = t + 1) {
        store64(&best + t * 16, 0 - 2);
        store64(&best + t * 16 + 8, 0);
    }
    var any = 0;
    var w[24];
    var start = 0;
    for (var i = 0; i <= n; i = i + 1) {
        if (i == n || load8(p + i) == 44) {
            if (i > start) {
                var kind = _pv_log_directive(p + start, i - start, &w);
                if (kind < 0 && strict == 1) { return 0; }
                if (kind >= 0) { any = 1; }
                if (kind == 0) { _pv_log_apply(&w, &best); }
            }
            start = i + 1;
        }
    }
    if (any == 0 && strict == 0) {
        # EnvFilter::new's default directive, `error` for every target.
        store64(&w, _PV_LOG_ERROR);
        store64(&w + 8, 0);
        store64(&w + 16, 0);
        _pv_log_apply(&w, &best);
    }
    for (var t2 = 0; t2 < _PV_LOG_TARGETS; t2 = t2 + 1) {
        var lv = 0;
        if (load64(&best + t2 * 16) > 0 - 2) { lv = load64(&best + t2 * 16 + 8); }
        store64(out + t2 * 8, lv);
    }
    return 1;
}

# The level each target enables under `init_with_level`'s filter, into the 8 words at out: PRAVASH_LOG's n bytes at
# env (has 0 when it is unset) when they parse, else the dn bytes of the default at dflt.
fn _pv_log_filter(env, n, has, dflt, dn, out) {
    if (has == 1 && _pv_log_parse(env, n, 1, out) == 1) { return 0; }
    var r = _pv_log_parse(dflt, dn, 0, out);
    return r - 1;
}

# ── init ────────────────────────────────────────────────────────────────────────────

# `logging_init_with_level("info", 4)`. Mirrors `logging::init`.
fn logging_init(): i64 {
    return logging_init_with_level("info", 4);
}

# Sets each target's level from PRAVASH_LOG, or from the `len` bytes of the default directives at `level` (above), and
# sends sakshi's text to stdout: 1, or 0 when an init already ran (nothing changes). Mirrors `logging::init_with_level`.
fn logging_init_with_level(level, len): i64 {
    if (_pv_log_init_done == 1) { return 0; }
    _pv_log_init_done = 1;
    var env = getenv("PRAVASH_LOG");
    var has = 0;
    var n = 0;
    if (env != 0) {
        has = 1;
        n = strlen(env);
    }
    var lv[64];
    _pv_log_filter(env, n, has, level, len, &lv);
    var max = 0;
    for (var t = 0; t < _PV_LOG_TARGETS; t = t + 1) {
        _pv_log_levels[t] = load64(&lv + t * 8);
        if (load64(&lv + t * 8) > max) { max = load64(&lv + t * 8); }
    }
    _pv_log_filtered = 1;
    # sakshi gates its lines by one level; pravash's per-target gate comes first.
    sakshi_set_level(max);
    sakshi_set_output_fd(1);
    return 1;
}

# ── spans and events ────────────────────────────────────────────────────────────────

# The span texts, one 128-byte slot per sakshi depth (sakshi keeps the name's pointer until the span exits), and each
# slot's target; and the last event's text, target and parts, for the trace writer.
var _pv_span_text: u8[2048];
var _pv_span_tgt: i64[16];
var _pv_event_text: u8[256];
var _pv_event_tgt = 0;
var _pv_event_msg_len = 0;

# Appends the decimal of v at p + n (room checked against cap): the new length.
fn _pv_log_put_int(p, n, cap, v): i64 {
    var d[24];
    var nd = 0;
    var neg = 0;
    var u = v;
    if (v < 0) {
        neg = 1;
        u = 0 - v;
    }
    while (nd == 0 || u != 0) {
        store8(&d + nd, 48 + (u % 10));
        u = u / 10;
        nd = nd + 1;
    }
    if (neg == 1 && n < cap) {
        store8(p + n, 45);
        n = n + 1;
    }
    for (var k = nd - 1; k >= 0; k = k - 1) {
        if (n < cap) {
            store8(p + n, load8(&d + k));
            n = n + 1;
        }
    }
    return n;
}

# Appends the C string s at p + n (to cap): the new length.
fn _pv_log_put(p, n, cap, s): i64 {
    var m = strlen(s);
    for (var k = 0; k < m; k = k + 1) {
        if (n < cap) {
            store8(p + n, load8(s + k));
            n = n + 1;
        }
    }
    return n;
}

# Appends ` k=v` for each named field (a 0 name ends them) at p + n (to cap): the new length. `first` writes the first
# without its space.
fn _pv_log_put_fields(p, n, cap, first, k1, v1, k2, v2, k3, v3): i64 {
    var sep = 1 - first;
    if (k1 != 0) {
        if (sep == 1) { n = _pv_log_put(p, n, cap, " "); }
        n = _pv_log_put(p, n, cap, k1);
        n = _pv_log_put(p, n, cap, "=");
        n = _pv_log_put_int(p, n, cap, v1);
        if (k2 != 0) {
            n = _pv_log_put(p, n, cap, " ");
            n = _pv_log_put(p, n, cap, k2);
            n = _pv_log_put(p, n, cap, "=");
            n = _pv_log_put_int(p, n, cap, v2);
            if (k3 != 0) {
                n = _pv_log_put(p, n, cap, " ");
                n = _pv_log_put(p, n, cap, k3);
                n = _pv_log_put(p, n, cap, "=");
                n = _pv_log_put_int(p, n, cap, v3);
            }
        }
    }
    return n;
}

# Enters the TRACE span `name` of target t, with up to three integer fields (a 0 name ends them), when t enables
# TRACE: 1, or 0 when it didn't (nothing happened). Every path out of the traced operation then calls
# `_pv_span_end` with the result (a `defer`). Mirrors `trace_span!(name, k1 = v1, …).entered()`.
fn _pv_span(t, name, k1, v1, k2, v2, k3, v3): i64 {
    if (_pv_log_level(t) < _PV_LOG_TRACE) { return 0; }
    var d = sakshi_span_depth();
    if (d < 0 || d >= 16) { return 0; }
    var slot = &_pv_span_text + d * 128;
    var n = _pv_log_put(slot, 0, 127, name);
    if (k1 != 0) {
        n = _pv_log_put(slot, n, 127, "{");
        n = _pv_log_put_fields(slot, n, 127, 1, k1, v1, k2, v2, k3, v3);
        n = _pv_log_put(slot, n, 127, "}");
    }
    _pv_span_tgt[d] = t;
    if (sakshi_span_enter(slot, n) != 0) { return 0; }
    return 1;
}

# Exits the span `_pv_span` entered (on 1), or does nothing (on 0).
fn _pv_span_end(on) {
    if (on == 1) { var e = sakshi_span_exit(); }
    return 0;
}

# Emits the WARN event `message k1=v1 …` (a 0 name ends the fields) of target t when t enables WARN, as the sakshi
# line `pravash::<module>: message k1=v1 …`. Mirrors `tracing::warn!(k1, …, "message")`.
fn _pv_warn(t, message, k1, v1, k2, v2, k3, v3) {
    if (_pv_log_level(t) < _PV_LOG_WARN) { return 0; }
    var p = &_pv_event_text;
    var n = _pv_log_put(p, 0, 255, _pv_log_target_name(t));
    n = _pv_log_put(p, n, 255, ": ");
    var m0 = n;
    n = _pv_log_put(p, n, 255, message);
    _pv_event_msg_len = n - m0;
    n = _pv_log_put_fields(p, n, 255, 0, k1, v1, k2, v2, k3, v3);
    _pv_event_tgt = t;
    sakshi_warn(p, n);
    return 0;
}

# ── the Trace Event writer (ledger L11) ─────────────────────────────────────────────
# tracing-chrome 0.7.2's file: `[`, entries joined by `,\n`, `\n]`; each entry serde_json's map, keys in order
# (args, cat, name, ph, pid, s, tid, ts); a "M" thread_name entry for the main thread first; "B" / "E" for a span's
# enter and exit with its fields as args (strings, the Debug of each value); "i" (scope "t") for an event, its
# message and fields as args. ts is µs since the writer's first entry. tracing-chrome's `.file` / `.line` (the Rust
# source location) have no Cyrius counterpart and are left out, as is an event's `event <file>:<line>` name: here
# `event <target>` (ADR 0002 #28).

# The guard `logging_init_profiling` fills: the file, and whether the writer is installed. Mirrors
# `tracing_chrome::FlushGuard`.
struct PvFlushGuard {
    fd;
    active;
}

var _pv_tr_fd = 0 - 1;
var _pv_tr_prev_level = 0;
var _pv_tr_path: u8[64];

# The path of the last trace file logging_init_profiling created (a C string; "" before one).
#must_use
fn _pv_trace_path(): i64 {
    return &_pv_tr_path;
}
var _pv_tr_buf: u8[8192];
var _pv_tr_len = 0;
var _pv_tr_count = 0;
var _pv_tr_t0 = 0;

# Writes the buffer out.
fn _pv_tr_flush() {
    if (_pv_tr_fd >= 0 && _pv_tr_len > 0) { var w = file_write(_pv_tr_fd, &_pv_tr_buf, _pv_tr_len); }
    _pv_tr_len = 0;
    return 0;
}

# Appends the n bytes at p to the file's buffer.
fn _pv_tr_put_n(p, n) {
    for (var k = 0; k < n; k = k + 1) {
        if (_pv_tr_len >= 8192) { _pv_tr_flush(); }
        store8(&_pv_tr_buf + _pv_tr_len, load8(p + k));
        _pv_tr_len = _pv_tr_len + 1;
    }
    return 0;
}

# Appends the C string s.
fn _pv_tr_put(s) {
    _pv_tr_put_n(s, strlen(s));
    return 0;
}

# Appends the n bytes at p as a JSON string (pravash's texts are plain ASCII; a quote, backslash or control byte is
# escaped all the same).
fn _pv_tr_str(p, n) {
    _pv_tr_put("\"");
    for (var k = 0; k < n; k = k + 1) {
        var c = load8(p + k);
        if (c == 34 || c == 92) {
            _pv_tr_put("\\");
            _pv_tr_put_n(p + k, 1);
        } elif (c < 32) {
            _pv_tr_put(" ");
        } else {
            _pv_tr_put_n(p + k, 1);
        }
    }
    _pv_tr_put("\"");
    return 0;
}

# Appends the integer v.
fn _pv_tr_int(v) {
    var b[24];
    var n = _pv_log_put_int(&b, 0, 24, v);
    _pv_tr_put_n(&b, n);
    return 0;
}

# Appends the args object of the fields in `name{k=v k=v}` or `k=v k=v` (the n bytes at p): `"args":{"k":"v",…},`,
# or nothing when there are none.
fn _pv_tr_args(p, n) {
    if (n <= 0) { return 0; }
    _pv_tr_put("\"args\":{");
    var i = 0;
    var first = 1;
    while (i < n) {
        var k0 = i;
        while (i < n && load8(p + i) != 61) { i = i + 1; }
        var kn = i - k0;
        i = i + 1;
        var v0 = i;
        while (i < n && load8(p + i) != 32) { i = i + 1; }
        if (first == 0) { _pv_tr_put(","); }
        first = 0;
        _pv_tr_str(p + k0, kn);
        _pv_tr_put(":");
        _pv_tr_str(p + v0, i - v0);
        i = i + 1;
    }
    _pv_tr_put("},");
    return 0;
}

# Starts an entry: the `,\n` between entries, and the main thread's name before the first.
fn _pv_tr_entry(ts) {
    if (_pv_tr_count == 0) {
        _pv_tr_t0 = ts;
        _pv_tr_put("{\"args\":{\"name\":\"main\"},\"name\":\"thread_name\",\"ph\":\"M\",\"pid\":1,\"tid\":1}");
        _pv_tr_count = 1;
    }
    _pv_tr_put(",\n{");
    _pv_tr_count = _pv_tr_count + 1;
    return 0;
}

# Ends an entry with its phase, the pid and tid, and ts (µs since the first entry, with its ns as three decimals).
fn _pv_tr_end(ph, scope, ts) {
    _pv_tr_put("\"ph\":\"");
    _pv_tr_put(ph);
    _pv_tr_put("\",\"pid\":1,");
    if (scope == 1) { _pv_tr_put("\"s\":\"t\","); }
    _pv_tr_put("\"tid\":1,\"ts\":");
    var d = ts - _pv_tr_t0;
    if (d < 0) { d = 0; }
    _pv_tr_int(d / 1000);
    var f[8];
    var r = d % 1000;
    store8(&f, 46);
    store8(&f + 1, 48 + r / 100);
    store8(&f + 2, 48 + (r / 10) % 10);
    store8(&f + 3, 48 + r % 10);
    _pv_tr_put_n(&f, 4);
    _pv_tr_put("}");
    return 0;
}

# sakshi's emit hook while profiling: a span's enter / exit (level 10 / 11) and every event, as Trace Event entries.
# A span pravash entered carries its target and fields; anyone else's has an empty category and no args. An event
# pravash emitted carries its target, message and fields; anyone else's, its text as the message.
fn _pv_tr_hook(ts, level, category, msg, msg_len, sixth): i64 {
    if (_pv_tr_fd < 0) { return 0; }
    if (level == 10 || level == 11) {
        _pv_tr_entry(ts);
        var own = 0;
        if (msg >= &_pv_span_text && msg < &_pv_span_text + 2048) { own = 1; }
        var nb = msg_len;
        for (var k = 0; k < msg_len; k = k + 1) {
            if (nb == msg_len && load8(msg + k) == 123) { nb = k; }
        }
        if (own == 1 && nb < msg_len) { _pv_tr_args(msg + nb + 1, msg_len - nb - 2); }
        _pv_tr_put("\"cat\":");
        if (own == 1) {
            var slot = (msg - &_pv_span_text) / 128;
            var tn = _pv_log_target_name(_pv_span_tgt[slot]);
            _pv_tr_str(tn, strlen(tn));
        } else {
            _pv_tr_put("\"\"");
        }
        _pv_tr_put(",\"name\":");
        _pv_tr_str(msg, nb);
        _pv_tr_put(",");
        if (level == 10) { _pv_tr_end("B", 0, ts); } else { _pv_tr_end("E", 0, ts); }
        return 0;
    }
    _pv_tr_entry(ts);
    if (msg == &_pv_event_text) {
        var tname = _pv_log_target_name(_pv_event_tgt);
        var tl = strlen(tname);
        var m0 = msg + tl + 2;
        _pv_tr_put("\"args\":{\"message\":");
        _pv_tr_str(m0, _pv_event_msg_len);
        var rest = msg_len - tl - 2 - _pv_event_msg_len;
        if (rest > 1) {
            _pv_tr_put(",");
            # The fields after the message: ` k=v k=v` as "k":"v" pairs.
            var fp = m0 + _pv_event_msg_len + 1;
            var fl = rest - 1;
            var i = 0;
            var first = 1;
            while (i < fl) {
                var k0 = i;
                while (i < fl && load8(fp + i) != 61) { i = i + 1; }
                var kn = i - k0;
                i = i + 1;
                var v0 = i;
                while (i < fl && load8(fp + i) != 32) { i = i + 1; }
                if (first == 0) { _pv_tr_put(","); }
                first = 0;
                _pv_tr_str(fp + k0, kn);
                _pv_tr_put(":");
                _pv_tr_str(fp + v0, i - v0);
                i = i + 1;
            }
        }
        _pv_tr_put("},\"cat\":");
        _pv_tr_str(tname, tl);
        _pv_tr_put(",\"name\":");
        var en[64];
        var enn = _pv_log_put(&en, 0, 64, "event ");
        enn = _pv_log_put(&en, enn, 64, tname);
        _pv_tr_str(&en, enn);
    } else {
        _pv_tr_put("\"args\":{\"message\":");
        _pv_tr_str(msg, msg_len);
        _pv_tr_put("},\"cat\":\"\",\"name\":\"event\"");
    }
    _pv_tr_put(",");
    _pv_tr_end("i", 1, ts);
    return 0;
}

# Starts chrome://tracing output to `trace-<unix µs>.json` in the working directory and fills *guard: 1, or 0 when the
# file can't be created. Every target then enables TRACE through sakshi's hook, which the writer takes over; when an
# init already ran, the file is written empty instead (Rust's: its layer isn't registered when a subscriber is). The
# trace is closed by PvFlushGuard_drop. Mirrors `logging::init_profiling`.
#must_use
fn logging_init_profiling(guard: *PvFlushGuard): i64 {
    guard.fd = 0 - 1;
    guard.active = 0;
    var name[64];
    var n = _pv_log_put(&name, 0, 63, "trace-");
    n = _pv_log_put_int(&name, n, 63, clock_epoch_ns() / 1000);
    n = _pv_log_put(&name, n, 63, ".json");
    store8(&name + n, 0);
    memcpy(&_pv_tr_path, &name, n + 1);
    var fd = file_open(&name, O_WRONLY | O_CREAT | O_TRUNC, 420);
    if (fd < 0) { return 0; }
    guard.fd = fd;
    _pv_tr_fd = fd;
    _pv_tr_len = 0;
    _pv_tr_count = 0;
    _pv_tr_put("[\n");
    if (_pv_log_init_done == 1) { return 1; }
    _pv_log_init_done = 1;
    for (var t = 0; t < _PV_LOG_TARGETS; t = t + 1) { _pv_log_levels[t] = _PV_LOG_TRACE; }
    _pv_log_filtered = 1;
    _pv_tr_prev_level = sakshi_get_level();
    sakshi_set_level(SK_TRACE);
    sakshi_set_emit_hook(&_pv_tr_hook);
    guard.active = 1;
    return 1;
}

impl PvFlushGuard {
    # Writes out what the trace holds so far. Mirrors `FlushGuard::flush`.
    fn flush(self) {
        if (self.fd >= 0 && self.fd == _pv_tr_fd) { _pv_tr_flush(); }
        return 0;
    }
}

# Ends the trace: closes the entry list and the file, and removes the hook. pravash then traces nothing (every
# target off) and sakshi has its level from before and writes to stderr: Rust's chrome layer stays installed and
# writes nowhere, so nothing is printed either. Mirrors dropping the `FlushGuard`.
fn PvFlushGuard_drop(guard: *PvFlushGuard) {
    if (guard.fd < 0 || guard.fd != _pv_tr_fd) { return 0; }
    if (guard.active == 1) {
        var c = sakshi_clear_emit_hook();
        for (var t = 0; t < _PV_LOG_TARGETS; t = t + 1) { _pv_log_levels[t] = 0; }
        var l = sakshi_set_level(_pv_tr_prev_level);
    }
    _pv_tr_put("\n]");
    _pv_tr_flush();
    var r = file_close(guard.fd);
    _pv_tr_fd = 0 - 1;
    guard.fd = 0 - 1;
    guard.active = 0;
    return 0;
}

# --- vec3.cyr ---

# vec3.cyr — glam's `DVec3`, the operations pravash calls (port plan §7.2).
#
# `PvVec3` is a 24-byte value, stored inline in the records that hold one (`PvFluidParticle.position`). Each
# operation is glam 0.29.3's (`src/f64/dvec3.rs`) in its exact order: `dot` is (x·x' + y·y') + z·z', `length`
# its square root, `distance` the length of the difference, with no fused operations, as rustc compiles them. So
# the results have the oracle's bits (class A). Operations arrive with the modules that call them. Hot loops read
# the components into f64 locals instead of passing values (port-parity §4.2: a struct value costs 2.5×).
#
# UPSTREAM(L3): hisab:docs/development/issues/2026-11-09-allocator-scoped-calls.md
#   replace with hisab's vector forms (`hvec3_*`) once a call's allocation can be scoped (each result allocates
#   24 B today, port-parity §4.1); parity: every row that goes through a vector operation.

struct PvVec3 { x: f64; y: f64; z: f64; }

# (x, y, z). Mirrors `DVec3::new`.
#must_use
fn PvVec3_new(x: f64, y: f64, z: f64): PvVec3 {
    var v: PvVec3;
    v.x = x;
    v.y = y;
    v.z = z;
    return v;
}

# (0, 0, 0). Mirrors `DVec3::ZERO`.
#must_use
fn PvVec3_zero(): PvVec3 {
    var v: PvVec3;
    v.x = 0.0;
    v.y = 0.0;
    v.z = 0.0;
    return v;
}

impl PvVec3 {
    # (x·x' + y·y') + z·z'. Mirrors `DVec3::dot`.
    #must_use
    fn dot(self, rhs: PvVec3): f64 {
        var d: f64 = ((self.x * rhs.x) + (self.y * rhs.y)) + (self.z * rhs.z);
        return d;
    }

    # The squared length, self·self. Mirrors `DVec3::length_squared`.
    #must_use
    fn length_squared(self): f64 {
        var d: f64 = ((self.x * self.x) + (self.y * self.y)) + (self.z * self.z);
        return d;
    }

    # √(self·self). Mirrors `DVec3::length`.
    #must_use
    fn length(self): f64 {
        var d: f64 = ((self.x * self.x) + (self.y * self.y)) + (self.z * self.z);
        var r: f64 = f64_sqrt(d);
        return r;
    }

    # |self − rhs|², the difference formed first. Mirrors `DVec3::distance_squared`.
    #must_use
    fn distance_squared(self, rhs: PvVec3): f64 {
        var dx: f64 = self.x - rhs.x;
        var dy: f64 = self.y - rhs.y;
        var dz: f64 = self.z - rhs.z;
        var d: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
        return d;
    }

    # |self − rhs|. Mirrors `DVec3::distance`.
    #must_use
    fn distance(self, rhs: PvVec3): f64 {
        var dx: f64 = self.x - rhs.x;
        var dy: f64 = self.y - rhs.y;
        var dz: f64 = self.z - rhs.z;
        var d: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
        var r: f64 = f64_sqrt(d);
        return r;
    }

    # 1 when no component is infinite or NaN. Mirrors `DVec3::is_finite`.
    #must_use
    fn is_finite(self): i64 {
        if (_pv_is_finite(self.x) == 0) { return 0; }
        if (_pv_is_finite(self.y) == 0) { return 0; }
        return _pv_is_finite(self.z);
    }
}

# --- column.cyr ---

# column.cyr — a growable column of 8-byte slots on the freelist: what `ParticleSoa`'s `Vec<f64>` and `Vec<u8>`
# fields become (port plan §7.3).
#
# A `PvColumn` is (data, len, cap) by value, with its slots on the freelist: `push` doubles the capacity and
# frees the outgrown buffer, and `drop` releases it, so a column never grows the bump heap. An f64 slot holds the
# value's bits (`get_f` / `set_f` / `push_f`); a word slot holds an integer (`get` / `set` / `push`; the SoA's
# phase, a Rust u8). Nothing aborts (ADR 0002 #8):
# - an index out of range reads NaN (`get_f`) or 0 (`get`) and writes nothing (`set*` return 0), where Rust's
#   `v[i]` panics;
# - an allocation failure leaves the column as it was and returns 0, where Rust's `push` aborts.
#
# UPSTREAM(L13): cyrius:docs/development/issues/2026-11-11-vec-keeps-outgrown-buffer-and-aborts.md
#   replace with the stdlib `vec` once `vec_push_a` frees the outgrown buffer through its Allocator and an
#   out-of-range access returns instead of aborting; parity: the ParticleSoa rows of tests/golden/common.tsv.

struct PvColumn { data; len; cap; }

# An empty column (no storage until the first push or reserve). Mirrors `Vec::new`.
#must_use
fn PvColumn_new(): PvColumn {
    var c: PvColumn;
    c.data = 0;
    c.len = 0;
    c.cap = 0;
    return c;
}

impl PvColumn {
    # The number of slots in use. Mirrors `Vec::len`.
    #must_use
    fn len(self): i64 {
        return self.len;
    }

    # Room for at least `n` slots: 1, or 0 when the memory isn't there (the column unchanged). Mirrors
    # `Vec::reserve` to a total of n.
    #must_use
    fn reserve(self, n): i64 {
        if (n <= self.cap) { return 1; }
        var d = fl_alloc(n * 8);
        if (d == 0) { return 0; }
        if (self.len > 0) { memcpy(d, self.data, self.len * 8); }
        if (self.data != 0) { fl_free(self.data); }
        self.data = d;
        self.cap = n;
        return 1;
    }

    # Appends the word w: 1, or 0 when the column can't grow (unchanged). The capacity doubles from 8.
    # Mirrors `Vec::push`.
    #must_use
    fn push(self, w): i64 {
        if (self.len == self.cap) {
            var want = self.cap * 2;
            if (want < 8) { want = 8; }
            if (self.reserve(want) == 0) { return 0; }
        }
        store64(self.data + self.len * 8, w);
        self.len = self.len + 1;
        return 1;
    }

    # Appends x's bits. Mirrors `Vec::<f64>::push`.
    #must_use
    fn push_f(self, x: f64): i64 {
        return self.push(_pv_bits(x));
    }

    # Slot i as an f64, unchecked: for loops that have checked the length (hot paths read this, not get_f).
    #must_use
    fn at(self, i): f64 {
        var x: f64 = load64(self.data + i * 8);
        return x;
    }

    # Slot i as a word, or 0 out of range. Mirrors `v[i]` on a `Vec<u8>`.
    #must_use
    fn get(self, i): i64 {
        if (i < 0 || i >= self.len) { return 0; }
        return load64(self.data + i * 8);
    }

    # Slot i as an f64, or NaN out of range. Mirrors `v[i]` on a `Vec<f64>`.
    #must_use
    fn get_f(self, i): f64 {
        if (i < 0 || i >= self.len) {
            var nan: f64 = PV_F64_NAN;
            return nan;
        }
        var x: f64 = load64(self.data + i * 8);
        return x;
    }

    # Sets slot i to the word w: 1, or 0 out of range (nothing written). Mirrors `v[i] = w`.
    fn set(self, i, w): i64 {
        if (i < 0 || i >= self.len) { return 0; }
        store64(self.data + i * 8, w);
        return 1;
    }

    # Sets slot i to x: 1, or 0 out of range. Mirrors `v[i] = x`.
    fn set_f(self, i, x: f64): i64 {
        return self.set(i, _pv_bits(x));
    }

    # Grows the column to `n` slots, each new one the word w, or shortens it to `n`: 1, or 0 when it can't grow
    # (unchanged). Mirrors `Vec::resize`.
    #must_use
    fn resize(self, n, w): i64 {
        if (n < 0) { return 0; }
        if (n <= self.len) {
            self.len = n;
            return 1;
        }
        if (self.reserve(n) == 0) { return 0; }
        for (var i = self.len; i < n; i = i + 1) { store64(self.data + i * 8, w); }
        self.len = n;
        return 1;
    }

    # Every slot set to the word w. Mirrors `slice::fill`.
    fn fill(self, w) {
        for (var i = 0; i < self.len; i = i + 1) { store64(self.data + i * 8, w); }
        return 0;
    }

    # Every slot set to x. Mirrors `slice::fill` on a `Vec<f64>` (`sw.manning_n.fill(0.025)`).
    fn fill_f(self, x: f64) {
        self.fill(_pv_bits(x));
        return 0;
    }

    # Copies `src`'s slots over this column's, which must be as long (0 and nothing copied otherwise). Mirrors
    # `slice::copy_from_slice` (which panics on a length mismatch).
    fn copy_from(self, src: *PvColumn): i64 {
        if (src.len != self.len) { return 0; }
        for (var i = 0; i < self.len; i = i + 1) { store64(self.data + i * 8, load64(src.data + i * 8)); }
        return 1;
    }

    # Shortens the column to `n` slots (no effect when it is not longer). Mirrors `Vec::truncate`.
    fn truncate(self, n) {
        if (n >= 0 && n < self.len) { self.len = n; }
        return 0;
    }

    # Releases the storage; the column is empty and usable again. Mirrors dropping the `Vec`.
    fn drop(self) {
        if (self.data != 0) { fl_free(self.data); }
        self.data = 0;
        self.len = 0;
        self.cap = 0;
        return 0;
    }
}

# Swaps two column records (their storage, length and capacity), as `std::mem::swap` swaps two Vecs.
fn _pv_col_swap(a: *PvColumn, b: *PvColumn) {
    var d = a.data;
    var l = a.len;
    var c = a.cap;
    a.data = b.data;
    a.len = b.len;
    a.cap = b.cap;
    b.data = d;
    b.len = l;
    b.cap = c;
    return 0;
}

# --- common.cyr ---

# common.cyr — shared fluid types: materials, particles, configuration, the SoA layout and the particle arena
# (port of rust-old/src/common.rs).
#
# Shapes (port plan §7.3, ADR 0002 #1, #8 and #9):
# - `PvFluidParticle` is a 144-byte record laid out as Rust's `FluidParticle` (probe 2, port-parity §4.2): three
#   `PvVec3`s, density, pressure, mass, the phase as a word (Rust's u8, 0–255), the conformation tensor as an
#   inline (f64, f64, f64) tuple, temperature and fuel. Particle buffers are typed stride arrays plus a count.
# - A fallible function returns a value-form Result with a `PV_ERR_*` code. One that builds a struct writes it
#   through an `out` pointer and returns `Ok(0)`.
# - `Option<ArenaHandle>` is an `out` pointer plus 1 (Some) or 0 (None); a slice is (pointer, count).
# - Nothing aborts: where Rust panics (an index out of range) or aborts (out of memory), the call returns NaN,
#   0, (0, 0) or 0 for failure, as each function says.
# - Owned storage is freelist (`fl_alloc`), released by the type's `_drop`.
# - Rust's `tracing::warn!` on a stale or double-freed arena handle arrives with M7's logging (sakshi).

# ── FluidMaterial ───────────────────────────────────────────────────────────────────

# Physical properties of a fluid material: rest density (kg/m³), dynamic viscosity (Pa·s), surface tension
# (N/m) and the speed of sound (m/s). Mirrors `FluidMaterial`.
struct PvFluidMaterial {
    density: f64;
    viscosity: f64;
    surface_tension: f64;
    speed_of_sound: f64;
}

# The presets, from the generated constants (src/constants.cyr). Mirror `FluidMaterial::WATER`, `OIL`,
# `HONEY`, `AIR` and `LAVA`; copy one (`var m: PvFluidMaterial = PV_FLUID_MATERIAL_WATER;`), never assign to it.
var PV_FLUID_MATERIAL_WATER: PvFluidMaterial = PvFluidMaterial { PV_FLUID_MATERIAL_WATER_DENSITY,
    PV_FLUID_MATERIAL_WATER_VISCOSITY, PV_FLUID_MATERIAL_WATER_SURFACE_TENSION,
    PV_FLUID_MATERIAL_WATER_SPEED_OF_SOUND };
var PV_FLUID_MATERIAL_OIL: PvFluidMaterial = PvFluidMaterial { PV_FLUID_MATERIAL_OIL_DENSITY,
    PV_FLUID_MATERIAL_OIL_VISCOSITY, PV_FLUID_MATERIAL_OIL_SURFACE_TENSION, PV_FLUID_MATERIAL_OIL_SPEED_OF_SOUND };
var PV_FLUID_MATERIAL_HONEY: PvFluidMaterial = PvFluidMaterial { PV_FLUID_MATERIAL_HONEY_DENSITY,
    PV_FLUID_MATERIAL_HONEY_VISCOSITY, PV_FLUID_MATERIAL_HONEY_SURFACE_TENSION,
    PV_FLUID_MATERIAL_HONEY_SPEED_OF_SOUND };
var PV_FLUID_MATERIAL_AIR: PvFluidMaterial = PvFluidMaterial { PV_FLUID_MATERIAL_AIR_DENSITY,
    PV_FLUID_MATERIAL_AIR_VISCOSITY, PV_FLUID_MATERIAL_AIR_SURFACE_TENSION, PV_FLUID_MATERIAL_AIR_SPEED_OF_SOUND };
var PV_FLUID_MATERIAL_LAVA: PvFluidMaterial = PvFluidMaterial { PV_FLUID_MATERIAL_LAVA_DENSITY,
    PV_FLUID_MATERIAL_LAVA_VISCOSITY, PV_FLUID_MATERIAL_LAVA_SURFACE_TENSION,
    PV_FLUID_MATERIAL_LAVA_SPEED_OF_SOUND };

# A material from its four properties, validated in Rust's order: the density finite and > 0
# (PV_ERR_INVALID_DENSITY), the viscosity finite and ≥ 0 (PV_ERR_INVALID_VISCOSITY), the surface tension finite and
# ≥ 0, the speed of sound finite and > 0 (both PV_ERR_INVALID_PARAMETER). Writes *out and returns Ok(0); on an
# error *out is untouched. Mirrors `FluidMaterial::custom`.
#must_use
fn PvFluidMaterial_custom(density: f64, viscosity: f64, surface_tension: f64, speed_of_sound: f64,
  out: *PvFluidMaterial): Result {
    if (_pv_is_finite(density) == 0 || density <= 0.0) { return Err(PV_ERR_INVALID_DENSITY); }
    if (_pv_is_finite(viscosity) == 0 || viscosity < 0.0) { return Err(PV_ERR_INVALID_VISCOSITY); }
    if (_pv_is_finite(surface_tension) == 0 || surface_tension < 0.0) { return Err(PV_ERR_INVALID_PARAMETER); }
    if (_pv_is_finite(speed_of_sound) == 0 || speed_of_sound <= 0.0) { return Err(PV_ERR_INVALID_PARAMETER); }
    out.density = density;
    out.viscosity = viscosity;
    out.surface_tension = surface_tension;
    out.speed_of_sound = speed_of_sound;
    return Ok(0);
}

# ── FluidParticle ───────────────────────────────────────────────────────────────────

# An SPH particle. Mirrors `FluidParticle`: position (2D: z = 0), velocity, acceleration (accumulated forces /
# mass), density (from the neighbours), pressure (from the equation of state), mass, the phase index (0 the
# primary phase), the viscoelastic conformation tensor (c_xx, c_xy, c_yy; identity (1, 0, 1)), temperature (K)
# and fuel (0–1).
struct PvFluidParticle {
    position: PvVec3;
    velocity: PvVec3;
    acceleration: PvVec3;
    density: f64;
    pressure: f64;
    mass: f64;
    phase;
    conformation: (f64, f64, f64);
    temperature: f64;
    fuel: f64;
}

# A typed view of a word (what fl_alloc returns, or a record's address).
#must_use
fn _pv_as_particles(p): *PvFluidParticle {
    return p;
}

# A pointer's address as a plain word, for byte offsets (typed pointer arithmetic steps whole records).
#must_use
fn _pv_addr(p): i64 {
    return p;
}

# A particle at rest at `position`: no velocity or acceleration, density and pressure 0, phase 0, the identity
# conformation (1, 0, 1), 293.15 K (20 °C) and no fuel. Mirrors `FluidParticle::new`.
#must_use
fn PvFluidParticle_new(position: PvVec3, mass: f64): PvFluidParticle {
    var p: PvFluidParticle;
    p.position = position;
    p.velocity = PvVec3_zero();
    p.acceleration = PvVec3_zero();
    p.density = 0.0;
    p.pressure = 0.0;
    p.mass = mass;
    p.phase = 0;
    p.conformation = (1.0, 0.0, 1.0);
    p.temperature = 293.15;
    p.fuel = 0.0;
    return p;
}

# A 2D particle at (x, y, 0). Mirrors `FluidParticle::new_2d`.
#must_use
fn PvFluidParticle_new_2d(x: f64, y: f64, mass: f64): PvFluidParticle {
    var p: PvFluidParticle = PvFluidParticle_new(PvVec3_new(x, y, 0.0), mass);
    return p;
}

# Writes the default particle (`FluidParticle::new(DVec3::ZERO, 0.0)`) into each of the `n` records at `ps`: one
# record built, then copied whole (a struct copy moves the 144 bytes word by word, 3× faster than storing each
# field: docs/benchmarks-rust-v-cyrius.md, M1 part 3).
fn _pv_particles_reset(ps: *PvFluidParticle, n) {
    var d: PvFluidParticle = PvFluidParticle_new(PvVec3_zero(), 0.0);
    for (var i = 0; i < n; i = i + 1) {
        var q: *PvFluidParticle = ps + i;
        *q = d;
    }
    return 0;
}

impl PvFluidParticle {
    # The squared speed, |v|² (glam's dot order). Mirrors `speed_squared`.
    #must_use
    fn speed_squared(self): f64 {
        var r: f64 = self.velocity.length_squared();
        return r;
    }

    # The speed, |v|. Mirrors `speed`.
    #must_use
    fn speed(self): f64 {
        var r: f64 = self.velocity.length();
        return r;
    }

    # The kinetic energy, (0.5·m)·|v|² in Rust's order. Mirrors `kinetic_energy`.
    #must_use
    fn kinetic_energy(self): f64 {
        var v2: f64 = self.velocity.length_squared();
        var r: f64 = (0.5 * self.mass) * v2;
        return r;
    }

    # The squared distance to `other`'s position. Mirrors `distance_squared_to`.
    #must_use
    fn distance_squared_to(self, other: *PvFluidParticle): f64 {
        var r: f64 = self.position.distance_squared(other.position);
        return r;
    }

    # The distance to `other`'s position. Mirrors `distance_to`.
    #must_use
    fn distance_to(self, other: *PvFluidParticle): f64 {
        var r: f64 = self.position.distance(other.position);
        return r;
    }
}

# ── FluidConfig ─────────────────────────────────────────────────────────────────────

# Simulation configuration. Mirrors `FluidConfig`: the timestep (s), gravity, the SPH smoothing radius, the gas
# constant of the equation of state, the rest density, the domain's corners, and the boundary damping (the velocity
# kept on a wall collision, 0–1).
struct PvFluidConfig {
    dt: f64;
    gravity: PvVec3;
    smoothing_radius: f64;
    gas_constant: f64;
    rest_density: f64;
    bounds_min: PvVec3;
    bounds_max: PvVec3;
    boundary_damping: f64;
}

# The default 2D water simulation: dt 0.001, gravity (0, −9.81, 0), h 0.05, gas constant 2000, water's rest
# density, the unit square (z = 0) and damping 0.5. Mirrors `FluidConfig::water_2d`.
#must_use
fn PvFluidConfig_water_2d(): PvFluidConfig {
    var c: PvFluidConfig;
    c.dt = 0.001;
    c.gravity = PvVec3_new(0.0, -9.81, 0.0);
    c.smoothing_radius = 0.05;
    c.gas_constant = 2000.0;
    c.rest_density = PV_FLUID_MATERIAL_WATER_DENSITY;
    c.bounds_min = PvVec3_zero();
    c.bounds_max = PvVec3_new(1.0, 1.0, 0.0);
    c.boundary_damping = 0.5;
    return c;
}

impl PvFluidConfig {
    # Ok(0), or the first failure in Rust's order: dt finite and > 0 (PV_ERR_INVALID_TIMESTEP); the smoothing
    # radius finite and > 0 (PV_ERR_INVALID_SMOOTHING_RADIUS); the rest density finite and > 0
    # (PV_ERR_INVALID_DENSITY); then PV_ERR_INVALID_PARAMETER for a gas constant not finite and > 0, a damping
    # outside [0, 1] (NaN included: `RangeInclusive::contains`), a non-finite gravity, non-finite bounds, or
    # bounds_min above bounds_max on any axis. Mirrors `validate`.
    #must_use
    fn validate(self): Result {
        var dt: f64 = self.dt;
        if (_pv_is_finite(dt) == 0 || dt <= 0.0) { return Err(PV_ERR_INVALID_TIMESTEP); }
        var h: f64 = self.smoothing_radius;
        if (_pv_is_finite(h) == 0 || h <= 0.0) { return Err(PV_ERR_INVALID_SMOOTHING_RADIUS); }
        var rho: f64 = self.rest_density;
        if (_pv_is_finite(rho) == 0 || rho <= 0.0) { return Err(PV_ERR_INVALID_DENSITY); }
        var k: f64 = self.gas_constant;
        if (_pv_is_finite(k) == 0 || k <= 0.0) { return Err(PV_ERR_INVALID_PARAMETER); }
        var bd: f64 = self.boundary_damping;
        if (bd >= 0.0 && bd <= 1.0) {} else { return Err(PV_ERR_INVALID_PARAMETER); }
        if (self.gravity.is_finite() == 0) { return Err(PV_ERR_INVALID_PARAMETER); }
        if (self.bounds_min.is_finite() == 0 || self.bounds_max.is_finite() == 0) {
            return Err(PV_ERR_INVALID_PARAMETER);
        }
        var lx: f64 = self.bounds_min.x;
        var ly: f64 = self.bounds_min.y;
        var lz: f64 = self.bounds_min.z;
        var hx: f64 = self.bounds_max.x;
        var hy: f64 = self.bounds_max.y;
        var hz: f64 = self.bounds_max.z;
        if (lx > hx || ly > hy || lz > hz) { return Err(PV_ERR_INVALID_PARAMETER); }
        return Ok(0);
    }

    # The CFL check: Ok(0) when |v|·dt / h is finite and at most 1, else PV_ERR_CFL_VIOLATION (a NaN velocity
    # too). Mirrors `check_cfl`.
    #must_use
    fn check_cfl(self, max_velocity: f64): Result {
        var dx: f64 = self.smoothing_radius;
        var av: f64 = f64_abs(max_velocity);
        var cfl: f64 = (av * self.dt) / dx;
        if (_pv_is_finite(cfl) == 0 || cfl > 1.0) { return Err(PV_ERR_CFL_VIOLATION); }
        return Ok(0);
    }
}

# ── ParticleSoa ─────────────────────────────────────────────────────────────────────

# Structure-of-arrays particle data: one column per field component. Mirrors `ParticleSoa`. The columns are
# public, as Rust's are, so they can be resized independently: `is_consistent` checks them and `consistent_len` is
# the number of complete particles. `phase` holds words (Rust's u8). Release with `PvParticleSoa_drop`.
struct PvParticleSoa {
    pos_x: PvColumn;
    pos_y: PvColumn;
    pos_z: PvColumn;
    vel_x: PvColumn;
    vel_y: PvColumn;
    vel_z: PvColumn;
    accel_x: PvColumn;
    accel_y: PvColumn;
    accel_z: PvColumn;
    density: PvColumn;
    pressure: PvColumn;
    mass: PvColumn;
    phase: PvColumn;
    conf_xx: PvColumn;
    conf_xy: PvColumn;
    conf_yy: PvColumn;
    temperature: PvColumn;
    fuel: PvColumn;
}

# The number of columns, and column k of `s` (0 … 17, in declaration order) as a pointer.
const _PV_SOA_COLUMNS = 18;

#must_use
fn _pv_as_columns(p): *PvColumn {
    return p;
}

#must_use
fn _pv_soa_col(s, k): *PvColumn {
    var c: *PvColumn = _pv_as_columns(s);
    return c + k;
}

# An empty store, with no storage. Mirrors `ParticleSoa::new` (and `Default`).
#must_use
fn PvParticleSoa_new(): PvParticleSoa {
    var s: PvParticleSoa;
    for (var k = 0; k < _PV_SOA_COLUMNS; k = k + 1) {
        var c: *PvColumn = _pv_soa_col(&s, k);
        c.data = 0;
        c.len = 0;
        c.cap = 0;
    }
    return s;
}

# `Default for ParticleSoa`: the empty store.
#must_use
fn PvParticleSoa_default(): PvParticleSoa {
    var s: PvParticleSoa = PvParticleSoa_new();
    return s;
}

# An empty store with room for `n` particles in every column: 1, or 0 when the memory isn't there (then *out
# holds no storage). Mirrors `ParticleSoa::with_capacity`.
#must_use
fn PvParticleSoa_with_capacity(out: *PvParticleSoa, n): i64 {
    for (var k = 0; k < _PV_SOA_COLUMNS; k = k + 1) {
        var z: *PvColumn = _pv_soa_col(out, k);
        z.data = 0;
        z.len = 0;
        z.cap = 0;
    }
    for (var k = 0; k < _PV_SOA_COLUMNS; k = k + 1) {
        var c: *PvColumn = _pv_soa_col(out, k);
        if (c.reserve(n) == 0) {
            PvParticleSoa_drop(out);
            return 0;
        }
    }
    return 1;
}

# Releases every column's storage; the store is empty and usable again. Mirrors dropping the `ParticleSoa`.
fn PvParticleSoa_drop(s: *PvParticleSoa) {
    for (var k = 0; k < _PV_SOA_COLUMNS; k = k + 1) {
        var c: *PvColumn = _pv_soa_col(s, k);
        c.drop();
    }
    return 0;
}

# A deep copy of `src` into *out (a different store), each column at its own length: 1, or 0 when the memory isn't
# there (then *out holds no storage). Mirrors the derived `Clone`.
#must_use
fn PvParticleSoa_clone(out: *PvParticleSoa, src: *PvParticleSoa): i64 {
    for (var k = 0; k < _PV_SOA_COLUMNS; k = k + 1) {
        var z: *PvColumn = _pv_soa_col(out, k);
        z.data = 0;
        z.len = 0;
        z.cap = 0;
    }
    for (var k = 0; k < _PV_SOA_COLUMNS; k = k + 1) {
        var s: *PvColumn = _pv_soa_col(src, k);
        var d: *PvColumn = _pv_soa_col(out, k);
        if (d.resize(s.len, 0) == 0) {
            PvParticleSoa_drop(out);
            return 0;
        }
        var ok = d.copy_from(s);
    }
    return 1;
}

# A particle record's 18 words, in column order (declaration order, the conformation's three in the tuple's): the
# record is laid out exactly as the 18 columns are, so word k of particle i is column k's slot i.
const _PV_PARTICLE_WORDS = 18;

# The store of the `n` particles at `ps`: 1, or 0 when the memory isn't there (then *out holds no storage).
# Mirrors `ParticleSoa::from_aos`. Each column's `n` slots are reserved, then filled straight from the records'
# words (Rust's pushes, without a call per field).
#must_use
fn PvParticleSoa_from_aos(out: *PvParticleSoa, ps: *PvFluidParticle, n): i64 {
    if (PvParticleSoa_with_capacity(out, n) == 0) { return 0; }
    for (var k = 0; k < _PV_SOA_COLUMNS; k = k + 1) {
        var c: *PvColumn = _pv_soa_col(out, k);
        var d = c.data;
        var src = _pv_addr(ps) + k * 8;
        for (var i = 0; i < n; i = i + 1) { store64(d + i * 8, load64(src + i * sizeof(PvFluidParticle))); }
        c.len = n;
    }
    return 1;
}

impl PvParticleSoa {
    # The number of particles: the length of `pos_x`. Mirrors `len`.
    #must_use
    fn len(self): i64 {
        return self.pos_x.len;
    }

    # 1 when `pos_x` is empty. Mirrors `is_empty`.
    #must_use
    fn is_empty(self): i64 {
        if (self.pos_x.len == 0) { return 1; }
        return 0;
    }

    # 1 when every column has `pos_x`'s length. Mirrors `is_consistent`.
    #must_use
    fn is_consistent(self): i64 {
        var n = self.pos_x.len;
        for (var k = 0; k < _PV_SOA_COLUMNS; k = k + 1) {
            var c: *PvColumn = _pv_soa_col(self, k);
            if (c.len != n) { return 0; }
        }
        return 1;
    }

    # The shortest column's length: the number of complete particles. Mirrors `consistent_len`.
    #must_use
    fn consistent_len(self): i64 {
        var n = self.pos_x.len;
        for (var k = 1; k < _PV_SOA_COLUMNS; k = k + 1) {
            var c: *PvColumn = _pv_soa_col(self, k);
            if (c.len < n) { n = c.len; }
        }
        return n;
    }

    # Writes complete particles 0 … m − 1 (m ≤ consistent_len) into the records at `ps`, column by column: word k
    # of particle i is column k's slot i (the record's layout is the columns' order).
    fn _rows_to(self, ps: *PvFluidParticle, m) {
        for (var k = 0; k < _PV_SOA_COLUMNS; k = k + 1) {
            var c: *PvColumn = _pv_soa_col(self, k);
            var d = c.data;
            var dst = _pv_addr(ps) + k * 8;
            for (var i = 0; i < m; i = i + 1) { store64(dst + i * sizeof(PvFluidParticle), load64(d + i * 8)); }
        }
        return 0;
    }

    # The complete particles (`consistent_len` of them) as a new freelist buffer: (pointer, count), which the
    # caller releases with `fl_free(pointer)`. (0, 0) when there are none, or when the memory isn't there (then
    # `consistent_len()` is above 0). Mirrors `to_aos`.
    #must_use
    fn to_aos(self) {
        var n = self.consistent_len();
        if (n == 0) { return (0, 0); }
        var buf = fl_alloc(n * sizeof(PvFluidParticle));
        if (buf == 0) { return (0, 0); }
        self._rows_to(_pv_as_particles(buf), n);
        return (buf, n);
    }

    # Writes the complete particles into the `n` records at `ps`, as many as both have. Mirrors `write_to_aos`.
    fn write_to_aos(self, ps: *PvFluidParticle, n) {
        var m = self.consistent_len();
        if (n < m) { m = n; }
        self._rows_to(ps, m);
        return 0;
    }

    # The squared distance between particles i and j: (dx² + dy²) + dz², in Rust's order. NaN when either index
    # is outside a position column (Rust panics). Mirrors `distance_squared`.
    #must_use
    fn distance_squared(self, i, j): f64 {
        var dx: f64 = self.pos_x.get_f(i) - self.pos_x.get_f(j);
        var dy: f64 = self.pos_y.get_f(i) - self.pos_y.get_f(j);
        var dz: f64 = self.pos_z.get_f(i) - self.pos_z.get_f(j);
        var r: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
        return r;
    }
}

# ── ParticleArena ───────────────────────────────────────────────────────────────────

# A block of a `PvParticleArena`: its start index, its length, and the arena generation it was issued in (bumped
# by `compact`, which makes older handles stale). The fields are private in Rust; read them through `start`,
# `len` and `is_empty`. Mirrors `ArenaHandle` (Copy, Eq).
struct PvArenaHandle { start; len; generation; }

impl PvArenaHandle {
    # The block's first index. Mirrors `start`.
    #must_use
    fn start(self): i64 {
        return self.start;
    }

    # The block's length. Mirrors `len`.
    #must_use
    fn len(self): i64 {
        return self.len;
    }

    # 1 when the block is empty. Mirrors `is_empty`.
    #must_use
    fn is_empty(self): i64 {
        if (self.len == 0) { return 1; }
        return 0;
    }

    # 1 when both handles have the same fields (Rust's derived `PartialEq`).
    #must_use
    fn eq(self, other: *PvArenaHandle): i64 {
        if (self.start == other.start && self.len == other.len && self.generation == other.generation) {
            return 1;
        }
        return 0;
    }
}

# A pre-allocated particle arena. Mirrors `ParticleArena`: `capacity` particle records, the high-water mark (the
# first index never handed out since the last shrink), the free list of (start, len) blocks sorted by start, with
# adjacent blocks merged, and the generation. The free list's storage is allocated once with room for every block
# the arena can hold (free blocks are separated by allocated ones, so there are at most capacity / 2), so no
# operation allocates. Create with `PvParticleArena_new`, release with `PvParticleArena_drop`.
struct PvParticleArena {
    particles;
    capacity;
    watermark;
    free_list;
    free_count;
    free_cap;
    generation;
}

#must_use
fn _pv_as_arena(p): *PvParticleArena {
    return p;
}

# An arena of `capacity` default particles (`FluidParticle::new(DVec3::ZERO, 0.0)`), or 0 when the memory isn't
# there (Rust aborts) or `capacity` is negative. Mirrors `ParticleArena::new`.
#must_use
fn PvParticleArena_new(capacity): *PvParticleArena {
    if (capacity < 0) { return _pv_as_arena(0); }
    var a: *PvParticleArena = _pv_as_arena(fl_alloc(sizeof(PvParticleArena)));
    if (a == 0) { return a; }
    var fcap = capacity / 2 + 1;
    var ps = fl_alloc(capacity * sizeof(PvFluidParticle) + 8);
    var fl = fl_alloc(fcap * 16);
    if (ps == 0 || fl == 0) {
        if (ps != 0) { fl_free(ps); }
        if (fl != 0) { fl_free(fl); }
        fl_free(a);
        return _pv_as_arena(0);
    }
    _pv_particles_reset(_pv_as_particles(ps), capacity);
    a.particles = ps;
    a.capacity = capacity;
    a.watermark = 0;
    a.free_list = fl;
    a.free_count = 0;
    a.free_cap = fcap;
    a.generation = 0;
    return a;
}

# Releases the arena and its storage (0 is ignored). Mirrors dropping the `ParticleArena`.
fn PvParticleArena_drop(a: *PvParticleArena) {
    if (a == 0) { return 0; }
    fl_free(a.particles);
    fl_free(a.free_list);
    fl_free(a);
    return 0;
}

impl PvParticleArena {
    # Free-list entry i's start and length.
    #must_use
    fn _fs(self, i): i64 {
        return load64(self.free_list + i * 16);
    }

    #must_use
    fn _fl(self, i): i64 {
        return load64(self.free_list + i * 16 + 8);
    }

    fn _fset(self, i, s, n) {
        store64(self.free_list + i * 16, s);
        store64(self.free_list + i * 16 + 8, n);
        return 0;
    }

    # Removes free-list entry i, keeping the order (`Vec::remove`).
    fn _fremove(self, i) {
        for (var k = i; k + 1 < self.free_count; k = k + 1) {
            self._fset(k, self._fs(k + 1), self._fl(k + 1));
        }
        self.free_count = self.free_count - 1;
        return 0;
    }

    # Inserts (s, n) as free-list entry i, keeping the order (`Vec::insert`). The capacity bound holds by
    # construction; 0 if it ever didn't (nothing changes).
    fn _finsert(self, i, s, n): i64 {
        if (self.free_count >= self.free_cap) { return 0; }
        var k = self.free_count;
        while (k > i) {
            self._fset(k, self._fs(k - 1), self._fl(k - 1));
            k = k - 1;
        }
        self._fset(i, s, n);
        self.free_count = self.free_count + 1;
        return 1;
    }

    # The arena's capacity. Mirrors `capacity`.
    #must_use
    fn capacity(self): i64 {
        return self.capacity;
    }

    # The number of allocated particles: the watermark less every free block, saturating at 0. Mirrors
    # `active_count`.
    #must_use
    fn active_count(self): i64 {
        var free_total = 0;
        for (var i = 0; i < self.free_count; i = i + 1) { free_total = free_total + self._fl(i); }
        if (free_total >= self.watermark) { return 0; }
        return self.watermark - free_total;
    }

    # Allocates a block of `n` default particles: the first free block long enough (split from its front), else
    # the watermark bumped. Writes the handle to *out and returns 1, or returns 0 when there is no room (*out
    # untouched). n = 0 gives the empty handle (0, 0, generation). Mirrors `alloc`'s `Option<ArenaHandle>`.
    #must_use
    fn alloc(self, n, out: *PvArenaHandle): i64 {
        if (n == 0) {
            out.start = 0;
            out.len = 0;
            out.generation = self.generation;
            return 1;
        }
        if (n < 0) { return 0; }
        var start = 0 - 1;
        for (var i = 0; i < self.free_count; i = i + 1) {
            if (self._fl(i) >= n) {
                start = self._fs(i);
                var free_len = self._fl(i);
                if (free_len == n) { self._fremove(i); } else { self._fset(i, start + n, free_len - n); }
                break;
            }
        }
        if (start < 0) {
            if (n > self.capacity - self.watermark) { return 0; }
            start = self.watermark;
            self.watermark = self.watermark + n;
        }
        _pv_particles_reset(_pv_as_particles(self.particles) + start, n);
        out.start = start;
        out.len = n;
        out.generation = self.generation;
        return 1;
    }

    # 1 when the handle is of this generation and lies within the allocated range.
    #must_use
    fn _in_range(self, h: PvArenaHandle): i64 {
        if (h.generation != self.generation) { return 0; }
        if (h.start < 0 || h.len < 0) { return 0; }
        if (h.start > self.watermark - h.len) { return 0; }
        return 1;
    }

    # Returns a block to the pool: inserted in start order, merged with an adjacent free block on either side,
    # and the watermark shrunk when the block ends there. A stale handle (from before a `compact`), an
    # out-of-range one, or a block that overlaps a free one (a double free) is ignored, with a WARN event naming the
    # handle's start and length. Mirrors `free`.
    fn free(self, h: PvArenaHandle) {
        if (h.len == 0) { return 0; }
        if (self._in_range(h) == 0) {
            var stale = "ParticleArena::free: stale or out-of-range handle ignored";
            _pv_warn(_PV_LOG_COMMON, stale, "start", h.start, "len", h.len, 0, 0);
            return 0;
        }
        var end = h.start + h.len;
        # binary_search_by_key on start: the first entry whose start is not below h.start.
        var lo = 0;
        var hi = self.free_count;
        while (lo < hi) {
            var mid = (lo + hi) / 2;
            if (self._fs(mid) < h.start) { lo = mid + 1; } else { hi = mid; }
        }
        var pos = lo;
        var overlaps = 0;
        if (pos > 0) {
            if (self._fs(pos - 1) + self._fl(pos - 1) > h.start) { overlaps = 1; }
        }
        if (pos < self.free_count) {
            if (self._fs(pos) < end) { overlaps = 1; }
        }
        if (overlaps == 1) {
            var dbl = "ParticleArena::free: block already free (double free) ignored";
            _pv_warn(_PV_LOG_COMMON, dbl, "start", h.start, "len", h.len, 0, 0);
            return 0;
        }
        if (self._finsert(pos, h.start, h.len) == 0) { return 0; }
        if (pos + 1 < self.free_count) {
            if (self._fs(pos) + self._fl(pos) == self._fs(pos + 1)) {
                self._fset(pos, self._fs(pos), self._fl(pos) + self._fl(pos + 1));
                self._fremove(pos + 1);
            }
        }
        if (pos > 0) {
            if (self._fs(pos - 1) + self._fl(pos - 1) == self._fs(pos)) {
                self._fset(pos - 1, self._fs(pos - 1), self._fl(pos - 1) + self._fl(pos));
                self._fremove(pos);
            }
        }
        if (self.free_count > 0) {
            var last = self.free_count - 1;
            if (self._fs(last) + self._fl(last) == self.watermark) {
                self.watermark = self._fs(last);
                self.free_count = last;
            }
        }
        return 0;
    }

    # The block's particles: (pointer to the first record, count), or (0, 0) for a stale or out-of-range
    # handle. Writable, as `get_mut`'s are. Mirrors `get`.
    #must_use
    fn get(self, h: PvArenaHandle) {
        if (self._in_range(h) == 0) { return (0, 0); }
        if (h.len == 0) { return (0, 0); }
        var p = self.particles + h.start * sizeof(PvFluidParticle);
        return (p, h.len);
    }

    # The same view as `get`. Mirrors `get_mut`.
    #must_use
    fn get_mut(self, h: PvArenaHandle) {
        var p, n = self.get(h);
        return (p, n);
    }

    # Every record below the watermark, freed gaps included: (pointer, watermark). Mirrors `raw_slice`.
    #must_use
    fn raw_slice(self) {
        return (self.particles, self.watermark);
    }

    # Moves every allocated particle to the front, in order, and returns how many there are. Clears the free list
    # and bumps the generation (wrapping), which makes every earlier handle stale; with no free block it changes
    # nothing and returns the watermark. Mirrors `compact`.
    fn compact(self): i64 {
        if (self.free_count == 0) { return self.watermark; }
        var ps: *PvFluidParticle = _pv_as_particles(self.particles);
        var write = 0;
        var read = 0;
        var wm = self.watermark;
        var fi = 0;
        while (read < wm) {
            if (fi < self.free_count && read == self._fs(fi)) {
                read = read + self._fl(fi);
                fi = fi + 1;
                continue;
            }
            if (read != write) {
                var src: *PvFluidParticle = ps + read;
                var dst: *PvFluidParticle = ps + write;
                *dst = *src;
            }
            write = write + 1;
            read = read + 1;
        }
        self.watermark = write;
        self.free_count = 0;
        self.generation = self.generation + 1;
        return write;
    }

    # Every allocated particle after a `compact`: (pointer, watermark). Mirrors `active_particles`.
    #must_use
    fn active_particles(self) {
        return (self.particles, self.watermark);
    }

    # The same view, for writing. Mirrors `active_particles_mut`.
    #must_use
    fn active_particles_mut(self) {
        return (self.particles, self.watermark);
    }
}

# --- buoyancy.cyr ---

# buoyancy.cyr — buoyancy and drag forces on a body in a fluid (port of rust-old/src/buoyancy.rs).
#
# Each formula is Rust's in Rust's operation order (left to right, no fused operations), so the results have the
# oracle's bits: buoyancy_force is (ρ·g)·V, drag_force ((((0.5·ρ)·v)·v)·Cd)·A. The drag coefficients are the
# generated constants PV_DRAG_COEFFICIENT_* (src/constants.cyr); Rust's `DragCoefficient` is a unit struct that only
# holds them.

# Archimedes' principle, F = ρ·g·V. Mirrors `buoyancy_force`.
#must_use
fn buoyancy_force(fluid_density: f64, gravity: f64, displaced_volume: f64): f64 {
    var r: f64 = (fluid_density * gravity) * displaced_volume;
    return r;
}

# The drag magnitude, F = 0.5·ρ·v²·Cd·A (non-negative for physical inputs; the caller applies it against the
# velocity). Mirrors `drag_force`.
#must_use
fn drag_force(fluid_density: f64, velocity: f64, drag_coefficient: f64, cross_section_area: f64): f64 {
    var r: f64 = ((((0.5 * fluid_density) * velocity) * velocity) * drag_coefficient) * cross_section_area;
    return r;
}

# 1 when x is finite and above 0.
#must_use
fn _pv_positive(x: f64): i64 {
    if (_pv_is_finite(x) == 1 && x > 0.0) { return 1; }
    return 0;
}

# The terminal velocity, √(2·m·g / (ρ·Cd·A)), as Ok(the f64's bits), or Err(PV_ERR_INVALID_PARAMETER) when m or g
# is not finite, when ρ, Cd or A is not positive and finite, or when m·g is negative. Read the value as
# `var t, v = terminal_velocity(..); var vt: f64 = v;`. Mirrors `terminal_velocity`.
#must_use
fn terminal_velocity(mass: f64, gravity: f64, fluid_density: f64, drag_coefficient: f64, area: f64): Result {
    if (_pv_is_finite(gravity) == 0 || _pv_is_finite(mass) == 0) { return Err(PV_ERR_INVALID_PARAMETER); }
    if (_pv_positive(fluid_density) == 0 || _pv_positive(drag_coefficient) == 0 || _pv_positive(area) == 0) {
        return Err(PV_ERR_INVALID_PARAMETER);
    }
    var denom: f64 = (fluid_density * drag_coefficient) * area;
    var arg: f64 = ((2.0 * mass) * gravity) / denom;
    if (arg < 0.0) { return Err(PV_ERR_INVALID_PARAMETER); }
    var r: f64 = f64_sqrt(arg);
    return Ok(_pv_bits(r));
}

# The Reynolds number, ρ·|v|·L / μ, as Ok(the f64's bits). Err(PV_ERR_INVALID_VISCOSITY) when μ is not finite and
# above 0; Err(PV_ERR_INVALID_PARAMETER) when ρ, v or L is not finite, or ρ or L is negative (checked in that
# order). Mirrors `reynolds_number`.
#must_use
fn reynolds_number(fluid_density: f64, velocity: f64, length: f64, viscosity: f64): Result {
    if (_pv_is_finite(viscosity) == 0 || viscosity <= 0.0) { return Err(PV_ERR_INVALID_VISCOSITY); }
    if (_pv_is_finite(fluid_density) == 0) { return Err(PV_ERR_INVALID_PARAMETER); }
    if (_pv_is_finite(velocity) == 0) { return Err(PV_ERR_INVALID_PARAMETER); }
    if (_pv_is_finite(length) == 0) { return Err(PV_ERR_INVALID_PARAMETER); }
    if (fluid_density < 0.0 || length < 0.0) { return Err(PV_ERR_INVALID_PARAMETER); }
    var av: f64 = f64_abs(velocity);
    var r: f64 = ((fluid_density * av) * length) / viscosity;
    return Ok(_pv_bits(r));
}

# The flow regime. Append-only values. Mirrors `FlowRegime`.
enum PvFlowRegime {
    PV_FLOW_REGIME_LAMINAR = 0;
    PV_FLOW_REGIME_TRANSITIONAL = 1;
    PV_FLOW_REGIME_TURBULENT = 2;
}

# The Rust variant name of a flow regime (`"Laminar"`), or "Unknown".
#must_use
fn flow_regime_name(k): i64 {
    match k {
        PV_FLOW_REGIME_LAMINAR => { return "Laminar"; }
        PV_FLOW_REGIME_TRANSITIONAL => { return "Transitional"; }
        PV_FLOW_REGIME_TURBULENT => { return "Turbulent"; }
        _ => { return "Unknown"; }
    }
    return "Unknown";
}

# The regime of |Re| by the pipe-flow thresholds: laminar below 2300, transitional below 4000, else turbulent (a NaN
# is turbulent, as Rust's comparisons make it). Mirrors `classify_flow`.
#must_use
fn classify_flow(re: f64): i64 {
    var a: f64 = f64_abs(re);
    if (a < 2300.0) { return PV_FLOW_REGIME_LAMINAR; }
    if (a < 4000.0) { return PV_FLOW_REGIME_TRANSITIONAL; }
    return PV_FLOW_REGIME_TURBULENT;
}

# --- vortex.cyr ---

# vortex.cyr — vortex dynamics: vorticity, the Lamb–Oseen and Rankine vortices, enstrophy and the Kolmogorov scale
# (port of rust-old/src/vortex.rs).
#
# Rust's operation order throughout. The transcendentals are the correctly rounded ones (src/mathx.cyr, ADR 0004), so
# lamb_oseen_velocity and kolmogorov_scale equal the oracle's operations with every exp and ln correctly rounded (the
# corrected oracle where glibc misrounds). 2π is `2.0 * PI`, exact.

# The 2D vorticity, ω = ∂vy/∂x − ∂vx/∂y. Mirrors `vorticity_2d`.
#must_use
fn vorticity_2d(dvydx: f64, dvxdy: f64): f64 {
    var r: f64 = dvydx - dvxdy;
    return r;
}

# The tangential velocity of a Lamb–Oseen vortex at radius r: Γ/(2πr)·(1 − e^(−r²/(4νt))). 0 for r ≤ 0; the
# point-vortex limit Γ/(2πr) when 4νt ≤ 0. Mirrors `lamb_oseen_velocity`.
#must_use
fn lamb_oseen_velocity(circulation: f64, radius: f64, viscosity: f64, time: f64): f64 {
    if (radius <= 0.0) { return 0.0; }
    var two_pi: f64 = 2.0 * PV_F64_PI;
    var point_vortex: f64 = circulation / (two_pi * radius);
    var core: f64 = (4.0 * viscosity) * time;
    if (core <= 0.0) { return point_vortex; }
    var rr: f64 = radius * radius;
    var nrr: f64 = -rr;
    var q: f64 = nrr / core;
    var e: f64 = _pv_exp(q);
    var r: f64 = point_vortex * (1.0 - e);
    return r;
}

# The tangential velocity of a Rankine vortex: Γ·r/(2π·R²) inside the core (r ≤ R), Γ/(2πr) outside, 0 for r ≤ 0.
# Mirrors `rankine_velocity`.
#must_use
fn rankine_velocity(circulation: f64, radius: f64, core_radius: f64): f64 {
    if (radius <= 0.0) { return 0.0; }
    var two_pi: f64 = 2.0 * PV_F64_PI;
    if (radius <= core_radius) {
        var r: f64 = (circulation * radius) / ((two_pi * core_radius) * core_radius);
        return r;
    }
    var o: f64 = circulation / (two_pi * radius);
    return o;
}

# The enstrophy of the `n` vorticity values at `field`: Σ ω²·dx², summed in order from −0 (Rust's `f64` `Sum`, so an
# empty field gives −0). Mirrors `enstrophy` (Rust's `&[f64]` is the pointer and the count).
#must_use
fn enstrophy(field, n, dx: f64): f64 {
    var dx2: f64 = dx * dx;
    var s: f64 = 0x8000000000000000;   # −0
    for (var i = 0; i < n; i = i + 1) {
        var w: f64 = load64(field + i * 8);
        var t: f64 = (w * w) * dx2;
        s = s + t;
    }
    return s;
}

# The Kolmogorov microscale, η = (ν³/ε)^(1/4), as exp(0.75·ln ν − 0.25·ln ε): +∞ for ε ≤ 0, 0 for ν ≤ 0. Mirrors
# `kolmogorov_scale`.
#must_use
fn kolmogorov_scale(viscosity: f64, dissipation_rate: f64): f64 {
    if (dissipation_rate <= 0.0) {
        var inf: f64 = PV_F64_INFINITY;
        return inf;
    }
    if (viscosity <= 0.0) { return 0.0; }
    var lv: f64 = _pv_ln(viscosity);
    var le: f64 = _pv_ln(dissipation_rate);
    var a: f64 = 0.75 * lv;
    var b: f64 = 0.25 * le;
    var r: f64 = _pv_exp(a - b);
    return r;
}

# --- bridge.cyr ---

# bridge.cyr — cross-crate bridges: primitive values from pavan (aerodynamics), ushma (thermodynamics) and goonj
# (acoustics) to pravash's fluid parameters (port of rust-old/src/bridge.rs).
#
# Rust's operation order throughout; the literals are Rust's (2.414e-5 written positionally: there is no exponent
# notation). temperature_to_water_viscosity's powf and tke_to_broadband_noise_db's log10 are the correctly rounded
# ones (ADR 0004).

# ── pavan (aerodynamics) ────────────────────────────────────────────────────────────

# The surface pressure from a pressure coefficient: P = P∞ + Cp·q∞ (Pa). Mirrors `cp_to_surface_pressure`.
#must_use
fn cp_to_surface_pressure(cp: f64, dynamic_pressure_pa: f64, static_pressure_pa: f64): f64 {
    var r: f64 = static_pressure_pa + (cp * dynamic_pressure_pa);
    return r;
}

# The free-stream dynamic pressure, q = 0.5·ρ·V² (Pa). Mirrors `freestream_dynamic_pressure`.
#must_use
fn freestream_dynamic_pressure(velocity_ms: f64, density_kg_m3: f64): f64 {
    var r: f64 = ((0.5 * density_kg_m3) * velocity_ms) * velocity_ms;
    return r;
}

# The lift and drag forces from their coefficients, F = C·q·S (N): read as `var l, d = …;` and bind each to an
# f64. Mirrors `aero_coefficients_to_forces`'s `(lift, drag)`.
#must_use
fn aero_coefficients_to_forces(cl: f64, cd: f64, dynamic_pressure_pa: f64, reference_area_m2: f64) {
    var lift: f64 = (cl * dynamic_pressure_pa) * reference_area_m2;
    var drag: f64 = (cd * dynamic_pressure_pa) * reference_area_m2;
    return (lift, drag);
}

# The wind speed clamped to the subsonic range [−340, 340] m/s (a NaN stays NaN). Mirrors `wind_to_freestream`.
#must_use
fn wind_to_freestream(wind_velocity_ms: f64): f64 {
    var r: f64 = _pv_clamp(wind_velocity_ms, -340.0, 340.0);
    return r;
}

# ── ushma (thermodynamics) ──────────────────────────────────────────────────────────

# Water's dynamic viscosity at temperature T (K), by the Vogel correlation μ = A·10^(B/(T − C)), A = 2.414e-5 Pa·s,
# B = 247.8 K, C = 140 K, with T clamped to [273, 373]. Mirrors `temperature_to_water_viscosity`.
#must_use
fn temperature_to_water_viscosity(temperature_k: f64): f64 {
    var t: f64 = _pv_clamp(temperature_k, 273.0, 373.0);
    var a: f64 = 0.00002414;
    var b: f64 = 247.8;
    var c: f64 = 140.0;
    var e: f64 = b / (t - c);
    var p: f64 = _pv_powf(10.0, e);
    var r: f64 = a * p;
    return r;
}

# The thermal buoyancy forcing per unit volume over one step, g·β·Q·dt / (c_p·V) (N/m³; ρ cancels and only needs to
# be positive). 0 unless V, c_p and ρ are all above 0 (a NaN among them included). Mirrors
# `heat_to_buoyancy_forcing`.
#must_use
fn heat_to_buoyancy_forcing(heat_power_w: f64, fluid_volume_m3: f64, density_kg_m3: f64,
  specific_heat_j_per_kg_k: f64, expansion_coeff_per_k: f64, dt_s: f64): f64 {
    if (fluid_volume_m3 > 0.0 && specific_heat_j_per_kg_k > 0.0 && density_kg_m3 > 0.0) {} else { return 0.0; }
    var num: f64 = ((9.81 * expansion_coeff_per_k) * heat_power_w) * dt_s;
    var r: f64 = num / (specific_heat_j_per_kg_k * fluid_volume_m3);
    return r;
}

# The eddy thermal diffusivity from the turbulent kinetic energy, α_t ≈ C_μ^(1/4)·√k·L / Pr_t with C_μ^(1/4) =
# 0.5477 and Pr_t = 0.85 (m²/s); 0 for k ≤ 0. Mirrors `tke_to_eddy_diffusivity`.
#must_use
fn tke_to_eddy_diffusivity(tke: f64, turbulent_length_scale_m: f64): f64 {
    if (tke <= 0.0) { return 0.0; }
    var sk: f64 = f64_sqrt(tke);
    var r: f64 = ((0.5477 * sk) * turbulent_length_scale_m) / 0.85;
    return r;
}

# ── goonj (acoustics) ───────────────────────────────────────────────────────────────

# Lighthill's eighth-power law: the acoustic source strength (|v|/c)^8, dimensionless; 0 for c ≤ 0. The power is
# LLVM's three squarings. Mirrors `velocity_to_acoustic_source_strength`.
#must_use
fn velocity_to_acoustic_source_strength(velocity_ms: f64, speed_of_sound: f64): f64 {
    if (speed_of_sound <= 0.0) { return 0.0; }
    var av: f64 = f64_abs(velocity_ms);
    var mach: f64 = av / speed_of_sound;
    var r: f64 = _pv_powi8(mach);
    return r;
}

# A rough broadband noise level, 20·log10(u_rms / v_ref) dB with u_rms = √((2/3)·k) and v_ref = 5e-8 m/s; 0 for
# k ≤ 0 or u_rms ≤ v_ref. A relative loudness cue, not a calibrated SPL. Mirrors `tke_to_broadband_noise_db`.
#must_use
fn tke_to_broadband_noise_db(tke: f64): f64 {
    if (tke <= 0.0) { return 0.0; }
    var two_thirds: f64 = 2.0 / 3.0;
    var u_rms: f64 = f64_sqrt(two_thirds * tke);
    var v_ref: f64 = 0.00000005;
    if (u_rms <= v_ref) { return 0.0; }
    var l: f64 = _pv_log10(u_rms / v_ref);
    var r: f64 = 20.0 * l;
    return r;
}

# The acoustic pressure of a surface wave, ρ_air·g·|h|·k·|h| with k = 2πf/c, ρ_air = 1.225 and g = 9.81 (Pa); 0 for
# c ≤ 0 or f ≤ 0. Mirrors `wave_height_to_acoustic_pressure`.
#must_use
fn wave_height_to_acoustic_pressure(wave_height_m: f64, frequency_hz: f64, speed_of_sound: f64): f64 {
    if (speed_of_sound <= 0.0 || frequency_hz <= 0.0) { return 0.0; }
    var two_pi: f64 = 2.0 * PV_F64_PI;
    var k: f64 = (two_pi * frequency_hz) / speed_of_sound;
    var ah: f64 = f64_abs(wave_height_m);
    var r: f64 = (((1.225 * 9.81) * ah) * k) * ah;
    return r;
}

# --- shallow.cyr ---

# shallow.cyr — the shallow water equations on a 2D grid (port of rust-old/src/shallow.rs).
#
# `PvShallowWater` mirrors `ShallowWater`: the grid (nx × ny cells of size dx, row-major, index y·nx + x), the
# public fields `height` (the surface η), `vx`, `vy`, `ground` (the bed z) and `manning_n` as columns
# (src/column.cyr) that a caller may resize, as Rust's public Vecs, and the scalar parameters. The scratch buffers
# are private, persistent across steps, so a step allocates nothing once the sizes are set. Create with
# `PvShallowWater_new`, release with `PvShallowWater_drop`.
#
# Every formula is Rust's in Rust's operation order; `cbrt` (Manning friction, sediment) is ganita's, correctly
# rounded as the oracle's compiler_builtins cbrt is, and the damping `powf` the correctly rounded one (ADR 0004). An
# index outside a field, where Rust panics, reads NaN or false and writes nothing (ADR 0002 #8). Rust's
# `trace_span!`s arrive with M7's logging.

struct PvShallowWater {
    nx;
    ny;
    dx: f64;
    height: PvColumn;
    vx: PvColumn;
    vy: PvColumn;
    ground: PvColumn;
    gravity: f64;
    damping: f64;
    manning_n: PvColumn;
    dry_threshold: f64;
    breaking_threshold: f64;
    breaking_dissipation: f64;
    dispersion_coeff: f64;
    use_green_naghdi;
    use_riemann;
    scratch_vx: PvColumn;
    scratch_vy: PvColumn;
    scratch_h: PvColumn;
    scratch_lap: PvColumn;
    scratch_line: PvColumn;
}

# The number of columns in a `PvShallowWater` (5 public, 5 scratch), for drop and clone.
const _PV_SW_COLUMNS = 10;

# Column k of the shallow water state: 0 height, 1 vx, 2 vy, 3 ground, 4 manning_n, 5 … 9 the scratch buffers, by
# its byte offset in the record (a field's address can't be taken; tests/shallow.tcyr pins the layout: nx, ny, dx,
# four columns, gravity, damping, manning_n, four f64 parameters, two flags, five scratch columns; 328 bytes).
#must_use
fn _pv_sw_col(sw, k): *PvColumn {
    var off = 304;
    if (k == 0) { off = 24; }
    if (k == 1) { off = 48; }
    if (k == 2) { off = 72; }
    if (k == 3) { off = 96; }
    if (k == 4) { off = 136; }
    if (k == 5) { off = 208; }
    if (k == 6) { off = 232; }
    if (k == 7) { off = 256; }
    if (k == 8) { off = 280; }
    return _pv_as_columns(_pv_addr(sw) + off);
}

# Releases every field's storage; the state holds no storage after. Mirrors dropping the `ShallowWater`.
fn PvShallowWater_drop(sw: *PvShallowWater) {
    for (var k = 0; k < _PV_SW_COLUMNS; k = k + 1) {
        var c: *PvColumn = _pv_sw_col(sw, k);
        c.drop();
    }
    return 0;
}

# A flat surface at `water_height` over flat ground (z = 0), at rest, into *out: Ok(0), or the first failure in
# Rust's order: PV_ERR_INVALID_GRID_RESOLUTION for nx or ny below 3 (or nx·ny overflowing), PV_ERR_INVALID_PARAMETER
# for a cell size not finite and > 0 or a height not finite; PV_ERR_OUT_OF_MEMORY when the fields can't be allocated
# (Rust aborts). On an error *out holds no storage. The defaults: g 9.81, damping 0.999, Manning n 0, dry threshold
# 1e-4, breaking threshold 0.5 and dissipation 5, no dispersion, the default (non-Riemann) scheme. Mirrors
# `ShallowWater::new`.
#must_use
fn PvShallowWater_new(nx, ny, dx: f64, water_height: f64, out: *PvShallowWater): Result {
    for (var k = 0; k < _PV_SW_COLUMNS; k = k + 1) {
        var z: *PvColumn = _pv_sw_col(out, k);
        z.data = 0;
        z.len = 0;
        z.cap = 0;
    }
    if (nx < 3 || ny < 3) { return Err(PV_ERR_INVALID_GRID_RESOLUTION); }
    if (_pv_is_finite(dx) == 0 || dx <= 0.0) { return Err(PV_ERR_INVALID_PARAMETER); }
    if (_pv_is_finite(water_height) == 0) { return Err(PV_ERR_INVALID_PARAMETER); }
    if (nx > 0x7FFFFFFFFFFFFFFF / ny) { return Err(PV_ERR_INVALID_GRID_RESOLUTION); }
    var size = nx * ny;
    var zero: f64 = 0.0;
    var ok = out.height.resize(size, _pv_bits(water_height));
    ok = ok & out.vx.resize(size, _pv_bits(zero));
    ok = ok & out.vy.resize(size, _pv_bits(zero));
    ok = ok & out.ground.resize(size, _pv_bits(zero));
    ok = ok & out.manning_n.resize(size, _pv_bits(zero));
    ok = ok & out.scratch_vx.resize(size, _pv_bits(zero));
    ok = ok & out.scratch_vy.resize(size, _pv_bits(zero));
    ok = ok & out.scratch_h.resize(size, _pv_bits(zero));
    ok = ok & out.scratch_lap.resize(size, _pv_bits(zero));
    if (ok == 0) {
        PvShallowWater_drop(out);
        return Err(PV_ERR_OUT_OF_MEMORY);
    }
    out.nx = nx;
    out.ny = ny;
    out.dx = dx;
    out.gravity = 9.81;
    out.damping = 0.999;
    var dry: f64 = 0x3F1A36E2EB1C432D;   # 1e-4
    out.dry_threshold = dry;
    out.breaking_threshold = 0.5;
    out.breaking_dissipation = 5.0;
    out.dispersion_coeff = 0.0;
    out.use_green_naghdi = 0;
    out.use_riemann = 0;
    return Ok(0);
}

# A deep copy of `src` into *out, scratch included: 1, or 0 when the memory isn't there (then *out holds no
# storage). Mirrors `ShallowWater::clone`.
#must_use
fn PvShallowWater_clone(out: *PvShallowWater, src: *PvShallowWater): i64 {
    out.nx = src.nx;
    out.ny = src.ny;
    out.dx = src.dx;
    out.gravity = src.gravity;
    out.damping = src.damping;
    out.dry_threshold = src.dry_threshold;
    out.breaking_threshold = src.breaking_threshold;
    out.breaking_dissipation = src.breaking_dissipation;
    out.dispersion_coeff = src.dispersion_coeff;
    out.use_green_naghdi = src.use_green_naghdi;
    out.use_riemann = src.use_riemann;
    for (var k = 0; k < _PV_SW_COLUMNS; k = k + 1) {
        var z: *PvColumn = _pv_sw_col(out, k);
        z.data = 0;
        z.len = 0;
        z.cap = 0;
    }
    for (var k = 0; k < _PV_SW_COLUMNS; k = k + 1) {
        var s: *PvColumn = _pv_sw_col(src, k);
        var d: *PvColumn = _pv_sw_col(out, k);
        if (d.resize(s.len, 0) == 0) {
            PvShallowWater_drop(out);
            return 0;
        }
        var ok = d.copy_from(s);
    }
    return 1;
}

impl PvShallowWater {
    # The water depth at (x, y), max(η − z, 0) (Rust's NaN-ignoring max: a NaN depth is 0). NaN when the index
    # y·nx + x lies outside height or ground (Rust panics). Mirrors `depth_at`.
    #must_use
    fn depth_at(self, x, y): f64 {
        var i = y * self.nx + x;
        if (i < 0 || i >= self.height.len || i >= self.ground.len) {
            var nan: f64 = PV_F64_NAN;
            return nan;
        }
        var d: f64 = self.height.at(i) - self.ground.at(i);
        var r: f64 = _pv_max(d, 0.0);
        return r;
    }

    # The surface elevation η at (x, y), or NaN outside the field. Mirrors `surface_at`.
    #must_use
    fn surface_at(self, x, y): f64 {
        var r: f64 = self.height.get_f(y * self.nx + x);
        return r;
    }

    # 1 when the depth at (x, y) is at least the dry threshold (0 outside the field). Mirrors `is_wet`.
    #must_use
    fn is_wet(self, x, y): i64 {
        var d: f64 = self.depth_at(x, y);
        if (d >= self.dry_threshold) { return 1; }
        return 0;
    }

    # 1 when the wet interior cell (x, y) is at a breaking front: its free-surface slope |∇η| exceeds the breaking
    # threshold (dry neighbours contribute the cell's own η). 0 on the boundary ring, for a dry cell, or with the
    # threshold ≤ 0. Mirrors `is_breaking`.
    #must_use
    fn is_breaking(self, x, y): i64 {
        if (x <= 0 || x + 1 >= self.nx || y <= 0 || y + 1 >= self.ny) { return 0; }
        var i = y * self.nx + x;
        var thr: f64 = self.breaking_threshold;
        if (thr <= 0.0 || i + self.nx >= self.height.len) { return 0; }
        if (i + self.nx >= self.ground.len) { return 0; }   # Rust panics
        var inv_2dx: f64 = 0.5 / self.dx;
        var slope: f64 = 0.0;
        if (_pv_sw_slope(self.height.data, self.ground.data, self.nx, i, self.dry_threshold, inv_2dx, &slope) == 0) {
            return 0;
        }
        if (slope > thr) { return 1; }
        return 0;
    }
}

# The free-surface slope |∇η| at interior cell i into *out: √(∂x² + ∂y²) of the central differences, a dry
# neighbour (depth below `dry_thr`) taking the cell's own η. 1, or 0 (nothing written) when the cell itself is dry.
# `eta` and `ground` are the fields' raw storage. Mirrors the private `surface_slope`.
fn _pv_sw_slope(eta, ground, nx, i, dry_thr: f64, inv_2dx: f64, out): i64 {
    var ei: f64 = load64(eta + i * 8);
    var gi: f64 = load64(ground + i * 8);
    if (ei - gi < dry_thr) { return 0; }
    var er: f64 = _pv_sw_e(eta, ground, i + 1, ei, dry_thr);
    var el: f64 = _pv_sw_e(eta, ground, i - 1, ei, dry_thr);
    var et: f64 = _pv_sw_e(eta, ground, i + nx, ei, dry_thr);
    var eb: f64 = _pv_sw_e(eta, ground, i - nx, ei, dry_thr);
    var sx: f64 = (er - el) * inv_2dx;
    var sy: f64 = (et - eb) * inv_2dx;
    var s: f64 = f64_sqrt((sx * sx) + (sy * sy));
    store64(out, _pv_bits(s));
    return 1;
}

# η at k when cell k is wet, else `own` (the slope's dry-neighbour rule).
#must_use
fn _pv_sw_e(eta, ground, k, own: f64, dry_thr: f64): f64 {
    var ek: f64 = load64(eta + k * 8);
    var gk: f64 = load64(ground + k * 8);
    if (ek - gk >= dry_thr) { return ek; }
    return own;
}

impl PvShallowWater {
    # Adds a circular drop at (cx, cy) (world coordinates, cell (x, y) at (x·dx, y·dx)): each cell within `radius`
    # rises by amplitude·(1 − d/radius)². Nothing for radius ≤ 0. Mirrors `add_disturbance`.
    fn add_disturbance(self, cx: f64, cy: f64, radius: f64, amplitude: f64) {
        if (radius <= 0.0) { return 0; }
        var trace = _pv_span(_PV_LOG_SHALLOW, "shallow::disturbance", 0, 0, 0, 0, 0, 0);
        var r2: f64 = radius * radius;
        var inv_radius: f64 = 1.0 / radius;
        var dx: f64 = self.dx;
        for (var y = 0; y < self.ny; y = y + 1) {
            for (var x = 0; x < self.nx; x = x + 1) {
                var px: f64 = f64_from(x) * dx;
                var py: f64 = f64_from(y) * dx;
                var ddx: f64 = px - cx;
                var ddy: f64 = py - cy;
                var dist2: f64 = (ddx * ddx) + (ddy * ddy);
                if (dist2 < r2) {
                    var factor: f64 = 1.0 - (f64_sqrt(dist2) * inv_radius);
                    var i = y * self.nx + x;
                    var h: f64 = self.height.get_f(i);
                    var s = self.height.set_f(i, h + ((amplitude * factor) * factor));
                }
            }
        }
        _pv_span_end(trace); return 0;
    }

    # Σ max(η − z, 0)·dx² over every cell the two fields share, the boundary ring included (its cells are ghost
    # copies; `interior_volume` is the conserved quantity). Rust's `Sum`, from −0. Mirrors `total_volume`.
    #must_use
    fn total_volume(self): f64 {
        var cell_area: f64 = self.dx * self.dx;
        var n = self.height.len;
        if (self.ground.len < n) { n = self.ground.len; }
        var s: f64 = 0x8000000000000000;   # −0
        var hp = self.height.data;
        var gp = self.ground.data;
        for (var i = 0; i < n; i = i + 1) {
            var h: f64 = load64(hp + i * 8);
            var g: f64 = load64(gp + i * 8);
            var d: f64 = h - g;
            # max(d, 0) as Rust's: d when d > 0, else +0 (a NaN, ±0 and negatives alike).
            var dd: f64 = 0.0;
            if (d > 0.0) { dd = d; }
            s = s + (dd * cell_area);
        }
        return s;
    }

    # (Σ max(η − z, 0) over the interior cells)·dx², the volume the closed walls conserve; 0 for a grid under 3 × 3
    # or short fields. Mirrors `interior_volume`.
    #must_use
    fn interior_volume(self): f64 {
        var cell_area: f64 = self.dx * self.dx;
        var nx = self.nx;
        var ny = self.ny;
        if (nx < 3 || ny < 3 || self.height.len < nx * ny || self.ground.len < nx * ny) { return 0.0; }
        var sum: f64 = 0.0;
        var hp = self.height.data;
        var gp = self.ground.data;
        for (var y = 1; y < ny - 1; y = y + 1) {
            for (var x = 1; x < nx - 1; x = x + 1) {
                var i = y * nx + x;
                var h: f64 = load64(hp + i * 8);
                var g: f64 = load64(gp + i * 8);
                var d: f64 = h - g;
                if (d > 0.0) { sum = sum + d; } else { sum = sum + 0.0; }
            }
        }
        var r: f64 = sum * cell_area;
        return r;
    }

    # The largest |η − rest| over the cells, folded from 0 with Rust's NaN-ignoring max. Mirrors `max_wave_height`.
    #must_use
    fn max_wave_height(self, rest_height: f64): f64 {
        var m: f64 = 0.0;
        for (var i = 0; i < self.height.len; i = i + 1) {
            var d: f64 = self.height.at(i) - rest_height;
            var ad: f64 = f64_abs(d);
            m = _pv_max(m, ad);
        }
        return m;
    }

    # The CFL timestep, cfl·dx / max(|u| + √(g·h)) over the cells; f64::MAX when the largest wave speed is below
    # 1e-20 (dry and at rest). NaN when a field is shorter than height (Rust panics). Mirrors `cfl_dt`.
    #must_use
    fn cfl_dt(self, cfl_factor: f64): f64 {
        var n = self.height.len;
        if (self.ground.len < n || self.vx.len < n || self.vy.len < n) {
            var nan: f64 = PV_F64_NAN;
            return nan;
        }
        var g: f64 = self.gravity;
        var mws: f64 = 0.0;
        for (var i = 0; i < n; i = i + 1) {
            var d: f64 = self.height.at(i) - self.ground.at(i);
            var depth: f64 = _pv_max(d, 0.0);
            var u: f64 = self.vx.at(i);
            var v: f64 = self.vy.at(i);
            var speed: f64 = f64_sqrt((u * u) + (v * v));
            var ws: f64 = speed + f64_sqrt(g * depth);
            mws = _pv_max(mws, ws);
        }
        var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
        if (mws < tiny) {
            var big: f64 = PV_F64_MAX;
            return big;
        }
        var r: f64 = (cfl_factor * self.dx) / mws;
        return r;
    }
}

# ── Sediment transport ──────────────────────────────────────────────────────────────

# Sediment transport parameters: the critical Shields parameter, the grain diameter (m), the sediment and water
# densities (kg/m³), and the erosion and deposition rate coefficients. Mirrors `SedimentConfig`.
struct PvSedimentConfig {
    shields_critical: f64;
    grain_diameter: f64;
    sediment_density: f64;
    water_density: f64;
    erosion_rate: f64;
    deposition_rate: f64;
}

# The default: Shields 0.047, 1 mm quartz sand (2650 kg/m³) in water (1000 kg/m³), erosion 0.01, deposition 0.02.
# Mirrors `Default for SedimentConfig`.
#must_use
fn PvSedimentConfig_default(): PvSedimentConfig {
    var c: PvSedimentConfig;
    c.shields_critical = 0.047;
    c.grain_diameter = 0.001;
    c.sediment_density = 2650.0;
    c.water_density = 1000.0;
    c.erosion_rate = 0.01;
    c.deposition_rate = 0.02;
    return c;
}

# One step of erosion and deposition with η held fixed: the bed `ground` and the `n` concentrations at
# `concentration` change. Per wet interior cell, the bed shear τ_b = ρ_w·g·n²·|u|²/∛h (n at least 0.01) beyond the
# Shields critical stress erodes the bed into suspension; suspended sediment settles at the deposition rate, never
# more than is suspended. Nothing happens for a non-finite or non-positive dt, a grid under 3 × 3, or a field or
# concentration slice shorter than nx·ny. Mirrors `update_sediment` (Rust's `&mut [f64]` is the pointer and count).
fn update_sediment(sw: *PvShallowWater, concentration, conc_len, config: *PvSedimentConfig, dt: f64) {
    var trace = _pv_span(_PV_LOG_SHALLOW, "shallow::sediment", "nx", sw.nx, "ny", sw.ny, 0, 0);
    var nx = sw.nx;
    var ny = sw.ny;
    if (nx < 3 || ny < 3) { _pv_span_end(trace); return 0; }
    if (nx > 0x7FFFFFFFFFFFFFFF / ny) { _pv_span_end(trace); return 0; }
    var n = nx * ny;
    if (_pv_is_finite(dt) == 0 || dt <= 0.0) { _pv_span_end(trace); return 0; }
    if (conc_len < n || sw.height.len < n || sw.ground.len < n || sw.vx.len < n || sw.vy.len < n) {
        _pv_span_end(trace);
        return 0;
    }
    if (sw.manning_n.len < n) { _pv_span_end(trace); return 0; }
    var g: f64 = sw.gravity;
    var rho_s: f64 = config.sediment_density;
    var rho_w: f64 = config.water_density;
    var d: f64 = config.grain_diameter;
    var tau_cr: f64 = ((config.shields_critical * (rho_s - rho_w)) * g) * d;
    var nano: f64 = 0x3E112E0BE826D695;   # 1e-9
    var dry_thr: f64 = _pv_max(sw.dry_threshold, nano);
    var minn: f64 = 0.01;
    var hd = sw.height.data;
    var gd = sw.ground.data;
    for (var y = 1; y < ny - 1; y = y + 1) {
        for (var x = 1; x < nx - 1; x = x + 1) {
            var i = y * nx + x;
            var hi: f64 = load64(hd + i * 8);
            var gi: f64 = load64(gd + i * 8);
            var dd: f64 = hi - gi;
            var depth: f64 = _pv_max(dd, 0.0);
            if (depth < dry_thr) { continue; }
            var ci: f64 = load64(concentration + i * 8);
            var suspended: f64 = _pv_max(ci, 0.0) * depth;
            var u: f64 = sw.vx.at(i);
            var v: f64 = sw.vy.at(i);
            var speed_sq: f64 = (u * u) + (v * v);
            var mn: f64 = sw.manning_n.at(i);
            var n_manning: f64 = _pv_max(mn, minn);
            var cr: f64 = _pv_cbrt(depth);
            var tau_b: f64 = ((((rho_w * g) * n_manning) * n_manning) * speed_sq) / cr;
            if (tau_b > tau_cr) {
                var erosion: f64 = (config.erosion_rate * (tau_b - tau_cr)) * dt;
                gi = gi - erosion;
                depth = depth + erosion;
                suspended = suspended + erosion;
            }
            if (suspended > 0.0) {
                var c: f64 = suspended / depth;
                var want: f64 = (config.deposition_rate * c) * dt;
                var depo: f64 = _pv_min(want, suspended);
                gi = gi + depo;
                depth = depth - depo;
                suspended = suspended - depo;
            }
            store64(gd + i * 8, _pv_bits(gi));
            var cn: f64 = 0.0;
            if (depth > 0.0) {
                var q: f64 = suspended / depth;
                cn = _pv_max(q, 0.0);
            }
            store64(concentration + i * 8, _pv_bits(cn));
        }
    }
    _pv_span_end(trace); return 0;
}

# ── the step (M2 part 2) ────────────────────────────────────────────────────────────

# The HLL flux of the 1D shallow water Riemann problem between (h_l, u_l) and (h_r, u_r): (F_h, F_hu). Davis wave
# speeds, the dry-bed speeds u ∓ 2c of the wet side when one side is dry, and (0, 0) when both are dry. Mirrors the
# private `hll_flux`.
#must_use
fn _pv_sw_hll(h_l0: f64, u_l: f64, h_r0: f64, u_r: f64, g: f64) {
    var eps: f64 = 0x3E45798EE2308C3A;   # 1e-8
    var h_l: f64 = _pv_max(h_l0, 0.0);
    var h_r: f64 = _pv_max(h_r0, 0.0);
    if (h_l <= 0.0 && h_r <= 0.0) {
        var z: f64 = 0.0;
        return (z, z);
    }
    var c_l: f64 = f64_sqrt(g * h_l);
    var c_r: f64 = f64_sqrt(g * h_r);
    var s_l: f64 = 0.0;
    var s_r: f64 = 0.0;
    if (h_l <= 0.0) {
        s_l = u_r - (2.0 * c_r);
        s_r = u_r + c_r;
    } elif (h_r <= 0.0) {
        s_l = u_l - c_l;
        s_r = u_l + (2.0 * c_l);
    } else {
        s_l = _pv_min(u_l - c_l, u_r - c_r);
        s_r = _pv_max(u_l + c_l, u_r + c_r);
    }
    var hg: f64 = 0.5 * g;
    var f_h_l: f64 = h_l * u_l;
    var f_hu_l: f64 = ((h_l * u_l) * u_l) + ((hg * h_l) * h_l);
    var f_h_r: f64 = h_r * u_r;
    var f_hu_r: f64 = ((h_r * u_r) * u_r) + ((hg * h_r) * h_r);
    if (s_l >= 0.0) { return (f_h_l, f_hu_l); }
    if (s_r <= 0.0) { return (f_h_r, f_hu_r); }
    var denom: f64 = 1.0 / _pv_max(s_r - s_l, eps);
    var slr: f64 = s_l * s_r;
    var f_h: f64 = (((s_r * f_h_l) - (s_l * f_h_r)) + (slr * (h_r - h_l))) * denom;
    var f_hu: f64 = (((s_r * f_hu_l) - (s_l * f_hu_r)) + (slr * ((h_r * u_r) - (h_l * u_l)))) * denom;
    return (f_h, f_hu);
}

# The well-balanced HLL face flux (Audusse's hydrostatic reconstruction) between the states (η, z, u_n, u_t) on the
# left and right, into the 4 words at out: F_h, F_hn as the left cell sees it, F_hn as the right cell sees it, F_ht.
# The per-side normal fluxes carry the ½g(h² − h*²) bed-slope correction, so a lake at rest stays at rest. Mirrors
# the private `face_flux`.
fn _pv_sw_face(eta_l: f64, z_l: f64, un_l: f64, ut_l: f64, eta_r: f64, z_r: f64, un_r: f64, ut_r: f64, g: f64,
  out) {
    var h_l: f64 = _pv_max(eta_l - z_l, 0.0);
    var h_r: f64 = _pv_max(eta_r - z_r, 0.0);
    var z_f: f64 = _pv_max(z_l, z_r);
    var a_l: f64 = _pv_max(eta_l - z_f, 0.0);
    var a_r: f64 = _pv_max(eta_r - z_f, 0.0);
    var hs_l: f64 = _pv_min(a_l, h_l);
    var hs_r: f64 = _pv_min(a_r, h_r);
    var fh, fhn = _pv_sw_hll(hs_l, un_l, hs_r, un_r, g);
    var f_h: f64 = fh;
    var f_hn: f64 = fhn;
    var ut: f64 = ut_r;
    if (f_h >= 0.0) { ut = ut_l; }
    var hg: f64 = 0.5 * g;
    var bl: f64 = f_hn + (hg * ((h_l * h_l) - (hs_l * hs_l)));
    var br: f64 = f_hn + (hg * ((h_r * h_r) - (hs_r * hs_r)));
    var ft: f64 = f_h * ut;
    store64(out, _pv_bits(f_h));
    store64(out + 8, _pv_bits(bl));
    store64(out + 16, _pv_bits(br));
    store64(out + 24, _pv_bits(ft));
    return 0;
}

impl PvShallowWater {
    # Ok(nx·ny), or Err: PV_ERR_INVALID_GRID_RESOLUTION when nx or ny is below 3, nx·ny overflows, or a public field
    # is not nx·ny long; PV_ERR_INVALID_PARAMETER for a cell size or gravity not finite and > 0, or a dispersion
    # coefficient not finite and ≥ 0. (Public fields and JSON can bypass `new`.) Mirrors the private
    # `validate_state`.
    #must_use
    fn _validate_state(self): Result {
        var nx = self.nx;
        var ny = self.ny;
        if (nx < 3 || ny < 3) { return Err(PV_ERR_INVALID_GRID_RESOLUTION); }
        if (nx > 0x7FFFFFFFFFFFFFFF / ny) { return Err(PV_ERR_INVALID_GRID_RESOLUTION); }
        var n = nx * ny;
        if (self.height.len != n || self.vx.len != n || self.vy.len != n || self.ground.len != n) {
            return Err(PV_ERR_INVALID_GRID_RESOLUTION);
        }
        if (self.manning_n.len != n) { return Err(PV_ERR_INVALID_GRID_RESOLUTION); }
        var dx: f64 = self.dx;
        if (_pv_is_finite(dx) == 0 || dx <= 0.0) { return Err(PV_ERR_INVALID_PARAMETER); }
        var g: f64 = self.gravity;
        if (_pv_is_finite(g) == 0 || g <= 0.0) { return Err(PV_ERR_INVALID_PARAMETER); }
        var dc: f64 = self.dispersion_coeff;
        if (_pv_is_finite(dc) == 0 || dc < 0.0) { return Err(PV_ERR_INVALID_PARAMETER); }
        return Ok(n);
    }

    # One step of the non-linear shallow water equations (continuity in flux form; momentum with convection and the
    # well-balanced pressure gradient −g∇η), then Manning friction, breaking dissipation and the timestep-proportional
    # damping damping^(dt/0.001). The default path is forward-backward (momentum, then continuity with the new
    # velocity); `use_riemann` is a finite-volume HLL update instead; `dispersion_coeff > 0` adds Peregrine's implicit
    # dispersion. The edges are closed reflective walls. Ok(0), or Err: PV_ERR_INVALID_TIMESTEP for dt not finite and
    # > 0, `_validate_state`'s, PV_ERR_OUT_OF_MEMORY when the scratch buffers can't grow (Rust aborts), and
    # PV_ERR_DIVERGED when a height or velocity comes out non-finite (the state then holds the step). Mirrors `step`.
    #must_use
    fn step(self, dt: f64): Result {
        var trace = _pv_span(_PV_LOG_SHALLOW, "shallow::step", "nx", self.nx, "ny", self.ny, 0, 0);
        if (_pv_is_finite(dt) == 0 || dt <= 0.0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_TIMESTEP); }
        var vt, vv = self._validate_state();
        if (is_err_result(vt) == 1) { _pv_span_end(trace); return Err(vv); }
        var size = vv;
        var nx = self.nx;
        var ny = self.ny;
        var g: f64 = self.gravity;
        var dx: f64 = self.dx;
        var inv_dx: f64 = 1.0 / dx;
        var inv_2dx: f64 = 0.5 * inv_dx;
        var damp: f64 = _pv_powf(self.damping, dt / 0.001);
        var use_riemann = self.use_riemann;
        var dry_thr: f64 = self.dry_threshold;

        var zero: f64 = 0.0;
        var zw = _pv_bits(zero);
        var ok = self.scratch_vx.resize(size, zw);
        ok = ok & self.scratch_vy.resize(size, zw);
        ok = ok & self.scratch_h.resize(size, zw);
        ok = ok & self.scratch_lap.resize(size, zw);
        if (ok == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }

        var hp = self.height.data;
        var up = self.vx.data;
        var vp = self.vy.data;
        var gp = self.ground.data;
        var mp = self.manning_n.data;
        var svx = self.scratch_vx.data;
        var svy = self.scratch_vy.data;
        var sh = self.scratch_h.data;

        # Zero the velocity in dry cells, then snapshot the state.
        for (var i = 0; i < size; i = i + 1) {
            var h0: f64 = load64(hp + i * 8);
            var g0: f64 = load64(gp + i * 8);
            if ((h0 - g0) < dry_thr) {
                store64(up + i * 8, zw);
                store64(vp + i * 8, zw);
            }
        }
        for (var i = 0; i < size; i = i + 1) {
            store64(svx + i * 8, load64(up + i * 8));
            store64(svy + i * 8, load64(vp + i * 8));
            store64(sh + i * 8, load64(hp + i * 8));
        }

        # 1. Momentum: pressure gradient and convection (the default path only), then friction, breaking and
        #    damping (both paths).
        var tiny: f64 = 0x3D719799812DEA11;   # 1e-12
        var brk_thr: f64 = self.breaking_threshold;
        var brk_diss: f64 = self.breaking_dissipation;
        for (var y = 1; y < ny - 1; y = y + 1) {
            for (var x = 1; x < nx - 1; x = x + 1) {
                var i = y * nx + x;
                var u: f64 = load64(svx + i * 8);
                var v: f64 = load64(svy + i * 8);
                var shi: f64 = load64(sh + i * 8);
                var gi: f64 = load64(gp + i * 8);
                var hi: f64 = _pv_max(shi - gi, 0.0);
                var nvx: f64 = load64(up + i * 8);
                var nvy: f64 = load64(vp + i * 8);

                if (use_riemann == 0) {
                    var dhdx: f64 = 0.0;
                    var dhdy: f64 = 0.0;
                    if (hi >= dry_thr) {
                        var hmax: f64 = _pv_max(hi, dry_thr);
                        var den: f64 = (2.0 * dx) * hmax;
                        var hg: f64 = 0.5 * g;
                        # x: well-balanced where the ground varies, simple where it is flat.
                        var gxr: f64 = load64(gp + (i + 1) * 8);
                        var gxl: f64 = load64(gp + (i - 1) * 8);
                        var shr: f64 = load64(sh + (i + 1) * 8);
                        var shl: f64 = load64(sh + (i - 1) * 8);
                        var dgr: f64 = f64_abs(gxr - gi);
                        var dgl: f64 = f64_abs(gxl - gi);
                        if (dgr > tiny || dgl > tiny) {
                            var z_right: f64 = _pv_max(gi, gxr);
                            var z_left: f64 = _pv_max(gi, gxl);
                            var h_ir: f64 = _pv_max(shi - z_right, 0.0);
                            var h_jr: f64 = _pv_max(shr - z_right, 0.0);
                            var h_il: f64 = _pv_max(shi - z_left, 0.0);
                            var h_jl: f64 = _pv_max(shl - z_left, 0.0);
                            var sq: f64 = (((h_jr * h_jr) - (h_ir * h_ir)) + (h_il * h_il)) - (h_jl * h_jl);
                            dhdx = (hg * sq) / den;
                        } else {
                            dhdx = (g * (shr - shl)) * inv_2dx;
                        }
                        # y, the same with stride nx.
                        var gyt: f64 = load64(gp + (i + nx) * 8);
                        var gyb: f64 = load64(gp + (i - nx) * 8);
                        var sht: f64 = load64(sh + (i + nx) * 8);
                        var shb: f64 = load64(sh + (i - nx) * 8);
                        var dgt: f64 = f64_abs(gyt - gi);
                        var dgb: f64 = f64_abs(gyb - gi);
                        if (dgt > tiny || dgb > tiny) {
                            var z_top: f64 = _pv_max(gi, gyt);
                            var z_bot: f64 = _pv_max(gi, gyb);
                            var h_it: f64 = _pv_max(shi - z_top, 0.0);
                            var h_jt: f64 = _pv_max(sht - z_top, 0.0);
                            var h_ib: f64 = _pv_max(shi - z_bot, 0.0);
                            var h_jb: f64 = _pv_max(shb - z_bot, 0.0);
                            var sq2: f64 = (((h_jt * h_jt) - (h_it * h_it)) + (h_ib * h_ib)) - (h_jb * h_jb);
                            dhdy = (hg * sq2) / den;
                        } else {
                            dhdy = (g * (sht - shb)) * inv_2dx;
                        }
                    }
                    # Convection, first-order upwind.
                    var dudx: f64 = _pv_sw_up(svx, i, u, 1, inv_dx);
                    var dudy: f64 = _pv_sw_up(svx, i, v, nx, inv_dx);
                    var dvdx: f64 = _pv_sw_up(svy, i, u, 1, inv_dx);
                    var dvdy: f64 = _pv_sw_up(svy, i, v, nx, inv_dx);
                    nvx = nvx - (((dhdx + (u * dudx)) + (v * dudy)) * dt);
                    nvy = nvy - (((dhdy + (u * dvdx)) + (v * dvdy)) * dt);
                }

                # Manning's bed friction, implicit: u ← u / (1 + g·n²·|u| / (h·∛h)·dt).
                var n_m: f64 = load64(mp + i * 8);
                if (n_m > 0.0 && hi > dry_thr) {
                    var speed: f64 = f64_sqrt((u * u) + (v * v));
                    var d_safe: f64 = _pv_max(hi, dry_thr);
                    var cb: f64 = _pv_cbrt(d_safe);
                    var friction: f64 = (((g * n_m) * n_m) * speed) / (d_safe * cb);
                    var decay: f64 = 1.0 / (1.0 + (friction * dt));
                    nvx = nvx * decay;
                    nvy = nvy * decay;
                }

                # Breaking: extra damping where the free-surface slope exceeds the threshold.
                if (brk_thr > 0.0 && brk_diss > 0.0) {
                    var slope: f64 = 0.0;
                    if (_pv_sw_slope(sh, gp, nx, i, dry_thr, inv_2dx, &slope) == 1) {
                        if (slope > brk_thr) {
                            var bdecay: f64 = 1.0 / (1.0 + (brk_diss * dt));
                            nvx = nvx * bdecay;
                            nvy = nvy * bdecay;
                        }
                    }
                }

                nvx = nvx * damp;
                nvy = nvy * damp;
                store64(up + i * 8, _pv_bits(nvx));
                store64(vp + i * 8, _pv_bits(nvy));
            }
        }

        var disp: f64 = self.dispersion_coeff;
        if (use_riemann != 0) {
            # 2a. The finite-volume update; 3a. dispersion on this step's velocity increment.
            self._riemann_update(dt);
            if (disp > 0.0) {
                if (self._apply_dispersion() == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
            }
        } else {
            # 2b. Dispersion first, so the filtered velocity drives the mass flux; 3b. continuity with
            #     face-averaged fluxes, walls (zero flux) on the boundary ring's faces.
            if (disp > 0.0) {
                if (self._apply_dispersion() == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
            }
            for (var y = 1; y < ny - 1; y = y + 1) {
                for (var x = 1; x < nx - 1; x = x + 1) {
                    var i = y * nx + x;
                    var d_i: f64 = _pv_sw_depth(sh, gp, i);
                    var vxi: f64 = load64(up + i * 8);
                    var vyi: f64 = load64(vp + i * 8);
                    var hu_right: f64 = 0.0;
                    if (x + 2 != nx) {
                        var dr: f64 = _pv_sw_depth(sh, gp, i + 1);
                        var vr: f64 = load64(up + (i + 1) * 8);
                        hu_right = 0.5 * ((d_i * vxi) + (dr * vr));
                    }
                    var hu_left: f64 = 0.0;
                    if (x != 1) {
                        var dl: f64 = _pv_sw_depth(sh, gp, i - 1);
                        var vl: f64 = load64(up + (i - 1) * 8);
                        hu_left = 0.5 * ((d_i * vxi) + (dl * vl));
                    }
                    var hv_top: f64 = 0.0;
                    if (y + 2 != ny) {
                        var dt2: f64 = _pv_sw_depth(sh, gp, i + nx);
                        var vtt: f64 = load64(vp + (i + nx) * 8);
                        hv_top = 0.5 * ((d_i * vyi) + (dt2 * vtt));
                    }
                    var hv_bottom: f64 = 0.0;
                    if (y != 1) {
                        var db: f64 = _pv_sw_depth(sh, gp, i - nx);
                        var vb: f64 = load64(vp + (i - nx) * 8);
                        hv_bottom = 0.5 * ((d_i * vyi) + (db * vb));
                    }
                    var flux_div: f64 = (((hu_right - hu_left) + hv_top) - hv_bottom) * inv_dx;
                    var hcur: f64 = load64(hp + i * 8);
                    var gcur: f64 = load64(gp + i * 8);
                    var nh: f64 = _pv_max(hcur - (flux_div * dt), gcur);
                    store64(hp + i * 8, _pv_bits(nh));
                }
            }
        }

        self._enforce_boundary();

        for (var i = 0; i < size; i = i + 1) {
            var a: f64 = load64(hp + i * 8);
            var b: f64 = load64(up + i * 8);
            var c: f64 = load64(vp + i * 8);
            if (_pv_is_finite(a) == 0 || _pv_is_finite(b) == 0 || _pv_is_finite(c) == 0) {
                _pv_span_end(trace); return Err(PV_ERR_DIVERGED);
            }
        }
        _pv_span_end(trace); return Ok(0);
    }

    # The finite-volume update of (h, hu, hv) from the step's snapshot: well-balanced HLL fluxes on the four faces of
    # each interior cell, a mirrored ghost state at the walls; the source terms already in vx / vy (friction,
    # breaking, damping) carried into hu / hv. Mirrors the private `riemann_update`.
    fn _riemann_update(self, dt: f64) {
        var nx = self.nx;
        var ny = self.ny;
        var g: f64 = self.gravity;
        var inv_dx: f64 = 1.0 / self.dx;
        var dry_thr: f64 = self.dry_threshold;
        var sh = self.scratch_h.data;
        var svx = self.scratch_vx.data;
        var svy = self.scratch_vy.data;
        var gp = self.ground.data;
        var hp = self.height.data;
        var up = self.vx.data;
        var vp = self.vy.data;
        var fr[32];
        var fl[32];
        var gt[32];
        var gb[32];
        var k: f64 = dt * inv_dx;
        for (var y = 1; y < ny - 1; y = y + 1) {
            for (var x = 1; x < nx - 1; x = x + 1) {
                var i = y * nx + x;
                var eta: f64 = load64(sh + i * 8);
                var z: f64 = load64(gp + i * 8);
                var u: f64 = load64(svx + i * 8);
                var v: f64 = load64(svy + i * 8);
                var h_i: f64 = _pv_max(eta - z, 0.0);
                var nu: f64 = -u;
                var nv: f64 = -v;
                # x-faces: normal u, tangential v.
                if (x + 2 == nx) {
                    _pv_sw_face(eta, z, u, v, eta, z, nu, v, g, &fr);
                } else {
                    _pv_sw_face(eta, z, u, v, load64(sh + (i + 1) * 8), load64(gp + (i + 1) * 8),
                      load64(svx + (i + 1) * 8), load64(svy + (i + 1) * 8), g, &fr);
                }
                if (x == 1) {
                    _pv_sw_face(eta, z, nu, v, eta, z, u, v, g, &fl);
                } else {
                    _pv_sw_face(load64(sh + (i - 1) * 8), load64(gp + (i - 1) * 8), load64(svx + (i - 1) * 8),
                      load64(svy + (i - 1) * 8), eta, z, u, v, g, &fl);
                }
                # y-faces: normal v, tangential u.
                if (y + 2 == ny) {
                    _pv_sw_face(eta, z, v, u, eta, z, nv, u, g, &gt);
                } else {
                    _pv_sw_face(eta, z, v, u, load64(sh + (i + nx) * 8), load64(gp + (i + nx) * 8),
                      load64(svy + (i + nx) * 8), load64(svx + (i + nx) * 8), g, &gt);
                }
                if (y == 1) {
                    _pv_sw_face(eta, z, nv, u, eta, z, v, u, g, &gb);
                } else {
                    _pv_sw_face(load64(sh + (i - nx) * 8), load64(gp + (i - nx) * 8), load64(svy + (i - nx) * 8),
                      load64(svx + (i - nx) * 8), eta, z, v, u, g, &gb);
                }
                var fr0: f64 = load64(&fr);
                var fr1: f64 = load64(&fr + 8);
                var fr3: f64 = load64(&fr + 24);
                var fl0: f64 = load64(&fl);
                var fl2: f64 = load64(&fl + 16);
                var fl3: f64 = load64(&fl + 24);
                var gt0: f64 = load64(&gt);
                var gt1: f64 = load64(&gt + 8);
                var gt3: f64 = load64(&gt + 24);
                var gb0: f64 = load64(&gb);
                var gb2: f64 = load64(&gb + 16);
                var gb3: f64 = load64(&gb + 24);
                var dh: f64 = ((fr0 - fl0) + gt0) - gb0;
                var new_h: f64 = _pv_max(h_i - (k * dh), 0.0);
                var vxi: f64 = load64(up + i * 8);
                var vyi: f64 = load64(vp + i * 8);
                var hu: f64 = (h_i * vxi) - (k * (((fr1 - fl2) + gt3) - gb3));
                var hv: f64 = (h_i * vyi) - (k * (((fr3 - fl3) + gt1) - gb2));
                var hn: f64 = z + new_h;
                store64(hp + i * 8, _pv_bits(hn));
                if (new_h > dry_thr) {
                    var nvx: f64 = hu / new_h;
                    var nvy: f64 = hv / new_h;
                    store64(up + i * 8, _pv_bits(nvx));
                    store64(vp + i * 8, _pv_bits(nvy));
                } else {
                    var zz: f64 = 0.0;
                    store64(up + i * 8, _pv_bits(zz));
                    store64(vp + i * 8, _pv_bits(zz));
                }
            }
        }
        return 0;
    }

    # Peregrine's implicit dispersion on this step's velocity increment: (I − c·h²∂xx)(I − c·h²∂yy)·Δũ = Δu for each
    # component, by alternating-direction tridiagonal (Thomas) solves with Dirichlet-zero ghosts, then u = u_old + Δũ.
    # With `use_green_naghdi` the coupling uses the face-averaged depth. 1, or 0 when the line scratch can't grow
    # (Rust aborts). Mirrors the private `apply_dispersion`.
    #must_use
    fn _apply_dispersion(self): i64 {
        var nx = self.nx;
        var ny = self.ny;
        var c: f64 = self.dispersion_coeff;
        var inv_dx2: f64 = 1.0 / (self.dx * self.dx);
        var dry_thr: f64 = self.dry_threshold;
        var dw = self.use_green_naghdi;
        var m = nx;
        if (ny > m) { m = ny; }
        var zero: f64 = 0.0;
        if (self.scratch_line.resize(2 * m, _pv_bits(zero)) == 0) { return 0; }
        var cp = self.scratch_line.data;
        var dp = cp + m * 8;
        var delta = self.scratch_lap.data;
        var sh = self.scratch_h.data;
        var gp = self.ground.data;
        var size = nx * ny;
        for (var comp = 0; comp < 2; comp = comp + 1) {
            var field = self.vx.data;
            var old = self.scratch_vx.data;
            if (comp == 1) {
                field = self.vy.data;
                old = self.scratch_vy.data;
            }
            for (var i = 0; i < size; i = i + 1) { store64(delta + i * 8, _pv_bits(zero)); }
            for (var y = 1; y < ny - 1; y = y + 1) {
                for (var x = 1; x < nx - 1; x = x + 1) {
                    var i = y * nx + x;
                    var fd: f64 = load64(field + i * 8);
                    var od: f64 = load64(old + i * 8);
                    store64(delta + i * 8, _pv_bits(fd - od));
                }
            }
            # x-sweeps (rows), then y-sweeps (columns).
            for (var pass = 0; pass < 2; pass = pass + 1) {
                var outer = ny;
                var inner = nx;
                var stride_o = nx;
                var stride_i = 1;
                if (pass == 1) {
                    outer = nx;
                    inner = ny;
                    stride_o = 1;
                    stride_i = nx;
                }
                var len = inner - 2;
                for (var o = 1; o < outer - 1; o = o + 1) {
                    var base = o * stride_o;
                    for (var k = 0; k < len; k = k + 1) {
                        var i = base + (k + 1) * stride_i;
                        var b_lo: f64 = _pv_sw_beta(sh, gp, i, i - stride_i, dw, c, inv_dx2, dry_thr);
                        var b_hi: f64 = _pv_sw_beta(sh, gp, i, i + stride_i, dw, c, inv_dx2, dry_thr);
                        var a_k: f64 = -b_lo;
                        var b_k: f64 = (1.0 + b_lo) + b_hi;
                        var c_k: f64 = -b_hi;
                        var cp_prev: f64 = 0.0;
                        var dp_prev: f64 = 0.0;
                        if (k > 0) {
                            cp_prev = load64(cp + (k - 1) * 8);
                            dp_prev = load64(dp + (k - 1) * 8);
                        }
                        var denom: f64 = b_k - (a_k * cp_prev);
                        var di: f64 = load64(delta + i * 8);
                        var cpk: f64 = c_k / denom;
                        var dpk: f64 = (di - (a_k * dp_prev)) / denom;
                        store64(cp + k * 8, _pv_bits(cpk));
                        store64(dp + k * 8, _pv_bits(dpk));
                    }
                    var next: f64 = 0.0;
                    var k2 = len - 1;
                    while (k2 >= 0) {
                        var i2 = base + (k2 + 1) * stride_i;
                        var dpv: f64 = load64(dp + k2 * 8);
                        var cpv: f64 = load64(cp + k2 * 8);
                        var val: f64 = dpv - (cpv * next);
                        store64(delta + i2 * 8, _pv_bits(val));
                        next = val;
                        k2 = k2 - 1;
                    }
                }
            }
            for (var y = 1; y < ny - 1; y = y + 1) {
                for (var x = 1; x < nx - 1; x = x + 1) {
                    var i = y * nx + x;
                    var od2: f64 = load64(old + i * 8);
                    var dd: f64 = load64(delta + i * 8);
                    store64(field + i * 8, _pv_bits(od2 + dd));
                }
            }
        }
        return 1;
    }

    # The closed walls: each boundary cell copies its interior neighbour's height and tangential velocity, and the
    # normal velocity is 0 (top and bottom rows first, then the left and right columns, which take the corners).
    # Mirrors the private `enforce_boundary`.
    fn _enforce_boundary(self) {
        var nx = self.nx;
        var ny = self.ny;
        var hp = self.height.data;
        var up = self.vx.data;
        var vp = self.vy.data;
        var zero: f64 = 0.0;
        var zw = _pv_bits(zero);
        for (var x = 0; x < nx; x = x + 1) {
            store64(hp + x * 8, load64(hp + (nx + x) * 8));
            store64(up + x * 8, load64(up + (nx + x) * 8));
            store64(vp + x * 8, zw);
            var top = (ny - 1) * nx + x;
            var below = (ny - 2) * nx + x;
            store64(hp + top * 8, load64(hp + below * 8));
            store64(up + top * 8, load64(up + below * 8));
            store64(vp + top * 8, zw);
        }
        for (var y = 0; y < ny; y = y + 1) {
            var l = y * nx;
            store64(hp + l * 8, load64(hp + (l + 1) * 8));
            store64(up + l * 8, zw);
            store64(vp + l * 8, load64(vp + (l + 1) * 8));
            var r = y * nx + nx - 1;
            store64(hp + r * 8, load64(hp + (r - 1) * 8));
            store64(up + r * 8, zw);
            store64(vp + r * 8, load64(vp + (r - 1) * 8));
        }
        return 0;
    }
}

# The first-order upwind difference of field f at i along `stride` for the velocity `vel`: backward when vel > 0,
# else forward, times 1/dx.
#must_use
fn _pv_sw_up(f, i, vel: f64, stride, inv_dx: f64): f64 {
    var fi: f64 = load64(f + i * 8);
    if (vel > 0.0) {
        var fb: f64 = load64(f + (i - stride) * 8);
        var r: f64 = (fi - fb) * inv_dx;
        return r;
    }
    var ff: f64 = load64(f + (i + stride) * 8);
    var r2: f64 = (ff - fi) * inv_dx;
    return r2;
}

# max(η − z, 0) at k on the snapshot.
#must_use
fn _pv_sw_depth(sh, gp, k): f64 {
    var a: f64 = load64(sh + k * 8);
    var b: f64 = load64(gp + k * 8);
    var r: f64 = _pv_max(a - b, 0.0);
    return r;
}

# The dispersion coupling between cells a and b on a's row: c·h²/dx², h the depth at a (d ≥ dry_thr, else 0), or
# with `dw` the mean of a's and b's.
#must_use
fn _pv_sw_beta(sh, gp, a, b, dw, c: f64, inv_dx2: f64, dry_thr: f64): f64 {
    var h: f64 = _pv_sw_ddepth(sh, gp, a, dry_thr);
    if (dw != 0) {
        var hb: f64 = _pv_sw_ddepth(sh, gp, b, dry_thr);
        h = 0.5 * (h + hb);
    }
    var r: f64 = ((c * h) * h) * inv_dx2;
    return r;
}

# The dispersion depth at k: η − z when at least dry_thr, else 0.
#must_use
fn _pv_sw_ddepth(sh, gp, k, dry_thr: f64): f64 {
    var a: f64 = load64(sh + k * 8);
    var b: f64 = load64(gp + k * 8);
    var d: f64 = a - b;
    if (d >= dry_thr) { return d; }
    return 0.0;
}

# --- par.cyr ---

# par.cyr — the worker pool behind a solver's runtime thread count (M3 part e; port plan D6, ADR 0002 #4).
#
# Rust 1.3.0 selects rayon with the compile-time `parallel` feature. The port gives each solver a thread count
# instead: 1 (the default) runs serially, and any count gives the serial bits. A pool of T threads is the caller
# plus T − 1 persistent workers (probe 6, port-parity §4.6), each parked on its own job channel. `_pv_par_for` splits
# an index range into T contiguous slices, runs slice 0 on the calling thread and the rest on the workers, and
# returns when all are done. Every index is written by exactly one thread, and the work function reads only what
# the caller finished writing before the call, so no slice depends on another and the split changes no bit.
#
# A work function is `fn f(ctx, a, b)` over the indices [a, b): it must allocate nothing and touch no global state
# (the grid's row kernels use only their stack and the buffers ctx points at). On a target whose threads run inline
# or whose channels don't block (THREADS_CONCURRENT or CHAN_BLOCKING 0: agnos, cx), and wherever a pool can't be
# started, there is no pool and the work runs serially, which gives the same bits.
#
# The pool loads crmath's tables before it starts any worker: they fill lazily behind a plain flag, which two
# workers could otherwise race on (ADR 0004, port-parity §6).
#
# Each pool's channels (four words and a mutex each, from the stdlib's `alloc`) are not returned when it stops: the
# stdlib has no `chan_free`. A pool starts once per thread-count change, not per step, so the step's heap stays flat.

struct _PvPool {
    threads;   # T: the calling thread and T − 1 workers
    jobs;      # T − 1 job channels, one per worker
    done;      # the answer channel, T − 1 deep
    handles;   # T − 1 thread handles
    args;      # T − 1 worker records: (pool, worker index)
    fp;        # the current job: fp(ctx, a, b) over its slice of [lo, hi)
    ctx;
    lo;
    hi;
}

#must_use
fn _pv_as_pool(p): *_PvPool {
    return p;
}

# Runs worker w's slice of the current job: [lo + (n·w)/T, lo + (n·(w+1))/T) of the n = hi − lo indices (nothing
# when the slice is empty).
fn _pv_pool_run(pool: *_PvPool, w) {
    var n = pool.hi - pool.lo;
    var a = pool.lo + (n * w) / pool.threads;
    var b = pool.lo + (n * (w + 1)) / pool.threads;
    if (a < b) { fncall3(pool.fp, pool.ctx, a, b); }
    return 0;
}

# A worker's loop: its slice for every job token it receives, then an answer; a 0 token ends it.
fn _pv_pool_worker(arg): i64 {
    var pool: *_PvPool = _pv_as_pool(load64(arg));
    var w = load64(arg + 8);
    var ch = load64(pool.jobs + (w - 1) * 8);
    while (1 == 1) {
        var job = chan_recv(ch);
        if (job == 0) { break; }
        _pv_pool_run(pool, w);
        chan_send(pool.done, 1);
    }
    return 0;
}

# Stops the first `started` workers of *pool and releases its blocks (not its channels: see the file comment).
fn _pv_pool_stop(pool: *_PvPool, started) {
    for (var w = 0; w < started; w = w + 1) { chan_send(load64(pool.jobs + w * 8), 0); }
    for (var w2 = 0; w2 < started; w2 = w2 + 1) { thread_join(load64(pool.handles + w2 * 8)); }
    if (pool.jobs != 0) { fl_free(pool.jobs); }
    if (pool.handles != 0) { fl_free(pool.handles); }
    if (pool.args != 0) { fl_free(pool.args); }
    fl_free(pool);
    return 0;
}

# A pool of `threads` threads (the caller and threads − 1 started workers): its pointer, or 0 for none, which runs
# the work serially: for a count of 1 or less, on a target without concurrent threads and blocking channels, and
# when a channel or a thread can't be made (the workers already started are stopped first). Never aborts.
#must_use
fn _pv_pool_new(threads): i64 {
    if (threads <= 1 || THREADS_CONCURRENT == 0 || CHAN_BLOCKING == 0) { return 0; }
    _pv_cr_load();
    var p = fl_alloc(sizeof(_PvPool));
    if (p == 0) { return 0; }
    var pool: *_PvPool = _pv_as_pool(p);
    var m = threads - 1;
    pool.threads = threads;
    pool.jobs = fl_alloc(m * 8);
    pool.handles = fl_alloc(m * 8);
    pool.args = fl_alloc(m * 16);
    pool.done = chan_new(m);
    pool.fp = 0;
    pool.ctx = 0;
    pool.lo = 0;
    pool.hi = 0;
    if (pool.jobs == 0 || pool.handles == 0 || pool.args == 0 || pool.done == 0) {
        _pv_pool_stop(pool, 0);
        return 0;
    }
    for (var w = 0; w < m; w = w + 1) {
        var ch = chan_new(1);
        if (ch == 0) {
            _pv_pool_stop(pool, 0);
            return 0;
        }
        store64(pool.jobs + w * 8, ch);
        store64(pool.args + w * 16, p);
        store64(pool.args + w * 16 + 8, w + 1);
    }
    for (var w2 = 0; w2 < m; w2 = w2 + 1) {
        var h = thread_create(&_pv_pool_worker, pool.args + w2 * 16);
        if (h == 0) {
            _pv_pool_stop(pool, w2);
            return 0;
        }
        store64(pool.handles + w2 * 8, h);
    }
    return p;
}

# Stops the pool's workers and releases it (nothing for a pool of 0).
fn _pv_pool_drop(p) {
    if (p == 0) { return 0; }
    var pool: *_PvPool = _pv_as_pool(p);
    _pv_pool_stop(pool, pool.threads - 1);
    return 0;
}

# fp(ctx, a, b) over [lo, hi): split across the pool's threads (each slice by one thread, the caller's first), or
# once over the whole range for a pool of 0. Returns when every slice is done.
fn _pv_par_for(p, lo, hi, fp, ctx) {
    if (lo >= hi) { return 0; }
    if (p == 0) {
        fncall3(fp, ctx, lo, hi);
        return 0;
    }
    var pool: *_PvPool = _pv_as_pool(p);
    pool.fp = fp;
    pool.ctx = ctx;
    pool.lo = lo;
    pool.hi = hi;
    var m = pool.threads - 1;
    for (var w = 0; w < m; w = w + 1) { chan_send(load64(pool.jobs + w * 8), 1); }
    _pv_pool_run(pool, 0);
    for (var w2 = 0; w2 < m; w2 = w2 + 1) { chan_recv(pool.done); }
    return 0;
}

# --- grid_solve.cyr ---

# grid_solve.cyr — the library solvers the grid's pressure projection calls: hisab 1.4.0's direct DST-I and IDST-I
# and its matrix-free linear conjugate gradient, transcribed into caller scratch (ADR 0003).
#
# Each is 1.4.0's algorithm in its operation order, so the rows compare against the oracle's own calls: the sums run
# in index order, the transforms' sines are correctly rounded (src/crmath.cyr, ledger L1, ADR 0004), and nothing
# allocates. The caller owns every buffer, so the step path stays flat (port plan §7.5).
#
# The DST's sines come from a table the caller keeps (`_pv_dst_sines`): hisab computes sin(π·(i+1)·(k+1)/(n+1))
# inside the sum, n² calls a transform, but each value depends only on (i, k, n), so one table per length gives the
# same bits with n² calls in all. The grid keeps one per transform length across steps (src/grid.cyr).
#
# UPSTREAM(L6): hisab:docs/development/issues/2026-11-11-dst-allocates-per-call.md
#   replace `_pv_dst` / `_pv_idst` with hisab's `num_dst` / `num_idst` once they write into caller scratch from a
#   caller-kept sine table (a plan), with the DST rows re-bounded for their algorithm; parity: the DST pressure rows
#   of tests/golden/grid.tsv and grid.cr.tsv.
# UPSTREAM(L5): hisab:docs/development/issues/2026-11-11-no-matrix-free-linear-cg.md
#   replace `_pv_cg` with hisab's linear CG once it ships; parity: the CG pressure rows of tests/golden/grid.tsv
#   (iterations class A, solution class B).

# The n² sines of the DST-I of length n into out (row k, entry i): out[k·n + i] = sin(((π·(i+1))·(k+1))/(n+1)), the
# value and argument of hisab 1.4.0 `num::dst`'s term (i, k), correctly rounded. Nothing for n ≤ 0.
fn _pv_dst_sines(n, out) {
    var pi: f64 = PV_F64_PI;
    var np1: f64 = f64_from(n + 1);
    for (var k = 0; k < n; k = k + 1) {
        var kf: f64 = f64_from(k + 1);
        var row = out + k * n * 8;
        for (var i = 0; i < n; i = i + 1) {
            var xf: f64 = f64_from(i + 1);
            var arg: f64 = ((pi * xf) * kf) / np1;
            var s: f64 = _pv_sin(arg);
            store64(row + i * 8, _pv_bits(s));
        }
    }
    return 0;
}

# The DST-I of x[0 … n) into out[0 … n) (out must not be x), with `sines` the length's table (`_pv_dst_sines`):
# X[k] = Σ x[i]·sines[k·n + i], each sum from +0 in i order. 1, or 0 for n ≤ 0 (hisab's InvalidInput for an empty
# input). Mirrors hisab 1.4.0 `num::dst`.
fn _pv_dst(x, n, sines, out): i64 {
    if (n <= 0) { return 0; }
    for (var k = 0; k < n; k = k + 1) {
        var row = sines + k * n * 8;
        var sum: f64 = 0.0;
        for (var i = 0; i < n; i = i + 1) {
            var xi: f64 = load64(x + i * 8);
            var si: f64 = load64(row + i * 8);
            sum = sum + (xi * si);
        }
        store64(out + k * 8, _pv_bits(sum));
    }
    return 1;
}

# The IDST-I of x[0 … n) into out[0 … n): the DST-I, each value then multiplied by 2/(n+1). 1, or 0 for n ≤ 0.
# Mirrors hisab 1.4.0 `num::idst`.
fn _pv_idst(x, n, sines, out): i64 {
    if (_pv_dst(x, n, sines, out) == 0) { return 0; }
    var np1: f64 = f64_from(n + 1);
    var scale: f64 = 2.0 / np1;
    for (var k = 0; k < n; k = k + 1) {
        var v: f64 = load64(out + k * 8);
        var w: f64 = v * scale;
        store64(out + k * 8, _pv_bits(w));
    }
    return 1;
}

# Σ v[i]·w[i] over i in 0 … n, folded from −0 in index order, as Rust's `f64::sum` does.
#must_use
fn _pv_cg_dot(v, w, n): f64 {
    var s: f64 = 0x8000000000000000;
    for (var i = 0; i < n; i = i + 1) {
        var a: f64 = load64(v + i * 8);
        var b: f64 = load64(w + i * 8);
        s = s + (a * b);
    }
    return s;
}

# hisab 1.4.0's matrix-free linear conjugate gradient: solves A·x = b (n unknowns) from the guess in x, in place. A is
# applied as `fncall3(op, ctx, v, out)` (out = A·v, n words). r, p and ap are n-word scratch. It stops when ‖r‖² <
# tol², when |pᵀAp| < 1e-12 (hisab's EPSILON_F64), or after max_iter iterations, leaving the last iterate in x, as
# hisab returns it. 1, or 0 for n ≤ 0 (hisab's InvalidInput; x untouched). Mirrors `num::conjugate_gradient`, with
# x0 and the result one buffer: hisab refuses a length mismatch before it computes, and the caller copies the
# result over x0.
fn _pv_cg(op, ctx, b, x, n, tol: f64, max_iter, r, p, ap): i64 {
    if (n <= 0) { return 0; }
    fncall3(op, ctx, x, ap);
    for (var i = 0; i < n; i = i + 1) {
        var bi: f64 = load64(b + i * 8);
        var ai: f64 = load64(ap + i * 8);
        var ri: f64 = bi - ai;
        store64(r + i * 8, _pv_bits(ri));
        store64(p + i * 8, _pv_bits(ri));
    }
    var rs_old: f64 = _pv_cg_dot(r, r, n);
    var tol_sq: f64 = tol * tol;
    if (rs_old < tol_sq) { return 1; }
    var eps: f64 = 0x3D719799812DEA11;   # 1e-12
    for (var it = 0; it < max_iter; it = it + 1) {
        fncall3(op, ctx, p, ap);
        var pap: f64 = _pv_cg_dot(p, ap, n);
        var apap: f64 = f64_abs(pap);
        if (apap < eps) { break; }
        var alpha: f64 = rs_old / pap;
        for (var j = 0; j < n; j = j + 1) {
            var xj: f64 = load64(x + j * 8);
            var pj: f64 = load64(p + j * 8);
            var rj: f64 = load64(r + j * 8);
            var aj: f64 = load64(ap + j * 8);
            var xn: f64 = xj + (alpha * pj);
            var rn: f64 = rj - (alpha * aj);
            store64(x + j * 8, _pv_bits(xn));
            store64(r + j * 8, _pv_bits(rn));
        }
        var rs_new: f64 = _pv_cg_dot(r, r, n);
        if (rs_new < tol_sq) { return 1; }
        var beta: f64 = rs_new / rs_old;
        for (var q = 0; q < n; q = q + 1) {
            var rq: f64 = load64(r + q * 8);
            var pq: f64 = load64(p + q * 8);
            var pn: f64 = rq + (beta * pq);
            store64(p + q * 8, _pv_bits(pn));
        }
        rs_old = rs_new;
    }
    return 1;
}

# --- grid.cyr ---

# grid.cyr — 2D incompressible Euler / Navier–Stokes on a uniform grid (port of rust-old/src/grid.rs, `FluidGrid`).
#
# `PvFluidGrid` mirrors `FluidGrid`: nx × ny cells of size dx, row-major (index y·nx + x), with a ghost ring: the
# public fields `vx`, `vy`, `pressure` and `density` are columns (src/column.cyr) a caller may resize, as Rust's
# public Vecs. A step splits the operators in Rust's order: advect the velocity (semi-Lagrangian, MacCormack or BFECC,
# both limited to the backtraced stencil; a wrapping sampler for periodic walls), diffuse it (Gauss–Seidel, with an
# optional Smagorinsky viscosity), apply buoyancy and vorticity confinement, project it (the Poisson system 4p − Σp =
# −dx²·∇·u by DST, multigrid, conjugate gradient or Gauss–Seidel), then advect the density.
#
# The scratch buffers are private and persist across steps, so a step allocates nothing once the sizes are set.
# Rust's DST and CG solves allocate per call; here they use three more private buffers, `solve_a` … `solve_c`
# (ADR 0002 #12). Create with `PvFluidGrid_new`, release with `PvFluidGrid_drop`.
#
# Every formula is Rust's in Rust's operation order; the DST's sines and cosines are correctly rounded (ADR 0004),
# and the periodic sampler's `%` is the exact fmod (src/mathx.cyr, L14). An index outside a field, where Rust panics,
# reads NaN and writes nothing (ADR 0002 #8). Rust's `trace_span!`s arrive with M7's logging, and the three parallel
# row loops with src/par.cyr (M3 part e); a serial loop gives the same bits.

# The wall rule for the velocity ghosts. Append-only values. Mirrors `BoundaryCondition`.
enum PvBoundaryCondition {
    PV_BOUNDARY_CONDITION_NO_SLIP = 0;
    PV_BOUNDARY_CONDITION_FREE_SLIP = 1;
    PV_BOUNDARY_CONDITION_PERIODIC = 2;
}

# The Rust variant name of a boundary condition (`"NoSlip"`), or "Unknown".
#must_use
fn boundary_condition_name(k): i64 {
    match k {
        PV_BOUNDARY_CONDITION_NO_SLIP => { return "NoSlip"; }
        PV_BOUNDARY_CONDITION_FREE_SLIP => { return "FreeSlip"; }
        PV_BOUNDARY_CONDITION_PERIODIC => { return "Periodic"; }
        _ => { return "Unknown"; }
    }
    return "Unknown";
}

# The configuration of a grid step. The flags are 0 / 1; the iteration counts are usizes. Mirrors `GridConfig`.
struct PvGridConfig {
    dt: f64;
    viscosity: f64;
    diffusion_iterations;
    pressure_iterations;
    boundary;
    vorticity_confinement: f64;
    buoyancy_alpha: f64;
    ambient_density: f64;
    use_maccormack;
    use_bfecc;
    smagorinsky_cs: f64;
    use_multigrid;
    use_cg;
}

# The smoke defaults (y up): dt 0.1, viscosity 1e-4, 20 diffusion and 40 pressure iterations, no-slip walls,
# vorticity confinement 0.5, buoyancy 0.1 against an ambient density 0, semi-Lagrangian advection, no Smagorinsky,
# the DST pressure solve. Mirrors `GridConfig::smoke`.
#must_use
fn PvGridConfig_smoke(): PvGridConfig {
    var c: PvGridConfig;
    c.dt = 0.1;
    var visc: f64 = 0x3F1A36E2EB1C432D;   # 1e-4
    c.viscosity = visc;
    c.diffusion_iterations = 20;
    c.pressure_iterations = 40;
    c.boundary = PV_BOUNDARY_CONDITION_NO_SLIP;
    c.vorticity_confinement = 0.5;
    c.buoyancy_alpha = 0.1;
    c.ambient_density = 0.0;
    c.use_maccormack = 0;
    c.use_bfecc = 0;
    c.smagorinsky_cs = 0.0;
    c.use_multigrid = 0;
    c.use_cg = 0;
    return c;
}

# The smoke defaults. Mirrors `GridConfig::default`.
#must_use
fn PvGridConfig_default(): PvGridConfig {
    return PvGridConfig_smoke();
}

# One multigrid level as the grid keeps it between steps: the residual (the level's size), the coarse right-hand
# side and the coarse correction (the next level's size). Mirrors the `(Vec, Vec, Vec)` of `mg_levels`.
struct _PvMgLevel {
    residual: PvColumn;
    coarse_rhs: PvColumn;
    coarse_p: PvColumn;
}

struct PvFluidGrid {
    nx;
    ny;
    dx: f64;
    vx: PvColumn;
    vy: PvColumn;
    pressure: PvColumn;
    density: PvColumn;
    scratch_a: PvColumn;
    scratch_b: PvColumn;
    scratch_c: PvColumn;
    diffuse_rhs: PvColumn;
    mg_levels: PvColumn;
    solve_a: PvColumn;
    solve_b: PvColumn;
    solve_c: PvColumn;
    dst_x: PvColumn;
    dst_y: PvColumn;
    threads;
    pool;
}

# The number of columns in a `PvFluidGrid`: the 4 public fields, the 4 scratch buffers, `mg_levels` (column 8, whose
# words are `*_PvMgLevel`s), the 3 solver buffers and the 2 DST plans (`_pv_fg_dst_plan`).
const _PV_FG_COLUMNS = 14;

# Column k of a grid (0 vx, 1 vy, 2 pressure, 3 density, 4 scratch_a, 5 scratch_b, 6 scratch_c, 7 diffuse_rhs,
# 8 mg_levels, 9 … 11 solve_a … solve_c, 12 dst_x, 13 dst_y), by its byte offset (a field's address can't be taken;
# tests/grid.tcyr pins the layout: nx, ny, dx, the fourteen columns, then the thread count and the pool (a
# `_PvPool` pointer, 0 for none: src/par.cyr), 376 bytes).
#must_use
fn _pv_fg_col(g, k): *PvColumn {
    return _pv_as_columns(_pv_addr(g) + 24 + k * 24);
}

#must_use
fn _pv_as_mg_level(p): *_PvMgLevel {
    return p;
}

# Column k (0 residual, 1 coarse_rhs, 2 coarse_p) of a multigrid level.
#must_use
fn _pv_mg_col(lv, k): *PvColumn {
    return _pv_as_columns(_pv_addr(lv) + k * 24);
}

# Releases every level and the level list; the list is empty after.
fn _pv_mg_levels_drop(levels: *PvColumn) {
    for (var k = 0; k < levels.len; k = k + 1) {
        var lv = load64(levels.data + k * 8);
        for (var c = 0; c < 3; c = c + 1) {
            var col: *PvColumn = _pv_mg_col(lv, c);
            col.drop();
        }
        fl_free(lv);
    }
    levels.drop();
    return 0;
}

# Appends an empty level: 1, or 0 when the memory isn't there (the list unchanged).
#must_use
fn _pv_mg_levels_push(levels: *PvColumn): i64 {
    var lv = fl_alloc(72);
    if (lv == 0) { return 0; }
    for (var c = 0; c < 3; c = c + 1) {
        var col: *PvColumn = _pv_mg_col(lv, c);
        col.data = 0;
        col.len = 0;
        col.cap = 0;
    }
    if (levels.push(lv) == 0) {
        fl_free(lv);
        return 0;
    }
    return 1;
}

# Empties every column of *g without releasing anything, and sets the serial default (one thread, no pool), for a
# record about to be filled.
fn _pv_fg_zero(g: *PvFluidGrid) {
    for (var k = 0; k < _PV_FG_COLUMNS; k = k + 1) {
        var z: *PvColumn = _pv_fg_col(g, k);
        z.data = 0;
        z.len = 0;
        z.cap = 0;
    }
    g.threads = 1;
    g.pool = 0;
    return 0;
}

# Releases every field's storage, the multigrid levels included; the grid holds no storage after. Mirrors dropping
# the `FluidGrid`.
fn PvFluidGrid_drop(g: *PvFluidGrid) {
    _pv_pool_drop(g.pool);
    g.pool = 0;
    _pv_mg_levels_drop(_pv_fg_col(g, 8));
    for (var k = 0; k < _PV_FG_COLUMNS; k = k + 1) {
        var c: *PvColumn = _pv_fg_col(g, k);
        c.drop();
    }
    return 0;
}

# The usize product nx·ny (each ≥ 4 or a word ≥ 2^63): 0 when it is below 2^63 (an i64 size), 1 when it is in
# [2^63, 2^64) (a size no allocation reaches: Rust's `vec!` aborts), 2 when it overflows a usize (Rust's
# `checked_mul` is None).
#must_use
fn _pv_fg_mul_class(nx, ny): i64 {
    if (nx < 0 || ny < 0) { return 2; }
    if (nx <= 0x7FFFFFFFFFFFFFFF / ny) { return 0; }
    # ⌊(2^64 − 1)/ny⌋ = 2a + ⌊(2b + 1)/ny⌋ for 2^63 − 1 = a·ny + b.
    var a = 0x7FFFFFFFFFFFFFFF / ny;
    var b = 0x7FFFFFFFFFFFFFFF % ny;
    var q = 2 * a + (2 * b + 1) / ny;
    if (nx > q) { return 2; }
    return 1;
}

# A grid of zeros into *out: Ok(0), or the first failure in Rust's order: PV_ERR_INVALID_GRID_RESOLUTION for nx or ny
# below 4, PV_ERR_INVALID_PARAMETER for a cell size not finite and > 0 or for nx·ny overflowing;
# PV_ERR_OUT_OF_MEMORY when the fields can't be allocated (Rust aborts). On an error *out holds no storage. The
# four scratch buffers start at nx·ny zeros and the multigrid levels empty. Mirrors `FluidGrid::new`.
#must_use
fn PvFluidGrid_new(nx, ny, dx: f64, out: *PvFluidGrid): Result {
    _pv_fg_zero(out);
    # nx and ny are usizes: a word at or above 2^63 reads negative, and is a size Rust accepts until nx·ny.
    if ((nx >= 0 && nx < _PV_GRID_MIN_SIZE) || (ny >= 0 && ny < _PV_GRID_MIN_SIZE)) {
        return Err(PV_ERR_INVALID_GRID_RESOLUTION);
    }
    if (dx <= 0.0 || _pv_is_finite(dx) == 0) { return Err(PV_ERR_INVALID_PARAMETER); }
    var ov = _pv_fg_mul_class(nx, ny);
    if (ov == 2) { return Err(PV_ERR_INVALID_PARAMETER); }
    if (ov == 1) { return Err(PV_ERR_OUT_OF_MEMORY); }
    var size = nx * ny;
    var ok = 1;
    for (var k = 0; k < 8; k = k + 1) {
        var c: *PvColumn = _pv_fg_col(out, k);
        ok = ok & c.resize(size, 0);
    }
    if (ok == 0) {
        PvFluidGrid_drop(out);
        return Err(PV_ERR_OUT_OF_MEMORY);
    }
    out.nx = nx;
    out.ny = ny;
    out.dx = dx;
    return Ok(0);
}

# A deep copy of `src` into *out, scratch and multigrid levels included: 1, or 0 when the memory isn't there (then
# *out holds no storage). Mirrors `FluidGrid::clone`.
#must_use
fn PvFluidGrid_clone(out: *PvFluidGrid, src: *PvFluidGrid): i64 {
    out.nx = src.nx;
    out.ny = src.ny;
    out.dx = src.dx;
    _pv_fg_zero(out);
    out.threads = src.threads;
    for (var k = 0; k < _PV_FG_COLUMNS; k = k + 1) {
        if (k == 8) { continue; }
        var s: *PvColumn = _pv_fg_col(src, k);
        var d: *PvColumn = _pv_fg_col(out, k);
        if (d.resize(s.len, 0) == 0) {
            PvFluidGrid_drop(out);
            return 0;
        }
        d.copy_from(s);
    }
    var sl: *PvColumn = _pv_fg_col(src, 8);
    var dl: *PvColumn = _pv_fg_col(out, 8);
    for (var j = 0; j < sl.len; j = j + 1) {
        if (_pv_mg_levels_push(dl) == 0) {
            PvFluidGrid_drop(out);
            return 0;
        }
        var sv = load64(sl.data + j * 8);
        var dv = load64(dl.data + j * 8);
        for (var c = 0; c < 3; c = c + 1) {
            var s2: *PvColumn = _pv_mg_col(sv, c);
            var d2: *PvColumn = _pv_mg_col(dv, c);
            if (d2.resize(s2.len, 0) == 0) {
                PvFluidGrid_drop(out);
                return 0;
            }
            d2.copy_from(s2);
        }
    }
    return 1;
}

# Copies n words from src to dst.
fn _pv_fg_copy(dst, src, n) {
    for (var i = 0; i < n; i = i + 1) { store64(dst + i * 8, load64(src + i * 8)); }
    return 0;
}

# Sets n words at p to w.
fn _pv_fg_fill(p, n, w) {
    for (var i = 0; i < n; i = i + 1) { store64(p + i * 8, w); }
    return 0;
}

# ── sampling and advection ──────────────────────────────────────────────────────────

# The bilinear interpolation of field f (nx × ny) at the continuous position (fx, fy) in cell units: the cell
# x0 = floor(fx) clamped to [0, nx − 2] (likewise y0), the weights sx = fx − x0 clamped to [0, 1], and
# ((v00·(1−sx))·(1−sy) + (v10·sx)·(1−sy)) + (v01·(1−sx))·sy + (v11·sx)·sy. NaN when a coordinate is not finite (the
# backtrace's divergence signal). Mirrors the private `sample`.
#must_use
fn _pv_fg_sample(f, nx, ny, fx: f64, fy: f64): f64 {
    var tx: f64 = fx - fx;
    var ty: f64 = fy - fy;
    if (tx != 0.0 || ty != 0.0) {
        var nan: f64 = PV_F64_NAN;
        return nan;
    }
    # floor, then max(0), then min(n − 2), then `as usize`: only the integer is used after, so the comparisons
    # stand for Rust's max / min on these finite values.
    var x0 = 0;
    var flx: f64 = f64_floor(fx);
    if (flx > 0.0) {
        var hx: f64 = f64_from(nx - 2);
        if (flx < hx) { x0 = f64_to(flx); } else { x0 = nx - 2; }
    }
    var y0 = 0;
    var fly: f64 = f64_floor(fy);
    if (fly > 0.0) {
        var hy: f64 = f64_from(ny - 2);
        if (fly < hy) { y0 = f64_to(fly); } else { y0 = ny - 2; }
    }
    var x0f: f64 = f64_from(x0);
    var y0f: f64 = f64_from(y0);
    var sx: f64 = fx - x0f;
    if (sx < 0.0) { sx = 0.0; }
    if (sx > 1.0) { sx = 1.0; }
    var sy: f64 = fy - y0f;
    if (sy < 0.0) { sy = 0.0; }
    if (sy > 1.0) { sy = 1.0; }
    var r0 = f + (y0 * nx + x0) * 8;
    var r1 = r0 + nx * 8;
    var v00: f64 = load64(r0);
    var v10: f64 = load64(r0 + 8);
    var v01: f64 = load64(r1);
    var v11: f64 = load64(r1 + 8);
    var osx: f64 = 1.0 - sx;
    var osy: f64 = 1.0 - sy;
    var r: f64 = ((((v00 * osx) * osy) + ((v10 * sx) * osy)) + ((v01 * osx) * sy)) + ((v11 * sx) * sy);
    return r;
}

# (lo, hi): the min and max of the four stencil values `_pv_fg_sample` reads at (fx, fy), the MacCormack / BFECC
# limiter bounds (Selle et al. 2008), NaN-ignoring as Rust's min / max are; (−∞, +∞) when a coordinate is not
# finite. Read as `var lo, hi = …` and bind each to an f64 local. Mirrors the private `sample_bounds`.
#must_use
fn _pv_fg_bounds(f, nx, ny, fx: f64, fy: f64) {
    var tx: f64 = fx - fx;
    var ty: f64 = fy - fy;
    if (tx != 0.0 || ty != 0.0) {
        var ninf: f64 = PV_F64_NEG_INFINITY;
        var pinf: f64 = PV_F64_INFINITY;
        return (ninf, pinf);
    }
    var x0 = 0;
    var flx: f64 = f64_floor(fx);
    if (flx > 0.0) {
        var hx: f64 = f64_from(nx - 2);
        if (flx < hx) { x0 = f64_to(flx); } else { x0 = nx - 2; }
    }
    var y0 = 0;
    var fly: f64 = f64_floor(fy);
    if (fly > 0.0) {
        var hy: f64 = f64_from(ny - 2);
        if (fly < hy) { y0 = f64_to(fly); } else { y0 = ny - 2; }
    }
    var r0 = f + (y0 * nx + x0) * 8;
    var r1 = r0 + nx * 8;
    var v00: f64 = load64(r0);
    var v10: f64 = load64(r0 + 8);
    var v01: f64 = load64(r1);
    var v11: f64 = load64(r1 + 8);
    var a: f64 = _pv_min(v00, v10);
    var b: f64 = _pv_min(a, v01);
    var lo: f64 = _pv_min(b, v11);
    var c: f64 = _pv_max(v00, v10);
    var d: f64 = _pv_max(c, v01);
    var hi: f64 = _pv_max(d, v11);
    return (lo, hi);
}

# v clamped to [lo, hi] when lo ≤ hi, else v unchanged (a NaN or inverted bound never panics). Mirrors the private
# `clamp_safe`.
#must_use
fn _pv_fg_clamp_safe(v: f64, lo: f64, hi: f64): f64 {
    if (lo <= hi) {
        var r: f64 = _pv_clamp(v, lo, hi);
        return r;
    }
    return v;
}

# Copies the boundary ring of src into dst. Mirrors the private `copy_ring`.
fn _pv_fg_copy_ring(dst, src, nx, ny) {
    _pv_fg_copy(dst, src, nx);
    var top = (ny - 1) * nx;
    _pv_fg_copy(dst + top * 8, src + top * 8, nx);
    for (var y = 1; y < ny - 1; y = y + 1) {
        var l = y * nx;
        var r = l + nx - 1;
        store64(dst + l * 8, load64(src + l * 8));
        store64(dst + r * 8, load64(src + r * 8));
    }
    return 0;
}

# The rows [y0, y1) of a semi-Lagrangian advection (a `_pv_par_for` kernel): ctx holds dst, src, vx, vy, nx, ny and
# the f64 dt·inv_dx, as `_pv_fg_advect` lays them out. Each row writes only its own interior cells of dst.
fn _pv_fg_advect_k(ctx, y0, y1) {
    var dst = load64(ctx);
    var src = load64(ctx + 8);
    var vx = load64(ctx + 16);
    var vy = load64(ctx + 24);
    var nx = load64(ctx + 32);
    var ny = load64(ctx + 40);
    var k: f64 = load64(ctx + 48);
    for (var y = y0; y < y1; y = y + 1) {
        var yf: f64 = f64_from(y);
        for (var x = 1; x < nx - 1; x = x + 1) {
            var i = y * nx + x;
            var xf: f64 = f64_from(x);
            var u: f64 = load64(vx + i * 8);
            var v: f64 = load64(vy + i * 8);
            var fx: f64 = xf - (k * u);
            var fy: f64 = yf - (k * v);
            var s: f64 = _pv_fg_sample(src, nx, ny, fx, fy);
            store64(dst + i * 8, _pv_bits(s));
        }
    }
    return 0;
}

# Packs the advection kernels' context (dst, src, vx, vy, nx, ny, k) into the 7 words at ctx.
fn _pv_fg_advect_ctx(ctx, dst, src, vx, vy, nx, ny, k: f64) {
    store64(ctx, dst);
    store64(ctx + 8, src);
    store64(ctx + 16, vx);
    store64(ctx + 24, vy);
    store64(ctx + 32, nx);
    store64(ctx + 40, ny);
    store64(ctx + 48, _pv_bits(k));
    return 0;
}

# Semi-Lagrangian advection of src into dst on the interior: each cell traced back through (vx, vy) by
# dt·inv_dx·v cells and sampled, the rows split across `pool` (0 runs them serially; src/par.cyr). Mirrors the
# private `advect`, one of Rust's three `parallel` loops.
fn _pv_fg_advect_raw(dst, src, vx, vy, nx, ny, dt: f64, inv_dx: f64, pool) {
    var k: f64 = dt * inv_dx;
    var ctx[56];
    _pv_fg_advect_ctx(&ctx, dst, src, vx, vy, nx, ny, k);
    _pv_par_for(pool, 1, ny - 1, &_pv_fg_advect_k, &ctx);
    return 0;
}

# `_pv_fg_advect_raw` in the TRACE span `grid::advect{nx, ny}`: Rust's `advect` (MacCormack and BFECC take the raw
# pass, as Rust's run their forward pass without the span).
fn _pv_fg_advect(dst, src, vx, vy, nx, ny, dt: f64, inv_dx: f64, pool) {
    var trace = _pv_span(_PV_LOG_GRID, "grid::advect", "nx", nx, "ny", ny, 0, 0);
    _pv_fg_advect_raw(dst, src, vx, vy, nx, ny, dt, inv_dx, pool);
    _pv_span_end(trace); return 0;
}

# The bilinear sample at (fx, fy) with both axes wrapped: ((f % n) + n) % n, then the floor cell mod n and its
# successor mod n, the weights f − floor(f). NaN when a coordinate is not finite. Mirrors the private
# `sample_periodic`.
#must_use
fn _pv_fg_sample_periodic(f, nx, ny, fx0: f64, fy0: f64): f64 {
    var tx: f64 = fx0 - fx0;
    var ty: f64 = fy0 - fy0;
    if (tx != 0.0 || ty != 0.0) {
        var nan: f64 = PV_F64_NAN;
        return nan;
    }
    var nxf: f64 = f64_from(nx);
    var nyf: f64 = f64_from(ny);
    var ax: f64 = _pv_fmod(fx0, nxf);
    var bx: f64 = ax + nxf;
    var fx: f64 = _pv_fmod(bx, nxf);
    var ay: f64 = _pv_fmod(fy0, nyf);
    var by: f64 = ay + nyf;
    var fy: f64 = _pv_fmod(by, nyf);
    var flx: f64 = f64_floor(fx);
    var fly: f64 = f64_floor(fy);
    var x0 = f64_to(flx) % nx;
    var y0 = f64_to(fly) % ny;
    var x1 = (x0 + 1) % nx;
    var y1 = (y0 + 1) % ny;
    var sx: f64 = fx - flx;
    var sy: f64 = fy - fly;
    var v00: f64 = load64(f + (y0 * nx + x0) * 8);
    var v10: f64 = load64(f + (y0 * nx + x1) * 8);
    var v01: f64 = load64(f + (y1 * nx + x0) * 8);
    var v11: f64 = load64(f + (y1 * nx + x1) * 8);
    var osx: f64 = 1.0 - sx;
    var osy: f64 = 1.0 - sy;
    var r: f64 = ((((v00 * osx) * osy) + ((v10 * sx) * osy)) + ((v01 * osx) * sy)) + ((v11 * sx) * sy);
    return r;
}

# The rows [y0, y1) of a periodic advection (a `_pv_par_for` kernel; ctx as `_pv_fg_advect_k`'s): every cell of
# each row, the ring included.
fn _pv_fg_advect_periodic_k(ctx, y0, y1) {
    var dst = load64(ctx);
    var src = load64(ctx + 8);
    var vx = load64(ctx + 16);
    var vy = load64(ctx + 24);
    var nx = load64(ctx + 32);
    var ny = load64(ctx + 40);
    var k: f64 = load64(ctx + 48);
    for (var y = y0; y < y1; y = y + 1) {
        var yf: f64 = f64_from(y);
        for (var x = 0; x < nx; x = x + 1) {
            var i = y * nx + x;
            var xf: f64 = f64_from(x);
            var u: f64 = load64(vx + i * 8);
            var v: f64 = load64(vy + i * 8);
            var fx: f64 = xf - (k * u);
            var fy: f64 = yf - (k * v);
            var s: f64 = _pv_fg_sample_periodic(src, nx, ny, fx, fy);
            store64(dst + i * 8, _pv_bits(s));
        }
    }
    return 0;
}

# Semi-Lagrangian advection with periodic wrapping, over every cell (the ring included), the rows split across
# `pool`. Mirrors the private `advect_periodic`, one of Rust's three `parallel` loops.
fn _pv_fg_advect_periodic(dst, src, vx, vy, nx, ny, dt: f64, inv_dx: f64, pool) {
    var trace = _pv_span(_PV_LOG_GRID, "grid::advect_periodic", "nx", nx, "ny", ny, 0, 0);
    var k: f64 = dt * inv_dx;
    var ctx[56];
    _pv_fg_advect_ctx(&ctx, dst, src, vx, vy, nx, ny, k);
    _pv_par_for(pool, 0, ny, &_pv_fg_advect_periodic_k, &ctx);
    _pv_span_end(trace); return 0;
}

# MacCormack advection of src into dst: the forward semi-Lagrangian step, the source's ring copied into it, the
# backward step from it into temp, then dst + ½(src − temp) clamped to the stencil of the backtraced point in src.
# The forward step's rows split across `pool`, as Rust's `advect` call is; the rest is serial, as Rust's is. Mirrors
# the private `advect_maccormack`.
fn _pv_fg_advect_maccormack(dst, src, vx, vy, nx, ny, dt: f64, inv_dx: f64, temp, pool) {
    var trace = _pv_span(_PV_LOG_GRID, "grid::advect_maccormack", "nx", nx, "ny", ny, 0, 0);
    var k: f64 = dt * inv_dx;
    _pv_fg_advect_raw(dst, src, vx, vy, nx, ny, dt, inv_dx, pool);
    _pv_fg_copy_ring(dst, src, nx, ny);
    for (var y = 1; y < ny - 1; y = y + 1) {
        var yf: f64 = f64_from(y);
        for (var x = 1; x < nx - 1; x = x + 1) {
            var i = y * nx + x;
            var xf: f64 = f64_from(x);
            var u: f64 = load64(vx + i * 8);
            var v: f64 = load64(vy + i * 8);
            var fx: f64 = xf + (k * u);
            var fy: f64 = yf + (k * v);
            var s: f64 = _pv_fg_sample(dst, nx, ny, fx, fy);
            store64(temp + i * 8, _pv_bits(s));
        }
    }
    for (var y2 = 1; y2 < ny - 1; y2 = y2 + 1) {
        var yf2: f64 = f64_from(y2);
        for (var x2 = 1; x2 < nx - 1; x2 = x2 + 1) {
            var j = y2 * nx + x2;
            var dj: f64 = load64(dst + j * 8);
            var sj: f64 = load64(src + j * 8);
            var tj: f64 = load64(temp + j * 8);
            var corrected: f64 = dj + (0.5 * (sj - tj));
            var xf2: f64 = f64_from(x2);
            var u2: f64 = load64(vx + j * 8);
            var v2: f64 = load64(vy + j * 8);
            var gx: f64 = xf2 - (k * u2);
            var gy: f64 = yf2 - (k * v2);
            var lo, hi = _pv_fg_bounds(src, nx, ny, gx, gy);
            var lof: f64 = lo;
            var hif: f64 = hi;
            var c: f64 = _pv_fg_clamp_safe(corrected, lof, hif);
            store64(dst + j * 8, _pv_bits(c));
        }
    }
    _pv_span_end(trace); return 0;
}

# BFECC advection of src into dst: forward into temp1 (the source's ring copied in), backward into temp2, the
# compensated source src + ½(src − temp2) in temp2 (ring from src), and its forward advection clamped to the stencil
# of the backtraced point in src. The first forward step's rows split across `pool`, as Rust's `advect` call is;
# the rest is serial, as Rust's is. Mirrors the private `advect_bfecc`.
fn _pv_fg_advect_bfecc(dst, src, vx, vy, nx, ny, dt: f64, inv_dx: f64, temp1, temp2, pool) {
    var trace = _pv_span(_PV_LOG_GRID, "grid::advect_bfecc", "nx", nx, "ny", ny, 0, 0);
    var k: f64 = dt * inv_dx;
    _pv_fg_advect_raw(temp1, src, vx, vy, nx, ny, dt, inv_dx, pool);
    _pv_fg_copy_ring(temp1, src, nx, ny);
    for (var y = 1; y < ny - 1; y = y + 1) {
        var yf: f64 = f64_from(y);
        for (var x = 1; x < nx - 1; x = x + 1) {
            var i = y * nx + x;
            var xf: f64 = f64_from(x);
            var u: f64 = load64(vx + i * 8);
            var v: f64 = load64(vy + i * 8);
            var fx: f64 = xf + (k * u);
            var fy: f64 = yf + (k * v);
            var s: f64 = _pv_fg_sample(temp1, nx, ny, fx, fy);
            store64(temp2 + i * 8, _pv_bits(s));
        }
    }
    _pv_fg_copy_ring(temp2, src, nx, ny);
    for (var y2 = 1; y2 < ny - 1; y2 = y2 + 1) {
        for (var x2 = 1; x2 < nx - 1; x2 = x2 + 1) {
            var j = y2 * nx + x2;
            var sj: f64 = load64(src + j * 8);
            var tj: f64 = load64(temp2 + j * 8);
            var w: f64 = sj + (0.5 * (sj - tj));
            store64(temp2 + j * 8, _pv_bits(w));
        }
    }
    for (var y3 = 1; y3 < ny - 1; y3 = y3 + 1) {
        var yf3: f64 = f64_from(y3);
        for (var x3 = 1; x3 < nx - 1; x3 = x3 + 1) {
            var q = y3 * nx + x3;
            var xf3: f64 = f64_from(x3);
            var u3: f64 = load64(vx + q * 8);
            var v3: f64 = load64(vy + q * 8);
            var gx: f64 = xf3 - (k * u3);
            var gy: f64 = yf3 - (k * v3);
            var sv: f64 = _pv_fg_sample(temp2, nx, ny, gx, gy);
            var lo, hi = _pv_fg_bounds(src, nx, ny, gx, gy);
            var lof: f64 = lo;
            var hif: f64 = hi;
            var c: f64 = _pv_fg_clamp_safe(sv, lof, hif);
            store64(dst + q * 8, _pv_bits(c));
        }
    }
    _pv_span_end(trace); return 0;
}

# ── diffusion ───────────────────────────────────────────────────────────────────────

# Gauss–Seidel diffusion of field (nx × ny) with rhs as the right-hand side buffer (resized to nx·ny and set to the
# field): `iterations` sweeps of field = (rhs + a·Σ neighbours)/(1 + 4a), a = (dt·diff_rate)/(dx·dx). 1, or 0 when
# rhs can't grow (field unchanged). Mirrors the private `diffuse_with_buf`.
fn _pv_fg_diffuse_buf(field, nx, ny, diff_rate: f64, dt: f64, dx: f64, iterations, rhs: *PvColumn): i64 {
    var trace = _pv_span(_PV_LOG_GRID, "grid::diffuse", "nx", nx, "ny", ny, "iterations", iterations);
    var a: f64 = (dt * diff_rate) / (dx * dx);
    var inv_denom: f64 = 1.0 / (1.0 + (4.0 * a));
    var n = nx * ny;
    if (rhs.resize(n, 0) == 0) { _pv_span_end(trace); return 0; }
    var rd = rhs.data;
    _pv_fg_copy(rd, field, n);
    for (var it = 0; it < iterations; it = it + 1) {
        for (var y = 1; y < ny - 1; y = y + 1) {
            for (var x = 1; x < nx - 1; x = x + 1) {
                var p = field + (y * nx + x) * 8;
                var l: f64 = load64(p - 8);
                var r: f64 = load64(p + 8);
                var d: f64 = load64(p - nx * 8);
                var u: f64 = load64(p + nx * 8);
                var nb: f64 = ((l + r) + d) + u;
                var b: f64 = load64(rd + (y * nx + x) * 8);
                var v: f64 = (b + (a * nb)) * inv_denom;
                store64(p, _pv_bits(v));
            }
        }
    }
    _pv_span_end(trace); return 1;
}

# Diffuses `field` (`len` f64s, nx × ny) in place by Gauss–Seidel: the implicit (I − a·∇²)·x_new = x_old with
# a = (dt·diff_rate)/dx², `iterations` sweeps over the interior, the original field as the right-hand side. 1, or
# 0 with the field unchanged when nx or ny is below 3, nx·ny overflows or isn't `len` (Rust warns and returns), or
# the right-hand side can't be allocated (Rust aborts). Mirrors `FluidGrid::diffuse`.
fn PvFluidGrid_diffuse(field, len, nx, ny, diff_rate: f64, dt: f64, dx: f64, iterations): i64 {
    var trace = _pv_span(_PV_LOG_GRID, "grid::diffuse", "nx", nx, "ny", ny, 0, 0);
    if (nx < 3 || ny < 3 || nx > 0x7FFFFFFFFFFFFFFF / ny || nx * ny != len) {
        _pv_warn(_PV_LOG_GRID, "grid::diffuse: size mismatch ignored", "nx", nx, "ny", ny, "len", len);
        _pv_span_end(trace); return 0;
    }
    var rhs: PvColumn = PvColumn_new();
    var ok = _pv_fg_diffuse_buf(field, nx, ny, diff_rate, dt, dx, iterations, &rhs);
    rhs.drop();
    _pv_span_end(trace); return ok;
}

# ── pressure projection ─────────────────────────────────────────────────────────────

# div = −((vx[i+1] − vx[i−1]) + (vy[i+nx] − vy[i−nx]))·scale on the interior. With scale dx/2 it is −dx²·∇·u, the
# right-hand side of the unit-stencil Poisson system. Mirrors the private `divergence`.
fn _pv_fg_divergence(div, vx, vy, nx, ny, scale: f64) {
    var trace = _pv_span(_PV_LOG_GRID, "grid::divergence", "nx", nx, "ny", ny, 0, 0);
    for (var y = 1; y < ny - 1; y = y + 1) {
        for (var x = 1; x < nx - 1; x = x + 1) {
            var i = y * nx + x;
            var xr: f64 = load64(vx + (i + 1) * 8);
            var xl: f64 = load64(vx + (i - 1) * 8);
            var yu: f64 = load64(vy + (i + nx) * 8);
            var yd: f64 = load64(vy + (i - nx) * 8);
            var s: f64 = (xr - xl) + (yu - yd);
            var ns: f64 = -s;
            var d: f64 = ns * scale;
            store64(div + i * 8, _pv_bits(d));
        }
    }
    _pv_span_end(trace); return 0;
}

# `iterations` Gauss–Seidel sweeps of 4·p − Σ p = rhs on the interior, warm-started from p, the ring held. Mirrors the
# private `pressure_solve` (always Ok).
fn _pv_fg_pressure_gs(p, div, nx, ny, iterations) {
    var trace = _pv_span(_PV_LOG_GRID, "grid::pressure_solve", "nx", nx, "ny", ny, "iterations", iterations);
    for (var it = 0; it < iterations; it = it + 1) {
        for (var y = 1; y < ny - 1; y = y + 1) {
            for (var x = 1; x < nx - 1; x = x + 1) {
                var q = p + (y * nx + x) * 8;
                var l: f64 = load64(q - 8);
                var r: f64 = load64(q + 8);
                var d: f64 = load64(q - nx * 8);
                var u: f64 = load64(q + nx * 8);
                var nb: f64 = ((l + r) + d) + u;
                var b: f64 = load64(div + (y * nx + x) * 8);
                var v: f64 = (b + nb) * 0.25;
                store64(q, _pv_bits(v));
            }
        }
    }
    _pv_span_end(trace); return 0;
}

# The DST plan of transform length n (≥ 1) in *tab: the n² sines of `_pv_dst_sines`, then the n eigenvalue terms
# 2·cos((π·(k+1))/(n+1)) − 2 of `pressure_solve_dst`. Each value depends only on n, and n² + n words name n, so a
# column already that long holds the plan and is kept; else it is rebuilt. 1, or 0 when the memory isn't there.
#must_use
fn _pv_fg_dst_plan(n, tab: *PvColumn): i64 {
    var words = n * n + n;
    if (tab.len == words) { return 1; }
    if (tab.resize(words, 0) == 0) { return 0; }
    _pv_dst_sines(n, tab.data);
    var pi: f64 = PV_F64_PI;
    var np1: f64 = f64_from(n + 1);
    var terms = tab.data + n * n * 8;
    for (var k = 0; k < n; k = k + 1) {
        var kf: f64 = f64_from(k + 1);
        var a: f64 = (pi * kf) / np1;
        var c: f64 = _pv_cos(a);
        var l: f64 = (2.0 * c) - 2.0;
        store64(terms + k * 8, _pv_bits(l));
    }
    return 1;
}

# The DST pressure solve of 4p − Σp = div with p = 0 on the ring: the interior divergence transformed by DST-I rows
# then columns, divided by the eigenvalues μ = −((2cos(π(kx+1)/(inx+1)) − 2) + (2cos(π(ky+1)/(iny+1)) − 2)) where
# |μ| > 1e-12, transformed back by IDST-I rows then columns; then all `plen` words of p zeroed and the interior
# written. ra, rb and rc are scratch columns (inx·iny, and the longer side twice); tx and ty hold the plans of the
# two transform lengths (tx alone when they are equal), kept for the next call. Ok(0) (also when the interior is
# empty), or Err(PV_ERR_OUT_OF_MEMORY) when the scratch can't grow. Mirrors the private `pressure_solve_dst`, with
# its per-term sines and per-cell cosines read from the plans (the same values).
#must_use
fn _pv_fg_pressure_dst(p, plen, div, nx, ny, ra: *PvColumn, rb: *PvColumn, rc: *PvColumn, tx: *PvColumn,
  ty: *PvColumn): Result {
    var trace = _pv_span(_PV_LOG_GRID, "grid::pressure_solve_dst", "nx", nx, "ny", ny, 0, 0);
    var inx = nx - 2;
    var iny = ny - 2;
    if (inx <= 0 || iny <= 0) { _pv_span_end(trace); return Ok(0); }
    var longest = inx;
    if (iny > longest) { longest = iny; }
    if (ra.resize(inx * iny, 0) == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
    if (rb.resize(longest, 0) == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
    if (rc.resize(longest, 0) == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
    if (_pv_fg_dst_plan(inx, tx) == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
    var py: *PvColumn = tx;
    if (iny != inx) {
        if (_pv_fg_dst_plan(iny, ty) == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
        py = ty;
    }
    var sx = tx.data;
    var sy = py.data;
    var rhs = ra.data;
    var col = rb.data;
    var tr = rc.data;
    for (var iy = 0; iy < iny; iy = iy + 1) {
        _pv_fg_copy(rhs + iy * inx * 8, div + ((iy + 1) * nx + 1) * 8, inx);
    }
    # The forward transform: rows, then columns.
    for (var r = 0; r < iny; r = r + 1) {
        var row = rhs + r * inx * 8;
        _pv_dst(row, inx, sx, tr);
        _pv_fg_copy(row, tr, inx);
    }
    for (var cx = 0; cx < inx; cx = cx + 1) {
        for (var cy = 0; cy < iny; cy = cy + 1) { store64(col + cy * 8, load64(rhs + (cy * inx + cx) * 8)); }
        _pv_dst(col, iny, sy, tr);
        for (var cy2 = 0; cy2 < iny; cy2 = cy2 + 1) { store64(rhs + (cy2 * inx + cx) * 8, load64(tr + cy2 * 8)); }
    }
    # The eigenvalues of the unit-stencil operator, from the plans' terms.
    var lxs = sx + inx * inx * 8;
    var lys = sy + iny * iny * 8;
    var tiny: f64 = 0x3D719799812DEA11;   # 1e-12
    for (var ky = 0; ky < iny; ky = ky + 1) {
        var ly: f64 = load64(lys + ky * 8);
        for (var kx = 0; kx < inx; kx = kx + 1) {
            var lx: f64 = load64(lxs + kx * 8);
            var s: f64 = lx + ly;
            var eig: f64 = -s;
            var ae: f64 = f64_abs(eig);
            if (ae > tiny) {
                var at = rhs + (ky * inx + kx) * 8;
                var v: f64 = load64(at);
                var w: f64 = v / eig;
                store64(at, _pv_bits(w));
            }
        }
    }
    # The inverse transform: rows, then columns.
    for (var r2 = 0; r2 < iny; r2 = r2 + 1) {
        var row2 = rhs + r2 * inx * 8;
        _pv_idst(row2, inx, sx, tr);
        _pv_fg_copy(row2, tr, inx);
    }
    for (var dx2 = 0; dx2 < inx; dx2 = dx2 + 1) {
        for (var dy = 0; dy < iny; dy = dy + 1) { store64(col + dy * 8, load64(rhs + (dy * inx + dx2) * 8)); }
        _pv_idst(col, iny, sy, tr);
        for (var dy2 = 0; dy2 < iny; dy2 = dy2 + 1) { store64(rhs + (dy2 * inx + dx2) * 8, load64(tr + dy2 * 8)); }
    }
    _pv_fg_fill(p, plen, 0);
    for (var oy = 0; oy < iny; oy = oy + 1) {
        _pv_fg_copy(p + ((oy + 1) * nx + 1) * 8, rhs + oy * inx * 8, inx);
    }
    _pv_span_end(trace); return Ok(0);
}

# One multigrid V-cycle on 4p − Σp = rhs (nx × ny) at `depth`: below 7 cells a side (or at depth 10) 50 Gauss–Seidel
# sweeps; otherwise nu pre-smoothing sweeps, the residual restricted by full weighting to the vertex-centred coarse
# grid (⌈nx/2⌉ × ⌈ny/2⌉, its right-hand side 4× the restricted residual), a V-cycle there, the correction prolonged
# bilinearly, and nu post-smoothing sweeps. The level buffers persist in `levels` (pushed as first reached). 1, or 0
# when a level's buffers can't be allocated. Mirrors the private `mg_vcycle`.
fn _pv_fg_mg_vcycle(p, rhs, nx, ny, nu, levels: *PvColumn, depth): i64 {
    if (nx <= 6 || ny <= 6 || depth >= 10) {
        _pv_fg_pressure_gs(p, rhs, nx, ny, 50);
        return 1;
    }
    _pv_fg_pressure_gs(p, rhs, nx, ny, nu);
    var n = nx * ny;
    var cnx = (nx + 1) / 2;
    var cny = (ny + 1) / 2;
    if (cnx < 4 || cny < 4) {
        _pv_fg_pressure_gs(p, rhs, nx, ny, nu * 4);
        return 1;
    }
    var cn = cnx * cny;
    while (levels.len <= depth) {
        if (_pv_mg_levels_push(levels) == 0) { return 0; }
    }
    var lv = load64(levels.data + depth * 8);
    var res_c: *PvColumn = _pv_mg_col(lv, 0);
    var crhs_c: *PvColumn = _pv_mg_col(lv, 1);
    var cp_c: *PvColumn = _pv_mg_col(lv, 2);
    if (res_c.resize(n, 0) == 0) { return 0; }
    if (crhs_c.resize(cn, 0) == 0) { return 0; }
    if (cp_c.resize(cn, 0) == 0) { return 0; }
    var res = res_c.data;
    var crhs = crhs_c.data;
    var cp = cp_c.data;
    _pv_fg_fill(cp, cn, 0);
    _pv_fg_fill(res, n, 0);
    # The residual of the smoother's system: r = rhs − (4p − Σp).
    for (var y = 1; y < ny - 1; y = y + 1) {
        for (var x = 1; x < nx - 1; x = x + 1) {
            var i = y * nx + x;
            var q = p + i * 8;
            var pc: f64 = load64(q);
            var l: f64 = load64(q - 8);
            var r: f64 = load64(q + 8);
            var d: f64 = load64(q - nx * 8);
            var u: f64 = load64(q + nx * 8);
            var a_p: f64 = (4.0 * pc) - (((l + r) + d) + u);
            var b: f64 = load64(rhs + i * 8);
            var rv: f64 = b - a_p;
            store64(res + i * 8, _pv_bits(rv));
        }
    }
    # Restriction (full weighting).
    _pv_fg_fill(crhs, cn, 0);
    for (var cy = 1; cy < cny - 1; cy = cy + 1) {
        for (var cx = 1; cx < cnx - 1; cx = cx + 1) {
            var fi = (cy * 2) * nx + cx * 2;
            var f = res + fi * 8;
            var c0: f64 = load64(f);
            var w: f64 = load64(f - 8);
            var e: f64 = load64(f + 8);
            var s: f64 = load64(f - nx * 8);
            var nn: f64 = load64(f + nx * 8);
            var sw: f64 = load64(f - nx * 8 - 8);
            var se: f64 = load64(f - nx * 8 + 8);
            var nw: f64 = load64(f + nx * 8 - 8);
            var ne: f64 = load64(f + nx * 8 + 8);
            var edges: f64 = ((w + e) + s) + nn;
            var t: f64 = ((((((4.0 * c0) + (2.0 * edges)) + sw) + se) + nw) + ne) * 0.25;
            store64(crhs + (cy * cnx + cx) * 8, _pv_bits(t));
        }
    }
    if (_pv_fg_mg_vcycle(cp, crhs, cnx, cny, nu, levels, depth + 1) == 0) { return 0; }
    # Prolongation (bilinear): even fine points take the coarse value, odd ones average their 2 or 4 coarse parents;
    # a parent outside the coarse grid reads 0, and the ring stays.
    for (var py = 1; py < ny - 1; py = py + 1) {
        var gy = py / 2;
        var odd_y = py % 2;
        for (var px = 1; px < nx - 1; px = px + 1) {
            var gx = px / 2;
            var odd_x = px % 2;
            var c00: f64 = 0.0;
            if (gx < cnx && gy < cny) { c00 = load64(cp + (gy * cnx + gx) * 8); }
            var corr: f64 = c00;
            if (odd_x == 1 && odd_y == 0) {
                var c10: f64 = 0.0;
                if (gx + 1 < cnx && gy < cny) { c10 = load64(cp + (gy * cnx + gx + 1) * 8); }
                corr = 0.5 * (c00 + c10);
            } elif (odd_x == 0 && odd_y == 1) {
                var c01: f64 = 0.0;
                if (gx < cnx && gy + 1 < cny) { c01 = load64(cp + ((gy + 1) * cnx + gx) * 8); }
                corr = 0.5 * (c00 + c01);
            } elif (odd_x == 1 && odd_y == 1) {
                var d10: f64 = 0.0;
                if (gx + 1 < cnx && gy < cny) { d10 = load64(cp + (gy * cnx + gx + 1) * 8); }
                var d01: f64 = 0.0;
                if (gx < cnx && gy + 1 < cny) { d01 = load64(cp + ((gy + 1) * cnx + gx) * 8); }
                var d11: f64 = 0.0;
                if (gx + 1 < cnx && gy + 1 < cny) { d11 = load64(cp + ((gy + 1) * cnx + gx + 1) * 8); }
                corr = 0.25 * (((c00 + d10) + d01) + d11);
            }
            var at = p + (py * nx + px) * 8;
            var pv: f64 = load64(at);
            var pn: f64 = pv + corr;
            store64(at, _pv_bits(pn));
        }
    }
    _pv_fg_pressure_gs(p, rhs, nx, ny, nu);
    return 1;
}

# `cycles` V-cycles (at least 1) with nu smoothing sweeps per level, the level buffers in `levels`. Ok(0), or
# Err(PV_ERR_OUT_OF_MEMORY) when a level can't be allocated (Rust aborts). Mirrors the private
# `pressure_solve_multigrid`.
#must_use
fn _pv_fg_pressure_mg(p, div, nx, ny, nu, cycles, levels: *PvColumn): Result {
    var trace = _pv_span(_PV_LOG_GRID, "grid::multigrid", "nx", nx, "ny", ny, "cycles", cycles);
    var c = cycles;
    if (c < 1) { c = 1; }
    for (var k = 0; k < c; k = k + 1) {
        if (_pv_fg_mg_vcycle(p, div, nx, ny, nu, levels, 0) == 0) {
            _pv_span_end(trace);
            return Err(PV_ERR_OUT_OF_MEMORY);
        }
    }
    _pv_span_end(trace); return Ok(0);
}

# The unit-stencil operator of the pressure systems, for `_pv_cg`: out = 4v − (((v[i−1] + v[i+1]) + v[i−nx]) +
# v[i+nx]) on the interior, 0 on the ring. ctx holds the words nx, ny. Mirrors the `a_mul` closure of
# `pressure_solve_cg`.
fn _pv_fg_stencil(ctx, v, out) {
    var nx = load64(ctx);
    var ny = load64(ctx + 8);
    _pv_fg_fill(out, nx * ny, 0);
    for (var y = 1; y < ny - 1; y = y + 1) {
        for (var x = 1; x < nx - 1; x = x + 1) {
            var i = y * nx + x;
            var q = v + i * 8;
            var c: f64 = load64(q);
            var l: f64 = load64(q - 8);
            var r: f64 = load64(q + 8);
            var d: f64 = load64(q - nx * 8);
            var u: f64 = load64(q + nx * 8);
            var a: f64 = (4.0 * c) - (((l + r) + d) + u);
            store64(out + i * 8, _pv_bits(a));
        }
    }
    return 0;
}

# The conjugate-gradient pressure solve of 4p − Σp = div (nx·ny unknowns, p the guess and the result): tolerance
# max(1e-6·‖div‖, 1e-14), at most `iterations` iterations. ra, rb and rc are scratch columns (nx·ny each). Ok(0);
# Err(PV_ERR_DIVERGED) for an empty system (hisab's InvalidInput, which Rust maps to Diverged), or
# Err(PV_ERR_OUT_OF_MEMORY) when the scratch can't grow. Mirrors the private `pressure_solve_cg`.
#must_use
fn _pv_fg_pressure_cg(p, div, nx, ny, iterations, ra: *PvColumn, rb: *PvColumn, rc: *PvColumn): Result {
    var trace = _pv_span(_PV_LOG_GRID, "grid::pressure_solve_cg", "nx", nx, "ny", ny, "iterations", iterations);
    var n = nx * ny;
    var ss: f64 = _pv_cg_dot(div, div, n);
    var b_norm: f64 = f64_sqrt(ss);
    var lo: f64 = 0x3D06849B86A12B9B;   # 1e-14
    var rel: f64 = 0x3EB0C6F7A0B5ED8D;  # 1e-6
    var t0: f64 = rel * b_norm;
    var tol: f64 = _pv_max(t0, lo);
    if (n <= 0) { _pv_span_end(trace); return Err(PV_ERR_DIVERGED); }
    if (ra.resize(n, 0) == 0 || rb.resize(n, 0) == 0 || rc.resize(n, 0) == 0) {
        _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY);
    }
    var ctx[16];
    store64(&ctx, nx);
    store64(&ctx + 8, ny);
    _pv_cg(&_pv_fg_stencil, &ctx, div, p, n, tol, iterations, ra.data, rb.data, rc.data);
    _pv_span_end(trace); return Ok(0);
}

# u −= ∇p by central differences (scaled by inv_2dx) on the interior, the rows split across `pool`. Mirrors the
# private `project_velocity`, one of Rust's three `parallel` loops.
fn _pv_fg_project(vx, vy, p, nx, ny, inv_2dx: f64, pool) {
    var trace = _pv_span(_PV_LOG_GRID, "grid::project", 0, 0, 0, 0, 0, 0);
    var ctx[48];
    store64(&ctx, vx);
    store64(&ctx + 8, vy);
    store64(&ctx + 16, p);
    store64(&ctx + 24, nx);
    store64(&ctx + 32, ny);
    store64(&ctx + 40, _pv_bits(inv_2dx));
    _pv_par_for(pool, 1, ny - 1, &_pv_fg_project_k, &ctx);
    _pv_span_end(trace); return 0;
}

# The rows [y0, y1) of the projection (a `_pv_par_for` kernel): ctx holds vx, vy, p, nx, ny and the f64 inv_2dx.
# Each row updates only its own interior cells of vx and vy, from p.
fn _pv_fg_project_k(ctx, y0, y1) {
    var vx = load64(ctx);
    var vy = load64(ctx + 8);
    var p = load64(ctx + 16);
    var nx = load64(ctx + 24);
    var inv_2dx: f64 = load64(ctx + 40);
    for (var y = y0; y < y1; y = y + 1) {
        for (var x = 1; x < nx - 1; x = x + 1) {
            var i = y * nx + x;
            var q = p + i * 8;
            var pr: f64 = load64(q + 8);
            var pl: f64 = load64(q - 8);
            var pu: f64 = load64(q + nx * 8);
            var pd: f64 = load64(q - nx * 8);
            var u: f64 = load64(vx + i * 8);
            var v: f64 = load64(vy + i * 8);
            var un: f64 = u - ((pr - pl) * inv_2dx);
            var vn: f64 = v - ((pu - pd) * inv_2dx);
            store64(vx + i * 8, _pv_bits(un));
            store64(vy + i * 8, _pv_bits(vn));
        }
    }
    return 0;
}

# ── vorticity confinement and walls ─────────────────────────────────────────────────

# Vorticity confinement: ω = ∂vy/∂x − ∂vx/∂y into vort on the interior, then, two cells in from the walls, the force
# ε·dx·dt·(N × ω) with N = ∇|ω|/‖∇|ω|‖, skipped where |ω| or ‖∇|ω|‖ is below 1e-10. Mirrors the private
# `apply_vorticity_confinement`.
fn _pv_fg_vorticity(vx, vy, nx, ny, dx: f64, dt: f64, epsilon: f64, vort) {
    var trace = _pv_span(_PV_LOG_GRID, "grid::vorticity_confinement", 0, 0, 0, 0, 0, 0);
    var inv_2dx: f64 = 0.5 / dx;
    for (var y = 1; y < ny - 1; y = y + 1) {
        for (var x = 1; x < nx - 1; x = x + 1) {
            var i = y * nx + x;
            var vr: f64 = load64(vy + (i + 1) * 8);
            var vl: f64 = load64(vy + (i - 1) * 8);
            var uu: f64 = load64(vx + (i + nx) * 8);
            var ud: f64 = load64(vx + (i - nx) * 8);
            var dvydx: f64 = (vr - vl) * inv_2dx;
            var dvxdy: f64 = (uu - ud) * inv_2dx;
            var w: f64 = dvydx - dvxdy;
            store64(vort + i * 8, _pv_bits(w));
        }
    }
    var tiny: f64 = 0x3DDB7CDFD9D7BDBB;   # 1e-10
    var scale: f64 = (epsilon * dx) * dt;
    for (var y2 = 2; y2 < ny - 2; y2 = y2 + 1) {
        for (var x2 = 2; x2 < nx - 2; x2 = x2 + 1) {
            var j = y2 * nx + x2;
            var q = vort + j * 8;
            var wj: f64 = load64(q);
            var abs_w: f64 = f64_abs(wj);
            if (abs_w < tiny) { continue; }
            var wr: f64 = load64(q + 8);
            var wl: f64 = load64(q - 8);
            var wu: f64 = load64(q + nx * 8);
            var wd: f64 = load64(q - nx * 8);
            var awr: f64 = f64_abs(wr);
            var awl: f64 = f64_abs(wl);
            var awu: f64 = f64_abs(wu);
            var awd: f64 = f64_abs(wd);
            var eta_x: f64 = (awr - awl) * inv_2dx;
            var eta_y: f64 = (awu - awd) * inv_2dx;
            var m2: f64 = (eta_x * eta_x) + (eta_y * eta_y);
            var eta_mag: f64 = f64_sqrt(m2);
            if (eta_mag < tiny) { continue; }
            var nx_v: f64 = eta_x / eta_mag;
            var ny_v: f64 = eta_y / eta_mag;
            var u: f64 = load64(vx + j * 8);
            var v: f64 = load64(vy + j * 8);
            var un: f64 = u + ((scale * ny_v) * wj);
            var vn: f64 = v - ((scale * nx_v) * wj);
            store64(vx + j * 8, _pv_bits(un));
            store64(vy + j * 8, _pv_bits(vn));
        }
    }
    _pv_span_end(trace); return 0;
}

# Stores −x at word index d.
fn _pv_fg_neg_to(p, d, s) {
    var x: f64 = load64(p + s * 8);
    var nx: f64 = -x;
    store64(p + d * 8, _pv_bits(nx));
    return 0;
}

# Stores the word at index s to index d.
fn _pv_fg_mov(p, d, s) {
    store64(p + d * 8, load64(p + s * 8));
    return 0;
}

# The velocity ghosts by wall rule: no-slip reflects both components, free-slip reflects the normal one and copies
# the tangential one (the wall on the face between the ghost and the first interior cell), periodic copies the
# opposite interior row and column, then the corners from the diagonal cell. An unknown rule leaves the ring. Mirrors
# the private `enforce_boundary`.
fn _pv_fg_enforce(vx, vy, nx, ny, bc) {
    if (bc == PV_BOUNDARY_CONDITION_NO_SLIP) {
        for (var x = 0; x < nx; x = x + 1) {
            _pv_fg_neg_to(vx, x, nx + x);
            _pv_fg_neg_to(vy, x, nx + x);
            var top = (ny - 1) * nx + x;
            var below = (ny - 2) * nx + x;
            _pv_fg_neg_to(vx, top, below);
            _pv_fg_neg_to(vy, top, below);
        }
        for (var y = 0; y < ny; y = y + 1) {
            var l = y * nx;
            _pv_fg_neg_to(vx, l, l + 1);
            _pv_fg_neg_to(vy, l, l + 1);
            var r = y * nx + nx - 1;
            _pv_fg_neg_to(vx, r, r - 1);
            _pv_fg_neg_to(vy, r, r - 1);
        }
        return 0;
    }
    if (bc == PV_BOUNDARY_CONDITION_FREE_SLIP) {
        for (var x2 = 0; x2 < nx; x2 = x2 + 1) {
            _pv_fg_mov(vx, x2, nx + x2);
            _pv_fg_neg_to(vy, x2, nx + x2);
            var top2 = (ny - 1) * nx + x2;
            var below2 = (ny - 2) * nx + x2;
            _pv_fg_mov(vx, top2, below2);
            _pv_fg_neg_to(vy, top2, below2);
        }
        for (var y2 = 0; y2 < ny; y2 = y2 + 1) {
            var l2 = y2 * nx;
            _pv_fg_neg_to(vx, l2, l2 + 1);
            _pv_fg_mov(vy, l2, l2 + 1);
            var r2 = y2 * nx + nx - 1;
            _pv_fg_neg_to(vx, r2, r2 - 1);
            _pv_fg_mov(vy, r2, r2 - 1);
        }
        return 0;
    }
    if (bc == PV_BOUNDARY_CONDITION_PERIODIC) {
        for (var x3 = 0; x3 < nx; x3 = x3 + 1) {
            _pv_fg_mov(vx, x3, (ny - 2) * nx + x3);
            _pv_fg_mov(vy, x3, (ny - 2) * nx + x3);
            _pv_fg_mov(vx, (ny - 1) * nx + x3, nx + x3);
            _pv_fg_mov(vy, (ny - 1) * nx + x3, nx + x3);
        }
        for (var y3 = 0; y3 < ny; y3 = y3 + 1) {
            _pv_fg_mov(vx, y3 * nx, y3 * nx + nx - 2);
            _pv_fg_mov(vy, y3 * nx, y3 * nx + nx - 2);
            _pv_fg_mov(vx, y3 * nx + nx - 1, y3 * nx + 1);
            _pv_fg_mov(vy, y3 * nx + nx - 1, y3 * nx + 1);
        }
        var c = (ny - 2) * nx + nx - 2;
        _pv_fg_mov(vx, 0, c);
        _pv_fg_mov(vy, 0, c);
        _pv_fg_mov(vx, nx - 1, (ny - 2) * nx + 1);
        _pv_fg_mov(vy, nx - 1, (ny - 2) * nx + 1);
        _pv_fg_mov(vx, (ny - 1) * nx, nx + nx - 2);
        _pv_fg_mov(vy, (ny - 1) * nx, nx + nx - 2);
        _pv_fg_mov(vx, (ny - 1) * nx + nx - 1, nx + 1);
        _pv_fg_mov(vy, (ny - 1) * nx + nx - 1, nx + 1);
    }
    return 0;
}

# The scalar ghosts: each ring cell copies its interior neighbour (zero gradient), rows first, then columns.
# Mirrors the private `enforce_scalar_boundary`.
fn _pv_fg_enforce_scalar(f, nx, ny) {
    for (var x = 0; x < nx; x = x + 1) {
        _pv_fg_mov(f, x, nx + x);
        _pv_fg_mov(f, (ny - 1) * nx + x, (ny - 2) * nx + x);
    }
    for (var y = 0; y < ny; y = y + 1) {
        _pv_fg_mov(f, y * nx, y * nx + 1);
        _pv_fg_mov(f, y * nx + nx - 1, y * nx + nx - 2);
    }
    return 0;
}

# 1 when any of the n f64s at p is NaN (all = 0) or not finite (all = 1).
#must_use
fn _pv_fg_any_bad(p, n, all): i64 {
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = load64(p + i * 8);
        if (all == 1) {
            var d: f64 = x - x;
            if (d != 0.0) { return 1; }
        } elif (x != x) {
            return 1;
        }
    }
    return 0;
}

# One advection of src into dst by the configured scheme (BFECC, then MacCormack, both only off periodic walls;
# the wrapping sampler on periodic walls; else semi-Lagrangian), with sc and drhs as the BFECC / MacCormack scratch
# (zeroed first, as the step does), and the advection rows split across `pool`.
fn _pv_fg_advect_by(dst, src, vx, vy, nx, ny, dt: f64, inv_dx: f64, config: *PvGridConfig, sc, drhs, pool) {
    var n = nx * ny;
    var periodic = 0;
    if (config.boundary == PV_BOUNDARY_CONDITION_PERIODIC) { periodic = 1; }
    if (config.use_bfecc != 0 && periodic == 0) {
        _pv_fg_fill(sc, n, 0);
        _pv_fg_fill(drhs, n, 0);
        _pv_fg_advect_bfecc(dst, src, vx, vy, nx, ny, dt, inv_dx, sc, drhs, pool);
    } elif (config.use_maccormack != 0 && periodic == 0) {
        _pv_fg_fill(sc, n, 0);
        _pv_fg_advect_maccormack(dst, src, vx, vy, nx, ny, dt, inv_dx, sc, pool);
    } elif (periodic == 1) {
        _pv_fg_advect_periodic(dst, src, vx, vy, nx, ny, dt, inv_dx, pool);
    } else {
        _pv_fg_advect(dst, src, vx, vy, nx, ny, dt, inv_dx, pool);
    }
    return 0;
}

impl PvFluidGrid {
    # Sets the thread count `step` uses: n ≥ 1 (a count below 1 is 1, serial). Any count gives the serial bits.
    # The grid's pool stops now, and the next step starts one of the new size (or runs serially where threads
    # can't start: src/par.cyr). Returns the count. Cyrius-only: Rust's `parallel` feature is compile-time (port
    # plan D6, ADR 0002 #4).
    fn set_threads(self, n): i64 {
        var t = n;
        if (t < 1) { t = 1; }
        _pv_pool_drop(self.pool);
        self.pool = 0;
        self.threads = t;
        return t;
    }

    # nx·ny. Mirrors `FluidGrid::cell_count`.
    #must_use
    fn cell_count(self): i64 {
        return self.nx * self.ny;
    }

    # The row-major index y·nx + x (Rust checks the range only in debug builds). Mirrors `FluidGrid::idx`.
    #must_use
    fn idx(self, x, y): i64 {
        return y * self.nx + x;
    }

    # (vx, vy) at cell (x, y); NaN for an index outside a field (Rust panics). Read as `var u, v = …` and bind each
    # to an f64 local. Mirrors `FluidGrid::velocity_at`.
    #must_use
    fn velocity_at(self, x, y) {
        var i = y * self.nx + x;
        var u: f64 = self.vx.get_f(i);
        var v: f64 = self.vy.get_f(i);
        return (u, v);
    }

    # √(vx² + vy²) at cell (x, y). Mirrors `FluidGrid::speed_at`.
    #must_use
    fn speed_at(self, x, y): f64 {
        var i = y * self.nx + x;
        var u: f64 = self.vx.get_f(i);
        var v: f64 = self.vy.get_f(i);
        var s: f64 = f64_sqrt((u * u) + (v * v));
        return s;
    }

    # The largest speed: √ of the max of vx² + vy² over the cells both fields have, folded with Rust's NaN-ignoring
    # max from +0. The max is written out (as a `_pv_max` call the loop took 1.44× as long, port-parity §10): q when
    # q ≥ m (equal operands give the second, as Rust's does) or when m is NaN; a NaN q is ignored. Mirrors
    # `FluidGrid::max_speed`.
    #must_use
    fn max_speed(self): f64 {
        var n = self.vx.len;
        if (self.vy.len < n) { n = self.vy.len; }
        var xd = self.vx.data;
        var yd = self.vy.data;
        var m: f64 = 0.0;
        for (var i = 0; i < n; i = i + 1) {
            var u: f64 = load64(xd + i * 8);
            var v: f64 = load64(yd + i * 8);
            var q: f64 = (u * u) + (v * v);
            if (q >= m || m != m) { m = q; }
        }
        var s: f64 = f64_sqrt(m);
        return s;
    }

    # The CFL-limited time step cfl·min(dx/v_max, dx²/(4ν)), each term only when v_max or ν is above 1e-20, capped at
    # f64::MAX (so f64::MAX·cfl, saturated, with neither). Mirrors `FluidGrid::cfl_dt`.
    #must_use
    fn cfl_dt(self, viscosity: f64, cfl_factor: f64): f64 {
        var big: f64 = PV_F64_MAX;
        var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
        var dt: f64 = big;
        var max_v: f64 = self.max_speed();
        if (max_v > tiny) {
            var a: f64 = self.dx / max_v;
            dt = _pv_min(dt, a);
        }
        if (viscosity > tiny) {
            var b: f64 = (self.dx * self.dx) / (4.0 * viscosity);
            dt = _pv_min(dt, b);
        }
        var c: f64 = cfl_factor * dt;
        var r: f64 = _pv_min(c, big);
        return r;
    }

    # Σ ((0.5·ρ)·(vx² + vy²))·dx² over the cells all three fields have, folded from −0. Mirrors
    # `FluidGrid::total_kinetic_energy`.
    #must_use
    fn total_kinetic_energy(self): f64 {
        var dx2: f64 = self.dx * self.dx;
        var n = self.vx.len;
        if (self.vy.len < n) { n = self.vy.len; }
        if (self.density.len < n) { n = self.density.len; }
        var xd = self.vx.data;
        var yd = self.vy.data;
        var rd = self.density.data;
        var s: f64 = 0x8000000000000000;
        for (var i = 0; i < n; i = i + 1) {
            var u: f64 = load64(xd + i * 8);
            var v: f64 = load64(yd + i * 8);
            var rho: f64 = load64(rd + i * 8);
            var e: f64 = ((0.5 * rho) * ((u * u) + (v * v))) * dx2;
            s = s + e;
        }
        return s;
    }

    # One Navier–Stokes step by `config`: advect the velocity, diffuse it (with the Smagorinsky viscosity when
    # smagorinsky_cs > 0), add buoyancy and vorticity confinement, project it (CG, else multigrid, else Gauss–Seidel
    # on periodic walls, else DST), then advect the density; the ghosts after each stage. Ok(0), or the first failure
    # in Rust's order:
    # - PV_ERR_INVALID_TIMESTEP (dt not finite and > 0), PV_ERR_INVALID_VISCOSITY (not finite and ≥ 0),
    #   PV_ERR_INVALID_PARAMETER (smagorinsky_cs or vorticity_confinement not finite and ≥ 0, buoyancy_alpha or
    #   ambient_density not finite, a zero iteration count), then, Cyrius-only, PV_ERR_INVALID_PARAMETER for a
    #   boundary value outside PvBoundaryCondition (ADR 0002 #12);
    # - PV_ERR_INVALID_GRID_RESOLUTION when nx or ny is below 4, nx·ny overflows or a field isn't nx·ny long (the
    #   public fields may be resized), PV_ERR_INVALID_PARAMETER for a cell size not finite and > 0;
    # - PV_ERR_DIVERGED for a NaN velocity after advection or a non-finite one after projection (the state then
    #   holds that stage's values, as Rust's does);
    # - PV_ERR_OUT_OF_MEMORY when a scratch buffer can't grow (Rust aborts).
    # Mirrors `FluidGrid::step`.
    #must_use
    fn step(self, config: *PvGridConfig): Result {
        var trace = _pv_span(_PV_LOG_GRID, "grid::step", "nx", self.nx, "ny", self.ny, 0, 0);
        var dt: f64 = config.dt;
        if (_pv_is_finite(dt) == 0 || dt <= 0.0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_TIMESTEP); }
        var visc: f64 = config.viscosity;
        if (visc < 0.0 || _pv_is_finite(visc) == 0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_VISCOSITY); }
        var cs: f64 = config.smagorinsky_cs;
        if (_pv_is_finite(cs) == 0 || cs < 0.0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_PARAMETER); }
        var eps: f64 = config.vorticity_confinement;
        if (_pv_is_finite(eps) == 0 || eps < 0.0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_PARAMETER); }
        var alpha: f64 = config.buoyancy_alpha;
        var ambient: f64 = config.ambient_density;
        if (_pv_is_finite(alpha) == 0 || _pv_is_finite(ambient) == 0) {
            _pv_span_end(trace);
            return Err(PV_ERR_INVALID_PARAMETER);
        }
        if (config.pressure_iterations == 0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_PARAMETER); }
        if (config.diffusion_iterations == 0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_PARAMETER); }
        var bc = config.boundary;
        if (bc < 0 || bc > PV_BOUNDARY_CONDITION_PERIODIC) {
            _pv_span_end(trace);
            return Err(PV_ERR_INVALID_PARAMETER);
        }
        var nx = self.nx;
        var ny = self.ny;
        if (nx < _PV_GRID_MIN_SIZE || ny < _PV_GRID_MIN_SIZE) {
            _pv_span_end(trace);
            return Err(PV_ERR_INVALID_GRID_RESOLUTION);
        }
        if (nx > 0x7FFFFFFFFFFFFFFF / ny) { _pv_span_end(trace); return Err(PV_ERR_INVALID_GRID_RESOLUTION); }
        var n = nx * ny;
        if (self.vx.len != n || self.vy.len != n || self.pressure.len != n || self.density.len != n) {
            _pv_span_end(trace); return Err(PV_ERR_INVALID_GRID_RESOLUTION);
        }
        var dx: f64 = self.dx;
        if (_pv_is_finite(dx) == 0 || dx <= 0.0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_PARAMETER); }
        var inv_dx: f64 = 1.0 / dx;
        var inv_2dx: f64 = 0.5 * inv_dx;
        var ok = self.scratch_a.resize(n, 0);
        ok = ok & self.scratch_b.resize(n, 0);
        ok = ok & self.scratch_c.resize(n, 0);
        ok = ok & self.diffuse_rhs.resize(n, 0);
        if (ok == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
        var sa = self.scratch_a.data;
        var sb = self.scratch_b.data;
        var sc = self.scratch_c.data;
        var drhs = self.diffuse_rhs.data;
        _pv_fg_fill(sa, n, 0);
        _pv_fg_fill(sb, n, 0);
        var vx = self.vx.data;
        var vy = self.vy.data;
        var rho = self.density.data;
        # The pool behind `threads`, started by the first step after `set_threads` (one that can't be started leaves
        # the grid serial, which gives the same bits).
        if (self.threads > 1 && self.pool == 0) {
            self.pool = _pv_pool_new(self.threads);
            if (self.pool == 0) { self.threads = 1; }
        }
        var pool = self.pool;

        # 1. Advect the velocity (both components from the same old field), then the ghosts.
        _pv_fg_advect_by(sa, vx, vx, vy, nx, ny, dt, inv_dx, config, sc, drhs, pool);
        _pv_fg_advect_by(sb, vy, vx, vy, nx, ny, dt, inv_dx, config, sc, drhs, pool);
        _pv_fg_copy(vx, sa, n);
        _pv_fg_copy(vy, sb, n);
        _pv_fg_enforce(vx, vy, nx, ny, bc);
        if (_pv_fg_any_bad(vx, n, 0) == 1 || _pv_fg_any_bad(vy, n, 0) == 1) {
            _pv_span_end(trace);
            return Err(PV_ERR_DIVERGED);
        }

        # 2. Diffuse the velocity, with the grid-averaged Smagorinsky viscosity ν_t = (Cs·dx)²·|S|.
        var eff: f64 = visc;
        if (cs > 0.0) {
            var cs_dx: f64 = cs * dx;
            var cs_dx2: f64 = cs_dx * cs_dx;
            var sum_nu_t: f64 = 0.0;
            var count: f64 = 0.0;
            for (var y = 1; y < ny - 1; y = y + 1) {
                for (var x = 1; x < nx - 1; x = x + 1) {
                    var i = y * nx + x;
                    var ur: f64 = load64(vx + (i + 1) * 8);
                    var ul: f64 = load64(vx + (i - 1) * 8);
                    var uu: f64 = load64(vx + (i + nx) * 8);
                    var ud: f64 = load64(vx + (i - nx) * 8);
                    var vr: f64 = load64(vy + (i + 1) * 8);
                    var vl: f64 = load64(vy + (i - 1) * 8);
                    var vu: f64 = load64(vy + (i + nx) * 8);
                    var vd: f64 = load64(vy + (i - nx) * 8);
                    var dudx: f64 = (ur - ul) * inv_2dx;
                    var dudy: f64 = (uu - ud) * inv_2dx;
                    var dvdx: f64 = (vr - vl) * inv_2dx;
                    var dvdy: f64 = (vu - vd) * inv_2dx;
                    var s12: f64 = 0.5 * (dudy + dvdx);
                    var inner: f64 = ((dudx * dudx) + (dvdy * dvdy)) + ((2.0 * s12) * s12);
                    var s_mag: f64 = f64_sqrt(2.0 * inner);
                    sum_nu_t = sum_nu_t + (cs_dx2 * s_mag);
                    count = count + 1.0;
                }
            }
            var mean: f64 = 0.0;
            if (count > 0.0) { mean = sum_nu_t / count; }
            eff = visc + mean;
        }
        if (eff > 0.0) {
            var dr: *PvColumn = _pv_fg_col(self, 7);
            if (_pv_fg_diffuse_buf(vx, nx, ny, eff, dt, dx, config.diffusion_iterations, dr) == 0) {
                _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY);
            }
            if (_pv_fg_diffuse_buf(vy, nx, ny, eff, dt, dx, config.diffusion_iterations, dr) == 0) {
                _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY);
            }
            _pv_fg_enforce(vx, vy, nx, ny, bc);
        }

        # 3. Forces: buoyancy on every cell, then vorticity confinement.
        if (alpha != 0.0) {
            for (var b = 0; b < n; b = b + 1) {
                var r: f64 = load64(rho + b * 8);
                var v: f64 = load64(vy + b * 8);
                var vn: f64 = v + ((alpha * (r - ambient)) * dt);
                store64(vy + b * 8, _pv_bits(vn));
            }
        }
        if (eps > 0.0) {
            _pv_fg_fill(sa, n, 0);
            _pv_fg_vorticity(vx, vy, nx, ny, dx, dt, eps, sa);
        }
        _pv_fg_enforce(vx, vy, nx, ny, bc);

        # 4. Pressure projection: the right-hand side −dx²·∇·u, a solve, u −= ∇p.
        _pv_fg_fill(sa, n, 0);
        var half_dx: f64 = 0.5 * dx;
        _pv_fg_divergence(sa, vx, vy, nx, ny, half_dx);
        var pd = self.pressure.data;
        if (config.use_cg != 0) {
            var tc, vc = _pv_fg_pressure_cg(pd, sa, nx, ny, config.pressure_iterations, _pv_fg_col(self, 9),
              _pv_fg_col(self, 10), _pv_fg_col(self, 11));
            if (is_err_result(tc) == 1) { _pv_span_end(trace); return Err(vc); }
        } elif (config.use_multigrid != 0) {
            var cycles = (config.pressure_iterations + 9) / 10;
            var tm, vm = _pv_fg_pressure_mg(pd, sa, nx, ny, 4, cycles, _pv_fg_col(self, 8));
            if (is_err_result(tm) == 1) { _pv_span_end(trace); return Err(vm); }
        } elif (bc == PV_BOUNDARY_CONDITION_PERIODIC) {
            _pv_fg_pressure_gs(pd, sa, nx, ny, config.pressure_iterations);
        } else {
            var td, vd2 = _pv_fg_pressure_dst(pd, n, sa, nx, ny, _pv_fg_col(self, 9), _pv_fg_col(self, 10),
              _pv_fg_col(self, 11), _pv_fg_col(self, 12), _pv_fg_col(self, 13));
            if (is_err_result(td) == 1) { _pv_span_end(trace); return Err(vd2); }
        }
        _pv_fg_project(vx, vy, pd, nx, ny, inv_2dx, pool);
        _pv_fg_enforce(vx, vy, nx, ny, bc);
        if (_pv_fg_any_bad(vx, n, 1) == 1 || _pv_fg_any_bad(vy, n, 1) == 1) {
            _pv_span_end(trace);
            return Err(PV_ERR_DIVERGED);
        }

        # 5. Advect the density, then its zero-gradient ghosts (except on periodic walls).
        _pv_fg_advect_by(sa, rho, vx, vy, nx, ny, dt, inv_dx, config, sc, drhs, pool);
        _pv_fg_copy(rho, sa, n);
        if (bc != PV_BOUNDARY_CONDITION_PERIODIC) { _pv_fg_enforce_scalar(rho, nx, ny); }
        _pv_span_end(trace); return Ok(0);
    }
}

# ── Ghost fluid ─────────────────────────────────────────────────────────────────────

# The ghost-fluid pressure correction at a level-set interface (plen words of pressure at p, llen of the signed
# distance at ls, negative inside the fluid): at each interior cell where φ changes sign against a 4-neighbour,
# with g = ((φ_r − φ_l)·0.5·(1/dx), (φ_t − φ_b)·0.5·(1/dx)), |g| = max(√(g_x² + g_y²), 1e-20) and
# κ = −(((φ_r − 2φ) + φ_l) + ((φ_t − 2φ) + φ_b))·(1/dx)² / |g| (each Laplacian term scaled before the sum), the
# pressure loses ((σ·κ)·φ)/|g| where φ > 0. 1, or 0 with nothing changed when nx or ny is below 3, nx·ny overflows
# or isn't both lengths, or dx isn't finite and > 0 (Rust warns and returns). Mirrors `apply_ghost_fluid`.
fn apply_ghost_fluid(p, plen, ls, llen, nx, ny, dx: f64, surface_tension: f64): i64 {
    var trace = _pv_span(_PV_LOG_GRID, "grid::ghost_fluid", "nx", nx, "ny", ny, 0, 0);
    var valid = 1;
    if ((nx >= 0 && nx < 3) || (ny >= 0 && ny < 3) || _pv_fg_mul_class(nx, ny) != 0) { valid = 0; }
    var n = nx * ny;
    if (valid == 1 && (plen != n || llen != n)) { valid = 0; }
    if (_pv_is_finite(dx) == 0 || dx <= 0.0) { valid = 0; }
    if (valid == 0) {
        _pv_warn(_PV_LOG_GRID, "apply_ghost_fluid: invalid sizes or dx ignored", "nx", nx, "ny", ny, 0, 0);
        _pv_span_end(trace); return 0;
    }
    var inv_dx: f64 = 1.0 / dx;
    var inv_dx2: f64 = inv_dx * inv_dx;
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    for (var y = 1; y < ny - 1; y = y + 1) {
        for (var x = 1; x < nx - 1; x = x + 1) {
            var i = y * nx + x;
            var q = ls + i * 8;
            var phi: f64 = load64(q);
            var phi_r: f64 = load64(q + 8);
            var phi_l: f64 = load64(q - 8);
            var phi_t: f64 = load64(q + nx * 8);
            var phi_b: f64 = load64(q - nx * 8);
            var cr: f64 = phi * phi_r;
            var cl: f64 = phi * phi_l;
            var ct: f64 = phi * phi_t;
            var cb: f64 = phi * phi_b;
            if (cr < 0.0 || cl < 0.0 || ct < 0.0 || cb < 0.0) {
                var gx: f64 = ((phi_r - phi_l) * 0.5) * inv_dx;
                var gy: f64 = ((phi_t - phi_b) * 0.5) * inv_dx;
                var gs: f64 = f64_sqrt((gx * gx) + (gy * gy));
                var g: f64 = _pv_max(gs, tiny);
                var tp: f64 = 2.0 * phi;
                var lxx: f64 = ((phi_r - tp) + phi_l) * inv_dx2;
                var lyy: f64 = ((phi_t - tp) + phi_b) * inv_dx2;
                var lap: f64 = lxx + lyy;
                var nl: f64 = -lap;
                var kappa: f64 = nl / g;
                if (phi > 0.0) {
                    var at = p + i * 8;
                    var p0: f64 = load64(at);
                    var c: f64 = ((surface_tension * kappa) * phi) / g;
                    var p1: f64 = p0 - c;
                    store64(at, _pv_bits(p1));
                }
            }
        }
    }
    _pv_span_end(trace); return 1;
}

# --- mac_grid.cyr ---

# mac_grid.cyr — the staggered (MAC) grid of rust-old/src/grid.rs (`MacGrid`, M3 part c).
#
# vx lives on the x faces ((nx+1) × ny), vy on the y faces (nx × (ny+1)), pressure and density at the cell centres
# (nx × ny). A step closes the walls, adds buoyancy on the interior y faces, projects with Gauss–Seidel on the
# Neumann pressure system (mean pinned to 0), and advects the density semi-Lagrangian from the cell centres with
# `FluidGrid`'s sampler. Every formula is Rust's, in its operation order.
#
# The record mirrors the struct: nx, ny, dx, the four public columns, then the two private scratch columns the step
# reuses (ADR 0002 #13).

struct PvMacGrid {
    nx;
    ny;
    dx: f64;
    vx: PvColumn;
    vy: PvColumn;
    pressure: PvColumn;
    density: PvColumn;
    scratch_div: PvColumn;
    scratch_density: PvColumn;
}

# Column k of a MAC grid (0 vx, 1 vy, 2 pressure, 3 density, 4 scratch_div, 5 scratch_density), by its byte offset
# (tests/grid.tcyr pins the layout: nx, ny, dx, then the six columns, 168 bytes).
#must_use
fn _pv_mac_col(g, k): *PvColumn {
    return _pv_as_columns(_pv_addr(g) + 24 + k * 24);
}

# Empties every column of *g without releasing anything (for a record about to be filled).
fn _pv_mac_zero(g: *PvMacGrid) {
    for (var k = 0; k < 6; k = k + 1) {
        var c: *PvColumn = _pv_mac_col(g, k);
        c.data = 0;
        c.len = 0;
        c.cap = 0;
    }
    return 0;
}

# Releases every column's storage; the grid holds no storage after. Mirrors dropping the `MacGrid`.
fn PvMacGrid_drop(g: *PvMacGrid) {
    for (var k = 0; k < 6; k = k + 1) {
        var c: *PvColumn = _pv_mac_col(g, k);
        c.drop();
    }
    return 0;
}

# The three sizes of an nx × ny MAC grid (nx, ny ≥ 4 or words ≥ 2^63): (nx·ny, (nx+1)·ny, nx·(ny+1)), or (-1, -1, -1)
# when one overflows or reaches 2^63 (a size no allocation reaches).
fn _pv_mac_sizes(nx, ny) {
    if (nx < 0 || ny < 0) { return (0 - 1, 0 - 1, 0 - 1); }
    if (_pv_fg_mul_class(nx, ny) != 0) { return (0 - 1, 0 - 1, 0 - 1); }
    var n = nx * ny;
    if (n > 0x7FFFFFFFFFFFFFFF - ny || n > 0x7FFFFFFFFFFFFFFF - nx) { return (0 - 1, 0 - 1, 0 - 1); }
    return (n, n + ny, n + nx);
}

# A MAC grid of zeros into *out: Ok(0), or the first failure in Rust's order: PV_ERR_INVALID_GRID_RESOLUTION for nx
# or ny below 4, PV_ERR_INVALID_PARAMETER for a cell size not finite and > 0; PV_ERR_OUT_OF_MEMORY when a size
# overflows or the fields can't be allocated. Rust doesn't check the products: it panics under overflow checks (the
# oracle's build), wraps without them, and aborts on an allocation that large (ADR 0002 #13). On an error *out
# holds no storage. Mirrors `MacGrid::new`.
#must_use
fn PvMacGrid_new(nx, ny, dx: f64, out: *PvMacGrid): Result {
    _pv_mac_zero(out);
    if ((nx >= 0 && nx < 4) || (ny >= 0 && ny < 4)) { return Err(PV_ERR_INVALID_GRID_RESOLUTION); }
    if (dx <= 0.0 || _pv_is_finite(dx) == 0) { return Err(PV_ERR_INVALID_PARAMETER); }
    var cn, vxn, vyn = _pv_mac_sizes(nx, ny);
    if (cn < 0) { return Err(PV_ERR_OUT_OF_MEMORY); }
    var ok = 1;
    var c0: *PvColumn = _pv_mac_col(out, 0);
    ok = ok & c0.resize(vxn, 0);
    var c1: *PvColumn = _pv_mac_col(out, 1);
    ok = ok & c1.resize(vyn, 0);
    for (var k = 2; k < 6; k = k + 1) {
        var c: *PvColumn = _pv_mac_col(out, k);
        ok = ok & c.resize(cn, 0);
    }
    if (ok == 0) {
        PvMacGrid_drop(out);
        return Err(PV_ERR_OUT_OF_MEMORY);
    }
    out.nx = nx;
    out.ny = ny;
    out.dx = dx;
    return Ok(0);
}

# A deep copy of `src` into *out, scratch included: 1, or 0 when the memory isn't there (then *out holds no
# storage). Mirrors `MacGrid::clone`.
#must_use
fn PvMacGrid_clone(out: *PvMacGrid, src: *PvMacGrid): i64 {
    out.nx = src.nx;
    out.ny = src.ny;
    out.dx = src.dx;
    _pv_mac_zero(out);
    for (var k = 0; k < 6; k = k + 1) {
        var s: *PvColumn = _pv_mac_col(src, k);
        var d: *PvColumn = _pv_mac_col(out, k);
        if (d.resize(s.len, 0) == 0) {
            PvMacGrid_drop(out);
            return 0;
        }
        d.copy_from(s);
    }
    return 1;
}

impl PvMacGrid {
    # The cell-centre velocity (0.5·(vx_left + vx_right), 0.5·(vy_bottom + vy_top)) at cell (x, y); NaN for a face
    # outside a field (Rust panics). Read as `var u, v = …` and bind each to an f64 local. Mirrors
    # `MacGrid::velocity_at`.
    #must_use
    fn velocity_at(self, x, y) {
        var r = y * (self.nx + 1) + x;
        var a: f64 = self.vx.get_f(r);
        var b: f64 = self.vx.get_f(r + 1);
        var c: f64 = self.vy.get_f(y * self.nx + x);
        var d: f64 = self.vy.get_f((y + 1) * self.nx + x);
        var u: f64 = 0.5 * (a + b);
        var v: f64 = 0.5 * (c + d);
        return (u, v);
    }

    # The largest cell-centre speed: √ of the max of u² + v² over every cell, folded with Rust's NaN-ignoring max
    # from +0 (a face outside a field reads NaN, ignored, where Rust panics). Mirrors `MacGrid::max_speed`.
    #must_use
    fn max_speed(self): f64 {
        var m: f64 = 0.0;
        for (var y = 0; y < self.ny; y = y + 1) {
            for (var x = 0; x < self.nx; x = x + 1) {
                var u, v = self.velocity_at(x, y);
                var uf: f64 = u;
                var vf: f64 = v;
                var q: f64 = (uf * uf) + (vf * vf);
                if (q >= m || m != m) { m = q; }
            }
        }
        var s: f64 = f64_sqrt(m);
        return s;
    }

    # The divergence ((vx_right − vx_left) + (vy_top − vy_bottom))·(1/dx) at cell (x, y), exact on the staggered
    # layout; NaN for a face outside a field. Mirrors `MacGrid::divergence_at`.
    #must_use
    fn divergence_at(self, x, y): f64 {
        var inv_dx: f64 = 1.0 / self.dx;
        var r = y * (self.nx + 1) + x;
        var a: f64 = self.vx.get_f(r + 1);
        var b: f64 = self.vx.get_f(r);
        var c: f64 = self.vy.get_f((y + 1) * self.nx + x);
        var d: f64 = self.vy.get_f(y * self.nx + x);
        var s: f64 = (a - b) + (c - d);
        var w: f64 = s * inv_dx;
        return w;
    }

    # The CFL time step (cfl_factor·dx)/v_max, or f64::MAX when v_max < 1e-20 (no flow, no advective limit).
    # Mirrors `MacGrid::cfl_dt`.
    #must_use
    fn cfl_dt(self, cfl_factor: f64): f64 {
        var max_v: f64 = self.max_speed();
        var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
        if (max_v < tiny) {
            var big: f64 = PV_F64_MAX;
            return big;
        }
        var a: f64 = cfl_factor * self.dx;
        var r: f64 = a / max_v;
        return r;
    }

    # One step by `config` (only dt, pressure_iterations, buoyancy_alpha and ambient_density are read):
    # - the walls: the normal velocity on the domain's boundary faces set to 0;
    # - buoyancy: each interior y face gains (alpha·(ρ_face − ambient))·dt, ρ_face the mean of its two cells;
    # - the projection: rhs = −((vx_r − vx_l) + (vy_t − vy_b))·dx per cell, `pressure_iterations` Gauss–Seidel
    #   sweeps of p = (rhs + Σ neighbours)/count over the in-domain neighbours (Neumann walls), each sum from +0
    #   in the order left, right, below, above; the mean (summed from −0) subtracted; the interior faces then lose
    #   the pressure difference × 1/dx;
    # - the density advected from each cell centre back along (dt/dx)·(u, v), by `FluidGrid`'s bilinear sampler.
    # Ok(0), or the first failure in Rust's order: PV_ERR_INVALID_TIMESTEP (dt not finite and > 0),
    # PV_ERR_INVALID_PARAMETER (no pressure iterations; buoyancy_alpha or ambient_density not finite),
    # PV_ERR_INVALID_GRID_RESOLUTION (nx or ny below 4, a size overflowing, a field of the wrong length),
    # PV_ERR_INVALID_PARAMETER (a cell size not finite and > 0), PV_ERR_DIVERGED (a non-finite velocity or density
    # after the step, which the state then holds, as Rust's does), PV_ERR_OUT_OF_MEMORY (the scratch can't grow,
    # checked before anything changes; Rust aborts). Mirrors `MacGrid::step`.
    #must_use
    fn step(self, config: *PvGridConfig): Result {
        var trace = _pv_span(_PV_LOG_GRID, "mac::step", "nx", self.nx, "ny", self.ny, 0, 0);
        var dt: f64 = config.dt;
        if (_pv_is_finite(dt) == 0 || dt <= 0.0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_TIMESTEP); }
        if (config.pressure_iterations == 0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_PARAMETER); }
        var alpha: f64 = config.buoyancy_alpha;
        var amb: f64 = config.ambient_density;
        if (_pv_is_finite(alpha) == 0 || _pv_is_finite(amb) == 0) {
            _pv_span_end(trace);
            return Err(PV_ERR_INVALID_PARAMETER);
        }
        var nx = self.nx;
        var ny = self.ny;
        if ((nx >= 0 && nx < 4) || (ny >= 0 && ny < 4)) {
            _pv_span_end(trace);
            return Err(PV_ERR_INVALID_GRID_RESOLUTION);
        }
        var cn, vxn, vyn = _pv_mac_sizes(nx, ny);
        if (cn < 0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_GRID_RESOLUTION); }
        if (self.vx.len != vxn || self.vy.len != vyn || self.pressure.len != cn || self.density.len != cn) {
            _pv_span_end(trace); return Err(PV_ERR_INVALID_GRID_RESOLUTION);
        }
        var dx: f64 = self.dx;
        if (_pv_is_finite(dx) == 0 || dx <= 0.0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_PARAMETER); }
        var sdiv: *PvColumn = _pv_mac_col(self, 4);
        var sden: *PvColumn = _pv_mac_col(self, 5);
        if (sdiv.resize(cn, 0) == 0 || sden.resize(cn, 0) == 0) {
            _pv_span_end(trace);
            return Err(PV_ERR_OUT_OF_MEMORY);
        }
        var inv_dx: f64 = 1.0 / dx;
        var u = self.vx.data;
        var v = self.vy.data;
        var p = self.pressure.data;
        var rho = self.density.data;
        var nx1 = nx + 1;

        # 0. The walls.
        for (var y = 0; y < ny; y = y + 1) {
            store64(u + (y * nx1) * 8, 0);
            store64(u + (y * nx1 + nx) * 8, 0);
        }
        for (var x = 0; x < nx; x = x + 1) {
            store64(v + x * 8, 0);
            store64(v + (ny * nx + x) * 8, 0);
        }

        # 1. Buoyancy on the interior y faces.
        if (alpha != 0.0) {
            for (var by = 1; by < ny; by = by + 1) {
                for (var bx = 0; bx < nx; bx = bx + 1) {
                    var r0: f64 = load64(rho + ((by - 1) * nx + bx) * 8);
                    var r1: f64 = load64(rho + (by * nx + bx) * 8);
                    var rf: f64 = 0.5 * (r0 + r1);
                    var at = v + (by * nx + bx) * 8;
                    var w0: f64 = load64(at);
                    var w1: f64 = w0 + ((alpha * (rf - amb)) * dt);
                    store64(at, _pv_bits(w1));
                }
            }
        }

        # 2. The projection.
        var rhs = sdiv.data;
        for (var ry = 0; ry < ny; ry = ry + 1) {
            for (var rx = 0; rx < nx; rx = rx + 1) {
                var ul: f64 = load64(u + (ry * nx1 + rx) * 8);
                var ur: f64 = load64(u + (ry * nx1 + rx + 1) * 8);
                var vb: f64 = load64(v + (ry * nx + rx) * 8);
                var vt: f64 = load64(v + ((ry + 1) * nx + rx) * 8);
                var fl: f64 = (ur - ul) + (vt - vb);
                var nf: f64 = -fl;
                var rv: f64 = nf * dx;
                store64(rhs + (ry * nx + rx) * 8, _pv_bits(rv));
            }
        }
        for (var it = 0; it < config.pressure_iterations; it = it + 1) {
            for (var gy = 0; gy < ny; gy = gy + 1) {
                for (var gx = 0; gx < nx; gx = gx + 1) {
                    var i = gy * nx + gx;
                    var q = p + i * 8;
                    var sum: f64 = 0.0;
                    var count: f64 = 0.0;
                    if (gx > 0) {
                        var pl: f64 = load64(q - 8);
                        sum = sum + pl;
                        count = count + 1.0;
                    }
                    if (gx + 1 < nx) {
                        var pr: f64 = load64(q + 8);
                        sum = sum + pr;
                        count = count + 1.0;
                    }
                    if (gy > 0) {
                        var pb: f64 = load64(q - nx * 8);
                        sum = sum + pb;
                        count = count + 1.0;
                    }
                    if (gy + 1 < ny) {
                        var pt: f64 = load64(q + nx * 8);
                        sum = sum + pt;
                        count = count + 1.0;
                    }
                    var b: f64 = load64(rhs + i * 8);
                    var pn: f64 = (b + sum) / count;
                    store64(q, _pv_bits(pn));
                }
            }
        }
        var total: f64 = 0x8000000000000000;
        for (var j = 0; j < cn; j = j + 1) {
            var pj: f64 = load64(p + j * 8);
            total = total + pj;
        }
        var cnf: f64 = f64_from(cn);
        var mean: f64 = total / cnf;
        for (var j2 = 0; j2 < cn; j2 = j2 + 1) {
            var pk: f64 = load64(p + j2 * 8);
            var pm: f64 = pk - mean;
            store64(p + j2 * 8, _pv_bits(pm));
        }
        for (var fy = 0; fy < ny; fy = fy + 1) {
            for (var fx = 1; fx < nx; fx = fx + 1) {
                var at2 = u + (fy * nx1 + fx) * 8;
                var pa: f64 = load64(p + (fy * nx + fx) * 8);
                var pb2: f64 = load64(p + (fy * nx + fx - 1) * 8);
                var u0: f64 = load64(at2);
                var u1: f64 = u0 - ((pa - pb2) * inv_dx);
                store64(at2, _pv_bits(u1));
            }
        }
        for (var hy = 1; hy < ny; hy = hy + 1) {
            for (var hx = 0; hx < nx; hx = hx + 1) {
                var at3 = v + (hy * nx + hx) * 8;
                var pc: f64 = load64(p + (hy * nx + hx) * 8);
                var pd: f64 = load64(p + ((hy - 1) * nx + hx) * 8);
                var v0: f64 = load64(at3);
                var v1: f64 = v0 - ((pc - pd) * inv_dx);
                store64(at3, _pv_bits(v1));
            }
        }

        # 3. The density, advected from the cell centres.
        var adv = sden.data;
        var dt_inv_dx: f64 = dt * inv_dx;
        for (var ay = 0; ay < ny; ay = ay + 1) {
            var ayf: f64 = f64_from(ay);
            for (var ax = 0; ax < nx; ax = ax + 1) {
                var a0: f64 = load64(u + (ay * nx1 + ax) * 8);
                var a1: f64 = load64(u + (ay * nx1 + ax + 1) * 8);
                var c0: f64 = load64(v + (ay * nx + ax) * 8);
                var c1: f64 = load64(v + ((ay + 1) * nx + ax) * 8);
                var cu: f64 = 0.5 * (a0 + a1);
                var cv: f64 = 0.5 * (c0 + c1);
                var axf: f64 = f64_from(ax);
                var sx: f64 = axf - (dt_inv_dx * cu);
                var sy: f64 = ayf - (dt_inv_dx * cv);
                var s: f64 = _pv_fg_sample(rho, nx, ny, sx, sy);
                store64(adv + (ay * nx + ax) * 8, _pv_bits(s));
            }
        }
        _pv_col_swap(_pv_mac_col(self, 3), sden);
        if (_pv_fg_any_bad(u, vxn, 1) == 1 || _pv_fg_any_bad(v, vyn, 1) == 1
          || _pv_fg_any_bad(self.density.data, cn, 1) == 1) {
            _pv_span_end(trace); return Err(PV_ERR_DIVERGED);
        }
        _pv_span_end(trace); return Ok(0);
    }
}

# --- k_epsilon.cyr ---

# k_epsilon.cyr — the k-ε turbulence model of rust-old/src/grid.rs (`KEpsilon`, M3 part c).
#
# A two-equation RANS state per cell: k, the turbulent kinetic energy, and ε, its dissipation rate, with the
# turbulent viscosity ν_t = C_μ·k²/ε. `step` integrates the production and dissipation source terms only, as
# 1.3.0 does (no advection or diffusion of k and ε). Every formula is Rust's, in its operation order.
#
# The record mirrors the struct: the public k and ε columns and constants, then the two private scratch columns
# `step` swaps through. `PvKEpsilon_new` returns 1 or 0 where Rust's `new` returns `Self` (ADR 0002 #8, #9), and
# `step` returns 1, or 0 where Rust warns and returns (ADR 0002 #13).

struct PvKEpsilon {
    k: PvColumn;
    epsilon: PvColumn;
    c_mu: f64;
    c_eps1: f64;
    c_eps2: f64;
    scratch_k: PvColumn;
    scratch_eps: PvColumn;
}

# Column j of a model (0 k, 1 epsilon, 2 scratch_k, 3 scratch_eps), by its byte offset: k and ε at 0 and 24, the
# three constants at 48 … 64, the scratch at 72 and 96 (tests/grid.tcyr pins the layout, 120 bytes).
#must_use
fn _pv_ke_col(m, j): *PvColumn {
    if (j < 2) { return _pv_as_columns(_pv_addr(m) + j * 24); }
    return _pv_as_columns(_pv_addr(m) + 72 + (j - 2) * 24);
}

# Empties every column of *m without releasing anything (for a record about to be filled).
fn _pv_ke_zero(m: *PvKEpsilon) {
    for (var j = 0; j < 4; j = j + 1) {
        var c: *PvColumn = _pv_ke_col(m, j);
        c.data = 0;
        c.len = 0;
        c.cap = 0;
    }
    return 0;
}

# Releases every column's storage; the model holds no storage after. Mirrors dropping the `KEpsilon`.
fn PvKEpsilon_drop(m: *PvKEpsilon) {
    for (var j = 0; j < 4; j = j + 1) {
        var c: *PvColumn = _pv_ke_col(m, j);
        c.drop();
    }
    return 0;
}

# The model for an nx × ny grid into *out: k = 1e-4 and ε = 1e-5 in every cell, C_μ = 0.09, C_ε1 = 1.44,
# C_ε2 = 1.92, the scratch nx·ny zeros. 1, or 0 when nx·ny overflows or is a size no allocation reaches, or the
# memory isn't there; *out then holds no storage. Rust doesn't check the product: it panics under overflow checks
# (the oracle's build), wraps without them, and aborts on an allocation that large (ADR 0002 #13). Mirrors
# `KEpsilon::new`.
#must_use
fn PvKEpsilon_new(nx, ny, out: *PvKEpsilon): i64 {
    _pv_ke_zero(out);
    var n = 0;
    if (nx != 0 && ny != 0) {
        if (nx < 0 || ny < 0) { return 0; }
        if (nx > 0x7FFFFFFFFFFFFFFF / ny) { return 0; }
        n = nx * ny;
    }
    var ok = 1;
    var k: *PvColumn = _pv_ke_col(out, 0);
    ok = ok & k.resize(n, 0x3F1A36E2EB1C432D);              # 1e-4
    var e: *PvColumn = _pv_ke_col(out, 1);
    ok = ok & e.resize(n, 0x3EE4F8B588E368F1);              # 1e-5
    for (var j = 2; j < 4; j = j + 1) {
        var s: *PvColumn = _pv_ke_col(out, j);
        ok = ok & s.resize(n, 0);
    }
    if (ok == 0) {
        PvKEpsilon_drop(out);
        return 0;
    }
    var c_mu: f64 = 0x3FB70A3D70A3D70A;    # 0.09
    var c1: f64 = 0x3FF70A3D70A3D70A;      # 1.44
    var c2: f64 = 0x3FFEB851EB851EB8;      # 1.92
    out.c_mu = c_mu;
    out.c_eps1 = c1;
    out.c_eps2 = c2;
    return 1;
}

# A deep copy of `src` into *out, scratch included: 1, or 0 when the memory isn't there (then *out holds no
# storage). Mirrors `KEpsilon::clone`.
#must_use
fn PvKEpsilon_clone(out: *PvKEpsilon, src: *PvKEpsilon): i64 {
    _pv_ke_zero(out);
    out.c_mu = src.c_mu;
    out.c_eps1 = src.c_eps1;
    out.c_eps2 = src.c_eps2;
    for (var j = 0; j < 4; j = j + 1) {
        var s: *PvColumn = _pv_ke_col(src, j);
        var d: *PvColumn = _pv_ke_col(out, j);
        if (d.resize(s.len, 0) == 0) {
            PvKEpsilon_drop(out);
            return 0;
        }
        d.copy_from(s);
    }
    return 1;
}

impl PvKEpsilon {
    # ν_t = ((C_μ·k)·k)/max(ε, 1e-20) at cell i; NaN for an index outside k or ε (Rust panics). Mirrors
    # `KEpsilon::turbulent_viscosity`.
    #must_use
    fn turbulent_viscosity(self, i): f64 {
        var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
        var k: f64 = self.k.get_f(i);
        var e: f64 = self.epsilon.get_f(i);
        var a: f64 = (self.c_mu * k) * k;
        var d: f64 = _pv_max(e, tiny);
        var r: f64 = a / d;
        return r;
    }

    # One step of the source terms from the velocity field (vx_len and vy_len words at vx and vy, an nx × ny
    # grid, cell size dx, time step dt). On the interior, from the old k and ε:
    #   ν_t = ((C_μ·k)·k)/max(ε, 1e-20), |S|² = 2·((u_x² + v_y²) + 0.5·(u_y + v_x)²) by central differences,
    #   P = ν_t·|S|², k ← max(k + (P − ε)·dt, 1e-10),
    #   ε ← max(ε + (((C_ε1·P) − (C_ε2·ε))·(ε/max(k, 1e-10)))·dt, 1e-10);
    # the ring keeps its values. The scratch columns end holding the old k and ε (Rust swaps the Vecs). 1, or 0
    # with nothing changed when nx or ny is below 3, nx·ny overflows, a length isn't nx·ny, dx or dt isn't finite
    # and > 0 (Rust warns and returns), or the scratch can't grow. Mirrors `KEpsilon::step`.
    fn step(self, vx, vx_len, vy, vy_len, nx, ny, dx: f64, dt: f64): i64 {
        var trace = _pv_span(_PV_LOG_GRID, "grid::kepsilon", "nx", nx, "ny", ny, 0, 0);
        var valid = 1;
        if ((nx >= 0 && nx < 3) || (ny >= 0 && ny < 3) || _pv_fg_mul_class(nx, ny) != 0) { valid = 0; }
        var n = nx * ny;
        if (valid == 1 && (vx_len != n || vy_len != n || self.k.len != n || self.epsilon.len != n)) { valid = 0; }
        if (_pv_is_finite(dx) == 0 || dx <= 0.0 || _pv_is_finite(dt) == 0 || dt <= 0.0) { valid = 0; }
        if (valid == 0) {
            _pv_warn(_PV_LOG_GRID, "KEpsilon::step: invalid sizes or parameters ignored", "nx", nx, "ny", ny, 0, 0);
            _pv_span_end(trace); return 0;
        }
        var inv_2dx: f64 = 0.5 / dx;
        var sk: *PvColumn = _pv_ke_col(self, 2);
        var se: *PvColumn = _pv_ke_col(self, 3);
        if (sk.resize(n, 0) == 0 || se.resize(n, 0) == 0) { _pv_span_end(trace); return 0; }
        var kc: *PvColumn = _pv_ke_col(self, 0);
        var ec: *PvColumn = _pv_ke_col(self, 1);
        _pv_col_swap(kc, sk);
        _pv_col_swap(ec, se);
        kc.copy_from(sk);
        ec.copy_from(se);
        var ko = sk.data;
        var eo = se.data;
        var kn = kc.data;
        var en = ec.data;
        var c_mu: f64 = self.c_mu;
        var c1: f64 = self.c_eps1;
        var c2: f64 = self.c_eps2;
        # The three maxes are written out. Each is `x.max(floor)` with a positive constant floor: x when x > floor,
        # else the floor (a NaN x included), the bits of Rust's max. As `_pv_max` calls they made the step 1.21×
        # slower (pinned A/B, port-parity §12).
        var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
        var lo: f64 = 0x3DDB7CDFD9D7BDBB;     # 1e-10
        for (var y = 1; y < ny - 1; y = y + 1) {
            for (var x = 1; x < nx - 1; x = x + 1) {
                var i = y * nx + x;
                var k0: f64 = load64(ko + i * 8);
                var e0: f64 = load64(eo + i * 8);
                var ed: f64 = tiny;
                if (e0 > tiny) { ed = e0; }
                var nu_t: f64 = ((c_mu * k0) * k0) / ed;
                var pu = vx + i * 8;
                var pv = vy + i * 8;
                var ur: f64 = load64(pu + 8);
                var ul: f64 = load64(pu - 8);
                var uu: f64 = load64(pu + nx * 8);
                var ud: f64 = load64(pu - nx * 8);
                var vr: f64 = load64(pv + 8);
                var vl: f64 = load64(pv - 8);
                var vu: f64 = load64(pv + nx * 8);
                var vd: f64 = load64(pv - nx * 8);
                var dudx: f64 = (ur - ul) * inv_2dx;
                var dudy: f64 = (uu - ud) * inv_2dx;
                var dvdx: f64 = (vr - vl) * inv_2dx;
                var dvdy: f64 = (vu - vd) * inv_2dx;
                var sh: f64 = dudy + dvdx;
                var s_mag_sq: f64 = 2.0 * (((dudx * dudx) + (dvdy * dvdy)) + (0.5 * (sh * sh)));
                var prod: f64 = nu_t * s_mag_sq;
                var k1: f64 = k0 + ((prod - e0) * dt);
                var k2: f64 = lo;
                if (k1 > lo) { k2 = k1; }
                store64(kn + i * 8, _pv_bits(k2));
                var kd: f64 = lo;
                if (k0 > lo) { kd = k0; }
                var eok: f64 = e0 / kd;
                var src: f64 = (c1 * prod) - (c2 * e0);
                var e1: f64 = e0 + ((src * eok) * dt);
                var e2: f64 = lo;
                if (e1 > lo) { e2 = e1; }
                store64(en + i * 8, _pv_bits(e2));
            }
        }
        _pv_span_end(trace); return 1;
    }
}

# --- vof.cyr ---

# vof.cyr — the volume-of-fluid field of rust-old/src/vof.rs (`VofField`, M3 part d).
#
# A volume fraction α ∈ [0, 1] per cell of an nx × ny grid: 0 empty, 1 full. `advect` moves it with donor-cell face
# fluxes, closed walls on the boundary ring, and sub-steps that keep the Courant number at or below 0.5. Every
# formula is Rust's, in its operation order.
#
# The record mirrors the struct: nx, ny, dx, the public α column, then the private scratch column the sub-steps read
# the old α from (ADR 0002 #14).

struct PvVofField {
    nx;
    ny;
    dx: f64;
    alpha: PvColumn;
    scratch: PvColumn;
}

# Column k of a VOF field (0 alpha, 1 scratch), by its byte offset (tests/vof.tcyr pins the layout, 72 bytes).
#must_use
fn _pv_vof_col(v, k): *PvColumn {
    return _pv_as_columns(_pv_addr(v) + 24 + k * 24);
}

# Empties both columns of *v without releasing anything (for a record about to be filled).
fn _pv_vof_zero(v: *PvVofField) {
    for (var k = 0; k < 2; k = k + 1) {
        var c: *PvColumn = _pv_vof_col(v, k);
        c.data = 0;
        c.len = 0;
        c.cap = 0;
    }
    return 0;
}

# Releases both columns' storage; the field holds no storage after. Mirrors dropping the `VofField`.
fn PvVofField_drop(v: *PvVofField) {
    for (var k = 0; k < 2; k = k + 1) {
        var c: *PvColumn = _pv_vof_col(v, k);
        c.drop();
    }
    return 0;
}

# An empty field (α = 0) into *out: Ok(0), or the first failure in Rust's order: PV_ERR_INVALID_GRID_RESOLUTION for
# nx or ny below 4, PV_ERR_INVALID_PARAMETER for a cell size not finite and > 0; PV_ERR_OUT_OF_MEMORY when nx·ny
# overflows or the columns can't be allocated (Rust doesn't check the product: it panics under overflow checks and
# aborts on an allocation that large; ADR 0002 #14). On an error *out holds no storage. Mirrors `VofField::new`.
#must_use
fn PvVofField_new(nx, ny, dx: f64, out: *PvVofField): Result {
    _pv_vof_zero(out);
    if ((nx >= 0 && nx < 4) || (ny >= 0 && ny < 4)) { return Err(PV_ERR_INVALID_GRID_RESOLUTION); }
    if (dx <= 0.0 || _pv_is_finite(dx) == 0) { return Err(PV_ERR_INVALID_PARAMETER); }
    if (_pv_fg_mul_class(nx, ny) != 0) { return Err(PV_ERR_OUT_OF_MEMORY); }
    var n = nx * ny;
    var a: *PvColumn = _pv_vof_col(out, 0);
    var s: *PvColumn = _pv_vof_col(out, 1);
    if (a.resize(n, 0) == 0 || s.resize(n, 0) == 0) {
        PvVofField_drop(out);
        return Err(PV_ERR_OUT_OF_MEMORY);
    }
    out.nx = nx;
    out.ny = ny;
    out.dx = dx;
    return Ok(0);
}

# A deep copy of `src` into *out, scratch included: 1, or 0 when the memory isn't there (then *out holds no
# storage). Mirrors `VofField::clone`.
#must_use
fn PvVofField_clone(out: *PvVofField, src: *PvVofField): i64 {
    out.nx = src.nx;
    out.ny = src.ny;
    out.dx = src.dx;
    _pv_vof_zero(out);
    for (var k = 0; k < 2; k = k + 1) {
        var s: *PvColumn = _pv_vof_col(src, k);
        var d: *PvColumn = _pv_vof_col(out, k);
        if (d.resize(s.len, 0) == 0) {
            PvVofField_drop(out);
            return 0;
        }
        d.copy_from(s);
    }
    return 1;
}

# Sets every cell (x, y) whose centre (x·dx, y·dx) passes `inside` to the word w, over the nx × ny cells a column
# holds (a cell outside it is skipped, where Rust panics). kind 0: the rectangle a ≤ px ≤ c and b ≤ py ≤ d, kind 1:
# the disc (px − a)² + (py − b)² < c². Shared by `VofField::fill_*` and `PhaseField::set_*`.
fn _pv_fill_shape(col: *PvColumn, nx, ny, dx: f64, kind, a: f64, b: f64, c: f64, d: f64, w) {
    var r2: f64 = c * c;
    for (var y = 0; y < ny; y = y + 1) {
        var yf: f64 = f64_from(y);
        var py: f64 = yf * dx;
        for (var x = 0; x < nx; x = x + 1) {
            var xf: f64 = f64_from(x);
            var px: f64 = xf * dx;
            var hit = 0;
            if (kind == 0) {
                if (px >= a && px <= c && py >= b && py <= d) { hit = 1; }
            } else {
                var ddx: f64 = px - a;
                var ddy: f64 = py - b;
                var q: f64 = (ddx * ddx) + (ddy * ddy);
                if (q < r2) { hit = 1; }
            }
            if (hit == 1) { col.set(y * nx + x, w); }
        }
    }
    return 0;
}

# One donor-cell sub-step of length dt (the scratch already nx·ny words): the old α copied to the scratch, then
# each interior cell's α ← clamp(α − (((F_r − F_l) + F_t) − F_b), 0, 1). A face flux is ((u·α_donor)·dt)·(1/dx)
# with u = 0.5·(v_0 + v_1), the face's two cell velocities, and α_donor the upstream cell's old α (the lower cell's
# when u > 0, else the upper's); a face on the boundary ring is a wall, flux 0. Mirrors the private
# `advect_substep`.
#
# The fluxes and the clamp are written out, and a face shared along a row is computed once: Rust evaluates each
# interior x face twice (as F_r of the cell on its left and F_l of the cell on its right) from the same four
# values, so the left cell's F_r is the right cell's F_l, bit for bit. Together they made the advection 1.17–1.18×
# faster (pinned A/B, port-parity §13).
fn _pv_vof_substep(fd: *PvVofField, vx, vy, dt: f64) {
    var nx = fd.nx;
    var ny = fd.ny;
    var inv_dx: f64 = 1.0 / fd.dx;
    var a = fd.alpha.data;
    var o = fd.scratch.data;
    _pv_fg_copy(o, a, nx * ny);
    var zero: f64 = 0.0;
    var row = nx * 8;
    for (var y = 1; y < ny - 1; y = y + 1) {
        var carry: f64 = zero;   # F_l of the row's first interior cell: its left face is a wall
        for (var x = 1; x < nx - 1; x = x + 1) {
            var i = y * nx + x;
            var pu = vx + i * 8;
            var pv = vy + i * 8;
            var po = o + i * 8;
            var old: f64 = load64(po);
            var fl: f64 = carry;
            var fr: f64 = zero;
            if (x + 1 != nx - 1) {
                var u0: f64 = load64(pu);
                var u1: f64 = load64(pu + 8);
                var u: f64 = 0.5 * (u0 + u1);
                var dr: f64 = load64(po + 8);
                if (u > 0.0) { dr = old; }
                fr = ((u * dr) * dt) * inv_dx;
            }
            carry = fr;
            var ft: f64 = zero;
            if (y + 1 != ny - 1) {
                var w0: f64 = load64(pv);
                var w1: f64 = load64(pv + row);
                var w: f64 = 0.5 * (w0 + w1);
                var dt2: f64 = load64(po + row);
                if (w > 0.0) { dt2 = old; }
                ft = ((w * dt2) * dt) * inv_dx;
            }
            var fb: f64 = zero;
            if (y != 1) {
                var b0: f64 = load64(pv - row);
                var b1: f64 = load64(pv);
                var bw: f64 = 0.5 * (b0 + b1);
                var db: f64 = old;
                if (bw > 0.0) { db = load64(po - row); }
                fb = ((bw * db) * dt) * inv_dx;
            }
            var net: f64 = ((fr - fl) + ft) - fb;
            var c: f64 = old - net;
            if (c < 0.0) { c = 0.0; }
            if (c > 1.0) { c = 1.0; }
            store64(a + i * 8, _pv_bits(c));
        }
    }
    return 0;
}

impl PvVofField {
    # 1 when the cell is partially filled: threshold < α < 1 − threshold; 0 otherwise (and for a cell outside α,
    # where Rust panics). Mirrors `VofField::is_surface_with_threshold`.
    #must_use
    fn is_surface_with_threshold(self, x, y, threshold: f64): i64 {
        var a: f64 = self.alpha.get_f(y * self.nx + x);
        var hi: f64 = 1.0 - threshold;
        if (a > threshold && a < hi) { return 1; }
        return 0;
    }

    # `is_surface_with_threshold` at 1e-6. Mirrors `VofField::is_surface`.
    #must_use
    fn is_surface(self, x, y): i64 {
        return self.is_surface_with_threshold(x, y, 0x3EB0C6F7A0B5ED8D);
    }

    # 1 when α > 1 − threshold. Mirrors `VofField::is_full_with_threshold`.
    #must_use
    fn is_full_with_threshold(self, x, y, threshold: f64): i64 {
        var a: f64 = self.alpha.get_f(y * self.nx + x);
        var hi: f64 = 1.0 - threshold;
        if (a > hi) { return 1; }
        return 0;
    }

    # `is_full_with_threshold` at 1e-6. Mirrors `VofField::is_full`.
    #must_use
    fn is_full(self, x, y): i64 {
        return self.is_full_with_threshold(x, y, 0x3EB0C6F7A0B5ED8D);
    }

    # 1 when α < threshold. Mirrors `VofField::is_empty_with_threshold`.
    #must_use
    fn is_empty_with_threshold(self, x, y, threshold: f64): i64 {
        var a: f64 = self.alpha.get_f(y * self.nx + x);
        if (a < threshold) { return 1; }
        return 0;
    }

    # `is_empty_with_threshold` at 1e-6. Mirrors `VofField::is_empty`.
    #must_use
    fn is_empty(self, x, y): i64 {
        return self.is_empty_with_threshold(x, y, 0x3EB0C6F7A0B5ED8D);
    }

    # α = 1 at every cell whose centre (x·dx, y·dx) lies in [x_min, x_max] × [y_min, y_max]. Mirrors
    # `VofField::fill_rect`.
    fn fill_rect(self, x_min: f64, y_min: f64, x_max: f64, y_max: f64) {
        _pv_fill_shape(_pv_vof_col(self, 0), self.nx, self.ny, self.dx, 0, x_min, y_min, x_max, y_max,
          0x3FF0000000000000);
        return 0;
    }

    # α = 1 at every cell whose centre is strictly within `radius` of (cx, cy). Mirrors `VofField::fill_circle`.
    fn fill_circle(self, cx: f64, cy: f64, radius: f64) {
        _pv_fill_shape(_pv_vof_col(self, 0), self.nx, self.ny, self.dx, 1, cx, cy, radius, 0.0, 0x3FF0000000000000);
        return 0;
    }

    # Σ α·dx² over every cell, folded from −0. Mirrors `VofField::total_volume`.
    #must_use
    fn total_volume(self): f64 {
        var area: f64 = self.dx * self.dx;
        var s: f64 = 0x8000000000000000;
        for (var i = 0; i < self.alpha.len; i = i + 1) {
            var a: f64 = load64(self.alpha.data + i * 8);
            s = s + (a * area);
        }
        return s;
    }

    # The interface normal (g_x/|g|, g_y/|g|) from α's central differences (×0.5/dx) at interior cell (x, y); (0, 0)
    # on the boundary ring, outside the grid, or where |g| < 1e-20. A neighbour outside α reads NaN (Rust panics).
    # Read as `var u, v = …` and bind each to an f64 local. Mirrors `VofField::interface_normal`.
    #must_use
    fn interface_normal(self, x, y) {
        var zero: f64 = 0.0;
        var nx = self.nx;
        if (x <= 0 || x >= nx - 1 || y <= 0 || y >= self.ny - 1) { return (zero, zero); }
        var i = y * nx + x;
        var inv_2dx: f64 = 0.5 / self.dx;
        var r: f64 = self.alpha.get_f(i + 1);
        var l: f64 = self.alpha.get_f(i - 1);
        var t: f64 = self.alpha.get_f(i + nx);
        var b: f64 = self.alpha.get_f(i - nx);
        var gx: f64 = (r - l) * inv_2dx;
        var gy: f64 = (t - b) * inv_2dx;
        var mag: f64 = f64_sqrt((gx * gx) + (gy * gy));
        var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
        if (mag < tiny) { return (zero, zero); }
        var u: f64 = gx / mag;
        var v: f64 = gy / mag;
        return (u, v);
    }

    # Advects α by the cell-centred velocity (vx_len and vy_len words at vx and vy) for dt, in
    # clamp(⌈(((2·v_max)·dt)/dx)/0.5⌉, 1, 1024) sub-steps of dt/count (v_max the largest |v| of vx then vy, folded
    # from +0; a NaN count, from a cell size of 0 or NaN, runs none, as Rust's `as usize` makes it 0). Ok(0), or the
    # first failure in Rust's order: PV_ERR_INVALID_TIMESTEP (dt not finite and > 0), PV_ERR_INVALID_PARAMETER (nx or
    # ny below 4, nx·ny overflowing (Rust panics), α, vx or vy not nx·ny long), PV_ERR_DIVERGED (a non-finite
    # velocity), PV_ERR_OUT_OF_MEMORY (the scratch can't grow, checked before α changes; Rust aborts). Mirrors
    # `VofField::advect`.
    #must_use
    fn advect(self, vx, vx_len, vy, vy_len, dt: f64): Result {
        var trace = _pv_span(_PV_LOG_VOF, "vof::advect", "nx", self.nx, "ny", self.ny, 0, 0);
        if (_pv_is_finite(dt) == 0 || dt <= 0.0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_TIMESTEP); }
        var nx = self.nx;
        var ny = self.ny;
        if ((nx >= 0 && nx < 4) || (ny >= 0 && ny < 4)) { _pv_span_end(trace); return Err(PV_ERR_INVALID_PARAMETER); }
        if (_pv_fg_mul_class(nx, ny) != 0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_PARAMETER); }
        var n = nx * ny;
        if (self.alpha.len != n || vx_len != n || vy_len != n) {
            _pv_span_end(trace);
            return Err(PV_ERR_INVALID_PARAMETER);
        }
        if (_pv_fg_any_bad(vx, n, 1) == 1 || _pv_fg_any_bad(vy, n, 1) == 1) {
            _pv_span_end(trace);
            return Err(PV_ERR_DIVERGED);
        }
        var m: f64 = 0.0;
        for (var i = 0; i < n; i = i + 1) {
            var u: f64 = load64(vx + i * 8);
            var au: f64 = f64_abs(u);
            if (au >= m) { m = au; }
        }
        for (var j = 0; j < n; j = j + 1) {
            var w: f64 = load64(vy + j * 8);
            var aw: f64 = f64_abs(w);
            if (aw >= m) { m = aw; }
        }
        var courant: f64 = ((2.0 * m) * dt) / self.dx;
        var q: f64 = courant / 0.5;
        var cq: f64 = f64_ceil(q);
        var cl: f64 = _pv_clamp(cq, 1.0, 1024.0);
        var substeps = _pv_as_usize(cl);
        var sf: f64 = f64_from(substeps);
        var sub_dt: f64 = dt / sf;
        var sc: *PvColumn = _pv_vof_col(self, 1);
        if (substeps > 0 && sc.resize(n, 0) == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
        for (var s = 0; s < substeps; s = s + 1) { _pv_vof_substep(self, vx, vy, sub_dt); }
        _pv_span_end(trace); return Ok(0);
    }
}

# --- phase_field.cyr ---

# phase_field.cyr — the Allen–Cahn phase field of rust-old/src/phase_field.rs (`PhaseField`, M3 part d).
#
# An order parameter φ ∈ [−1, 1] per cell of an nx × ny grid: −1 phase A, +1 phase B, the interface at 0. `step`
# integrates ∂φ/∂t + u·∇φ = M·(ε²·∇²φ − (φ³ − φ)) by forward Euler, with first-order upwind advection, then copies
# the zero-gradient ghosts. Every formula is Rust's, in its operation order.
#
# The record mirrors the struct: nx, ny, dx, the public φ column, mobility and ε, then the private scratch column
# `step` reads the old φ from (ADR 0002 #14).

struct PvPhaseField {
    nx;
    ny;
    dx: f64;
    phi: PvColumn;
    mobility: f64;
    epsilon: f64;
    scratch: PvColumn;
}

# Column k of a phase field (0 phi at 24, 1 scratch at 64, after mobility and ε), by its byte offset
# (tests/phase_field.tcyr pins the layout, 88 bytes).
#must_use
fn _pv_pf_col(p, k): *PvColumn {
    if (k == 0) { return _pv_as_columns(_pv_addr(p) + 24); }
    return _pv_as_columns(_pv_addr(p) + 64);
}

# Empties both columns of *p without releasing anything (for a record about to be filled).
fn _pv_pf_zero(p: *PvPhaseField) {
    for (var k = 0; k < 2; k = k + 1) {
        var c: *PvColumn = _pv_pf_col(p, k);
        c.data = 0;
        c.len = 0;
        c.cap = 0;
    }
    return 0;
}

# Releases both columns' storage; the field holds no storage after. Mirrors dropping the `PhaseField`.
fn PvPhaseField_drop(p: *PvPhaseField) {
    for (var k = 0; k < 2; k = k + 1) {
        var c: *PvColumn = _pv_pf_col(p, k);
        c.drop();
    }
    return 0;
}

# A field of phase A (φ = −1) into *out, mobility 1 and ε = 2·dx: Ok(0), or the first failure in Rust's order:
# PV_ERR_INVALID_GRID_RESOLUTION for nx or ny below 4, PV_ERR_INVALID_PARAMETER for a cell size not finite and > 0;
# PV_ERR_OUT_OF_MEMORY when nx·ny overflows or the columns can't be allocated (Rust doesn't check the product: it
# panics under overflow checks and aborts on an allocation that large; ADR 0002 #14). On an error *out holds no
# storage. Mirrors `PhaseField::new`.
#must_use
fn PvPhaseField_new(nx, ny, dx: f64, out: *PvPhaseField): Result {
    _pv_pf_zero(out);
    if ((nx >= 0 && nx < 4) || (ny >= 0 && ny < 4)) { return Err(PV_ERR_INVALID_GRID_RESOLUTION); }
    if (dx <= 0.0 || _pv_is_finite(dx) == 0) { return Err(PV_ERR_INVALID_PARAMETER); }
    if (_pv_fg_mul_class(nx, ny) != 0) { return Err(PV_ERR_OUT_OF_MEMORY); }
    var n = nx * ny;
    var f: *PvColumn = _pv_pf_col(out, 0);
    var s: *PvColumn = _pv_pf_col(out, 1);
    if (f.resize(n, 0xBFF0000000000000) == 0 || s.resize(n, 0) == 0) {
        PvPhaseField_drop(out);
        return Err(PV_ERR_OUT_OF_MEMORY);
    }
    out.nx = nx;
    out.ny = ny;
    out.dx = dx;
    out.mobility = 1.0;
    var eps: f64 = 2.0 * dx;
    out.epsilon = eps;
    return Ok(0);
}

# A deep copy of `src` into *out, scratch included: 1, or 0 when the memory isn't there (then *out holds no
# storage). Mirrors `PhaseField::clone`.
#must_use
fn PvPhaseField_clone(out: *PvPhaseField, src: *PvPhaseField): i64 {
    out.nx = src.nx;
    out.ny = src.ny;
    out.dx = src.dx;
    out.mobility = src.mobility;
    out.epsilon = src.epsilon;
    _pv_pf_zero(out);
    for (var k = 0; k < 2; k = k + 1) {
        var s: *PvColumn = _pv_pf_col(src, k);
        var d: *PvColumn = _pv_pf_col(out, k);
        if (d.resize(s.len, 0) == 0) {
            PvPhaseField_drop(out);
            return 0;
        }
        d.copy_from(s);
    }
    return 1;
}

impl PvPhaseField {
    # φ = +1 at every cell whose centre (x·dx, y·dx) is strictly within `radius` of (cx, cy). Mirrors
    # `PhaseField::set_circle`.
    fn set_circle(self, cx: f64, cy: f64, radius: f64) {
        _pv_fill_shape(_pv_pf_col(self, 0), self.nx, self.ny, self.dx, 1, cx, cy, radius, 0.0, 0x3FF0000000000000);
        return 0;
    }

    # φ = +1 at every cell whose centre lies in [x_min, x_max] × [y_min, y_max]. Mirrors `PhaseField::set_rect`.
    fn set_rect(self, x_min: f64, y_min: f64, x_max: f64, y_max: f64) {
        _pv_fill_shape(_pv_pf_col(self, 0), self.nx, self.ny, self.dx, 0, x_min, y_min, x_max, y_max,
          0x3FF0000000000000);
        return 0;
    }

    # 1 when the cell is phase B (φ > 0); 0 otherwise (and for a cell outside φ, where Rust panics). Mirrors
    # `PhaseField::is_phase_b`.
    #must_use
    fn is_phase_b(self, x, y): i64 {
        var p: f64 = self.phi.get_f(y * self.nx + x);
        if (p > 0.0) { return 1; }
        return 0;
    }

    # 1 when |φ| < threshold at the cell (an interface cell). Mirrors `PhaseField::is_interface`.
    #must_use
    fn is_interface(self, x, y, threshold: f64): i64 {
        var p: f64 = self.phi.get_f(y * self.nx + x);
        var a: f64 = f64_abs(p);
        if (a < threshold) { return 1; }
        return 0;
    }

    # Σ ((φ + 1)·0.5)·dx² over every cell, folded from −0. Mirrors `PhaseField::phase_b_area`.
    #must_use
    fn phase_b_area(self): f64 {
        var area: f64 = self.dx * self.dx;
        var s: f64 = 0x8000000000000000;
        for (var i = 0; i < self.phi.len; i = i + 1) {
            var p: f64 = load64(self.phi.data + i * 8);
            var w: f64 = ((p + 1.0) * 0.5) * area;
            s = s + w;
        }
        return s;
    }

    # One step of length dt with the velocity (vx_len and vy_len words at vx and vy; both 0 for none). On the
    # interior, from the old φ (copied to the scratch):
    #   ∇²φ = ((((φ_r + φ_l) + φ_t) + φ_b) − 4φ)·(1/dx)², f' = (φ·φ)·φ − φ, R = M·(ε²·∇²φ − f'),
    #   A = −((u·∂xφ) + (v·∂yφ)) with one-sided upwind differences ×(1/dx) (A = +0 without a velocity),
    #   φ ← clamp(φ + (A + R)·dt, −1, 1);
    # then the ghosts: the bottom and top rows, then the left and right columns, each copied from its inner
    # neighbour. Ok(0), or the first failure in Rust's order: PV_ERR_INVALID_TIMESTEP (dt not finite and > 0),
    # PV_ERR_INVALID_GRID_RESOLUTION (φ not nx·ny long, nx or ny below 3, nx·ny overflowing, where Rust panics),
    # PV_ERR_INVALID_PARAMETER (a velocity that is neither both empty nor both nx·ny long), PV_ERR_OUT_OF_MEMORY (the
    # scratch can't grow, checked before φ changes; Rust aborts). When any interior cell's new φ is beyond ±1.5 before
    # its clamp, one WARN event per step counts them (`cells`). Mirrors `PhaseField::step`.
    #must_use
    fn step(self, vx, vx_len, vy, vy_len, dt: f64): Result {
        var trace = _pv_span(_PV_LOG_PHASE_FIELD, "phase_field::step", "nx", self.nx, "ny", self.ny, 0, 0);
        if (_pv_is_finite(dt) == 0 || dt <= 0.0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_TIMESTEP); }
        var nx = self.nx;
        var ny = self.ny;
        if (nx != 0 && ny != 0 && (nx < 0 || ny < 0 || nx > 0x7FFFFFFFFFFFFFFF / ny)) {
            _pv_span_end(trace); return Err(PV_ERR_INVALID_GRID_RESOLUTION);
        }
        var n = nx * ny;
        if (self.phi.len != n || nx < 3 || ny < 3) { _pv_span_end(trace); return Err(PV_ERR_INVALID_GRID_RESOLUTION); }
        var has_v = 1;
        if (vx_len == 0 && vy_len == 0) { has_v = 0; }
        if (has_v == 1 && (vx_len != n || vy_len != n)) { _pv_span_end(trace); return Err(PV_ERR_INVALID_PARAMETER); }
        var sc: *PvColumn = _pv_pf_col(self, 1);
        if (sc.resize(n, 0) == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
        var inv_dx: f64 = 1.0 / self.dx;
        var inv_dx2: f64 = inv_dx * inv_dx;
        var m: f64 = self.mobility;
        var eps2: f64 = self.epsilon * self.epsilon;
        var f = self.phi.data;
        var ph = sc.data;
        _pv_fg_copy(ph, f, n);
        var diverging = 0;
        for (var y = 1; y < ny - 1; y = y + 1) {
            for (var x = 1; x < nx - 1; x = x + 1) {
                var i = y * nx + x;
                var q = ph + i * 8;
                var p: f64 = load64(q);
                var pr: f64 = load64(q + 8);
                var pl: f64 = load64(q - 8);
                var pt: f64 = load64(q + nx * 8);
                var pb: f64 = load64(q - nx * 8);
                var s4: f64 = 4.0 * p;
                var lap: f64 = ((((pr + pl) + pt) + pb) - s4) * inv_dx2;
                var fp: f64 = ((p * p) * p) - p;
                var react: f64 = m * ((eps2 * lap) - fp);
                var adv: f64 = 0.0;
                if (has_v == 1) {
                    var u: f64 = load64(vx + i * 8);
                    var v: f64 = load64(vy + i * 8);
                    var ddx: f64 = pr - p;
                    if (u > 0.0) { ddx = p - pl; }
                    var dpdx: f64 = ddx * inv_dx;
                    var ddy: f64 = pt - p;
                    if (v > 0.0) { ddy = p - pb; }
                    var dpdy: f64 = ddy * inv_dx;
                    var t: f64 = (u * dpdx) + (v * dpdy);
                    adv = -t;
                }
                var cur: f64 = load64(f + i * 8);
                # clamp(·, −1, 1) written out (a NaN stays NaN): as a `_pv_clamp` call it made the step 1.18–1.19×
                # slower (pinned A/B, port-parity §13).
                var c: f64 = cur + ((adv + react) * dt);
                # |c| > 1.5 counts as diverging (a NaN doesn't, as Rust's `abs() > 1.5`), tested only past the clamp's
                # ±1, so the common path pays nothing for it.
                if (c < -1.0) {
                    if (c < -1.5) { diverging = diverging + 1; }
                    c = -1.0;
                }
                if (c > 1.0) {
                    if (c > 1.5) { diverging = diverging + 1; }
                    c = 1.0;
                }
                store64(f + i * 8, _pv_bits(c));
            }
        }
        # One warning per step (not per cell), as Rust's.
        if (diverging > 0) {
            var msg = "phase field divergence detected (|φ| > 1.5)";
            _pv_warn(_PV_LOG_PHASE_FIELD, msg, "cells", diverging, 0, 0, 0, 0);
        }
        for (var gx = 0; gx < nx; gx = gx + 1) {
            store64(f + gx * 8, load64(f + (nx + gx) * 8));
            store64(f + ((ny - 1) * nx + gx) * 8, load64(f + ((ny - 2) * nx + gx) * 8));
        }
        for (var gy = 0; gy < ny; gy = gy + 1) {
            store64(f + (gy * nx) * 8, load64(f + (gy * nx + 1) * 8));
            store64(f + (gy * nx + nx - 1) * 8, load64(f + (gy * nx + nx - 2) * 8));
        }
        _pv_span_end(trace); return Ok(0);
    }
}

# --- sph_kernels.cyr ---

# sph_kernels.cyr — the SPH smoothing kernels, the equations of state and the small particle helpers of
# rust-old/src/sph.rs (M4 part a).
#
# The 3D kernels (Müller et al. 2003: poly6 for density, the spiky gradient for pressure, the viscosity Laplacian),
# the Wendland C2 and C4 kernels and gradients, the linear and Tait equations of state, the non-Newtonian
# viscosity models, and the batch and whole-system helpers. Every formula is Rust's, in its operation order; π is
# `f64::consts::PI` (src/constants.cyr), the floors are the private constants (src/constants_private.cyr), and ln
# and powf are the correctly rounded ones (ADR 0004).
#
# `_PvKernelCoeffs` mirrors the private `KernelCoeffs`: the coefficients for one smoothing radius, computed once. Its
# colour-field terms (`poly6_grad_scalar`, `poly6_laplacian`) are reached only from the solver, whose rows cover them
# at M5; until then `tests/sph.tcyr` checks them (Rust's `test_poly6_kernels_consistent`). The CSF acceleration
# arrives with the solver.

struct _PvKernelCoeffs {
    h: f64;
    h2: f64;
    poly6: f64;
    spiky_grad: f64;
    visc_lap: f64;
    poly6_grad: f64;
    poly6_lap: f64;
}

# A typed view of a word (the solver's pool kernels read their coefficients through one).
#must_use
fn _pv_as_kc(p): *_PvKernelCoeffs {
    return p;
}

# The coefficients for smoothing radius h into *kc (Rust only debug-asserts h > 0; another h gives what its
# arithmetic gives): h², 315/((64π)·h⁹), −45/(π·h⁶), 45/(π·h⁶) and −945/((32π)·h⁹) twice, with h⁶ = h³·h³ and
# h⁹ = h⁶·h³. Mirrors `KernelCoeffs::new`.
fn _pv_kc_init(kc: *_PvKernelCoeffs, h: f64) {
    var pi: f64 = PV_F64_PI;
    var h2: f64 = h * h;
    var h3: f64 = h2 * h;
    var h6: f64 = h3 * h3;
    var h9: f64 = h6 * h3;
    var p6: f64 = 315.0 / ((64.0 * pi) * h9);
    var sg: f64 = -45.0 / (pi * h6);
    var vl: f64 = 45.0 / (pi * h6);
    var pg: f64 = -945.0 / ((32.0 * pi) * h9);
    kc.h = h;
    kc.h2 = h2;
    kc.poly6 = p6;
    kc.spiky_grad = sg;
    kc.visc_lap = vl;
    kc.poly6_grad = pg;
    kc.poly6_lap = pg;
    return 0;
}

# poly6 at squared distance r2: 0 beyond h², else ((c·d)·d)·d with d = h² − r2. Mirrors `KernelCoeffs::poly6`.
#must_use
fn _pv_kc_poly6(kc: *_PvKernelCoeffs, r2: f64): f64 {
    if (r2 > kc.h2) { return 0.0; }
    var d: f64 = kc.h2 - r2;
    var w: f64 = ((kc.poly6 * d) * d) * d;
    return w;
}

# The poly6 gradient's scalar at squared distance r2: 0 beyond h², else (c·d)·d with d = h² − r2 and c = −945/(32π·h⁹)
# (the caller multiplies by the displacement). Mirrors `KernelCoeffs::poly6_grad_scalar`.
#must_use
fn _pv_kc_poly6_grad(kc: *_PvKernelCoeffs, r2: f64): f64 {
    if (r2 > kc.h2) { return 0.0; }
    var d: f64 = kc.h2 - r2;
    var w: f64 = (kc.poly6_grad * d) * d;
    return w;
}

# The poly6 Laplacian at squared distance r2: 0 beyond h², else (c·d)·(3h² − 7r2) with d = h² − r2. Mirrors
# `KernelCoeffs::poly6_laplacian`.
#must_use
fn _pv_kc_poly6_lap(kc: *_PvKernelCoeffs, r2: f64): f64 {
    if (r2 > kc.h2) { return 0.0; }
    var d: f64 = kc.h2 - r2;
    var t: f64 = (3.0 * kc.h2) - (7.0 * r2);
    var w: f64 = (kc.poly6_lap * d) * t;
    return w;
}

# The spiky gradient magnitude at distance r: 0 beyond h or for r ≤ 0, else (c·d)·d with d = h − r. Mirrors
# `KernelCoeffs::spiky_grad`.
#must_use
fn _pv_kc_spiky_grad(kc: *_PvKernelCoeffs, r: f64): f64 {
    if (r > kc.h || r <= 0.0) { return 0.0; }
    var d: f64 = kc.h - r;
    var w: f64 = (kc.spiky_grad * d) * d;
    return w;
}

# The viscosity Laplacian at distance r: 0 beyond h or for r ≤ 0, else c·(h − r). Mirrors
# `KernelCoeffs::visc_laplacian`.
#must_use
fn _pv_kc_visc_lap(kc: *_PvKernelCoeffs, r: f64): f64 {
    if (r > kc.h || r <= 0.0) { return 0.0; }
    var d: f64 = kc.h - r;
    var w: f64 = kc.visc_lap * d;
    return w;
}

# 1 when x is finite and > 0 (0 for NaN). Mirrors the private `is_positive`.
#must_use
fn _pv_is_positive(x: f64): i64 {
    if (_pv_is_finite(x) == 1 && x > 0.0) { return 1; }
    return 0;
}

# ── the kernels (public API) ────────────────────────────────────────────────────────

# The poly6 kernel W(r, h) = 315/(64π·h⁹)·(h² − r²)³ for 0 ≤ r ≤ h; 0 for r < 0, beyond h, or h not > 0 (NaN
# included). Mirrors `kernel_poly6`.
#
# Each public kernel computes only its own coefficient, by `_pv_kc_init`'s expression, where Rust builds the whole
# `KernelCoeffs` and rustc keeps only what the call uses: the same value, so the same bits, without three unused
# divisions (pinned A/B, port-parity §15).
#must_use
fn kernel_poly6(r: f64, h: f64): f64 {
    if (r < 0.0 || (h > 0.0) == 0) { return 0.0; }
    var h2: f64 = h * h;
    var r2: f64 = r * r;
    if (r2 > h2) { return 0.0; }
    var pi: f64 = PV_F64_PI;
    var h3: f64 = h2 * h;
    var h6: f64 = h3 * h3;
    var h9: f64 = h6 * h3;
    var c: f64 = 315.0 / ((64.0 * pi) * h9);
    var d: f64 = h2 - r2;
    var w: f64 = ((c * d) * d) * d;
    return w;
}

# The spiky kernel's gradient magnitude −45/(π·h⁶)·(h − r)² for 0 < r ≤ h; 0 otherwise, and for h not > 0. Mirrors
# `kernel_spiky_grad`.
#must_use
fn kernel_spiky_grad(r: f64, h: f64): f64 {
    if ((h > 0.0) == 0) { return 0.0; }
    if (r > h || r <= 0.0) { return 0.0; }
    var pi: f64 = PV_F64_PI;
    var h2: f64 = h * h;
    var h3: f64 = h2 * h;
    var h6: f64 = h3 * h3;
    var c: f64 = -45.0 / (pi * h6);
    var d: f64 = h - r;
    var w: f64 = (c * d) * d;
    return w;
}

# The viscosity kernel's Laplacian 45/(π·h⁶)·(h − r) for 0 < r ≤ h; 0 otherwise, and for h not > 0. Mirrors
# `kernel_viscosity_laplacian`.
#must_use
fn kernel_viscosity_laplacian(r: f64, h: f64): f64 {
    if ((h > 0.0) == 0) { return 0.0; }
    if (r > h || r <= 0.0) { return 0.0; }
    var pi: f64 = PV_F64_PI;
    var h2: f64 = h * h;
    var h3: f64 = h2 * h;
    var h6: f64 = h3 * h3;
    var c: f64 = 45.0 / (pi * h6);
    var w: f64 = c * (h - r);
    return w;
}

# 7/((4π·h)·h), the 2D Wendland C2 normalisation (C4's numerator is 9).
#must_use
fn _pv_wendland_sigma(num: f64, h: f64): f64 {
    var pi: f64 = PV_F64_PI;
    var s: f64 = num / (((4.0 * pi) * h) * h);
    return s;
}

# The Wendland C2 kernel σ·(1 − q/2)⁴·(1 + 2q), σ = 7/(4π·h²), q = r/h in [0, 2); 0 otherwise (NaN q included).
# Mirrors `kernel_wendland_c2`.
#must_use
fn kernel_wendland_c2(r: f64, h: f64): f64 {
    var q: f64 = r / h;
    if ((q >= 0.0 && q < 2.0) == 0) { return 0.0; }
    var t: f64 = 1.0 - (0.5 * q);
    var s: f64 = _pv_wendland_sigma(7.0, h);
    var w: f64 = ((((s * t) * t) * t) * t) * (1.0 + (2.0 * q));
    return w;
}

# The Wendland C2 gradient magnitude ((((σ·(−5q))·t)·t)·t)/h, t = 1 − q/2, for 0 < q < 2; 0 for q ≥ 2 or q ≤ 0 (a
# NaN q passes both tests and gives NaN, as Rust's does). Mirrors `kernel_wendland_c2_grad`.
#must_use
fn kernel_wendland_c2_grad(r: f64, h: f64): f64 {
    var q: f64 = r / h;
    if (q >= 2.0 || q <= 0.0) { return 0.0; }
    var t: f64 = 1.0 - (0.5 * q);
    var s: f64 = _pv_wendland_sigma(7.0, h);
    var m5: f64 = -5.0 * q;
    var w: f64 = ((((s * m5) * t) * t) * t) / h;
    return w;
}

# The Wendland C4 kernel (σ·t⁶)·((1 + 3q) + (35/12)·q·q), σ = 9/(4π·h²), t = 1 − q/2, t⁶ by five multiplies, q in
# [0, 2); 0 otherwise. Mirrors `kernel_wendland_c4`.
#must_use
fn kernel_wendland_c4(r: f64, h: f64): f64 {
    var q: f64 = r / h;
    if ((q >= 0.0 && q < 2.0) == 0) { return 0.0; }
    var t: f64 = 1.0 - (0.5 * q);
    var t6: f64 = ((((t * t) * t) * t) * t) * t;
    var s: f64 = _pv_wendland_sigma(9.0, h);
    var k: f64 = 35.0 / 12.0;
    var g: f64 = (1.0 + (3.0 * q)) + ((k * q) * q);
    var w: f64 = (s * t6) * g;
    return w;
}

# The Wendland C4 gradient magnitude (σ·(t⁵·(−3g + t·g′)))/h, with g = (1 + 3q) + (35/12)·q·q and
# g′ = 3 + (35/6)·q, for 0 < q < 2; 0 for q ≥ 2 or q ≤ 0 (NaN passes, as above). Mirrors `kernel_wendland_c4_grad`.
#must_use
fn kernel_wendland_c4_grad(r: f64, h: f64): f64 {
    var q: f64 = r / h;
    if (q >= 2.0 || q <= 0.0) { return 0.0; }
    var t: f64 = 1.0 - (0.5 * q);
    var t5: f64 = (((t * t) * t) * t) * t;
    var k12: f64 = 35.0 / 12.0;
    var k6: f64 = 35.0 / 6.0;
    var g: f64 = (1.0 + (3.0 * q)) + ((k12 * q) * q);
    var gp: f64 = 3.0 + (k6 * q);
    var m3: f64 = -3.0 * g;
    var tg: f64 = t * gp;
    var dfdq: f64 = t5 * (m3 + tg);
    var s: f64 = _pv_wendland_sigma(9.0, h);
    var w: f64 = (s * dfdq) / h;
    return w;
}

# ── the equations of state ──────────────────────────────────────────────────────────

# The linear equation of state k·(ρ − ρ₀). Mirrors `equation_of_state`.
#must_use
fn equation_of_state(density: f64, rest_density: f64, gas_constant: f64): f64 {
    var d: f64 = density - rest_density;
    var p: f64 = gas_constant * d;
    return p;
}

# The Tait equation of state B·((ρ/ρ₀′)^γ − 1), B = (ρ₀·c²)/γ, ρ₀′ = max(ρ₀, 1e-10); for |γ| < 1e-12 its limit
# (ρ₀·c²)·ln(ρ/ρ₀′). ln and powf are correctly rounded (ADR 0004). Mirrors `equation_of_state_tait`.
#must_use
fn equation_of_state_tait(density: f64, rest_density: f64, speed_of_sound: f64, gamma: f64): f64 {
    var lo: f64 = _PV_SPH_MIN_DENSITY;
    var rho0: f64 = _pv_max(rest_density, lo);
    var c2: f64 = speed_of_sound * speed_of_sound;
    var rc2: f64 = rest_density * c2;
    var x: f64 = density / rho0;
    var ag: f64 = f64_abs(gamma);
    var tiny: f64 = 0x3D719799812DEA11;   # 1e-12
    if (ag < tiny) {
        var lx: f64 = _pv_ln(x);
        var p0: f64 = rc2 * lx;
        return p0;
    }
    var b: f64 = rc2 / gamma;
    var xg: f64 = _pv_powf(x, gamma);
    var p: f64 = b * (xg - 1.0);
    return p;
}

# ── the non-Newtonian viscosity models ──────────────────────────────────────────────

# The kind of a non-Newtonian viscosity model: explicit, append-only values (Rust's `#[non_exhaustive]` enum in
# declaration order). Its payload is `PvNonNewtonianModel` (port plan §7.3).
enum PvNonNewtonianViscosity {
    PV_NON_NEWTONIAN_VISCOSITY_POWER_LAW = 0;
    PV_NON_NEWTONIAN_VISCOSITY_BINGHAM = 1;
    PV_NON_NEWTONIAN_VISCOSITY_HERSCHEL_BULKLEY = 2;
}

# A non-Newtonian viscosity model: its kind and the union of the variants' fields (a field a kind doesn't use is
# 0). Mirrors `NonNewtonianViscosity`.
struct PvNonNewtonianModel {
    kind;
    consistency: f64;
    power_index: f64;
    yield_stress: f64;
    plastic_viscosity: f64;
}

# The power law μ = K·|γ̇|^(n−1). Mirrors `NonNewtonianViscosity::PowerLaw { consistency, power_index }`.
#must_use
fn PvNonNewtonianModel_power_law(consistency: f64, power_index: f64): PvNonNewtonianModel {
    var m: PvNonNewtonianModel;
    m.kind = PV_NON_NEWTONIAN_VISCOSITY_POWER_LAW;
    m.consistency = consistency;
    m.power_index = power_index;
    m.yield_stress = 0.0;
    m.plastic_viscosity = 0.0;
    return m;
}

# The Bingham plastic μ = μ_p + τ_y/|γ̇|. Mirrors `NonNewtonianViscosity::Bingham { yield_stress,
# plastic_viscosity }`.
#must_use
fn PvNonNewtonianModel_bingham(yield_stress: f64, plastic_viscosity: f64): PvNonNewtonianModel {
    var m: PvNonNewtonianModel;
    m.kind = PV_NON_NEWTONIAN_VISCOSITY_BINGHAM;
    m.consistency = 0.0;
    m.power_index = 0.0;
    m.yield_stress = yield_stress;
    m.plastic_viscosity = plastic_viscosity;
    return m;
}

# Herschel–Bulkley μ = K·|γ̇|^(n−1) + τ_y/|γ̇|. Mirrors `NonNewtonianViscosity::HerschelBulkley { yield_stress,
# consistency, power_index }`.
#must_use
fn PvNonNewtonianModel_herschel_bulkley(yield_stress: f64, consistency: f64, power_index: f64): PvNonNewtonianModel {
    var m: PvNonNewtonianModel;
    m.kind = PV_NON_NEWTONIAN_VISCOSITY_HERSCHEL_BULKLEY;
    m.consistency = consistency;
    m.power_index = power_index;
    m.yield_stress = yield_stress;
    m.plastic_viscosity = 0.0;
    return m;
}

# The model's effective viscosity at strain rate |γ̇|, with s = max(|γ̇|, 1e-10) (a NaN rate gives 1e-10):
#   power law K·s^(n−1); Bingham min(μ_p + τ_y/s, 1e6·μ_p); Herschel–Bulkley min(K·s^(n−1) + τ_y/s, 1e6·K)
# (powf correctly rounded, the mins Rust's NaN-ignoring ones). NaN for a kind outside the enum. Mirrors
# `NonNewtonianViscosity::effective_viscosity`.
#must_use
fn non_newtonian_viscosity_effective_viscosity(m: *PvNonNewtonianModel, strain_rate: f64): f64 {
    var eps: f64 = 0x3DDB7CDFD9D7BDBB;   # 1e-10
    var sr: f64 = _pv_max(strain_rate, eps);
    var big: f64 = 1000000.0;
    match m.kind {
        PV_NON_NEWTONIAN_VISCOSITY_POWER_LAW => {
            var e: f64 = m.power_index - 1.0;
            var pw: f64 = _pv_powf(sr, e);
            var mu: f64 = m.consistency * pw;
            return mu;
        }
        PV_NON_NEWTONIAN_VISCOSITY_BINGHAM => {
            var ys: f64 = m.yield_stress / sr;
            var mb: f64 = m.plastic_viscosity + ys;
            var cap: f64 = big * m.plastic_viscosity;
            var rb: f64 = _pv_min(mb, cap);
            return rb;
        }
        PV_NON_NEWTONIAN_VISCOSITY_HERSCHEL_BULKLEY => {
            var e2: f64 = m.power_index - 1.0;
            var pw2: f64 = _pv_powf(sr, e2);
            var base: f64 = m.consistency * pw2;
            var ys2: f64 = m.yield_stress / sr;
            var mh: f64 = base + ys2;
            var cap2: f64 = big * m.consistency;
            var rh: f64 = _pv_min(mh, cap2);
            return rh;
        }
        _ => {
            var nan: f64 = PV_F64_NAN;
            return nan;
        }
    }
    var nan2: f64 = PV_F64_NAN;
    return nan2;
}

# ── the batch and whole-system helpers ──────────────────────────────────────────────

# poly6 at each of the n squared distances at r2 (the coefficients for h, with no check on h, as Rust's), as a new
# freelist buffer: (pointer, n), which the caller releases with `fl_free`; (0, 0) for n ≤ 0 or no memory. Mirrors
# `batch_poly6` (ADR 0002 #9).
#must_use
fn batch_poly6(r2, n, h: f64) {
    if (n <= 0) { return (0, 0); }
    var out = fl_alloc(n * 8);
    if (out == 0) { return (0, 0); }
    var kc: _PvKernelCoeffs;
    _pv_kc_init(&kc, h);
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = load64(r2 + i * 8);
        var w: f64 = _pv_kc_poly6(&kc, x);
        store64(out + i * 8, _pv_bits(w));
    }
    return (out, n);
}

# |pos − positions[i]|² for each of the n `PvVec3`s at positions, as a new freelist buffer: (pointer, n), (0, 0) for
# n ≤ 0 or no memory. Mirrors `batch_distance_squared` (ADR 0002 #9).
#must_use
fn batch_distance_squared(pos: PvVec3, positions, n) {
    if (n <= 0) { return (0, 0); }
    var out = fl_alloc(n * 8);
    if (out == 0) { return (0, 0); }
    for (var i = 0; i < n; i = i + 1) {
        var q = positions + i * 24;
        var qx: f64 = load64(q);
        var qy: f64 = load64(q + 8);
        var qz: f64 = load64(q + 16);
        var dx: f64 = pos.x - qx;
        var dy: f64 = pos.y - qy;
        var dz: f64 = pos.z - qz;
        var d: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
        store64(out + i * 8, _pv_bits(d));
    }
    return (out, n);
}

# Σ kinetic energy over the n particles at ps, folded from −0 (Rust's f64 sum). Mirrors `total_kinetic_energy`.
#must_use
fn total_kinetic_energy(ps: *PvFluidParticle, n): f64 {
    var s: f64 = 0x8000000000000000;
    for (var i = 0; i < n; i = i + 1) {
        var p: *PvFluidParticle = ps + i;
        var e: f64 = p.kinetic_energy();
        s = s + e;
    }
    return s;
}

# The largest speed over the n particles at ps: √ of the max of |v|², folded from +0 with Rust's NaN-ignoring max.
# Mirrors `max_speed`.
#must_use
fn max_speed(ps: *PvFluidParticle, n): f64 {
    var m: f64 = 0.0;
    for (var i = 0; i < n; i = i + 1) {
        var p: *PvFluidParticle = ps + i;
        var q: f64 = p.speed_squared();
        if (q >= m || m != m) { m = q; }
    }
    var s: f64 = f64_sqrt(m);
    return s;
}

# --- neighbor.cyr ---

# neighbor.cyr — the SPH neighbour grid (M4 part b, switched to f64 keys in M5 part e): the cells of hisab's
# `SpatialHash` as `SphSolver` uses it, on sorted arrays, and the solver's neighbour lists in `build_neighbors`' order.
# Also the stable merge sort the grid and `sort_by_zorder` share.
#
# hisab keeps a `HashMap` of cells: each cell's indices in insertion order, which is index order, since the solver
# inserts particle i at step i. Sorting the points on (cell key, index) gives every cell as one run in that same
# order, and a cell lookup is a search over the runs: the same lists, with no map to iterate (CLAUDE.md: never
# iterate a hashmap) and nothing allocated once the grid has grown. The cells are ordered z, then y, then x, so a
# list row's three cells (one z and y, three consecutive x) sit together: one binary search finds the first, and a
# short scan the others. The order of the cells never shows in the lists, which follow (dz, dy, dx).
#
# The keys are f64 (port plan D3, ADR 0002 #2): floor(x · fl(1/h)) as a saturating i64 per axis, hisab 3.4.1's
# `_sh_cell_coord`, and a particle's lists are the 27 cells at its own key ± 1 on each axis, in integers. Rust 1.3.0
# keys f32 positions (hisab 1.4.0) and finds each neighbour cell by re-keying an f32 probe point at its centre, which
# at |x| ≈ 10⁶ lands in another cell for 89% of the points (port-parity §4.4) and can list a cell twice. The rows the
# switch changes are checked against tests/golden/<module>.d3.tsv, the f64 lists of scripts/oracle/validate.py.
#
# A grid built by `PvNeighborGrid_build` (M6 part a) holds the cells only, with no lists: it is the caller's stand-in
# for the hisab `SpatialHash` that `drag_from_particles_indexed` queries (ADR 0002 #23). Its extra column orders the
# cells by x, then y, then z, the order Rust's `query_radius` visits a block of cells in (`_pv_nb_block`).
#
# UPSTREAM(L4): hisab:docs/development/issues/2026-11-11-spatial-hash-per-step-rebuild-allocates.md
#   replace `PvNeighborGrid` with hisab's `spatial_hash_*` once its query writes into caller storage (its f64 cells
#   are these keys); parity: the `SphSolver::neighbor_lists` rows of tests/golden/sph.tsv and sph.d3.tsv (class A),
#   and the `drag_from_particles_indexed` rows of tests/golden/coupling.tsv and coupling.d3.tsv (class B).
# UPSTREAM(L9): cyrius:docs/development/issues/2026-11-11-no-stable-sort.md
#   replace `_pv_msort` with the stdlib's stable sort once it ships; parity: the neighbour lists and the
#   `sort_by_zorder` rows (class A).

# ── the stable merge sort ───────────────────────────────────────────────────────────

# Sorts the n words at idx stably by cmp(ctx, a, b) (negative, 0 or positive, as a before, tied with or after b),
# with tmp holding n words of scratch: a bottom-up merge sort, which keeps tied words in their input order. With idx
# starting in index order, the result is sorted on (key, index), a total order (ADR 0002 #3).
fn _pv_msort(idx, n, tmp, cmp, ctx) {
    var src = idx;
    var dst = tmp;
    var width = 1;
    while (width < n) {
        for (var lo = 0; lo < n; lo = lo + 2 * width) {
            var mid = lo + width;
            if (mid > n) { mid = n; }
            var hi = lo + 2 * width;
            if (hi > n) { hi = n; }
            var a = lo;
            var b = mid;
            var k = lo;
            while (a < mid && b < hi) {
                var wa = load64(src + a * 8);
                var wb = load64(src + b * 8);
                if (fncall3(cmp, ctx, wa, wb) <= 0) {
                    store64(dst + k * 8, wa);
                    a = a + 1;
                } else {
                    store64(dst + k * 8, wb);
                    b = b + 1;
                }
                k = k + 1;
            }
            while (a < mid) {
                store64(dst + k * 8, load64(src + a * 8));
                a = a + 1;
                k = k + 1;
            }
            while (b < hi) {
                store64(dst + k * 8, load64(src + b * 8));
                b = b + 1;
                k = k + 1;
            }
        }
        var t = src;
        src = dst;
        dst = t;
        width = width * 2;
    }
    if (src != idx) {
        for (var i = 0; i < n; i = i + 1) { store64(idx + i * 8, load64(src + i * 8)); }
    }
    return 0;
}

# ── the f64 cell key ────────────────────────────────────────────────────────────────

# floor(x · inv) as a saturating i64 (NaN 0): one axis of a cell key, inv the grid's fl(1/cell). Mirrors hisab 3.4.1
# `_sh_cell_coord` (ADR 0002 #2).
#must_use
fn _pv_nb_key(x: f64, inv: f64): i64 {
    var prod: f64 = x * inv;
    var fl: f64 = f64_floor(prod);
    return _pv_as_i64(fl);
}

# The cell key of position p (one axis) at smoothing radius h: floor(p · fl(1/h)) as i64. The f64 form of the oracle
# hook `sph_cell_key`, whose f32 rows are mapped by name (ADR 0002 #2).
#must_use
fn _pv_sph_cell_key(p: f64, h: f64): i64 {
    var one: f64 = 1.0;
    var inv: f64 = one / h;
    return _pv_nb_key(p, inv);
}

# ── the grid ────────────────────────────────────────────────────────────────────────

# The neighbour grid of one solver: the cell size of the last build (its h) and fl(1/h), the points of that build
# sorted into cells (their keys, 3 words a point), and the neighbour lists in CSR form. Every column is reused across
# builds. Starts as `SphSolver::new`'s grid: cell size 1, empty. A cells-only build (`PvNeighborGrid_build`) leaves
# the lists empty and fills `xorder`, the cells in (x, y, z) order; a solver's build leaves `xorder` empty.
struct PvNeighborGrid {
    cell_size: f64;
    inv_cell: f64;
    len;
    cells;
    keys: PvColumn;
    order: PvColumn;
    tmp: PvColumn;
    cstart: PvColumn;
    offsets: PvColumn;
    indices: PvColumn;
    ckeys: PvColumn;
    xorder: PvColumn;
}

# Column k of a grid (0 keys, 1 order, 2 tmp, 3 cstart, 4 offsets, 5 indices, 6 ckeys, 7 xorder), by its byte offset
# (tests/sph.tcyr pins the layout, 224 bytes).
#must_use
fn _pv_nb_col(g, k): *PvColumn {
    return _pv_as_columns(_pv_addr(g) + 32 + k * 24);
}

# The grid's column count.
const _PV_NB_COLUMNS = 8;

# An empty grid of cell size 1 into *g (nothing allocated yet). Mirrors `SpatialHash::new(1.0)` in `SphSolver::new`.
fn PvNeighborGrid_init(g: *PvNeighborGrid) {
    g.cell_size = 1.0;
    g.inv_cell = 1.0;
    g.len = 0;
    g.cells = 0;
    for (var k = 0; k < _PV_NB_COLUMNS; k = k + 1) {
        var c: *PvColumn = _pv_nb_col(g, k);
        c.data = 0;
        c.len = 0;
        c.cap = 0;
    }
    return 0;
}

# Releases the grid's columns; it is empty and usable again (cell size kept).
fn PvNeighborGrid_drop(g: *PvNeighborGrid) {
    for (var k = 0; k < _PV_NB_COLUMNS; k = k + 1) {
        var c: *PvColumn = _pv_nb_col(g, k);
        c.drop();
    }
    g.len = 0;
    g.cells = 0;
    return 0;
}

# The order of two points' cell keys (ctx: the key column's words, x, y, z a point): negative, 0 or positive,
# comparing z, then y, then x. Ties keep index order through the stable sort.
fn _pv_nb_cmp(ctx, a, b): i64 {
    var pa = ctx + a * 24;
    var pb = ctx + b * 24;
    for (var k = 2; k >= 0; k = k - 1) {
        var ka = load64(pa + k * 8);
        var kb = load64(pb + k * 8);
        if (ka < kb) { return 0 - 1; }
        if (ka > kb) { return 1; }
    }
    return 0;
}

# The first of the cells [lo, hi) (ck: their keys, x, y, z a cell) not before (kx, ky, kz) in the grid's order (z,
# then y, then x): a binary search.
#must_use
fn _pv_nb_lower(ck, lo, hi, kx, ky, kz): i64 {
    while (lo < hi) {
        var mid = (lo + hi) / 2;
        var p = ck + mid * 24;
        var mz = load64(p + 16);
        var before = 0;
        if (mz < kz) {
            before = 1;
        } elif (mz == kz) {
            var my = load64(p + 8);
            if (my < ky) {
                before = 1;
            } elif (my == ky) {
                if (load64(p) < kx) { before = 1; }
            }
        }
        if (before == 1) { lo = mid + 1; } else { hi = mid; }
    }
    return lo;
}

# Appends order[a..b) to the list column: 1, or 0 when it can't grow (unchanged). The capacity at least doubles, as
# `extend_from_slice`'s does.
#must_use
fn _pv_nb_append(c: *PvColumn, order, a, b): i64 {
    var need = c.len + (b - a);
    if (need > c.cap) {
        var want = c.cap * 2;
        if (want < need) { want = need; }
        if (want < 8) { want = 8; }
        if (c.reserve(want) == 0) { return 0; }
    }
    var dst = c.data + c.len * 8;
    for (var r = a; r < b; r = r + 1) {
        store64(dst, load64(order + r * 8));
        dst = dst + 8;
    }
    c.len = need;
    return 1;
}

# Sorts the n particles at ps into the grid's cells at cell size h (finite and > 0, with 1/h finite): the cell size
# is h and every point is keyed by fl(1/h); the cells are the runs of equal keys in (z, y, x) order, each run's
# points in index order. 1, or 0 when a column can't grow (the grid is then empty). The lists and `xorder` are left
# to the caller.
#must_use
fn _pv_nb_cells(g: *PvNeighborGrid, ps: *PvFluidParticle, n, h: f64): i64 {
    var one: f64 = 1.0;
    var inv: f64 = one / h;
    g.cell_size = h;
    g.inv_cell = inv;
    g.len = 0;
    g.cells = 0;
    var ckey: *PvColumn = _pv_nb_col(g, 0);
    var cord: *PvColumn = _pv_nb_col(g, 1);
    var ctmp: *PvColumn = _pv_nb_col(g, 2);
    var ccs: *PvColumn = _pv_nb_col(g, 3);
    var cck: *PvColumn = _pv_nb_col(g, 6);
    var ok = ckey.resize(3 * n, 0) & cord.resize(n, 0) & ctmp.resize(n, 0) & ccs.resize(n + 1, 0);
    ok = ok & cck.resize(3 * n, 0);
    if (ok == 0) { return 0; }
    var keys = ckey.data;
    var order = cord.data;
    # Each point's key.
    for (var i = 0; i < n; i = i + 1) {
        var p: *PvFluidParticle = ps + i;
        store64(keys + i * 24, _pv_nb_key(p.position.x, inv));
        store64(keys + i * 24 + 8, _pv_nb_key(p.position.y, inv));
        store64(keys + i * 24 + 16, _pv_nb_key(p.position.z, inv));
        store64(order + i * 8, i);
    }
    _pv_msort(order, n, ctmp.data, &_pv_nb_cmp, keys);
    # The cells: each run of equal keys in sorted order, its start and its key.
    var cst = ccs.data;
    var ck = cck.data;
    var cells = 0;
    for (var j = 0; j < n; j = j + 1) {
        var starts = 1;
        if (j > 0) {
            if (_pv_nb_cmp(keys, load64(order + (j - 1) * 8), load64(order + j * 8)) == 0) { starts = 0; }
        }
        if (starts == 1) {
            var src = keys + load64(order + j * 8) * 24;
            store64(cst + cells * 8, j);
            store64(ck + cells * 24, load64(src));
            store64(ck + cells * 24 + 8, load64(src + 8));
            store64(ck + cells * 24 + 16, load64(src + 16));
            cells = cells + 1;
        }
    }
    store64(cst + cells * 8, n);
    g.cells = cells;
    g.len = n;
    return 1;
}

# Rebuilds the grid from the n particles at ps and makes their neighbour lists at smoothing radius h (finite and > 0,
# with 1/h finite: the steps check h as f32), as `SphSolver::build_neighbors` does with f64 keys (ADR 0002 #2):
# - the cell size is h and every point is keyed by fl(1/h), each build (Rust keeps its old f32 grid when h as f32 is
#   within f32::EPSILON of it, while keying the probes by the new h: the two sizes no longer differ);
# - each particle's list is the 27 cells around its own key (c − 1, c, c + 1 per axis, z outermost, then y, then x),
#   each cell's points in index order; an offset past i64's range (a saturated key) has no cell.
# 1, or 0 when a column can't grow (the lists are then unusable; Rust aborts). Mirrors `build_neighbors`.
#must_use
fn _pv_nb_build(g: *PvNeighborGrid, ps: *PvFluidParticle, n, h: f64): i64 {
    var cxo: *PvColumn = _pv_nb_col(g, 7);
    cxo.truncate(0);
    if (_pv_nb_cells(g, ps, n, h) == 0) { return 0; }
    var coff: *PvColumn = _pv_nb_col(g, 4);
    var cidx: *PvColumn = _pv_nb_col(g, 5);
    if (coff.resize(n + 1, 0) == 0) { return 0; }
    var keys = g.keys.data;
    var order = g.order.data;
    var cst = g.cstart.data;
    var ck = g.ckeys.data;
    var cells = g.cells;
    # The lists: for each (dz, dy) row, the first cell at or after x key c − 1 by a binary search, then the row's
    # cells up to c + 1 in x order, which is dx's.
    cidx.truncate(0);
    var off = coff.data;
    store64(off, 0);
    var kmax = 9223372036854775807;
    var kmin = 0 - 9223372036854775807 - 1;
    for (var q = 0; q < n; q = q + 1) {
        var cx = load64(keys + q * 24);
        var cy = load64(keys + q * 24 + 8);
        var cz = load64(keys + q * 24 + 16);
        var xlo = cx - 1;
        if (cx == kmin) { xlo = cx; }
        var xhi = cx + 1;
        if (cx == kmax) { xhi = cx; }
        for (var dz = 0 - 1; dz <= 1; dz = dz + 1) {
            var zin = 1;
            if ((dz == 1 && cz == kmax) || (dz == 0 - 1 && cz == kmin)) { zin = 0; }
            for (var dy = 0 - 1; zin == 1 && dy <= 1; dy = dy + 1) {
                var yin = 1;
                if ((dy == 1 && cy == kmax) || (dy == 0 - 1 && cy == kmin)) { yin = 0; }
                if (yin == 1) {
                    var kz = cz + dz;
                    var ky = cy + dy;
                    var c = _pv_nb_lower(ck, 0, cells, xlo, ky, kz);
                    var more = 1;
                    while (more == 1 && c < cells) {
                        var at = ck + c * 24;
                        if (load64(at + 16) == kz && load64(at + 8) == ky && load64(at) <= xhi) {
                            if (_pv_nb_append(cidx, order, load64(cst + c * 8), load64(cst + (c + 1) * 8)) == 0) {
                                return 0;
                            }
                            c = c + 1;
                        } else {
                            more = 0;
                        }
                    }
                }
            }
        }
        store64(off + (q + 1) * 8, cidx.len);
    }
    return 1;
}

# ── the cells-only grid (M6 part a) ─────────────────────────────────────────────────

# The order of two cells' keys (ctx: the cell-key column's words, x, y, z a cell): comparing x, then y, then z, the
# order Rust's `query_radius` visits a block in. Distinct cells never tie.
fn _pv_nb_xcmp(ctx, a, b): i64 {
    var pa = ctx + a * 24;
    var pb = ctx + b * 24;
    for (var k = 0; k < 3; k = k + 1) {
        var ka = load64(pa + k * 8);
        var kb = load64(pb + k * 8);
        if (ka < kb) { return 0 - 1; }
        if (ka > kb) { return 1; }
    }
    return 0;
}

# The first position in xorder[lo, hi) (xo: cell indices in (x, y, z) order, ck: their keys) whose cell is not before
# (kx, ky, kz) in that order: a binary search.
#must_use
fn _pv_nb_xlower(ck, xo, lo, hi, kx, ky, kz): i64 {
    while (lo < hi) {
        var mid = (lo + hi) / 2;
        var p = ck + load64(xo + mid * 8) * 24;
        var mx = load64(p);
        var before = 0;
        if (mx < kx) {
            before = 1;
        } elif (mx == kx) {
            var my = load64(p + 8);
            if (my < ky) {
                before = 1;
            } elif (my == ky) {
                if (load64(p + 16) < kz) { before = 1; }
            }
        }
        if (before == 1) { lo = mid + 1; } else { hi = mid; }
    }
    return lo;
}

# Rebuilds *g from the n particles at ps at `cell_size`, the cells only: the Cyrius form of a hisab `SpatialHash` of
# that cell size into which particle i's position is inserted with index i, for i in 0..n, the way
# `drag_from_particles_indexed` asks its caller to build one (ADR 0002 #23). The keys are f64, floor(x · fl(1/cell))
# as a saturating i64 per axis (NaN 0), hisab 3.4.1's (ADR 0002 #2), and so is the rule for the cell size: finite
# and > 0 with 1/cell finite, as `spatial_hash_new` takes it (Rust's f32 hash refuses only cell ≤ 0). The grid then
# has no neighbour lists. Ok(0); Err(PV_ERR_INVALID_PARAMETER) for any other cell size or n < 0, and
# Err(PV_ERR_OUT_OF_MEMORY) when a column can't grow; either way *g is then empty, its columns kept.
#must_use
fn PvNeighborGrid_build(g: *PvNeighborGrid, ps: *PvFluidParticle, n, cell_size: f64): Result {
    var cxo: *PvColumn = _pv_nb_col(g, 7);
    var coff: *PvColumn = _pv_nb_col(g, 4);
    var cidx: *PvColumn = _pv_nb_col(g, 5);
    cxo.truncate(0);
    coff.truncate(0);
    cidx.truncate(0);
    g.len = 0;
    g.cells = 0;
    var one: f64 = 1.0;
    var inv: f64 = one / cell_size;
    if (n < 0 || _pv_is_positive(cell_size) == 0 || _pv_is_finite(inv) == 0) { return Err(PV_ERR_INVALID_PARAMETER); }
    if (_pv_nb_cells(g, ps, n, cell_size) == 0) { return Err(PV_ERR_OUT_OF_MEMORY); }
    var cells = g.cells;
    if (cxo.resize(cells, 0) == 0) {
        g.len = 0;
        g.cells = 0;
        return Err(PV_ERR_OUT_OF_MEMORY);
    }
    var xo = cxo.data;
    for (var c = 0; c < cells; c = c + 1) { store64(xo + c * 8, c); }
    _pv_msort(xo, cells, g.tmp.data, &_pv_nb_xcmp, g.ckeys.data);
    return Ok(0);
}

# The cell range [c − r, c + r] of one axis, saturated at i64's ends, for r >= 0.
fn _pv_nb_span(c, r) {
    var kmax = 9223372036854775807;
    var kmin = 0 - 9223372036854775807 - 1;
    var lo = kmin;
    var hi = kmax;
    if (c >= kmin + r) { lo = c - r; }
    if (c <= kmax - r) { hi = c + r; }
    return (lo, hi);
}

# Calls visit(ctx, a, b) for each occupied cell of a cells-only grid inside the block [lo, hi] (three words each,
# x, y, z; lo <= hi on every axis), in (x, y, z) order, with order[a, b) the cell's points in index order: the cells
# hisab 1.4.0's `query_radius` walks, in its (dx, dy, dz) order, each cell's items in insertion order. A search
# skips the block's empty rows, so the walk costs the occupied cells, not the block's volume. A grid whose `xorder`
# doesn't cover its cells (a solver's) visits nothing.
fn _pv_nb_block(g: *PvNeighborGrid, lo, hi, visit, ctx) {
    var cells = g.cells;
    if (g.xorder.len != cells) { return 0; }
    var ck = g.ckeys.data;
    var xo = g.xorder.data;
    var cst = g.cstart.data;
    var xlo = load64(lo);
    var ylo = load64(lo + 8);
    var zlo = load64(lo + 16);
    var xhi = load64(hi);
    var yhi = load64(hi + 8);
    var zhi = load64(hi + 16);
    var kmax = 9223372036854775807;
    var j = _pv_nb_xlower(ck, xo, 0, cells, xlo, ylo, zlo);
    while (j < cells) {
        var c = load64(xo + j * 8);
        var p = ck + c * 24;
        var cx = load64(p);
        var cy = load64(p + 8);
        var cz = load64(p + 16);
        if (cx > xhi) { return 0; }
        if (cy < ylo) {
            j = _pv_nb_xlower(ck, xo, j, cells, cx, ylo, zlo);
        } elif (cy > yhi) {
            if (cx == kmax) { return 0; }
            j = _pv_nb_xlower(ck, xo, j, cells, cx + 1, ylo, zlo);
        } elif (cz < zlo) {
            j = _pv_nb_xlower(ck, xo, j, cells, cx, cy, zlo);
        } elif (cz > zhi) {
            if (cy == kmax) {
                if (cx == kmax) { return 0; }
                j = _pv_nb_xlower(ck, xo, j, cells, cx + 1, ylo, zlo);
            } else {
                j = _pv_nb_xlower(ck, xo, j, cells, cx, cy + 1, zlo);
            }
        } else {
            fncall3(visit, ctx, load64(cst + c * 8), load64(cst + (c + 1) * 8));
            j = j + 1;
        }
    }
    return 0;
}

# ── the z-order sort ────────────────────────────────────────────────────────────────

# x's 32 bits spread to the even bits of a word (a zero between each). Mirrors the private `spread_bits`.
#must_use
fn _pv_spread_bits(x): i64 {
    var v = x & 0xFFFFFFFF;
    v = (v | (v << 16)) & 0x0000FFFF0000FFFF;
    v = (v | (v << 8)) & 0x00FF00FF00FF00FF;
    v = (v | (v << 4)) & 0x0F0F0F0F0F0F0F0F;
    v = (v | (v << 2)) & 0x3333333333333333;
    v = (v | (v << 1)) & 0x5555555555555555;
    return v;
}

# The 2D Morton code of (x, y) at 1/cell inv_cell: each axis max(·inv_cell, 0) as u32 (saturating, NaN 0), spread,
# y's bits above x's. A u64 as a word. Mirrors the private `morton_code_2d`.
#must_use
fn _pv_morton_2d(x: f64, y: f64, inv_cell: f64): i64 {
    var zero: f64 = 0.0;
    var ax: f64 = x * inv_cell;
    var ay: f64 = y * inv_cell;
    var mx: f64 = _pv_max(ax, zero);
    var my: f64 = _pv_max(ay, zero);
    var ix = _pv_as_u32(mx);
    var iy = _pv_as_u32(my);
    return _pv_spread_bits(ix) | (_pv_spread_bits(iy) << 1);
}

# The order of two points' Morton codes (ctx: the code words), compared as u64.
fn _pv_zorder_cmp(ctx, a, b): i64 {
    var ka = load64(ctx + a * 8) ^ 0x8000000000000000;
    var kb = load64(ctx + b * 8) ^ 0x8000000000000000;
    if (ka < kb) { return 0 - 1; }
    if (ka > kb) { return 1; }
    return 0;
}

# Sorts the n particles at ps by the 2D Morton code of (x − min x, y − min y) at 1/cell_size, the minima folded from
# f64::MAX with Rust's NaN-ignoring min. Ties keep their input order: Rust's `sort_unstable_by_key` leaves them in
# an order its algorithm picks, which the port doesn't copy (ADR 0002 #3, port-parity §4.5). The codes are made once
# and the sorted order applied in place, a cycle at a time, each record moved by assignment (a word-wise copy; `memcpy`
# goes byte by byte). 1, or 0 with nothing changed for fewer than 2 particles or a cell size not finite and > 0 (Rust
# returns), or when the scratch can't be allocated (Rust aborts). Mirrors `sort_by_zorder`.
fn sort_by_zorder(ps: *PvFluidParticle, n, cell_size: f64): i64 {
    var trace = _pv_span(_PV_LOG_SPH, "sph::sort_by_zorder", "n", n, 0, 0, 0, 0);
    if (n < 2 || _pv_is_positive(cell_size) == 0) { _pv_span_end(trace); return 0; }
    var inv: f64 = 1.0 / cell_size;
    var mnx: f64 = PV_F64_MAX;
    var mny: f64 = PV_F64_MAX;
    for (var i = 0; i < n; i = i + 1) {
        var p: *PvFluidParticle = ps + i;
        mnx = _pv_min(mnx, p.position.x);
        mny = _pv_min(mny, p.position.y);
    }
    # One block: the codes, the order, the sort's scratch.
    var keys = fl_alloc(n * 24);
    if (keys == 0) { _pv_span_end(trace); return 0; }
    var order = keys + n * 8;
    var tmp = keys + n * 16;
    for (var j = 0; j < n; j = j + 1) {
        var q: *PvFluidParticle = ps + j;
        var dx: f64 = q.position.x - mnx;
        var dy: f64 = q.position.y - mny;
        store64(keys + j * 8, _pv_morton_2d(dx, dy, inv));
        store64(order + j * 8, j);
    }
    _pv_msort(order, n, tmp, &_pv_zorder_cmp, keys);
    # Slot k takes the particle at order[k]: follow each cycle from its first slot, marking each slot done (order[k]
    # = k) as it's filled.
    var held: PvFluidParticle;
    for (var s = 0; s < n; s = s + 1) {
        if (load64(order + s * 8) != s) {
            var first: *PvFluidParticle = ps + s;
            held = *first;
            var k = s;
            var from = load64(order + k * 8);
            while (from != s) {
                var dst: *PvFluidParticle = ps + k;
                var src: *PvFluidParticle = ps + from;
                *dst = *src;
                store64(order + k * 8, k);
                k = from;
                from = load64(order + k * 8);
            }
            var last: *PvFluidParticle = ps + k;
            *last = held;
            store64(order + k * 8, k);
        }
    }
    fl_free(keys);
    _pv_span_end(trace); return 1;
}

# --- sph_fns.cyr ---

# sph_fns.cyr — the SPH free functions of rust-old/src/sph.rs (M4 parts c and d).
#
# Part c: the brute-force O(n²) density and forces, the free step (`sph_step`: Rust's `step`, renamed because one
# namespace serves pravash and its consumers, ADR 0002 #17), the particle block, and adaptive splitting and
# merging. Every formula is Rust's, in its operation order. The pair loops write the particle distance out (glam's
# ((dx² + dy²) + dz²) with d = xᵢ − xⱼ, as `distance_squared_to`): the same bits without a call per pair.
#
# `step` keeps Rust's two per-call buffers (the densities, the snapshot the forces read) as one freelist block,
# freed before it returns: the heap is flat across steps (port plan §7.5).
#
# UPSTREAM(L7): ganita:docs/development/issues/2026-11-11-mat-inv-allocates-per-call.md
#   `_pv_invert_3x3`, the MLS 3×3 inverse: an allocation-free transcription of the oracle's (hisab 1.4.0
#   `matrix_inverse`); replace it with ganita's `mat_inv_into` once it ships with hisab's absolute 1e-12 pivot test
#   and non-finite behaviour, or as an ADR divergence; parity: the `oracle::invert_3x3` and MLS rows (class B).

# ── density and the forces (brute force) ────────────────────────────────────────────

# Σ m_j·poly6(r²) over the n particles at ps within h of *pi (r² ≤ h², *pi itself included), from +0, at the
# coefficients kc. Mirrors the private `compute_density_inner`.
#must_use
fn _pv_density_sum(pi: *PvFluidParticle, ps: *PvFluidParticle, n, kc: *_PvKernelCoeffs): f64 {
    var px: f64 = pi.position.x;
    var py: f64 = pi.position.y;
    var pz: f64 = pi.position.z;
    var h2: f64 = kc.h2;
    var density: f64 = 0.0;
    for (var j = 0; j < n; j = j + 1) {
        var pj: *PvFluidParticle = ps + j;
        var dx: f64 = px - pj.position.x;
        var dy: f64 = py - pj.position.y;
        var dz: f64 = pz - pj.position.z;
        var r2: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
        if (r2 <= h2) {
            var w: f64 = _pv_kc_poly6(kc, r2);
            var mw: f64 = pj.mass * w;
            density = density + mw;
        }
    }
    return density;
}

# The density of particle idx of the n at ps, by brute force over all n at smoothing radius h. NaN for idx outside
# [0, n) (Rust panics; ADR 0002 #8). Mirrors `compute_density`.
#must_use
fn compute_density(idx, ps: *PvFluidParticle, n, h: f64): f64 {
    if (idx < 0 || idx >= n) {
        var nan: f64 = PV_F64_NAN;
        return nan;
    }
    var kc: _PvKernelCoeffs;
    _pv_kc_init(&kc, h);
    var d: f64 = _pv_density_sum(ps + idx, ps, n, &kc);
    return d;
}

# The symmetric, momentum-conserving pressure force on particle idx of the n at ps, by brute force:
# Σⱼ (((−mᵢ·mⱼ)·(pᵢ/ρᵢ² + pⱼ/ρⱼ²))·∇W(r))/r · (xᵢ − xⱼ), over j ≠ idx with 1e-20 ≤ r² ≤ h², each ρ floored at
# 1e-10 (NaN-ignoring), from +0. (NaN, NaN, NaN) for idx outside [0, n) (Rust panics). Mirrors `pressure_force`
# (its [f64; 3] as a PvVec3, ADR 0002 #17).
#must_use
fn pressure_force(idx, ps: *PvFluidParticle, n, h: f64): PvVec3 {
    var trace = _pv_span(_PV_LOG_SPH, "sph::pressure_force", "n", n, 0, 0, 0, 0);
    if (idx < 0 || idx >= n) {
        var nan: f64 = PV_F64_NAN;
        _pv_span_end(trace); return PvVec3_new(nan, nan, nan);
    }
    var kc: _PvKernelCoeffs;
    _pv_kc_init(&kc, h);
    var h2: f64 = kc.h2;
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var lo: f64 = _PV_SPH_MIN_DENSITY;
    var pi: *PvFluidParticle = ps + idx;
    var px: f64 = pi.position.x;
    var py: f64 = pi.position.y;
    var pz: f64 = pi.position.z;
    var rho_i: f64 = _pv_max(pi.density, lo);
    var a: f64 = pi.pressure / (rho_i * rho_i);
    var mi: f64 = pi.mass;
    var nmi: f64 = -mi;
    var fx: f64 = 0.0;
    var fy: f64 = 0.0;
    var fz: f64 = 0.0;
    for (var j = 0; j < n; j = j + 1) {
        if (j != idx) {
            var pj: *PvFluidParticle = ps + j;
            var dx: f64 = px - pj.position.x;
            var dy: f64 = py - pj.position.y;
            var dz: f64 = pz - pj.position.z;
            var r2: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
            if ((r2 > h2 || r2 < tiny) == 0) {
                var r: f64 = f64_sqrt(r2);
                var rho_j: f64 = _pv_max(pj.density, lo);
                var b: f64 = pj.pressure / (rho_j * rho_j);
                var sym: f64 = a + b;
                var grad: f64 = _pv_kc_spiky_grad(&kc, r);
                var scale: f64 = (((nmi * pj.mass) * sym) * grad) / r;
                fx = fx + (scale * dx);
                fy = fy + (scale * dy);
                fz = fz + (scale * dz);
            }
        }
    }
    _pv_span_end(trace); return PvVec3_new(fx, fy, fz);
}

# The viscosity force on particle idx of the n at ps, by brute force: Σⱼ ((μ·mⱼ)·∇²W(r))/ρⱼ · (vⱼ − vᵢ), over j ≠ idx
# with 1e-20 ≤ r² ≤ h², ρⱼ floored at 1e-10, from +0. (NaN, NaN, NaN) for idx outside [0, n). Mirrors
# `viscosity_force`.
#must_use
fn viscosity_force(idx, ps: *PvFluidParticle, n, h: f64, viscosity: f64): PvVec3 {
    var trace = _pv_span(_PV_LOG_SPH, "sph::viscosity_force", "n", n, 0, 0, 0, 0);
    if (idx < 0 || idx >= n) {
        var nan: f64 = PV_F64_NAN;
        _pv_span_end(trace); return PvVec3_new(nan, nan, nan);
    }
    var kc: _PvKernelCoeffs;
    _pv_kc_init(&kc, h);
    var h2: f64 = kc.h2;
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var lo: f64 = _PV_SPH_MIN_DENSITY;
    var pi: *PvFluidParticle = ps + idx;
    var px: f64 = pi.position.x;
    var py: f64 = pi.position.y;
    var pz: f64 = pi.position.z;
    var vx: f64 = pi.velocity.x;
    var vy: f64 = pi.velocity.y;
    var vz: f64 = pi.velocity.z;
    var fx: f64 = 0.0;
    var fy: f64 = 0.0;
    var fz: f64 = 0.0;
    for (var j = 0; j < n; j = j + 1) {
        if (j != idx) {
            var pj: *PvFluidParticle = ps + j;
            var dx: f64 = px - pj.position.x;
            var dy: f64 = py - pj.position.y;
            var dz: f64 = pz - pj.position.z;
            var r2: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
            if ((r2 > h2 || r2 < tiny) == 0) {
                var r: f64 = f64_sqrt(r2);
                var lap: f64 = _pv_kc_visc_lap(&kc, r);
                var rho_j: f64 = _pv_max(pj.density, lo);
                var scale: f64 = ((viscosity * pj.mass) * lap) / rho_j;
                var ux: f64 = pj.velocity.x - vx;
                var uy: f64 = pj.velocity.y - vy;
                var uz: f64 = pj.velocity.z - vz;
                fx = fx + (scale * ux);
                fy = fy + (scale * uy);
                fz = fz + (scale * uz);
            }
        }
    }
    _pv_span_end(trace); return PvVec3_new(fx, fy, fz);
}

# ── the free step ───────────────────────────────────────────────────────────────────

# One SPH step of the n particles at ps by brute force (O(n²)), in Rust's order:
# - the config is validated (its error returned, nothing changed);
# - every density by `compute_density`'s sum, then each pressure by the linear equation of state;
# - from a snapshot of that state, each acceleration: gravity, plus over j ≠ i with 1e-20 ≤ r² ≤ h² the symmetric
#   pressure term ((−mⱼ·(pᵢ/ρᵢ² + pⱼ/ρⱼ²))·∇W)/r·(xᵢ − xⱼ) and the viscosity term (((μ·mⱼ)·∇²W)/ρⱼ)/ρᵢ·(vⱼ − vᵢ);
# - symplectic Euler, v += a·dt then x += v·dt;
# - the walls, axis by axis: below the low corner, the position clamped to it and the velocity times −damping; else
#   above the high corner (when it is above the low one), the same at the high corner.
# Ok(0); or the config's Err; PV_ERR_OUT_OF_MEMORY when the scratch can't be allocated, before anything changes (Rust
# aborts); or PV_ERR_DIVERGED at the first particle whose acceleration is not finite, which leaves the densities and
# pressures set and the accelerations before it written, as Rust does. Mirrors `step` (ADR 0002 #17).
#must_use
fn sph_step(ps: *PvFluidParticle, n, config: *PvFluidConfig, viscosity: f64): Result {
    var trace = _pv_span(_PV_LOG_SPH, "sph::step", "n", n, 0, 0, 0, 0);
    var ct, cv = config.validate();
    if (is_err_result(ct) == 1) { _pv_span_end(trace); return Err(cv); }
    if (n <= 0) { _pv_span_end(trace); return Ok(0); }
    var sz = sizeof(PvFluidParticle);
    if (n > 9223372036854775807 / (sz + 8)) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
    var block = fl_alloc(n * (sz + 8));
    if (block == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
    var dens = block;
    var snap: *PvFluidParticle = _pv_as_particles(block + n * 8);
    var h: f64 = config.smoothing_radius;
    var kc: _PvKernelCoeffs;
    _pv_kc_init(&kc, h);

    # The densities, then the pressures.
    var td = _pv_span(_PV_LOG_SPH, "sph::density", "n", n, 0, 0, 0, 0);
    for (var i = 0; i < n; i = i + 1) {
        var d: f64 = _pv_density_sum(ps + i, ps, n, &kc);
        store64(dens + i * 8, _pv_bits(d));
    }
    var rest: f64 = config.rest_density;
    var gas: f64 = config.gas_constant;
    for (var i2 = 0; i2 < n; i2 = i2 + 1) {
        var p: *PvFluidParticle = ps + i2;
        p.density = load64(dens + i2 * 8);
        var pr: f64 = equation_of_state(p.density, rest, gas);
        p.pressure = pr;
        var s: *PvFluidParticle = snap + i2;
        *s = *p;
    }

    _pv_span_end(td);

    # The accelerations, from the snapshot.
    var tf = _pv_span(_PV_LOG_SPH, "sph::forces", "n", n, 0, 0, 0, 0);
    var h2: f64 = kc.h2;
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var lo: f64 = _PV_SPH_MIN_DENSITY;
    for (var a = 0; a < n; a = a + 1) {
        var pi: *PvFluidParticle = snap + a;
        var ax: f64 = config.gravity.x;
        var ay: f64 = config.gravity.y;
        var az: f64 = config.gravity.z;
        var rho: f64 = _pv_max(pi.density, lo);
        var api: f64 = pi.pressure / (rho * rho);
        var px: f64 = pi.position.x;
        var py: f64 = pi.position.y;
        var pz: f64 = pi.position.z;
        var vx: f64 = pi.velocity.x;
        var vy: f64 = pi.velocity.y;
        var vz: f64 = pi.velocity.z;
        for (var j = 0; j < n; j = j + 1) {
            if (j != a) {
                var pj: *PvFluidParticle = snap + j;
                var dx: f64 = px - pj.position.x;
                var dy: f64 = py - pj.position.y;
                var dz: f64 = pz - pj.position.z;
                var r2: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
                if ((r2 > h2 || r2 < tiny) == 0) {
                    var r: f64 = f64_sqrt(r2);
                    var rho_j: f64 = _pv_max(pj.density, lo);
                    var b: f64 = pj.pressure / (rho_j * rho_j);
                    var sym: f64 = api + b;
                    var grad: f64 = _pv_kc_spiky_grad(&kc, r);
                    var mj: f64 = pj.mass;
                    var nmj: f64 = -mj;
                    var p_scale: f64 = ((nmj * sym) * grad) / r;
                    ax = ax + (p_scale * dx);
                    ay = ay + (p_scale * dy);
                    az = az + (p_scale * dz);
                    var lap: f64 = _pv_kc_visc_lap(&kc, r);
                    var v_scale: f64 = (((viscosity * mj) * lap) / rho_j) / rho;
                    var ux: f64 = pj.velocity.x - vx;
                    var uy: f64 = pj.velocity.y - vy;
                    var uz: f64 = pj.velocity.z - vz;
                    ax = ax + (v_scale * ux);
                    ay = ay + (v_scale * uy);
                    az = az + (v_scale * uz);
                }
            }
        }
        if (_pv_is_finite(ax) == 0 || _pv_is_finite(ay) == 0 || _pv_is_finite(az) == 0) {
            fl_free(block);
            _pv_span_end(tf);
            _pv_span_end(trace); return Err(PV_ERR_DIVERGED);
        }
        var out: *PvFluidParticle = ps + a;
        out.acceleration = PvVec3_new(ax, ay, az);
    }
    _pv_span_end(tf);
    fl_free(block);

    # Symplectic Euler, then the walls.
    var dt: f64 = config.dt;
    for (var k = 0; k < n; k = k + 1) {
        var q: *PvFluidParticle = ps + k;
        var nvx: f64 = q.velocity.x + (q.acceleration.x * dt);
        var nvy: f64 = q.velocity.y + (q.acceleration.y * dt);
        var nvz: f64 = q.velocity.z + (q.acceleration.z * dt);
        q.velocity = PvVec3_new(nvx, nvy, nvz);
        var nx: f64 = q.position.x + (nvx * dt);
        var ny: f64 = q.position.y + (nvy * dt);
        var nz: f64 = q.position.z + (nvz * dt);
        q.position = PvVec3_new(nx, ny, nz);
    }
    var damp: f64 = config.boundary_damping;
    var nd: f64 = -damp;
    var lx: f64 = config.bounds_min.x;
    var ly: f64 = config.bounds_min.y;
    var lz: f64 = config.bounds_min.z;
    var hx: f64 = config.bounds_max.x;
    var hy: f64 = config.bounds_max.y;
    var hz: f64 = config.bounds_max.z;
    for (var m = 0; m < n; m = m + 1) {
        var w: *PvFluidParticle = ps + m;
        var wx: f64 = w.position.x;
        var wy: f64 = w.position.y;
        var wz: f64 = w.position.z;
        var ux: f64 = w.velocity.x;
        var uy: f64 = w.velocity.y;
        var uz: f64 = w.velocity.z;
        if (wx < lx) {
            wx = lx;
            ux = ux * nd;
        } elif (wx > hx && hx > lx) {
            wx = hx;
            ux = ux * nd;
        }
        if (wy < ly) {
            wy = ly;
            uy = uy * nd;
        } elif (wy > hy && hy > ly) {
            wy = hy;
            uy = uy * nd;
        }
        if (wz < lz) {
            wz = lz;
            uz = uz * nd;
        } elif (wz > hz && hz > lz) {
            wz = hz;
            uz = uz * nd;
        }
        w.position = PvVec3_new(wx, wy, wz);
        w.velocity = PvVec3_new(ux, uy, uz);
    }
    _pv_span_end(trace); return Ok(0);
}

# ── splitting and merging ───────────────────────────────────────────────────────────

# n_children copies of *parent with its mass split evenly (m/n), on a ring of radius `offset` about it in the xy
# plane: child k at angle ((2π)·k)/n, moved by (offset·cos θ, offset·sin θ) (correctly rounded, ADR 0004). One child
# is the parent unchanged; none is (0, 0). A new freelist buffer: (pointer, n_children), which the caller releases
# with `fl_free`; (0, 0) for n_children ≤ 0 or no memory (Rust aborts). Mirrors `split_particle` (ADR 0002 #9).
#must_use
fn split_particle(parent: *PvFluidParticle, n_children, offset: f64) {
    var trace = _pv_span(_PV_LOG_SPH, "sph::split_particle", 0, 0, 0, 0, 0, 0);
    if (n_children <= 0) { _pv_span_end(trace); return (0, 0); }
    var sz = sizeof(PvFluidParticle);
    if (n_children > 9223372036854775807 / sz) { _pv_span_end(trace); return (0, 0); }
    var buf = fl_alloc(n_children * sz);
    if (buf == 0) { _pv_span_end(trace); return (0, 0); }
    var out: *PvFluidParticle = _pv_as_particles(buf);
    if (n_children == 1) {
        *out = *parent;
        _pv_span_end(trace); return (buf, 1);
    }
    var nf: f64 = f64_from(n_children);
    var child_mass: f64 = parent.mass / nf;
    var two_pi: f64 = 2.0 * PV_F64_PI;
    for (var k = 0; k < n_children; k = k + 1) {
        var kf: f64 = f64_from(k);
        var angle: f64 = (two_pi * kf) / nf;
        var c: f64 = _pv_cos(angle);
        var s: f64 = _pv_sin(angle);
        var ch: *PvFluidParticle = out + k;
        *ch = *parent;
        ch.mass = child_mass;
        var x: f64 = ch.position.x + (offset * c);
        var y: f64 = ch.position.y + (offset * s);
        ch.position = PvVec3_new(x, y, ch.position.z);
    }
    _pv_span_end(trace); return (buf, n_children);
}

# One particle from two, conserving mass and momentum: the mass a.m + b.m; position, velocity, density, pressure,
# temperature and fuel mass-weighted, (q_a·m_a + q_b·m_b)·(1/max(m, 1e-20)) (a NaN total gives 1e20), written out
# per component; no acceleration; a's phase and conformation. Mirrors `merge_particles`.
#must_use
fn merge_particles(a: *PvFluidParticle, b: *PvFluidParticle): PvFluidParticle {
    var trace = _pv_span(_PV_LOG_SPH, "sph::merge_particles", 0, 0, 0, 0, 0, 0);
    var ma: f64 = a.mass;
    var mb: f64 = b.mass;
    var total: f64 = ma + mb;
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var floor: f64 = _pv_max(total, tiny);
    var inv: f64 = 1.0 / floor;
    var p: PvFluidParticle = *a;
    var px: f64 = ((a.position.x * ma) + (b.position.x * mb)) * inv;
    var py: f64 = ((a.position.y * ma) + (b.position.y * mb)) * inv;
    var pz: f64 = ((a.position.z * ma) + (b.position.z * mb)) * inv;
    var vx: f64 = ((a.velocity.x * ma) + (b.velocity.x * mb)) * inv;
    var vy: f64 = ((a.velocity.y * ma) + (b.velocity.y * mb)) * inv;
    var vz: f64 = ((a.velocity.z * ma) + (b.velocity.z * mb)) * inv;
    p.position = PvVec3_new(px, py, pz);
    p.velocity = PvVec3_new(vx, vy, vz);
    p.acceleration = PvVec3_zero();
    var d: f64 = ((a.density * ma) + (b.density * mb)) * inv;
    var pr: f64 = ((a.pressure * ma) + (b.pressure * mb)) * inv;
    var t: f64 = ((a.temperature * ma) + (b.temperature * mb)) * inv;
    var fu: f64 = ((a.fuel * ma) + (b.fuel * mb)) * inv;
    p.density = d;
    p.pressure = pr;
    p.mass = total;
    p.temperature = t;
    p.fuel = fu;
    _pv_span_end(trace); return p;
}

# ── the particle block ──────────────────────────────────────────────────────────────

# A 2D block of particles of mass `mass` on a grid of spacing `spacing` from (ox, oy): ⌈sx/spacing⌉ × ⌈sy/spacing⌉
# of them (each count `as usize`, saturating), row by row from the origin, at (ox + ix·spacing, oy + iy·spacing).
# A new freelist buffer: (pointer, count), which the caller releases with `fl_free`; (0, 0) for a spacing not finite
# and > 0, a size not finite, a count of 0, a count whose product or byte size overflows (Rust's `checked_mul`
# returns empty for the product; the byte size aborts), or no memory (Rust aborts). Mirrors `create_particle_block`,
# its `[f64; 2]` origin and size as two arguments each (ADR 0002 #17).
#must_use
fn create_particle_block(ox: f64, oy: f64, sx: f64, sy: f64, spacing: f64, mass: f64) {
    if (_pv_is_positive(spacing) == 0 || _pv_is_finite(sx) == 0 || _pv_is_finite(sy) == 0) { return (0, 0); }
    var qx: f64 = sx / spacing;
    var qy: f64 = sy / spacing;
    var cx: f64 = f64_ceil(qx);
    var cy: f64 = f64_ceil(qy);
    var nx = _pv_as_usize(cx);
    var ny = _pv_as_usize(cy);
    # A count at or above 2^63 reads negative: no block that size is allocatable.
    if (nx <= 0 || ny <= 0) { return (0, 0); }
    var sz = sizeof(PvFluidParticle);
    if (nx > 9223372036854775807 / ny) { return (0, 0); }
    var count = nx * ny;
    if (count > 9223372036854775807 / sz) { return (0, 0); }
    var buf = fl_alloc(count * sz);
    if (buf == 0) { return (0, 0); }
    var out: *PvFluidParticle = _pv_as_particles(buf);
    # `FluidParticle::new_2d(x, y, m)` differs from new_2d(0, 0, m) only in its position: one record built, then
    # copied whole and placed (a struct copy is word-wise, as `_pv_particles_reset`'s).
    var tmpl: PvFluidParticle = PvFluidParticle_new_2d(0.0, 0.0, mass);
    var k = 0;
    for (var iy = 0; iy < ny; iy = iy + 1) {
        var fy: f64 = f64_from(iy);
        var y: f64 = oy + (fy * spacing);
        for (var ix = 0; ix < nx; ix = ix + 1) {
            var fxx: f64 = f64_from(ix);
            var x: f64 = ox + (fxx * spacing);
            var q: *PvFluidParticle = out + k;
            *q = tmpl;
            q.position = PvVec3_new(x, y, 0.0);
            k = k + 1;
        }
    }
    return (buf, count);
}

# ── part d: the caller-supplied neighbour lists ─────────────────────────────────────

# 1 when CSR lists fit n particles, as Rust's private `neighbor_lists_valid` checks: n + 1 offsets, never
# decreasing, the last within the indices, and every index in [0, n). The lists are 8-byte words (Rust's `u32`
# offsets and `usize` indices), so an offset outside [0, 2³²) or an index read as unsigned at n or more is invalid,
# values Rust's types can't hold or that index past n. Invalid lists emit Rust's WARN event (its `n`, and the two
# lists' lengths).
#must_use
fn _pv_lists_valid(offsets, n_off, indices, n_idx, n): i64 {
    if (_pv_lists_ok(offsets, n_off, indices, n_idx, n) == 1) { return 1; }
    _pv_warn(_PV_LOG_SPH, "invalid neighbor lists ignored (expected offsets.len() == n + 1, indices < n)", "n", n,
      "offsets", n_off, "indices", n_idx);
    return 0;
}

# The check itself, without the warning.
#must_use
fn _pv_lists_ok(offsets, n_off, indices, n_idx, n): i64 {
    if (n_off != n + 1 || n_idx < 0) { return 0; }
    var prev = load64(offsets);
    if (prev < 0) { return 0; }
    for (var k = 1; k < n_off; k = k + 1) {
        var o = load64(offsets + k * 8);
        if (o < prev) { return 0; }
        prev = o;
    }
    if (prev > 4294967295 || prev > n_idx) { return 0; }
    for (var j = 0; j < n_idx; j = j + 1) {
        var x = load64(indices + j * 8);
        if (x < 0 || x >= n) { return 0; }
    }
    return 1;
}

# ── part d: viscoelasticity (Oldroyd-B) ─────────────────────────────────────────────

# Viscoelastic fluid properties: the elastic modulus G (Pa) and the relaxation time λ (s). Mirrors
# `ViscoelasticConfig`.
struct PvViscoelasticConfig {
    elastic_modulus: f64;
    relaxation_time: f64;
}

# A viscoelastic config. Mirrors `ViscoelasticConfig::new`.
#must_use
fn PvViscoelasticConfig_new(elastic_modulus: f64, relaxation_time: f64): PvViscoelasticConfig {
    var c: PvViscoelasticConfig;
    c.elastic_modulus = elastic_modulus;
    c.relaxation_time = relaxation_time;
    return c;
}

# Evolves each particle's conformation tensor (upper-convected Oldroyd-B, in the xy plane) and adds the elastic
# stress divergence to its x and y acceleration, from a snapshot of the n particles, over the CSR lists at smoothing
# radius h (pairs with 1e-20 ≤ r² ≤ h², j ≠ i), with 1/λ = 1/max(λ, 1e-20):
# - ∇u from Σ ((mⱼ/ρⱼ)·∇W)/r · (vⱼ − vᵢ) ⊗ (xᵢ − xⱼ);
# - dC = L·C + C·Lᵀ − (C − I)/λ, C += dC·dt;
# - a += Σ ((G·(ΔC·d))·scale)/ρᵢ with the snapshot's C.
# 1, or 0 with nothing changed for invalid lists or no memory for the snapshot (Rust warns or aborts); n = 0 does
# nothing (1). Mirrors `update_viscoelastic` (ADR 0002 #18).
#must_use
fn update_viscoelastic(ps: *PvFluidParticle, n, offsets, n_off, indices, n_idx, h: f64, ve: *PvViscoelasticConfig,
  dt: f64): i64 {
    var trace = _pv_span(_PV_LOG_SPH, "sph::viscoelastic", "n", n, 0, 0, 0, 0);
    if (n <= 0) { _pv_span_end(trace); return 1; }
    if (_pv_lists_valid(offsets, n_off, indices, n_idx, n) == 0) { _pv_span_end(trace); return 0; }
    var sz = sizeof(PvFluidParticle);
    if (n > 9223372036854775807 / sz) { _pv_span_end(trace); return 0; }
    var buf = fl_alloc(n * sz);
    if (buf == 0) { _pv_span_end(trace); return 0; }
    var snap: *PvFluidParticle = _pv_as_particles(buf);
    for (var c = 0; c < n; c = c + 1) {
        var d: *PvFluidParticle = snap + c;
        var e: *PvFluidParticle = ps + c;
        *d = *e;
    }
    var kc: _PvKernelCoeffs;
    _pv_kc_init(&kc, h);
    var h2: f64 = kc.h2;
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var lo: f64 = _PV_SPH_MIN_DENSITY;
    var lam: f64 = _pv_max(ve.relaxation_time, tiny);
    var inv_lambda: f64 = 1.0 / lam;
    var g: f64 = ve.elastic_modulus;
    for (var i = 0; i < n; i = i + 1) {
        var pi: *PvFluidParticle = snap + i;
        var rho: f64 = _pv_max(pi.density, lo);
        var start = load64(offsets + i * 8);
        var end = load64(offsets + (i + 1) * 8);
        var dudx: f64 = 0.0;
        var dudy: f64 = 0.0;
        var dvdx: f64 = 0.0;
        var dvdy: f64 = 0.0;
        for (var k = start; k < end; k = k + 1) {
            var j = load64(indices + k * 8);
            if (j != i) {
                var pj: *PvFluidParticle = snap + j;
                var dx: f64 = pi.position.x - pj.position.x;
                var dy: f64 = pi.position.y - pj.position.y;
                var dz: f64 = pi.position.z - pj.position.z;
                var r2: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
                if ((r2 > h2 || r2 < tiny) == 0) {
                    var r: f64 = f64_sqrt(r2);
                    var rho_j: f64 = _pv_max(pj.density, lo);
                    var grad: f64 = _pv_kc_spiky_grad(&kc, r);
                    var scale: f64 = ((pj.mass / rho_j) * grad) / r;
                    var dvx: f64 = pj.velocity.x - pi.velocity.x;
                    var dvy: f64 = pj.velocity.y - pi.velocity.y;
                    dudx = dudx + ((dvx * scale) * dx);
                    dudy = dudy + ((dvx * scale) * dy);
                    dvdx = dvdx + ((dvy * scale) * dx);
                    dvdy = dvdy + ((dvy * scale) * dy);
                }
            }
        }
        var cxx: f64 = pi.conformation.0;
        var cxy: f64 = pi.conformation.1;
        var cyy: f64 = pi.conformation.2;
        var dcxx: f64 = (2.0 * ((dudx * cxx) + (dudy * cxy))) - ((cxx - 1.0) * inv_lambda);
        var dcxy: f64 = ((((dudx * cxy) + (dudy * cyy)) + (dvdx * cxx)) + (dvdy * cxy)) - (cxy * inv_lambda);
        var dcyy: f64 = (2.0 * ((dvdx * cxy) + (dvdy * cyy))) - ((cyy - 1.0) * inv_lambda);
        var nxx: f64 = cxx + (dcxx * dt);
        var nxy: f64 = cxy + (dcxy * dt);
        var nyy: f64 = cyy + (dcyy * dt);
        var out: *PvFluidParticle = ps + i;
        out.conformation = (nxx, nxy, nyy);
        var fx: f64 = 0.0;
        var fy: f64 = 0.0;
        for (var k2 = start; k2 < end; k2 = k2 + 1) {
            var j2 = load64(indices + k2 * 8);
            if (j2 != i) {
                var qj: *PvFluidParticle = snap + j2;
                var ex: f64 = pi.position.x - qj.position.x;
                var ey: f64 = pi.position.y - qj.position.y;
                var ez: f64 = pi.position.z - qj.position.z;
                var s2: f64 = ((ex * ex) + (ey * ey)) + (ez * ez);
                if ((s2 > h2 || s2 < tiny) == 0) {
                    var s: f64 = f64_sqrt(s2);
                    var rho_q: f64 = _pv_max(qj.density, lo);
                    var gq: f64 = _pv_kc_spiky_grad(&kc, s);
                    var sc: f64 = ((qj.mass / rho_q) * gq) / s;
                    var dxx: f64 = qj.conformation.0 - cxx;
                    var dxy: f64 = qj.conformation.1 - cxy;
                    var dyy: f64 = qj.conformation.2 - cyy;
                    var tx: f64 = (dxx * ex) + (dxy * ey);
                    var ty: f64 = (dxy * ex) + (dyy * ey);
                    fx = fx + (((g * tx) * sc) / rho);
                    fy = fy + (((g * ty) * sc) / rho);
                }
            }
        }
        var ax: f64 = out.acceleration.x + fx;
        var ay: f64 = out.acceleration.y + fy;
        out.acceleration = PvVec3_new(ax, ay, out.acceleration.z);
    }
    fl_free(buf);
    _pv_span_end(trace); return 1;
}

# ── part d: heat conduction ─────────────────────────────────────────────────────────

# SPH heat conduction: the thermal diffusivity κ (m²/s). Mirrors `HeatConfig`.
struct PvHeatConfig {
    diffusivity: f64;
}

# A heat-conduction config. Mirrors `HeatConfig::new`.
#must_use
fn PvHeatConfig_new(diffusivity: f64): PvHeatConfig {
    var c: PvHeatConfig;
    c.diffusivity = diffusivity;
    return c;
}

# Conducts heat between the n particles over the CSR lists at smoothing radius h: Tᵢ += (κ·Σ ((mⱼ/ρⱼ)·(Tⱼ −
# Tᵢ))·∇²W)·dt, the temperatures from a snapshot, over pairs with 1e-20 ≤ r² ≤ h², j ≠ i, ρⱼ floored at 1e-10. Nothing
# for n = 0 or κ not finite and > 0 (1). 1, or 0 with nothing changed for invalid lists or no memory for the snapshot.
# Mirrors `update_heat` (ADR 0002 #18).
#must_use
fn update_heat(ps: *PvFluidParticle, n, offsets, n_off, indices, n_idx, h: f64, heat: *PvHeatConfig, dt: f64): i64 {
    var trace = _pv_span(_PV_LOG_SPH, "sph::heat", "n", n, 0, 0, 0, 0);
    if (n <= 0 || _pv_is_positive(heat.diffusivity) == 0) { _pv_span_end(trace); return 1; }
    if (_pv_lists_valid(offsets, n_off, indices, n_idx, n) == 0) { _pv_span_end(trace); return 0; }
    if (n > 9223372036854775807 / 8) { _pv_span_end(trace); return 0; }
    var snap = fl_alloc(n * 8);
    if (snap == 0) { _pv_span_end(trace); return 0; }
    for (var c = 0; c < n; c = c + 1) {
        var q: *PvFluidParticle = ps + c;
        store64(snap + c * 8, _pv_bits(q.temperature));
    }
    var kc: _PvKernelCoeffs;
    _pv_kc_init(&kc, h);
    var h2: f64 = kc.h2;
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var lo: f64 = _PV_SPH_MIN_DENSITY;
    var kappa: f64 = heat.diffusivity;
    for (var i = 0; i < n; i = i + 1) {
        var pi: *PvFluidParticle = ps + i;
        var ti: f64 = load64(snap + i * 8);
        var start = load64(offsets + i * 8);
        var end = load64(offsets + (i + 1) * 8);
        var acc: f64 = 0.0;
        for (var k = start; k < end; k = k + 1) {
            var j = load64(indices + k * 8);
            if (j != i) {
                var pj: *PvFluidParticle = ps + j;
                var dx: f64 = pi.position.x - pj.position.x;
                var dy: f64 = pi.position.y - pj.position.y;
                var dz: f64 = pi.position.z - pj.position.z;
                var r2: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
                if ((r2 > h2 || r2 < tiny) == 0) {
                    var r: f64 = f64_sqrt(r2);
                    var rho_j: f64 = _pv_max(pj.density, lo);
                    var lap: f64 = _pv_kc_visc_lap(&kc, r);
                    var tj: f64 = load64(snap + j * 8);
                    var term: f64 = ((pj.mass / rho_j) * (tj - ti)) * lap;
                    acc = acc + term;
                }
            }
        }
        var dtemp: f64 = (kappa * acc) * dt;
        pi.temperature = pi.temperature + dtemp;
    }
    fl_free(snap);
    _pv_span_end(trace); return 1;
}

# ── part d: phase change ────────────────────────────────────────────────────────────

# Phase change at one threshold: the transition temperature (K), the latent heat (J/kg), the specific heat capacity
# (J/(kg·K)), and the phase indices below and above it. Mirrors `PhaseChangeConfig`.
struct PvPhaseChangeConfig {
    transition_temperature: f64;
    latent_heat: f64;
    heat_capacity: f64;
    phase_below;
    phase_above;
}

# A phase-change config. Mirrors `PhaseChangeConfig::new`.
#must_use
fn PvPhaseChangeConfig_new(transition_temperature: f64, latent_heat: f64, heat_capacity: f64, phase_below,
  phase_above): PvPhaseChangeConfig {
    var c: PvPhaseChangeConfig;
    c.transition_temperature = transition_temperature;
    c.latent_heat = latent_heat;
    c.heat_capacity = heat_capacity;
    c.phase_below = phase_below;
    c.phase_above = phase_above;
    return c;
}

# Water ice ⇄ liquid water at 273.15 K (L = 334 kJ/kg, c_p of ice 2090 J/(kg·K)). Mirrors
# `PhaseChangeConfig::water_ice`.
#must_use
fn PvPhaseChangeConfig_water_ice(phase_ice, phase_water): PvPhaseChangeConfig {
    var c: PvPhaseChangeConfig = PvPhaseChangeConfig_new(273.15, 334000.0, 2090.0, phase_ice, phase_water);
    return c;
}

# The Stefan condition on each of the n particles in phase_below or phase_above (phase_below first when they are
# equal), with the fuel field as the latent-heat accumulator (the fraction of the transition done, clamped to [0, 1];
# NaN stays NaN), L = max(latent heat, 1e-20) and c = max(heat capacity, 1e-10): energy past the transition point,
# (T − T*)·c heating or (T* − T)·c cooling, first fills the remaining latent heat (the temperature held at T*), then
# flips the phase (fuel 0) and moves the temperature by what is left over c; energy back returns stored latent heat
# first. dt is unused, as Rust's. Mirrors `update_phase_change`.
fn update_phase_change(ps: *PvFluidParticle, n, config: *PvPhaseChangeConfig, dt: f64) {
    var trace = _pv_span(_PV_LOG_SPH, "sph::phase_change", "n", n, 0, 0, 0, 0);
    var t_trans: f64 = config.transition_temperature;
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var l_heat: f64 = _pv_max(config.latent_heat, tiny);
    var cfloor: f64 = 0x3DDB7CDFD9D7BDBB;   # 1e-10
    var cp: f64 = _pv_max(config.heat_capacity, cfloor);
    for (var i = 0; i < n; i = i + 1) {
        var p: *PvFluidParticle = ps + i;
        var other = 0;
        var heating = 0;
        var known = 1;
        if (p.phase == config.phase_below) {
            other = config.phase_above;
            heating = 1;
        } elif (p.phase == config.phase_above) {
            other = config.phase_below;
        } else {
            known = 0;
        }
        if (known == 1) {
            var toward: f64 = (t_trans - p.temperature) * cp;
            if (heating == 1) { toward = (p.temperature - t_trans) * cp; }
            var progress: f64 = _pv_clamp(p.fuel, 0.0, 1.0);
            if (toward > 0.0) {
                var needed: f64 = (1.0 - progress) * l_heat;
                if (toward >= needed) {
                    p.phase = other;
                    p.fuel = 0.0;
                    var extra: f64 = (toward - needed) / cp;
                    var tu: f64 = t_trans - extra;
                    if (heating == 1) { tu = t_trans + extra; }
                    p.temperature = tu;
                } else {
                    var part: f64 = toward / l_heat;
                    p.fuel = progress + part;
                    p.temperature = t_trans;
                }
            } elif (progress > 0.0) {
                var stored: f64 = progress * l_heat;
                var back: f64 = -toward;
                if (back >= stored) {
                    p.fuel = 0.0;
                    var extra2: f64 = (back - stored) / cp;
                    var td: f64 = t_trans + extra2;
                    if (heating == 1) { td = t_trans - extra2; }
                    p.temperature = td;
                } else {
                    var part2: f64 = back / l_heat;
                    p.fuel = progress - part2;
                    p.temperature = t_trans;
                }
            }
        }
    }
    _pv_span_end(trace); return 0;
}

# ── part d: reactions and combustion ────────────────────────────────────────────────

# A reaction's result for one particle: the fuel consumed and the temperature increase. Rust's `(f64, f64)`: a call
# through a `dyn` returns one value, so the pair is a struct (ADR 0002 #18).
struct PvReaction {
    consumed: f64;
    heat: f64;
}

# A pluggable chemistry backend: `react(temperature, fuel, dt)` gives the fuel consumed and the temperature increase
# for one particle. Mirrors the trait `ReactionProvider` (a `dyn PvReactionProvider` is Rust's `&dyn`).
trait PvReactionProvider {
    # One particle's reaction: the fuel consumed and the temperature increase at this temperature (K), fuel (0–1) and
    # dt (s). Mirrors `ReactionProvider::react`.
    fn react(self, temperature: f64, fuel: f64, dt: f64): PvReaction;
}

# One-step combustion, fuel → products + heat: the ignition temperature (K), the reaction rate (1/s), and the heat
# released per unit fuel (K). Mirrors `CombustionConfig`.
struct PvCombustionConfig {
    ignition_temperature: f64;
    reaction_rate: f64;
    heat_release: f64;
}

# Ignition at 500 K, rate 10/s, 1000 K per unit fuel. Mirrors `CombustionConfig::default`.
#must_use
fn PvCombustionConfig_default(): PvCombustionConfig {
    var c: PvCombustionConfig;
    c.ignition_temperature = 500.0;
    c.reaction_rate = 10.0;
    c.heat_release = 1000.0;
    return c;
}

impl PvReactionProvider for PvCombustionConfig {
    # Nothing at or below ignition or without fuel (a NaN temperature reacts, as Rust's `<=` lets it); else the
    # implicit depletion consumed = fuel − fuel/(1 + rate·dt) and heat = heat_release·consumed. Mirrors
    # `impl ReactionProvider for CombustionConfig`.
    fn react(self, temperature: f64, fuel: f64, dt: f64): PvReaction {
        var r: PvReaction;
        r.consumed = 0.0;
        r.heat = 0.0;
        if (temperature <= self.ignition_temperature || fuel <= 0.0) { return r; }
        var d: f64 = 1.0 + (self.reaction_rate * dt);
        var q: f64 = fuel / d;
        var c: f64 = fuel - q;
        r.consumed = c;
        r.heat = self.heat_release * c;
        return r;
    }
}

# Each of the n particles with fuel > 0 reacts through the provider: fuel = max(fuel − consumed, 0) (NaN-ignoring),
# temperature += heat. Mirrors `update_reaction`.
fn update_reaction(ps: *PvFluidParticle, n, provider: dyn PvReactionProvider, dt: f64) {
    var trace = _pv_span(_PV_LOG_SPH, "sph::reaction", "n", n, 0, 0, 0, 0);
    for (var i = 0; i < n; i = i + 1) {
        var p: *PvFluidParticle = ps + i;
        if (p.fuel > 0.0) {
            var r: PvReaction = provider.react(p.temperature, p.fuel, dt);
            var left: f64 = p.fuel - r.consumed;
            var zero: f64 = 0.0;
            p.fuel = _pv_max(left, zero);
            p.temperature = p.temperature + r.heat;
        }
    }
    _pv_span_end(trace); return 0;
}

# Combustion on each of the n particles above ignition with fuel > 0 (a NaN temperature does not burn here):
# consumed = fuel − fuel/(1 + rate·dt), fuel = max(fuel − consumed, 0), temperature += heat_release·consumed.
# Mirrors `update_combustion`.
fn update_combustion(ps: *PvFluidParticle, n, config: *PvCombustionConfig, dt: f64) {
    var trace = _pv_span(_PV_LOG_SPH, "sph::combustion", "n", n, 0, 0, 0, 0);
    var t_ign: f64 = config.ignition_temperature;
    var rate: f64 = config.reaction_rate;
    var heat: f64 = config.heat_release;
    var d: f64 = 1.0 + (rate * dt);
    for (var i = 0; i < n; i = i + 1) {
        var p: *PvFluidParticle = ps + i;
        if (p.temperature > t_ign && p.fuel > 0.0) {
            var fuel: f64 = p.fuel;
            var q: f64 = fuel / d;
            var consumed: f64 = fuel - q;
            var left: f64 = fuel - consumed;
            var zero: f64 = 0.0;
            p.fuel = _pv_max(left, zero);
            var dtemp: f64 = heat * consumed;
            p.temperature = p.temperature + dtemp;
        }
    }
    _pv_span_end(trace); return 0;
}

# ── part d: the contact angle ───────────────────────────────────────────────────────

# Young's contact angle at the domain's walls: each of the n particles within h of a wall (on an axis whose high corner
# is not at or below its low one: a NaN corner keeps its walls, as Rust's `hi <= lo` test does) is accelerated by
# −n̂·((σ·cos θ)/h), n̂ the normalised sum of the inward normals of its walls (glam's v·(1/|v|)), skipped when that
# sum's |·|² < 1e-20. cos θ is correctly rounded (ADR 0004). Nothing for h not finite and > 0, or σ or θ not finite.
# Mirrors `apply_contact_angle`.
fn apply_contact_angle(ps: *PvFluidParticle, n, config: *PvFluidConfig, contact_angle: f64, surface_tension: f64) {
    var trace = _pv_span(_PV_LOG_SPH, "sph::contact_angle", "n", n, 0, 0, 0, 0);
    var h: f64 = config.smoothing_radius;
    if (_pv_is_positive(h) == 0 || _pv_is_finite(surface_tension) == 0 || _pv_is_finite(contact_angle) == 0) {
        _pv_span_end(trace); return 0;
    }
    var cos_theta: f64 = _pv_cos(contact_angle);
    var accel: f64 = (surface_tension * cos_theta) / h;
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var lx: f64 = config.bounds_min.x;
    var ly: f64 = config.bounds_min.y;
    var lz: f64 = config.bounds_min.z;
    var hx: f64 = config.bounds_max.x;
    var hy: f64 = config.bounds_max.y;
    var hz: f64 = config.bounds_max.z;
    for (var i = 0; i < n; i = i + 1) {
        var p: *PvFluidParticle = ps + i;
        var wx: f64 = 0.0;
        var wy: f64 = 0.0;
        var wz: f64 = 0.0;
        if ((hx <= lx) == 0) {
            if (p.position.x - lx < h) { wx = wx + 1.0; }
            if (hx - p.position.x < h) { wx = wx - 1.0; }
        }
        if ((hy <= ly) == 0) {
            if (p.position.y - ly < h) { wy = wy + 1.0; }
            if (hy - p.position.y < h) { wy = wy - 1.0; }
        }
        if ((hz <= lz) == 0) {
            if (p.position.z - lz < h) { wz = wz + 1.0; }
            if (hz - p.position.z < h) { wz = wz - 1.0; }
        }
        var l2: f64 = ((wx * wx) + (wy * wy)) + (wz * wz);
        if ((l2 < tiny) == 0) {
            var len: f64 = f64_sqrt(l2);
            var inv: f64 = 1.0 / len;
            var nx: f64 = (wx * inv) * accel;
            var ny: f64 = (wy * inv) * accel;
            var nz: f64 = (wz * inv) * accel;
            var ax: f64 = p.acceleration.x - nx;
            var ay: f64 = p.acceleration.y - ny;
            var az: f64 = p.acceleration.z - nz;
            p.acceleration = PvVec3_new(ax, ay, az);
        }
    }
    _pv_span_end(trace); return 0;
}

# ── part d: delta-SPH density diffusion ─────────────────────────────────────────────

# Molteni & Colagrossi's density diffusion on the n particles over the CSR lists: ρᵢ += (((δ·h)·c₀)·Σ)·dt with Σ = −Σⱼ
# ((Vⱼ·ψ)·r)·∇W(r), ψ = (2·(ρⱼ − ρᵢ))/(r² + (0.01·h)·h), Vⱼ = mⱼ/max(ρⱼ, 1e-10), from a snapshot of the densities,
# positions and masses, over pairs with 1e-20 ≤ r² ≤ h², j ≠ i. Nothing for n = 0 or δ not finite and > 0 (1). 1, or 0
# with nothing changed for invalid lists or no memory for the snapshot. Mirrors `apply_delta_sph` (ADR 0002 #18).
#must_use
fn apply_delta_sph(ps: *PvFluidParticle, n, offsets, n_off, indices, n_idx, h: f64, speed_of_sound: f64, delta: f64,
  dt: f64): i64 {
    var trace = _pv_span(_PV_LOG_SPH, "sph::delta_sph", "n", n, 0, 0, 0, 0);
    if (n <= 0 || _pv_is_positive(delta) == 0) { _pv_span_end(trace); return 1; }
    if (_pv_lists_valid(offsets, n_off, indices, n_idx, n) == 0) { _pv_span_end(trace); return 0; }
    if (n > 9223372036854775807 / 40) { _pv_span_end(trace); return 0; }
    var snap = fl_alloc(n * 40);   # density, x, y, z, mass
    if (snap == 0) { _pv_span_end(trace); return 0; }
    for (var c = 0; c < n; c = c + 1) {
        var q: *PvFluidParticle = ps + c;
        var w = snap + c * 40;
        store64(w, _pv_bits(q.density));
        store64(w + 8, _pv_bits(q.position.x));
        store64(w + 16, _pv_bits(q.position.y));
        store64(w + 24, _pv_bits(q.position.z));
        store64(w + 32, _pv_bits(q.mass));
    }
    var kc: _PvKernelCoeffs;
    _pv_kc_init(&kc, h);
    var h2: f64 = kc.h2;
    var eps: f64 = (0.01 * h) * h;
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var lo: f64 = _PV_SPH_MIN_DENSITY;
    var gain: f64 = ((delta * h) * speed_of_sound);
    for (var i = 0; i < n; i = i + 1) {
        var wi = snap + i * 40;
        var rho_i: f64 = load64(wi);
        var xi: f64 = load64(wi + 8);
        var yi: f64 = load64(wi + 16);
        var zi: f64 = load64(wi + 24);
        var start = load64(offsets + i * 8);
        var end = load64(offsets + (i + 1) * 8);
        var corr: f64 = 0.0;
        for (var k = start; k < end; k = k + 1) {
            var j = load64(indices + k * 8);
            if (j != i) {
                var wj = snap + j * 40;
                var rho_j: f64 = load64(wj);
                var xj: f64 = load64(wj + 8);
                var yj: f64 = load64(wj + 16);
                var zj: f64 = load64(wj + 24);
                var dx: f64 = xi - xj;
                var dy: f64 = yi - yj;
                var dz: f64 = zi - zj;
                var r2: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
                if ((r2 > h2 || r2 < tiny) == 0) {
                    var r: f64 = f64_sqrt(r2);
                    var safe: f64 = _pv_max(rho_j, lo);
                    var mj: f64 = load64(wj + 32);
                    var vol: f64 = mj / safe;
                    var psi: f64 = (2.0 * (rho_j - rho_i)) / (r2 + eps);
                    var grad: f64 = _pv_kc_spiky_grad(&kc, r);
                    var term: f64 = ((vol * psi) * r) * grad;
                    corr = corr - term;
                }
            }
        }
        var p: *PvFluidParticle = ps + i;
        var dd: f64 = (gain * corr) * dt;
        p.density = p.density + dd;
    }
    fl_free(snap);
    _pv_span_end(trace); return 1;
}

# ── part d: the MLS gradient corrections ────────────────────────────────────────────

# The inverse of the 3×3 row-major matrix at m into out (9 words): 1, or 0 for a largest pivot below 1e-12 (hisab's
# `EPSILON_F64`, an absolute threshold; out unchanged). The oracle's own algorithm, allocation-free: hisab 1.4.0
# `matrix_inverse`, an LU decomposition with partial pivoting (the first largest |pivot| below the diagonal; a NaN pivot
# stays, as `val > NaN` never holds), then a dense forward and back substitution of each unit column, `a − b·c` as
# written (no fused multiply-add). ganita's `mat_inv` is not the same function at the edges: it refuses any non-finite
# entry and scales its singular threshold by the matrix, so it differs from the oracle on 12 of the 60 inverse rows (a
# 1e-13 diagonal, a 1e-12 pivot, 1e300 entries, every ±∞ and NaN entry; port-parity §18). Mirrors `invert_3x3`.
#must_use
fn _pv_invert_3x3(m, out): i64 {
    var lu[72];
    var piv[24];
    for (var k = 0; k < 9; k = k + 1) { store64(&lu + k * 8, load64(m + k * 8)); }
    for (var p = 0; p < 3; p = p + 1) { store64(&piv + p * 8, p); }
    var eps: f64 = 0x3D719799812DEA11;   # 1e-12: hisab 1.4.0's `EPSILON_F64` (not f64::EPSILON)
    for (var col = 0; col < 3; col = col + 1) {
        var max_row = col;
        var mv: f64 = load64(&lu + (col * 3 + col) * 8);
        var max_val: f64 = f64_abs(mv);
        for (var row = col + 1; row < 3; row = row + 1) {
            var rv: f64 = load64(&lu + (row * 3 + col) * 8);
            var val: f64 = f64_abs(rv);
            if (val > max_val) {
                max_val = val;
                max_row = row;
            }
        }
        if (max_val < eps) { return 0; }
        if (max_row != col) {
            for (var c = 0; c < 3; c = c + 1) {
                var a = load64(&lu + (col * 3 + c) * 8);
                store64(&lu + (col * 3 + c) * 8, load64(&lu + (max_row * 3 + c) * 8));
                store64(&lu + (max_row * 3 + c) * 8, a);
            }
            var t = load64(&piv + col * 8);
            store64(&piv + col * 8, load64(&piv + max_row * 8));
            store64(&piv + max_row * 8, t);
        }
        var diag: f64 = load64(&lu + (col * 3 + col) * 8);
        for (var r = col + 1; r < 3; r = r + 1) {
            var l: f64 = load64(&lu + (r * 3 + col) * 8);
            var factor: f64 = l / diag;
            store64(&lu + (r * 3 + col) * 8, _pv_bits(factor));
            for (var j = col + 1; j < 3; j = j + 1) {
                var u: f64 = load64(&lu + (col * 3 + j) * 8);
                var x: f64 = load64(&lu + (r * 3 + j) * 8);
                var nx: f64 = x - (factor * u);
                store64(&lu + (r * 3 + j) * 8, _pv_bits(nx));
            }
        }
    }
    var xv[24];
    for (var e = 0; e < 3; e = e + 1) {
        # x = P·e_e, then L·y = x forward, U·x = y back (hisab's `lu_solve`).
        for (var i = 0; i < 3; i = i + 1) {
            var one: f64 = 0.0;
            if (load64(&piv + i * 8) == e) { one = 1.0; }
            store64(&xv + i * 8, _pv_bits(one));
        }
        for (var i2 = 1; i2 < 3; i2 = i2 + 1) {
            var sum: f64 = load64(&xv + i2 * 8);
            for (var j2 = 0; j2 < i2; j2 = j2 + 1) {
                var lij: f64 = load64(&lu + (i2 * 3 + j2) * 8);
                var xj: f64 = load64(&xv + j2 * 8);
                sum = sum - (lij * xj);
            }
            store64(&xv + i2 * 8, _pv_bits(sum));
        }
        for (var i3 = 2; i3 >= 0; i3 = i3 - 1) {
            var bs: f64 = load64(&xv + i3 * 8);
            for (var j3 = i3 + 1; j3 < 3; j3 = j3 + 1) {
                var uij: f64 = load64(&lu + (i3 * 3 + j3) * 8);
                var xk: f64 = load64(&xv + j3 * 8);
                bs = bs - (uij * xk);
            }
            var uii: f64 = load64(&lu + (i3 * 3 + i3) * 8);
            var xi: f64 = bs / uii;
            store64(&xv + i3 * 8, _pv_bits(xi));
        }
        for (var i4 = 0; i4 < 3; i4 = i4 + 1) { store64(out + (i4 * 3 + e) * 8, load64(&xv + i4 * 8)); }
    }
    return 1;
}

# The MLS gradient correction of each of the n particles, Lᵢ = Mᵢ⁻¹ with Mᵢ = Σⱼ Vⱼ·(xⱼ − xᵢ) ⊗ ∇Wᵢⱼ (Vⱼ = mⱼ/max(ρⱼ,
# 1e-10), ∇W = (xᵢ − xⱼ)·(W'(r)/r), M[row][col] += (Vⱼ·d[row])·∇W[col]) over pairs with 1e-20 ≤ r² ≤ h², j ≠ i; the
# identity where M is singular (`_pv_invert_3x3`). A new freelist buffer of n row-major 3×3 matrices (9 words
# each): (pointer, n), every one the identity for h not finite and > 0 or invalid lists (Rust warns for the lists);
# (0, 0) for n ≤ 0 or no memory (Rust aborts). Mirrors `compute_gradient_corrections` (ADR 0002 #18).
#must_use
fn compute_gradient_corrections(ps: *PvFluidParticle, n, offsets, n_off, indices, n_idx, h: f64) {
    var trace = _pv_span(_PV_LOG_SPH, "sph::mls_correction", "n", n, 0, 0, 0, 0);
    if (n == 0) {
        # Rust checks the lists (and warns) for no particles too, unless h refuses first.
        if (_pv_is_positive(h) == 1) { var lv = _pv_lists_valid(offsets, n_off, indices, n_idx, n); }
        _pv_span_end(trace); return (0, 0);
    }
    if (n < 0 || n > 9223372036854775807 / 72) { _pv_span_end(trace); return (0, 0); }
    var out = fl_alloc(n * 72);
    if (out == 0) { _pv_span_end(trace); return (0, 0); }
    for (var c = 0; c < n; c = c + 1) {
        for (var e = 0; e < 9; e = e + 1) {
            var v: f64 = 0.0;
            if (e == 0 || e == 4 || e == 8) { v = 1.0; }
            store64(out + (c * 9 + e) * 8, _pv_bits(v));
        }
    }
    if (_pv_is_positive(h) == 0 || _pv_lists_valid(offsets, n_off, indices, n_idx, n) == 0) {
        _pv_span_end(trace);
        return (out, n);
    }
    var kc: _PvKernelCoeffs;
    _pv_kc_init(&kc, h);
    var h2: f64 = kc.h2;
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var lo: f64 = _PV_SPH_MIN_DENSITY;
    var mm[72];
    for (var i = 0; i < n; i = i + 1) {
        var pi: *PvFluidParticle = ps + i;
        # M, row-major, in nine locals: M[row][col] += (Vⱼ·d[row])·∇W[col], as Rust's two loops add it.
        var m00: f64 = 0.0;
        var m01: f64 = 0.0;
        var m02: f64 = 0.0;
        var m10: f64 = 0.0;
        var m11: f64 = 0.0;
        var m12: f64 = 0.0;
        var m20: f64 = 0.0;
        var m21: f64 = 0.0;
        var m22: f64 = 0.0;
        var start = load64(offsets + i * 8);
        var end = load64(offsets + (i + 1) * 8);
        for (var k = start; k < end; k = k + 1) {
            var j = load64(indices + k * 8);
            if (j != i) {
                var pj: *PvFluidParticle = ps + j;
                var fx: f64 = pj.position.x - pi.position.x;
                var fy: f64 = pj.position.y - pi.position.y;
                var fz: f64 = pj.position.z - pi.position.z;
                var r2: f64 = ((fx * fx) + (fy * fy)) + (fz * fz);
                if ((r2 > h2 || r2 < tiny) == 0) {
                    var r: f64 = f64_sqrt(r2);
                    var rho_j: f64 = _pv_max(pj.density, lo);
                    var vol: f64 = pj.mass / rho_j;
                    var grad: f64 = _pv_kc_spiky_grad(&kc, r);
                    var gr: f64 = grad / r;
                    var bx: f64 = pi.position.x - pj.position.x;
                    var by: f64 = pi.position.y - pj.position.y;
                    var bz: f64 = pi.position.z - pj.position.z;
                    var g0: f64 = bx * gr;
                    var g1: f64 = by * gr;
                    var g2: f64 = bz * gr;
                    var v0: f64 = vol * fx;
                    var v1: f64 = vol * fy;
                    var v2: f64 = vol * fz;
                    m00 = m00 + (v0 * g0);
                    m01 = m01 + (v0 * g1);
                    m02 = m02 + (v0 * g2);
                    m10 = m10 + (v1 * g0);
                    m11 = m11 + (v1 * g1);
                    m12 = m12 + (v1 * g2);
                    m20 = m20 + (v2 * g0);
                    m21 = m21 + (v2 * g1);
                    m22 = m22 + (v2 * g2);
                }
            }
        }
        store64(&mm, _pv_bits(m00));
        store64(&mm + 8, _pv_bits(m01));
        store64(&mm + 16, _pv_bits(m02));
        store64(&mm + 24, _pv_bits(m10));
        store64(&mm + 32, _pv_bits(m11));
        store64(&mm + 40, _pv_bits(m12));
        store64(&mm + 48, _pv_bits(m20));
        store64(&mm + 56, _pv_bits(m21));
        store64(&mm + 64, _pv_bits(m22));
        var tmp[72];
        if (_pv_invert_3x3(&mm, &tmp) == 1) {
            for (var t = 0; t < 9; t = t + 1) { store64(out + (i * 9 + t) * 8, load64(&tmp + t * 8)); }
        }
    }
    _pv_span_end(trace); return (out, n);
}

# L·∇W for the row-major 3×3 matrix at correction: each row ((r₀·x) + (r₁·y)) + (r₂·z). Mirrors
# `apply_gradient_correction` (its `&[f64; 9]` a pointer to 9 words).
#must_use
fn apply_gradient_correction(correction, gw: PvVec3): PvVec3 {
    var c0: f64 = load64(correction);
    var c1: f64 = load64(correction + 8);
    var c2: f64 = load64(correction + 16);
    var c3: f64 = load64(correction + 24);
    var c4: f64 = load64(correction + 32);
    var c5: f64 = load64(correction + 40);
    var c6: f64 = load64(correction + 48);
    var c7: f64 = load64(correction + 56);
    var c8: f64 = load64(correction + 64);
    var x: f64 = ((c0 * gw.x) + (c1 * gw.y)) + (c2 * gw.z);
    var y: f64 = ((c3 * gw.x) + (c4 * gw.y)) + (c5 * gw.z);
    var z: f64 = ((c6 * gw.x) + (c7 * gw.y)) + (c8 * gw.z);
    return PvVec3_new(x, y, z);
}

# ── part d: implicit viscosity ──────────────────────────────────────────────────────

# Backward-Euler viscosity v = v_old + (ν·dt)·∇²v by Gauss–Seidel sweeps over the n particles and the CSR lists:
# vᵢ = (v_oldᵢ + Σ (vⱼ·aᵢⱼ)·c)/(1 + c·Σ aᵢⱼ), aᵢⱼ = (mⱼ·∇²W)/(ρⱼ·ρᵢ), c = ν·dt, each ρ floored at 1e-10, the current
# velocities (sweep order), at most `iterations` sweeps, stopping after one whose largest |Δv|² (NaN-ignoring) is below
# (1e-8)². Nothing for n = 0 or ν, h or dt not finite and > 0 (1). 1, or 0 with nothing changed for invalid lists or no
# memory for v_old. Mirrors `apply_implicit_viscosity` (ADR 0002 #18).
#must_use
fn apply_implicit_viscosity(ps: *PvFluidParticle, n, offsets, n_off, indices, n_idx, h: f64, viscosity: f64, dt: f64,
  iterations): i64 {
    var trace = _pv_span(_PV_LOG_SPH, "sph::implicit_visc", "n", n, 0, 0, 0, 0);
    if (n <= 0 || _pv_is_positive(viscosity) == 0 || _pv_is_positive(h) == 0 || _pv_is_positive(dt) == 0) {
        _pv_span_end(trace); return 1;
    }
    if (_pv_lists_valid(offsets, n_off, indices, n_idx, n) == 0) { _pv_span_end(trace); return 0; }
    if (n > 9223372036854775807 / 24) { _pv_span_end(trace); return 0; }
    var v_old = fl_alloc(n * 24);
    if (v_old == 0) { _pv_span_end(trace); return 0; }
    for (var c0 = 0; c0 < n; c0 = c0 + 1) {
        var q: *PvFluidParticle = ps + c0;
        store64(v_old + c0 * 24, _pv_bits(q.velocity.x));
        store64(v_old + c0 * 24 + 8, _pv_bits(q.velocity.y));
        store64(v_old + c0 * 24 + 16, _pv_bits(q.velocity.z));
    }
    var kc: _PvKernelCoeffs;
    _pv_kc_init(&kc, h);
    var h2: f64 = kc.h2;
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var lo: f64 = _PV_SPH_MIN_DENSITY;
    var c: f64 = viscosity * dt;
    var thr: f64 = _PV_SPH_CONVERGENCE_THRESHOLD;
    var stop: f64 = thr * thr;
    for (var it = 0; it < iterations; it = it + 1) {
        var max_change: f64 = 0.0;
        for (var i = 0; i < n; i = i + 1) {
            var pi: *PvFluidParticle = ps + i;
            var px: f64 = pi.position.x;
            var py: f64 = pi.position.y;
            var pz: f64 = pi.position.z;
            var rho: f64 = _pv_max(pi.density, lo);
            var start = load64(offsets + i * 8);
            var end = load64(offsets + (i + 1) * 8);
            var wx: f64 = 0.0;
            var wy: f64 = 0.0;
            var wz: f64 = 0.0;
            var diag: f64 = 0.0;
            for (var k = start; k < end; k = k + 1) {
                var j = load64(indices + k * 8);
                if (j != i) {
                    var pj: *PvFluidParticle = ps + j;
                    var dx: f64 = px - pj.position.x;
                    var dy: f64 = py - pj.position.y;
                    var dz: f64 = pz - pj.position.z;
                    var r2: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
                    if ((r2 > h2 || r2 < tiny) == 0) {
                        var r: f64 = f64_sqrt(r2);
                        var rho_j: f64 = _pv_max(pj.density, lo);
                        var lap: f64 = _pv_kc_visc_lap(&kc, r);
                        var a: f64 = (pj.mass * lap) / (rho_j * rho);
                        wx = wx + (pj.velocity.x * a);
                        wy = wy + (pj.velocity.y * a);
                        wz = wz + (pj.velocity.z * a);
                        diag = diag + a;
                    }
                }
            }
            var den: f64 = 1.0 + (c * diag);
            var ox: f64 = load64(v_old + i * 24);
            var oy: f64 = load64(v_old + i * 24 + 8);
            var oz: f64 = load64(v_old + i * 24 + 16);
            var nx: f64 = (ox + (wx * c)) / den;
            var ny: f64 = (oy + (wy * c)) / den;
            var nz: f64 = (oz + (wz * c)) / den;
            var ex: f64 = nx - pi.velocity.x;
            var ey: f64 = ny - pi.velocity.y;
            var ez: f64 = nz - pi.velocity.z;
            var change: f64 = ((ex * ex) + (ey * ey)) + (ez * ez);
            max_change = _pv_max(max_change, change);
            pi.velocity = PvVec3_new(nx, ny, nz);
        }
        if (max_change < stop) { it = iterations; }
    }
    fl_free(v_old);
    _pv_span_end(trace); return 1;
}

# ── part d: secondary particles (foam, spray, bubbles) ──────────────────────────────

# The kind of a secondary particle: explicit, append-only values (Rust's `#[non_exhaustive]` enum in declaration
# order). Mirrors `SecondaryType`.
enum PvSecondaryType {
    PV_SECONDARY_TYPE_FOAM = 0;
    PV_SECONDARY_TYPE_SPRAY = 1;
    PV_SECONDARY_TYPE_BUBBLE = 2;
}

# A decorative secondary particle: position, velocity, remaining lifetime (s) and kind (`PvSecondaryType`). Mirrors
# `SecondaryParticle`.
struct PvSecondaryParticle {
    position: PvVec3;
    velocity: PvVec3;
    lifetime: f64;
    kind;
}

# A typed view of a word: the secondary-particle records at p.
#must_use
fn _pv_as_secondaries(p): *PvSecondaryParticle {
    return p;
}

# The secondary particles the n fluid particles shed, in their order: spray (velocity·1.2, lifetime·0.5) where |a| >
# threshold, else foam (velocity·0.1, the full lifetime) where |a| > threshold·0.3. A new freelist buffer: (pointer,
# count), which the caller releases with `fl_free`; (0, 0) when none is shed, or no memory (Rust aborts). Mirrors
# `generate_secondary_particles` (ADR 0002 #9).
#must_use
fn generate_secondary_particles(ps: *PvFluidParticle, n, accel_threshold: f64, max_lifetime: f64) {
    var trace = _pv_span(_PV_LOG_SPH, "sph::secondary", "n", n, 0, 0, 0, 0);
    var sz = sizeof(PvSecondaryParticle);
    if (n <= 0 || n > 9223372036854775807 / sz) { _pv_span_end(trace); return (0, 0); }
    var foam_thr: f64 = accel_threshold * 0.3;
    var count = 0;
    for (var i = 0; i < n; i = i + 1) {
        var p: *PvFluidParticle = ps + i;
        var a: f64 = p.acceleration.length();
        if (a > accel_threshold || a > foam_thr) { count = count + 1; }
    }
    if (count == 0) { _pv_span_end(trace); return (0, 0); }
    var buf = fl_alloc(count * sz);
    if (buf == 0) { _pv_span_end(trace); return (0, 0); }
    var k = 0;
    var half: f64 = max_lifetime * 0.5;
    for (var j = 0; j < n; j = j + 1) {
        var q: *PvFluidParticle = ps + j;
        var am: f64 = q.acceleration.length();
        var kind = 0 - 1;
        var gain: f64 = 0.0;
        var life: f64 = 0.0;
        if (am > accel_threshold) {
            kind = PV_SECONDARY_TYPE_SPRAY;
            gain = 1.2;
            life = half;
        } elif (am > foam_thr) {
            kind = PV_SECONDARY_TYPE_FOAM;
            gain = 0.1;
            life = max_lifetime;
        }
        if (kind >= 0) {
            var s: *PvSecondaryParticle = _pv_as_secondaries(buf) + k;
            s.position = q.position;
            var vx: f64 = q.velocity.x * gain;
            var vy: f64 = q.velocity.y * gain;
            var vz: f64 = q.velocity.z * gain;
            s.velocity = PvVec3_new(vx, vy, vz);
            s.lifetime = life;
            s.kind = kind;
            k = k + 1;
        }
    }
    _pv_span_end(trace); return (buf, count);
}

# Advects and ages the n secondary particles at ss, then keeps those still alive (lifetime > 0; NaN is not) in their
# order: spray falls (v + g·dt), foam damps (v·0.98), a bubble rises (v_y + 0.5·dt) then damps (v·0.95); then x +=
# v·dt and lifetime −= dt. A kind outside `PvSecondaryType` (which Rust can't hold) only moves and ages. Returns the
# new count. Mirrors `update_secondary_particles` (its `&mut Vec` as (pointer, count), `retain` in place).
#must_use
fn update_secondary_particles(ss: *PvSecondaryParticle, n, gravity: PvVec3, dt: f64): i64 {
    var gx: f64 = gravity.x * dt;
    var gy: f64 = gravity.y * dt;
    var gz: f64 = gravity.z * dt;
    var rise: f64 = 0.5 * dt;
    var kept = 0;
    for (var i = 0; i < n; i = i + 1) {
        var s: *PvSecondaryParticle = ss + i;
        var vx: f64 = s.velocity.x;
        var vy: f64 = s.velocity.y;
        var vz: f64 = s.velocity.z;
        match s.kind {
            PV_SECONDARY_TYPE_SPRAY => {
                vx = vx + gx;
                vy = vy + gy;
                vz = vz + gz;
            }
            PV_SECONDARY_TYPE_FOAM => {
                vx = vx * 0.98;
                vy = vy * 0.98;
                vz = vz * 0.98;
            }
            PV_SECONDARY_TYPE_BUBBLE => {
                vy = vy + rise;
                vx = vx * 0.95;
                vy = vy * 0.95;
                vz = vz * 0.95;
            }
            _ => {}
        }
        s.velocity.x = vx;
        s.velocity.y = vy;
        s.velocity.z = vz;
        var px: f64 = s.position.x + (vx * dt);
        var py: f64 = s.position.y + (vy * dt);
        var pz: f64 = s.position.z + (vz * dt);
        s.position.x = px;
        s.position.y = py;
        s.position.z = pz;
        s.lifetime = s.lifetime - dt;
        if (s.lifetime > 0.0) {
            if (kept != i) {
                var d: *PvSecondaryParticle = ss + kept;
                *d = *s;
            }
            kept = kept + 1;
        }
    }
    return kept;
}

# --- sph.cyr ---

# sph.cyr — `SphSolver` of rust-old/src/sph.rs (M5): the stateful SPH solver on part b's neighbour grid.
#
# M5 part a: the solver's state and constructors, its WCSPH `step` (symplectic Euler or velocity Verlet, with the CSF
# surface tension), the neighbour lists it leaves for M4 part d's functions, and `adaptive_dt`. PCISPH (part b) is in
# src/sph_pcisph.cyr, DFSPH (part c) in src/sph_dfsph.cyr and the multiphase step (part d) in src/sph_multiphase.cyr.
# Part e runs Rust's three `parallel` loops (this step's densities and forces, the multiphase step's forces) on the
# solver's worker pool (src/par.cyr; ADR 0002 #4): every particle is written by one thread, so any thread count gives
# the serial bits.
#
# Every buffer is the solver's and reused across steps: the grid's columns, the densities, the snapshot the forces
# read, the accelerations (a per-step `Vec` in Rust, port plan §7.5), and Verlet's previous accelerations. A step
# grows them all before it changes a particle, so `PV_ERR_OUT_OF_MEMORY` (where Rust aborts) leaves the particles as
# they were.

# The SPH solver: the neighbour grid (first, so its address is the solver's), the densities (one word a particle), the
# snapshot (18 words a particle), the accelerations and Verlet's previous ones (3 words a particle), PCISPH's
# non-pressure accelerations, pressures, predicted positions and velocities (M5 part b), DFSPH's α and κ factors (part
# c), the surface tension coefficient (0 disables it), whether to integrate by velocity Verlet, and (Cyrius-only, part
# e) the thread count and its pool (`set_threads`). Mirrors `SphSolver`; its `surface_tension` and `use_verlet` are
# public, as Rust's.
struct PvSphSolver {
    grid: PvNeighborGrid;
    densities: PvColumn;
    snapshot: PvColumn;
    accels: PvColumn;
    prev_accel: PvColumn;
    pcisph_accel: PvColumn;
    pcisph_pressures: PvColumn;
    pcisph_pred_pos: PvColumn;
    pcisph_pred_vel: PvColumn;
    dfsph_alpha: PvColumn;
    dfsph_kappa: PvColumn;
    surface_tension: f64;
    use_verlet;
    threads;
    pool;
}

# The solver's column count after its grid.
const _PV_SOLVER_COLUMNS = 10;

# The solver's neighbour grid, at offset 0.
#must_use
fn _pv_sph_grid(s): *PvNeighborGrid {
    return _pv_addr(s);
}

# Column k of a solver (0 densities, 1 snapshot, 2 accels, 3 prev_accel, 4 pcisph_accel, 5 pcisph_pressures,
# 6 pcisph_pred_pos, 7 pcisph_pred_vel, 8 dfsph_alpha, 9 dfsph_kappa), by its byte offset after the 224-byte grid
# (tests/sph.tcyr pins the layout, 496 bytes).
#must_use
fn _pv_sph_col(s, k): *PvColumn {
    return _pv_as_columns(_pv_addr(s) + sizeof(PvNeighborGrid) + k * 24);
}

# A fresh solver into *s: an empty grid of cell size 1, no buffers, no surface tension, symplectic Euler, one thread.
# Nothing is allocated.
fn PvSphSolver_init(s: *PvSphSolver) {
    PvNeighborGrid_init(_pv_sph_grid(s));
    for (var k = 0; k < _PV_SOLVER_COLUMNS; k = k + 1) {
        var c: *PvColumn = _pv_sph_col(s, k);
        c.data = 0;
        c.len = 0;
        c.cap = 0;
    }
    s.surface_tension = 0.0;
    s.use_verlet = 0;
    s.threads = 1;
    s.pool = 0;
    return 0;
}

# A new solver (nothing allocated until its first step). Mirrors `SphSolver::new`.
#must_use
fn PvSphSolver_new(): PvSphSolver {
    var s: PvSphSolver;
    PvSphSolver_init(&s);
    return s;
}

# A new solver with surface tension σ. Mirrors `SphSolver::with_surface_tension`.
#must_use
fn PvSphSolver_with_surface_tension(surface_tension: f64): PvSphSolver {
    var s: PvSphSolver;
    PvSphSolver_init(&s);
    s.surface_tension = surface_tension;
    return s;
}

# `SphSolver::new()`. Mirrors `impl Default for SphSolver`.
#must_use
fn PvSphSolver_default(): PvSphSolver {
    var s: PvSphSolver;
    PvSphSolver_init(&s);
    return s;
}

# Releases the solver's buffers and stops its pool; it is a fresh solver again, keeping its settings (its thread count
# among them: the next step starts a new pool) and its grid's cell size.
fn PvSphSolver_drop(s: *PvSphSolver) {
    _pv_pool_drop(s.pool);
    s.pool = 0;
    PvNeighborGrid_drop(_pv_sph_grid(s));
    for (var k = 0; k < _PV_SOLVER_COLUMNS; k = k + 1) {
        var c: *PvColumn = _pv_sph_col(s, k);
        c.drop();
    }
    return 0;
}

# The solver's pool for its thread count, started by the first step after `set_threads` (one that can't be started
# leaves the solver serial, which gives the same bits): its pointer, or 0 to run serially.
fn _pv_sph_pool(s: *PvSphSolver): i64 {
    if (s.threads > 1 && s.pool == 0) {
        s.pool = _pv_pool_new(s.threads);
        if (s.pool == 0) { s.threads = 1; }
    }
    return s.pool;
}

# Packs a density kernel's context (the particles, offsets, indices, densities, coefficients) into the 5 words at ctx.
fn _pv_sph_density_ctx(ctx, ps: *PvFluidParticle, off, idx, dens, kc: *_PvKernelCoeffs) {
    store64(ctx, _pv_addr(ps));
    store64(ctx + 8, off);
    store64(ctx + 16, idx);
    store64(ctx + 24, dens);
    store64(ctx + 32, _pv_addr(kc));
    return 0;
}

# The densities of particles [a, b) (a `_pv_par_for` kernel, the first of Rust's three `parallel` loops): ctx holds the
# particles, the lists' offsets and indices, the densities column and the kernel coefficients. Each index writes only
# its own density, Σ over its list (itself included) of mⱼ·poly6(r²) for r² ≤ h². The multiphase step runs it serially,
# as Rust does.
fn _pv_sph_density_k(ctx, a, b) {
    var ps: *PvFluidParticle = _pv_as_particles(load64(ctx));
    var off = load64(ctx + 8);
    var idx = load64(ctx + 16);
    var dens = load64(ctx + 24);
    var kc: *_PvKernelCoeffs = _pv_as_kc(load64(ctx + 32));
    var h2: f64 = kc.h2;
    for (var i = a; i < b; i = i + 1) {
        var pi: *PvFluidParticle = ps + i;
        var px: f64 = pi.position.x;
        var py: f64 = pi.position.y;
        var pz: f64 = pi.position.z;
        var d: f64 = 0.0;
        var ka = load64(off + i * 8);
        var kb = load64(off + (i + 1) * 8);
        for (var k = ka; k < kb; k = k + 1) {
            var pj: *PvFluidParticle = ps + load64(idx + k * 8);
            var dx: f64 = px - pj.position.x;
            var dy: f64 = py - pj.position.y;
            var dz: f64 = pz - pj.position.z;
            var r2: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
            if (r2 <= h2) {
                var w: f64 = _pv_kc_poly6(kc, r2);
                var mw: f64 = pj.mass * w;
                d = d + mw;
            }
        }
        store64(dens + i * 8, _pv_bits(d));
    }
    return 0;
}

# The accelerations of particles [a, b) from the snapshot (a `_pv_par_for` kernel, the second of Rust's three
# `parallel` loops): ctx holds the snapshot, the lists' offsets and indices, the accelerations column, the kernel
# coefficients, the config, the viscosity, σ, the CSF flag and ∇²W(0). Each index writes only its own three words.
fn _pv_sph_accel_k(ctx, a, b) {
    var snap: *PvFluidParticle = _pv_as_particles(load64(ctx));
    var off = load64(ctx + 8);
    var idx = load64(ctx + 16);
    var acc = load64(ctx + 24);
    var kc: *_PvKernelCoeffs = _pv_as_kc(load64(ctx + 32));
    var config: *PvFluidConfig = _pv_as_config(load64(ctx + 40));
    var viscosity: f64 = load64(ctx + 48);
    var st: f64 = load64(ctx + 56);
    var csf = load64(ctx + 64);
    var lap0: f64 = load64(ctx + 72);
    var h2: f64 = kc.h2;
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var lo: f64 = _PV_SPH_MIN_DENSITY;
    for (var q = a; q < b; q = q + 1) {
        var si: *PvFluidParticle = snap + q;
        var ax: f64 = config.gravity.x;
        var ay: f64 = config.gravity.y;
        var az: f64 = config.gravity.z;
        var rho: f64 = _pv_max(si.density, lo);
        var api: f64 = si.pressure / (rho * rho);
        var sx: f64 = si.position.x;
        var sy: f64 = si.position.y;
        var sz: f64 = si.position.z;
        var vx: f64 = si.velocity.x;
        var vy: f64 = si.velocity.y;
        var vz: f64 = si.velocity.z;
        var cnx: f64 = 0.0;
        var cny: f64 = 0.0;
        var cnz: f64 = 0.0;
        var lapc: f64 = 0.0;
        if (csf == 1) { lapc = (si.mass / rho) * lap0; }
        var a2 = load64(off + q * 8);
        var b2 = load64(off + (q + 1) * 8);
        for (var k2 = a2; k2 < b2; k2 = k2 + 1) {
            var j = load64(idx + k2 * 8);
            if (j != q) {
                var sj: *PvFluidParticle = snap + j;
                var ex: f64 = sx - sj.position.x;
                var ey: f64 = sy - sj.position.y;
                var ez: f64 = sz - sj.position.z;
                var s2: f64 = ((ex * ex) + (ey * ey)) + (ez * ez);
                if ((s2 > h2 || s2 < tiny) == 0) {
                    var r: f64 = f64_sqrt(s2);
                    var rho_j: f64 = _pv_max(sj.density, lo);
                    var bj: f64 = sj.pressure / (rho_j * rho_j);
                    var sym: f64 = api + bj;
                    var grad: f64 = _pv_kc_spiky_grad(kc, r);
                    var mj: f64 = sj.mass;
                    var nmj: f64 = -mj;
                    var p_scale: f64 = ((nmj * sym) * grad) / r;
                    ax = ax + (p_scale * ex);
                    ay = ay + (p_scale * ey);
                    az = az + (p_scale * ez);
                    var lap: f64 = _pv_kc_visc_lap(kc, r);
                    var v_scale: f64 = (((viscosity * mj) * lap) / rho_j) / rho;
                    var ux: f64 = sj.velocity.x - vx;
                    var uy: f64 = sj.velocity.y - vy;
                    var uz: f64 = sj.velocity.z - vz;
                    ax = ax + (v_scale * ux);
                    ay = ay + (v_scale * uy);
                    az = az + (v_scale * uz);
                    if (csf == 1) {
                        var mor: f64 = mj / rho_j;
                        var pg: f64 = _pv_kc_poly6_grad(kc, s2);
                        var mpg: f64 = mor * pg;
                        cnx = cnx + (mpg * ex);
                        cny = cny + (mpg * ey);
                        cnz = cnz + (mpg * ez);
                        var pl: f64 = _pv_kc_poly6_lap(kc, s2);
                        lapc = lapc + (mor * pl);
                    }
                }
            }
        }
        var ast: PvVec3 = _pv_csf_acceleration(cnx, cny, cnz, lapc, st, rho, kc.h);
        var fx: f64 = ax + ast.x;
        var fy: f64 = ay + ast.y;
        var fz: f64 = az + ast.z;
        store64(acc + q * 24, _pv_bits(fx));
        store64(acc + q * 24 + 8, _pv_bits(fy));
        store64(acc + q * 24 + 16, _pv_bits(fz));
    }
    return 0;
}

# The CSR neighbour lists of a solver's last step: offsets (n_off words) and indices (n_idx words), the forms M4 part
# d's functions take. Rust's `(&[u32], &[usize])`.
struct PvNeighborLists {
    offsets;
    n_off;
    indices;
    n_idx;
}

impl PvSphSolver {
    # Sets the thread count the steps use: n ≥ 1 (a count below 1 is 1, serial). Any count gives the serial bits. The
    # solver's pool stops now, and the next step starts one of the new size (or runs serially where threads can't
    # start: src/par.cyr). Returns the count. Cyrius-only: Rust's `parallel` feature is compile-time (port plan D6,
    # ADR 0002 #4).
    fn set_threads(self, n): i64 {
        var t = n;
        if (t < 1) { t = 1; }
        _pv_pool_drop(self.pool);
        self.pool = 0;
        self.threads = t;
        return t;
    }

    # Forgets Verlet's previous accelerations, so a step after the particles were reordered, split or merged starts
    # the integrator afresh. Mirrors `reset_integrator`.
    fn reset_integrator(self) {
        self.prev_accel.truncate(0);
        return 0;
    }

    # The neighbour lists from the most recent step: particle i's neighbours are indices[offsets[i] .. offsets[i + 1]]
    # (empty before a first step). Mirrors `neighbor_lists`.
    #must_use
    fn neighbor_lists(self): PvNeighborLists {
        var g: *PvNeighborGrid = _pv_sph_grid(self);
        var l: PvNeighborLists;
        l.offsets = g.offsets.data;
        l.n_off = g.offsets.len;
        l.indices = g.indices.data;
        l.n_idx = g.indices.len;
        return l;
    }

    # One WCSPH step of the n particles at ps, in Rust's order:
    # - the config is validated (its error returned, nothing changed); n = 0 is Ok; h as f32 must be finite and > 0
    #   (PV_ERR_INVALID_SMOOTHING_RADIUS, for h beyond f32's range either side);
    # - the neighbour lists (`_pv_nb_build`: f64 keys, ADR 0002 #2);
    # - each density, Σ over its list (itself included) of mⱼ·poly6(r²) for r² ≤ h², then each pressure by the linear
    #   equation of state;
    # - from a snapshot, each acceleration: gravity, the symmetric pressure and viscosity terms of the free step over
    #   the list (j ≠ i, 1e-20 ≤ r² ≤ h²), and, for σ > 0, the CSF term from the colour field (its Laplacian starting
    #   at the self term (mᵢ/ρᵢ)·∇²W(0)), always added (+0 when off, as Rust's `+ DVec3::ZERO`);
    # - PV_ERR_DIVERGED at the first non-finite acceleration (those before it written, as Rust's);
    # - symplectic Euler, or velocity Verlet (vₙ = ṽₙ + (½(aₙ − aₙ₋₁))·dt once started, x += v·dt + ((½a)·dt)·dt,
    #   v += a·dt), the previous accelerations restarted (zero) when their count isn't n;
    # - the free step's walls.
    # Ok(0); the errors above; or PV_ERR_OUT_OF_MEMORY when a buffer can't grow, before any particle changes (Rust
    # aborts). Mirrors `step` (ADR 0002 #19).
    #must_use
    fn step(self, ps: *PvFluidParticle, n, config: *PvFluidConfig, viscosity: f64): Result {
        var trace = _pv_span(_PV_LOG_SPH, "sph::solver_step", "n", n, 0, 0, 0, 0);
        var ct, cv = config.validate();
        if (is_err_result(ct) == 1) { _pv_span_end(trace); return Err(cv); }
        if (n <= 0) { _pv_span_end(trace); return Ok(0); }
        var h: f64 = config.smoothing_radius;
        var h32: f32 = f32_from(h);
        var hw: f64 = f32_to(h32);
        if (_pv_is_positive(hw) == 0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_SMOOTHING_RADIUS); }
        if (n > 9223372036854775807 / 144) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
        var zero: f64 = 0.0;
        var zw = _pv_bits(zero);
        var ok = self.densities.resize(n, zw) & self.snapshot.resize(18 * n, 0) & self.accels.resize(3 * n, zw);
        if (self.use_verlet != 0) { ok = ok & self.prev_accel.reserve(3 * n); }
        if (ok == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
        var g: *PvNeighborGrid = _pv_sph_grid(self);
        var tb = _pv_span(_PV_LOG_SPH, "sph::build_neighbors", "n", n, 0, 0, 0, 0);
        var built = _pv_nb_build(g, ps, n, h);
        _pv_span_end(tb);
        if (built == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
        var kc: _PvKernelCoeffs;
        _pv_kc_init(&kc, h);
        var off = g.offsets.data;
        var idx = g.indices.data;
        var dens = self.densities.data;

        # The densities (on the pool), then the pressures.
        var td = _pv_span(_PV_LOG_SPH, "sph::density", "n", n, 0, 0, 0, 0);
        var pool = _pv_sph_pool(self);
        var dctx[40];
        _pv_sph_density_ctx(&dctx, ps, off, idx, dens, &kc);
        _pv_par_for(pool, 0, n, &_pv_sph_density_k, &dctx);
        var rest: f64 = config.rest_density;
        var gas: f64 = config.gas_constant;
        var snap: *PvFluidParticle = _pv_as_particles(self.snapshot.data);
        for (var i2 = 0; i2 < n; i2 = i2 + 1) {
            var p: *PvFluidParticle = ps + i2;
            p.density = load64(dens + i2 * 8);
            var pr: f64 = equation_of_state(p.density, rest, gas);
            p.pressure = pr;
            var sq: *PvFluidParticle = snap + i2;
            *sq = *p;
        }

        _pv_span_end(td);

        # The accelerations, from the snapshot, into the solver's buffer (on the pool).
        var tf = _pv_span(_PV_LOG_SPH, "sph::forces", "n", n, 0, 0, 0, 0);
        var acc = self.accels.data;
        var st: f64 = self.surface_tension;
        var csf = 0;
        if (st > 0.0) { csf = 1; }
        var lap0: f64 = _pv_kc_poly6_lap(&kc, 0.0);
        var actx[80];
        store64(&actx, _pv_addr(snap));
        store64(&actx + 8, off);
        store64(&actx + 16, idx);
        store64(&actx + 24, acc);
        store64(&actx + 32, _pv_addr(&kc));
        store64(&actx + 40, _pv_addr(config));
        store64(&actx + 48, _pv_bits(viscosity));
        store64(&actx + 56, _pv_bits(st));
        store64(&actx + 64, csf);
        store64(&actx + 72, _pv_bits(lap0));
        _pv_par_for(pool, 0, n, &_pv_sph_accel_k, &actx);
        for (var c = 0; c < n; c = c + 1) {
            var gx: f64 = load64(acc + c * 24);
            var gy: f64 = load64(acc + c * 24 + 8);
            var gz: f64 = load64(acc + c * 24 + 16);
            if (_pv_is_finite(gx) == 0 || _pv_is_finite(gy) == 0 || _pv_is_finite(gz) == 0) {
                _pv_span_end(tf);
                _pv_span_end(trace); return Err(PV_ERR_DIVERGED);
            }
            var w: *PvFluidParticle = ps + c;
            w.acceleration = PvVec3_new(gx, gy, gz);
        }
        _pv_span_end(tf);

        # Integrate.
        var dt: f64 = config.dt;
        if (self.use_verlet != 0) {
            var started = 0;
            if (self.prev_accel.len == 3 * n) { started = 1; }
            if (started == 0) {
                self.prev_accel.truncate(0);
                var grown = self.prev_accel.resize(3 * n, zw);
            }
            var prev = self.prev_accel.data;
            for (var v = 0; v < n; v = v + 1) {
                var pv: *PvFluidParticle = ps + v;
                var aax: f64 = pv.acceleration.x;
                var aay: f64 = pv.acceleration.y;
                var aaz: f64 = pv.acceleration.z;
                var wx: f64 = pv.velocity.x;
                var wy: f64 = pv.velocity.y;
                var wz: f64 = pv.velocity.z;
                if (started == 1) {
                    var qx: f64 = load64(prev + v * 24);
                    var qy: f64 = load64(prev + v * 24 + 8);
                    var qz: f64 = load64(prev + v * 24 + 16);
                    wx = wx + ((0.5 * (aax - qx)) * dt);
                    wy = wy + ((0.5 * (aay - qy)) * dt);
                    wz = wz + ((0.5 * (aaz - qz)) * dt);
                }
                var mx: f64 = pv.position.x + ((wx * dt) + (((0.5 * aax) * dt) * dt));
                var my: f64 = pv.position.y + ((wy * dt) + (((0.5 * aay) * dt) * dt));
                var mz: f64 = pv.position.z + ((wz * dt) + (((0.5 * aaz) * dt) * dt));
                pv.position.x = mx;
                pv.position.y = my;
                pv.position.z = mz;
                pv.velocity.x = wx + (aax * dt);
                pv.velocity.y = wy + (aay * dt);
                pv.velocity.z = wz + (aaz * dt);
                store64(prev + v * 24, _pv_bits(aax));
                store64(prev + v * 24 + 8, _pv_bits(aay));
                store64(prev + v * 24 + 16, _pv_bits(aaz));
            }
        } else {
            for (var e = 0; e < n; e = e + 1) {
                var pe: *PvFluidParticle = ps + e;
                var nvx: f64 = pe.velocity.x + (pe.acceleration.x * dt);
                var nvy: f64 = pe.velocity.y + (pe.acceleration.y * dt);
                var nvz: f64 = pe.velocity.z + (pe.acceleration.z * dt);
                pe.velocity.x = nvx;
                pe.velocity.y = nvy;
                pe.velocity.z = nvz;
                pe.position.x = pe.position.x + (nvx * dt);
                pe.position.y = pe.position.y + (nvy * dt);
                pe.position.z = pe.position.z + (nvz * dt);
            }
        }
        _pv_sph_walls(ps, n, config);
        _pv_span_end(trace); return Ok(0);
    }
}

# The CSF surface-tension acceleration (Müller et al. 2003): −σ·∇²c·n̂/ρ, i.e. n·(((−σ)·∇²c)/(ρ·|n|)) for the colour
# normal n = (nx, ny, nz); 0 for σ not finite and > 0, |n| NaN, or |n| ≤ 0.1/h (an interior particle). Mirrors the
# private `csf_acceleration`.
#must_use
fn _pv_csf_acceleration(nx: f64, ny: f64, nz: f64, laplacian: f64, sigma: f64, rho: f64, h: f64): PvVec3 {
    var l2: f64 = ((nx * nx) + (ny * ny)) + (nz * nz);
    var mag: f64 = f64_sqrt(l2);
    var thr: f64 = _PV_SPH_CSF_NORMAL_THRESHOLD / h;
    if (_pv_is_positive(sigma) == 0 || mag != mag || mag <= thr) { return PvVec3_zero(); }
    var ns: f64 = -sigma;
    var s: f64 = (ns * laplacian) / (rho * mag);
    return PvVec3_new(nx * s, ny * s, nz * s);
}

# The domain's walls on the n particles: per axis, below the low corner the position clamped to it and the velocity
# times −damping; else above the high corner (when it is above the low one), the same at the high corner. The free
# step's and the solver's.
fn _pv_sph_walls(ps: *PvFluidParticle, n, config: *PvFluidConfig) {
    var damp: f64 = config.boundary_damping;
    var nd: f64 = -damp;
    var lx: f64 = config.bounds_min.x;
    var ly: f64 = config.bounds_min.y;
    var lz: f64 = config.bounds_min.z;
    var hx: f64 = config.bounds_max.x;
    var hy: f64 = config.bounds_max.y;
    var hz: f64 = config.bounds_max.z;
    for (var m = 0; m < n; m = m + 1) {
        var w: *PvFluidParticle = ps + m;
        if (w.position.x < lx) {
            w.position.x = lx;
            w.velocity.x = w.velocity.x * nd;
        } elif (w.position.x > hx && hx > lx) {
            w.position.x = hx;
            w.velocity.x = w.velocity.x * nd;
        }
        if (w.position.y < ly) {
            w.position.y = ly;
            w.velocity.y = w.velocity.y * nd;
        } elif (w.position.y > hy && hy > ly) {
            w.position.y = hy;
            w.velocity.y = w.velocity.y * nd;
        }
        if (w.position.z < lz) {
            w.position.z = lz;
            w.velocity.z = w.velocity.z * nd;
        } elif (w.position.z > hz && hz > lz) {
            w.position.z = hz;
            w.velocity.z = w.velocity.z * nd;
        }
    }
    return 0;
}

# The CFL-limited timestep cfl·min(h/v_max, √(h/a_max), h²/(6ν)) over the n particles, each term only where its
# denominator exceeds 1e-20 (from f64::MAX, NaN-ignoring), clamped to [dt_min, dt_max] (swapped when inverted; a NaN
# stays NaN). max(dt_max, dt_min) for h or cfl not finite and > 0, or a bound not finite. Mirrors
# `SphSolver::adaptive_dt` (an associated fn).
#must_use
fn PvSphSolver_adaptive_dt(ps: *PvFluidParticle, n, smoothing_radius: f64, viscosity: f64, cfl_factor: f64,
  dt_min: f64, dt_max: f64): f64 {
    var h: f64 = smoothing_radius;
    if (_pv_is_positive(h) == 0 || _pv_is_positive(cfl_factor) == 0 || _pv_is_finite(dt_min) == 0
      || _pv_is_finite(dt_max) == 0) {
        var both: f64 = _pv_max(dt_max, dt_min);
        return both;
    }
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var dt_cfl: f64 = PV_F64_MAX;
    var max_v: f64 = max_speed(ps, n);
    if (max_v > tiny) {
        var t1: f64 = h / max_v;
        dt_cfl = _pv_min(dt_cfl, t1);
    }
    var m2: f64 = 0.0;
    for (var i = 0; i < n; i = i + 1) {
        var p: *PvFluidParticle = ps + i;
        var a2: f64 = ((p.acceleration.x * p.acceleration.x) + (p.acceleration.y * p.acceleration.y))
        + (p.acceleration.z * p.acceleration.z);
        m2 = _pv_max(m2, a2);
    }
    var max_a: f64 = f64_sqrt(m2);
    if (max_a > tiny) {
        var q: f64 = h / max_a;
        var t2: f64 = f64_sqrt(q);
        dt_cfl = _pv_min(dt_cfl, t2);
    }
    if (viscosity > tiny) {
        var t3: f64 = (h * h) / (6.0 * viscosity);
        dt_cfl = _pv_min(dt_cfl, t3);
    }
    var lo: f64 = dt_min;
    var hi: f64 = dt_max;
    if ((dt_min <= dt_max) == 0) {
        lo = dt_max;
        hi = dt_min;
    }
    var raw: f64 = cfl_factor * dt_cfl;
    var r: f64 = _pv_clamp(raw, lo, hi);
    return r;
}

# --- sph_pcisph.cyr ---

# sph_pcisph.cyr — `SphSolver::step_pcisph` of rust-old/src/sph.rs (M5 part b): Predictive-Corrective Incompressible
# SPH (Solenthaler & Pajarola 2009), on the solver of src/sph.cyr.
#
# Rust's order throughout:
# - the densities over the neighbour lists, the pressures zeroed;
# - from a snapshot, the non-pressure accelerations (gravity, viscosity, the CSF surface tension; no pressure term);
# - the pressure factor δ = 1/(β·(|Σ∇W|² + Σ|∇W|²)), β = 2·((dt·m)/ρ₀)², from the prototype particle with the fullest
#   neighbourhood (ties to the larger denominator, the first kept);
# - at least one correction iteration: predict, measure the compression, raise the pressures; a last prediction with
#   the final pressures when it didn't converge;
# - the predicted velocities and positions and the pressures applied (the accelerations are not written), then the
#   walls.
# The four PCISPH buffers are the solver's, grown with the others before any particle changes.

# The PCISPH prediction for each of the n snapshot particles: the symmetric pressure acceleration of `pressures` over
# the lists (j ≠ i, 1e-20 ≤ r² ≤ h², each ρ floored at 1e-10), then v* = v + (a_np + a_p)·dt and x* = x + v*·dt from the
# snapshot's velocity and position. Mirrors the private `pcisph_predict`.
fn _pv_pcisph_predict(s: *PvSphSolver, n, kc: *_PvKernelCoeffs, dt: f64) {
    var g: *PvNeighborGrid = _pv_sph_grid(s);
    var off = g.offsets.data;
    var idx = g.indices.data;
    var snap: *PvFluidParticle = _pv_as_particles(s.snapshot.data);
    var pres = s.pcisph_pressures.data;
    var npa = s.pcisph_accel.data;
    var pos = s.pcisph_pred_pos.data;
    var vel = s.pcisph_pred_vel.data;
    var h2: f64 = kc.h2;
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var lo: f64 = _PV_SPH_MIN_DENSITY;
    for (var i = 0; i < n; i = i + 1) {
        var pi: *PvFluidParticle = snap + i;
        var rho: f64 = _pv_max(pi.density, lo);
        var pri: f64 = load64(pres + i * 8);
        var ai: f64 = pri / (rho * rho);
        var pax: f64 = 0.0;
        var pay: f64 = 0.0;
        var paz: f64 = 0.0;
        var a = load64(off + i * 8);
        var b = load64(off + (i + 1) * 8);
        for (var k = a; k < b; k = k + 1) {
            var j = load64(idx + k * 8);
            if (j != i) {
                var pj: *PvFluidParticle = snap + j;
                var dx: f64 = pi.position.x - pj.position.x;
                var dy: f64 = pi.position.y - pj.position.y;
                var dz: f64 = pi.position.z - pj.position.z;
                var r2: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
                if ((r2 > h2 || r2 < tiny) == 0) {
                    var r: f64 = f64_sqrt(r2);
                    var rho_j: f64 = _pv_max(pj.density, lo);
                    var prj: f64 = load64(pres + j * 8);
                    var bj: f64 = prj / (rho_j * rho_j);
                    var sym: f64 = ai + bj;
                    var grad: f64 = _pv_kc_spiky_grad(kc, r);
                    var mj: f64 = pj.mass;
                    var nmj: f64 = -mj;
                    var sc: f64 = ((nmj * sym) * grad) / r;
                    pax = pax + (dx * sc);
                    pay = pay + (dy * sc);
                    paz = paz + (dz * sc);
                }
            }
        }
        var nx: f64 = load64(npa + i * 24);
        var ny: f64 = load64(npa + i * 24 + 8);
        var nz: f64 = load64(npa + i * 24 + 16);
        var vx: f64 = pi.velocity.x + ((nx + pax) * dt);
        var vy: f64 = pi.velocity.y + ((ny + pay) * dt);
        var vz: f64 = pi.velocity.z + ((nz + paz) * dt);
        store64(vel + i * 24, _pv_bits(vx));
        store64(vel + i * 24 + 8, _pv_bits(vy));
        store64(vel + i * 24 + 16, _pv_bits(vz));
        var xx: f64 = pi.position.x + (vx * dt);
        var xy: f64 = pi.position.y + (vy * dt);
        var xz: f64 = pi.position.z + (vz * dt);
        store64(pos + i * 24, _pv_bits(xx));
        store64(pos + i * 24 + 8, _pv_bits(xy));
        store64(pos + i * 24 + 16, _pv_bits(xz));
    }
    return 0;
}

# The PCISPH pressure factor δ over the n snapshot particles: for each with a neighbour (j ≠ i, 1e-20 ≤ r² ≤ h²),
# denom = β·(|Σ∇W|² + Σ|∇W|²) with ∇W = (W'(r)/r)·(xᵢ − xⱼ) and β = 2·((dt·mᵢ)/ρ₀)² (`powi(2)`, a square); the
# prototype is the first with the most neighbours and, among those, the largest denom, counting only |denom| > 1e-20.
# 1/denom of the prototype, or 0 without one. Mirrors `step_pcisph`'s δ block.
#must_use
fn _pv_pcisph_delta(s: *PvSphSolver, n, kc: *_PvKernelCoeffs, dt: f64, rest_density: f64): f64 {
    var g: *PvNeighborGrid = _pv_sph_grid(s);
    var off = g.offsets.data;
    var idx = g.indices.data;
    var snap: *PvFluidParticle = _pv_as_particles(s.snapshot.data);
    var h2: f64 = kc.h2;
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var found = 0;
    var best_count = 0;
    var best_denom: f64 = 0.0;
    for (var i = 0; i < n; i = i + 1) {
        var pi: *PvFluidParticle = snap + i;
        var sgx: f64 = 0.0;
        var sgy: f64 = 0.0;
        var sgz: f64 = 0.0;
        var sq: f64 = 0.0;
        var count = 0;
        var a = load64(off + i * 8);
        var b = load64(off + (i + 1) * 8);
        for (var k = a; k < b; k = k + 1) {
            var j = load64(idx + k * 8);
            if (j != i) {
                var pj: *PvFluidParticle = snap + j;
                var dx: f64 = pi.position.x - pj.position.x;
                var dy: f64 = pi.position.y - pj.position.y;
                var dz: f64 = pi.position.z - pj.position.z;
                var r2: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
                if ((r2 > h2 || r2 < tiny) == 0) {
                    count = count + 1;
                    var r: f64 = f64_sqrt(r2);
                    var grad: f64 = _pv_kc_spiky_grad(kc, r);
                    var gr: f64 = grad / r;
                    var gx: f64 = gr * dx;
                    var gy: f64 = gr * dy;
                    var gz: f64 = gr * dz;
                    sgx = sgx + gx;
                    sgy = sgy + gy;
                    sgz = sgz + gz;
                    var g2: f64 = ((gx * gx) + (gy * gy)) + (gz * gz);
                    sq = sq + g2;
                }
            }
        }
        if (count > 0) {
            var dot: f64 = ((sgx * sgx) + (sgy * sgy)) + (sgz * sgz);
            var q: f64 = (dt * pi.mass) / rest_density;
            var beta: f64 = 2.0 * (q * q);
            var denom: f64 = beta * (dot + sq);
            var ad: f64 = f64_abs(denom);
            if (ad > tiny) {
                var better = 0;
                if (found == 0 || count > best_count) {
                    better = 1;
                } elif (count == best_count && denom > best_denom) {
                    better = 1;
                }
                if (better == 1) {
                    found = 1;
                    best_count = count;
                    best_denom = denom;
                }
            }
        }
    }
    if (found == 0) {
        var zero: f64 = 0.0;
        return zero;
    }
    var delta: f64 = 1.0 / best_denom;
    return delta;
}

impl PvSphSolver {
    # One PCISPH step of the n particles at ps (the file's header gives the order): at most max(max_iterations, 1)
    # correction iterations, converging when the largest relative compression max(ρ* − ρ₀, 0)/ρ₀ (NaN-ignoring) is
    # below `max_density_error`; each raises pᵢ to max(pᵢ + (ρ*ᵢ − ρ₀)·δ, 0) (NaN-ignoring). Ok(0); the config's error
    # (nothing changed); PV_ERR_INVALID_SMOOTHING_RADIUS for h as f32 not finite and > 0; PV_ERR_OUT_OF_MEMORY when a
    # buffer can't grow, before any particle changes (Rust aborts); PV_ERR_DIVERGED at the first non-finite
    # non-pressure acceleration (the densities set, the pressures 0) or predicted position (the particles before it
    # moved), as Rust's. Mirrors `step_pcisph` (ADR 0002 #20).
    #must_use
    fn step_pcisph(self, ps: *PvFluidParticle, n, config: *PvFluidConfig, viscosity: f64, max_iterations,
      max_density_error: f64): Result {
        var trace = _pv_span(_PV_LOG_SPH, "sph::pcisph", "n", n, 0, 0, 0, 0);
        var ct, cv = config.validate();
        if (is_err_result(ct) == 1) { _pv_span_end(trace); return Err(cv); }
        if (n <= 0) { _pv_span_end(trace); return Ok(0); }
        var h: f64 = config.smoothing_radius;
        var h32: f32 = f32_from(h);
        var hw: f64 = f32_to(h32);
        if (_pv_is_positive(hw) == 0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_SMOOTHING_RADIUS); }
        if (n > 9223372036854775807 / 144) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
        var zero: f64 = 0.0;
        var zw = _pv_bits(zero);
        var ok = self.densities.resize(n, zw) & self.snapshot.resize(18 * n, 0);
        ok = ok & self.pcisph_accel.resize(3 * n, zw) & self.pcisph_pressures.resize(n, zw);
        ok = ok & self.pcisph_pred_pos.resize(3 * n, zw) & self.pcisph_pred_vel.resize(3 * n, zw);
        if (ok == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
        var g: *PvNeighborGrid = _pv_sph_grid(self);
        var tb = _pv_span(_PV_LOG_SPH, "sph::build_neighbors", "n", n, 0, 0, 0, 0);
        var built = _pv_nb_build(g, ps, n, h);
        _pv_span_end(tb);
        if (built == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
        var kc: _PvKernelCoeffs;
        _pv_kc_init(&kc, h);
        var h2: f64 = kc.h2;
        var dt: f64 = config.dt;
        var rest: f64 = config.rest_density;
        var off = g.offsets.data;
        var idx = g.indices.data;
        var dens = self.densities.data;

        # The densities; the pressures start at 0.
        for (var i = 0; i < n; i = i + 1) {
            var pi: *PvFluidParticle = ps + i;
            var d: f64 = 0.0;
            var a = load64(off + i * 8);
            var b = load64(off + (i + 1) * 8);
            for (var k = a; k < b; k = k + 1) {
                var pj: *PvFluidParticle = ps + load64(idx + k * 8);
                var dx: f64 = pi.position.x - pj.position.x;
                var dy: f64 = pi.position.y - pj.position.y;
                var dz: f64 = pi.position.z - pj.position.z;
                var r2: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
                if (r2 <= h2) {
                    var w: f64 = _pv_kc_poly6(&kc, r2);
                    var mw: f64 = pj.mass * w;
                    d = d + mw;
                }
            }
            store64(dens + i * 8, _pv_bits(d));
        }
        var snap: *PvFluidParticle = _pv_as_particles(self.snapshot.data);
        for (var i2 = 0; i2 < n; i2 = i2 + 1) {
            var p: *PvFluidParticle = ps + i2;
            p.density = load64(dens + i2 * 8);
            p.pressure = 0.0;
            var sq: *PvFluidParticle = snap + i2;
            *sq = *p;
        }

        # The non-pressure accelerations: gravity, viscosity, surface tension.
        var npa = self.pcisph_accel.data;
        var st: f64 = self.surface_tension;
        var csf = 0;
        if (st > 0.0) { csf = 1; }
        var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
        var lo: f64 = _PV_SPH_MIN_DENSITY;
        var lap0: f64 = _pv_kc_poly6_lap(&kc, 0.0);
        for (var q = 0; q < n; q = q + 1) {
            var si: *PvFluidParticle = snap + q;
            var ax: f64 = config.gravity.x;
            var ay: f64 = config.gravity.y;
            var az: f64 = config.gravity.z;
            var rho: f64 = _pv_max(si.density, lo);
            var cnx: f64 = 0.0;
            var cny: f64 = 0.0;
            var cnz: f64 = 0.0;
            var lapc: f64 = 0.0;
            if (csf == 1) { lapc = (si.mass / rho) * lap0; }
            var a2 = load64(off + q * 8);
            var b2 = load64(off + (q + 1) * 8);
            for (var k2 = a2; k2 < b2; k2 = k2 + 1) {
                var j = load64(idx + k2 * 8);
                if (j != q) {
                    var sj: *PvFluidParticle = snap + j;
                    var ex: f64 = si.position.x - sj.position.x;
                    var ey: f64 = si.position.y - sj.position.y;
                    var ez: f64 = si.position.z - sj.position.z;
                    var s2: f64 = ((ex * ex) + (ey * ey)) + (ez * ez);
                    if ((s2 > h2 || s2 < tiny) == 0) {
                        var r: f64 = f64_sqrt(s2);
                        var rho_j: f64 = _pv_max(sj.density, lo);
                        var lap: f64 = _pv_kc_visc_lap(&kc, r);
                        var v_scale: f64 = (((viscosity * sj.mass) * lap) / rho_j) / rho;
                        var ux: f64 = sj.velocity.x - si.velocity.x;
                        var uy: f64 = sj.velocity.y - si.velocity.y;
                        var uz: f64 = sj.velocity.z - si.velocity.z;
                        ax = ax + (v_scale * ux);
                        ay = ay + (v_scale * uy);
                        az = az + (v_scale * uz);
                        if (csf == 1) {
                            var mor: f64 = sj.mass / rho_j;
                            var pg: f64 = _pv_kc_poly6_grad(&kc, s2);
                            var mpg: f64 = mor * pg;
                            cnx = cnx + (mpg * ex);
                            cny = cny + (mpg * ey);
                            cnz = cnz + (mpg * ez);
                            var pl: f64 = _pv_kc_poly6_lap(&kc, s2);
                            lapc = lapc + (mor * pl);
                        }
                    }
                }
            }
            var ast: PvVec3 = _pv_csf_acceleration(cnx, cny, cnz, lapc, st, rho, kc.h);
            ax = ax + ast.x;
            ay = ay + ast.y;
            az = az + ast.z;
            if (_pv_is_finite(ax) == 0 || _pv_is_finite(ay) == 0 || _pv_is_finite(az) == 0) {
                _pv_span_end(trace); return Err(PV_ERR_DIVERGED);
            }
            store64(npa + q * 24, _pv_bits(ax));
            store64(npa + q * 24 + 8, _pv_bits(ay));
            store64(npa + q * 24 + 16, _pv_bits(az));
        }

        # The pressure correction.
        var delta: f64 = _pv_pcisph_delta(self, n, &kc, dt, rest);
        var pres = self.pcisph_pressures.data;
        for (var z = 0; z < n; z = z + 1) { store64(pres + z * 8, zw); }
        var pos = self.pcisph_pred_pos.data;
        var err = dens;   # Rust's `density_err` is the densities buffer
        var iterations = max_iterations;
        if (iterations < 1) { iterations = 1; }
        var converged = 0;
        for (var it = 0; it < iterations; it = it + 1) {
            var ti = _pv_span(_PV_LOG_SPH, "sph::pcisph_iter", "iter", it, 0, 0, 0, 0);
            _pv_pcisph_predict(self, n, &kc, dt);
            var max_error: f64 = 0.0;
            for (var c = 0; c < n; c = c + 1) {
                var cx: f64 = load64(pos + c * 24);
                var cy: f64 = load64(pos + c * 24 + 8);
                var cz: f64 = load64(pos + c * 24 + 16);
                var pd: f64 = 0.0;
                var a3 = load64(off + c * 8);
                var b3 = load64(off + (c + 1) * 8);
                for (var k3 = a3; k3 < b3; k3 = k3 + 1) {
                    var j3 = load64(idx + k3 * 8);
                    var jx: f64 = load64(pos + j3 * 24);
                    var jy: f64 = load64(pos + j3 * 24 + 8);
                    var jz: f64 = load64(pos + j3 * 24 + 16);
                    var fx: f64 = cx - jx;
                    var fy: f64 = cy - jy;
                    var fz: f64 = cz - jz;
                    var f2: f64 = ((fx * fx) + (fy * fy)) + (fz * fz);
                    if (f2 <= h2) {
                        var sm: *PvFluidParticle = snap + j3;
                        var w3: f64 = _pv_kc_poly6(&kc, f2);
                        var mw3: f64 = sm.mass * w3;
                        pd = pd + mw3;
                    }
                }
                var e: f64 = pd - rest;
                store64(err + c * 8, _pv_bits(e));
                var comp: f64 = _pv_max(e, zero);
                var rel: f64 = comp / rest;
                max_error = _pv_max(max_error, rel);
            }
            if (max_error < max_density_error) {
                converged = 1;
                it = iterations;
            } else {
                for (var u = 0; u < n; u = u + 1) {
                    var pu: f64 = load64(pres + u * 8);
                    var eu: f64 = load64(err + u * 8);
                    var raised: f64 = pu + (eu * delta);
                    var clamped: f64 = _pv_max(raised, zero);
                    store64(pres + u * 8, _pv_bits(clamped));
                }
            }
            _pv_span_end(ti);
        }
        if (converged == 0) { _pv_pcisph_predict(self, n, &kc, dt); }

        # Apply, checking each predicted position, then the walls.
        var vel = self.pcisph_pred_vel.data;
        for (var m = 0; m < n; m = m + 1) {
            var mx: f64 = load64(pos + m * 24);
            var my: f64 = load64(pos + m * 24 + 8);
            var mz: f64 = load64(pos + m * 24 + 16);
            if (_pv_is_finite(mx) == 0 || _pv_is_finite(my) == 0 || _pv_is_finite(mz) == 0) {
                _pv_span_end(trace); return Err(PV_ERR_DIVERGED);
            }
            var pm: *PvFluidParticle = ps + m;
            pm.velocity.x = load64(vel + m * 24);
            pm.velocity.y = load64(vel + m * 24 + 8);
            pm.velocity.z = load64(vel + m * 24 + 16);
            pm.position.x = mx;
            pm.position.y = my;
            pm.position.z = mz;
            pm.pressure = load64(pres + m * 8);
        }
        _pv_sph_walls(ps, n, config);
        _pv_span_end(trace); return Ok(0);
    }
}

# --- sph_dfsph.cyr ---

# sph_dfsph.cyr — `SphSolver::step_dfsph` of rust-old/src/sph.rs (M5 part c): Divergence-Free SPH (Bender & Koschier
# 2015), on the solver of src/sph.cyr.
#
# The paper's order, as Rust's:
# - the neighbour lists, then each density and stiffness factor α at xₙ (`_pv_dfsph_density_alpha`);
# - from a snapshot, the non-pressure acceleration (gravity, viscosity) into the predicted velocity v*;
# - the density solver: up to `max_iterations` rounds of κᵢ = (max(ρ*ᵢ − ρ₀, 0)/dt²)·αᵢ with ρ* = ρ + dt·Dρ/Dt,
#   stopping once the average error over n·ρ₀ is below `max_error`, each round applied to the velocities;
# - the positions advected, the lists and α rebuilt at x_{n+1};
# - the divergence solver: up to `max_iterations` rounds of κᵛᵢ = (max(Dρᵢ/Dt, 0)/dt)·αᵢ, the same stopping test on
#   (Σ·dt)/(n·ρ₀);
# - the pressures by the linear equation of state (a diagnostic), the divergence check, the walls.
# Unlike PCISPH, `max_iterations` = 0 runs no round of either solver. α and κ are solver columns, grown with the others
# before any particle changes.

# Each of the n particles' density and DFSPH stiffness factor at its current position, over the lists: ρᵢ = Σ mⱼ·W(r²)
# for r² ≤ h² (itself included), and αᵢ = max(ρᵢ, 1e-10)/(|Σ gⱼ|² + Σ |gⱼ|²), gⱼ = (xᵢ − xⱼ)·((mⱼ·W'(r))/r) over j ≠ i
# with 1e-20 ≤ r² ≤ h²; α = 0 when that denominator is not above 1e-20. The densities are written to the particles as
# they go (the sums read only positions and masses). Mirrors the private `dfsph_density_alpha`.
fn _pv_dfsph_density_alpha(s: *PvSphSolver, ps: *PvFluidParticle, n, kc: *_PvKernelCoeffs) {
    var g: *PvNeighborGrid = _pv_sph_grid(s);
    var off = g.offsets.data;
    var idx = g.indices.data;
    var alphas = s.dfsph_alpha.data;
    var h2: f64 = kc.h2;
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var lo: f64 = _PV_SPH_MIN_DENSITY;
    for (var i = 0; i < n; i = i + 1) {
        var pi: *PvFluidParticle = ps + i;
        var px: f64 = pi.position.x;
        var py: f64 = pi.position.y;
        var pz: f64 = pi.position.z;
        var d: f64 = 0.0;
        var sgx: f64 = 0.0;
        var sgy: f64 = 0.0;
        var sgz: f64 = 0.0;
        var sq: f64 = 0.0;
        var a = load64(off + i * 8);
        var b = load64(off + (i + 1) * 8);
        for (var k = a; k < b; k = k + 1) {
            var j = load64(idx + k * 8);
            var pj: *PvFluidParticle = ps + j;
            var dx: f64 = px - pj.position.x;
            var dy: f64 = py - pj.position.y;
            var dz: f64 = pz - pj.position.z;
            var r2: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
            if ((r2 > h2) == 0) {
                var w: f64 = _pv_kc_poly6(kc, r2);
                var mw: f64 = pj.mass * w;
                d = d + mw;
                if (j != i && (r2 < tiny) == 0) {
                    var r: f64 = f64_sqrt(r2);
                    var grad: f64 = _pv_kc_spiky_grad(kc, r);
                    var sc: f64 = (pj.mass * grad) / r;
                    var gx: f64 = dx * sc;
                    var gy: f64 = dy * sc;
                    var gz: f64 = dz * sc;
                    sgx = sgx + gx;
                    sgy = sgy + gy;
                    sgz = sgz + gz;
                    var g2: f64 = ((gx * gx) + (gy * gy)) + (gz * gz);
                    sq = sq + g2;
                }
            }
        }
        pi.density = d;
        var s2: f64 = ((sgx * sgx) + (sgy * sgy)) + (sgz * sgz);
        var denom: f64 = s2 + sq;
        var alpha: f64 = 0.0;
        if (denom > tiny) {
            var dm: f64 = _pv_max(d, lo);
            alpha = dm / denom;
        }
        store64(alphas + i * 8, _pv_bits(alpha));
    }
    return 0;
}

# Particle i's density change rate Dρᵢ/Dt = Σⱼ mⱼ·((vᵢ − vⱼ)·gⱼ), gⱼ = (xᵢ − xⱼ)·(W'(r)/r), over j ≠ i with
# 1e-20 ≤ r² ≤ h², from +0. Mirrors the private `dfsph_density_rate`.
#must_use
fn _pv_dfsph_density_rate(s: *PvSphSolver, ps: *PvFluidParticle, kc: *_PvKernelCoeffs, i): f64 {
    var g: *PvNeighborGrid = _pv_sph_grid(s);
    var off = g.offsets.data;
    var idx = g.indices.data;
    var h2: f64 = kc.h2;
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var pi: *PvFluidParticle = ps + i;
    var rate: f64 = 0.0;
    var a = load64(off + i * 8);
    var b = load64(off + (i + 1) * 8);
    for (var k = a; k < b; k = k + 1) {
        var j = load64(idx + k * 8);
        if (j != i) {
            var pj: *PvFluidParticle = ps + j;
            var dx: f64 = pi.position.x - pj.position.x;
            var dy: f64 = pi.position.y - pj.position.y;
            var dz: f64 = pi.position.z - pj.position.z;
            var r2: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
            if ((r2 > h2 || r2 < tiny) == 0) {
                var r: f64 = f64_sqrt(r2);
                var grad: f64 = _pv_kc_spiky_grad(kc, r);
                var gr: f64 = grad / r;
                var gx: f64 = dx * gr;
                var gy: f64 = dy * gr;
                var gz: f64 = dz * gr;
                var ux: f64 = pi.velocity.x - pj.velocity.x;
                var uy: f64 = pi.velocity.y - pj.velocity.y;
                var uz: f64 = pi.velocity.z - pj.velocity.z;
                var dot: f64 = ((ux * gx) + (uy * gy)) + (uz * gz);
                var term: f64 = pj.mass * dot;
                rate = rate + term;
            }
        }
    }
    return rate;
}

# vᵢ −= dvᵢ·dt with dvᵢ = Σⱼ (xᵢ − xⱼ)·(((mⱼ·(κᵢ/ρᵢ + κⱼ/ρⱼ))·W'(r))/r) over j ≠ i with 1e-20 ≤ r² ≤ h², each ρ floored
# at 1e-10, for each of the n particles (the sums read positions, densities and κ, never the velocities, so the order
# doesn't matter). Mirrors the private `dfsph_apply_kappa`.
fn _pv_dfsph_apply_kappa(s: *PvSphSolver, ps: *PvFluidParticle, n, kc: *_PvKernelCoeffs, dt: f64) {
    var g: *PvNeighborGrid = _pv_sph_grid(s);
    var off = g.offsets.data;
    var idx = g.indices.data;
    var kappa = s.dfsph_kappa.data;
    var h2: f64 = kc.h2;
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var lo: f64 = _PV_SPH_MIN_DENSITY;
    for (var i = 0; i < n; i = i + 1) {
        var pi: *PvFluidParticle = ps + i;
        var px: f64 = pi.position.x;
        var py: f64 = pi.position.y;
        var pz: f64 = pi.position.z;
        var kpi: f64 = load64(kappa + i * 8);
        var rho_i: f64 = _pv_max(pi.density, lo);
        var ki: f64 = kpi / rho_i;
        var dvx: f64 = 0.0;
        var dvy: f64 = 0.0;
        var dvz: f64 = 0.0;
        var a = load64(off + i * 8);
        var b = load64(off + (i + 1) * 8);
        for (var k = a; k < b; k = k + 1) {
            var j = load64(idx + k * 8);
            if (j != i) {
                var pj: *PvFluidParticle = ps + j;
                var dx: f64 = px - pj.position.x;
                var dy: f64 = py - pj.position.y;
                var dz: f64 = pz - pj.position.z;
                var r2: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
                if ((r2 > h2 || r2 < tiny) == 0) {
                    var r: f64 = f64_sqrt(r2);
                    var kpj: f64 = load64(kappa + j * 8);
                    var rho_j: f64 = _pv_max(pj.density, lo);
                    var kj: f64 = kpj / rho_j;
                    var grad: f64 = _pv_kc_spiky_grad(kc, r);
                    var sc: f64 = ((pj.mass * (ki + kj)) * grad) / r;
                    dvx = dvx + (dx * sc);
                    dvy = dvy + (dy * sc);
                    dvz = dvz + (dz * sc);
                }
            }
        }
        pi.velocity.x = pi.velocity.x - (dvx * dt);
        pi.velocity.y = pi.velocity.y - (dvy * dt);
        pi.velocity.z = pi.velocity.z - (dvz * dt);
    }
    return 0;
}

impl PvSphSolver {
    # One DFSPH step of the n particles at ps (the file's header gives the order). Ok(0); the config's error (nothing
    # changed); PV_ERR_INVALID_SMOOTHING_RADIUS for h as f32 not finite and > 0; PV_ERR_OUT_OF_MEMORY when a buffer
    # can't grow (Rust aborts): before any particle changes, except at the second neighbour build, after the advection,
    # whose lists may need more room; PV_ERR_DIVERGED when a position or velocity is not finite at the end (before the
    # walls), the state then the step's. Mirrors `step_dfsph` (ADR 0002 #21).
    #must_use
    fn step_dfsph(self, ps: *PvFluidParticle, n, config: *PvFluidConfig, viscosity: f64, max_iterations,
      max_error: f64): Result {
        var trace = _pv_span(_PV_LOG_SPH, "sph::dfsph", "n", n, 0, 0, 0, 0);
        var ct, cv = config.validate();
        if (is_err_result(ct) == 1) { _pv_span_end(trace); return Err(cv); }
        if (n <= 0) { _pv_span_end(trace); return Ok(0); }
        var h: f64 = config.smoothing_radius;
        var h32: f32 = f32_from(h);
        var hw: f64 = f32_to(h32);
        if (_pv_is_positive(hw) == 0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_SMOOTHING_RADIUS); }
        if (n > 9223372036854775807 / 144) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
        var zero: f64 = 0.0;
        var zw = _pv_bits(zero);
        var ok = self.dfsph_alpha.resize(n, zw) & self.dfsph_kappa.resize(n, zw) & self.snapshot.resize(18 * n, 0);
        if (ok == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
        var g: *PvNeighborGrid = _pv_sph_grid(self);
        var tb = _pv_span(_PV_LOG_SPH, "sph::build_neighbors", "n", n, 0, 0, 0, 0);
        var built = _pv_nb_build(g, ps, n, h);
        _pv_span_end(tb);
        if (built == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
        var kc: _PvKernelCoeffs;
        _pv_kc_init(&kc, h);
        var h2: f64 = kc.h2;
        var dt: f64 = config.dt;
        var rest: f64 = config.rest_density;
        var kappa = self.dfsph_kappa.data;
        var alphas = self.dfsph_alpha.data;
        _pv_dfsph_density_alpha(self, ps, n, &kc);

        # The non-pressure acceleration (gravity, viscosity) into v*, from the snapshot.
        var snap: *PvFluidParticle = _pv_as_particles(self.snapshot.data);
        for (var c = 0; c < n; c = c + 1) {
            var sq: *PvFluidParticle = snap + c;
            var sp: *PvFluidParticle = ps + c;
            *sq = *sp;
        }
        var off = g.offsets.data;
        var idx = g.indices.data;
        var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
        var lo: f64 = _PV_SPH_MIN_DENSITY;
        for (var i = 0; i < n; i = i + 1) {
            var si: *PvFluidParticle = snap + i;
            var ax: f64 = config.gravity.x;
            var ay: f64 = config.gravity.y;
            var az: f64 = config.gravity.z;
            var rho: f64 = _pv_max(si.density, lo);
            var a = load64(off + i * 8);
            var b = load64(off + (i + 1) * 8);
            for (var k = a; k < b; k = k + 1) {
                var j = load64(idx + k * 8);
                if (j != i) {
                    var sj: *PvFluidParticle = snap + j;
                    var dx: f64 = si.position.x - sj.position.x;
                    var dy: f64 = si.position.y - sj.position.y;
                    var dz: f64 = si.position.z - sj.position.z;
                    var r2: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
                    if ((r2 > h2 || r2 < tiny) == 0) {
                        var r: f64 = f64_sqrt(r2);
                        var rho_j: f64 = _pv_max(sj.density, lo);
                        var lap: f64 = _pv_kc_visc_lap(&kc, r);
                        var v_scale: f64 = (((viscosity * sj.mass) * lap) / rho_j) / rho;
                        var ux: f64 = sj.velocity.x - si.velocity.x;
                        var uy: f64 = sj.velocity.y - si.velocity.y;
                        var uz: f64 = sj.velocity.z - si.velocity.z;
                        ax = ax + (ux * v_scale);
                        ay = ay + (uy * v_scale);
                        az = az + (uz * v_scale);
                    }
                }
            }
            var pi: *PvFluidParticle = ps + i;
            pi.velocity.x = pi.velocity.x + (ax * dt);
            pi.velocity.y = pi.velocity.y + (ay * dt);
            pi.velocity.z = pi.velocity.z + (az * dt);
        }

        # The density solver.
        var nf: f64 = f64_from(n);
        var scale: f64 = nf * rest;
        var dt2: f64 = dt * dt;
        var done = 0;
        for (var it = 0; it < max_iterations; it = it + 1) {
            if (done == 0) {
                var ti = _pv_span(_PV_LOG_SPH, "sph::dfsph_density", 0, 0, 0, 0, 0, 0);
                var err_sum: f64 = 0.0;
                for (var q = 0; q < n; q = q + 1) {
                    var pq: *PvFluidParticle = ps + q;
                    var rate: f64 = _pv_dfsph_density_rate(self, ps, &kc, q);
                    var rho_star: f64 = pq.density + (dt * rate);
                    var over: f64 = rho_star - rest;
                    var err: f64 = _pv_max(over, zero);
                    err_sum = err_sum + err;
                    var al: f64 = load64(alphas + q * 8);
                    var kq: f64 = (err / dt2) * al;
                    store64(kappa + q * 8, _pv_bits(kq));
                }
                var avg: f64 = err_sum / scale;
                if (avg < max_error) {
                    done = 1;
                } else {
                    _pv_dfsph_apply_kappa(self, ps, n, &kc, dt);
                }
                _pv_span_end(ti);
            }
        }

        # Advect, then the lists and α at the new positions.
        for (var e = 0; e < n; e = e + 1) {
            var pe: *PvFluidParticle = ps + e;
            pe.position.x = pe.position.x + (pe.velocity.x * dt);
            pe.position.y = pe.position.y + (pe.velocity.y * dt);
            pe.position.z = pe.position.z + (pe.velocity.z * dt);
        }
        if (_pv_nb_build(g, ps, n, h) == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
        _pv_dfsph_density_alpha(self, ps, n, &kc);

        # The divergence solver.
        var done2 = 0;
        for (var it2 = 0; it2 < max_iterations; it2 = it2 + 1) {
            if (done2 == 0) {
                var tj = _pv_span(_PV_LOG_SPH, "sph::dfsph_div", 0, 0, 0, 0, 0, 0);
                var div_sum: f64 = 0.0;
                for (var u = 0; u < n; u = u + 1) {
                    var ru: f64 = _pv_dfsph_density_rate(self, ps, &kc, u);
                    var rate2: f64 = _pv_max(ru, zero);
                    div_sum = div_sum + rate2;
                    var au: f64 = load64(alphas + u * 8);
                    var ku: f64 = (rate2 / dt) * au;
                    store64(kappa + u * 8, _pv_bits(ku));
                }
                var avg2: f64 = (div_sum * dt) / scale;
                if (avg2 < max_error) {
                    done2 = 1;
                } else {
                    _pv_dfsph_apply_kappa(self, ps, n, &kc, dt);
                }
                _pv_span_end(tj);
            }
        }

        # The diagnostic pressures, the divergence check, the walls.
        var gas: f64 = config.gas_constant;
        var bad = 0;
        for (var m = 0; m < n; m = m + 1) {
            var pm: *PvFluidParticle = ps + m;
            var pr: f64 = equation_of_state(pm.density, rest, gas);
            pm.pressure = pr;
        }
        for (var v = 0; v < n; v = v + 1) {
            var pv: *PvFluidParticle = ps + v;
            if (_pv_is_finite(pv.position.x) == 0 || _pv_is_finite(pv.position.y) == 0
              || _pv_is_finite(pv.position.z) == 0 || _pv_is_finite(pv.velocity.x) == 0
              || _pv_is_finite(pv.velocity.y) == 0 || _pv_is_finite(pv.velocity.z) == 0) {
                bad = 1;
            }
        }
        if (bad == 1) { _pv_span_end(trace); return Err(PV_ERR_DIVERGED); }
        _pv_sph_walls(ps, n, config);
        _pv_span_end(trace); return Ok(0);
    }
}

# --- sph_multiphase.cyr ---

# sph_multiphase.cyr — `PhaseProperties`, `MultiPhaseConfig` and `SphSolver::step_multiphase` of rust-old/src/sph.rs
# (M5 part d), on the solver of src/sph.cyr.
#
# The multiphase step is the WCSPH step with per-particle materials: each particle's phase selects its rest density and
# gas constant for the equation of state, a pair's viscosity is the mean of the two phases', and a second CSF term on
# the phase-indicator field (Hu & Adams 2006) acts only between particles of different phases. It integrates by
# symplectic Euler only (no Verlet), in Rust's order.

# One phase's material: its rest density, gas constant (the equation of state's stiffness) and dynamic viscosity.
# Mirrors `PhaseProperties`.
struct PvPhaseProperties {
    rest_density: f64;
    gas_constant: f64;
    viscosity: f64;
}

# A multiphase configuration: the phases (a column of three words a phase: rest density, gas constant, viscosity,
# indexed by a particle's `phase`) and the interface tension between unlike phases. Mirrors `MultiPhaseConfig`, its
# `Vec<PhaseProperties>` the column (ADR 0002 #22).
struct PvMultiPhaseConfig {
    phases: PvColumn;
    interface_tension: f64;
}

impl PvMultiPhaseConfig {
    # The number of phases.
    #must_use
    fn phase_count(self): i64 {
        var n = self.phases.len / 3;
        return n;
    }

    # Appends a phase: 1, or 0 when the column can't grow (unchanged). Rust's `phases.push(..)`.
    #must_use
    fn push_phase(self, p: PvPhaseProperties): i64 {
        if (self.phases.reserve(self.phases.len + 3) == 0) { return 0; }
        var a = self.phases.push(_pv_bits(p.rest_density));
        var b = self.phases.push(_pv_bits(p.gas_constant));
        var c = self.phases.push(_pv_bits(p.viscosity));
        return a & b & c;
    }
}

# An empty configuration with interface tension `it` (nothing allocated).
#must_use
fn _pv_mp_empty(it: f64): PvMultiPhaseConfig {
    var c: PvMultiPhaseConfig;
    c.phases.data = 0;
    c.phases.len = 0;
    c.phases.cap = 0;
    c.interface_tension = it;
    return c;
}

# A single-phase configuration (the standard step's material), no interface tension. Its column is allocated; when it
# can't be, the configuration has no phase, which `step_multiphase` refuses (Rust aborts). Mirrors
# `MultiPhaseConfig::single`.
#must_use
fn PvMultiPhaseConfig_single(rest_density: f64, gas_constant: f64, viscosity: f64): PvMultiPhaseConfig {
    var c: PvMultiPhaseConfig = _pv_mp_empty(0.0);
    var p: PvPhaseProperties;
    p.rest_density = rest_density;
    p.gas_constant = gas_constant;
    p.viscosity = viscosity;
    if (c.push_phase(p) == 0) { c.phases.truncate(0); }
    return c;
}

# A two-phase configuration (e.g. water and air) with interface tension `it`; no phase when its column can't be
# allocated, as `PvMultiPhaseConfig_single`. Mirrors `MultiPhaseConfig::two_phase`.
#must_use
fn PvMultiPhaseConfig_two_phase(phase_a: PvPhaseProperties, phase_b: PvPhaseProperties, interface_tension: f64):
PvMultiPhaseConfig {
    var c: PvMultiPhaseConfig = _pv_mp_empty(interface_tension);
    if (c.push_phase(phase_a) == 0 || c.push_phase(phase_b) == 0) { c.phases.truncate(0); }
    return c;
}

# A typed view of a word (the multiphase pool kernel reads its configuration through one).
#must_use
fn _pv_as_mp(p): *PvMultiPhaseConfig {
    return p;
}

# Releases the configuration's phases (it then has none).
fn PvMultiPhaseConfig_drop(c: *PvMultiPhaseConfig) {
    c.phases.drop();
    return 0;
}

# A deep copy of `src` into *out (a different configuration): the phases and the interface tension. 1, or 0 when the
# memory isn't there (then *out holds no storage). Mirrors the derived `Clone`.
#must_use
fn PvMultiPhaseConfig_clone(out: *PvMultiPhaseConfig, src: *PvMultiPhaseConfig): i64 {
    out.interface_tension = src.interface_tension;
    out.phases.data = 0;
    out.phases.len = 0;
    out.phases.cap = 0;
    if (out.phases.resize(src.phases.len, 0) == 0) { return 0; }
    # `phases` is the first field, so the record's address is its column's.
    var s: *PvColumn = _pv_as_columns(src);
    var ok = out.phases.copy_from(s);
    return 1;
}

# The properties of phase `phase` (a word read as Rust's `u8 as usize`), falling back to phase 0 when it is outside
# the list, and to (1000, 2000, 0) when the list is empty: (rest density, gas constant, viscosity). Mirrors the private
# `MultiPhaseConfig::get` and its local `FALLBACK`.
fn _pv_mp_get(c: *PvMultiPhaseConfig, phase) {
    var count = c.phases.len / 3;
    var k = phase;
    if (k < 0 || k >= count) { k = 0; }
    if (count == 0) {
        var rf: f64 = 1000.0;
        var gf: f64 = 2000.0;
        var vf: f64 = 0.0;
        return (_pv_bits(rf), _pv_bits(gf), _pv_bits(vf));
    }
    var w = c.phases.data + k * 24;
    return (load64(w), load64(w + 8), load64(w + 16));
}

# The accelerations of particles [a, b) from the snapshot (a `_pv_par_for` kernel, the third of Rust's three `parallel`
# loops): ctx holds the snapshot, the lists' offsets and indices, the accelerations column, the kernel coefficients, the
# config, the phase config, σ, the interface tension, the two CSF flags and ∇²W(0). Each index writes only its own three
# words.
fn _pv_mp_accel_k(ctx, a, b) {
    var snap: *PvFluidParticle = _pv_as_particles(load64(ctx));
    var off = load64(ctx + 8);
    var idx = load64(ctx + 16);
    var acc = load64(ctx + 24);
    var kc: *_PvKernelCoeffs = _pv_as_kc(load64(ctx + 32));
    var config: *PvFluidConfig = _pv_as_config(load64(ctx + 40));
    var phase_config: *PvMultiPhaseConfig = _pv_as_mp(load64(ctx + 48));
    var st: f64 = load64(ctx + 56);
    var it: f64 = load64(ctx + 64);
    var free = load64(ctx + 72);
    var inter = load64(ctx + 80);
    var lap0: f64 = load64(ctx + 88);
    var h2: f64 = kc.h2;
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var lo: f64 = _PV_SPH_MIN_DENSITY;
    for (var q = a; q < b; q = q + 1) {
        var si: *PvFluidParticle = snap + q;
        var ax: f64 = config.gravity.x;
        var ay: f64 = config.gravity.y;
        var az: f64 = config.gravity.z;
        var rho: f64 = _pv_max(si.density, lo);
        var api: f64 = si.pressure / (rho * rho);
        var ri, gi, vi_w = _pv_mp_get(phase_config, si.phase);
        var visc_i: f64 = vi_w;
        var csx: f64 = 0.0;
        var csy: f64 = 0.0;
        var csz: f64 = 0.0;
        var lap_s: f64 = 0.0;
        if (free == 1) { lap_s = (si.mass / rho) * lap0; }
        var cix: f64 = 0.0;
        var ciy: f64 = 0.0;
        var ciz: f64 = 0.0;
        var lap_i: f64 = 0.0;
        var a2 = load64(off + q * 8);
        var b2 = load64(off + (q + 1) * 8);
        for (var k2 = a2; k2 < b2; k2 = k2 + 1) {
            var j = load64(idx + k2 * 8);
            if (j != q) {
                var sj: *PvFluidParticle = snap + j;
                var ex: f64 = si.position.x - sj.position.x;
                var ey: f64 = si.position.y - sj.position.y;
                var ez: f64 = si.position.z - sj.position.z;
                var s2: f64 = ((ex * ex) + (ey * ey)) + (ez * ez);
                if ((s2 > h2 || s2 < tiny) == 0) {
                    var r: f64 = f64_sqrt(s2);
                    var rho_j: f64 = _pv_max(sj.density, lo);
                    var bj: f64 = sj.pressure / (rho_j * rho_j);
                    var sym: f64 = api + bj;
                    var grad: f64 = _pv_kc_spiky_grad(kc, r);
                    var mj: f64 = sj.mass;
                    var nmj: f64 = -mj;
                    var p_scale: f64 = ((nmj * sym) * grad) / r;
                    ax = ax + (p_scale * ex);
                    ay = ay + (p_scale * ey);
                    az = az + (p_scale * ez);
                    var rj, gj, vj_w = _pv_mp_get(phase_config, sj.phase);
                    var visc_j: f64 = vj_w;
                    var visc: f64 = 0.5 * (visc_i + visc_j);
                    var lap: f64 = _pv_kc_visc_lap(kc, r);
                    var v_scale: f64 = (((visc * mj) * lap) / rho_j) / rho;
                    var ux: f64 = sj.velocity.x - si.velocity.x;
                    var uy: f64 = sj.velocity.y - si.velocity.y;
                    var uz: f64 = sj.velocity.z - si.velocity.z;
                    ax = ax + (v_scale * ux);
                    ay = ay + (v_scale * uy);
                    az = az + (v_scale * uz);
                    var unlike = 0;
                    if (inter == 1 && si.phase != sj.phase) { unlike = 1; }
                    if (free == 1 || unlike == 1) {
                        var mor: f64 = mj / rho_j;
                        var pg: f64 = _pv_kc_poly6_grad(kc, s2);
                        var mpg: f64 = mor * pg;
                        var gx: f64 = ex * mpg;
                        var gy: f64 = ey * mpg;
                        var gz: f64 = ez * mpg;
                        var pl: f64 = _pv_kc_poly6_lap(kc, s2);
                        var lap_c: f64 = mor * pl;
                        if (free == 1) {
                            csx = csx + gx;
                            csy = csy + gy;
                            csz = csz + gz;
                            lap_s = lap_s + lap_c;
                        }
                        if (unlike == 1) {
                            cix = cix + gx;
                            ciy = ciy + gy;
                            ciz = ciz + gz;
                            lap_i = lap_i + lap_c;
                        }
                    }
                }
            }
        }
        var a_s: PvVec3 = _pv_csf_acceleration(csx, csy, csz, lap_s, st, rho, kc.h);
        var a_i: PvVec3 = _pv_csf_acceleration(cix, ciy, ciz, lap_i, it, rho, kc.h);
        var fx: f64 = (ax + a_s.x) + a_i.x;
        var fy: f64 = (ay + a_s.y) + a_i.y;
        var fz: f64 = (az + a_s.z) + a_i.z;
        store64(acc + q * 24, _pv_bits(fx));
        store64(acc + q * 24 + 8, _pv_bits(fy));
        store64(acc + q * 24 + 16, _pv_bits(fz));
    }
    return 0;
}

impl PvSphSolver {
    # One multiphase step of the n particles at ps, in Rust's order:
    # - the config is validated (its error returned); n = 0 is Ok; no phase is PV_ERR_INVALID_PARAMETER; h as f32 must
    #   be finite and > 0 (PV_ERR_INVALID_SMOOTHING_RADIUS). Nothing changes on any of these. An out-of-range phase
    #   falls back to phase 0 (Rust also warns, once a step; logging arrives with M7);
    # - the neighbour lists, the densities, each pressure by its phase's equation of state;
    # - from a snapshot, on the solver's pool, each acceleration: gravity, the symmetric pressure term, the viscosity at
    #   the mean of the two phases' ((μᵢ + μⱼ)·½), the free-surface colour field for σ > 0 (its Laplacian from the self
    #   term) and the interface colour field over unlike neighbours for an interface tension > 0 (two CSF terms), in
    #   that order;
    # - PV_ERR_DIVERGED at the first non-finite acceleration (those before it written);
    # - symplectic Euler, then the walls.
    # PV_ERR_OUT_OF_MEMORY when a buffer can't grow, before any particle changes (Rust aborts). Mirrors
    # `step_multiphase` (ADR 0002 #22).
    #must_use
    fn step_multiphase(self, ps: *PvFluidParticle, n, config: *PvFluidConfig, phase_config: *PvMultiPhaseConfig):
    Result {
        var trace = _pv_span(_PV_LOG_SPH, "sph::step_multiphase", "n", n, 0, 0, 0, 0);
        var ct, cv = config.validate();
        if (is_err_result(ct) == 1) { _pv_span_end(trace); return Err(cv); }
        if (n <= 0) { _pv_span_end(trace); return Ok(0); }
        if (phase_config.phases.len / 3 == 0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_PARAMETER); }
        # One warning a step for the particles whose phase has no entry (they fall back to phase 0), as Rust's.
        var nphases = phase_config.phases.len / 3;
        var bad_phase = 0;
        for (var bq = 0; bq < n; bq = bq + 1) {
            var pb: *PvFluidParticle = ps + bq;
            if (pb.phase >= nphases) { bad_phase = bad_phase + 1; }
        }
        if (bad_phase > 0) {
            var msg = "phase index out of bounds, falling back to phase 0";
            _pv_warn(_PV_LOG_SPH, msg, "particles", bad_phase, "available", nphases, 0, 0);
        }
        var h: f64 = config.smoothing_radius;
        var h32: f32 = f32_from(h);
        var hw: f64 = f32_to(h32);
        if (_pv_is_positive(hw) == 0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_SMOOTHING_RADIUS); }
        if (n > 9223372036854775807 / 144) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
        var zero: f64 = 0.0;
        var zw = _pv_bits(zero);
        var ok = self.densities.resize(n, zw) & self.snapshot.resize(18 * n, 0) & self.accels.resize(3 * n, zw);
        if (ok == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
        var g: *PvNeighborGrid = _pv_sph_grid(self);
        var tb = _pv_span(_PV_LOG_SPH, "sph::build_neighbors", "n", n, 0, 0, 0, 0);
        var built = _pv_nb_build(g, ps, n, h);
        _pv_span_end(tb);
        if (built == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
        var kc: _PvKernelCoeffs;
        _pv_kc_init(&kc, h);
        var off = g.offsets.data;
        var idx = g.indices.data;
        var dens = self.densities.data;

        # The densities (serially, as Rust's), then each pressure by its phase's equation of state.
        var td = _pv_span(_PV_LOG_SPH, "sph::density", "n", n, 0, 0, 0, 0);
        var dctx[40];
        _pv_sph_density_ctx(&dctx, ps, off, idx, dens, &kc);
        _pv_sph_density_k(&dctx, 0, n);
        var snap: *PvFluidParticle = _pv_as_particles(self.snapshot.data);
        for (var i2 = 0; i2 < n; i2 = i2 + 1) {
            var p: *PvFluidParticle = ps + i2;
            p.density = load64(dens + i2 * 8);
            var rw, gw, vw = _pv_mp_get(phase_config, p.phase);
            var rest: f64 = rw;
            var gas: f64 = gw;
            var pr: f64 = equation_of_state(p.density, rest, gas);
            p.pressure = pr;
            var sq: *PvFluidParticle = snap + i2;
            *sq = *p;
        }

        _pv_span_end(td);

        # The accelerations, from the snapshot (on the pool).
        var tf = _pv_span(_PV_LOG_SPH, "sph::forces", "n", n, 0, 0, 0, 0);
        var acc = self.accels.data;
        var st: f64 = self.surface_tension;
        var it: f64 = phase_config.interface_tension;
        var free = 0;
        if (st > 0.0) { free = 1; }
        var inter = 0;
        if (it > 0.0) { inter = 1; }
        var lap0: f64 = _pv_kc_poly6_lap(&kc, 0.0);
        var actx[96];
        store64(&actx, _pv_addr(snap));
        store64(&actx + 8, off);
        store64(&actx + 16, idx);
        store64(&actx + 24, acc);
        store64(&actx + 32, _pv_addr(&kc));
        store64(&actx + 40, _pv_addr(config));
        store64(&actx + 48, _pv_addr(phase_config));
        store64(&actx + 56, _pv_bits(st));
        store64(&actx + 64, _pv_bits(it));
        store64(&actx + 72, free);
        store64(&actx + 80, inter);
        store64(&actx + 88, _pv_bits(lap0));
        _pv_par_for(_pv_sph_pool(self), 0, n, &_pv_mp_accel_k, &actx);
        for (var c = 0; c < n; c = c + 1) {
            var gx2: f64 = load64(acc + c * 24);
            var gy2: f64 = load64(acc + c * 24 + 8);
            var gz2: f64 = load64(acc + c * 24 + 16);
            if (_pv_is_finite(gx2) == 0 || _pv_is_finite(gy2) == 0 || _pv_is_finite(gz2) == 0) {
                _pv_span_end(tf);
                _pv_span_end(trace); return Err(PV_ERR_DIVERGED);
            }
            var w2: *PvFluidParticle = ps + c;
            w2.acceleration = PvVec3_new(gx2, gy2, gz2);
        }
        _pv_span_end(tf);

        # Symplectic Euler, then the walls.
        var dt: f64 = config.dt;
        for (var e = 0; e < n; e = e + 1) {
            var pe: *PvFluidParticle = ps + e;
            var nvx: f64 = pe.velocity.x + (pe.acceleration.x * dt);
            var nvy: f64 = pe.velocity.y + (pe.acceleration.y * dt);
            var nvz: f64 = pe.velocity.z + (pe.acceleration.z * dt);
            pe.velocity.x = nvx;
            pe.velocity.y = nvy;
            pe.velocity.z = nvz;
            pe.position.x = pe.position.x + (nvx * dt);
            pe.position.y = pe.position.y + (nvy * dt);
            pe.position.z = pe.position.z + (nvz * dt);
        }
        _pv_sph_walls(ps, n, config);
        _pv_span_end(trace); return Ok(0);
    }
}

# --- coupling.cyr ---

# coupling.cyr — fluid–body coupling of rust-old/src/coupling.rs (M6 part a): rigid bodies with their shapes and
# signed distances, the two-way SPH coupling, body integration with and without added mass, drag from nearby
# particles (by brute force and through a caller's neighbour grid), and the particle level set. The FLIP/APIC solver
# arrives with part b.
#
# `BodyShape` is a data-carrying enum: the kind enum `PvBodyShape` and the payload struct `PvShape`, the union of
# the variants' fields (port plan §7.3, ADR 0002 #23). Every formula is Rust's in its operation order: glam's dot
# products ((x·x' + y·y') + z·z'), vector-by-scalar products and quotients component by component, Rust's NaN-
# ignoring min and max. A shape kind outside the enum, which Rust can't hold, gives NaN. Slices are (pointer, count)
# (ADR 0002 #9); a body is a `PvRigidBody` record. Rust's `trace_span!`s and the level set's size warning arrive with
# M7's logging.
#
# `drag_from_particles_indexed` takes the caller's `PvNeighborGrid`, built by `PvNeighborGrid_build` (src/neighbor.cyr),
# where Rust takes a hisab 1.4.0 `SpatialHash` the caller fills with each particle's f32 position: the grid's keys are
# f64 (ADR 0002 #2), and the rows they change are checked against tests/golden/coupling.d3.tsv.
#
# The distance loops read each body's shape and centre from a context filled once (`_PvSdCtx`), a two-argument call:
# Cyrius declines `#inline` for the seven-argument form (docs/benchmarks-rust-v-cyrius.md, M6 part a, 1.5× on the
# drags). `couple_sph_bodies` runs its bodies outside its particles, which keeps every sum in Rust's order.

# ── BodyShape ───────────────────────────────────────────────────────────────────────

# The kind of a body shape: explicit, append-only values (Rust's `#[non_exhaustive]` enum in declaration order). Its
# payload is `PvShape`. Mirrors `BodyShape`.
enum PvBodyShape {
    PV_BODY_SHAPE_SPHERE = 0;
    PV_BODY_SHAPE_BOX = 1;
}

# A body shape: its kind and the union of the variants' fields (a field the kind doesn't use is 0). A sphere has a
# radius; a box its half-extents (hx, hy, hz), an axis-aligned box about the body's centre. Mirrors `BodyShape`.
struct PvShape {
    kind;
    radius: f64;
    half_extents: (f64, f64, f64);
}

# A sphere of `radius`. Mirrors `BodyShape::Sphere { radius }`.
#must_use
fn PvShape_sphere(radius: f64): PvShape {
    var s: PvShape;
    s.kind = PV_BODY_SHAPE_SPHERE;
    s.radius = radius;
    s.half_extents = (0.0, 0.0, 0.0);
    return s;
}

# An axis-aligned box with half-extents (hx, hy, hz). Mirrors `BodyShape::Box { half_extents }`.
#must_use
fn PvShape_box(hx: f64, hy: f64, hz: f64): PvShape {
    var s: PvShape;
    s.kind = PV_BODY_SHAPE_BOX;
    s.radius = 0.0;
    s.half_extents = (hx, hy, hz);
    return s;
}

# The Rust variant name of a shape kind (`"Sphere"`), or "Unknown".
#must_use
fn body_shape_name(k): i64 {
    match k {
        PV_BODY_SHAPE_SPHERE => { return "Sphere"; }
        PV_BODY_SHAPE_BOX => { return "Box"; }
        _ => { return "Unknown"; }
    }
    return "Unknown";
}

# A shape about a centre, as the distance loops read it: the kind, the radius, the half-extents and the centre. Each
# loop fills one per body, so a particle's distance is a two-argument call.
struct _PvSdCtx {
    kind;
    r: f64;
    hx: f64;
    hy: f64;
    hz: f64;
    bx: f64;
    by: f64;
    bz: f64;
}

# Fills *c with shape s about (bx, by, bz).
fn _pv_sd_ctx(c: *_PvSdCtx, s: *PvShape, bx: f64, by: f64, bz: f64) {
    c.kind = s.kind;
    c.r = s.radius;
    c.hx = s.half_extents.0;
    c.hy = s.half_extents.1;
    c.hz = s.half_extents.2;
    c.bx = bx;
    c.by = by;
    c.bz = bz;
    return 0;
}

# The signed distance from the point at q (three f64 words, x, y, z: a `PvVec3`, or a particle, whose position comes
# first) to the shape of *c, d = q − centre per axis:
#   sphere √((dx² + dy²) + dz²) − r;
#   box √((max(qx, 0)² + max(qy, 0)²) + max(qz, 0)²) + min(max(max(qx, qy), qz), 0), q = |d| − half-extent.
# NaN for a kind outside the enum.
#must_use
fn _pv_sd_at(c: *_PvSdCtx, q): f64 {
    var x: f64 = load64(q);
    var y: f64 = load64(q + 8);
    var z: f64 = load64(q + 16);
    var dx: f64 = x - c.bx;
    var dy: f64 = y - c.by;
    var dz: f64 = z - c.bz;
    if (c.kind == PV_BODY_SHAPE_SPHERE) {
        var d2: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
        var r: f64 = f64_sqrt(d2);
        var sd: f64 = r - c.r;
        return sd;
    }
    if (c.kind == PV_BODY_SHAPE_BOX) {
        var zero: f64 = 0.0;
        var ax: f64 = f64_abs(dx);
        var ay: f64 = f64_abs(dy);
        var az: f64 = f64_abs(dz);
        var qx: f64 = ax - c.hx;
        var qy: f64 = ay - c.hy;
        var qz: f64 = az - c.hz;
        var mx: f64 = _pv_max(qx, zero);
        var my: f64 = _pv_max(qy, zero);
        var mz: f64 = _pv_max(qz, zero);
        var o2: f64 = ((mx * mx) + (my * my)) + (mz * mz);
        var outside: f64 = f64_sqrt(o2);
        var m1: f64 = _pv_max(qx, qy);
        var m2: f64 = _pv_max(m1, qz);
        var inside: f64 = _pv_min(m2, zero);
        var sb: f64 = outside + inside;
        return sb;
    }
    var nan: f64 = PV_F64_NAN;
    return nan;
}

# The signed distance from `point` to the shape's surface about `body_pos`: negative inside, positive outside. NaN
# for a kind outside the enum. Mirrors `BodyShape::signed_distance`.
#must_use
fn body_shape_signed_distance(s: *PvShape, point: PvVec3, body_pos: PvVec3): f64 {
    var c: _PvSdCtx;
    _pv_sd_ctx(&c, s, body_pos.x, body_pos.y, body_pos.z);
    var q: PvVec3 = point;
    var sd: f64 = _pv_sd_at(&c, &q);
    return sd;
}

# The shape's volume: a sphere's ((fl(4/3)·π)·r)·r·r, a box's ((8·hx)·hy)·hz. NaN for a kind outside the enum.
# Mirrors `BodyShape::volume`.
#must_use
fn body_shape_volume(s: *PvShape): f64 {
    match s.kind {
        PV_BODY_SHAPE_SPHERE => {
            var four: f64 = 4.0;
            var c: f64 = four / 3.0;
            var cp: f64 = c * PV_F64_PI;
            var r: f64 = s.radius;
            var v: f64 = ((cp * r) * r) * r;
            return v;
        }
        PV_BODY_SHAPE_BOX => {
            var eight: f64 = 8.0;
            var vb: f64 = ((eight * s.half_extents.0) * s.half_extents.1) * s.half_extents.2;
            return vb;
        }
        _ => {
            var nan: f64 = PV_F64_NAN;
            return nan;
        }
    }
    var nan2: f64 = PV_F64_NAN;
    return nan2;
}

# The radius of the smallest sphere about the body's centre that holds the shape: a sphere's |r|, a box's
# √((hx² + hy²) + hz²). NaN for a kind outside the enum. Mirrors `BodyShape::bounding_radius`.
#must_use
fn body_shape_bounding_radius(s: *PvShape): f64 {
    match s.kind {
        PV_BODY_SHAPE_SPHERE => {
            var r: f64 = f64_abs(s.radius);
            return r;
        }
        PV_BODY_SHAPE_BOX => {
            var hx: f64 = s.half_extents.0;
            var hy: f64 = s.half_extents.1;
            var hz: f64 = s.half_extents.2;
            var d2: f64 = ((hx * hx) + (hy * hy)) + (hz * hz);
            var rb: f64 = f64_sqrt(d2);
            return rb;
        }
        _ => {
            var nan: f64 = PV_F64_NAN;
            return nan;
        }
    }
    var nan2: f64 = PV_F64_NAN;
    return nan2;
}

# The area of the shape projected on the plane normal to (dx, dy, dz) (a unit direction): a sphere's (π·r)·r, a
# box's 4·(((|dx|·hy)·hz + (|dy|·hx)·hz) + (|dz|·hx)·hy).
#must_use
fn _pv_shape_area(s: *PvShape, dx: f64, dy: f64, dz: f64): f64 {
    match s.kind {
        PV_BODY_SHAPE_SPHERE => {
            var r: f64 = s.radius;
            var a: f64 = (PV_F64_PI * r) * r;
            return a;
        }
        PV_BODY_SHAPE_BOX => {
            var hx: f64 = s.half_extents.0;
            var hy: f64 = s.half_extents.1;
            var hz: f64 = s.half_extents.2;
            var ax: f64 = f64_abs(dx);
            var ay: f64 = f64_abs(dy);
            var az: f64 = f64_abs(dz);
            var t: f64 = (((ax * hy) * hz) + ((ay * hx) * hz)) + ((az * hx) * hy);
            var four: f64 = 4.0;
            var ab: f64 = four * t;
            return ab;
        }
        _ => {
            var nan: f64 = PV_F64_NAN;
            return nan;
        }
    }
    var nan2: f64 = PV_F64_NAN;
    return nan2;
}

# The cross-section area of the shape on the plane normal to the unit direction `dir`. NaN for a kind outside the
# enum. Mirrors `BodyShape::projected_area`.
#must_use
fn body_shape_projected_area(s: *PvShape, dir: PvVec3): f64 {
    var a: f64 = _pv_shape_area(s, dir.x, dir.y, dir.z);
    return a;
}

# ── RigidBody ───────────────────────────────────────────────────────────────────────

# A rigid body that interacts with fluid particles: its centre, velocity, mass and shape, and the force the fluid
# put on it (reset by each `couple_sph_bodies`). Mirrors `RigidBody`.
struct PvRigidBody {
    position: PvVec3;
    velocity: PvVec3;
    mass: f64;
    shape: PvShape;
    force: PvVec3;
}

# A typed view of a word (a body array's address).
#must_use
fn _pv_as_bodies(p): *PvRigidBody {
    return p;
}

# A typed view of a word (a shape's address).
#must_use
fn _pv_as_shape(p): *PvShape {
    return p;
}

# Body b's shape, at byte offset 56 (tests/coupling.tcyr pins the layout).
#must_use
fn _pv_body_shape(b): *PvShape {
    return _pv_as_shape(_pv_addr(b) + 56);
}

# A body at rest at `position`: no velocity or force. Mirrors `RigidBody::new`.
#must_use
fn PvRigidBody_new(position: PvVec3, mass: f64, shape: PvShape): PvRigidBody {
    var b: PvRigidBody;
    b.position = position;
    b.velocity = PvVec3_zero();
    b.mass = mass;
    b.shape = shape;
    b.force = PvVec3_zero();
    return b;
}

# The unit surface normal at (px, py, pz) of the shape of *c: the central difference of the signed distance at ε = 1e-6
# per axis, normalised. When its length is below 1e-20 it is the direction from the centre to the point, or (1, 0, 0)
# when that is below 1e-20 too.
fn _pv_sd_normal(c: *_PvSdCtx, px: f64, py: f64, pz: f64): (f64, f64, f64) {
    var eps: f64 = 0x3EB0C6F7A0B5ED8D;   # 1e-6
    var tiny: f64 = 0x3BC79CA10C924223;  # 1e-20
    var xp: f64 = px + eps;
    var xm: f64 = px - eps;
    var yp: f64 = py + eps;
    var ym: f64 = py - eps;
    var zp: f64 = pz + eps;
    var zm: f64 = pz - eps;
    var q: PvVec3;
    q.x = xp;
    q.y = py;
    q.z = pz;
    var a1: f64 = _pv_sd_at(c, &q);
    q.x = xm;
    var a2: f64 = _pv_sd_at(c, &q);
    var dx: f64 = a1 - a2;
    q.x = px;
    q.y = yp;
    var b1: f64 = _pv_sd_at(c, &q);
    q.y = ym;
    var b2: f64 = _pv_sd_at(c, &q);
    var dy: f64 = b1 - b2;
    q.y = py;
    q.z = zp;
    var c1: f64 = _pv_sd_at(c, &q);
    q.z = zm;
    var c2: f64 = _pv_sd_at(c, &q);
    var dz: f64 = c1 - c2;
    var m2: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
    var mag: f64 = f64_sqrt(m2);
    if (mag < tiny) {
        var fx: f64 = px - c.bx;
        var fy: f64 = py - c.by;
        var fz: f64 = pz - c.bz;
        var f2: f64 = ((fx * fx) + (fy * fy)) + (fz * fz);
        var fmag: f64 = f64_sqrt(f2);
        if (fmag < tiny) { return (1.0, 0.0, 0.0); }
        var ux: f64 = fx / fmag;
        var uy: f64 = fy / fmag;
        var uz: f64 = fz / fmag;
        return (ux, uy, uz);
    }
    var nx: f64 = dx / mag;
    var ny: f64 = dy / mag;
    var nz: f64 = dz / mag;
    return (nx, ny, nz);
}

# Fills *c with body b's shape and centre.
fn _pv_body_sd_ctx(c: *_PvSdCtx, b: *PvRigidBody) {
    _pv_sd_ctx(c, _pv_body_shape(b), b.position.x, b.position.y, b.position.z);
    return 0;
}

impl PvRigidBody {
    # The signed distance from `point` to the body's surface. Mirrors `RigidBody::signed_distance`.
    #must_use
    fn signed_distance(self, point: PvVec3): f64 {
        var c: _PvSdCtx;
        _pv_body_sd_ctx(&c, self);
        var q: PvVec3 = point;
        var sd: f64 = _pv_sd_at(&c, &q);
        return sd;
    }

    # The unit surface normal at `point`: the central difference of the signed distance at ε = 1e-6, normalised;
    # the direction from the centre when that is shorter than 1e-20, and (1, 0, 0) at the centre itself. Mirrors
    # `RigidBody::surface_normal`.
    #must_use
    fn surface_normal(self, point: PvVec3): PvVec3 {
        var c: _PvSdCtx;
        _pv_body_sd_ctx(&c, self);
        var n0, n1, n2 = _pv_sd_normal(&c, point.x, point.y, point.z);
        var nx: f64 = n0;
        var ny: f64 = n1;
        var nz: f64 = n2;
        return PvVec3_new(nx, ny, nz);
    }
}

# ── two-way coupling and integration ────────────────────────────────────────────────

# The two-way forces between the n particles at ps and the nb bodies at bodies, with h the smoothing radius, k the
# stiffness and c the damping. Every body's force is reset; then, for each particle and body where the particle's
# signed distance sd is below h, the total t = k·(h − sd) + (−c·vn when the normal relative speed vn is negative, else
# 0) pushes the particle out along the surface normal n (acceleration += (t·n)/max(m, 1e-20)) and the body takes −t·n.
# Rust's loop runs bodies inside particles; this one runs particles inside bodies, which sums each particle's
# acceleration over the bodies and each body's force over the particles in the same order (no pair reads what
# another writes). Mirrors `couple_sph_bodies`.
fn couple_sph_bodies(ps: *PvFluidParticle, n, bodies: *PvRigidBody, nb, smoothing_radius: f64, stiffness: f64,
  damping: f64) {
    var trace = _pv_span(_PV_LOG_COUPLING, "coupling::sph_bodies", "n_particles", n, "n_bodies", nb, 0, 0);
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var zero: f64 = 0.0;
    var nd: f64 = -damping;
    var c: _PvSdCtx;
    for (var j = 0; j < nb; j = j + 1) {
        var bj: *PvRigidBody = bodies + j;
        _pv_body_sd_ctx(&c, bj);
        var bvx: f64 = bj.velocity.x;
        var bvy: f64 = bj.velocity.y;
        var bvz: f64 = bj.velocity.z;
        var fx: f64 = 0.0;
        var fy: f64 = 0.0;
        var fz: f64 = 0.0;
        for (var i = 0; i < n; i = i + 1) {
            var p: *PvFluidParticle = ps + i;
            var sd: f64 = _pv_sd_at(&c, p);
            if (sd < smoothing_radius) {
                var n0, n1, n2 = _pv_sd_normal(&c, p.position.x, p.position.y, p.position.z);
                var nx: f64 = n0;
                var ny: f64 = n1;
                var nz: f64 = n2;
                var penetration: f64 = smoothing_radius - sd;
                var pen_force: f64 = stiffness * penetration;
                var rx: f64 = p.velocity.x - bvx;
                var ry: f64 = p.velocity.y - bvy;
                var rz: f64 = p.velocity.z - bvz;
                var vn: f64 = ((rx * nx) + (ry * ny)) + (rz * nz);
                var damp_force: f64 = zero;
                if (vn < 0.0) { damp_force = nd * vn; }
                var total: f64 = pen_force + damp_force;
                var m: f64 = _pv_max(p.mass, tiny);
                var tx: f64 = total * nx;
                var ty: f64 = total * ny;
                var tz: f64 = total * nz;
                var ax: f64 = p.acceleration.x + tx / m;
                var ay: f64 = p.acceleration.y + ty / m;
                var az: f64 = p.acceleration.z + tz / m;
                p.acceleration.x = ax;
                p.acceleration.y = ay;
                p.acceleration.z = az;
                fx = fx - tx;
                fy = fy - ty;
                fz = fz - tz;
            }
        }
        bj.force = PvVec3_new(fx, fy, fz);
    }
    _pv_span_end(trace); return 0;
}

# Integrates the nb bodies at bodies over dt: v += (F·(1/max(m, 1e-20)) + g)·dt, then x += v·dt. Mirrors
# `integrate_bodies`.
fn integrate_bodies(bodies: *PvRigidBody, nb, gravity: PvVec3, dt: f64) {
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var one: f64 = 1.0;
    var gx: f64 = gravity.x;
    var gy: f64 = gravity.y;
    var gz: f64 = gravity.z;
    for (var b = 0; b < nb; b = b + 1) {
        var body: *PvRigidBody = bodies + b;
        var m: f64 = _pv_max(body.mass, tiny);
        var inv: f64 = one / m;
        var vx: f64 = body.velocity.x + ((body.force.x * inv) + gx) * dt;
        var vy: f64 = body.velocity.y + ((body.force.y * inv) + gy) * dt;
        var vz: f64 = body.velocity.z + ((body.force.z * inv) + gz) * dt;
        body.velocity = PvVec3_new(vx, vy, vz);
        var x: f64 = body.position.x + vx * dt;
        var y: f64 = body.position.y + vy * dt;
        var z: f64 = body.position.z + vz * dt;
        body.position = PvVec3_new(x, y, z);
    }
    return 0;
}

# The effective mass with added mass, m + (C_a·ρ)·V. Mirrors `effective_mass`.
#must_use
fn effective_mass(body_mass: f64, fluid_density: f64, body_volume: f64, ca: f64): f64 {
    var a: f64 = (ca * fluid_density) * body_volume;
    var m: f64 = body_mass + a;
    return m;
}

# Integrates the nb bodies at bodies over dt with added mass: m_eff = effective_mass(m, ρ, V, C_a) for the shape's
# volume V, then v += ((F + g·m)·(1/max(m_eff, 1e-20)))·dt and x += v·dt. Gravity acts on the body's own mass only.
# Mirrors `integrate_bodies_with_added_mass`.
fn integrate_bodies_with_added_mass(bodies: *PvRigidBody, nb, gravity: PvVec3, dt: f64, fluid_density: f64,
  ca: f64) {
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    var one: f64 = 1.0;
    var gx: f64 = gravity.x;
    var gy: f64 = gravity.y;
    var gz: f64 = gravity.z;
    for (var b = 0; b < nb; b = b + 1) {
        var body: *PvRigidBody = bodies + b;
        var vol: f64 = body_shape_volume(_pv_body_shape(body));
        var m: f64 = body.mass;
        var m_eff: f64 = effective_mass(m, fluid_density, vol, ca);
        var me: f64 = _pv_max(m_eff, tiny);
        var inv: f64 = one / me;
        var vx: f64 = body.velocity.x + ((body.force.x + gx * m) * inv) * dt;
        var vy: f64 = body.velocity.y + ((body.force.y + gy * m) * inv) * dt;
        var vz: f64 = body.velocity.z + ((body.force.z + gz * m) * inv) * dt;
        body.velocity = PvVec3_new(vx, vy, vz);
        var x: f64 = body.position.x + vx * dt;
        var y: f64 = body.position.y + vy * dt;
        var z: f64 = body.position.z + vz * dt;
        body.position = PvVec3_new(x, y, z);
    }
    return 0;
}

# ── drag ────────────────────────────────────────────────────────────────────────────

# The quadratic drag on b from the mean of `count` sampled velocities (sum (sx, sy, sz)): v_rel = s/count − v_b, and
# v_rel·(((0.5·ρ)·|v_rel|)·C_d)·A(v_rel/|v_rel|); zero for no samples and for |v_rel| ≤ 1e-20 or not finite. Mirrors
# the private `drag_from_mean_velocity`.
#must_use
fn _pv_drag_mean(b: *PvRigidBody, sx: f64, sy: f64, sz: f64, count, fluid_density: f64, cd: f64): PvVec3 {
    if (count == 0) { return PvVec3_zero(); }
    var c: f64 = f64_from(count);
    var rx: f64 = sx / c - b.velocity.x;
    var ry: f64 = sy / c - b.velocity.y;
    var rz: f64 = sz / c - b.velocity.z;
    var s2: f64 = ((rx * rx) + (ry * ry)) + (rz * rz);
    var speed: f64 = f64_sqrt(s2);
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    if (speed <= tiny || _pv_is_finite(speed) == 0) { return PvVec3_zero(); }
    var ux: f64 = rx / speed;
    var uy: f64 = ry / speed;
    var uz: f64 = rz / speed;
    var area: f64 = _pv_shape_area(_pv_body_shape(b), ux, uy, uz);
    var half: f64 = 0.5;
    var k: f64 = (((half * fluid_density) * speed) * cd) * area;
    var fx: f64 = rx * k;
    var fy: f64 = ry * k;
    var fz: f64 = rz * k;
    return PvVec3_new(fx, fy, fz);
}

# The drag on `body` from the n particles at ps: the mean velocity of those whose |signed distance| is below
# `sample_radius`, summed in index order, through the quadratic drag ½·ρ·|v_rel|·v_rel·C_d·A. Mirrors
# `drag_from_particles`.
#must_use
fn drag_from_particles(body: *PvRigidBody, ps: *PvFluidParticle, n, fluid_density: f64, drag_coefficient: f64,
  sample_radius: f64): PvVec3 {
    var trace = _pv_span(_PV_LOG_COUPLING, "coupling::drag_from_particles", 0, 0, 0, 0, 0, 0);
    var sx: f64 = 0.0;
    var sy: f64 = 0.0;
    var sz: f64 = 0.0;
    var count = 0;
    var c: _PvSdCtx;
    _pv_body_sd_ctx(&c, body);
    for (var i = 0; i < n; i = i + 1) {
        var p: *PvFluidParticle = ps + i;
        var sd: f64 = _pv_sd_at(&c, p);
        var ad: f64 = f64_abs(sd);
        if (ad < sample_radius) {
            sx = sx + p.velocity.x;
            sy = sy + p.velocity.y;
            sz = sz + p.velocity.z;
            count = count + 1;
        }
    }
    var f: PvVec3 = _pv_drag_mean(body, sx, sy, sz, count, fluid_density, drag_coefficient);
    _pv_span_end(trace); return f;
}

# The context of one indexed drag sum: the body's distance context, the particles and their count, the sample radius,
# the grid's order column, then the running sums and count.
struct _PvDragCtx {
    sdc: *_PvSdCtx;
    ps: *PvFluidParticle;
    n;
    sample_radius: f64;
    order;
    sx: f64;
    sy: f64;
    sz: f64;
    count;
}

# A typed view of a word (a drag context's address).
#must_use
fn _pv_as_drag(p): *_PvDragCtx {
    return p;
}

# The block walk's visit: adds the velocities of cell order[a, b)'s particles that are in the slice (index < n) and
# within the sample radius of the surface.
fn _pv_drag_visit(ctx, a, b): i64 {
    var d: *_PvDragCtx = _pv_as_drag(ctx);
    var sr: f64 = d.sample_radius;
    for (var r = a; r < b; r = r + 1) {
        var idx = load64(d.order + r * 8);
        if (idx < d.n) {
            var p: *PvFluidParticle = d.ps + idx;
            var sd: f64 = _pv_sd_at(d.sdc, p);
            var ad: f64 = f64_abs(sd);
            if (ad < sr) {
                d.sx = d.sx + p.velocity.x;
                d.sy = d.sy + p.velocity.y;
                d.sz = d.sz + p.velocity.z;
                d.count = d.count + 1;
            }
        }
    }
    return 0;
}

# The drag on `body` from the n particles at ps, through the caller's cells-only grid built over them
# (`PvNeighborGrid_build`): the candidates are the points of the cells within c ± ⌈r·fl(1/cell)⌉ of the body centre's
# cell c per axis, r = sample_radius + the shape's bounding radius, walked in Rust's (x, y, z) cell order, each cell's
# points in index order; one at index n or more (a grid built over more particles) is skipped. Then the same filter
# and drag as `drag_from_particles`. A NaN r searches c alone, a negative one nothing (Rust's ranges); a grid not
# built by `PvNeighborGrid_build` finds nothing. Mirrors `drag_from_particles_indexed` (ADR 0002 #23).
#must_use
fn drag_from_particles_indexed(body: *PvRigidBody, ps: *PvFluidParticle, n, grid: *PvNeighborGrid,
  fluid_density: f64, drag_coefficient: f64, sample_radius: f64): PvVec3 {
    var trace = _pv_span(_PV_LOG_COUPLING, "coupling::drag_from_particles_indexed", 0, 0, 0, 0, 0, 0);
    var inv: f64 = grid.inv_cell;
    var br: f64 = body_shape_bounding_radius(_pv_body_shape(body));
    var qr: f64 = sample_radius + br;
    var qi: f64 = qr * inv;
    var qc: f64 = f64_ceil(qi);
    var cr = _pv_as_i64(qc);
    var c: _PvSdCtx;
    _pv_body_sd_ctx(&c, body);
    var d: _PvDragCtx;
    d.sdc = &c;
    d.ps = ps;
    d.n = n;
    d.sample_radius = sample_radius;
    d.order = grid.order.data;
    d.sx = 0.0;
    d.sy = 0.0;
    d.sz = 0.0;
    d.count = 0;
    if (cr >= 0) {
        var lo[24];
        var hi[24];
        var cx = _pv_nb_key(body.position.x, inv);
        var cy = _pv_nb_key(body.position.y, inv);
        var cz = _pv_nb_key(body.position.z, inv);
        var xl, xh = _pv_nb_span(cx, cr);
        var yl, yh = _pv_nb_span(cy, cr);
        var zl, zh = _pv_nb_span(cz, cr);
        store64(&lo, xl);
        store64(&lo + 8, yl);
        store64(&lo + 16, zl);
        store64(&hi, xh);
        store64(&hi + 8, yh);
        store64(&hi + 16, zh);
        _pv_nb_block(grid, &lo, &hi, &_pv_drag_visit, &d);
    }
    var f: PvVec3 = _pv_drag_mean(body, d.sx, d.sy, d.sz, d.count, fluid_density, drag_coefficient);
    _pv_span_end(trace); return f;
}

# ── the particle level set ──────────────────────────────────────────────────────────

# Fills the nx × ny level set at ls (len words) from the n particles at ps: each cell (x, y), at (x·dx, y·dx), gets
# min(far, min over the particles of √(Δx² + Δy²) − particle_radius) in index order, far = (nx + ny)·dx; positive
# outside the fluid, negative inside (a brute-force O(cells · n) search, as Rust's). 1, or 0 with nothing written
# when nx·ny is not len or overflows, or nx or ny is negative (Rust warns and returns). Mirrors `particle_level_set`.
fn particle_level_set(ls, len, nx, ny, dx: f64, ps: *PvFluidParticle, n, particle_radius: f64): i64 {
    var trace = _pv_span(_PV_LOG_COUPLING, "coupling::particle_level_set", "nx", nx, "ny", ny, "n", n);
    # Rust's `nx.checked_mul(ny) != Some(level_set.len())`: an overflow, or any other length.
    var bad = 0;
    if (nx < 0 || ny < 0) { bad = 1; }
    if (bad == 0 && nx > 0 && ny > 9223372036854775807 / nx) { bad = 1; }
    if (bad == 0 && nx * ny != len) { bad = 1; }
    if (bad == 1) {
        _pv_warn(_PV_LOG_COUPLING, "particle_level_set: size mismatch ignored", "nx", nx, "ny", ny, "len", len);
        _pv_span_end(trace); return 0;
    }
    var fx: f64 = f64_from(nx);
    var fy: f64 = f64_from(ny);
    var far: f64 = (fx + fy) * dx;
    for (var k = 0; k < len; k = k + 1) { store64(ls + k * 8, _pv_bits(far)); }
    for (var y = 0; y < ny; y = y + 1) {
        var yf: f64 = f64_from(y);
        var gy: f64 = yf * dx;
        for (var x = 0; x < nx; x = x + 1) {
            var xf: f64 = f64_from(x);
            var gx: f64 = xf * dx;
            var min_dist: f64 = far;
            for (var i = 0; i < n; i = i + 1) {
                var p: *PvFluidParticle = ps + i;
                var ddx: f64 = gx - p.position.x;
                var ddy: f64 = gy - p.position.y;
                var d2: f64 = (ddx * ddx) + (ddy * ddy);
                var r: f64 = f64_sqrt(d2);
                var dist: f64 = r - particle_radius;
                if (dist < min_dist) { min_dist = dist; }
            }
            store64(ls + (y * nx + x) * 8, _pv_bits(min_dist));
        }
    }
    _pv_span_end(trace); return 1;
}

# --- flip.cyr ---

# flip.cyr — the FLIP/PIC solver of rust-old/src/coupling.rs (M6 part b): particles advected on a background grid,
# their velocities splatted to it (P2G), the grid projected by Gauss–Seidel, and the grid velocity carried back
# (G2P) as a FLIP/PIC blend or, with `use_apic`, as APIC's affine transfer.
#
# `PvFlipSolver` holds Rust's private `Vec` fields as solver-owned columns, reused from step to step: the grid
# fields (nx·ny each) and the APIC matrices, four words a particle, which `step` resizes to the particle count as Rust
# does (ADR 0002 #24). Every formula is Rust's in its operation order: each cell index and fraction is
# floor(g).max(0).min(n − 2) and (g − x0).clamp(0, 1) with Rust's NaN-ignoring max and min; the splat's weights are
# products of the fractions times the mass; the sampler's are the value times one fraction then the other. A step
# allocates nothing once the APIC column has grown. Rust's `trace_span!`s arrive with M7's logging. Slices are
# (pointer, count) (ADR 0002 #9).

# The FLIP/PIC solver: the grid (nx × ny cells of size dx), the blend `flip_ratio` (0 PIC, 1 FLIP; re-clamped at use),
# `use_apic` (0 / 1, overriding the blend), `narrow_band_cells` (a usize, reserved: Rust reads it nowhere), then the
# grid fields and the APIC matrices [c00, c01, c10, c11] of each particle. Mirrors `FlipSolver`.
struct PvFlipSolver {
    nx;
    ny;
    dx: f64;
    flip_ratio: f64;
    use_apic;
    narrow_band_cells;
    vx: PvColumn;
    vy: PvColumn;
    vx_old: PvColumn;
    vy_old: PvColumn;
    weight: PvColumn;
    pressure: PvColumn;
    div: PvColumn;
    apic_c: PvColumn;
}

# The solver's column count: the seven grid fields, then `apic_c`.
const _PV_FLIP_COLUMNS = 8;

# Column k of a solver (0 vx, 1 vy, 2 vx_old, 3 vy_old, 4 weight, 5 pressure, 6 div, 7 apic_c), by its byte offset
# (tests/coupling.tcyr pins the layout, 240 bytes).
#must_use
fn _pv_flip_col(s, k): *PvColumn {
    return _pv_as_columns(_pv_addr(s) + 48 + k * 24);
}

# Empties every column of *s without releasing anything, for a record about to be filled.
fn _pv_flip_zero(s: *PvFlipSolver) {
    for (var k = 0; k < _PV_FLIP_COLUMNS; k = k + 1) {
        var c: *PvColumn = _pv_flip_col(s, k);
        c.data = 0;
        c.len = 0;
        c.cap = 0;
    }
    s.use_apic = 0;
    s.narrow_band_cells = 0;
    return 0;
}

# Releases every column; the solver holds no storage after. Mirrors dropping the `FlipSolver`.
fn PvFlipSolver_drop(s: *PvFlipSolver) {
    for (var k = 0; k < _PV_FLIP_COLUMNS; k = k + 1) {
        var c: *PvColumn = _pv_flip_col(s, k);
        c.drop();
    }
    return 0;
}

# A solver of zeros into *out: Ok(0), or the first failure in Rust's order: PV_ERR_INVALID_GRID_RESOLUTION for nx or
# ny below 4, PV_ERR_INVALID_PARAMETER for a cell size not finite and > 0, PV_ERR_INVALID_GRID_RESOLUTION for nx·ny
# overflowing a usize; PV_ERR_OUT_OF_MEMORY for a size no allocation reaches (Rust's `vec!` aborts) or when the fields
# can't be allocated. On an error *out holds no storage. The blend is flip_ratio clamped to [0, 1], or 0.95 when it
# isn't finite; APIC off, no narrow band, the APIC column empty. Mirrors `FlipSolver::new`.
#must_use
fn PvFlipSolver_new(nx, ny, dx: f64, flip_ratio: f64, out: *PvFlipSolver): Result {
    _pv_flip_zero(out);
    # nx and ny are usizes: a word at or above 2^63 reads negative, and is a size Rust accepts until nx·ny.
    if ((nx >= 0 && nx < 4) || (ny >= 0 && ny < 4)) { return Err(PV_ERR_INVALID_GRID_RESOLUTION); }
    if (dx <= 0.0 || _pv_is_finite(dx) == 0) { return Err(PV_ERR_INVALID_PARAMETER); }
    var ov = _pv_fg_mul_class(nx, ny);
    if (ov == 2) { return Err(PV_ERR_INVALID_GRID_RESOLUTION); }
    if (ov == 1) { return Err(PV_ERR_OUT_OF_MEMORY); }
    var size = nx * ny;
    var ok = 1;
    for (var k = 0; k < 7; k = k + 1) {
        var c: *PvColumn = _pv_flip_col(out, k);
        ok = ok & c.resize(size, 0);
    }
    if (ok == 0) {
        PvFlipSolver_drop(out);
        return Err(PV_ERR_OUT_OF_MEMORY);
    }
    out.nx = nx;
    out.ny = ny;
    out.dx = dx;
    var r: f64 = 0.95;
    if (_pv_is_finite(flip_ratio) == 1) { r = _pv_clamp(flip_ratio, 0.0, 1.0); }
    out.flip_ratio = r;
    return Ok(0);
}

# One axis of a grid position g (in cells) on an n-cell axis: the lower node floor(g).max(0).min(n − 2) as an index
# and the fraction (g − x0).clamp(0, 1), which is NaN for a NaN g (Rust's clamp keeps it). Rust's NaN-ignoring max
# and min are written out (src/mathx.cyr's semantics): max(fl, 0) is fl when fl > 0 and +0 otherwise (a NaN, ±0 and
# the negatives); the result is never NaN, so min(·, n − 2) is a comparison; and x0 as f64 is that value exactly.
fn _pv_flip_axis(g: f64, n) {
    var fl: f64 = f64_floor(g);
    var c: f64 = 0.0;
    if (fl > 0.0) { c = fl; }
    var top: f64 = f64_from(n - 2);
    if (c >= top) { c = top; }
    var x0 = f64_to(c);
    var d: f64 = g - c;
    var sx: f64 = d;
    if (d < 0.0) { sx = 0.0; }
    if (d > 1.0) { sx = 1.0; }
    return (x0, sx);
}

# Resizes the APIC column to n particles, new ones the zero matrix: 1, or 0 when it can't grow (unchanged).
#must_use
fn _pv_flip_apic_resize(s: *PvFlipSolver, n): i64 {
    var c: *PvColumn = _pv_flip_col(s, 7);
    return c.resize(4 * n, 0);
}

# Particle-to-grid: the mass-weighted splat of the n particles at ps. Each particle's four nodes get w = (its
# bilinear weight)·m (m its mass when positive and finite, else 0) times v + C·(xᵢ − xₚ), C its APIC matrix when
# `use_apic` and it has one, else zero; then each node with a weight above 1e-20 is divided by it. Mirrors the private
# `particles_to_grid`.
fn _pv_flip_p2g(s: *PvFlipSolver, ps: *PvFluidParticle, n) {
    var trace = _pv_span(_PV_LOG_COUPLING, "flip::p2g", "n", n, 0, 0, 0, 0);
    var nx = s.nx;
    var ny = s.ny;
    var dx: f64 = s.dx;
    var one: f64 = 1.0;
    var inv_dx: f64 = one / dx;
    var vx = s.vx.data;
    var vy = s.vy.data;
    var wt = s.weight.data;
    var cells = nx * ny;
    for (var z = 0; z < cells; z = z + 1) {
        store64(vx + z * 8, 0);
        store64(vy + z * 8, 0);
        store64(wt + z * 8, 0);
    }
    var ac = s.apic_c.data;
    var na = s.apic_c.len / 4;
    var zero: f64 = 0.0;
    for (var pi = 0; pi < n; pi = pi + 1) {
        var p: *PvFluidParticle = ps + pi;
        var px: f64 = p.position.x;
        var py: f64 = p.position.y;
        var gx: f64 = px * inv_dx;
        var gy: f64 = py * inv_dx;
        var x0, sxv = _pv_flip_axis(gx, nx);
        var y0, syv = _pv_flip_axis(gy, ny);
        var sx: f64 = sxv;
        var sy: f64 = syv;
        var ux: f64 = one - sx;
        var uy: f64 = one - sy;
        var c0: f64 = zero;
        var c1: f64 = zero;
        var c2: f64 = zero;
        var c3: f64 = zero;
        if (s.use_apic == 1 && pi < na) {
            c0 = load64(ac + pi * 32);
            c1 = load64(ac + pi * 32 + 8);
            c2 = load64(ac + pi * 32 + 16);
            c3 = load64(ac + pi * 32 + 24);
        }
        var mass: f64 = zero;
        if (p.mass > 0.0 && _pv_is_finite(p.mass) == 1) { mass = p.mass; }
        var pvx: f64 = p.velocity.x;
        var pvy: f64 = p.velocity.y;
        for (var k = 0; k < 4; k = k + 1) {
            var wk: f64 = ux * uy;
            var ix = x0;
            var iy = y0;
            if (k == 1) {
                wk = sx * uy;
                ix = x0 + 1;
            } elif (k == 2) {
                wk = ux * sy;
                iy = y0 + 1;
            } elif (k == 3) {
                wk = sx * sy;
                ix = x0 + 1;
                iy = y0 + 1;
            }
            var w: f64 = wk * mass;
            var idx = iy * nx + ix;
            var fix: f64 = f64_from(ix);
            var fiy: f64 = f64_from(iy);
            var gxi: f64 = fix * dx;
            var gyi: f64 = fiy * dx;
            var dxi: f64 = gxi - px;
            var dyi: f64 = gyi - py;
            var sxp: f64 = (pvx + c0 * dxi) + c1 * dyi;
            var syp: f64 = (pvy + c2 * dxi) + c3 * dyi;
            var ovx: f64 = load64(vx + idx * 8);
            var ovy: f64 = load64(vy + idx * 8);
            var ow: f64 = load64(wt + idx * 8);
            var nvx: f64 = ovx + w * sxp;
            var nvy: f64 = ovy + w * syp;
            var nw: f64 = ow + w;
            store64(vx + idx * 8, _pv_bits(nvx));
            store64(vy + idx * 8, _pv_bits(nvy));
            store64(wt + idx * 8, _pv_bits(nw));
        }
    }
    var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
    for (var i = 0; i < cells; i = i + 1) {
        var wi: f64 = load64(wt + i * 8);
        if (wi > tiny) {
            var a: f64 = load64(vx + i * 8);
            var b: f64 = load64(vy + i * 8);
            var qa: f64 = a / wi;
            var qb: f64 = b / wi;
            store64(vx + i * 8, _pv_bits(qa));
            store64(vy + i * 8, _pv_bits(qb));
        }
    }
    _pv_span_end(trace); return 0;
}

# The bilinear sample of the nx-wide field at f at the cell (x0, y0) and fractions (sx, sy) of a grid position:
# ((v00·(1 − sx))·(1 − sy) + (v10·sx)·(1 − sy)) + (v01·(1 − sx))·sy + (v11·sx)·sy. Rust's private `sample_field`
# finds the cell and fractions from the position at each call; G2P samples four fields at one position, so it finds
# them once (`_pv_flip_axis` is a function of the position alone: the same bits).
#must_use
fn _pv_flip_sample(f, nx, x0, y0, sx: f64, sy: f64): f64 {
    var one: f64 = 1.0;
    var ux: f64 = one - sx;
    var uy: f64 = one - sy;
    var at = f + (y0 * nx + x0) * 8;
    var v00: f64 = load64(at);
    var v10: f64 = load64(at + 8);
    var v01: f64 = load64(at + nx * 8);
    var v11: f64 = load64(at + nx * 8 + 8);
    var r: f64 = (((v00 * ux) * uy + (v10 * sx) * uy) + (v01 * ux) * sy) + (v11 * sx) * sy;
    return r;
}

# Grid-to-particle for the n particles at ps. With `use_apic`: the APIC column resized to n, each particle's velocity
# Σ w·vᵢ over its four nodes and its matrix Σ vᵢ ⊗ ∇wᵢ (the weight gradients over dx); otherwise the FLIP/PIC blend
# f·(v + Δv) + (1 − f)·v_new with f the blend clamped to [0, 1] and Δv the sampled change v_new − v_old. Only x and y
# change. 1, or 0 when the APIC column can't grow (nothing changed). Mirrors the private `grid_to_particles`.
#must_use
fn _pv_flip_g2p(s: *PvFlipSolver, ps: *PvFluidParticle, n): i64 {
    var trace = _pv_span(_PV_LOG_COUPLING, "flip::g2p", "n", n, 0, 0, 0, 0);
    var nx = s.nx;
    var ny = s.ny;
    var dx: f64 = s.dx;
    var one: f64 = 1.0;
    var inv_dx: f64 = one / dx;
    var vx = s.vx.data;
    var vy = s.vy.data;
    if (s.use_apic == 1) {
        if (_pv_flip_apic_resize(s, n) == 0) { _pv_span_end(trace); return 0; }
        var ac = s.apic_c.data;
        for (var pi = 0; pi < n; pi = pi + 1) {
            var p: *PvFluidParticle = ps + pi;
            var gx: f64 = p.position.x * inv_dx;
            var gy: f64 = p.position.y * inv_dx;
            var x0, sxv = _pv_flip_axis(gx, nx);
            var y0, syv = _pv_flip_axis(gy, ny);
            var sx: f64 = sxv;
            var sy: f64 = syv;
            var ux: f64 = one - sx;
            var uy: f64 = one - sy;
            var vx_new: f64 = 0.0;
            var vy_new: f64 = 0.0;
            var c00: f64 = 0.0;
            var c01: f64 = 0.0;
            var c10: f64 = 0.0;
            var c11: f64 = 0.0;
            for (var k = 0; k < 4; k = k + 1) {
                # (node, weight, ∂w/∂x, ∂w/∂y)
                var ix = x0;
                var iy = y0;
                var w: f64 = ux * uy;
                var gwx: f64 = -uy;
                var gwy: f64 = -ux;
                if (k == 1) {
                    ix = x0 + 1;
                    w = sx * uy;
                    gwx = uy;
                    gwy = -sx;
                } elif (k == 2) {
                    iy = y0 + 1;
                    w = ux * sy;
                    gwx = -sy;
                    gwy = ux;
                } elif (k == 3) {
                    ix = x0 + 1;
                    iy = y0 + 1;
                    w = sx * sy;
                    gwx = sy;
                    gwy = sx;
                }
                var idx = iy * nx + ix;
                var gvx: f64 = load64(vx + idx * 8);
                var gvy: f64 = load64(vy + idx * 8);
                vx_new = vx_new + w * gvx;
                vy_new = vy_new + w * gvy;
                var gx2: f64 = gwx * inv_dx;
                var gy2: f64 = gwy * inv_dx;
                c00 = c00 + gvx * gx2;
                c01 = c01 + gvx * gy2;
                c10 = c10 + gvy * gx2;
                c11 = c11 + gvy * gy2;
            }
            p.velocity.x = vx_new;
            p.velocity.y = vy_new;
            store64(ac + pi * 32, _pv_bits(c00));
            store64(ac + pi * 32 + 8, _pv_bits(c01));
            store64(ac + pi * 32 + 16, _pv_bits(c10));
            store64(ac + pi * 32 + 24, _pv_bits(c11));
        }
        _pv_span_end(trace); return 1;
    }
    var flip: f64 = _pv_clamp(s.flip_ratio, 0.0, 1.0);
    var pic: f64 = one - flip;
    var ox = s.vx_old.data;
    var oy = s.vy_old.data;
    for (var q = 0; q < n; q = q + 1) {
        var pq: *PvFluidParticle = ps + q;
        var hx: f64 = pq.position.x * inv_dx;
        var hy: f64 = pq.position.y * inv_dx;
        var ax0, asx = _pv_flip_axis(hx, nx);
        var ay0, asy = _pv_flip_axis(hy, ny);
        var fsx: f64 = asx;
        var fsy: f64 = asy;
        var new_vx: f64 = _pv_flip_sample(vx, nx, ax0, ay0, fsx, fsy);
        var new_vy: f64 = _pv_flip_sample(vy, nx, ax0, ay0, fsx, fsy);
        var old_vx: f64 = _pv_flip_sample(ox, nx, ax0, ay0, fsx, fsy);
        var old_vy: f64 = _pv_flip_sample(oy, nx, ax0, ay0, fsx, fsy);
        var dvx: f64 = new_vx - old_vx;
        var dvy: f64 = new_vy - old_vy;
        var bx: f64 = flip * (pq.velocity.x + dvx) + pic * new_vx;
        var by: f64 = flip * (pq.velocity.y + dvy) + pic * new_vy;
        pq.velocity.x = bx;
        pq.velocity.y = by;
    }
    _pv_span_end(trace); return 1;
}

impl PvFlipSolver {
    # The grid width in cells. Mirrors `FlipSolver::grid_nx`.
    #must_use
    fn grid_nx(self): i64 {
        return self.nx;
    }

    # The grid height in cells. Mirrors `FlipSolver::grid_ny`.
    #must_use
    fn grid_ny(self): i64 {
        return self.ny;
    }

    # The cell size. Mirrors `FlipSolver::grid_dx`.
    #must_use
    fn grid_dx(self): f64 {
        return self.dx;
    }

    # One FLIP/PIC step of the n particles at ps under `gravity` over dt, in Rust's order:
    # 1. the checks: dt finite and > 0 (PV_ERR_INVALID_TIMESTEP), the blend finite (PV_ERR_INVALID_PARAMETER);
    # 2. with `use_apic`, the APIC column resized to n (PV_ERR_OUT_OF_MEMORY, nothing changed, when it can't grow);
    # 3. P2G, then the pre-solve copy of vx and vy, then gravity·dt on every node (x and y);
    # 4. the projection: the divergence −((vx[i+1] − vx[i−1]) + (vy[i+nx] − vy[i−nx]))·((0.5/dx)/dt) on the interior,
    #    at most 40 Gauss–Seidel sweeps of p = (div·dx² + Σ neighbours)·0.25 (warm-started from the last step; done
    #    when no cell changes by 1e-6), and the gradient times dt·(0.5/dx) subtracted;
    # 5. PV_ERR_DIVERGED if any node's velocity isn't finite (the grid is left as computed, the particles as they were);
    # 6. G2P, then each position advanced by v·dt (z included) and clamped to [0, (n − 1)·dx] on x and y, the clamped
    #    axis's velocity set to 0.
    # Ok(0). Mirrors `FlipSolver::step`.
    #must_use
    fn step(self, ps: *PvFluidParticle, n, gravity: PvVec3, dt: f64): Result {
        var trace = _pv_span(_PV_LOG_COUPLING, "flip::step", "n", n, 0, 0, 0, 0);
        if (_pv_is_finite(dt) == 0 || dt <= 0.0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_TIMESTEP); }
        if (_pv_is_finite(self.flip_ratio) == 0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_PARAMETER); }
        var nx = self.nx;
        var ny = self.ny;
        if (self.use_apic == 1 && self.apic_c.len != 4 * n) {
            if (_pv_flip_apic_resize(self, n) == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
        }
        _pv_flip_p2g(self, ps, n);
        var cells = nx * ny;
        var vx = self.vx.data;
        var vy = self.vy.data;
        var ox = self.vx_old.data;
        var oy = self.vy_old.data;
        for (var c = 0; c < cells; c = c + 1) {
            store64(ox + c * 8, load64(vx + c * 8));
            store64(oy + c * 8, load64(vy + c * 8));
        }
        var gx: f64 = gravity.x;
        var gy: f64 = gravity.y;
        var gdx: f64 = gx * dt;
        var gdy: f64 = gy * dt;
        for (var i = 0; i < cells; i = i + 1) {
            var a: f64 = load64(vx + i * 8);
            var b: f64 = load64(vy + i * 8);
            var na: f64 = a + gdx;
            var nb: f64 = b + gdy;
            store64(vx + i * 8, _pv_bits(na));
            store64(vy + i * 8, _pv_bits(nb));
        }
        # The projection.
        var half: f64 = 0.5;
        var inv_2dx: f64 = half / self.dx;
        var dv = self.div.data;
        var pr = self.pressure.data;
        for (var z = 0; z < cells; z = z + 1) { store64(dv + z * 8, 0); }
        var div_scale: f64 = inv_2dx / dt;
        for (var y = 1; y < ny - 1; y = y + 1) {
            for (var x = 1; x < nx - 1; x = x + 1) {
                var j = y * nx + x;
                var xr: f64 = load64(vx + (j + 1) * 8);
                var xl: f64 = load64(vx + (j - 1) * 8);
                var yu: f64 = load64(vy + (j + nx) * 8);
                var yd: f64 = load64(vy + (j - nx) * 8);
                var sum: f64 = (xr - xl) + (yu - yd);
                var neg: f64 = -sum;
                var d: f64 = neg * div_scale;
                store64(dv + j * 8, _pv_bits(d));
            }
        }
        var dx2: f64 = self.dx * self.dx;
        var quarter: f64 = 0.25;
        var tol: f64 = 0x3EB0C6F7A0B5ED8D;   # 1e-6
        for (var it = 0; it < _PV_COUPLING_PRESSURE_ITERATIONS; it = it + 1) {
            var max_change: f64 = 0.0;
            for (var y2 = 1; y2 < ny - 1; y2 = y2 + 1) {
                for (var x2 = 1; x2 < nx - 1; x2 = x2 + 1) {
                    var k = y2 * nx + x2;
                    var pl: f64 = load64(pr + (k - 1) * 8);
                    var prt: f64 = load64(pr + (k + 1) * 8);
                    var pd: f64 = load64(pr + (k - nx) * 8);
                    var pu: f64 = load64(pr + (k + nx) * 8);
                    var nbr: f64 = ((pl + prt) + pd) + pu;
                    var dk: f64 = load64(dv + k * 8);
                    var new_p: f64 = (dk * dx2 + nbr) * quarter;
                    var pk: f64 = load64(pr + k * 8);
                    var ch: f64 = new_p - pk;
                    var ach: f64 = f64_abs(ch);
                    # Rust's max(max_change, |Δ|): |Δ| is ≥ 0 or NaN and max_change starts at 0, so the NaN-ignoring
                    # max is this comparison.
                    if (ach > max_change) { max_change = ach; }
                    store64(pr + k * 8, _pv_bits(new_p));
                }
            }
            if (max_change < tol) { it = _PV_COUPLING_PRESSURE_ITERATIONS; }
        }
        var grad_scale: f64 = dt * inv_2dx;
        for (var y3 = 1; y3 < ny - 1; y3 = y3 + 1) {
            for (var x3 = 1; x3 < nx - 1; x3 = x3 + 1) {
                var m = y3 * nx + x3;
                var pa: f64 = load64(pr + (m + 1) * 8);
                var pb: f64 = load64(pr + (m - 1) * 8);
                var pc: f64 = load64(pr + (m + nx) * 8);
                var pdn: f64 = load64(pr + (m - nx) * 8);
                var ux: f64 = load64(vx + m * 8);
                var uy: f64 = load64(vy + m * 8);
                var nux: f64 = ux - (pa - pb) * grad_scale;
                var nuy: f64 = uy - (pc - pdn) * grad_scale;
                store64(vx + m * 8, _pv_bits(nux));
                store64(vy + m * 8, _pv_bits(nuy));
            }
        }
        # Every node finite: x − x is 0 for a finite x and NaN otherwise (`_pv_is_finite`, written out: `#inline`
        # declines it).
        for (var q = 0; q < cells; q = q + 1) {
            var fx: f64 = load64(vx + q * 8);
            var fy: f64 = load64(vy + q * 8);
            var zx: f64 = fx - fx;
            var zy: f64 = fy - fy;
            if (!(zx == 0.0) || !(zy == 0.0)) { _pv_span_end(trace); return Err(PV_ERR_DIVERGED); }
        }
        if (_pv_flip_g2p(self, ps, n) == 0) { _pv_span_end(trace); return Err(PV_ERR_OUT_OF_MEMORY); }
        # Advection, and the clamp to the grid.
        var nxf: f64 = f64_from(nx - 1);
        var nyf: f64 = f64_from(ny - 1);
        var max_x: f64 = nxf * self.dx;
        var max_y: f64 = nyf * self.dx;
        for (var r = 0; r < n; r = r + 1) {
            var p: *PvFluidParticle = ps + r;
            var px: f64 = p.position.x + p.velocity.x * dt;
            var py: f64 = p.position.y + p.velocity.y * dt;
            var pz: f64 = p.position.z + p.velocity.z * dt;
            p.position.x = px;
            p.position.y = py;
            p.position.z = pz;
            if (px < 0.0) {
                p.position.x = 0.0;
                p.velocity.x = 0.0;
            } elif (px > max_x) {
                p.position.x = max_x;
                p.velocity.x = 0.0;
            }
            if (py < 0.0) {
                p.position.y = 0.0;
                p.velocity.y = 0.0;
            } elif (py > max_y) {
                p.position.y = max_y;
                p.velocity.y = 0.0;
            }
        }
        _pv_span_end(trace); return Ok(0);
    }
}

# --- mpm.cyr ---

# mpm.cyr — the material point method of rust-old/src/mpm.rs (M6 part c): per-particle deformation gradients and
# constitutive stress (a weakly compressible fluid, a Neo-Hookean solid, Drucker–Prager sand with its plastic
# projection), transferred on a background grid with separating walls.
#
# `ConstitutiveModel` is a data-carrying enum: the kind enum `PvConstitutiveModel` and the payload struct
# `PvConstitutiveLaw`, the union of the variants' fields (port plan §7.3, ADR 0002 #25). Rust's `[f64; 4]` 2 × 2
# matrices (the deformation gradient, the stress) are `PvMat2`, row-major. Every formula is Rust's in its operation
# order, on the correctly rounded primitives (src/crmath.cyr, src/crlog.cyr): the 2 × 2 SVD's hypot, atan2, sin and
# cos, the Hencky strain's ln and exp, the friction angle's sin. So the step and stress rows are class C, equal to the
# corrected oracle where glibc misrounds (tests/golden/mpm.cr.tsv). The grid's cell lookup is the FLIP solver's
# (`_pv_flip_axis`, the same expression). A kind outside the enum, which Rust can't hold, is refused by `validate`
# and gives a NaN stress. Rust's `trace_span!` arrives with M7's logging. Slices are (pointer, count) (ADR 0002 #9).

# ── ConstitutiveModel ───────────────────────────────────────────────────────────────

# The kind of a constitutive model: explicit, append-only values (Rust's `#[non_exhaustive]` enum in declaration
# order). Its payload is `PvConstitutiveLaw`. Mirrors `ConstitutiveModel`.
enum PvConstitutiveModel {
    PV_CONSTITUTIVE_MODEL_FLUID = 0;
    PV_CONSTITUTIVE_MODEL_NEO_HOOKEAN = 1;
    PV_CONSTITUTIVE_MODEL_DRUCKER_PRAGER = 2;
}

# A constitutive model: its kind and the union of the variants' fields (a field the kind doesn't use is 0). A fluid
# has a bulk modulus K and a viscosity (validated, not applied, as in Rust); a Neo-Hookean solid Young's modulus E and
# Poisson's ratio ν; Drucker–Prager sand E, ν and a friction angle in degrees. Mirrors `ConstitutiveModel`.
struct PvConstitutiveLaw {
    kind;
    bulk_modulus: f64;
    viscosity: f64;
    youngs_modulus: f64;
    poisson_ratio: f64;
    friction_angle: f64;
}

# A weakly compressible fluid: σ = K·(J − 1)·I. Mirrors `ConstitutiveModel::Fluid { bulk_modulus, viscosity }`.
#must_use
fn PvConstitutiveLaw_fluid(bulk_modulus: f64, viscosity: f64): PvConstitutiveLaw {
    var m: PvConstitutiveLaw;
    m.kind = PV_CONSTITUTIVE_MODEL_FLUID;
    m.bulk_modulus = bulk_modulus;
    m.viscosity = viscosity;
    m.youngs_modulus = 0.0;
    m.poisson_ratio = 0.0;
    m.friction_angle = 0.0;
    return m;
}

# A Neo-Hookean solid. Mirrors `ConstitutiveModel::NeoHookean { youngs_modulus, poisson_ratio }`.
#must_use
fn PvConstitutiveLaw_neo_hookean(youngs_modulus: f64, poisson_ratio: f64): PvConstitutiveLaw {
    var m: PvConstitutiveLaw;
    m.kind = PV_CONSTITUTIVE_MODEL_NEO_HOOKEAN;
    m.bulk_modulus = 0.0;
    m.viscosity = 0.0;
    m.youngs_modulus = youngs_modulus;
    m.poisson_ratio = poisson_ratio;
    m.friction_angle = 0.0;
    return m;
}

# Drucker–Prager sand, the friction angle in degrees. Mirrors `ConstitutiveModel::DruckerPrager { youngs_modulus,
# poisson_ratio, friction_angle }`.
#must_use
fn PvConstitutiveLaw_drucker_prager(youngs_modulus: f64, poisson_ratio: f64, friction_angle: f64): PvConstitutiveLaw {
    var m: PvConstitutiveLaw;
    m.kind = PV_CONSTITUTIVE_MODEL_DRUCKER_PRAGER;
    m.bulk_modulus = 0.0;
    m.viscosity = 0.0;
    m.youngs_modulus = youngs_modulus;
    m.poisson_ratio = poisson_ratio;
    m.friction_angle = friction_angle;
    return m;
}

# The Rust variant name of a model kind (`"Fluid"`), or "Unknown".
#must_use
fn constitutive_model_name(k): i64 {
    match k {
        PV_CONSTITUTIVE_MODEL_FLUID => { return "Fluid"; }
        PV_CONSTITUTIVE_MODEL_NEO_HOOKEAN => { return "NeoHookean"; }
        PV_CONSTITUTIVE_MODEL_DRUCKER_PRAGER => { return "DruckerPrager"; }
        _ => { return "Unknown"; }
    }
    return "Unknown";
}

# Ok(0) for E finite and > 0 with ν finite in (−1, 0.5), else Err(PV_ERR_INVALID_PARAMETER) (E checked first). Mirrors
# the private `validate_elastic`.
#must_use
fn _pv_mpm_validate_elastic(youngs_modulus: f64, poisson_ratio: f64): Result {
    if (youngs_modulus <= 0.0 || _pv_is_finite(youngs_modulus) == 0) { return Err(PV_ERR_INVALID_PARAMETER); }
    if (poisson_ratio <= -1.0 || poisson_ratio >= 0.5 || _pv_is_finite(poisson_ratio) == 0) {
        return Err(PV_ERR_INVALID_PARAMETER);
    }
    return Ok(0);
}

# Ok(0) when the model's parameters are physical, else Err(PV_ERR_INVALID_PARAMETER): a fluid's K finite and > 0 and
# its viscosity finite and ≥ 0; an elastic model's E and ν (`_pv_mpm_validate_elastic`); Drucker–Prager's friction
# angle in [0, 90) degrees as well. A kind outside the enum is refused. Mirrors `ConstitutiveModel::validate`.
#must_use
fn constitutive_model_validate(m: *PvConstitutiveLaw): Result {
    match m.kind {
        PV_CONSTITUTIVE_MODEL_FLUID => {
            if (m.bulk_modulus <= 0.0 || _pv_is_finite(m.bulk_modulus) == 0) { return Err(PV_ERR_INVALID_PARAMETER); }
            if (m.viscosity < 0.0 || _pv_is_finite(m.viscosity) == 0) { return Err(PV_ERR_INVALID_PARAMETER); }
            return Ok(0);
        }
        PV_CONSTITUTIVE_MODEL_NEO_HOOKEAN => {
            return _pv_mpm_validate_elastic(m.youngs_modulus, m.poisson_ratio);
        }
        PV_CONSTITUTIVE_MODEL_DRUCKER_PRAGER => {
            var et, ev = _pv_mpm_validate_elastic(m.youngs_modulus, m.poisson_ratio);
            if (is_err_result(et) == 1) { return Err(ev); }
            if (m.friction_angle >= 0.0 && m.friction_angle < 90.0) { return Ok(0); }
            return Err(PV_ERR_INVALID_PARAMETER);
        }
        _ => { return Err(PV_ERR_INVALID_PARAMETER); }
    }
    return Err(PV_ERR_INVALID_PARAMETER);
}

# ── the 2 × 2 algebra ───────────────────────────────────────────────────────────────

# A row-major 2 × 2 matrix [m00, m01, m10, m11]: Rust's `[f64; 4]` deformation gradient and stress.
struct PvMat2 {
    m00: f64;
    m01: f64;
    m10: f64;
    m11: f64;
}

# [m00, m01, m10, m11].
#must_use
fn PvMat2_new(m00: f64, m01: f64, m10: f64, m11: f64): PvMat2 {
    var m: PvMat2;
    m.m00 = m00;
    m.m01 = m01;
    m.m10 = m10;
    m.m11 = m11;
    return m;
}

# The Lamé parameters (μ, λ) = (E/(2·(1 + ν)), (E·ν)/((1 + ν)·(1 − 2ν))). Mirrors the private `lame`.
#must_use
fn _pv_mpm_lame(youngs_modulus: f64, poisson_ratio: f64): (f64, f64) {
    var two: f64 = 2.0;
    var one: f64 = 1.0;
    var op: f64 = one + poisson_ratio;
    var mu: f64 = youngs_modulus / (two * op);
    var en: f64 = youngs_modulus * poisson_ratio;
    var tn: f64 = two * poisson_ratio;
    var om: f64 = one - tn;
    var lambda: f64 = en / (op * om);
    return (mu, lambda);
}

# The closed-form SVD of the 2 × 2 matrix at a (four words, row-major) into the six words at out: u's (cos, sin),
# σ = (q + r, q − r) and vᵀ's (cos, sin), with A = R(u)·diag(σ)·R(vᵀ), R(c, s) = [[c, −s], [s, c]]; σ₁ carries det A's
# sign. e, f, g, h are the halves of the sums and differences; q = hypot(e, h), r = hypot(f, g); the angles are
# atan2(g, f) and atan2(h, e); φ = ½(a2 + a1) and θ = ½(a2 − a1) go through sin and cos (all correctly rounded).
# Mirrors the private `svd2`.
fn _pv_mpm_svd2(a, out) {
    var a00: f64 = load64(a);
    var a01: f64 = load64(a + 8);
    var a10: f64 = load64(a + 16);
    var a11: f64 = load64(a + 24);
    var half: f64 = 0.5;
    var e: f64 = half * (a00 + a11);
    var f: f64 = half * (a00 - a11);
    var g: f64 = half * (a10 + a01);
    var h: f64 = half * (a10 - a01);
    var q: f64 = _pv_hypot(e, h);
    var r: f64 = _pv_hypot(f, g);
    var a1: f64 = _pv_atan2(g, f);
    var a2: f64 = _pv_atan2(h, e);
    var theta: f64 = half * (a2 - a1);
    var phi: f64 = half * (a2 + a1);
    var sp, cp = _pv_sin_cos(phi);
    var st, ct = _pv_sin_cos(theta);
    var s_phi: f64 = sp;
    var c_phi: f64 = cp;
    var s_theta: f64 = st;
    var c_theta: f64 = ct;
    var s0: f64 = q + r;
    var s1: f64 = q - r;
    store64(out, _pv_bits(c_phi));
    store64(out + 8, _pv_bits(s_phi));
    store64(out + 16, _pv_bits(s0));
    store64(out + 24, _pv_bits(s1));
    store64(out + 32, _pv_bits(c_theta));
    store64(out + 40, _pv_bits(s_theta));
    return 0;
}

# R(u)·diag(σ)·R(vᵀ) from the six words at svd (u's cos and sin, σ, vᵀ's cos and sin) with σ replaced by (s0, s1),
# into the four words at out, row-major. Mirrors the private `compose2`.
fn _pv_mpm_compose2(svd, s0: f64, s1: f64, out) {
    var cu: f64 = load64(svd);
    var su: f64 = load64(svd + 8);
    var cv: f64 = load64(svd + 32);
    var sv: f64 = load64(svd + 40);
    var m00: f64 = cu * s0;
    var nsu: f64 = -su;
    var m01: f64 = nsu * s1;
    var m10: f64 = su * s0;
    var m11: f64 = cu * s1;
    var nm00: f64 = -m00;
    var nm10: f64 = -m10;
    var r00: f64 = m00 * cv + m01 * sv;
    var r01: f64 = nm00 * sv + m01 * cv;
    var r10: f64 = m10 * cv + m11 * sv;
    var r11: f64 = nm10 * sv + m11 * cv;
    store64(out, _pv_bits(r00));
    store64(out + 8, _pv_bits(r01));
    store64(out + 16, _pv_bits(r10));
    store64(out + 24, _pv_bits(r11));
    return 0;
}

# ln(max(x, 1e-6)): one Hencky strain. `MIN_SINGULAR_VALUE` keeps ln σ finite.
#must_use
fn _pv_mpm_hencky(x: f64): f64 {
    var m: f64 = _pv_max(x, _PV_MPM_MIN_SINGULAR_VALUE);
    var l: f64 = _pv_ln(m);
    return l;
}

# The deformation gradient at f (four words) projected onto the Drucker–Prager yield cone (Klár et al. 2016), into the
# four words at out: the Hencky strains e = ln max(σ, 1e-6); expansion (tr e > 0) returns to the cone tip (σ = (1,
# 1)); otherwise the deviatoric part is shrunk by Δγ = |dev| + ((2λ + 2μ)/(2μ))·tr·α, α = (√(2/3)·2·sin φ)/(3 − sin φ),
# unless Δγ ≤ 0 or |dev| ≤ 0 (inside the cone: f unchanged). Mirrors the private `drucker_prager_project`.
fn _pv_mpm_dp_project(f, youngs_modulus: f64, poisson_ratio: f64, friction_angle_deg: f64, out) {
    var mu0, lam0 = _pv_mpm_lame(youngs_modulus, poisson_ratio);
    var mu: f64 = mu0;
    var lambda: f64 = lam0;
    var svd[48];
    _pv_mpm_svd2(f, &svd);
    var sg0: f64 = load64(&svd + 16);
    var sg1: f64 = load64(&svd + 24);
    var e0: f64 = _pv_mpm_hencky(sg0);
    var e1: f64 = _pv_mpm_hencky(sg1);
    var tr: f64 = e0 + e1;
    var one: f64 = 1.0;
    if (tr > 0.0) {
        _pv_mpm_compose2(&svd, one, one, out);
        return 0;
    }
    var half: f64 = 0.5;
    var htr: f64 = half * tr;
    var dev0: f64 = e0 - htr;
    var dev1: f64 = e1 - htr;
    var dev_norm: f64 = _pv_hypot(dev0, dev1);
    var rad: f64 = _pv_to_radians(friction_angle_deg);
    var sin_phi: f64 = _pv_sin(rad);
    var two: f64 = 2.0;
    var three: f64 = 3.0;
    var r23: f64 = two / three;
    var sq: f64 = f64_sqrt(r23);
    var an: f64 = (sq * two) * sin_phi;
    var alpha: f64 = an / (three - sin_phi);
    var num: f64 = two * lambda + two * mu;
    var den: f64 = two * mu;
    var coef: f64 = ((num / den) * tr) * alpha;
    var delta_gamma: f64 = dev_norm + coef;
    if (delta_gamma <= 0.0 || dev_norm <= 0.0) {
        for (var k = 0; k < 4; k = k + 1) { store64(out + k * 8, load64(f + k * 8)); }
        return 0;
    }
    var scale: f64 = delta_gamma / dev_norm;
    var h0: f64 = e0 - scale * dev0;
    var h1: f64 = e1 - scale * dev1;
    var x0: f64 = _pv_exp(h0);
    var x1: f64 = _pv_exp(h1);
    _pv_mpm_compose2(&svd, x0, x1, out);
    return 0;
}

# ── MpmParticle ─────────────────────────────────────────────────────────────────────

# A particle's MPM state: its deformation gradient F (identity at rest), its constitutive model, and its reference
# volume. Mirrors `MpmParticle`.
struct PvMpmParticle {
    deformation_grad: PvMat2;
    model: PvConstitutiveLaw;
    volume_0: f64;
}

# A typed view of a word (an MPM particle array's address).
#must_use
fn _pv_as_mpm_particles(p): *PvMpmParticle {
    return p;
}

# A typed view of a word (a model's address).
#must_use
fn _pv_as_law(p): *PvConstitutiveLaw {
    return p;
}

# MPM particle mp's model, at byte offset 32 (tests/mpm.tcyr pins the layout).
#must_use
fn _pv_mpm_model(mp): *PvConstitutiveLaw {
    return _pv_as_law(_pv_addr(mp) + 32);
}

# A particle of `model` at rest: F the identity. Mirrors `MpmParticle::new`.
#must_use
fn PvMpmParticle_new(model: PvConstitutiveLaw, volume_0: f64): PvMpmParticle {
    var p: PvMpmParticle;
    p.deformation_grad = PvMat2_new(1.0, 0.0, 0.0, 1.0);
    p.model = model;
    p.volume_0 = volume_0;
    return p;
}

# The Cauchy stress of MPM particle mp into the four words at out, row-major (tension positive), with J = max(det F,
# 1e-10):
# - a fluid: K·(J − 1) on the diagonal;
# - Neo-Hookean: (μ·(1/J))·(FFᵀ − I) + (λ·ln J)·(1/J)·I;
# - Drucker–Prager: St. Venant–Kirchhoff in Hencky strain, U·diag(t)·Uᵀ with tᵢ = (2μ·eᵢ + λ·tr e)/J, e = ln max(σ,
#   1e-6) from the SVD (the friction angle acts in the projection, not here);
# NaN for a kind outside the enum.
fn _pv_mpm_stress_into(mp: *PvMpmParticle, out) {
    var f00: f64 = mp.deformation_grad.m00;
    var f01: f64 = mp.deformation_grad.m01;
    var f10: f64 = mp.deformation_grad.m10;
    var f11: f64 = mp.deformation_grad.m11;
    var det: f64 = f00 * f11 - f01 * f10;
    var jmin: f64 = 0x3DDB7CDFD9D7BDBB;   # 1e-10
    var j: f64 = _pv_max(det, jmin);
    var one: f64 = 1.0;
    var zero: f64 = 0.0;
    var m: *PvConstitutiveLaw = _pv_mpm_model(mp);
    if (m.kind == PV_CONSTITUTIVE_MODEL_FLUID) {
        var s: f64 = m.bulk_modulus * (j - one);
        store64(out, _pv_bits(s));
        store64(out + 8, _pv_bits(zero));
        store64(out + 16, _pv_bits(zero));
        store64(out + 24, _pv_bits(s));
        return 0;
    }
    if (m.kind == PV_CONSTITUTIVE_MODEL_NEO_HOOKEAN) {
        var mu0, lam0 = _pv_mpm_lame(m.youngs_modulus, m.poisson_ratio);
        var mu: f64 = mu0;
        var lambda: f64 = lam0;
        var ln_j: f64 = _pv_ln(j);
        var inv_j: f64 = one / j;
        var fft00: f64 = f00 * f00 + f01 * f01;
        var fft01: f64 = f00 * f10 + f01 * f11;
        var fft11: f64 = f10 * f10 + f11 * f11;
        var mi: f64 = mu * inv_j;
        var vol: f64 = (lambda * ln_j) * inv_j;
        var s00: f64 = mi * (fft00 - one) + vol;
        var s01: f64 = mi * fft01;
        var s11: f64 = mi * (fft11 - one) + vol;
        store64(out, _pv_bits(s00));
        store64(out + 8, _pv_bits(s01));
        store64(out + 16, _pv_bits(s01));
        store64(out + 24, _pv_bits(s11));
        return 0;
    }
    if (m.kind == PV_CONSTITUTIVE_MODEL_DRUCKER_PRAGER) {
        var dmu0, dlam0 = _pv_mpm_lame(m.youngs_modulus, m.poisson_ratio);
        var dmu: f64 = dmu0;
        var dlam: f64 = dlam0;
        var fw[32];
        store64(&fw, _pv_bits(f00));
        store64(&fw + 8, _pv_bits(f01));
        store64(&fw + 16, _pv_bits(f10));
        store64(&fw + 24, _pv_bits(f11));
        var svd[48];
        _pv_mpm_svd2(&fw, &svd);
        var cu: f64 = load64(&svd);
        var su: f64 = load64(&svd + 8);
        var sg0: f64 = load64(&svd + 16);
        var sg1: f64 = load64(&svd + 24);
        var e0: f64 = _pv_mpm_hencky(sg0);
        var e1: f64 = _pv_mpm_hencky(sg1);
        var tr: f64 = e0 + e1;
        var two: f64 = 2.0;
        var tm: f64 = two * dmu;
        var lt: f64 = dlam * tr;
        var t0: f64 = (tm * e0 + lt) / j;
        var t1: f64 = (tm * e1 + lt) / j;
        var off: f64 = ((t0 - t1) * cu) * su;
        var d00: f64 = (t0 * cu) * cu + (t1 * su) * su;
        var d11: f64 = (t0 * su) * su + (t1 * cu) * cu;
        store64(out, _pv_bits(d00));
        store64(out + 8, _pv_bits(off));
        store64(out + 16, _pv_bits(off));
        store64(out + 24, _pv_bits(d11));
        return 0;
    }
    var nan: f64 = PV_F64_NAN;
    for (var k = 0; k < 4; k = k + 1) { store64(out + k * 8, _pv_bits(nan)); }
    return 0;
}

impl PvMpmParticle {
    # det F = F00·F11 − F01·F10, the volume ratio J. Mirrors `MpmParticle::det_f`.
    #must_use
    fn det_f(self): f64 {
        var a: f64 = self.deformation_grad.m00;
        var b: f64 = self.deformation_grad.m01;
        var c: f64 = self.deformation_grad.m10;
        var d: f64 = self.deformation_grad.m11;
        var r: f64 = a * d - b * c;
        return r;
    }

    # The Cauchy stress from the constitutive model, row-major, tension positive (`_pv_mpm_stress_into`). Mirrors
    # `MpmParticle::stress`.
    #must_use
    fn stress(self): PvMat2 {
        var w[32];
        _pv_mpm_stress_into(self, &w);
        var a: f64 = load64(&w);
        var b: f64 = load64(&w + 8);
        var c: f64 = load64(&w + 16);
        var d: f64 = load64(&w + 24);
        return PvMat2_new(a, b, c, d);
    }
}

# ── MpmSolver ───────────────────────────────────────────────────────────────────────

# The MPM solver: the grid (nx × ny nodes of spacing dx; the domain [0, (nx − 1)·dx] × [0, (ny − 1)·dx]) and its
# fields, mass, momentum then velocity, and force, solver-owned and reused. Mirrors `MpmSolver`.
struct PvMpmSolver {
    nx;
    ny;
    dx: f64;
    mass: PvColumn;
    vx: PvColumn;
    vy: PvColumn;
    fx: PvColumn;
    fy: PvColumn;
}

# The solver's column count.
const _PV_MPM_COLUMNS = 5;

# Column k of a solver (0 mass, 1 vx, 2 vy, 3 fx, 4 fy), by its byte offset (tests/mpm.tcyr pins the layout, 144 bytes).
#must_use
fn _pv_mpm_col(s, k): *PvColumn {
    return _pv_as_columns(_pv_addr(s) + 24 + k * 24);
}

# Releases every column; the solver holds no storage after. Mirrors dropping the `MpmSolver`.
fn PvMpmSolver_drop(s: *PvMpmSolver) {
    for (var k = 0; k < _PV_MPM_COLUMNS; k = k + 1) {
        var c: *PvColumn = _pv_mpm_col(s, k);
        c.drop();
    }
    return 0;
}

# A solver of zeros into *out: Ok(0), or the first failure in Rust's order: PV_ERR_INVALID_GRID_RESOLUTION for nx or
# ny below 4, PV_ERR_INVALID_PARAMETER for a cell size not finite and > 0, PV_ERR_INVALID_GRID_RESOLUTION for nx·ny
# overflowing a usize; PV_ERR_OUT_OF_MEMORY for a size no allocation reaches (Rust's `vec!` aborts) or when the fields
# can't be allocated. On an error *out holds no storage. Mirrors `MpmSolver::new`.
#must_use
fn PvMpmSolver_new(nx, ny, dx: f64, out: *PvMpmSolver): Result {
    for (var z = 0; z < _PV_MPM_COLUMNS; z = z + 1) {
        var c0: *PvColumn = _pv_mpm_col(out, z);
        c0.data = 0;
        c0.len = 0;
        c0.cap = 0;
    }
    # nx and ny are usizes: a word at or above 2^63 reads negative, and is a size Rust accepts until nx·ny.
    if ((nx >= 0 && nx < 4) || (ny >= 0 && ny < 4)) { return Err(PV_ERR_INVALID_GRID_RESOLUTION); }
    if (dx <= 0.0 || _pv_is_finite(dx) == 0) { return Err(PV_ERR_INVALID_PARAMETER); }
    var ov = _pv_fg_mul_class(nx, ny);
    if (ov == 2) { return Err(PV_ERR_INVALID_GRID_RESOLUTION); }
    if (ov == 1) { return Err(PV_ERR_OUT_OF_MEMORY); }
    var size = nx * ny;
    var ok = 1;
    for (var k = 0; k < _PV_MPM_COLUMNS; k = k + 1) {
        var c: *PvColumn = _pv_mpm_col(out, k);
        ok = ok & c.resize(size, 0);
    }
    if (ok == 0) {
        PvMpmSolver_drop(out);
        return Err(PV_ERR_OUT_OF_MEMORY);
    }
    out.nx = nx;
    out.ny = ny;
    out.dx = dx;
    return Ok(0);
}

impl PvMpmSolver {
    # One MPM step of the n particles at ps with their MPM states at mpm (nm of them) under `gravity` over dt, in
    # Rust's order:
    # 1. the checks: dt finite and > 0 (PV_ERR_INVALID_TIMESTEP); nm = n (PV_ERR_INVALID_PARAMETER); each model valid
    #    and each reference volume finite and > 0, in order (PV_ERR_INVALID_PARAMETER); nothing has changed yet;
    # 2. P2G: each particle's bilinear weights w scatter w·m, (w·m)·v and −V·(σ·∇w) (V = V₀·|det F|) to its four nodes;
    # 3. the grid: each node with mass above 1e-20 gets v = p/m + (g + f/m)·dt, its outward component zeroed on a wall
    #    (separating walls); the others keep their momentum;
    # 4. G2P, particle by particle: v = Σ w·vᵢ and L = Σ vᵢ ⊗ ∇wᵢ, F ← (I + dt·L)·F, projected for Drucker–Prager, and
    #    reset to the identity when det F is outside [1e-4, 1e4] or not finite; then x += v·dt (z included), kept in
    #    the domain with the outward velocity removed.
    # Ok(0). Mirrors `MpmSolver::step`.
    #must_use
    fn step(self, ps: *PvFluidParticle, n, mpm: *PvMpmParticle, nm, gravity: PvVec3, dt: f64): Result {
        var trace = _pv_span(_PV_LOG_MPM, "mpm::step", "n", n, 0, 0, 0, 0);
        if (_pv_is_finite(dt) == 0 || dt <= 0.0) { _pv_span_end(trace); return Err(PV_ERR_INVALID_TIMESTEP); }
        if (n != nm) { _pv_span_end(trace); return Err(PV_ERR_INVALID_PARAMETER); }
        for (var c = 0; c < nm; c = c + 1) {
            var mc: *PvMpmParticle = mpm + c;
            var vt, vv = constitutive_model_validate(_pv_mpm_model(mc));
            if (is_err_result(vt) == 1) { _pv_span_end(trace); return Err(vv); }
            if (_pv_is_finite(mc.volume_0) == 0 || mc.volume_0 <= 0.0) {
                _pv_span_end(trace);
                return Err(PV_ERR_INVALID_PARAMETER);
            }
        }
        var nx = self.nx;
        var ny = self.ny;
        var dx: f64 = self.dx;
        var one: f64 = 1.0;
        var inv_dx: f64 = one / dx;
        var fnx: f64 = f64_from(nx - 1);
        var fny: f64 = f64_from(ny - 1);
        var x_max: f64 = fnx * dx;
        var y_max: f64 = fny * dx;
        var cells = nx * ny;
        var gm = self.mass.data;
        var gvx = self.vx.data;
        var gvy = self.vy.data;
        var gfx = self.fx.data;
        var gfy = self.fy.data;
        for (var z = 0; z < cells; z = z + 1) {
            store64(gm + z * 8, 0);
            store64(gvx + z * 8, 0);
            store64(gvy + z * 8, 0);
            store64(gfx + z * 8, 0);
            store64(gfy + z * 8, 0);
        }
        # P2G.
        var sw[32];
        for (var pi = 0; pi < n; pi = pi + 1) {
            var p: *PvFluidParticle = ps + pi;
            var mp: *PvMpmParticle = mpm + pi;
            var gx: f64 = p.position.x * inv_dx;
            var gy: f64 = p.position.y * inv_dx;
            var x0, sxv = _pv_flip_axis(gx, nx);
            var y0, syv = _pv_flip_axis(gy, ny);
            var sx: f64 = sxv;
            var sy: f64 = syv;
            _pv_mpm_stress_into(mp, &sw);
            var s0: f64 = load64(&sw);
            var s1: f64 = load64(&sw + 8);
            var s2: f64 = load64(&sw + 16);
            var s3: f64 = load64(&sw + 24);
            var det: f64 = mp.det_f();
            var adet: f64 = f64_abs(det);
            var vol: f64 = mp.volume_0 * adet;
            var ux: f64 = one - sx;
            var uy: f64 = one - sy;
            var pm: f64 = p.mass;
            var pvx: f64 = p.velocity.x;
            var pvy: f64 = p.velocity.y;
            for (var k = 0; k < 4; k = k + 1) {
                var w: f64 = ux * uy;
                var ix = x0;
                var iy = y0;
                if (k == 1) {
                    w = sx * uy;
                    ix = x0 + 1;
                } elif (k == 2) {
                    w = ux * sy;
                    iy = y0 + 1;
                } elif (k == 3) {
                    w = sx * sy;
                    ix = x0 + 1;
                    iy = y0 + 1;
                }
                var idx = iy * nx + ix;
                var wm: f64 = w * pm;
                var om: f64 = load64(gm + idx * 8);
                var nmass: f64 = om + wm;
                store64(gm + idx * 8, _pv_bits(nmass));
                var ox: f64 = load64(gvx + idx * 8);
                var nvx: f64 = ox + wm * pvx;
                store64(gvx + idx * 8, _pv_bits(nvx));
                var oy: f64 = load64(gvy + idx * 8);
                var nvy: f64 = oy + wm * pvy;
                store64(gvy + idx * 8, _pv_bits(nvy));
                # The bilinear weight's gradient: ±(the other axis's weight)·(1/dx).
                var wy: f64 = sy;
                if (iy == y0) { wy = uy; }
                var wx: f64 = sx;
                if (ix == x0) { wx = ux; }
                var gw_x: f64 = wy * inv_dx;
                if (ix == x0) {
                    var nwy: f64 = -wy;
                    gw_x = nwy * inv_dx;
                }
                var gw_y: f64 = wx * inv_dx;
                if (iy == y0) {
                    var nwx: f64 = -wx;
                    gw_y = nwx * inv_dx;
                }
                var ofx: f64 = load64(gfx + idx * 8);
                var ofy: f64 = load64(gfy + idx * 8);
                var nfx: f64 = ofx - vol * (s0 * gw_x + s1 * gw_y);
                var nfy: f64 = ofy - vol * (s2 * gw_x + s3 * gw_y);
                store64(gfx + idx * 8, _pv_bits(nfx));
                store64(gfy + idx * 8, _pv_bits(nfy));
            }
        }
        # The grid: momentum to velocity, gravity and the force, separating walls.
        var tiny: f64 = 0x3BC79CA10C924223;   # 1e-20
        var gxv: f64 = gravity.x;
        var gyv: f64 = gravity.y;
        for (var j = 0; j < ny; j = j + 1) {
            for (var i = 0; i < nx; i = i + 1) {
                var q = j * nx + i;
                var mq: f64 = load64(gm + q * 8);
                if (!(mq <= tiny)) {
                    var inv_m: f64 = one / mq;
                    var px: f64 = load64(gvx + q * 8);
                    var py: f64 = load64(gvy + q * 8);
                    var qfx: f64 = load64(gfx + q * 8);
                    var qfy: f64 = load64(gfy + q * 8);
                    var vx: f64 = px * inv_m + (gxv + qfx * inv_m) * dt;
                    var vy: f64 = py * inv_m + (gyv + qfy * inv_m) * dt;
                    if ((i == 0 && vx < 0.0) || (i == nx - 1 && vx > 0.0)) { vx = 0.0; }
                    if ((j == 0 && vy < 0.0) || (j == ny - 1 && vy > 0.0)) { vy = 0.0; }
                    store64(gvx + q * 8, _pv_bits(vx));
                    store64(gvy + q * 8, _pv_bits(vy));
                }
            }
        }
        # G2P, F, advection and the walls.
        var lo: f64 = 0x3F1A36E2EB1C432D;   # 1e-4
        var hi: f64 = 10000.0;
        var nf[32];
        var pf[32];
        for (var r = 0; r < n; r = r + 1) {
            var pr: *PvFluidParticle = ps + r;
            var mr: *PvMpmParticle = mpm + r;
            var hx: f64 = pr.position.x * inv_dx;
            var hy: f64 = pr.position.y * inv_dx;
            var ax0, asx = _pv_flip_axis(hx, nx);
            var ay0, asy = _pv_flip_axis(hy, ny);
            var tx: f64 = asx;
            var ty: f64 = asy;
            var tux: f64 = one - tx;
            var tuy: f64 = one - ty;
            var new_vx: f64 = 0.0;
            var new_vy: f64 = 0.0;
            var dvx_dx: f64 = 0.0;
            var dvx_dy: f64 = 0.0;
            var dvy_dx: f64 = 0.0;
            var dvy_dy: f64 = 0.0;
            for (var k2 = 0; k2 < 4; k2 = k2 + 1) {
                var wk: f64 = tux * tuy;
                var gxk: f64 = -tuy;
                var gyk: f64 = -tux;
                var nidx = ay0 * nx + ax0;
                if (k2 == 1) {
                    wk = tx * tuy;
                    gxk = tuy;
                    gyk = -tx;
                    nidx = nidx + 1;
                } elif (k2 == 2) {
                    wk = tux * ty;
                    gxk = -ty;
                    gyk = tux;
                    nidx = nidx + nx;
                } elif (k2 == 3) {
                    wk = tx * ty;
                    gxk = ty;
                    gyk = tx;
                    nidx = nidx + nx + 1;
                }
                var gxs: f64 = gxk * inv_dx;
                var gys: f64 = gyk * inv_dx;
                var nvx2: f64 = load64(gvx + nidx * 8);
                var nvy2: f64 = load64(gvy + nidx * 8);
                new_vx = new_vx + wk * nvx2;
                new_vy = new_vy + wk * nvy2;
                dvx_dx = dvx_dx + nvx2 * gxs;
                dvx_dy = dvx_dy + nvx2 * gys;
                dvy_dx = dvy_dx + nvy2 * gxs;
                dvy_dy = dvy_dy + nvy2 * gys;
            }
            # F ← (I + dt·L)·F.
            var f00: f64 = mr.deformation_grad.m00;
            var f01: f64 = mr.deformation_grad.m01;
            var f10: f64 = mr.deformation_grad.m10;
            var f11: f64 = mr.deformation_grad.m11;
            var axx: f64 = one + dt * dvx_dx;
            var axy: f64 = dt * dvx_dy;
            var ayx: f64 = dt * dvy_dx;
            var ayy: f64 = one + dt * dvy_dy;
            var n00: f64 = axx * f00 + axy * f10;
            var n01: f64 = axx * f01 + axy * f11;
            var n10: f64 = ayx * f00 + ayy * f10;
            var n11: f64 = ayx * f01 + ayy * f11;
            store64(&nf, _pv_bits(n00));
            store64(&nf + 8, _pv_bits(n01));
            store64(&nf + 16, _pv_bits(n10));
            store64(&nf + 24, _pv_bits(n11));
            var ml: *PvConstitutiveLaw = _pv_mpm_model(mr);
            if (ml.kind == PV_CONSTITUTIVE_MODEL_DRUCKER_PRAGER) {
                _pv_mpm_dp_project(&nf, ml.youngs_modulus, ml.poisson_ratio, ml.friction_angle, &pf);
                for (var c2 = 0; c2 < 4; c2 = c2 + 1) { store64(&nf + c2 * 8, load64(&pf + c2 * 8)); }
            }
            var q00: f64 = load64(&nf);
            var q01: f64 = load64(&nf + 8);
            var q10: f64 = load64(&nf + 16);
            var q11: f64 = load64(&nf + 24);
            var ndet: f64 = q00 * q11 - q01 * q10;
            if (ndet >= lo && ndet <= hi && _pv_is_finite(ndet) == 1) {
                mr.deformation_grad.m00 = q00;
                mr.deformation_grad.m01 = q01;
                mr.deformation_grad.m10 = q10;
                mr.deformation_grad.m11 = q11;
            } else {
                mr.deformation_grad.m00 = 1.0;
                mr.deformation_grad.m01 = 0.0;
                mr.deformation_grad.m10 = 0.0;
                mr.deformation_grad.m11 = 1.0;
            }
            var zero: f64 = 0.0;
            var px2: f64 = pr.position.x + new_vx * dt;
            var py2: f64 = pr.position.y + new_vy * dt;
            var pz2: f64 = pr.position.z + pr.velocity.z * dt;
            var vx2: f64 = new_vx;
            var vy2: f64 = new_vy;
            if (px2 < 0.0) {
                px2 = 0.0;
                vx2 = _pv_max(vx2, zero);
            } elif (px2 > x_max) {
                px2 = x_max;
                vx2 = _pv_min(vx2, zero);
            }
            if (py2 < 0.0) {
                py2 = 0.0;
                vy2 = _pv_max(vy2, zero);
            } elif (py2 > y_max) {
                py2 = y_max;
                vy2 = _pv_min(vy2, zero);
            }
            pr.position.x = px2;
            pr.position.y = py2;
            pr.position.z = pz2;
            pr.velocity.x = vx2;
            pr.velocity.y = vy2;
        }
        _pv_span_end(trace); return Ok(0);
    }
}

# --- compute.cyr ---

# compute.cyr — the compute-backend surface of rust-old/src/compute.rs (M7 part a): f32 particle buffers packed from
# the SoA for a GPU upload and unpacked back, the kernel parameter records a backend reads, the operations and the two
# backend traits (implemented by a consumer; pravash's solvers never dispatch to one), and the analytical kernel
# derivatives.
#
# Rust's `Vec<f32>` buffers are `PvF32Column`s: packed 4-byte singles a backend can upload as they are. A value is
# rounded to f32 when it is stored (Rust's `as f32`) and widened exactly when it is read back (`f64::from`). Rust's
# `[f32; 3]` gravity is three f32 fields. The traits return a status word where Rust returns `Result`, since a call
# through a `dyn` returns one value: PV_ERR_NONE (0) for Ok, or a PV_ERR_* code (ADR 0002 #26).
#
# `KernelDerivatives::autodiff_gradient` is in src/compute_ad.cyr, outside the `[lib]` bundle: it is the one function
# that calls hisab, which stays a test-scope dependency, so only a consumer that includes that file and declares hisab
# pulls it in.

# ── f32 buffers ─────────────────────────────────────────────────────────────────────

# A typed view of a word (an f32 buffer's address).
#must_use
fn _pv_as_f32s(p): *f32 {
    return p;
}

# A growable buffer of packed f32 values: the storage (4 bytes an element), the length and the capacity, in
# elements. Rust's `Vec<f32>`. Starts empty; released by `drop`.
struct PvF32Column {
    data;
    len;
    cap;
}

impl PvF32Column {
    # Room for at least n elements: 1, or 0 when the memory isn't there (unchanged).
    #must_use
    fn reserve(self, n): i64 {
        if (n <= self.cap) { return 1; }
        var d = fl_alloc(n * 4);
        if (d == 0) { return 0; }
        if (self.len > 0) { memcpy(d, self.data, self.len * 4); }
        if (self.data != 0) { fl_free(self.data); }
        self.data = d;
        self.cap = n;
        return 1;
    }

    # Appends x rounded to f32 (Rust's `x as f32`), into reserved room: the caller has reserved it.
    fn push_rounded(self, x: f64) {
        var b: *f32 = _pv_as_f32s(self.data);
        b[self.len] = x;
        self.len = self.len + 1;
        return 0;
    }

    # Element i widened to f64 (exact), unchecked. Mirrors `f64::from(v[i])`.
    #must_use
    fn at(self, i): f64 {
        var b: *f32 = _pv_as_f32s(self.data);
        var v: f32 = b[i];
        var w: f64 = f32_to(v);
        return w;
    }

    # Sets element i to x rounded to f32: 1, or 0 out of range (nothing written). Mirrors `v[i] = x as f32`.
    fn set(self, i, x: f64): i64 {
        if (i < 0 || i >= self.len) { return 0; }
        var b: *f32 = _pv_as_f32s(self.data);
        b[i] = x;
        return 1;
    }

    # Shortens the buffer to n elements (no effect when it is not longer). Mirrors `Vec::truncate`.
    fn truncate(self, n) {
        if (n >= 0 && n < self.len) { self.len = n; }
        return 0;
    }

    # Releases the storage; the buffer is empty and usable again. Mirrors dropping the `Vec`.
    fn drop(self) {
        if (self.data != 0) { fl_free(self.data); }
        self.data = 0;
        self.len = 0;
        self.cap = 0;
        return 0;
    }
}

# ── PackedParticles ─────────────────────────────────────────────────────────────────

# Particles packed into f32 buffers for a GPU upload: the count, then [x, y, z, mass] and [vx, vy, vz, 0] per
# particle (4 singles each, 16-byte aligned) and [density, pressure] per particle. Mirrors `PackedParticles`.
struct PvPackedParticles {
    count;
    position_mass: PvF32Column;
    velocity: PvF32Column;
    density_pressure: PvF32Column;
}

# A typed view of a word (a buffer's address in a packed record).
#must_use
fn _pv_as_f32_column(p): *PvF32Column {
    return p;
}

# Buffer k of a packed record (0 position_mass, 1 velocity, 2 density_pressure), by its byte offset
# (tests/compute.tcyr pins the layout, 80 bytes).
#must_use
fn _pv_packed_col(p, k): *PvF32Column {
    return _pv_as_f32_column(_pv_addr(p) + 8 + k * 24);
}

# Releases the three buffers; the record is empty after (count 0). Mirrors dropping the `PackedParticles`.
fn PvPackedParticles_drop(p: *PvPackedParticles) {
    for (var k = 0; k < 3; k = k + 1) {
        var c: *PvF32Column = _pv_packed_col(p, k);
        c.drop();
    }
    p.count = 0;
    return 0;
}

# Column d set to a copy of column s's elements (d holds no storage before): 1, or 0 when the memory isn't there (d
# then holds none). Rust's `Vec<f32>::clone`.
#must_use
fn _pv_f32_clone(d: *PvF32Column, s: *PvF32Column): i64 {
    d.data = 0;
    d.len = 0;
    d.cap = 0;
    if (s.len == 0) { return 1; }
    if (d.reserve(s.len) == 0) { return 0; }
    memcpy(d.data, s.data, s.len * 4);
    d.len = s.len;
    return 1;
}

# A deep copy of `src` into *out (a different record): the count and the three buffers at their own lengths. 1, or 0
# when the memory isn't there (then *out holds no storage, count 0). Mirrors the derived `Clone`.
#must_use
fn PvPackedParticles_clone(out: *PvPackedParticles, src: *PvPackedParticles): i64 {
    for (var k = 0; k < 3; k = k + 1) {
        var z: *PvF32Column = _pv_packed_col(out, k);
        z.data = 0;
        z.len = 0;
        z.cap = 0;
    }
    out.count = 0;
    for (var k = 0; k < 3; k = k + 1) {
        if (_pv_f32_clone(_pv_packed_col(out, k), _pv_packed_col(src, k)) == 0) {
            PvPackedParticles_drop(out);
            return 0;
        }
    }
    out.count = src.count;
    return 1;
}

# Packs the SoA's complete particles (`consistent_len`, at most u32::MAX) into *out, each value rounded to f32:
# [x, y, z, mass], [vx, vy, vz, 0] and [density, pressure] per particle. 1, or 0 when the buffers can't be allocated
# (Rust aborts); *out then holds no storage. Mirrors `PackedParticles::from_soa`.
#must_use
fn PvPackedParticles_from_soa(soa: *PvParticleSoa, out: *PvPackedParticles): i64 {
    for (var k = 0; k < 3; k = k + 1) {
        var z: *PvF32Column = _pv_packed_col(out, k);
        z.data = 0;
        z.len = 0;
        z.cap = 0;
    }
    out.count = 0;
    var n = soa.consistent_len();
    if (n > 4294967295) { n = 4294967295; }
    var pm: *PvF32Column = _pv_packed_col(out, 0);
    var vl: *PvF32Column = _pv_packed_col(out, 1);
    var dp: *PvF32Column = _pv_packed_col(out, 2);
    var ok = pm.reserve(4 * n) & vl.reserve(4 * n) & dp.reserve(2 * n);
    if (ok == 0) {
        PvPackedParticles_drop(out);
        return 0;
    }
    # The SoA's columns by index: 0–2 position, 3–5 velocity, 9 density, 10 pressure, 11 mass; every one holds at
    # least n slots (n is the consistent length), so the loop reads them unchecked and writes the reserved room.
    var c0: *PvColumn = _pv_soa_col(soa, 0);
    var c1: *PvColumn = _pv_soa_col(soa, 1);
    var c2: *PvColumn = _pv_soa_col(soa, 2);
    var c3: *PvColumn = _pv_soa_col(soa, 3);
    var c4: *PvColumn = _pv_soa_col(soa, 4);
    var c5: *PvColumn = _pv_soa_col(soa, 5);
    var c9: *PvColumn = _pv_soa_col(soa, 9);
    var c10: *PvColumn = _pv_soa_col(soa, 10);
    var c11: *PvColumn = _pv_soa_col(soa, 11);
    var d0 = c0.data;
    var d1 = c1.data;
    var d2 = c2.data;
    var d3 = c3.data;
    var d4 = c4.data;
    var d5 = c5.data;
    var d9 = c9.data;
    var d10 = c10.data;
    var d11 = c11.data;
    var fp: *f32 = _pv_as_f32s(pm.data);
    var fv: *f32 = _pv_as_f32s(vl.data);
    var fd: *f32 = _pv_as_f32s(dp.data);
    var zero: f64 = 0.0;
    for (var i = 0; i < n; i = i + 1) {
        var o = i * 8;
        var q = i * 4;
        var x: f64 = load64(d0 + o);
        var y: f64 = load64(d1 + o);
        var z: f64 = load64(d2 + o);
        var m: f64 = load64(d11 + o);
        fp[q] = x;
        fp[q + 1] = y;
        fp[q + 2] = z;
        fp[q + 3] = m;
        var vx: f64 = load64(d3 + o);
        var vy: f64 = load64(d4 + o);
        var vz: f64 = load64(d5 + o);
        fv[q] = vx;
        fv[q + 1] = vy;
        fv[q + 2] = vz;
        fv[q + 3] = zero;
        var rho: f64 = load64(d9 + o);
        var pr: f64 = load64(d10 + o);
        fd[2 * i] = rho;
        fd[2 * i + 1] = pr;
    }
    pm.len = 4 * n;
    vl.len = 4 * n;
    dp.len = 2 * n;
    out.count = n;
    return 1;
}

# Writes up to m particles of buffer b (`per` values each) back into the SoA columns k0, k0 + 1 (and k0 + 2 when
# `cols` is 3), widened: m is count, b's complete chunks and the columns' lengths, whichever is least (Rust's `take(n)`
# over zipped iterators).
fn _pv_unpack(count, b: *PvF32Column, per, soa: *PvParticleSoa, k0, cols) {
    var m = count;
    var chunks = b.len / per;
    if (chunks < m) { m = chunks; }
    for (var k = 0; k < cols; k = k + 1) {
        var c: *PvColumn = _pv_soa_col(soa, k0 + k);
        if (c.len < m) { m = c.len; }
    }
    # Column by column: each slot below m is written once, so the order changes nothing.
    var src: *f32 = _pv_as_f32s(b.data);
    for (var k2 = 0; k2 < cols; k2 = k2 + 1) {
        var d: *PvColumn = _pv_soa_col(soa, k0 + k2);
        var dd = d.data;
        for (var i = 0; i < m; i = i + 1) {
            var v: f32 = src[per * i + k2];
            var w: f64 = f32_to(v);
            store64(dd + i * 8, _pv_bits(w));
        }
    }
    return 0;
}

impl PvPackedParticles {
    # Writes each particle's [density, pressure] back into the SoA, widened: at most `count`, bounded by the buffer's
    # complete pairs and the two columns' lengths. Mirrors `PackedParticles::unpack_density_pressure`.
    fn unpack_density_pressure(self, soa: *PvParticleSoa) {
        _pv_unpack(self.count, _pv_packed_col(self, 2), 2, soa, 9, 2);
        return 0;
    }

    # Writes each particle's [vx, vy, vz] back into the SoA, widened, bounded as above by the buffer's complete
    # quadruples and the three columns. Mirrors `PackedParticles::unpack_velocity`.
    fn unpack_velocity(self, soa: *PvParticleSoa) {
        _pv_unpack(self.count, _pv_packed_col(self, 1), 4, soa, 3, 3);
        return 0;
    }

    # Writes each particle's [x, y, z] back into the SoA, widened, bounded as above. Mirrors
    # `PackedParticles::unpack_positions`.
    fn unpack_positions(self, soa: *PvParticleSoa) {
        _pv_unpack(self.count, _pv_packed_col(self, 0), 4, soa, 0, 3);
        return 0;
    }
}

# ── kernel parameters ───────────────────────────────────────────────────────────────

# The parameters of an SPH density or force kernel, in f32 (a backend's uniform buffer). Rust's `gravity: [f32; 3]` is
# the three fields gravity_x, gravity_y, gravity_z. Mirrors `SphKernelParams`.
struct PvSphKernelParams {
    smoothing_radius: f32;
    rest_density: f32;
    gas_constant: f32;
    viscosity: f32;
    gravity_x: f32;
    gravity_y: f32;
    gravity_z: f32;
    dt: f32;
    particle_count: u32;
}

# Every field 0. Mirrors `SphKernelParams::default`.
#must_use
fn PvSphKernelParams_default(): PvSphKernelParams {
    var p: PvSphKernelParams;
    var z: f32 = f32_from(0.0);
    p.smoothing_radius = z;
    p.rest_density = z;
    p.gas_constant = z;
    p.viscosity = z;
    p.gravity_x = z;
    p.gravity_y = z;
    p.gravity_z = z;
    p.dt = z;
    p.particle_count = 0;
    return p;
}

# The parameters of a grid Navier–Stokes step, in f32 and u32. Mirrors `GridKernelParams`.
struct PvGridKernelParams {
    nx: u32;
    ny: u32;
    dx: f32;
    dt: f32;
    viscosity: f32;
    buoyancy_alpha: f32;
    ambient_density: f32;
}

# Every field 0. Mirrors `GridKernelParams::default`.
#must_use
fn PvGridKernelParams_default(): PvGridKernelParams {
    var p: PvGridKernelParams;
    var z: f32 = f32_from(0.0);
    p.nx = 0;
    p.ny = 0;
    p.dx = z;
    p.dt = z;
    p.viscosity = z;
    p.buoyancy_alpha = z;
    p.ambient_density = z;
    return p;
}

# The parameters of a shallow-water step, in f32 and u32. Mirrors `ShallowKernelParams`.
struct PvShallowKernelParams {
    nx: u32;
    ny: u32;
    dx: f32;
    dt: f32;
    gravity: f32;
    damping: f32;
    dry_threshold: f32;
}

# Every field 0. Mirrors `ShallowKernelParams::default`.
#must_use
fn PvShallowKernelParams_default(): PvShallowKernelParams {
    var p: PvShallowKernelParams;
    var z: f32 = f32_from(0.0);
    p.nx = 0;
    p.ny = 0;
    p.dx = z;
    p.dt = z;
    p.gravity = z;
    p.damping = z;
    p.dry_threshold = z;
    return p;
}

# ── the backends ────────────────────────────────────────────────────────────────────

# The operation a backend is asked to perform: explicit, append-only values (Rust's `#[non_exhaustive]` enum in
# declaration order). Mirrors `ComputeOp`.
enum PvComputeOp {
    PV_COMPUTE_OP_SPH_DENSITY = 0;
    PV_COMPUTE_OP_SPH_STEP = 1;
    PV_COMPUTE_OP_GRID_ADVECT = 2;
    PV_COMPUTE_OP_SHALLOW_STEP = 3;
}

# The Rust variant name of an operation (`"SphDensity"`), or "Unknown".
#must_use
fn compute_op_name(k): i64 {
    match k {
        PV_COMPUTE_OP_SPH_DENSITY => { return "SphDensity"; }
        PV_COMPUTE_OP_SPH_STEP => { return "SphStep"; }
        PV_COMPUTE_OP_GRID_ADVECT => { return "GridAdvect"; }
        PV_COMPUTE_OP_SHALLOW_STEP => { return "ShallowStep"; }
        _ => { return "Unknown"; }
    }
    return "Unknown";
}

# A backend that accelerates simulation kernels on packed buffers (a GPU, a cluster): the consumer implements it and
# calls it; pravash's CPU solvers never dispatch to one. Each method returns PV_ERR_NONE (0) for Ok or a PV_ERR_* code
# (Rust's `Result<()>`). The slices are (pointer, count) of f32 elements. Mirrors the trait `ComputeBackend`.
trait PvComputeBackend {
    # 1 when the backend implements `op` (a `PvComputeOp`). Mirrors `ComputeBackend::supports`.
    fn supports(self, op): i64;

    # SPH densities: updates `particles.density_pressure`. Mirrors `ComputeBackend::sph_density`.
    fn sph_density(self, particles: *PvPackedParticles, params: *PvSphKernelParams): i64;

    # A whole SPH step (density, forces, integration): updates every particle buffer. Mirrors
    # `ComputeBackend::sph_step`.
    fn sph_step(self, particles: *PvPackedParticles, params: *PvSphKernelParams): i64;

    # Grid advection: reads src (and the velocities), writes dst, n elements each. Mirrors
    # `ComputeBackend::grid_advect`.
    fn grid_advect(self, dst, src, vx, vy, n, params: *PvGridKernelParams): i64;

    # A shallow-water step: updates height, vx and vy in place over ground, n elements each. Mirrors
    # `ComputeBackend::shallow_step`.
    fn shallow_step(self, height, vx, vy, ground, n, params: *PvShallowKernelParams): i64;
}

# A neural operator's correction: the deltas to add to the velocities (in their layout) and to the pressures, as f32
# buffers the corrector fills. Mirrors `NeuralCorrection`.
struct PvNeuralCorrection {
    velocity_delta: PvF32Column;
    pressure_delta: PvF32Column;
}

# Releases both buffers. Mirrors dropping the `NeuralCorrection`.
fn PvNeuralCorrection_drop(c: *PvNeuralCorrection) {
    for (var k = 0; k < 2; k = k + 1) {
        var b: *PvF32Column = _pv_as_f32_column(_pv_addr(c) + k * 24);
        b.drop();
    }
    return 0;
}

# A deep copy of `src` into *out (a different record): both buffers at their own lengths. 1, or 0 when the memory
# isn't there (then *out holds no storage). Mirrors the derived `Clone`.
#must_use
fn PvNeuralCorrection_clone(out: *PvNeuralCorrection, src: *PvNeuralCorrection): i64 {
    out.velocity_delta.data = 0;
    out.velocity_delta.len = 0;
    out.velocity_delta.cap = 0;
    out.pressure_delta.data = 0;
    out.pressure_delta.len = 0;
    out.pressure_delta.cap = 0;
    for (var k = 0; k < 2; k = k + 1) {
        var d: *PvF32Column = _pv_as_f32_column(_pv_addr(out) + k * 24);
        var s: *PvF32Column = _pv_as_f32_column(_pv_addr(src) + k * 24);
        if (_pv_f32_clone(d, s) == 0) {
            PvNeuralCorrection_drop(out);
            return 0;
        }
    }
    return 1;
}

# A learned corrector: takes a coarse state's velocities and pressures (f32 slices) and fills *out with the
# correction toward the fine result. Returns PV_ERR_NONE (0) for Ok or a PV_ERR_* code (Rust's
# `Result<NeuralCorrection>`). Mirrors the trait `NeuralCorrector`.
trait PvNeuralCorrector {
    # The correction for this state. Mirrors `NeuralCorrector::correct`.
    fn correct(self, velocities, nv, pressures, np, params: *PvGridKernelParams, out: *PvNeuralCorrection): i64;
}

# ── kernel derivatives ──────────────────────────────────────────────────────────────

# d(poly6)/d(r²) = −3c·(h² − r²)², c = 315/((64π)·h⁹) with h⁹ = (h³·h³)·h³; 0 for h ≤ 0 or r² > h² (a NaN h computes
# on, as Rust's tests let it). Mirrors `KernelDerivatives::dpoly6_dr2`.
#must_use
fn PvKernelDerivatives_dpoly6_dr2(r2: f64, h: f64): f64 {
    var h2: f64 = h * h;
    var zero: f64 = 0.0;
    if (h <= 0.0 || r2 > h2) { return zero; }
    var h3: f64 = h2 * h;
    var h9: f64 = (h3 * h3) * h3;
    var sf: f64 = 64.0;
    var den: f64 = (sf * PV_F64_PI) * h9;
    var num: f64 = 315.0;
    var c: f64 = num / den;
    var diff: f64 = h2 - r2;
    var m3: f64 = -3.0;
    var r: f64 = ((m3 * c) * diff) * diff;
    return r;
}

# d(P)/dρ of the linear equation of state: the gas constant k. Mirrors `KernelDerivatives::deos_drho`.
#must_use
fn PvKernelDerivatives_deos_drho(gas_constant: f64): f64 {
    return gas_constant;
}

# d(Tait)/dρ = (c·c)·(ρ/ρ₀)^(γ − 1), ρ₀ floored at 1e-10 (NaN-ignoring); powf correctly rounded. Mirrors
# `KernelDerivatives::dtait_drho`.
#must_use
fn PvKernelDerivatives_dtait_drho(density: f64, rest_density: f64, speed_of_sound: f64, gamma: f64): f64 {
    var floor10: f64 = 0x3DDB7CDFD9D7BDBB;   # 1e-10
    var rho0: f64 = _pv_max(rest_density, floor10);
    var q: f64 = density / rho0;
    var e: f64 = gamma - 1.0;
    var pw: f64 = _pv_powf(q, e);
    var c2: f64 = speed_of_sound * speed_of_sound;
    var r: f64 = c2 * pw;
    return r;
}

# d(Wendland C2)/dr: `kernel_wendland_c2_grad`. Mirrors `KernelDerivatives::dwendland_c2_dr`.
#must_use
fn PvKernelDerivatives_dwendland_c2_dr(r: f64, h: f64): f64 {
    var g: f64 = kernel_wendland_c2_grad(r, h);
    return g;
}

