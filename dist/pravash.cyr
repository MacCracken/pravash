# --- ai.cyr ---

# ai.cyr — rust-old/src/ai.rs (M7 part b): the daimon and hoosh service configs, their defaults, and Rust's `Debug` for
# each, which never prints the daimon key. Their JSON is in src/json.cyr.
#
# A config holds its strings as bytes and a length: `endpoint`, and the daimon config's `api_key`, where a 0 pointer is
# Rust's None and any other pointer Some (Some("") included). Rust's `String`s own their bytes. Here `owned` says which
# of a config's strings are its own freelist copies (bit 0 the endpoint, bit 1 the key), which `_drop` releases: a
# default config points at static text and owns nothing, one read from JSON owns its strings, and the setters copy.
# Rust's `#[non_exhaustive]` stops a consumer building one with a struct literal, so it starts from a default or a
# document and sets fields; here that is the setters (ADR 0002 #27).
#
# `debug(sb, alternate)` is Rust's `{:?}` (alternate 0) and `{:#?}` (1): the derived `Debug` for `HooshConfig` and the
# hand-written one for `DaimonConfig`, whose key prints as `Some("<redacted>")`. Strings print as `<str as Debug>`
# does: the named escapes \0 \t \n \r \" \\, `\u{…}` for the code points src/str_debug_data.cyr lists (generated from
# rustc's core), the rest as they are. A byte that is no part of valid UTF-8 (Rust's strings can't hold one) prints as
# U+FFFD.

# The `owned` bits.
const _PV_AI_OWN_ENDPOINT = 1;
const _PV_AI_OWN_KEY = 2;

# A daimon service's config: its endpoint, and its API key (0 for none). Mirrors `DaimonConfig`.
struct PvDaimonConfig {
    endpoint;
    endpoint_len;
    api_key;
    api_key_len;
    owned;
}

# A hoosh service's config: its endpoint. Mirrors `HooshConfig`.
struct PvHooshConfig {
    endpoint;
    endpoint_len;
    owned;
}

# The daimon default: endpoint http://localhost:8090, no key, nothing owned. Mirrors `DaimonConfig::default`.
#must_use
fn PvDaimonConfig_default(): PvDaimonConfig {
    var c: PvDaimonConfig;
    c.endpoint = "http://localhost:8090";
    c.endpoint_len = 21;
    c.api_key = 0;
    c.api_key_len = 0;
    c.owned = 0;
    return c;
}

# The hoosh default: endpoint http://localhost:8088, nothing owned. Mirrors `HooshConfig::default`.
#must_use
fn PvHooshConfig_default(): PvHooshConfig {
    var c: PvHooshConfig;
    c.endpoint = "http://localhost:8088";
    c.endpoint_len = 21;
    c.owned = 0;
    return c;
}

# A freelist copy of the n bytes at p, NUL-terminated (so Some("") is a nonzero pointer), or 0 for no memory.
#must_use
fn _pv_ai_copy(p, n): i64 {
    if (n < 0) { return 0; }
    var d = fl_alloc(n + 1);
    if (d == 0) { return 0; }
    if (n > 0) { memcpy(d, p, n); }
    store8(d + n, 0);
    return d;
}

# Releases the strings a daimon config owns; it is then the empty config (endpoint "" at a static, no key). Mirrors
# dropping the `DaimonConfig`.
fn PvDaimonConfig_drop(c: *PvDaimonConfig) {
    if ((c.owned & _PV_AI_OWN_ENDPOINT) != 0 && c.endpoint != 0) { fl_free(c.endpoint); }
    if ((c.owned & _PV_AI_OWN_KEY) != 0 && c.api_key != 0) { fl_free(c.api_key); }
    c.endpoint = "";
    c.endpoint_len = 0;
    c.api_key = 0;
    c.api_key_len = 0;
    c.owned = 0;
    return 0;
}

# Releases the endpoint a hoosh config owns, as PvDaimonConfig_drop. Mirrors dropping the `HooshConfig`.
fn PvHooshConfig_drop(c: *PvHooshConfig) {
    if ((c.owned & _PV_AI_OWN_ENDPOINT) != 0 && c.endpoint != 0) { fl_free(c.endpoint); }
    c.endpoint = "";
    c.endpoint_len = 0;
    c.owned = 0;
    return 0;
}

impl PvDaimonConfig {
    # Sets the endpoint to a copy of the n bytes at p: 1, or 0 when the copy can't be allocated (unchanged). Rust's
    # `c.endpoint = String::from(..)`.
    #must_use
    fn set_endpoint(self, p, n): i64 {
        var d = _pv_ai_copy(p, n);
        if (d == 0) { return 0; }
        if ((self.owned & _PV_AI_OWN_ENDPOINT) != 0 && self.endpoint != 0) { fl_free(self.endpoint); }
        self.endpoint = d;
        self.endpoint_len = n;
        self.owned = self.owned | _PV_AI_OWN_ENDPOINT;
        return 1;
    }

    # Sets the key to a copy of the n bytes at p (Some, even for n = 0): 1, or 0 when the copy can't be allocated
    # (unchanged). Rust's `c.api_key = Some(..)`.
    #must_use
    fn set_api_key(self, p, n): i64 {
        var d = _pv_ai_copy(p, n);
        if (d == 0) { return 0; }
        if ((self.owned & _PV_AI_OWN_KEY) != 0 && self.api_key != 0) { fl_free(self.api_key); }
        self.api_key = d;
        self.api_key_len = n;
        self.owned = self.owned | _PV_AI_OWN_KEY;
        return 1;
    }

    # Removes the key. Rust's `c.api_key = None`.
    fn clear_api_key(self) {
        if ((self.owned & _PV_AI_OWN_KEY) != 0 && self.api_key != 0) { fl_free(self.api_key); }
        self.api_key = 0;
        self.api_key_len = 0;
        self.owned = self.owned & _PV_AI_OWN_ENDPOINT;
        return 0;
    }

    # Appends Rust's `{:?}` (alternate 0) or `{:#?}` (1) of the config: the endpoint, and `Some("<redacted>")` or
    # `None` for the key, whose bytes are never read. 0, or -1 when the builder can't grow. Mirrors the hand-written
    # `impl Debug for DaimonConfig`.
    #must_use
    fn debug(self, sb, alternate): i64 {
        var rc = _pv_dbg_open(sb, "DaimonConfig", alternate);
        rc = rc | _pv_dbg_field(sb, "endpoint", alternate, 1);
        rc = rc | _pv_debug_str(sb, self.endpoint, self.endpoint_len);
        rc = rc | _pv_dbg_field_end(sb, alternate);
        rc = rc | _pv_dbg_field(sb, "api_key", alternate, 0);
        if (self.api_key == 0) {
            rc = rc | _pv_jw(sb, "None");
        } elif (alternate == 0) {
            rc = rc | _pv_jw(sb, "Some(\"<redacted>\")");
        } else {
            rc = rc | _pv_jw(sb, "Some(\n        \"<redacted>\",\n    )");
        }
        rc = rc | _pv_dbg_field_end(sb, alternate);
        rc = rc | _pv_dbg_close(sb, alternate);
        return rc;
    }
}

impl PvHooshConfig {
    # Sets the endpoint to a copy of the n bytes at p: 1, or 0 when the copy can't be allocated (unchanged).
    #must_use
    fn set_endpoint(self, p, n): i64 {
        var d = _pv_ai_copy(p, n);
        if (d == 0) { return 0; }
        if ((self.owned & _PV_AI_OWN_ENDPOINT) != 0 && self.endpoint != 0) { fl_free(self.endpoint); }
        self.endpoint = d;
        self.endpoint_len = n;
        self.owned = _PV_AI_OWN_ENDPOINT;
        return 1;
    }

    # Appends Rust's `{:?}` (alternate 0) or `{:#?}` (1) of the config. 0, or -1 when the builder can't grow. Mirrors
    # the derived `Debug` for `HooshConfig`.
    #must_use
    fn debug(self, sb, alternate): i64 {
        var rc = _pv_dbg_open(sb, "HooshConfig", alternate);
        rc = rc | _pv_dbg_field(sb, "endpoint", alternate, 1);
        rc = rc | _pv_debug_str(sb, self.endpoint, self.endpoint_len);
        rc = rc | _pv_dbg_field_end(sb, alternate);
        rc = rc | _pv_dbg_close(sb, alternate);
        return rc;
    }
}

# A deep copy of `src` into *out (a different config): an owned copy of the endpoint, and of the key when it is
# Some. 1, or 0 when the memory isn't there (then *out is the empty config, owning nothing). Mirrors the derived
# `Clone`.
#must_use
fn PvDaimonConfig_clone(out: *PvDaimonConfig, src: *PvDaimonConfig): i64 {
    out.endpoint = "";
    out.endpoint_len = 0;
    out.api_key = 0;
    out.api_key_len = 0;
    out.owned = 0;
    if (out.set_endpoint(src.endpoint, src.endpoint_len) == 0) { return 0; }
    if (src.api_key != 0 && out.set_api_key(src.api_key, src.api_key_len) == 0) {
        PvDaimonConfig_drop(out);
        return 0;
    }
    return 1;
}

# A deep copy of `src` into *out (a different config): an owned copy of the endpoint. 1, or 0 when the memory isn't
# there (then *out is the empty config, owning nothing). Mirrors the derived `Clone`.
#must_use
fn PvHooshConfig_clone(out: *PvHooshConfig, src: *PvHooshConfig): i64 {
    out.endpoint = "";
    out.endpoint_len = 0;
    out.owned = 0;
    if (out.set_endpoint(src.endpoint, src.endpoint_len) == 0) { return 0; }
    return 1;
}

# ── Rust's Debug ────────────────────────────────────────────────────────────────────
# `debug_struct`'s two shapes: `Name { a: x, b: y }`, and the alternate `Name {\n    a: x,\n    b: y,\n}` (a field's
# value never holds a raw newline here, so PadAdapter's indentation has nothing to add inside one).

# Appends `Name {` (alternate: `Name {\n`). 0, or -1.
#must_use
fn _pv_dbg_open(sb, name, alternate): i64 {
    var rc = _pv_jw(sb, name);
    if (alternate == 0) { return rc | _pv_jw(sb, " {"); }
    return rc | _pv_jw(sb, " {\n");
}

# Appends a field's name: ` a: ` (`, b: ` after the first; alternate `    a: `). 0, or -1.
#must_use
fn _pv_dbg_field(sb, name, alternate, first): i64 {
    var rc = 0;
    if (alternate == 1) {
        rc = _pv_jw(sb, "    ");
    } elif (first == 1) {
        rc = _pv_jw(sb, " ");
    } else {
        rc = _pv_jw(sb, ", ");
    }
    rc = rc | _pv_jw(sb, name);
    return rc | _pv_jw(sb, ": ");
}

# Ends a field (alternate: `,\n`). 0, or -1.
#must_use
fn _pv_dbg_field_end(sb, alternate): i64 {
    if (alternate == 0) { return 0; }
    return _pv_jw(sb, ",\n");
}

# Appends ` }` (alternate: `}`). 0, or -1.
#must_use
fn _pv_dbg_close(sb, alternate): i64 {
    if (alternate == 0) { return _pv_jw(sb, " }"); }
    return _pv_jw(sb, "}");
}

# 1 when `<str as Debug>` writes code point u as `\u{…}` (src/str_debug_data.cyr, by binary search), else 0.
#must_use
fn _pv_str_debug_escapes(u): i64 {
    var lo = 0;
    var hi = _PV_STR_DEBUG_RANGES - 1;
    while (lo <= hi) {
        var mid = (lo + hi) / 2;
        var a = _PV_STR_DEBUG_ESC[2 * mid];
        var b = _PV_STR_DEBUG_ESC[2 * mid + 1];
        if (u < a) {
            hi = mid - 1;
        } elif (u > b) {
            lo = mid + 1;
        } else {
            return 1;
        }
    }
    return 0;
}

# The code point of the UTF-8 sequence at p (n bytes left, n ≥ 1) and its length: (cp, len), or (-1, 1) when the byte
# at p starts no valid sequence (an overlong form, a surrogate, past U+10FFFF, a stray continuation, a truncation).
fn _pv_utf8_next(p, n) {
    var b0 = load8(p);
    if (b0 < 128) { return (b0, 1); }
    var len = 0;
    var cp = 0;
    var min = 0;
    if (b0 >= 194 && b0 <= 223) {
        len = 2;
        cp = b0 & 31;
        min = 128;
    } elif (b0 >= 224 && b0 <= 239) {
        len = 3;
        cp = b0 & 15;
        min = 2048;
    } elif (b0 >= 240 && b0 <= 244) {
        len = 4;
        cp = b0 & 7;
        min = 65536;
    } else {
        return (0 - 1, 1);
    }
    if (n < len) { return (0 - 1, 1); }
    for (var k = 1; k < len; k = k + 1) {
        var b = load8(p + k);
        if ((b & 192) != 128) { return (0 - 1, 1); }
        cp = (cp << 6) | (b & 63);
    }
    if (cp < min || cp > 1114111 || (cp >= 55296 && cp <= 57343)) { return (0 - 1, 1); }
    return (cp, len);
}

# Appends the n bytes at p as `<str as Debug>` writes a string, quotes included. 0, or -1 when the builder can't grow.
#must_use
fn _pv_debug_str(sb, p, n): i64 {
    var rc = _pv_jw(sb, "\"");
    var i = 0;
    var run = 0;
    while (i < n) {
        # Printable ASCII other than `"` and `\` prints as it is (the table holds none of 0x20–0x7E): no decode, no
        # search.
        var b0 = load8(p + i);
        if (b0 >= 32 && b0 <= 126 && b0 != 34 && b0 != 92) {
            i = i + 1;
            continue;
        }
        var cp, len = _pv_utf8_next(p + i, n - i);
        var esc = 0;
        if (cp < 0 || cp == 34 || cp == 92 || cp == 0 || cp == 9 || cp == 10 || cp == 13) {
            esc = 1;
        } elif (_pv_str_debug_escapes(cp) == 1) {
            esc = 1;
        }
        if (esc == 0) {
            i = i + len;
        } else {
            # The plain run before it, then the escape.
            rc = rc | _pv_jw_n(sb, p + run, i - run);
            if (cp < 0) {
                var rep[8];
                store8(&rep, 239);
                store8(&rep + 1, 191);
                store8(&rep + 2, 189);
                rc = rc | _pv_jw_n(sb, &rep, 3);
            } elif (cp == 34) {
                rc = rc | _pv_jw(sb, "\\\"");
            } elif (cp == 92) {
                rc = rc | _pv_jw(sb, "\\\\");
            } elif (cp == 0) {
                rc = rc | _pv_jw(sb, "\\0");
            } elif (cp == 9) {
                rc = rc | _pv_jw(sb, "\\t");
            } elif (cp == 10) {
                rc = rc | _pv_jw(sb, "\\n");
            } elif (cp == 13) {
                rc = rc | _pv_jw(sb, "\\r");
            } else {
                rc = rc | _pv_debug_u(sb, cp);
            }
            i = i + len;
            run = i;
        }
    }
    rc = rc | _pv_jw_n(sb, p + run, n - run);
    return rc | _pv_jw(sb, "\"");
}

# Appends `\u{…}` for code point cp: lowercase hex, no leading zeros. 0, or -1.
#must_use
fn _pv_debug_u(sb, cp): i64 {
    var buf[16];
    var d[8];
    var nd = 0;
    var v = cp;
    while (nd == 0 || v != 0) {
        var h = v & 15;
        if (h < 10) { store8(&d + nd, 48 + h); } else { store8(&d + nd, 87 + h); }
        nd = nd + 1;
        v = v >> 4;
    }
    store8(&buf, 92);
    store8(&buf + 1, 117);
    store8(&buf + 2, 123);
    for (var k = 0; k < nd; k = k + 1) { store8(&buf + 3 + k, load8(&d + nd - 1 - k)); }
    store8(&buf + 3 + nd, 125);
    return _pv_jw_n(sb, &buf, 4 + nd);
}

# --- json.cyr ---

# json.cyr — serde-compatible JSON for the M1 types (port plan D4, ADR 0002 #6 and #10): the documents the Rust
# crate's serde_json writes decode to the same bits, and every document written here decodes back to the same bits.
#
# Types: `FluidMaterial`, `FluidParticle`, `FluidConfig`, `ParticleSoa` (src/common.cyr), `FlowRegime` and the unit
# struct `DragCoefficient` (src/buoyancy.cyr); later milestones add their own (`ShallowWater`, the grid types, M6's
# `BodyShape`, `RigidBody` and `ConstitutiveModel`, and M7's kernel parameters, each in its own section below). The
# text is not serde_json's byte for byte (D4): floats are bayan's Grisu2 digits, which round-trip exactly (an f32 as its
# widened f64's digits); NaN and ±∞ are written `null`, as serde_json writes them, and like serde_json's such a document
# doesn't read back.
#
# Writers: `x.to_json(sb)` appends to a `str_builder` through its non-aborting `_a` calls (the default allocator) and
# returns 0, or -1 when a grow failed (ADR 0002 #8: nothing aborts). Fields go in Rust's declaration order; a
# `DVec3` and a `[f64; 3]` are `[x,y,z]` (glam's and serde's array forms).
#
# Readers: `PvX_from_json(buf, len, out)` parses with bayan's value tree (never the derive's scanner, whose open
# defects malformed input could reach: impetus ADR 0010) and applies serde's derive semantics, as serde_json 1.0.154
# reads (its `float_roundtrip` parse, which is correctly rounded, as bayan's is):
# - a struct reads from an object, by field name (unknown fields ignored), or from an array of exactly its fields,
#   by position (serde's sequence form). None of the M1 types has a `#[serde(default)]` field, so every field is
#   required;
# - an f64 takes a JSON integer or float whose value is finite; `null` is refused (serde_json writes NaN and ±∞ as
#   `null` and can't read them back), and so is a number beyond f64's range (`1e400`);
# - a u8 (the phase) takes a JSON integer in 0 … 255 only (`1.0`, `-1` and `256` are refused);
# - a vector takes an array of exactly 3 numbers; a `Vec<f64>` / `Vec<u8>` any number;
# - an enum is externally tagged: a unit variant is `"Name"` or `{"Name":null}`, a struct variant (`BodyShape`'s)
#   the one-key object `{"Name":fields}`, its fields read as a struct's; the unit struct `DragCoefficient` is `null`.
# Anything else is Err(PV_ERR_DESERIALIZE), and *out is then untouched (a `ParticleSoa` holds no storage). Two bayan
# policies are stricter than serde_json, so a few documents serde_json reads are refused here (impetus port plan §8,
# S3 and S4, filed at bayan): an integer above i64::MAX (serde_json reads one into an f64), and a duplicated unknown
# field (serde_json ignores it).
#
# Not thread-safe: the decode arena is module state, reset by each read.
#
# UPSTREAM(L10): cyrius:docs/development/issues/2026-11-11-derive-json-no-vector-array-or-tagged-variant-shapes.md
#   replace with `#derive(Serialize)` / `#derive(Deserialize)` once the derive has the array form for a vector struct
#   (and the tagged form for M6's data-carrying enums); parity: tests/golden/json.tsv (class A).

# ── writer ──────────────────────────────────────────────────────────────────────────

# Appends the C string s: 0, or -1 when the builder can't grow.
#must_use
fn _pv_jw(sb, s): i64 {
    if (str_builder_add_cstr_a(default_alloc(), sb, s) != 0) { return 0 - 1; }
    return 0;
}

# Appends `,"name":` (no comma when `first` is 1).
#must_use
fn _pv_jw_key(sb, name, first): i64 {
    var rc = 0;
    if (first == 0) { rc = rc | _pv_jw(sb, ","); }
    rc = rc | _pv_jw(sb, "\"");
    rc = rc | _pv_jw(sb, name);
    rc = rc | _pv_jw(sb, "\":");
    return rc;
}

# Appends x in bayan's round-trip digits, or `null` when x is NaN or ±∞.
#must_use
fn _pv_jw_f64(sb, x: f64): i64 {
    var buf[40];
    var n = bayan_f64_to_json(_pv_bits(x), &buf);
    store8(&buf + n, 0);
    return _pv_jw(sb, &buf);
}

# Appends the integer n.
#must_use
fn _pv_jw_int(sb, n): i64 {
    if (str_builder_add_int_a(default_alloc(), sb, n) != 0) { return 0 - 1; }
    return 0;
}

# Appends `[x,y,z]`.
#must_use
fn _pv_jw_f64x3(sb, x: f64, y: f64, z: f64): i64 {
    var rc = _pv_jw(sb, "[");
    rc = rc | _pv_jw_f64(sb, x);
    rc = rc | _pv_jw(sb, ",");
    rc = rc | _pv_jw_f64(sb, y);
    rc = rc | _pv_jw(sb, ",");
    rc = rc | _pv_jw_f64(sb, z);
    rc = rc | _pv_jw(sb, "]");
    return rc;
}

# Appends a column as a JSON array: of f64s, or of integers when `ints` is 1.
#must_use
fn _pv_jw_col(sb, c: *PvColumn, ints): i64 {
    var rc = _pv_jw(sb, "[");
    for (var i = 0; i < c.len; i = i + 1) {
        if (i > 0) { rc = rc | _pv_jw(sb, ","); }
        if (ints == 1) {
            rc = rc | _pv_jw_int(sb, c.get(i));
        } else {
            var x: f64 = c.get_f(i);
            rc = rc | _pv_jw_f64(sb, x);
        }
    }
    rc = rc | _pv_jw(sb, "]");
    return rc;
}

# ── reader ──────────────────────────────────────────────────────────────────────────

var _pv_json_arena = 0;

# The document last parsed and its tree, for the f32 reads' midpoint step (ledger L15).
var _pv_jr_doc = 0;
var _pv_jr_doc_len = 0;
var _pv_jr_root = 0;

# The parsed tree of [buf, buf + len), on the decode arena (reset first), or 0 when the text is not one JSON value
# (or there is no memory).
#must_use
fn _pv_jr_parse(buf, len): i64 {
    if (_pv_json_arena == 0) { _pv_json_arena = arena_allocator_growable(4096); }
    if (_pv_json_arena == 0) { return 0; }
    reset_via(_pv_json_arena);
    _pv_jr_doc = buf;
    _pv_jr_doc_len = len;
    _pv_jr_root = bayan_json_v_parse_buf_a(_pv_json_arena, buf, len);
    return _pv_jr_root;
}

# The form of a struct node with `n` fields: 1 an object, 2 an array of exactly n elements, 0 anything else.
#must_use
fn _pv_jr_form(v, n): i64 {
    if (v == 0) { return 0; }
    var tag = bayan_json_v_tag(v);
    if (tag == JTAG_OBJ) { return 1; }
    if (tag == JTAG_ARR && bayan_json_v_arr_len(v) == n) { return 2; }
    return 0;
}

# Field i, named `name`, of a struct node in `form`: its value, or 0 when absent.
#must_use
fn _pv_jr_at(v, form, i, name): i64 {
    if (form == 1) { return bayan_json_v_obj_get_by_cstr(v, name); }
    return bayan_json_v_arr_get(v, i);
}

# A JSON number with a finite value into *out (its f64 bits): 1, or 0 for anything else.
fn _pv_jr_f64(v, out): i64 {
    if (v == 0) { return 0; }
    var tag = bayan_json_v_tag(v);
    if (tag != JTAG_INT && tag != JTAG_FLOAT) { return 0; }
    var x: f64 = bayan_json_v_float(v);
    if (_pv_is_finite(x) == 0) { return 0; }
    store64(out, _pv_bits(x));
    return 1;
}

# A JSON integer in 0 … 255 into *out: 1, or 0.
fn _pv_jr_u8(v, out): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_tag(v) != JTAG_INT) { return 0; }
    var n = bayan_json_v_int(v);
    if (n < 0 || n > 255) { return 0; }
    store64(out, n);
    return 1;
}

# A JSON array of exactly 3 numbers into the 3 words at out: 1, or 0.
fn _pv_jr_f64x3(v, out): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_tag(v) != JTAG_ARR || bayan_json_v_arr_len(v) != 3) { return 0; }
    for (var i = 0; i < 3; i = i + 1) {
        if (_pv_jr_f64(bayan_json_v_arr_get(v, i), out + i * 8) == 0) { return 0; }
    }
    return 1;
}

# Typed views of a word buffer laid out as the record (each record is a fixed run of 8-byte words).
#must_use
fn _pv_as_material(p): *PvFluidMaterial {
    return p;
}

#must_use
fn _pv_as_config(p): *PvFluidConfig {
    return p;
}

# A JSON array into the empty column *c: of finite numbers, or of integers in 0 … 255 when `bytes` is 1. 1, or 0
# (the column may hold part of it; the caller drops it).
fn _pv_jr_col(v, c: *PvColumn, bytes): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_tag(v) != JTAG_ARR) { return 0; }
    var n = bayan_json_v_arr_len(v);
    if (c.reserve(n) == 0) { return 0; }
    var w[8];
    for (var i = 0; i < n; i = i + 1) {
        var e = bayan_json_v_arr_get(v, i);
        var ok = 0;
        if (bytes == 1) { ok = _pv_jr_u8(e, &w); } else { ok = _pv_jr_f64(e, &w); }
        if (ok == 0) { return 0; }
        if (c.push(load64(&w)) == 0) { return 0; }
    }
    return 1;
}

# A unit variant: the string naming one of the `count` variants (`name_fn(k)`), or the one-key object
# `{"Name":null}`, into *out. 1, or 0.
fn _pv_jr_enum(v, name_fn, count, out): i64 {
    if (v == 0) { return 0; }
    var tag = bayan_json_v_tag(v);
    var s = 0;
    if (tag == JTAG_STR) {
        s = bayan_json_v_str(v);
    } elif (tag == JTAG_OBJ && bayan_json_v_obj_len(v) == 1) {
        var p = bayan_json_v_obj_val(v, 0);
        if (p == 0 || bayan_json_v_tag(p) != JTAG_NULL) { return 0; }
        s = bayan_json_v_obj_key(v, 0);
    } else {
        return 0;
    }
    for (var k = 0; k < count; k = k + 1) {
        if (str_eq_cstr(s, fncall1(name_fn, k)) == 1) {
            store64(out, k);
            return 1;
        }
    }
    return 0;
}

# Ok(0) when ok is 1, else Err(PV_ERR_DESERIALIZE).
#must_use
fn _pv_jr_result(ok): Result {
    if (ok == 1) { return Ok(0); }
    return Err(PV_ERR_DESERIALIZE);
}

# ── FluidMaterial ───────────────────────────────────────────────────────────────────

impl PvFluidMaterial {
    # Appends the material as serde_json writes a `FluidMaterial`: 0, or -1 when the builder can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        var rc = _pv_jw(sb, "{");
        rc = rc | _pv_jw_key(sb, "density", 1);
        rc = rc | _pv_jw_f64(sb, self.density);
        rc = rc | _pv_jw_key(sb, "viscosity", 0);
        rc = rc | _pv_jw_f64(sb, self.viscosity);
        rc = rc | _pv_jw_key(sb, "surface_tension", 0);
        rc = rc | _pv_jw_f64(sb, self.surface_tension);
        rc = rc | _pv_jw_key(sb, "speed_of_sound", 0);
        rc = rc | _pv_jw_f64(sb, self.speed_of_sound);
        rc = rc | _pv_jw(sb, "}");
        return rc;
    }
}

# Reads a `FluidMaterial` document into *out: Ok(0), or Err(PV_ERR_DESERIALIZE) with *out untouched. (No validation:
# serde fills the fields as `custom` would not; validate with `PvFluidMaterial_custom` when that matters.)
#must_use
fn PvFluidMaterial_from_json(buf, len, out: *PvFluidMaterial): Result {
    var v = _pv_jr_parse(buf, len);
    var f = _pv_jr_form(v, 4);
    if (f == 0) { return Err(PV_ERR_DESERIALIZE); }
    # Read into the record's four words, then copy it whole.
    var w[32];
    var ok = _pv_jr_f64(_pv_jr_at(v, f, 0, "density"), &w);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 1, "viscosity"), &w + 8);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 2, "surface_tension"), &w + 16);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 3, "speed_of_sound"), &w + 24);
    if (ok == 0) { return Err(PV_ERR_DESERIALIZE); }
    var src: *PvFluidMaterial = _pv_as_material(&w);
    *out = *src;
    return Ok(0);
}

# ── FluidParticle ───────────────────────────────────────────────────────────────────

impl PvFluidParticle {
    # Appends the particle as serde_json writes a `FluidParticle`: 0, or -1 when the builder can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        var rc = _pv_jw(sb, "{");
        rc = rc | _pv_jw_key(sb, "position", 1);
        rc = rc | _pv_jw_f64x3(sb, self.position.x, self.position.y, self.position.z);
        rc = rc | _pv_jw_key(sb, "velocity", 0);
        rc = rc | _pv_jw_f64x3(sb, self.velocity.x, self.velocity.y, self.velocity.z);
        rc = rc | _pv_jw_key(sb, "acceleration", 0);
        rc = rc | _pv_jw_f64x3(sb, self.acceleration.x, self.acceleration.y, self.acceleration.z);
        rc = rc | _pv_jw_key(sb, "density", 0);
        rc = rc | _pv_jw_f64(sb, self.density);
        rc = rc | _pv_jw_key(sb, "pressure", 0);
        rc = rc | _pv_jw_f64(sb, self.pressure);
        rc = rc | _pv_jw_key(sb, "mass", 0);
        rc = rc | _pv_jw_f64(sb, self.mass);
        rc = rc | _pv_jw_key(sb, "phase", 0);
        rc = rc | _pv_jw_int(sb, self.phase);
        rc = rc | _pv_jw_key(sb, "conformation", 0);
        rc = rc | _pv_jw_f64x3(sb, self.conformation.0, self.conformation.1, self.conformation.2);
        rc = rc | _pv_jw_key(sb, "temperature", 0);
        rc = rc | _pv_jw_f64(sb, self.temperature);
        rc = rc | _pv_jw_key(sb, "fuel", 0);
        rc = rc | _pv_jw_f64(sb, self.fuel);
        rc = rc | _pv_jw(sb, "}");
        return rc;
    }
}

# Reads a `FluidParticle` document into *out: Ok(0), or Err(PV_ERR_DESERIALIZE) with *out untouched.
#must_use
fn PvFluidParticle_from_json(buf, len, out: *PvFluidParticle): Result {
    var v = _pv_jr_parse(buf, len);
    var f = _pv_jr_form(v, 10);
    if (f == 0) { return Err(PV_ERR_DESERIALIZE); }
    # Read into the record's 18 words (position 0–2, velocity 3–5, acceleration 6–8, density, pressure, mass,
    # phase, conformation 13–15, temperature, fuel), then copy it whole.
    var w[144];
    var ok = _pv_jr_f64x3(_pv_jr_at(v, f, 0, "position"), &w);
    ok = ok & _pv_jr_f64x3(_pv_jr_at(v, f, 1, "velocity"), &w + 24);
    ok = ok & _pv_jr_f64x3(_pv_jr_at(v, f, 2, "acceleration"), &w + 48);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 3, "density"), &w + 72);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 4, "pressure"), &w + 80);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 5, "mass"), &w + 88);
    ok = ok & _pv_jr_u8(_pv_jr_at(v, f, 6, "phase"), &w + 96);
    ok = ok & _pv_jr_f64x3(_pv_jr_at(v, f, 7, "conformation"), &w + 104);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 8, "temperature"), &w + 128);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 9, "fuel"), &w + 136);
    if (ok == 0) { return Err(PV_ERR_DESERIALIZE); }
    var src: *PvFluidParticle = _pv_as_particles(&w);
    *out = *src;
    return Ok(0);
}

# ── FluidConfig ─────────────────────────────────────────────────────────────────────

impl PvFluidConfig {
    # Appends the config as serde_json writes a `FluidConfig`: 0, or -1 when the builder can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        var rc = _pv_jw(sb, "{");
        rc = rc | _pv_jw_key(sb, "dt", 1);
        rc = rc | _pv_jw_f64(sb, self.dt);
        rc = rc | _pv_jw_key(sb, "gravity", 0);
        rc = rc | _pv_jw_f64x3(sb, self.gravity.x, self.gravity.y, self.gravity.z);
        rc = rc | _pv_jw_key(sb, "smoothing_radius", 0);
        rc = rc | _pv_jw_f64(sb, self.smoothing_radius);
        rc = rc | _pv_jw_key(sb, "gas_constant", 0);
        rc = rc | _pv_jw_f64(sb, self.gas_constant);
        rc = rc | _pv_jw_key(sb, "rest_density", 0);
        rc = rc | _pv_jw_f64(sb, self.rest_density);
        rc = rc | _pv_jw_key(sb, "bounds_min", 0);
        rc = rc | _pv_jw_f64x3(sb, self.bounds_min.x, self.bounds_min.y, self.bounds_min.z);
        rc = rc | _pv_jw_key(sb, "bounds_max", 0);
        rc = rc | _pv_jw_f64x3(sb, self.bounds_max.x, self.bounds_max.y, self.bounds_max.z);
        rc = rc | _pv_jw_key(sb, "boundary_damping", 0);
        rc = rc | _pv_jw_f64(sb, self.boundary_damping);
        rc = rc | _pv_jw(sb, "}");
        return rc;
    }
}

# Reads a `FluidConfig` document into *out: Ok(0), or Err(PV_ERR_DESERIALIZE) with *out untouched. (No validation:
# call `validate` after.)
#must_use
fn PvFluidConfig_from_json(buf, len, out: *PvFluidConfig): Result {
    var v = _pv_jr_parse(buf, len);
    var f = _pv_jr_form(v, 8);
    if (f == 0) { return Err(PV_ERR_DESERIALIZE); }
    # Read into the record's 14 words (dt, gravity 1–3, h, gas constant, rest density, bounds_min 7–9, bounds_max
    # 10–12, damping), then copy it whole.
    var w[112];
    var ok = _pv_jr_f64(_pv_jr_at(v, f, 0, "dt"), &w);
    ok = ok & _pv_jr_f64x3(_pv_jr_at(v, f, 1, "gravity"), &w + 8);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 2, "smoothing_radius"), &w + 32);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 3, "gas_constant"), &w + 40);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 4, "rest_density"), &w + 48);
    ok = ok & _pv_jr_f64x3(_pv_jr_at(v, f, 5, "bounds_min"), &w + 56);
    ok = ok & _pv_jr_f64x3(_pv_jr_at(v, f, 6, "bounds_max"), &w + 80);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 7, "boundary_damping"), &w + 104);
    if (ok == 0) { return Err(PV_ERR_DESERIALIZE); }
    var src: *PvFluidConfig = _pv_as_config(&w);
    *out = *src;
    return Ok(0);
}

# ── ParticleSoa ─────────────────────────────────────────────────────────────────────

# The SoA's field names, in declaration order (column k is field k).
#must_use
fn _pv_soa_field(k): i64 {
    match k {
        0 => { return "pos_x"; }
        1 => { return "pos_y"; }
        2 => { return "pos_z"; }
        3 => { return "vel_x"; }
        4 => { return "vel_y"; }
        5 => { return "vel_z"; }
        6 => { return "accel_x"; }
        7 => { return "accel_y"; }
        8 => { return "accel_z"; }
        9 => { return "density"; }
        10 => { return "pressure"; }
        11 => { return "mass"; }
        12 => { return "phase"; }
        13 => { return "conf_xx"; }
        14 => { return "conf_xy"; }
        15 => { return "conf_yy"; }
        16 => { return "temperature"; }
        _ => { return "fuel"; }
    }
    return "fuel";
}

impl PvParticleSoa {
    # Appends the store as serde_json writes a `ParticleSoa`: 18 arrays, the phase as integers. 0, or -1 when the
    # builder can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        var rc = _pv_jw(sb, "{");
        for (var k = 0; k < _PV_SOA_COLUMNS; k = k + 1) {
            var first = 0;
            if (k == 0) { first = 1; }
            rc = rc | _pv_jw_key(sb, _pv_soa_field(k), first);
            var ints = 0;
            if (k == 12) { ints = 1; }
            rc = rc | _pv_jw_col(sb, _pv_soa_col(self, k), ints);
        }
        rc = rc | _pv_jw(sb, "}");
        return rc;
    }
}

# Reads a `ParticleSoa` document into *out, a fresh store that the caller drops with `PvParticleSoa_drop`: Ok(0),
# or Err(PV_ERR_DESERIALIZE) with *out holding no storage. The columns' lengths are the document's (they need not
# agree, as Rust's public Vecs need not).
#must_use
fn PvParticleSoa_from_json(buf, len, out: *PvParticleSoa): Result {
    var v = _pv_jr_parse(buf, len);
    var f = _pv_jr_form(v, _PV_SOA_COLUMNS);
    var s: PvParticleSoa = PvParticleSoa_new();
    if (f == 0) { return Err(PV_ERR_DESERIALIZE); }
    for (var k = 0; k < _PV_SOA_COLUMNS; k = k + 1) {
        var bytes = 0;
        if (k == 12) { bytes = 1; }
        if (_pv_jr_col(_pv_jr_at(v, f, k, _pv_soa_field(k)), _pv_soa_col(&s, k), bytes) == 0) {
            PvParticleSoa_drop(&s);
            return Err(PV_ERR_DESERIALIZE);
        }
    }
    *out = s;
    return Ok(0);
}

# ── FlowRegime, DragCoefficient ─────────────────────────────────────────────────────

# Appends the flow regime as serde_json writes a `FlowRegime` (`"Laminar"`): 0, or -1.
#must_use
fn flow_regime_to_json(k, sb): i64 {
    var rc = _pv_jw(sb, "\"");
    rc = rc | _pv_jw(sb, flow_regime_name(k));
    rc = rc | _pv_jw(sb, "\"");
    return rc;
}

# Reads a `FlowRegime` document (`"Laminar"` or `{"Laminar":null}`) into *out: Ok(0), or Err(PV_ERR_DESERIALIZE).
#must_use
fn flow_regime_from_json(buf, len, out): Result {
    var v = _pv_jr_parse(buf, len);
    var k = 0;
    if (_pv_jr_enum(v, &flow_regime_name, 3, &k) == 0) { return Err(PV_ERR_DESERIALIZE); }
    store64(out, k);
    return Ok(0);
}

# Appends the unit struct `DragCoefficient` as serde_json writes it: `null`. 0, or -1.
#must_use
fn drag_coefficient_to_json(sb): i64 {
    return _pv_jw(sb, "null");
}

# Reads a `DragCoefficient` document: Ok(0) for `null`, else Err(PV_ERR_DESERIALIZE).
#must_use
fn drag_coefficient_from_json(buf, len): Result {
    var v = _pv_jr_parse(buf, len);
    if (v == 0 || bayan_json_v_tag(v) != JTAG_NULL) { return Err(PV_ERR_DESERIALIZE); }
    return Ok(0);
}

# ── ShallowWater (M2) ───────────────────────────────────────────────────────────────

# A JSON integer in 0 … i64::MAX (a usize; bayan refuses larger, S3) into *out: 1, or 0.
fn _pv_jr_usize(v, out): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_tag(v) != JTAG_INT) { return 0; }
    var n = bayan_json_v_int(v);
    if (n < 0) { return 0; }
    store64(out, n);
    return 1;
}

# A JSON boolean into *out (0 / 1): 1, or 0.
fn _pv_jr_bool(v, out): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_tag(v) != JTAG_BOOL) { return 0; }
    store64(out, bayan_json_v_bool(v));
    return 1;
}

# Appends `true` or `false`.
#must_use
fn _pv_jw_bool(sb, x): i64 {
    if (x != 0) { return _pv_jw(sb, "true"); }
    return _pv_jw(sb, "false");
}

# The serialized fields of a `ShallowWater`, in declaration order (the scratch buffers are `#[serde(skip)]`).
#must_use
fn _pv_sw_field(k): i64 {
    match k {
        0 => { return "nx"; }
        1 => { return "ny"; }
        2 => { return "dx"; }
        3 => { return "height"; }
        4 => { return "vx"; }
        5 => { return "vy"; }
        6 => { return "ground"; }
        7 => { return "gravity"; }
        8 => { return "damping"; }
        9 => { return "manning_n"; }
        10 => { return "dry_threshold"; }
        11 => { return "breaking_threshold"; }
        12 => { return "breaking_dissipation"; }
        13 => { return "dispersion_coeff"; }
        14 => { return "use_green_naghdi"; }
        _ => { return "use_riemann"; }
    }
    return "use_riemann";
}

impl PvShallowWater {
    # Appends the state as serde_json writes a `ShallowWater` (the scratch buffers skipped): 0, or -1 when the
    # builder can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        var rc = _pv_jw(sb, "{");
        rc = rc | _pv_jw_key(sb, "nx", 1);
        rc = rc | _pv_jw_int(sb, self.nx);
        rc = rc | _pv_jw_key(sb, "ny", 0);
        rc = rc | _pv_jw_int(sb, self.ny);
        rc = rc | _pv_jw_key(sb, "dx", 0);
        rc = rc | _pv_jw_f64(sb, self.dx);
        rc = rc | _pv_jw_key(sb, "height", 0);
        rc = rc | _pv_jw_col(sb, _pv_sw_col(self, 0), 0);
        rc = rc | _pv_jw_key(sb, "vx", 0);
        rc = rc | _pv_jw_col(sb, _pv_sw_col(self, 1), 0);
        rc = rc | _pv_jw_key(sb, "vy", 0);
        rc = rc | _pv_jw_col(sb, _pv_sw_col(self, 2), 0);
        rc = rc | _pv_jw_key(sb, "ground", 0);
        rc = rc | _pv_jw_col(sb, _pv_sw_col(self, 3), 0);
        rc = rc | _pv_jw_key(sb, "gravity", 0);
        rc = rc | _pv_jw_f64(sb, self.gravity);
        rc = rc | _pv_jw_key(sb, "damping", 0);
        rc = rc | _pv_jw_f64(sb, self.damping);
        rc = rc | _pv_jw_key(sb, "manning_n", 0);
        rc = rc | _pv_jw_col(sb, _pv_sw_col(self, 4), 0);
        rc = rc | _pv_jw_key(sb, "dry_threshold", 0);
        rc = rc | _pv_jw_f64(sb, self.dry_threshold);
        rc = rc | _pv_jw_key(sb, "breaking_threshold", 0);
        rc = rc | _pv_jw_f64(sb, self.breaking_threshold);
        rc = rc | _pv_jw_key(sb, "breaking_dissipation", 0);
        rc = rc | _pv_jw_f64(sb, self.breaking_dissipation);
        rc = rc | _pv_jw_key(sb, "dispersion_coeff", 0);
        rc = rc | _pv_jw_f64(sb, self.dispersion_coeff);
        rc = rc | _pv_jw_key(sb, "use_green_naghdi", 0);
        rc = rc | _pv_jw_bool(sb, self.use_green_naghdi);
        rc = rc | _pv_jw_key(sb, "use_riemann", 0);
        rc = rc | _pv_jw_bool(sb, self.use_riemann);
        rc = rc | _pv_jw(sb, "}");
        return rc;
    }
}

# Reads a `ShallowWater` document into *out, a fresh state with empty scratch buffers (as serde's skipped fields
# default), released with `PvShallowWater_drop`: Ok(0), or Err(PV_ERR_DESERIALIZE) with *out holding no storage. The
# field lengths are the document's (they need not agree with nx·ny: `step` refuses an inconsistent state).
#must_use
fn PvShallowWater_from_json(buf, len, out: *PvShallowWater): Result {
    var v = _pv_jr_parse(buf, len);
    var f = _pv_jr_form(v, 16);
    if (f == 0) { return Err(PV_ERR_DESERIALIZE); }
    # The scalars into a word buffer (nx, ny, dx, gravity, damping, the four f64 parameters, the two flags).
    var w[88];
    var ok = _pv_jr_usize(_pv_jr_at(v, f, 0, "nx"), &w);
    ok = ok & _pv_jr_usize(_pv_jr_at(v, f, 1, "ny"), &w + 8);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 2, "dx"), &w + 16);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 7, "gravity"), &w + 24);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 8, "damping"), &w + 32);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 10, "dry_threshold"), &w + 40);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 11, "breaking_threshold"), &w + 48);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 12, "breaking_dissipation"), &w + 56);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 13, "dispersion_coeff"), &w + 64);
    ok = ok & _pv_jr_bool(_pv_jr_at(v, f, 14, "use_green_naghdi"), &w + 72);
    ok = ok & _pv_jr_bool(_pv_jr_at(v, f, 15, "use_riemann"), &w + 80);
    if (ok == 0) { return Err(PV_ERR_DESERIALIZE); }
    for (var k = 0; k < _PV_SW_COLUMNS; k = k + 1) {
        var z: *PvColumn = _pv_sw_col(out, k);
        z.data = 0;
        z.len = 0;
        z.cap = 0;
    }
    # The five public fields: height, vx, vy, ground (fields 3–6), manning_n (field 9).
    for (var c = 0; c < 5; c = c + 1) {
        var fi = c + 3;
        if (c == 4) { fi = 9; }
        if (_pv_jr_col(_pv_jr_at(v, f, fi, _pv_sw_field(fi)), _pv_sw_col(out, c), 0) == 0) {
            PvShallowWater_drop(out);
            return Err(PV_ERR_DESERIALIZE);
        }
    }
    out.nx = load64(&w);
    out.ny = load64(&w + 8);
    var dx: f64 = load64(&w + 16);
    var g: f64 = load64(&w + 24);
    var damp: f64 = load64(&w + 32);
    var dry: f64 = load64(&w + 40);
    var bt: f64 = load64(&w + 48);
    var bd: f64 = load64(&w + 56);
    var dc: f64 = load64(&w + 64);
    out.dx = dx;
    out.gravity = g;
    out.damping = damp;
    out.dry_threshold = dry;
    out.breaking_threshold = bt;
    out.breaking_dissipation = bd;
    out.dispersion_coeff = dc;
    out.use_green_naghdi = load64(&w + 72);
    out.use_riemann = load64(&w + 80);
    return Ok(0);
}

# ── BoundaryCondition, GridConfig, FluidGrid (M3) ───────────────────────────────────

# Appends the boundary condition as serde_json writes a `BoundaryCondition` (`"NoSlip"`): 0, or -1.
#must_use
fn boundary_condition_to_json(k, sb): i64 {
    var rc = _pv_jw(sb, "\"");
    rc = rc | _pv_jw(sb, boundary_condition_name(k));
    rc = rc | _pv_jw(sb, "\"");
    return rc;
}

# Reads a `BoundaryCondition` document (`"NoSlip"` or `{"NoSlip":null}`) into *out: Ok(0), or
# Err(PV_ERR_DESERIALIZE).
#must_use
fn boundary_condition_from_json(buf, len, out): Result {
    var v = _pv_jr_parse(buf, len);
    var k = 0;
    if (_pv_jr_enum(v, &boundary_condition_name, 3, &k) == 0) { return Err(PV_ERR_DESERIALIZE); }
    store64(out, k);
    return Ok(0);
}

#must_use
fn _pv_as_grid_config(p): *PvGridConfig {
    return p;
}

impl PvGridConfig {
    # Appends the config as serde_json writes a `GridConfig`: 0, or -1 when the builder can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        var rc = _pv_jw(sb, "{");
        rc = rc | _pv_jw_key(sb, "dt", 1);
        rc = rc | _pv_jw_f64(sb, self.dt);
        rc = rc | _pv_jw_key(sb, "viscosity", 0);
        rc = rc | _pv_jw_f64(sb, self.viscosity);
        rc = rc | _pv_jw_key(sb, "diffusion_iterations", 0);
        rc = rc | _pv_jw_int(sb, self.diffusion_iterations);
        rc = rc | _pv_jw_key(sb, "pressure_iterations", 0);
        rc = rc | _pv_jw_int(sb, self.pressure_iterations);
        rc = rc | _pv_jw_key(sb, "boundary", 0);
        rc = rc | boundary_condition_to_json(self.boundary, sb);
        rc = rc | _pv_jw_key(sb, "vorticity_confinement", 0);
        rc = rc | _pv_jw_f64(sb, self.vorticity_confinement);
        rc = rc | _pv_jw_key(sb, "buoyancy_alpha", 0);
        rc = rc | _pv_jw_f64(sb, self.buoyancy_alpha);
        rc = rc | _pv_jw_key(sb, "ambient_density", 0);
        rc = rc | _pv_jw_f64(sb, self.ambient_density);
        rc = rc | _pv_jw_key(sb, "use_maccormack", 0);
        rc = rc | _pv_jw_bool(sb, self.use_maccormack);
        rc = rc | _pv_jw_key(sb, "use_bfecc", 0);
        rc = rc | _pv_jw_bool(sb, self.use_bfecc);
        rc = rc | _pv_jw_key(sb, "smagorinsky_cs", 0);
        rc = rc | _pv_jw_f64(sb, self.smagorinsky_cs);
        rc = rc | _pv_jw_key(sb, "use_multigrid", 0);
        rc = rc | _pv_jw_bool(sb, self.use_multigrid);
        rc = rc | _pv_jw_key(sb, "use_cg", 0);
        rc = rc | _pv_jw_bool(sb, self.use_cg);
        rc = rc | _pv_jw(sb, "}");
        return rc;
    }
}

# Reads a `GridConfig` document into *out: Ok(0), or Err(PV_ERR_DESERIALIZE) with *out untouched. (No validation:
# `step` checks the config.)
#must_use
fn PvGridConfig_from_json(buf, len, out: *PvGridConfig): Result {
    var v = _pv_jr_parse(buf, len);
    var f = _pv_jr_form(v, 13);
    if (f == 0) { return Err(PV_ERR_DESERIALIZE); }
    # Read into the record's 13 words, then copy it whole.
    var w[104];
    var ok = _pv_jr_f64(_pv_jr_at(v, f, 0, "dt"), &w);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 1, "viscosity"), &w + 8);
    ok = ok & _pv_jr_usize(_pv_jr_at(v, f, 2, "diffusion_iterations"), &w + 16);
    ok = ok & _pv_jr_usize(_pv_jr_at(v, f, 3, "pressure_iterations"), &w + 24);
    ok = ok & _pv_jr_enum(_pv_jr_at(v, f, 4, "boundary"), &boundary_condition_name, 3, &w + 32);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 5, "vorticity_confinement"), &w + 40);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 6, "buoyancy_alpha"), &w + 48);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 7, "ambient_density"), &w + 56);
    ok = ok & _pv_jr_bool(_pv_jr_at(v, f, 8, "use_maccormack"), &w + 64);
    ok = ok & _pv_jr_bool(_pv_jr_at(v, f, 9, "use_bfecc"), &w + 72);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 10, "smagorinsky_cs"), &w + 80);
    ok = ok & _pv_jr_bool(_pv_jr_at(v, f, 11, "use_multigrid"), &w + 88);
    ok = ok & _pv_jr_bool(_pv_jr_at(v, f, 12, "use_cg"), &w + 96);
    if (ok == 0) { return Err(PV_ERR_DESERIALIZE); }
    var src: *PvGridConfig = _pv_as_grid_config(&w);
    *out = *src;
    return Ok(0);
}

# The serialized fields of a `FluidGrid`, in declaration order (the scratch buffers and levels are `#[serde(skip)]`).
#must_use
fn _pv_fg_field(k): i64 {
    match k {
        0 => { return "nx"; }
        1 => { return "ny"; }
        2 => { return "dx"; }
        3 => { return "vx"; }
        4 => { return "vy"; }
        5 => { return "pressure"; }
        _ => { return "density"; }
    }
    return "density";
}

impl PvFluidGrid {
    # Appends the grid as serde_json writes a `FluidGrid` (the scratch buffers and levels skipped): 0, or -1 when the
    # builder can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        var rc = _pv_jw(sb, "{");
        rc = rc | _pv_jw_key(sb, "nx", 1);
        rc = rc | _pv_jw_int(sb, self.nx);
        rc = rc | _pv_jw_key(sb, "ny", 0);
        rc = rc | _pv_jw_int(sb, self.ny);
        rc = rc | _pv_jw_key(sb, "dx", 0);
        rc = rc | _pv_jw_f64(sb, self.dx);
        for (var k = 0; k < 4; k = k + 1) {
            rc = rc | _pv_jw_key(sb, _pv_fg_field(k + 3), 0);
            rc = rc | _pv_jw_col(sb, _pv_fg_col(self, k), 0);
        }
        rc = rc | _pv_jw(sb, "}");
        return rc;
    }
}

# Reads a `FluidGrid` document into *out, a fresh grid with empty scratch buffers and no multigrid levels (as serde's
# skipped fields default), released with `PvFluidGrid_drop`: Ok(0), or Err(PV_ERR_DESERIALIZE) with *out holding
# no storage. The field lengths are the document's (they need not agree with nx·ny: `step` refuses an inconsistent
# grid).
#must_use
fn PvFluidGrid_from_json(buf, len, out: *PvFluidGrid): Result {
    var v = _pv_jr_parse(buf, len);
    var f = _pv_jr_form(v, 7);
    if (f == 0) { return Err(PV_ERR_DESERIALIZE); }
    var w[24];
    var ok = _pv_jr_usize(_pv_jr_at(v, f, 0, "nx"), &w);
    ok = ok & _pv_jr_usize(_pv_jr_at(v, f, 1, "ny"), &w + 8);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 2, "dx"), &w + 16);
    if (ok == 0) { return Err(PV_ERR_DESERIALIZE); }
    _pv_fg_zero(out);
    for (var c = 0; c < 4; c = c + 1) {
        if (_pv_jr_col(_pv_jr_at(v, f, c + 3, _pv_fg_field(c + 3)), _pv_fg_col(out, c), 0) == 0) {
            PvFluidGrid_drop(out);
            return Err(PV_ERR_DESERIALIZE);
        }
    }
    out.nx = load64(&w);
    out.ny = load64(&w + 8);
    var dx: f64 = load64(&w + 16);
    out.dx = dx;
    return Ok(0);
}

# ── grid (M3 part c): MacGrid, KEpsilon ───────────────────────────────────────────────

impl PvMacGrid {
    # Appends the grid as serde_json writes a `MacGrid` (the scratch skipped): 0, or -1 when the builder can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        var rc = _pv_jw(sb, "{");
        rc = rc | _pv_jw_key(sb, "nx", 1);
        rc = rc | _pv_jw_int(sb, self.nx);
        rc = rc | _pv_jw_key(sb, "ny", 0);
        rc = rc | _pv_jw_int(sb, self.ny);
        rc = rc | _pv_jw_key(sb, "dx", 0);
        rc = rc | _pv_jw_f64(sb, self.dx);
        for (var k = 0; k < 4; k = k + 1) {
            rc = rc | _pv_jw_key(sb, _pv_fg_field(k + 3), 0);
            rc = rc | _pv_jw_col(sb, _pv_mac_col(self, k), 0);
        }
        rc = rc | _pv_jw(sb, "}");
        return rc;
    }
}

# Reads a `MacGrid` document into *out, a fresh grid with empty scratch (as serde's skipped fields default),
# released with `PvMacGrid_drop`: Ok(0), or Err(PV_ERR_DESERIALIZE) with *out holding no storage. The field
# lengths are the document's (`step` refuses an inconsistent grid).
#must_use
fn PvMacGrid_from_json(buf, len, out: *PvMacGrid): Result {
    var v = _pv_jr_parse(buf, len);
    var f = _pv_jr_form(v, 7);
    if (f == 0) { return Err(PV_ERR_DESERIALIZE); }
    var w[24];
    var ok = _pv_jr_usize(_pv_jr_at(v, f, 0, "nx"), &w);
    ok = ok & _pv_jr_usize(_pv_jr_at(v, f, 1, "ny"), &w + 8);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 2, "dx"), &w + 16);
    if (ok == 0) { return Err(PV_ERR_DESERIALIZE); }
    _pv_mac_zero(out);
    for (var c = 0; c < 4; c = c + 1) {
        if (_pv_jr_col(_pv_jr_at(v, f, c + 3, _pv_fg_field(c + 3)), _pv_mac_col(out, c), 0) == 0) {
            PvMacGrid_drop(out);
            return Err(PV_ERR_DESERIALIZE);
        }
    }
    out.nx = load64(&w);
    out.ny = load64(&w + 8);
    var dx: f64 = load64(&w + 16);
    out.dx = dx;
    return Ok(0);
}

# The serde field name of a `KEpsilon` field k (0 k, 1 epsilon, 2 c_mu, 3 c_eps1, 4 c_eps2).
#must_use
fn _pv_ke_field(k): i64 {
    match k {
        0 => { return "k"; }
        1 => { return "epsilon"; }
        2 => { return "c_mu"; }
        3 => { return "c_eps1"; }
        _ => { return "c_eps2"; }
    }
    return "c_eps2";
}

impl PvKEpsilon {
    # Appends the model as serde_json writes a `KEpsilon` (the scratch skipped): 0, or -1 when the builder can't
    # grow.
    #must_use
    fn to_json(self, sb): i64 {
        var rc = _pv_jw(sb, "{");
        rc = rc | _pv_jw_key(sb, "k", 1);
        rc = rc | _pv_jw_col(sb, _pv_ke_col(self, 0), 0);
        rc = rc | _pv_jw_key(sb, "epsilon", 0);
        rc = rc | _pv_jw_col(sb, _pv_ke_col(self, 1), 0);
        rc = rc | _pv_jw_key(sb, "c_mu", 0);
        rc = rc | _pv_jw_f64(sb, self.c_mu);
        rc = rc | _pv_jw_key(sb, "c_eps1", 0);
        rc = rc | _pv_jw_f64(sb, self.c_eps1);
        rc = rc | _pv_jw_key(sb, "c_eps2", 0);
        rc = rc | _pv_jw_f64(sb, self.c_eps2);
        rc = rc | _pv_jw(sb, "}");
        return rc;
    }
}

# Reads a `KEpsilon` document into *out, with empty scratch (as serde's skipped fields default), released with
# `PvKEpsilon_drop`: Ok(0), or Err(PV_ERR_DESERIALIZE) with *out holding no storage. The k and ε lengths are the
# document's (`step` refuses ones that aren't the grid's).
#must_use
fn PvKEpsilon_from_json(buf, len, out: *PvKEpsilon): Result {
    var v = _pv_jr_parse(buf, len);
    var f = _pv_jr_form(v, 5);
    if (f == 0) { return Err(PV_ERR_DESERIALIZE); }
    var w[24];
    var ok = _pv_jr_f64(_pv_jr_at(v, f, 2, "c_mu"), &w);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 3, "c_eps1"), &w + 8);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 4, "c_eps2"), &w + 16);
    if (ok == 0) { return Err(PV_ERR_DESERIALIZE); }
    _pv_ke_zero(out);
    for (var c = 0; c < 2; c = c + 1) {
        if (_pv_jr_col(_pv_jr_at(v, f, c, _pv_ke_field(c)), _pv_ke_col(out, c), 0) == 0) {
            PvKEpsilon_drop(out);
            return Err(PV_ERR_DESERIALIZE);
        }
    }
    var a: f64 = load64(&w);
    var b: f64 = load64(&w + 8);
    var c2: f64 = load64(&w + 16);
    out.c_mu = a;
    out.c_eps1 = b;
    out.c_eps2 = c2;
    return Ok(0);
}

# ── VOF and the phase field (M3 part d) ──────────────────────────────────────────────

impl PvVofField {
    # Appends the field as serde_json writes a `VofField` (the scratch skipped): 0, or -1 when the builder can't
    # grow.
    #must_use
    fn to_json(self, sb): i64 {
        var rc = _pv_jw(sb, "{");
        rc = rc | _pv_jw_key(sb, "nx", 1);
        rc = rc | _pv_jw_int(sb, self.nx);
        rc = rc | _pv_jw_key(sb, "ny", 0);
        rc = rc | _pv_jw_int(sb, self.ny);
        rc = rc | _pv_jw_key(sb, "dx", 0);
        rc = rc | _pv_jw_f64(sb, self.dx);
        rc = rc | _pv_jw_key(sb, "alpha", 0);
        rc = rc | _pv_jw_col(sb, _pv_vof_col(self, 0), 0);
        rc = rc | _pv_jw(sb, "}");
        return rc;
    }
}

# Reads a `VofField` document into *out, with empty scratch (as serde's skipped field defaults), released with
# `PvVofField_drop`: Ok(0), or Err(PV_ERR_DESERIALIZE) with *out holding no storage. α's length is the document's
# (`advect` refuses one that isn't nx·ny).
#must_use
fn PvVofField_from_json(buf, len, out: *PvVofField): Result {
    var v = _pv_jr_parse(buf, len);
    var f = _pv_jr_form(v, 4);
    if (f == 0) { return Err(PV_ERR_DESERIALIZE); }
    var w[24];
    var ok = _pv_jr_usize(_pv_jr_at(v, f, 0, "nx"), &w);
    ok = ok & _pv_jr_usize(_pv_jr_at(v, f, 1, "ny"), &w + 8);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 2, "dx"), &w + 16);
    if (ok == 0) { return Err(PV_ERR_DESERIALIZE); }
    _pv_vof_zero(out);
    if (_pv_jr_col(_pv_jr_at(v, f, 3, "alpha"), _pv_vof_col(out, 0), 0) == 0) {
        PvVofField_drop(out);
        return Err(PV_ERR_DESERIALIZE);
    }
    out.nx = load64(&w);
    out.ny = load64(&w + 8);
    var dx: f64 = load64(&w + 16);
    out.dx = dx;
    return Ok(0);
}

impl PvPhaseField {
    # Appends the field as serde_json writes a `PhaseField` (the scratch skipped): 0, or -1 when the builder can't
    # grow.
    #must_use
    fn to_json(self, sb): i64 {
        var rc = _pv_jw(sb, "{");
        rc = rc | _pv_jw_key(sb, "nx", 1);
        rc = rc | _pv_jw_int(sb, self.nx);
        rc = rc | _pv_jw_key(sb, "ny", 0);
        rc = rc | _pv_jw_int(sb, self.ny);
        rc = rc | _pv_jw_key(sb, "dx", 0);
        rc = rc | _pv_jw_f64(sb, self.dx);
        rc = rc | _pv_jw_key(sb, "phi", 0);
        rc = rc | _pv_jw_col(sb, _pv_pf_col(self, 0), 0);
        rc = rc | _pv_jw_key(sb, "mobility", 0);
        rc = rc | _pv_jw_f64(sb, self.mobility);
        rc = rc | _pv_jw_key(sb, "epsilon", 0);
        rc = rc | _pv_jw_f64(sb, self.epsilon);
        rc = rc | _pv_jw(sb, "}");
        return rc;
    }
}

# Reads a `PhaseField` document into *out, with empty scratch (as serde's skipped field defaults), released with
# `PvPhaseField_drop`: Ok(0), or Err(PV_ERR_DESERIALIZE) with *out holding no storage. φ's length is the document's
# (`step` refuses one that isn't nx·ny).
#must_use
fn PvPhaseField_from_json(buf, len, out: *PvPhaseField): Result {
    var v = _pv_jr_parse(buf, len);
    var f = _pv_jr_form(v, 6);
    if (f == 0) { return Err(PV_ERR_DESERIALIZE); }
    var w[40];
    var ok = _pv_jr_usize(_pv_jr_at(v, f, 0, "nx"), &w);
    ok = ok & _pv_jr_usize(_pv_jr_at(v, f, 1, "ny"), &w + 8);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 2, "dx"), &w + 16);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 4, "mobility"), &w + 24);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 5, "epsilon"), &w + 32);
    if (ok == 0) { return Err(PV_ERR_DESERIALIZE); }
    _pv_pf_zero(out);
    if (_pv_jr_col(_pv_jr_at(v, f, 3, "phi"), _pv_pf_col(out, 0), 0) == 0) {
        PvPhaseField_drop(out);
        return Err(PV_ERR_DESERIALIZE);
    }
    out.nx = load64(&w);
    out.ny = load64(&w + 8);
    var dx: f64 = load64(&w + 16);
    var mob: f64 = load64(&w + 24);
    var eps: f64 = load64(&w + 32);
    out.dx = dx;
    out.mobility = mob;
    out.epsilon = eps;
    return Ok(0);
}

# ── BodyShape, RigidBody (M6 part a) ──────────────────────────────────────────────────

# Appends the shape as serde_json writes a `BodyShape`, externally tagged: `{"Sphere":{"radius":r}}` or
# `{"Box":{"half_extents":[hx,hy,hz]}}`. 0, or -1 when the builder can't grow or the kind is outside the enum.
#must_use
fn body_shape_to_json(s: *PvShape, sb): i64 {
    if (s.kind == PV_BODY_SHAPE_SPHERE) {
        var rc = _pv_jw(sb, "{\"Sphere\":{\"radius\":");
        rc = rc | _pv_jw_f64(sb, s.radius);
        rc = rc | _pv_jw(sb, "}}");
        return rc;
    }
    if (s.kind == PV_BODY_SHAPE_BOX) {
        var rb = _pv_jw(sb, "{\"Box\":{\"half_extents\":");
        rb = rb | _pv_jw_f64x3(sb, s.half_extents.0, s.half_extents.1, s.half_extents.2);
        rb = rb | _pv_jw(sb, "}}");
        return rb;
    }
    return 0 - 1;
}

# A `BodyShape` node into *out: the one-key object `{"Variant": fields}`, the fields as a struct variant's (an object
# by name, unknown names ignored, or an array of exactly its fields). A bare `"Sphere"` is refused, as serde refuses
# a unit form for a struct variant. 1, or 0 with *out untouched.
fn _pv_jr_shape(v, out: *PvShape): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_tag(v) != JTAG_OBJ || bayan_json_v_obj_len(v) != 1) { return 0; }
    var key = bayan_json_v_obj_key(v, 0);
    var body = bayan_json_v_obj_val(v, 0);
    var f = _pv_jr_form(body, 1);
    if (f == 0) { return 0; }
    var w[24];
    if (str_eq_cstr(key, "Sphere") == 1) {
        if (_pv_jr_f64(_pv_jr_at(body, f, 0, "radius"), &w) == 0) { return 0; }
        var r: f64 = load64(&w);
        var sp: PvShape = PvShape_sphere(r);
        *out = sp;
        return 1;
    }
    if (str_eq_cstr(key, "Box") == 1) {
        if (_pv_jr_f64x3(_pv_jr_at(body, f, 0, "half_extents"), &w) == 0) { return 0; }
        var hx: f64 = load64(&w);
        var hy: f64 = load64(&w + 8);
        var hz: f64 = load64(&w + 16);
        var bx: PvShape = PvShape_box(hx, hy, hz);
        *out = bx;
        return 1;
    }
    return 0;
}

# Reads a `BodyShape` document into *out: Ok(0), or Err(PV_ERR_DESERIALIZE) with *out untouched.
#must_use
fn body_shape_from_json(buf, len, out: *PvShape): Result {
    var v = _pv_jr_parse(buf, len);
    if (_pv_jr_shape(v, out) == 0) { return Err(PV_ERR_DESERIALIZE); }
    return Ok(0);
}

impl PvRigidBody {
    # Appends the body as serde_json writes a `RigidBody`: 0, or -1 when the builder can't grow or the shape's kind
    # is outside the enum.
    #must_use
    fn to_json(self, sb): i64 {
        var rc = _pv_jw(sb, "{");
        rc = rc | _pv_jw_key(sb, "position", 1);
        rc = rc | _pv_jw_f64x3(sb, self.position.x, self.position.y, self.position.z);
        rc = rc | _pv_jw_key(sb, "velocity", 0);
        rc = rc | _pv_jw_f64x3(sb, self.velocity.x, self.velocity.y, self.velocity.z);
        rc = rc | _pv_jw_key(sb, "mass", 0);
        rc = rc | _pv_jw_f64(sb, self.mass);
        rc = rc | _pv_jw_key(sb, "shape", 0);
        rc = rc | body_shape_to_json(_pv_body_shape(self), sb);
        rc = rc | _pv_jw_key(sb, "force", 0);
        rc = rc | _pv_jw_f64x3(sb, self.force.x, self.force.y, self.force.z);
        rc = rc | _pv_jw(sb, "}");
        return rc;
    }
}

# Reads a `RigidBody` document into *out: Ok(0), or Err(PV_ERR_DESERIALIZE) with *out untouched.
#must_use
fn PvRigidBody_from_json(buf, len, out: *PvRigidBody): Result {
    var v = _pv_jr_parse(buf, len);
    var f = _pv_jr_form(v, 5);
    if (f == 0) { return Err(PV_ERR_DESERIALIZE); }
    # Read into the record's 15 words (position, velocity, mass, the shape's 5, force), then copy it whole.
    var w[120];
    var ok = _pv_jr_f64x3(_pv_jr_at(v, f, 0, "position"), &w);
    ok = ok & _pv_jr_f64x3(_pv_jr_at(v, f, 1, "velocity"), &w + 24);
    ok = ok & _pv_jr_f64(_pv_jr_at(v, f, 2, "mass"), &w + 48);
    ok = ok & _pv_jr_shape(_pv_jr_at(v, f, 3, "shape"), _pv_body_shape(&w));
    ok = ok & _pv_jr_f64x3(_pv_jr_at(v, f, 4, "force"), &w + 96);
    if (ok == 0) { return Err(PV_ERR_DESERIALIZE); }
    var src: *PvRigidBody = _pv_as_bodies(&w);
    *out = *src;
    return Ok(0);
}

# ── ConstitutiveModel (M6 part c) ─────────────────────────────────────────────────────

# Appends the model as serde_json writes a `ConstitutiveModel`, externally tagged: `{"Fluid":{"bulk_modulus":K,
# "viscosity":μ}}`, `{"NeoHookean":{"youngs_modulus":E,"poisson_ratio":ν}}` or `{"DruckerPrager":{…,
# "friction_angle":φ}}`. 0, or -1 when the builder can't grow or the kind is outside the enum.
#must_use
fn constitutive_model_to_json(m: *PvConstitutiveLaw, sb): i64 {
    if (m.kind == PV_CONSTITUTIVE_MODEL_FLUID) {
        var rc = _pv_jw(sb, "{\"Fluid\":{");
        rc = rc | _pv_jw_key(sb, "bulk_modulus", 1);
        rc = rc | _pv_jw_f64(sb, m.bulk_modulus);
        rc = rc | _pv_jw_key(sb, "viscosity", 0);
        rc = rc | _pv_jw_f64(sb, m.viscosity);
        rc = rc | _pv_jw(sb, "}}");
        return rc;
    }
    if (m.kind != PV_CONSTITUTIVE_MODEL_NEO_HOOKEAN && m.kind != PV_CONSTITUTIVE_MODEL_DRUCKER_PRAGER) {
        return 0 - 1;
    }
    var re = 0;
    if (m.kind == PV_CONSTITUTIVE_MODEL_NEO_HOOKEAN) {
        re = _pv_jw(sb, "{\"NeoHookean\":{");
    } else {
        re = _pv_jw(sb, "{\"DruckerPrager\":{");
    }
    re = re | _pv_jw_key(sb, "youngs_modulus", 1);
    re = re | _pv_jw_f64(sb, m.youngs_modulus);
    re = re | _pv_jw_key(sb, "poisson_ratio", 0);
    re = re | _pv_jw_f64(sb, m.poisson_ratio);
    if (m.kind == PV_CONSTITUTIVE_MODEL_DRUCKER_PRAGER) {
        re = re | _pv_jw_key(sb, "friction_angle", 0);
        re = re | _pv_jw_f64(sb, m.friction_angle);
    }
    re = re | _pv_jw(sb, "}}");
    return re;
}

# Reads a `ConstitutiveModel` document into *out: the one-key object `{"Variant": fields}`, the fields as a struct
# variant's (an object by name, unknown names ignored, or an array of exactly its fields). Ok(0), or
# Err(PV_ERR_DESERIALIZE) with *out untouched. (No validation: serde fills the fields; `constitutive_model_validate`
# checks them.)
#must_use
fn constitutive_model_from_json(buf, len, out: *PvConstitutiveLaw): Result {
    var v = _pv_jr_parse(buf, len);
    if (v == 0) { return Err(PV_ERR_DESERIALIZE); }
    if (bayan_json_v_tag(v) != JTAG_OBJ || bayan_json_v_obj_len(v) != 1) { return Err(PV_ERR_DESERIALIZE); }
    var key = bayan_json_v_obj_key(v, 0);
    var body = bayan_json_v_obj_val(v, 0);
    var w[24];
    if (str_eq_cstr(key, "Fluid") == 1) {
        var ff = _pv_jr_form(body, 2);
        if (ff == 0) { return Err(PV_ERR_DESERIALIZE); }
        var ok = _pv_jr_f64(_pv_jr_at(body, ff, 0, "bulk_modulus"), &w);
        ok = ok & _pv_jr_f64(_pv_jr_at(body, ff, 1, "viscosity"), &w + 8);
        if (ok == 0) { return Err(PV_ERR_DESERIALIZE); }
        var k: f64 = load64(&w);
        var mu: f64 = load64(&w + 8);
        var fl: PvConstitutiveLaw = PvConstitutiveLaw_fluid(k, mu);
        *out = fl;
        return Ok(0);
    }
    var dp = str_eq_cstr(key, "DruckerPrager");
    if (str_eq_cstr(key, "NeoHookean") == 0 && dp == 0) { return Err(PV_ERR_DESERIALIZE); }
    var fe = _pv_jr_form(body, 2 + dp);
    if (fe == 0) { return Err(PV_ERR_DESERIALIZE); }
    var oe = _pv_jr_f64(_pv_jr_at(body, fe, 0, "youngs_modulus"), &w);
    oe = oe & _pv_jr_f64(_pv_jr_at(body, fe, 1, "poisson_ratio"), &w + 8);
    if (dp == 1) { oe = oe & _pv_jr_f64(_pv_jr_at(body, fe, 2, "friction_angle"), &w + 16); }
    if (oe == 0) { return Err(PV_ERR_DESERIALIZE); }
    var e: f64 = load64(&w);
    var nu: f64 = load64(&w + 8);
    if (dp == 1) {
        var phi: f64 = load64(&w + 16);
        var d: PvConstitutiveLaw = PvConstitutiveLaw_drucker_prager(e, nu, phi);
        *out = d;
        return Ok(0);
    }
    var nh: PvConstitutiveLaw = PvConstitutiveLaw_neo_hookean(e, nu);
    *out = nh;
    return Ok(0);
}

# ── SphKernelParams, GridKernelParams, ShallowKernelParams (M7 part a) ────────────────

# A JSON integer in 0 … u32::MAX into *out: 1, or 0 (serde refuses a float, a negative and a larger integer for a
# u32).
fn _pv_jr_u32(v, out): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_tag(v) != JTAG_INT) { return 0; }
    var n = bayan_json_v_int(v);
    if (n < 0 || n > 4294967295) { return 0; }
    store64(out, n);
    return 1;
}

# An f32 field as serde_json writes it: the value, which bayan prints as its widened f64's digits (they read back to
# the same f32), or `null` when it is NaN or ±∞. 0, or -1 when the builder can't grow.
#must_use
fn _pv_jw_f32(sb, x: f32): i64 {
    var w: f64 = f32_to(x);
    return _pv_jw_f64(sb, w);
}

# ── f32 reads (ledger L15) ──────────────────────────────────────────────────────────
# serde_json 1.0.154's `float_roundtrip` parse rounds the document's decimal to f32 once (`f64_from_parts` with
# `single_precision`) and refuses a value that rounds to ±∞ (NumberOutOfRange); a JSON integer reads through
# `u64 as f32` / `i64 as f32`, one rounding too. bayan's tree holds only the f64 nearest the decimal, and the f32
# nearest that f64 is the f32 nearest the decimal except when the f64 is exactly the midpoint of two adjacent f32s:
# every such midpoint is itself an f64, so a decimal and its nearest f64 can't lie on opposite sides of one. There
# the decimal's own side of the midpoint decides, which the stand-in reads from the document text, finding the
# number by its document-order position (the tree keeps objects' members and arrays' elements in document order).
#
# UPSTREAM(L15): cyrius:docs/development/issues/2026-11-12-no-f32-decimal-parse.md (a correctly rounded f32 parse)
#   and bayan:docs/development/issues/2026-11-12-json-tree-number-keeps-no-source-text.md (a number node's span);
#   replace the midpoint step with the stdlib's f32 parse over the node's span once both ship; parity: the
#   kernel-parameter `from_json` rows of tests/golden/compute.tsv (class A).

# The decimal digits the comparison keeps (Go strconv's capacity: an f64 has at most 767 significant digits), and the
# bignum size in 32-bit limbs, a word each (5,440 bits: the largest product, m·10^1200·2^971, needs 5,011).
const _PV_DEC_CAP = 800;
const _PV_BIG_LIMBS = 170;

# The f32 nearest x, ties to even, as its 32-bit pattern (+∞'s when x rounds past f32::MAX).
#must_use
fn _pv_f32_pat(x: f64): i64 {
    return f32_from(x);
}

# The value of the nonnegative f32 pattern fb as f64 bits, +∞'s pattern standing for 2^128 (the successor of
# f32::MAX that the overflow threshold is the midpoint to).
#must_use
fn _pv_f32_wide(fb): i64 {
    if (fb == 2139095040) { return 5183643171103440896; }
    var w: f64 = f32_to(fb);
    return _pv_bits(w);
}

# 1 when the finite, nonnegative a is exactly the midpoint of two adjacent f32 values, else 0.
#must_use
fn _pv_f32_is_tie(a: f64): i64 {
    var fb = _pv_f32_pat(a);
    var w: f64 = _pv_f32_wide(fb);
    if (w == a) { return 0; }
    var gb = fb + 1;
    if (w > a) { gb = fb - 1; }
    if (gb > 2139095040) { return 0; }
    var g: f64 = _pv_f32_wide(gb);
    var s: f64 = w + g;
    var m: f64 = s * 0.5;
    if (m == a) { return 1; }
    return 0;
}

# The f32 nearest a value v, given x, the f64 nearest v (finite), and c, the sign of |v| − |x| (0 unless |x| is an
# f32 midpoint, `_pv_f32_is_tie`): (1, its widened f64 bits), or (0, 0) when v rounds to ±∞.
fn _pv_f32_round(x: f64, c) {
    var sign = _pv_bits(x) & (0 - 9223372036854775807 - 1);
    var a: f64 = _pv_bits(x) & 9223372036854775807;
    var fb = _pv_f32_pat(a);
    if (c != 0) {
        var w: f64 = _pv_f32_wide(fb);
        if (c > 0 && w < a) { fb = fb + 1; }
        if (c < 0 && w > a) { fb = fb - 1; }
    }
    if (fb >= 2139095040) { return (0, 0); }
    var r: f64 = f32_to(fb);
    return (1, _pv_bits(r) | sign);
}

# a·k + c on the n little-endian 32-bit limbs at a (a word each), 0 ≤ k, c < 2^31: the new limb count, or -1 when it
# would pass _PV_BIG_LIMBS.
fn _pv_big_madd(a, n, k, c): i64 {
    var carry = c;
    for (var i = 0; i < n; i = i + 1) {
        var t = load64(a + i * 8) * k + carry;
        store64(a + i * 8, t & 4294967295);
        carry = t >> 32;
    }
    if (carry == 0) { return n; }
    if (n >= _PV_BIG_LIMBS) { return 0 - 1; }
    store64(a + n * 8, carry);
    return n + 1;
}

# The n-limb a times base^e (base 10 or 2, e ≥ 0), in place: the new count, or -1.
fn _pv_big_mul_pow(a, n, base, e): i64 {
    var step = 1000000000;
    var sk = 9;
    if (base == 2) {
        step = 1073741824;
        sk = 30;
    }
    while (e >= sk) {
        n = _pv_big_madd(a, n, step, 0);
        if (n < 0) { return n; }
        e = e - sk;
    }
    var k = 1;
    for (var i = 0; i < e; i = i + 1) { k = k * base; }
    return _pv_big_madd(a, n, k, 0);
}

# The sign of a − b for the bignums of na and nb limbs.
#must_use
fn _pv_big_cmp(a, na, b, nb): i64 {
    while (na > 0 && load64(a + (na - 1) * 8) == 0) { na = na - 1; }
    while (nb > 0 && load64(b + (nb - 1) * 8) == 0) { nb = nb - 1; }
    if (na > nb) { return 1; }
    if (na < nb) { return 0 - 1; }
    for (var i = na - 1; i >= 0; i = i - 1) {
        var x = load64(a + i * 8);
        var y = load64(b + i * 8);
        if (x > y) { return 1; }
        if (x < y) { return 0 - 1; }
    }
    return 0;
}

# The sign of |v| − |x|, exactly, for the JSON number text s[0..n) (value v; bayan has checked its grammar) and a
# finite, nonzero f64 x: -1, 0 or 1. Digits past _PV_DEC_CAP count only as "a nonzero digit follows", which decides
# every comparison the kept digits leave equal.
#must_use
fn _pv_dec_cmp(s, n, x: f64): i64 {
    var dg[800];
    var nd = 0;
    var e = 0;
    var sticky = 0;
    var seen = 0;
    var i = 0;
    if (n > 0 && load8(s) == 45) { i = 1; }
    while (i < n && load8(s + i) >= 48 && load8(s + i) <= 57) {
        var c = load8(s + i) - 48;
        if (seen == 1 || c != 0) {
            seen = 1;
            if (nd < _PV_DEC_CAP) {
                store8(&dg + nd, c);
                nd = nd + 1;
            } else {
                if (c != 0) { sticky = 1; }
                e = e + 1;
            }
        }
        i = i + 1;
    }
    if (i < n && load8(s + i) == 46) {
        i = i + 1;
        while (i < n && load8(s + i) >= 48 && load8(s + i) <= 57) {
            var cf = load8(s + i) - 48;
            if (seen == 0 && cf == 0) {
                e = e - 1;
            } elif (nd < _PV_DEC_CAP) {
                seen = 1;
                store8(&dg + nd, cf);
                nd = nd + 1;
                e = e - 1;
            } elif (cf != 0) {
                sticky = 1;
            }
            i = i + 1;
        }
    }
    if (i < n && (load8(s + i) == 101 || load8(s + i) == 69)) {
        i = i + 1;
        var xneg = 0;
        if (i < n && load8(s + i) == 45) { xneg = 1; }
        if (i < n && (load8(s + i) == 45 || load8(s + i) == 43)) { i = i + 1; }
        var xe = 0;
        while (i < n && load8(s + i) >= 48 && load8(s + i) <= 57) {
            if (xe < 100000) { xe = xe * 10 + (load8(s + i) - 48); }
            i = i + 1;
        }
        if (xneg == 1) { xe = 0 - xe; }
        e = e + xe;
    }
    while (nd > 0 && load8(&dg + nd - 1) == 0) {
        nd = nd - 1;
        e = e + 1;
    }
    if (nd == 0) { return 0 - 1; }
    # |x| lies in [2^-1074, 2^1024), so a decimal past these orders is decided by its order alone (and the bignums
    # stay inside _PV_BIG_LIMBS).
    if (e + nd > 400) { return 1; }
    if (e + nd < (0 - 400)) { return 0 - 1; }
    # |x| = m·2^q.
    var bx = _pv_bits(x) & 9223372036854775807;
    var ef = bx >> 52;
    var m = bx & 4503599627370495;
    var q = 0 - 1074;
    if (ef != 0) {
        m = m | 4503599627370496;
        q = ef - 1075;
    }
    while ((m & 1) == 0) {
        m = m >> 1;
        q = q + 1;
    }
    var big_a[1360];
    var big_b[1360];
    var na = 0;
    var j = 0;
    while (j < nd) {
        var take = nd - j;
        if (take > 9) { take = 9; }
        var cv = 0;
        var k = 1;
        for (var t = 0; t < take; t = t + 1) {
            cv = cv * 10 + load8(&dg + j + t);
            k = k * 10;
        }
        na = _pv_big_madd(&big_a, na, k, cv);
        j = j + take;
    }
    store64(&big_b, m & 4294967295);
    store64(&big_b + 8, m >> 32);
    var nb = 2;
    if (e > 0) { na = _pv_big_mul_pow(&big_a, na, 10, e); }
    if (e < 0) { nb = _pv_big_mul_pow(&big_b, nb, 10, 0 - e); }
    if (q > 0) { nb = _pv_big_mul_pow(&big_b, nb, 2, q); }
    if (q < 0 && na >= 0) { na = _pv_big_mul_pow(&big_a, na, 2, 0 - q); }
    # Unreachable inside the order bounds above; a tie is then kept as the f64's.
    if (na < 0 || nb < 0) { return 0; }
    var r = _pv_big_cmp(&big_a, na, &big_b, nb);
    if (r == 0 && sticky == 1) { return 1; }
    return r;
}

# The pre-order position of `node` among the number nodes of the tree v, counted on from *st: 1 when found (the
# position then in *st), else 0 with *st advanced past v's numbers. Recursion is bounded by bayan's nesting cap (128).
fn _pv_jr_num_pos(v, node, st): i64 {
    if (v == node) { return 1; }
    var tag = bayan_json_v_tag(v);
    if (tag == JTAG_INT || tag == JTAG_FLOAT) {
        store64(st, load64(st) + 1);
        return 0;
    }
    if (tag == JTAG_ARR) {
        var na = bayan_json_v_arr_len(v);
        for (var i = 0; i < na; i = i + 1) {
            if (_pv_jr_num_pos(bayan_json_v_arr_get(v, i), node, st) == 1) { return 1; }
        }
    }
    if (tag == JTAG_OBJ) {
        var no = bayan_json_v_obj_len(v);
        for (var k = 0; k < no; k = k + 1) {
            if (_pv_jr_num_pos(bayan_json_v_obj_val(v, k), node, st) == 1) { return 1; }
        }
    }
    return 0;
}

# 1 when b can continue a JSON number (a digit, `.`, `e`, `E`, `+` or `-`).
#must_use
fn _pv_jr_num_byte(b): i64 {
    if (b >= 48 && b <= 57) { return 1; }
    if (b == 46 || b == 101 || b == 69 || b == 43 || b == 45) { return 1; }
    return 0;
}

# The text of the number node v of the document last parsed: (pointer, length), or (0, 0) when v is not a number
# node of its tree.
# The k-th number of the tree in pre-order is the k-th number token of the text: the scan skips strings (with their
# escapes), so only numbers start with `-` or a digit.
fn _pv_jr_num_text(v) {
    var tag = bayan_json_v_tag(v);
    if (v == 0 || (tag != JTAG_INT && tag != JTAG_FLOAT)) { return (0, 0); }
    var st[8];
    store64(&st, 0);
    if (_pv_jr_root == 0 || _pv_jr_num_pos(_pv_jr_root, v, &st) == 0) { return (0, 0); }
    var want = load64(&st);
    var s = _pv_jr_doc;
    var n = _pv_jr_doc_len;
    var k = 0;
    var i = 0;
    while (i < n) {
        var c = load8(s + i);
        if (c == 34) {
            i = i + 1;
            var open = 1;
            while (i < n && open == 1) {
                var d = load8(s + i);
                if (d == 92) {
                    i = i + 2;
                } else {
                    if (d == 34) { open = 0; }
                    i = i + 1;
                }
            }
        } elif (c == 45 || (c >= 48 && c <= 57)) {
            var start = i;
            i = i + 1;
            while (i < n && _pv_jr_num_byte(load8(s + i)) == 1) { i = i + 1; }
            if (k == want) { return (s + start, i - start); }
            k = k + 1;
        } else {
            i = i + 1;
        }
    }
    return (0, 0);
}

# An integer as `i64 as f32` rounds it, once: its widened f64 bits (never ±∞: |n| ≤ 2^63).
#must_use
fn _pv_f32_of_int(n): i64 {
    var x: f64 = f64_from(n);
    var a: f64 = _pv_bits(x) & 9223372036854775807;
    var c = 0;
    if (_pv_f32_is_tie(a) == 1) {
        # A midpoint is below 2^63 (itself an f32), so it converts back exactly, and n is not i64::MIN.
        var mx = f64_to(a);
        var an = n;
        if (n < 0) { an = 0 - n; }
        if (an > mx) { c = 1; }
        if (an < mx) { c = 0 - 1; }
    }
    var t, b = _pv_f32_round(x, c);
    return b;
}

# A JSON number into *out as serde_json reads an f32 (above), as the f32's widened f64 bits: 1, or 0 for anything
# else, and for a value that rounds to ±∞.
fn _pv_jr_f32(v, out): i64 {
    if (v == 0) { return 0; }
    var tag = bayan_json_v_tag(v);
    if (tag == JTAG_INT) {
        store64(out, _pv_f32_of_int(bayan_json_v_int(v)));
        return 1;
    }
    if (tag != JTAG_FLOAT) { return 0; }
    var x: f64 = bayan_json_v_float(v);
    if (_pv_is_finite(x) == 0) { return 0; }
    var a: f64 = _pv_bits(x) & 9223372036854775807;
    var c = 0;
    if (_pv_f32_is_tie(a) == 1) {
        var p, pn = _pv_jr_num_text(v);
        if (p == 0) { return 0; }
        c = _pv_dec_cmp(p, pn, x);
    }
    var t, b = _pv_f32_round(x, c);
    if (t == 0) { return 0; }
    store64(out, b);
    return 1;
}

impl PvSphKernelParams {
    # Appends the parameters as serde_json writes a `SphKernelParams` (`gravity` the array of its three fields): 0,
    # or -1 when the builder can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        var rc = _pv_jw(sb, "{");
        rc = rc | _pv_jw_key(sb, "smoothing_radius", 1);
        rc = rc | _pv_jw_f32(sb, self.smoothing_radius);
        rc = rc | _pv_jw_key(sb, "rest_density", 0);
        rc = rc | _pv_jw_f32(sb, self.rest_density);
        rc = rc | _pv_jw_key(sb, "gas_constant", 0);
        rc = rc | _pv_jw_f32(sb, self.gas_constant);
        rc = rc | _pv_jw_key(sb, "viscosity", 0);
        rc = rc | _pv_jw_f32(sb, self.viscosity);
        rc = rc | _pv_jw_key(sb, "gravity", 0);
        rc = rc | _pv_jw(sb, "[");
        rc = rc | _pv_jw_f32(sb, self.gravity_x);
        rc = rc | _pv_jw(sb, ",");
        rc = rc | _pv_jw_f32(sb, self.gravity_y);
        rc = rc | _pv_jw(sb, ",");
        rc = rc | _pv_jw_f32(sb, self.gravity_z);
        rc = rc | _pv_jw(sb, "]");
        rc = rc | _pv_jw_key(sb, "dt", 0);
        rc = rc | _pv_jw_f32(sb, self.dt);
        rc = rc | _pv_jw_key(sb, "particle_count", 0);
        rc = rc | _pv_jw_int(sb, self.particle_count);
        rc = rc | _pv_jw(sb, "}");
        return rc;
    }
}

# Reads a `SphKernelParams` document into *out: Ok(0), or Err(PV_ERR_DESERIALIZE) with *out untouched. Every field is
# required (the type is `Default` but has no `#[serde(default)]`).
#must_use
fn PvSphKernelParams_from_json(buf, len, out: *PvSphKernelParams): Result {
    var v = _pv_jr_parse(buf, len);
    var f = _pv_jr_form(v, 7);
    if (f == 0) { return Err(PV_ERR_DESERIALIZE); }
    var w[72];
    var ok = _pv_jr_f32(_pv_jr_at(v, f, 0, "smoothing_radius"), &w);
    ok = ok & _pv_jr_f32(_pv_jr_at(v, f, 1, "rest_density"), &w + 8);
    ok = ok & _pv_jr_f32(_pv_jr_at(v, f, 2, "gas_constant"), &w + 16);
    ok = ok & _pv_jr_f32(_pv_jr_at(v, f, 3, "viscosity"), &w + 24);
    var g = _pv_jr_at(v, f, 4, "gravity");
    if (g == 0 || bayan_json_v_tag(g) != JTAG_ARR || bayan_json_v_arr_len(g) != 3) { return Err(PV_ERR_DESERIALIZE); }
    for (var k = 0; k < 3; k = k + 1) { ok = ok & _pv_jr_f32(bayan_json_v_arr_get(g, k), &w + 32 + k * 8); }
    ok = ok & _pv_jr_f32(_pv_jr_at(v, f, 5, "dt"), &w + 56);
    ok = ok & _pv_jr_u32(_pv_jr_at(v, f, 6, "particle_count"), &w + 64);
    if (ok == 0) { return Err(PV_ERR_DESERIALIZE); }
    var a: f64 = load64(&w);
    var b: f64 = load64(&w + 8);
    var c: f64 = load64(&w + 16);
    var d: f64 = load64(&w + 24);
    var gx: f64 = load64(&w + 32);
    var gy: f64 = load64(&w + 40);
    var gz: f64 = load64(&w + 48);
    var dt: f64 = load64(&w + 56);
    out.smoothing_radius = a;
    out.rest_density = b;
    out.gas_constant = c;
    out.viscosity = d;
    out.gravity_x = gx;
    out.gravity_y = gy;
    out.gravity_z = gz;
    out.dt = dt;
    out.particle_count = load64(&w + 64);
    return Ok(0);
}

# The grid and shallow-water parameter records share a shape: two u32 sizes, then five f32 values. Appends one as
# serde_json writes it, with the five field names given: 0, or -1.
#must_use
fn _pv_jw_kernel_grid(sb, nx, ny, vals, n0, n1, n2, n3, n4): i64 {
    var rc = _pv_jw(sb, "{");
    rc = rc | _pv_jw_key(sb, "nx", 1);
    rc = rc | _pv_jw_int(sb, nx);
    rc = rc | _pv_jw_key(sb, "ny", 0);
    rc = rc | _pv_jw_int(sb, ny);
    var names[40];
    store64(&names, n0);
    store64(&names + 8, n1);
    store64(&names + 16, n2);
    store64(&names + 24, n3);
    store64(&names + 32, n4);
    for (var k = 0; k < 5; k = k + 1) {
        rc = rc | _pv_jw_key(sb, load64(&names + k * 8), 0);
        var x: f64 = load64(vals + k * 8);
        rc = rc | _pv_jw_f64(sb, x);
    }
    rc = rc | _pv_jw(sb, "}");
    return rc;
}

# Reads the shared shape into the seven words at w (nx, ny, then the five values as widened f32s): 1, or 0.
fn _pv_jr_kernel_grid(buf, len, w, n0, n1, n2, n3, n4): i64 {
    var v = _pv_jr_parse(buf, len);
    var f = _pv_jr_form(v, 7);
    if (f == 0) { return 0; }
    var ok = _pv_jr_u32(_pv_jr_at(v, f, 0, "nx"), w);
    ok = ok & _pv_jr_u32(_pv_jr_at(v, f, 1, "ny"), w + 8);
    ok = ok & _pv_jr_f32(_pv_jr_at(v, f, 2, n0), w + 16);
    ok = ok & _pv_jr_f32(_pv_jr_at(v, f, 3, n1), w + 24);
    ok = ok & _pv_jr_f32(_pv_jr_at(v, f, 4, n2), w + 32);
    ok = ok & _pv_jr_f32(_pv_jr_at(v, f, 5, n3), w + 40);
    ok = ok & _pv_jr_f32(_pv_jr_at(v, f, 6, n4), w + 48);
    return ok;
}

impl PvGridKernelParams {
    # Appends the parameters as serde_json writes a `GridKernelParams`: 0, or -1 when the builder can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        var vals[40];
        var a: f64 = f32_to(self.dx);
        var b: f64 = f32_to(self.dt);
        var c: f64 = f32_to(self.viscosity);
        var d: f64 = f32_to(self.buoyancy_alpha);
        var e: f64 = f32_to(self.ambient_density);
        store64(&vals, _pv_bits(a));
        store64(&vals + 8, _pv_bits(b));
        store64(&vals + 16, _pv_bits(c));
        store64(&vals + 24, _pv_bits(d));
        store64(&vals + 32, _pv_bits(e));
        return _pv_jw_kernel_grid(sb, self.nx, self.ny, &vals, "dx", "dt", "viscosity", "buoyancy_alpha",
          "ambient_density");
    }
}

# Reads a `GridKernelParams` document into *out: Ok(0), or Err(PV_ERR_DESERIALIZE) with *out untouched.
#must_use
fn PvGridKernelParams_from_json(buf, len, out: *PvGridKernelParams): Result {
    var w[56];
    if (_pv_jr_kernel_grid(buf, len, &w, "dx", "dt", "viscosity", "buoyancy_alpha", "ambient_density") == 0) {
        return Err(PV_ERR_DESERIALIZE);
    }
    var a: f64 = load64(&w + 16);
    var b: f64 = load64(&w + 24);
    var c: f64 = load64(&w + 32);
    var d: f64 = load64(&w + 40);
    var e: f64 = load64(&w + 48);
    out.nx = load64(&w);
    out.ny = load64(&w + 8);
    out.dx = a;
    out.dt = b;
    out.viscosity = c;
    out.buoyancy_alpha = d;
    out.ambient_density = e;
    return Ok(0);
}

impl PvShallowKernelParams {
    # Appends the parameters as serde_json writes a `ShallowKernelParams`: 0, or -1 when the builder can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        var vals[40];
        var a: f64 = f32_to(self.dx);
        var b: f64 = f32_to(self.dt);
        var c: f64 = f32_to(self.gravity);
        var d: f64 = f32_to(self.damping);
        var e: f64 = f32_to(self.dry_threshold);
        store64(&vals, _pv_bits(a));
        store64(&vals + 8, _pv_bits(b));
        store64(&vals + 16, _pv_bits(c));
        store64(&vals + 24, _pv_bits(d));
        store64(&vals + 32, _pv_bits(e));
        return _pv_jw_kernel_grid(sb, self.nx, self.ny, &vals, "dx", "dt", "gravity", "damping", "dry_threshold");
    }
}

# Reads a `ShallowKernelParams` document into *out: Ok(0), or Err(PV_ERR_DESERIALIZE) with *out untouched.
#must_use
fn PvShallowKernelParams_from_json(buf, len, out: *PvShallowKernelParams): Result {
    var w[56];
    if (_pv_jr_kernel_grid(buf, len, &w, "dx", "dt", "gravity", "damping", "dry_threshold") == 0) {
        return Err(PV_ERR_DESERIALIZE);
    }
    var a: f64 = load64(&w + 16);
    var b: f64 = load64(&w + 24);
    var c: f64 = load64(&w + 32);
    var d: f64 = load64(&w + 40);
    var e: f64 = load64(&w + 48);
    out.nx = load64(&w);
    out.ny = load64(&w + 8);
    out.dx = a;
    out.dt = b;
    out.gravity = c;
    out.damping = d;
    out.dry_threshold = e;
    return Ok(0);
}

# ── DaimonConfig, HooshConfig (M7 part b) ────────────────────────────────────────────
# serde's derive for the two configs (src/ai.cyr): `{"endpoint":"…","api_key":"…"|null}` and `{"endpoint":"…"}`. A
# missing or null `api_key` reads as None in the object form, as serde reads an Option; the sequence form needs every
# element. Strings are UTF-8 with serde_json's escapes, which bayan decodes as serde_json does (a lone surrogate
# either way is refused by both). Two serde_json refusals bayan passes through are checked on the text first (bayan
# issue 2026-11-11-json-strings-accept-raw-control-bytes-and-invalid-utf8): a raw byte below 0x20 inside a string, and
# bytes that are not UTF-8 (serde_json's `from_slice`; its `from_str` takes a `&str`, valid by type).

# Appends the n bytes at p: 0, or -1 when the builder can't grow.
#must_use
fn _pv_jw_n(sb, p, n): i64 {
    if (n <= 0) { return 0; }
    var t[16];
    store64(&t, p);
    store64(&t + 8, n);
    if (str_builder_add_a(default_alloc(), sb, &t) != 0) { return 0 - 1; }
    return 0;
}

# Appends the n bytes at p as serde_json writes a string: quoted; `"` and `\` escaped; \b \f \n \r \t named; the other
# bytes below 0x20 as \u00xx, lowercase; every other byte as it is. 0, or -1 when the builder can't grow.
#must_use
fn _pv_jw_str(sb, p, n): i64 {
    var rc = _pv_jw(sb, "\"");
    var run = 0;
    for (var i = 0; i < n; i = i + 1) {
        var c = load8(p + i);
        if (c == 34 || c == 92 || c < 32) {
            rc = rc | _pv_jw_n(sb, p + run, i - run);
            if (c == 34) {
                rc = rc | _pv_jw(sb, "\\\"");
            } elif (c == 92) {
                rc = rc | _pv_jw(sb, "\\\\");
            } elif (c == 8) {
                rc = rc | _pv_jw(sb, "\\b");
            } elif (c == 12) {
                rc = rc | _pv_jw(sb, "\\f");
            } elif (c == 10) {
                rc = rc | _pv_jw(sb, "\\n");
            } elif (c == 13) {
                rc = rc | _pv_jw(sb, "\\r");
            } elif (c == 9) {
                rc = rc | _pv_jw(sb, "\\t");
            } else {
                var e[8];
                store8(&e, 92);
                store8(&e + 1, 117);
                store8(&e + 2, 48);
                store8(&e + 3, 48);
                var hi = c >> 4;
                var lo = c & 15;
                store8(&e + 4, 48 + hi);
                if (lo < 10) { store8(&e + 5, 48 + lo); } else { store8(&e + 5, 87 + lo); }
                rc = rc | _pv_jw_n(sb, &e, 6);
            }
            run = i + 1;
        }
    }
    rc = rc | _pv_jw_n(sb, p + run, n - run);
    return rc | _pv_jw(sb, "\"");
}

# 1 when the n bytes at p are UTF-8 (strict: no overlong form, surrogate or code point past U+10FFFF) and no string
# in them holds a raw byte below 0x20; else 0.
#must_use
fn _pv_jr_text_ok(p, n): i64 {
    var i = 0;
    var instr = 0;
    while (i < n) {
        var c = load8(p + i);
        if (c >= 128) {
            var cp, len = _pv_utf8_next(p + i, n - i);
            if (cp < 0) { return 0; }
            i = i + len;
        } elif (instr == 1 && c < 32) {
            return 0;
        } elif (instr == 1 && c == 92) {
            # An escape: its byte is the parser's to check (`\"` keeps the string open).
            i = i + 2;
        } else {
            if (c == 34) { instr = 1 - instr; }
            i = i + 1;
        }
    }
    return 1;
}

# A JSON string node's bytes into *w (pointer) and *(w + 8) (length): 1, or 0 for anything else.
fn _pv_jr_str(v, w): i64 {
    if (v == 0 || bayan_json_v_tag(v) != JTAG_STR) { return 0; }
    var s = bayan_json_v_str(v);
    store64(w, str_data(s));
    store64(w + 8, str_len(s));
    return 1;
}

impl PvDaimonConfig {
    # Appends the config as serde_json writes a `DaimonConfig`: 0, or -1 when the builder can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        var rc = _pv_jw(sb, "{");
        rc = rc | _pv_jw_key(sb, "endpoint", 1);
        rc = rc | _pv_jw_str(sb, self.endpoint, self.endpoint_len);
        rc = rc | _pv_jw_key(sb, "api_key", 0);
        if (self.api_key == 0) {
            rc = rc | _pv_jw(sb, "null");
        } else {
            rc = rc | _pv_jw_str(sb, self.api_key, self.api_key_len);
        }
        return rc | _pv_jw(sb, "}");
    }
}

# Reads a `DaimonConfig` document into *out, which then owns copies of its strings (release them with
# PvDaimonConfig_drop; *out's old strings are not released). Ok(0); Err(PV_ERR_DESERIALIZE), or
# Err(PV_ERR_OUT_OF_MEMORY) when a copy can't be allocated, with *out untouched.
#must_use
fn PvDaimonConfig_from_json(buf, len, out: *PvDaimonConfig): Result {
    if (_pv_jr_text_ok(buf, len) == 0) { return Err(PV_ERR_DESERIALIZE); }
    var v = _pv_jr_parse(buf, len);
    var f = _pv_jr_form(v, 2);
    if (f == 0) { return Err(PV_ERR_DESERIALIZE); }
    var w[32];
    if (_pv_jr_str(_pv_jr_at(v, f, 0, "endpoint"), &w) == 0) { return Err(PV_ERR_DESERIALIZE); }
    var k = _pv_jr_at(v, f, 1, "api_key");
    var has = 0;
    if (k != 0 && bayan_json_v_tag(k) != JTAG_NULL) {
        if (_pv_jr_str(k, &w + 16) == 0) { return Err(PV_ERR_DESERIALIZE); }
        has = 1;
    }
    var ed = _pv_ai_copy(load64(&w), load64(&w + 8));
    if (ed == 0) { return Err(PV_ERR_OUT_OF_MEMORY); }
    var kd = 0;
    var kl = 0;
    if (has == 1) {
        kl = load64(&w + 24);
        kd = _pv_ai_copy(load64(&w + 16), kl);
        if (kd == 0) {
            fl_free(ed);
            return Err(PV_ERR_OUT_OF_MEMORY);
        }
    }
    out.endpoint = ed;
    out.endpoint_len = load64(&w + 8);
    out.api_key = kd;
    out.api_key_len = kl;
    out.owned = _PV_AI_OWN_ENDPOINT | (has * _PV_AI_OWN_KEY);
    return Ok(0);
}

impl PvHooshConfig {
    # Appends the config as serde_json writes a `HooshConfig`: 0, or -1 when the builder can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        var rc = _pv_jw(sb, "{");
        rc = rc | _pv_jw_key(sb, "endpoint", 1);
        rc = rc | _pv_jw_str(sb, self.endpoint, self.endpoint_len);
        return rc | _pv_jw(sb, "}");
    }
}

# Reads a `HooshConfig` document into *out, as PvDaimonConfig_from_json does.
#must_use
fn PvHooshConfig_from_json(buf, len, out: *PvHooshConfig): Result {
    if (_pv_jr_text_ok(buf, len) == 0) { return Err(PV_ERR_DESERIALIZE); }
    var v = _pv_jr_parse(buf, len);
    var f = _pv_jr_form(v, 1);
    if (f == 0) { return Err(PV_ERR_DESERIALIZE); }
    var w[16];
    if (_pv_jr_str(_pv_jr_at(v, f, 0, "endpoint"), &w) == 0) { return Err(PV_ERR_DESERIALIZE); }
    var ed = _pv_ai_copy(load64(&w), load64(&w + 8));
    if (ed == 0) { return Err(PV_ERR_OUT_OF_MEMORY); }
    out.endpoint = ed;
    out.endpoint_len = load64(&w + 8);
    out.owned = _PV_AI_OWN_ENDPOINT;
    return Ok(0);
}

# --- fmtf.cyr ---

# fmtf.cyr — f64 and f32 to text, as Rust's `{:?}` writes them (M8 part d).
#
# Rust's Debug for a float prints the SHORTEST digits that parse back to the same value, choosing the closest to the
# exact value among them, and on an exact tie between two closest candidates the upper one (core's Grisu with its
# Dragon fallback: 2^-25 is 2.9802322387695313e-8). The digits are positional with at least one fractional digit
# (`1.0`, `0.0001`, `9999999999999998.0`) unless the value is nonzero and below 1e-4 or at least 1e16, which take
# the exponential form (`1e16`, `9.999999999999999e-5`, `5e-324`); NaN is `NaN` with no sign, and ±∞ `inf`, `-inf`.
# An f32 is printed as an f32: its own shortest digits and thresholds.
#
# The digits come from Burger & Dybvig's free-format algorithm ("Printing Floating-Point Numbers Quickly and
# Accurately", 1996) on a small bignum: exact, with no tables. It is impetus's src/fmtf.cyr (ADR 0010 there), with
# the f32 case added and every write returning 0, or -1 when the builder can't grow. tests/golden/debug.tsv pins both
# printers against Rust over the specials, the powers of ten and of two with their neighbours, the thresholds, and
# seeded sweeps. Printing is never on the step path.
#
# UPSTREAM(L16): cyrius:docs/development/issues/2026-11-13-derive-debug-and-shortest-float-digits.md

# ── bignum ──────────────────────────────────────────────────────────────────────────
# A non-negative integer in 32-bit limbs, little-endian: word 0 the limb count, words 1..40 the limbs. 40 limbs hold
# 2^1280; the algorithm's values stay below 2^1140 for an f64 and far below for an f32. No leading zero limbs.

# a := v, for 0 <= v < 2^63.
fn _pv_bn_set(a, v) {
    var n = 0;
    var x = v;
    while (x != 0) {
        store64(a + 8 + n * 8, x & 0xFFFFFFFF);
        x = x >> 32;
        n = n + 1;
    }
    store64(a, n);
    return 0;
}

# dst := src.
fn _pv_bn_copy(dst, src) {
    var n = load64(src);
    for (var i = 0; i <= n; i = i + 1) { store64(dst + i * 8, load64(src + i * 8)); }
    return 0;
}

# a := a × m, for 0 < m < 2^31.
fn _pv_bn_mul_small(a, m) {
    var n = load64(a);
    var carry = 0;
    for (var i = 0; i < n; i = i + 1) {
        var t = load64(a + 8 + i * 8) * m + carry;
        store64(a + 8 + i * 8, t & 0xFFFFFFFF);
        carry = t >> 32;
    }
    while (carry != 0) {
        store64(a + 8 + n * 8, carry & 0xFFFFFFFF);
        carry = carry >> 32;
        n = n + 1;
    }
    store64(a, n);
    return 0;
}

# a := a × 10^k, for k >= 0 (in steps of 10^9).
fn _pv_bn_mul_pow10(a, k) {
    var left = k;
    while (left >= 9) {
        _pv_bn_mul_small(a, 1000000000);
        left = left - 9;
    }
    var m = 1;
    for (var i = 0; i < left; i = i + 1) { m = m * 10; }
    if (m > 1) { _pv_bn_mul_small(a, m); }
    return 0;
}

# a := a × 2^k, for k >= 0.
fn _pv_bn_shl(a, k) {
    var n = load64(a);
    if (n == 0) { return 0; }
    var q = k / 32;
    var b = k % 32;
    if (b != 0) {
        var carry = 0;
        for (var i = 0; i < n; i = i + 1) {
            var t = (load64(a + 8 + i * 8) << b) | carry;
            store64(a + 8 + i * 8, t & 0xFFFFFFFF);
            carry = t >> 32;
        }
        if (carry != 0) {
            store64(a + 8 + n * 8, carry);
            n = n + 1;
        }
    }
    if (q > 0) {
        var i = n - 1;
        while (i >= 0) {
            store64(a + 8 + (i + q) * 8, load64(a + 8 + i * 8));
            i = i - 1;
        }
        for (var j = 0; j < q; j = j + 1) { store64(a + 8 + j * 8, 0); }
        n = n + q;
    }
    store64(a, n);
    return 0;
}

# dst := a + b (dst distinct from both).
fn _pv_bn_sum(dst, a, b) {
    var na = load64(a);
    var nb = load64(b);
    var n = na;
    if (nb > n) { n = nb; }
    var carry = 0;
    for (var i = 0; i < n; i = i + 1) {
        var x = 0;
        var y = 0;
        if (i < na) { x = load64(a + 8 + i * 8); }
        if (i < nb) { y = load64(b + 8 + i * 8); }
        var t = x + y + carry;
        store64(dst + 8 + i * 8, t & 0xFFFFFFFF);
        carry = t >> 32;
    }
    if (carry != 0) {
        store64(dst + 8 + n * 8, carry);
        n = n + 1;
    }
    store64(dst, n);
    return 0;
}

# -1, 0 or 1 as a < b, a = b, a > b.
#must_use
fn _pv_bn_cmp(a, b): i64 {
    var na = load64(a);
    var nb = load64(b);
    if (na != nb) {
        if (na < nb) { return 0 - 1; }
        return 1;
    }
    var i = na - 1;
    while (i >= 0) {
        var x = load64(a + 8 + i * 8);
        var y = load64(b + 8 + i * 8);
        if (x != y) {
            if (x < y) { return 0 - 1; }
            return 1;
        }
        i = i - 1;
    }
    return 0;
}

# a := a − b, for a >= b.
fn _pv_bn_sub(a, b) {
    var na = load64(a);
    var nb = load64(b);
    var borrow = 0;
    for (var i = 0; i < na; i = i + 1) {
        var y = 0;
        if (i < nb) { y = load64(b + 8 + i * 8); }
        var t = load64(a + 8 + i * 8) - y - borrow;
        borrow = 0;
        if (t < 0) {
            t = t + 0x100000000;
            borrow = 1;
        }
        store64(a + 8 + i * 8, t);
    }
    while (na > 0 && load64(a + na * 8) == 0) { na = na - 1; }
    store64(a, na);
    return 0;
}

# The number of bits in x > 0.
#must_use
fn _pv_bitlen(x): i64 {
    var n = 0;
    var v = x;
    while (v != 0) {
        v = v >> 1;
        n = n + 1;
    }
    return n;
}

# ── shortest digits (Burger & Dybvig, free format) ──────────────────────────────────

# The shortest decimal digits of the positive finite value f × 2^e that read back to it in its format, the closest
# to its exact value among them, an exact tie between two going up (core's printer). `hidden` is the format's hidden
# bit (2^52, 2^23) and `emin` its least exponent (-1074, -149): f = hidden with e > emin is a power of two, whose
# lower neighbour is half as far. Writes the ASCII digits to `digits` (17 bytes is enough) and returns (n, k), with
# value = 0.d1d2…dn × 10^k.
fn _pv_shortest(f, e, hidden, emin, digits) {
    # IEEE round-half-even on reading: the interval's ends belong to it when f is even.
    var even = 1 - (f & 1);
    var r[328];
    var s[328];
    var mp[328];
    var mm[328];
    var t[328];
    if (e >= 0) {
        if (f != hidden) {
            _pv_bn_set(&r, f);
            _pv_bn_shl(&r, e + 1);
            _pv_bn_set(&s, 2);
            _pv_bn_set(&mp, 1);
            _pv_bn_shl(&mp, e);
            _pv_bn_copy(&mm, &mp);
        } else {
            _pv_bn_set(&r, f);
            _pv_bn_shl(&r, e + 2);
            _pv_bn_set(&s, 4);
            _pv_bn_set(&mp, 1);
            _pv_bn_shl(&mp, e + 1);
            _pv_bn_set(&mm, 1);
            _pv_bn_shl(&mm, e);
        }
    } else {
        if (e == emin || f != hidden) {
            _pv_bn_set(&r, f);
            _pv_bn_shl(&r, 1);
            _pv_bn_set(&s, 1);
            _pv_bn_shl(&s, 1 - e);
            _pv_bn_set(&mp, 1);
            _pv_bn_set(&mm, 1);
        } else {
            _pv_bn_set(&r, f);
            _pv_bn_shl(&r, 2);
            _pv_bn_set(&s, 1);
            _pv_bn_shl(&s, 2 - e);
            _pv_bn_set(&mp, 2);
            _pv_bn_set(&mm, 1);
        }
    }
    # k = ⌈log10(v) − 1e-10⌉ from the binary exponent: never too large, at most one too small (the fixup below adds
    # the one).
    var lg: f64 = f64_from(e + _pv_bitlen(f) - 1);
    var est: f64 = lg * 0.30102999566398114 - 0.0000000001;
    var k = f64_to(f64_ceil(est));
    if (k >= 0) {
        _pv_bn_mul_pow10(&s, k);
    } else {
        _pv_bn_mul_pow10(&r, 0 - k);
        _pv_bn_mul_pow10(&mp, 0 - k);
        _pv_bn_mul_pow10(&mm, 0 - k);
    }
    _pv_bn_sum(&t, &r, &mp);
    var c = _pv_bn_cmp(&t, &s);
    if ((even == 1 && c >= 0) || (even == 0 && c > 0)) {
        _pv_bn_mul_small(&s, 10);
        k = k + 1;
    }
    var n = 0;
    while (1) {
        _pv_bn_mul_small(&r, 10);
        _pv_bn_mul_small(&mp, 10);
        _pv_bn_mul_small(&mm, 10);
        var d = 0;
        while (_pv_bn_cmp(&r, &s) >= 0) {
            _pv_bn_sub(&r, &s);
            d = d + 1;
        }
        var lo = _pv_bn_cmp(&r, &mm);
        var tc1 = 0;
        if (lo < 0 || (even == 1 && lo == 0)) { tc1 = 1; }
        _pv_bn_sum(&t, &r, &mp);
        var hi = _pv_bn_cmp(&t, &s);
        var tc2 = 0;
        if (hi > 0 || (even == 1 && hi == 0)) { tc2 = 1; }
        if (tc1 == 0 && tc2 == 0) {
            store8(digits + n, 48 + d);
            n = n + 1;
        } else {
            if (tc1 == 1 && tc2 == 1) {
                # Both neighbours read back: the closer one, 2r against s; a tie goes up.
                _pv_bn_copy(&t, &r);
                _pv_bn_shl(&t, 1);
                if (_pv_bn_cmp(&t, &s) >= 0) { d = d + 1; }
            } elif (tc2 == 1) {
                d = d + 1;
            }
            store8(digits + n, 48 + d);
            n = n + 1;
            return (n, k);
        }
    }
    return (n, k);
}

# ── Rust's Debug form ───────────────────────────────────────────────────────────────

# Appends 0.d1…dn × 10^k (negative when `neg` is 1) as core's Debug writes it: positional with at least one
# fractional digit, or with `expo` 1 the exponential form d1.d2…dn e(k−1). 0, or -1 when the builder can't grow.
#must_use
fn _pv_dbg_digits(sb, neg, digits, n, k, expo): i64 {
    var out[400];
    var len = 0;
    if (neg == 1) {
        store8(&out, 45);
        len = 1;
    }
    if (expo == 1) {
        store8(&out + len, load8(digits));
        len = len + 1;
        if (n > 1) {
            store8(&out + len, 46);
            len = len + 1;
            for (var i = 1; i < n; i = i + 1) {
                store8(&out + len, load8(digits + i));
                len = len + 1;
            }
        }
        store8(&out + len, 101);
        len = len + 1;
        var rc = _pv_jw_n(sb, &out, len);
        return rc | _pv_jw_int(sb, k - 1);
    }
    if (k <= 0) {
        store8(&out + len, 48);
        store8(&out + len + 1, 46);
        len = len + 2;
        for (var z = 0; z < 0 - k; z = z + 1) {
            store8(&out + len, 48);
            len = len + 1;
        }
        for (var i = 0; i < n; i = i + 1) {
            store8(&out + len, load8(digits + i));
            len = len + 1;
        }
    } elif (k >= n) {
        for (var i = 0; i < n; i = i + 1) {
            store8(&out + len, load8(digits + i));
            len = len + 1;
        }
        for (var z = 0; z < k - n; z = z + 1) {
            store8(&out + len, 48);
            len = len + 1;
        }
        store8(&out + len, 46);
        store8(&out + len + 1, 48);
        len = len + 2;
    } else {
        for (var i = 0; i < k; i = i + 1) {
            store8(&out + len, load8(digits + i));
            len = len + 1;
        }
        store8(&out + len, 46);
        len = len + 1;
        for (var i = k; i < n; i = i + 1) {
            store8(&out + len, load8(digits + i));
            len = len + 1;
        }
    }
    return _pv_jw_n(sb, &out, len);
}

# Appends x as Rust's `{:?}` (and `{:#?}`) writes an f64. 0, or -1 when the builder can't grow. Mirrors
# `<f64 as Debug>::fmt`.
#must_use
fn _pv_debug_f64(sb, x: f64): i64 {
    if (x != x) { return _pv_jw(sb, "NaN"); }
    var bits = _pv_bits(x);
    var neg = 0;
    if (bits < 0) { neg = 1; }
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    if (mag == 0x7FF0000000000000) {
        if (neg == 1) { return _pv_jw(sb, "-inf"); }
        return _pv_jw(sb, "inf");
    }
    if (mag == 0) {
        if (neg == 1) { return _pv_jw(sb, "-0.0"); }
        return _pv_jw(sb, "0.0");
    }
    var be = (mag >> 52) & 0x7FF;
    var f = mag & 0xFFFFFFFFFFFFF;
    var e = 0 - 1074;
    if (be != 0) {
        f = f | 0x10000000000000;
        e = be - 1075;
    }
    var digits[24];
    var n, k = _pv_shortest(f, e, 0x10000000000000, 0 - 1074, &digits);
    var ax: f64 = x;
    if (neg == 1) { ax = -x; }
    var expo = 0;
    if (ax < 0.0001 || ax >= 10000000000000000.0) { expo = 1; }
    return _pv_dbg_digits(sb, neg, &digits, n, k, expo);
}

# The 32 bits of an f32.
#must_use
fn _pv_f32_word(x: f32): i64 {
    var buf[8];
    store64(&buf, 0);
    var b: *f32 = _pv_as_f32s(&buf);
    b[0] = x;
    return load64(&buf) & 0xFFFFFFFF;
}

# Appends x as Rust's `{:?}` (and `{:#?}`) writes an f32: its own shortest digits, and the exponential form below
# 1e-4f32 or from 1e16f32. 0, or -1 when the builder can't grow. Mirrors `<f32 as Debug>::fmt`.
#must_use
fn _pv_debug_f32(sb, x: f32): i64 {
    var w = _pv_f32_word(x);
    var neg = (w >> 31) & 1;
    var mag = w & 0x7FFFFFFF;
    if (mag > 0x7F800000) { return _pv_jw(sb, "NaN"); }
    if (mag == 0x7F800000) {
        if (neg == 1) { return _pv_jw(sb, "-inf"); }
        return _pv_jw(sb, "inf");
    }
    if (mag == 0) {
        if (neg == 1) { return _pv_jw(sb, "-0.0"); }
        return _pv_jw(sb, "0.0");
    }
    var be = (mag >> 23) & 0xFF;
    var f = mag & 0x7FFFFF;
    var e = 0 - 149;
    if (be != 0) {
        f = f | 0x800000;
        e = be - 150;
    }
    var digits[24];
    var n, k = _pv_shortest(f, e, 0x800000, 0 - 149, &digits);
    # The thresholds as f32s (1e-4f32 and 1e16f32), compared on the magnitude's bits: both are positive, so their
    # bit patterns order as their values.
    var expo = 0;
    if (mag < _pv_f32_word(f32_from(0.0001)) || mag >= _pv_f32_word(f32_from(10000000000000000.0))) { expo = 1; }
    return _pv_dbg_digits(sb, neg, &digits, n, k, expo);
}

# --- debug.cyr ---

# debug.cyr — Rust's derived `Debug` for the public types (M8 part d): `x.debug(sb, alternate)` appends `{:?}`
# (alternate 0) or `{:#?}` (1), and returns 0, or -1 when the builder can't grow.
#
# The derive's shapes, as core's builders write them:
# - a struct is `Name { a: 1.0, b: 2 }`, and pretty `Name {\n    a: 1.0,\n    b: 2,\n}`; a unit struct is its name;
# - a tuple struct (glam's `DVec3`) is `DVec3(1.0, 2.0, 3.0)`, and pretty one element a line, each with a comma;
# - a `Vec` or an array is `[1.0, 2.0]`, and pretty one element a line; empty, it is `[]` in both forms;
# - a unit variant is its name, and a variant with fields is a struct named after the variant;
# - in the pretty form a nested value's lines are indented four more spaces (core's `PadAdapter`).
# A float is Rust's shortest text (src/fmtf.cyr), an f32 as an f32; an integer is decimal; a bool `true` or `false`.
# Every field Rust declares is printed in its order, private scratch included; the port's own extras (the DST
# plans, the solve buffers, the thread count) are not. A kind word outside its enum, which Rust can't hold, prints
# as `Unknown`.
#
# `PravashError` has no counterpart: a 2.0 error is a code with no payload (ADR 0002 #1), and `pv_error_name(code)`
# gives its variant's name. The ai configs' Debug is in src/ai.cyr.
#
# UPSTREAM(L16): cyrius:docs/development/issues/2026-11-13-derive-debug-and-shortest-float-digits.md

# ── the builders ────────────────────────────────────────────────────────────────────

# 4 × depth spaces.
#must_use
fn _pv_dd_indent(sb, depth): i64 {
    var rc = 0;
    for (var i = 0; i < depth; i = i + 1) { rc = rc | _pv_jw(sb, "    "); }
    return rc;
}

# Opens a struct: `Name {` (pretty `Name {` and a newline).
#must_use
fn _pv_dd_open(sb, name, alt): i64 {
    var rc = _pv_jw(sb, name);
    if (alt == 0) { return rc | _pv_jw(sb, " {"); }
    return rc | _pv_jw(sb, " {\n");
}

# A field's name, before its value: ` a: `, or `, a: ` after the first (pretty: the indent of depth + 1, `a: `).
#must_use
fn _pv_dd_field(sb, name, alt, depth, first): i64 {
    var rc = 0;
    if (alt == 1) {
        rc = _pv_dd_indent(sb, depth + 1);
    } elif (first == 1) {
        rc = _pv_jw(sb, " ");
    } else {
        rc = _pv_jw(sb, ", ");
    }
    rc = rc | _pv_jw(sb, name);
    return rc | _pv_jw(sb, ": ");
}

# After a field's value: nothing (pretty `,` and a newline).
#must_use
fn _pv_dd_end(sb, alt): i64 {
    if (alt == 0) { return 0; }
    return _pv_jw(sb, ",\n");
}

# Closes a struct: ` }` (pretty: the indent of depth, `}`).
#must_use
fn _pv_dd_close(sb, alt, depth): i64 {
    if (alt == 0) { return _pv_jw(sb, " }"); }
    return _pv_dd_indent(sb, depth) | _pv_jw(sb, "}");
}

# Opens a tuple or a list of n items with `text` (`DVec3(`, `[`); pretty adds a newline unless n is 0.
#must_use
fn _pv_dd_seq_open(sb, text, alt, n): i64 {
    var rc = _pv_jw(sb, text);
    if (alt == 1 && n > 0) { rc = rc | _pv_jw(sb, "\n"); }
    return rc;
}

# Before item i: `, ` after the first (pretty: the indent of depth + 1).
#must_use
fn _pv_dd_item(sb, alt, depth, i): i64 {
    if (alt == 1) { return _pv_dd_indent(sb, depth + 1); }
    if (i == 0) { return 0; }
    return _pv_jw(sb, ", ");
}

# Closes a tuple or a list of n items with `text` (`)`, `]`); pretty, when n > 0, after the indent of depth.
#must_use
fn _pv_dd_seq_close(sb, text, alt, depth, n): i64 {
    if (alt == 1 && n > 0) { return _pv_dd_indent(sb, depth) | _pv_jw(sb, text); }
    return _pv_jw(sb, text);
}

# ── values ──────────────────────────────────────────────────────────────────────────

# `true` for a nonzero word, `false` for 0.
#must_use
fn _pv_dd_bool(sb, w): i64 {
    if (w != 0) { return _pv_jw(sb, "true"); }
    return _pv_jw(sb, "false");
}

# The n f64 words at p as a list.
#must_use
fn _pv_dd_f64s(sb, p, n, alt, depth): i64 {
    var rc = _pv_dd_seq_open(sb, "[", alt, n);
    for (var i = 0; i < n; i = i + 1) {
        rc = rc | _pv_dd_item(sb, alt, depth, i);
        var x: f64 = load64(p + i * 8);
        rc = rc | _pv_debug_f64(sb, x);
        rc = rc | _pv_dd_end(sb, alt);
    }
    return rc | _pv_dd_seq_close(sb, "]", alt, depth, n);
}

# The n integer words at p as a list.
#must_use
fn _pv_dd_words(sb, p, n, alt, depth): i64 {
    var rc = _pv_dd_seq_open(sb, "[", alt, n);
    for (var i = 0; i < n; i = i + 1) {
        rc = rc | _pv_dd_item(sb, alt, depth, i);
        rc = rc | _pv_jw_int(sb, load64(p + i * 8));
        rc = rc | _pv_dd_end(sb, alt);
    }
    return rc | _pv_dd_seq_close(sb, "]", alt, depth, n);
}

# The n f32 elements at p as a list.
#must_use
fn _pv_dd_f32s(sb, p, n, alt, depth): i64 {
    var rc = _pv_dd_seq_open(sb, "[", alt, n);
    var b: *f32 = _pv_as_f32s(p);
    for (var i = 0; i < n; i = i + 1) {
        rc = rc | _pv_dd_item(sb, alt, depth, i);
        var x: f32 = b[i];
        rc = rc | _pv_debug_f32(sb, x);
        rc = rc | _pv_dd_end(sb, alt);
    }
    return rc | _pv_dd_seq_close(sb, "]", alt, depth, n);
}

# A `DVec3` as glam's Debug writes it: `DVec3(x, y, z)`.
#must_use
fn _pv_dd_vec3(sb, v: PvVec3, alt, depth): i64 {
    var w[24];
    store64(&w, _pv_bits(v.x));
    store64(&w + 8, _pv_bits(v.y));
    store64(&w + 16, _pv_bits(v.z));
    var rc = _pv_dd_seq_open(sb, "DVec3(", alt, 3);
    for (var i = 0; i < 3; i = i + 1) {
        rc = rc | _pv_dd_item(sb, alt, depth, i);
        var x: f64 = load64(&w + i * 8);
        rc = rc | _pv_debug_f64(sb, x);
        rc = rc | _pv_dd_end(sb, alt);
    }
    return rc | _pv_dd_seq_close(sb, ")", alt, depth, 3);
}

# ── fields ──────────────────────────────────────────────────────────────────────────

# An f64 field.
#must_use
fn _pv_dd_ff(sb, name, x: f64, alt, depth, first): i64 {
    var rc = _pv_dd_field(sb, name, alt, depth, first);
    rc = rc | _pv_debug_f64(sb, x);
    return rc | _pv_dd_end(sb, alt);
}

# An f32 field.
#must_use
fn _pv_dd_f32f(sb, name, x: f32, alt, depth, first): i64 {
    var rc = _pv_dd_field(sb, name, alt, depth, first);
    rc = rc | _pv_debug_f32(sb, x);
    return rc | _pv_dd_end(sb, alt);
}

# An integer field.
#must_use
fn _pv_dd_if(sb, name, n, alt, depth, first): i64 {
    var rc = _pv_dd_field(sb, name, alt, depth, first);
    rc = rc | _pv_jw_int(sb, n);
    return rc | _pv_dd_end(sb, alt);
}

# A bool field.
#must_use
fn _pv_dd_bf(sb, name, w, alt, depth, first): i64 {
    var rc = _pv_dd_field(sb, name, alt, depth, first);
    rc = rc | _pv_dd_bool(sb, w);
    return rc | _pv_dd_end(sb, alt);
}

# A field holding a unit variant, printed as `text`.
#must_use
fn _pv_dd_tf(sb, name, text, alt, depth, first): i64 {
    var rc = _pv_dd_field(sb, name, alt, depth, first);
    rc = rc | _pv_jw(sb, text);
    return rc | _pv_dd_end(sb, alt);
}

# A `Vec<f64>` field.
#must_use
fn _pv_dd_cf(sb, name, c: *PvColumn, alt, depth, first): i64 {
    var rc = _pv_dd_field(sb, name, alt, depth, first);
    rc = rc | _pv_dd_f64s(sb, c.data, c.len, alt, depth + 1);
    return rc | _pv_dd_end(sb, alt);
}

# A `Vec<f32>` field.
#must_use
fn _pv_dd_c32f(sb, name, c: *PvF32Column, alt, depth, first): i64 {
    var rc = _pv_dd_field(sb, name, alt, depth, first);
    rc = rc | _pv_dd_f32s(sb, c.data, c.len, alt, depth + 1);
    return rc | _pv_dd_end(sb, alt);
}

# A `DVec3` field.
#must_use
fn _pv_dd_vf(sb, name, v: PvVec3, alt, depth, first): i64 {
    var rc = _pv_dd_field(sb, name, alt, depth, first);
    rc = rc | _pv_dd_vec3(sb, v, alt, depth + 1);
    return rc | _pv_dd_end(sb, alt);
}

# An `[f64; n]` field from n words at p.
#must_use
fn _pv_dd_af(sb, name, p, n, alt, depth, first): i64 {
    var rc = _pv_dd_field(sb, name, alt, depth, first);
    rc = rc | _pv_dd_f64s(sb, p, n, alt, depth + 1);
    return rc | _pv_dd_end(sb, alt);
}

# ── common ──────────────────────────────────────────────────────────────────────────

#must_use
fn _pv_dd_material(m: *PvFluidMaterial, sb, alt, depth): i64 {
    var rc = _pv_dd_open(sb, "FluidMaterial", alt);
    rc = rc | _pv_dd_ff(sb, "density", m.density, alt, depth, 1);
    rc = rc | _pv_dd_ff(sb, "viscosity", m.viscosity, alt, depth, 0);
    rc = rc | _pv_dd_ff(sb, "surface_tension", m.surface_tension, alt, depth, 0);
    rc = rc | _pv_dd_ff(sb, "speed_of_sound", m.speed_of_sound, alt, depth, 0);
    return rc | _pv_dd_close(sb, alt, depth);
}

impl PvFluidMaterial {
    # Appends Rust's `{:?}` (alternate 0) or `{:#?}` (1). 0, or -1 when the builder can't grow. Mirrors the derived
    # `Debug`.
    #must_use
    fn debug(self, sb, alternate): i64 {
        return _pv_dd_material(self, sb, alternate, 0);
    }
}

#must_use
fn _pv_dd_particle(p: *PvFluidParticle, sb, alt, depth): i64 {
    var conf[24];
    store64(&conf, _pv_bits(p.conformation.0));
    store64(&conf + 8, _pv_bits(p.conformation.1));
    store64(&conf + 16, _pv_bits(p.conformation.2));
    var rc = _pv_dd_open(sb, "FluidParticle", alt);
    rc = rc | _pv_dd_vf(sb, "position", p.position, alt, depth, 1);
    rc = rc | _pv_dd_vf(sb, "velocity", p.velocity, alt, depth, 0);
    rc = rc | _pv_dd_vf(sb, "acceleration", p.acceleration, alt, depth, 0);
    rc = rc | _pv_dd_ff(sb, "density", p.density, alt, depth, 0);
    rc = rc | _pv_dd_ff(sb, "pressure", p.pressure, alt, depth, 0);
    rc = rc | _pv_dd_ff(sb, "mass", p.mass, alt, depth, 0);
    rc = rc | _pv_dd_if(sb, "phase", p.phase, alt, depth, 0);
    rc = rc | _pv_dd_af(sb, "conformation", &conf, 3, alt, depth, 0);
    rc = rc | _pv_dd_ff(sb, "temperature", p.temperature, alt, depth, 0);
    rc = rc | _pv_dd_ff(sb, "fuel", p.fuel, alt, depth, 0);
    return rc | _pv_dd_close(sb, alt, depth);
}

impl PvFluidParticle {
    # Appends Rust's `{:?}` (alternate 0) or `{:#?}` (1). 0, or -1 when the builder can't grow. Mirrors the derived
    # `Debug`.
    #must_use
    fn debug(self, sb, alternate): i64 {
        return _pv_dd_particle(self, sb, alternate, 0);
    }
}

# The name of a `ParticleSoa` column, in declaration order (`_pv_soa_col`'s).
#must_use
fn _pv_dd_soa_name(k): i64 {
    match k {
        0 => { return "pos_x"; }
        1 => { return "pos_y"; }
        2 => { return "pos_z"; }
        3 => { return "vel_x"; }
        4 => { return "vel_y"; }
        5 => { return "vel_z"; }
        6 => { return "accel_x"; }
        7 => { return "accel_y"; }
        8 => { return "accel_z"; }
        9 => { return "density"; }
        10 => { return "pressure"; }
        11 => { return "mass"; }
        12 => { return "phase"; }
        13 => { return "conf_xx"; }
        14 => { return "conf_xy"; }
        15 => { return "conf_yy"; }
        16 => { return "temperature"; }
        17 => { return "fuel"; }
        _ => { return ""; }
    }
    return "";
}

impl PvParticleSoa {
    # Appends Rust's `{:?}` (alternate 0) or `{:#?}` (1): the 18 columns, `phase` as integers. 0, or -1 when the
    # builder can't grow. Mirrors the derived `Debug`.
    #must_use
    fn debug(self, sb, alternate): i64 {
        var rc = _pv_dd_open(sb, "ParticleSoa", alternate);
        for (var k = 0; k < _PV_SOA_COLUMNS; k = k + 1) {
            var first = 0;
            if (k == 0) { first = 1; }
            var c: *PvColumn = _pv_soa_col(self, k);
            if (k == 12) {
                rc = rc | _pv_dd_field(sb, _pv_dd_soa_name(k), alternate, 0, first);
                rc = rc | _pv_dd_words(sb, c.data, c.len, alternate, 1);
                rc = rc | _pv_dd_end(sb, alternate);
            } else {
                rc = rc | _pv_dd_cf(sb, _pv_dd_soa_name(k), c, alternate, 0, first);
            }
        }
        return rc | _pv_dd_close(sb, alternate, 0);
    }
}

impl PvArenaHandle {
    # Appends Rust's `{:?}` (alternate 0) or `{:#?}` (1) of the private fields. 0, or -1 when the builder can't
    # grow. Mirrors the derived `Debug`.
    #must_use
    fn debug(self, sb, alternate): i64 {
        var rc = _pv_dd_open(sb, "ArenaHandle", alternate);
        rc = rc | _pv_dd_if(sb, "start", self.start, alternate, 0, 1);
        rc = rc | _pv_dd_if(sb, "len", self.len, alternate, 0, 0);
        rc = rc | _pv_dd_if(sb, "generation", self.generation, alternate, 0, 0);
        return rc | _pv_dd_close(sb, alternate, 0);
    }
}

impl PvFluidConfig {
    # Appends Rust's `{:?}` (alternate 0) or `{:#?}` (1). 0, or -1 when the builder can't grow. Mirrors the derived
    # `Debug`.
    #must_use
    fn debug(self, sb, alternate): i64 {
        var rc = _pv_dd_open(sb, "FluidConfig", alternate);
        rc = rc | _pv_dd_ff(sb, "dt", self.dt, alternate, 0, 1);
        rc = rc | _pv_dd_vf(sb, "gravity", self.gravity, alternate, 0, 0);
        rc = rc | _pv_dd_ff(sb, "smoothing_radius", self.smoothing_radius, alternate, 0, 0);
        rc = rc | _pv_dd_ff(sb, "gas_constant", self.gas_constant, alternate, 0, 0);
        rc = rc | _pv_dd_ff(sb, "rest_density", self.rest_density, alternate, 0, 0);
        rc = rc | _pv_dd_vf(sb, "bounds_min", self.bounds_min, alternate, 0, 0);
        rc = rc | _pv_dd_vf(sb, "bounds_max", self.bounds_max, alternate, 0, 0);
        rc = rc | _pv_dd_ff(sb, "boundary_damping", self.boundary_damping, alternate, 0, 0);
        return rc | _pv_dd_close(sb, alternate, 0);
    }
}

# ── buoyancy, shallow ───────────────────────────────────────────────────────────────

# Appends Rust's Debug of the unit struct `DragCoefficient`: its name, in both forms. 0, or -1 when the builder
# can't grow. Mirrors the derived `Debug`.
#must_use
fn drag_coefficient_debug(sb, alternate): i64 {
    return _pv_jw(sb, "DragCoefficient");
}

# Appends Rust's Debug of a flow regime: the variant's name, in both forms. 0, or -1 when the builder can't grow.
# Mirrors the derived `Debug`.
#must_use
fn flow_regime_debug(k, sb, alternate): i64 {
    return _pv_jw(sb, flow_regime_name(k));
}

impl PvShallowWater {
    # Appends Rust's `{:?}` (alternate 0) or `{:#?}` (1): every field, the five scratch buffers included. 0, or -1
    # when the builder can't grow. Mirrors the derived `Debug`.
    #must_use
    fn debug(self, sb, alternate): i64 {
        var rc = _pv_dd_open(sb, "ShallowWater", alternate);
        rc = rc | _pv_dd_if(sb, "nx", self.nx, alternate, 0, 1);
        rc = rc | _pv_dd_if(sb, "ny", self.ny, alternate, 0, 0);
        rc = rc | _pv_dd_ff(sb, "dx", self.dx, alternate, 0, 0);
        rc = rc | _pv_dd_cf(sb, "height", _pv_sw_col(self, 0), alternate, 0, 0);
        rc = rc | _pv_dd_cf(sb, "vx", _pv_sw_col(self, 1), alternate, 0, 0);
        rc = rc | _pv_dd_cf(sb, "vy", _pv_sw_col(self, 2), alternate, 0, 0);
        rc = rc | _pv_dd_cf(sb, "ground", _pv_sw_col(self, 3), alternate, 0, 0);
        rc = rc | _pv_dd_ff(sb, "gravity", self.gravity, alternate, 0, 0);
        rc = rc | _pv_dd_ff(sb, "damping", self.damping, alternate, 0, 0);
        rc = rc | _pv_dd_cf(sb, "manning_n", _pv_sw_col(self, 4), alternate, 0, 0);
        rc = rc | _pv_dd_ff(sb, "dry_threshold", self.dry_threshold, alternate, 0, 0);
        rc = rc | _pv_dd_ff(sb, "breaking_threshold", self.breaking_threshold, alternate, 0, 0);
        rc = rc | _pv_dd_ff(sb, "breaking_dissipation", self.breaking_dissipation, alternate, 0, 0);
        rc = rc | _pv_dd_ff(sb, "dispersion_coeff", self.dispersion_coeff, alternate, 0, 0);
        rc = rc | _pv_dd_bf(sb, "use_green_naghdi", self.use_green_naghdi, alternate, 0, 0);
        rc = rc | _pv_dd_bf(sb, "use_riemann", self.use_riemann, alternate, 0, 0);
        rc = rc | _pv_dd_cf(sb, "scratch_vx", _pv_sw_col(self, 5), alternate, 0, 0);
        rc = rc | _pv_dd_cf(sb, "scratch_vy", _pv_sw_col(self, 6), alternate, 0, 0);
        rc = rc | _pv_dd_cf(sb, "scratch_h", _pv_sw_col(self, 7), alternate, 0, 0);
        rc = rc | _pv_dd_cf(sb, "scratch_lap", _pv_sw_col(self, 8), alternate, 0, 0);
        rc = rc | _pv_dd_cf(sb, "scratch_line", _pv_sw_col(self, 9), alternate, 0, 0);
        return rc | _pv_dd_close(sb, alternate, 0);
    }
}

impl PvSedimentConfig {
