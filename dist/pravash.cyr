# ── sph ─────────────────────────────────────────────────────────────────────────────

# A phase's three properties from the three words at p.
#must_use
fn _pv_dd_phase(sb, p, alt, depth): i64 {
    var rd: f64 = load64(p);
    var gc: f64 = load64(p + 8);
    var mu: f64 = load64(p + 16);
    var rc = _pv_dd_open(sb, "PhaseProperties", alt);
    rc = rc | _pv_dd_ff(sb, "rest_density", rd, alt, depth, 1);
    rc = rc | _pv_dd_ff(sb, "gas_constant", gc, alt, depth, 0);
    rc = rc | _pv_dd_ff(sb, "viscosity", mu, alt, depth, 0);
    return rc | _pv_dd_close(sb, alt, depth);
}

impl PvPhaseProperties {
    # Appends Rust's `{:?}` (alternate 0) or `{:#?}` (1). 0, or -1 when the builder can't grow. Mirrors the derived
    # `Debug`.
    #must_use
    fn debug(self, sb, alternate): i64 {
        return _pv_dd_phase(sb, self, alternate, 0);
    }
}

impl PvMultiPhaseConfig {
    # Appends Rust's `{:?}` (alternate 0) or `{:#?}` (1): the phases as a list of `PhaseProperties`. 0, or -1 when
    # the builder can't grow. Mirrors the derived `Debug`.
    #must_use
    fn debug(self, sb, alternate): i64 {
        var n = self.phases.len / 3;
        var rc = _pv_dd_open(sb, "MultiPhaseConfig", alternate);
        rc = rc | _pv_dd_field(sb, "phases", alternate, 0, 1);
        rc = rc | _pv_dd_seq_open(sb, "[", alternate, n);
        for (var j = 0; j < n; j = j + 1) {
            rc = rc | _pv_dd_item(sb, alternate, 1, j);
            rc = rc | _pv_dd_phase(sb, self.phases.data + j * 24, alternate, 2);
            rc = rc | _pv_dd_end(sb, alternate);
        }
        rc = rc | _pv_dd_seq_close(sb, "]", alternate, 1, n);
        rc = rc | _pv_dd_end(sb, alternate);
        rc = rc | _pv_dd_ff(sb, "interface_tension", self.interface_tension, alternate, 0, 0);
        return rc | _pv_dd_close(sb, alternate, 0);
    }
}

impl PvViscoelasticConfig {
