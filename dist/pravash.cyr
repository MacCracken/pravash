impl PvShallowKernelParams {
    # Appends Rust's `{:?}` (alternate 0) or `{:#?}` (1). 0, or -1 when the builder can't grow. Mirrors the derived
    # `Debug`.
    #must_use
    fn debug(self, sb, alternate): i64 {
        var rc = _pv_dd_open(sb, "ShallowKernelParams", alternate);
        rc = rc | _pv_dd_if(sb, "nx", self.nx, alternate, 0, 1);
        rc = rc | _pv_dd_if(sb, "ny", self.ny, alternate, 0, 0);
        rc = rc | _pv_dd_f32f(sb, "dx", self.dx, alternate, 0, 0);
        rc = rc | _pv_dd_f32f(sb, "dt", self.dt, alternate, 0, 0);
        rc = rc | _pv_dd_f32f(sb, "gravity", self.gravity, alternate, 0, 0);
        rc = rc | _pv_dd_f32f(sb, "damping", self.damping, alternate, 0, 0);
        rc = rc | _pv_dd_f32f(sb, "dry_threshold", self.dry_threshold, alternate, 0, 0);
        return rc | _pv_dd_close(sb, alternate, 0);
    }
}

# Appends Rust's Debug of a compute operation: the variant's name, in both forms. 0, or -1 when the builder can't
# grow. Mirrors the derived `Debug`.
#must_use
fn compute_op_debug(k, sb, alternate): i64 {
    return _pv_jw(sb, compute_op_name(k));
}

impl PvNeuralCorrection {
    # Appends Rust's `{:?}` (alternate 0) or `{:#?}` (1), each buffer as its f32s. 0, or -1 when the builder can't
    # grow. Mirrors the derived `Debug`.
    #must_use
    fn debug(self, sb, alternate): i64 {
        var rc = _pv_dd_open(sb, "NeuralCorrection", alternate);
        rc = rc | _pv_dd_c32f(sb, "velocity_delta", _pv_as_f32_column(_pv_addr(self)), alternate, 0, 1);
        rc = rc | _pv_dd_c32f(sb, "pressure_delta", _pv_as_f32_column(_pv_addr(self) + 24), alternate, 0, 0);
        return rc | _pv_dd_close(sb, alternate, 0);
    }
}
