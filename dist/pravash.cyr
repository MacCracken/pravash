impl PvPackedParticles {
    # Appends Rust's `{:?}` (alternate 0) or `{:#?}` (1), each buffer as its f32s. 0, or -1 when the builder can't
    # grow. Mirrors the derived `Debug`.
    #must_use
    fn debug(self, sb, alternate): i64 {
        var rc = _pv_dd_open(sb, "PackedParticles", alternate);
        rc = rc | _pv_dd_if(sb, "count", self.count, alternate, 0, 1);
        rc = rc | _pv_dd_c32f(sb, "position_mass", _pv_packed_col(self, 0), alternate, 0, 0);
        rc = rc | _pv_dd_c32f(sb, "velocity", _pv_packed_col(self, 1), alternate, 0, 0);
        rc = rc | _pv_dd_c32f(sb, "density_pressure", _pv_packed_col(self, 2), alternate, 0, 0);
        return rc | _pv_dd_close(sb, alternate, 0);
    }
}

impl PvSphKernelParams {
    # Appends Rust's `{:?}` (alternate 0) or `{:#?}` (1): `gravity` as Rust's `[f32; 3]`. 0, or -1 when the builder
    # can't grow. Mirrors the derived `Debug`.
    #must_use
    fn debug(self, sb, alternate): i64 {
        var gv[16];
        store64(&gv, 0);
        store64(&gv + 8, 0);
        var b: *f32 = _pv_as_f32s(&gv);
        b[0] = self.gravity_x;
        b[1] = self.gravity_y;
        b[2] = self.gravity_z;
        var rc = _pv_dd_open(sb, "SphKernelParams", alternate);
        rc = rc | _pv_dd_f32f(sb, "smoothing_radius", self.smoothing_radius, alternate, 0, 1);
        rc = rc | _pv_dd_f32f(sb, "rest_density", self.rest_density, alternate, 0, 0);
        rc = rc | _pv_dd_f32f(sb, "gas_constant", self.gas_constant, alternate, 0, 0);
        rc = rc | _pv_dd_f32f(sb, "viscosity", self.viscosity, alternate, 0, 0);
        rc = rc | _pv_dd_field(sb, "gravity", alternate, 0, 0);
        rc = rc | _pv_dd_f32s(sb, &gv, 3, alternate, 1);
        rc = rc | _pv_dd_end(sb, alternate);
        rc = rc | _pv_dd_f32f(sb, "dt", self.dt, alternate, 0, 0);
        rc = rc | _pv_dd_if(sb, "particle_count", self.particle_count, alternate, 0, 0);
        return rc | _pv_dd_close(sb, alternate, 0);
    }
}

