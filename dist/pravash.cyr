        rc = rc | _pv_dd_ff(sb, "dt", self.dt, alternate, 0, 1);
        rc = rc | _pv_dd_ff(sb, "viscosity", self.viscosity, alternate, 0, 0);
        rc = rc | _pv_dd_if(sb, "diffusion_iterations", self.diffusion_iterations, alternate, 0, 0);
        rc = rc | _pv_dd_if(sb, "pressure_iterations", self.pressure_iterations, alternate, 0, 0);
        rc = rc | _pv_dd_tf(sb, "boundary", boundary_condition_name(self.boundary), alternate, 0, 0);
        rc = rc | _pv_dd_ff(sb, "vorticity_confinement", self.vorticity_confinement, alternate, 0, 0);
        rc = rc | _pv_dd_ff(sb, "buoyancy_alpha", self.buoyancy_alpha, alternate, 0, 0);
        rc = rc | _pv_dd_ff(sb, "ambient_density", self.ambient_density, alternate, 0, 0);
        rc = rc | _pv_dd_bf(sb, "use_maccormack", self.use_maccormack, alternate, 0, 0);
        rc = rc | _pv_dd_bf(sb, "use_bfecc", self.use_bfecc, alternate, 0, 0);
        rc = rc | _pv_dd_ff(sb, "smagorinsky_cs", self.smagorinsky_cs, alternate, 0, 0);
        rc = rc | _pv_dd_bf(sb, "use_multigrid", self.use_multigrid, alternate, 0, 0);
        rc = rc | _pv_dd_bf(sb, "use_cg", self.use_cg, alternate, 0, 0);
        return rc | _pv_dd_close(sb, alternate, 0);
    }
}

# The multigrid levels (a column of `*_PvMgLevel`) as Rust's `Vec<(Vec<f64>, Vec<f64>, Vec<f64>)>`: a list of
# tuples.
#must_use
fn _pv_dd_mg_levels(sb, lv: *PvColumn, alt, depth): i64 {
    var rc = _pv_dd_seq_open(sb, "[", alt, lv.len);
    for (var j = 0; j < lv.len; j = j + 1) {
        rc = rc | _pv_dd_item(sb, alt, depth, j);
        var r = load64(lv.data + j * 8);
        rc = rc | _pv_dd_seq_open(sb, "(", alt, 3);
        for (var q = 0; q < 3; q = q + 1) {
            rc = rc | _pv_dd_item(sb, alt, depth + 1, q);
            var c: *PvColumn = _pv_mg_col(r, q);
            rc = rc | _pv_dd_f64s(sb, c.data, c.len, alt, depth + 2);
            rc = rc | _pv_dd_end(sb, alt);
        }
        rc = rc | _pv_dd_seq_close(sb, ")", alt, depth + 1, 3);
        rc = rc | _pv_dd_end(sb, alt);
    }
    return rc | _pv_dd_seq_close(sb, "]", alt, depth, lv.len);
}

# The name of a `FluidGrid` column 0 … 7 (`_pv_fg_col`'s): the public fields, then the scratch.
#must_use
fn _pv_dd_fg_name(k): i64 {
    match k {
        0 => { return "vx"; }
        1 => { return "vy"; }
        2 => { return "pressure"; }
        3 => { return "density"; }
        4 => { return "scratch_a"; }
        5 => { return "scratch_b"; }
        6 => { return "scratch_c"; }
        7 => { return "diffuse_rhs"; }
        _ => { return ""; }
    }
    return "";
}

impl PvFluidGrid {
    # Appends Rust's `{:?}` (alternate 0) or `{:#?}` (1): Rust's fields, the scratch and the multigrid levels
    # included (not the port's solve buffers, DST plans or thread count). 0, or -1 when the builder can't grow.
    # Mirrors the derived `Debug`.
    #must_use
    fn debug(self, sb, alternate): i64 {
        var rc = _pv_dd_open(sb, "FluidGrid", alternate);
        rc = rc | _pv_dd_if(sb, "nx", self.nx, alternate, 0, 1);
        rc = rc | _pv_dd_if(sb, "ny", self.ny, alternate, 0, 0);
        rc = rc | _pv_dd_ff(sb, "dx", self.dx, alternate, 0, 0);
        for (var k = 0; k < 8; k = k + 1) {
            rc = rc | _pv_dd_cf(sb, _pv_dd_fg_name(k), _pv_fg_col(self, k), alternate, 0, 0);
        }
        rc = rc | _pv_dd_field(sb, "mg_levels", alternate, 0, 0);
        rc = rc | _pv_dd_mg_levels(sb, _pv_fg_col(self, 8), alternate, 1);
        rc = rc | _pv_dd_end(sb, alternate);
        return rc | _pv_dd_close(sb, alternate, 0);
    }
}

impl PvKEpsilon {
    # Appends Rust's `{:?}` (alternate 0) or `{:#?}` (1), the scratch included. 0, or -1 when the builder can't
    # grow. Mirrors the derived `Debug`.
    #must_use
    fn debug(self, sb, alternate): i64 {
        var rc = _pv_dd_open(sb, "KEpsilon", alternate);
        rc = rc | _pv_dd_cf(sb, "k", _pv_ke_col(self, 0), alternate, 0, 1);
        rc = rc | _pv_dd_cf(sb, "epsilon", _pv_ke_col(self, 1), alternate, 0, 0);
        rc = rc | _pv_dd_ff(sb, "c_mu", self.c_mu, alternate, 0, 0);
        rc = rc | _pv_dd_ff(sb, "c_eps1", self.c_eps1, alternate, 0, 0);
        rc = rc | _pv_dd_ff(sb, "c_eps2", self.c_eps2, alternate, 0, 0);
        rc = rc | _pv_dd_cf(sb, "scratch_k", _pv_ke_col(self, 2), alternate, 0, 0);
        rc = rc | _pv_dd_cf(sb, "scratch_eps", _pv_ke_col(self, 3), alternate, 0, 0);
        return rc | _pv_dd_close(sb, alternate, 0);
    }
}

