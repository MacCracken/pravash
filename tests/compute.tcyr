# compute.tcyr — the ported tests of Rust 1.3.0's src/compute.rs (M7 part a): all 11, in Rust's order.
#
# Rust's `Vec<f32>` buffers are `PvF32Column`s; `particles.density_pressure[0] = 1000.0` is `set(0, 1000.0)`. The
# file also includes src/compute_ad.cyr, which ships outside the `[lib]` bundle (hisab is test-scope here). Cyrius-only
# groups follow: the layouts, f32 rounding to nearest even, a backend implemented and called through `dyn`, the
# autodiff gradient against analytical gradients and on a tape it has to grow, the derivatives against finite
# differences (class R), and the f32 JSON reads' stand-in (ledger L15). Last, Rust's four `ignore`d doc examples,
# written against the API and run (`doc_*`, M8 part a).

include "tests/lib.cyr"
include "src/compute_ad.cyr"

# 1 when |a − b| < tol.
fn near(a: f64, b: f64, tol: f64): i64 {
    var d: f64 = a - b;
    var ad: f64 = f64_abs(d);
    if (ad < tol) { return 1; }
    return 0;
}

# An SoA of the n particles at ps into *soa (asserting it was built).
fn soa_of(soa: *PvParticleSoa, ps: *PvFluidParticle, n) {
    assert_eq(PvParticleSoa_from_aos(soa, ps, n), 1, "SoA built");
    return 0;
}

# A buffer of n particles `FluidParticle::new(position, mass)`.
fn particles(n, x: f64, y: f64, z: f64, m: f64): i64 {
    var buf = fl_alloc(n * sizeof(PvFluidParticle) + 8);
    var ps: *PvFluidParticle = _pv_as_particles(buf);
    for (var i = 0; i < n; i = i + 1) {
        var p: PvFluidParticle = PvFluidParticle_new(PvVec3_new(x, y, z), m);
        memcpy(ps + i, &p, sizeof(PvFluidParticle));
    }
    return buf;
}

# The first block of Rust tests: packing and unpacking, the parameters, the operations.
fn test_packing() {
    test_group("test_packed_particles_roundtrip");
    var pb = particles(2, 1.0, 2.0, 3.0, 0.5);
    var ps: *PvFluidParticle = _pv_as_particles(pb);
    var p1: *PvFluidParticle = ps + 1;
    p1.position = PvVec3_new(4.0, 5.0, 6.0);
    p1.mass = 0.25;
    var soa: PvParticleSoa;
    soa_of(&soa, ps, 2);
    var pk: PvPackedParticles;
    assert_eq(PvPackedParticles_from_soa(&soa, &pk), 1, "packed");
    var a0: f64 = pk.position_mass.at(0);
    var a1: f64 = pk.position_mass.at(1);
    var a2: f64 = pk.position_mass.at(2);
    var a3: f64 = pk.position_mass.at(3);
    var a4: f64 = pk.position_mass.at(4);
    var e = 0.000001;
    assert_eq(pk.count, 2, "two particles");
    assert(near(a0, 1.0, e) == 1 && near(a1, 2.0, e) == 1 && near(a2, 3.0, e) == 1, "the first position");
    assert(near(a3, 0.5, e) == 1 && near(a4, 4.0, e) == 1, "its mass, and the second's x");
    PvPackedParticles_drop(&pk);
    PvParticleSoa_drop(&soa);
    fl_free(pb);

    test_group("test_packed_unpack_density");
    var qb = particles(1, 0.0, 0.0, 0.0, 1.0);
    soa_of(&soa, _pv_as_particles(qb), 1);
    assert_eq(PvPackedParticles_from_soa(&soa, &pk), 1, "packed");
    pk.density_pressure.set(0, 1000.0);
    pk.density_pressure.set(1, 500.0);
    pk.unpack_density_pressure(&soa);
    var d0: f64 = soa.density.at(0);
    var p0: f64 = soa.pressure.at(0);
    assert(near(d0, 1000.0, 0.001) == 1 && near(p0, 500.0, 0.001) == 1, "density and pressure written back");
    PvPackedParticles_drop(&pk);
    PvParticleSoa_drop(&soa);

    test_group("test_packed_unpack_velocity");
    soa_of(&soa, _pv_as_particles(qb), 1);
    assert_eq(PvPackedParticles_from_soa(&soa, &pk), 1, "packed");
    pk.velocity.set(0, 1.5);
    pk.velocity.set(1, 2.5);
    pk.velocity.set(2, 3.5);
    pk.unpack_velocity(&soa);
    var v0: f64 = soa.vel_x.at(0);
    var v1: f64 = soa.vel_y.at(0);
    var v2: f64 = soa.vel_z.at(0);
    assert(near(v0, 1.5, 0.001) == 1 && near(v1, 2.5, 0.001) == 1 && near(v2, 3.5, 0.001) == 1, "velocity back");
    PvPackedParticles_drop(&pk);
    PvParticleSoa_drop(&soa);
    fl_free(qb);

    test_group("test_packed_empty");
    var empty: PvParticleSoa = PvParticleSoa_new();
    assert_eq(PvPackedParticles_from_soa(&empty, &pk), 1, "packed");
    assert(pk.count == 0 && pk.position_mass.len == 0, "nothing packed");
    PvPackedParticles_drop(&pk);

    test_group("test_sph_kernel_params");
    var sp: PvSphKernelParams = PvSphKernelParams_default();
    sp.smoothing_radius = 0.05;
    sp.rest_density = 1000.0;
    sp.gas_constant = 2000.0;
    sp.viscosity = 0.001;
    sp.gravity_y = -9.81;
    sp.dt = 0.001;
    sp.particle_count = 100;
    var dtw: f64 = f32_to(sp.dt);
    assert(dtw > 0.0 && sp.particle_count == 100, "set fields read back");

    test_group("test_compute_op_variants");
    assert(PV_COMPUTE_OP_SPH_DENSITY != PV_COMPUTE_OP_SPH_STEP, "SphDensity ≠ SphStep");
    assert(PV_COMPUTE_OP_GRID_ADVECT != PV_COMPUTE_OP_SHALLOW_STEP, "GridAdvect ≠ ShallowStep");
    return 0;
}

# The audit's regressions (1.3.0), in Rust's order.
fn test_regressions() {
    test_group("test_unpack_short_buffers_no_panic");
    var pb = particles(4, 0.0, 0.0, 0.0, 1.0);
    var soa: PvParticleSoa;
    soa_of(&soa, _pv_as_particles(pb), 4);
    var pk: PvPackedParticles;
    assert_eq(PvPackedParticles_from_soa(&soa, &pk), 1, "packed");
    pk.density_pressure.truncate(3);
    pk.velocity.truncate(5);
    pk.position_mass.truncate(0);
    pk.unpack_density_pressure(&soa);
    pk.unpack_velocity(&soa);
    pk.unpack_positions(&soa);
    assert(soa.density.len == 4, "short buffers: no panic");
    PvPackedParticles_drop(&pk);

    test_group("test_from_soa_mismatched_lengths");
    soa.pressure.truncate(1);
    assert_eq(PvPackedParticles_from_soa(&soa, &pk), 1, "packed");
    assert_eq(pk.count, 1, "only the complete particles");
    PvPackedParticles_drop(&pk);
    PvParticleSoa_drop(&soa);
    fl_free(pb);

    test_group("test_kernel_params_default_constructible");
    var p: PvSphKernelParams = PvSphKernelParams_default();
    p.smoothing_radius = 0.05;
    var sr: f64 = f32_to(p.smoothing_radius);
    var f32eps: f64 = 0.00000011920928955078125;
    assert(near(sr, 0.05, f32eps) == 1, "a default with one field set");
    var g: PvGridKernelParams = PvGridKernelParams_default();
    var s: PvShallowKernelParams = PvShallowKernelParams_default();
    assert(g.nx == 0 && s.ny == 0, "both other defaults");

    test_group("test_dtait_drho_gamma_zero_finite");
    var d: f64 = PvKernelDerivatives_dtait_drho(1000.0, 1000.0, 10.0, 0.0);
    var d7: f64 = PvKernelDerivatives_dtait_drho(1000.0, 1000.0, 10.0, 7.0);
    assert(_pv_is_finite(d) == 1 && near(d7, 100.0, 0.000000001) == 1, "γ = 0 finite, γ = 7 at rest c²");

    test_group("test_dpoly6_zero_radius");
    var z: f64 = PvKernelDerivatives_dpoly6_dr2(0.0, 0.0);
    assert(z == 0.0, "h = 0: 0");
    return 0;
}

# A backend for the tests: it counts its calls and writes density 1 for every particle.
struct MockBackend {
    calls;
}

impl PvComputeBackend for MockBackend {
    # The SPH operations only.
    fn supports(self, op): i64 {
        if (op == PV_COMPUTE_OP_SPH_DENSITY || op == PV_COMPUTE_OP_SPH_STEP) { return 1; }
        return 0;
    }

    # Density 1 everywhere.
    fn sph_density(self, particles: *PvPackedParticles, params: *PvSphKernelParams): i64 {
        self.calls = self.calls + 1;
        for (var i = 0; i < particles.count; i = i + 1) { particles.density_pressure.set(2 * i, 1.0); }
        return PV_ERR_NONE;
    }

    # Not implemented: an error code.
    fn sph_step(self, particles: *PvPackedParticles, params: *PvSphKernelParams): i64 {
        return PV_ERR_INVALID_PARAMETER;
    }

    # Copies src to dst.
    fn grid_advect(self, dst, src, vx, vy, n, params: *PvGridKernelParams): i64 {
        memcpy(dst, src, n * 4);
        return PV_ERR_NONE;
    }

    # Nothing.
    fn shallow_step(self, height, vx, vy, ground, n, params: *PvShallowKernelParams): i64 {
        return PV_ERR_NONE;
    }
}

# Runs the density through any backend.
fn run_density(b: dyn PvComputeBackend, pk: *PvPackedParticles, p: *PvSphKernelParams): i64 {
    if (b.supports(PV_COMPUTE_OP_SPH_DENSITY) == 0) { return 0 - 1; }
    return b.sph_density(pk, p);
}

# Cyrius-only: the layouts, f32 rounding, and a backend through `dyn`.
fn test_cyrius() {
    test_group("compute_layouts");
    assert_eq(sizeof(PvF32Column), 24, "a buffer is 24 bytes");
    assert_eq(sizeof(PvPackedParticles), 80, "the packed record is 80 bytes");
    assert(sizeof(PvSphKernelParams) == 36 && sizeof(PvGridKernelParams) == 28, "the parameter records, packed");
    assert_eq(sizeof(PvShallowKernelParams), 28, "and the shallow-water one");
    var pk: PvPackedParticles;
    var c1: *PvF32Column = _pv_packed_col(&pk, 1);
    assert_eq(_pv_addr(c1), _pv_addr(&pk) + 32, "buffer 1 (velocity) at byte 32");

    test_group("compute_f32_rounding");
    var pb = particles(1, 0.1, 16777217.0, -0.0, 0.3);
    var soa: PvParticleSoa;
    soa_of(&soa, _pv_as_particles(pb), 1);
    assert_eq(PvPackedParticles_from_soa(&soa, &pk), 1, "packed");
    var x: f64 = pk.position_mass.at(0);
    var y: f64 = pk.position_mass.at(1);
    var zb = load32(pk.position_mass.data + 8);
    var pad: f64 = pk.velocity.at(3);
    assert(x == 0.10000000149011612 && y == 16777216.0, "nearest f32, ties to even");
    assert(zb == 0x80000000 && pad == 0.0 && load32(pk.velocity.data + 12) == 0, "−0 kept, the padding +0");
    PvPackedParticles_drop(&pk);

    test_group("compute_op_names");
    var on0 = streq(compute_op_name(PV_COMPUTE_OP_SPH_DENSITY), "SphDensity");
    var on1 = streq(compute_op_name(PV_COMPUTE_OP_SPH_STEP), "SphStep");
    var on2 = streq(compute_op_name(PV_COMPUTE_OP_GRID_ADVECT), "GridAdvect");
    var on3 = streq(compute_op_name(PV_COMPUTE_OP_SHALLOW_STEP), "ShallowStep");
    assert(on0 == 1 && on1 == 1, "the SPH operations by their Rust names");
    assert(on2 == 1 && on3 == 1, "the grid and shallow-water operations");
    var unk = streq(compute_op_name(4), "Unknown");
    assert(PV_COMPUTE_OP_SPH_DENSITY == 0 && PV_COMPUTE_OP_SHALLOW_STEP == 3 && unk == 1,
      "explicit values 0 … 3, and a value past them unknown");

    test_group("compute_backend_through_dyn");
    assert_eq(PvPackedParticles_from_soa(&soa, &pk), 1, "packed");
    var mb: MockBackend;
    mb.calls = 0;
    var params: PvSphKernelParams = PvSphKernelParams_default();
    var rc = run_density(&mb, &pk, &params);
    var d: f64 = pk.density_pressure.at(0);
    assert(rc == PV_ERR_NONE && mb.calls == 1 && d == 1.0, "the backend wrote the density");
    assert(mb.sph_step(&pk, &params) == PV_ERR_INVALID_PARAMETER, "an error is a code");
    PvPackedParticles_drop(&pk);
    PvParticleSoa_drop(&soa);
    fl_free(pb);
    return 0;
}

# f(x) = x0·x1 + sin(x2): the gradient is (x1, x0, cos x2).
fn ad_f1(t, vars, n): i64 {
    var a = ad_mul(t, load64(vars), load64(vars + 8));
    var s = ad_sin(t, load64(vars + 16));
    return ad_add(t, a, s);
}

# f(x) = x0 + Σ_{k<200} ((x0·x1 − x1·x0) + x0): 1,000 operations from a 64-node first tape, so the tape grows; the
# gradient is (201, 0).
fn ad_long(t, vars, n): i64 {
    var x0 = load64(vars);
    var x1 = load64(vars + 8);
    var acc = x0;
    for (var k = 0; k < 200; k = k + 1) {
        var a = ad_mul(t, x0, x1);
        var b = ad_mul(t, x1, x0);
        var c = ad_sub(t, a, b);
        acc = ad_add(t, acc, ad_add(t, c, x0));
    }
    return acc;
}

# Cyrius-only: the autodiff gradient, and the analytical derivatives against finite differences (class R).
fn test_derivatives() {
    test_group("autodiff_matches_analytical_gradients");
    var x[24];
    store64(&x, _pv_bits(1.5));
    store64(&x + 8, _pv_bits(-0.5));
    store64(&x + 16, _pv_bits(0.7));
    var gp, gn = PvKernelDerivatives_autodiff_gradient(&ad_f1, &x, 3);
    var g0: f64 = load64(gp);
    var g1: f64 = load64(gp + 8);
    var g2: f64 = load64(gp + 16);
    var c2: f64 = _pv_cos(0.7);
    var tol = 0.000000000001;
    var ok01 = near(g0, -0.5, tol) & near(g1, 1.5, tol);
    assert(gn == 3 && ok01 == 1 && near(g2, c2, tol) == 1, "(x1, x0, cos x2)");
    fl_free(gp);
    var lp, ln = PvKernelDerivatives_autodiff_gradient(&ad_long, &x, 2);
    var l0: f64 = load64(lp);
    var l1: f64 = load64(lp + 8);
    assert(ln == 2 && l0 == 201.0 && l1 == 0.0, "a 1,000-node function grows the tape: (201, 0)");
    fl_free(lp);
    var used = alloc_used();
    for (var k = 0; k < 50; k = k + 1) {
        var rp, rn = PvKernelDerivatives_autodiff_gradient(&ad_f1, &x, 3);
        fl_free(rp);
    }
    assert_eq(alloc_used() - used, 0, "50 more gradients on the kept tape take no heap");
    var zp, zn = PvKernelDerivatives_autodiff_gradient(&ad_f1, &x, 0);
    assert(zp == 0 && zn == 0, "no inputs: nothing");

    test_group("derivatives_against_finite_differences");
    var ok = 1;
    var hs[24];
    store64(&hs, _pv_bits(0.05));
    store64(&hs + 8, _pv_bits(1.0));
    store64(&hs + 16, _pv_bits(0.3));
    for (var hi = 0; hi < 3; hi = hi + 1) {
        var h: f64 = load64(&hs + hi * 8);
        for (var k2 = 1; k2 < 10; k2 = k2 + 1) {
            var fk: f64 = f64_from(k2);
            var r: f64 = fk * 0.1 * h;
            var r2: f64 = r * r;
            var e: f64 = 0.000001 * h * h;
            var wp: f64 = kernel_poly6(f64_sqrt(r2 + e), h);
            var wm: f64 = kernel_poly6(f64_sqrt(r2 - e), h);
            var fd: f64 = (wp - wm) / (2.0 * e);
            var an: f64 = PvKernelDerivatives_dpoly6_dr2(r2, h);
            var rel: f64 = f64_abs(fd - an) / f64_abs(an);
            if (rel > 0.00001) { ok = 0; }
            var eps: f64 = 0.000001 * h;
            var cp: f64 = kernel_wendland_c2(r + eps, h);
            var cm: f64 = kernel_wendland_c2(r - eps, h);
            var fw: f64 = (cp - cm) / (2.0 * eps);
            var aw: f64 = PvKernelDerivatives_dwendland_c2_dr(r, h);
            var relw: f64 = f64_abs(fw - aw) / f64_abs(aw);
            if (relw > 0.00001) { ok = 0; }
        }
    }
    for (var k3 = 1; k3 < 8; k3 = k3 + 1) {
        var fk3: f64 = f64_from(k3);
        var rho: f64 = 900.0 + fk3 * 30.0;
        var de: f64 = 0.001;
        var pp: f64 = equation_of_state_tait(rho + de, 1000.0, 10.0, 7.0);
        var pm: f64 = equation_of_state_tait(rho - de, 1000.0, 10.0, 7.0);
        var ft: f64 = (pp - pm) / (2.0 * de);
        var at: f64 = PvKernelDerivatives_dtait_drho(rho, 1000.0, 10.0, 7.0);
        var relt: f64 = f64_abs(ft - at) / f64_abs(at);
        if (relt > 0.000001) { ok = 0; }
    }
    assert_eq(ok, 1, "poly6, Wendland C2 and Tait derivatives agree with central differences");
    var kd: f64 = PvKernelDerivatives_deos_drho(2000.0);
    assert(kd == 2000.0, "the linear EOS: k");
    return 0;
}

# 2^k, exactly (repeated doubling or halving).
fn pow2(k): f64 {
    var x: f64 = 1.0;
    for (var i = 0; i < k; i = i + 1) { x = x * 2.0; }
    for (var j = 0; j > k; j = j - 1) { x = x * 0.5; }
    return x;
}

# The sign the exact decimal comparison gives for the C string s against x.
fn dcmp(s, x: f64): i64 {
    return _pv_dec_cmp(s, strlen(s), x);
}

# The widened f32 the stand-in rounds x to, given the sign c: its bits, or -1 for ±∞.
fn r32(x: f64, c): i64 {
    var t, b = _pv_f32_round(x, c);
    if (t == 0) { return 0 - 1; }
    return b;
}

# The f32 reads' stand-in (ledger L15): the tie test, the rounding with a sign, the exact decimal comparison, the
# integers, and the number text found by document position.
fn test_f32_reads() {
    test_group("compute_f32_reads");
    var one: f64 = 1.0;
    var u24: f64 = pow2(0 - 24);
    var u23: f64 = pow2(0 - 23);
    var m1: f64 = one + u24;
    var up1: f64 = one + u23;
    var t3: f64 = 3.0 * u24;
    var m3: f64 = one + t3;
    var s1: f64 = pow2(0 - 150);
    var s3: f64 = 3.0 * s1;
    var s0: f64 = pow2(0 - 151);
    var p128: f64 = pow2(128);
    var p103: f64 = pow2(103);
    var big: f64 = p128 - p103;
    var fmax: f64 = 340282346638528859811704183484516925440.0;
    assert(_pv_f32_is_tie(m1) == 1 && _pv_f32_is_tie(m3) == 1, "1 + 2^-24 and 1 + 3·2^-24 are midpoints");
    assert(_pv_f32_is_tie(one) == 0 && _pv_f32_is_tie(up1) == 0, "f32 values are not");
    assert(_pv_f32_is_tie(s1) == 1 && _pv_f32_is_tie(s3) == 1 && _pv_f32_is_tie(s0) == 0, "the subnormal midpoints");
    assert(_pv_f32_is_tie(big) == 1 && _pv_f32_is_tie(fmax) == 0, "2^128 − 2^103 is the overflow midpoint");
    var e39: f64 = 1000000000000000000000000000000000000000.0;
    var zero: f64 = 0.0;
    assert(_pv_f32_is_tie(e39) == 0 && _pv_f32_is_tie(zero) == 0, "nor are 1e39 and 0");

    assert(r32(m1, 0) == _pv_bits(one) && r32(m1, 1) == _pv_bits(up1) && r32(m1, 0 - 1) == _pv_bits(one),
      "a tie: even, or the side the decimal lies on");
    var up3: f64 = one + pow2(0 - 22);
    assert(r32(m3, 0) == _pv_bits(up3) && r32(m3, 0 - 1) == _pv_bits(up1), "1 + 3·2^-24: up to even, or down");
    var nm1: f64 = -m1;
    var nup1: f64 = -up1;
    assert(r32(nm1, 1) == _pv_bits(nup1), "a negative tie moves away from 0 when the decimal is larger");
    assert(r32(big, 0 - 1) == _pv_bits(fmax) && r32(big, 0) == 0 - 1 && r32(big, 1) == 0 - 1,
      "the overflow midpoint: f32::MAX just below it, ±∞ (refused) at and above");
    assert(r32(e39, 0) == 0 - 1 && r32(fmax, 0) == _pv_bits(fmax), "past the range ±∞; f32::MAX itself");
    var nz: f64 = -0.0;
    assert(r32(nz, 0) == _pv_bits(nz), "−0 keeps its sign");
    var p149: f64 = pow2(0 - 149);
    assert(r32(s1, 1) == _pv_bits(p149) && r32(s1, 0) == 0 && r32(s1, 0 - 1) == 0, "2^-150: 2^-149 above, else 0");

    assert(dcmp("1.000000059604644775390625", m1) == 0, "the midpoint's exact digits");
    assert(dcmp("1.0000000596046448", m1) == 1 && dcmp("1.0000000596046447", m1) == 0 - 1,
      "its shortest f64 digits lie above it, the next below");
    assert(dcmp("1000000059604644775390625e-24", m1) == 0 && dcmp("100000005960464477539062.5E-23", m1) == 0,
      "an integer mantissa and an exponent");
    assert(dcmp("1.0000000596046447753906250000", m1) == 0 && dcmp("-1.000000059604644775390625", m1) == 0,
      "trailing zeros, and the sign ignored");
    var sbs = str_builder_new();
    str_builder_add_cstr(sbs, "0.");
    for (var zz = 0; zz < 45; zz = zz + 1) { str_builder_add_cstr(sbs, "0"); }
    str_builder_add_cstr(sbs, "70064923216240853546186479164495806564013097093825");
    str_builder_add_cstr(sbs, "788587853414194489554134293030074331909418106079101562500");
    var ds1 = str_builder_build(sbs);
    assert(_pv_dec_cmp(str_data(ds1), str_len(ds1), s1) == 0, "2^-150's 105 significant digits");
    assert(dcmp("7.006492321624086e-46", s1) == 1 && dcmp("7.006492321624085e-46", s1) == 0 - 1, "and beside it");
    assert(dcmp("16777217", 16777216.0) == 1 && dcmp("0.5", 0.5) == 0 && dcmp("5e-1", 0.5) == 0, "integers, halves");
    var m25: f64 = 33554450.0;
    assert(_pv_f32_is_tie(m25) == 1 && dcmp("33554450.0", m25) == 0 && dcmp("3355445e1", m25) == 0,
      "a midpoint with a trailing zero (A scaled by 10^e)");
    var m25b: f64 = 33554470.0;
    var up25: f64 = 33554472.0;
    var d70 = "33554470.0";
    var e70 = _pv_dec_cmp(d70, strlen(d70), m25b);
    assert(e70 == 0 && r32(m25b, e70) == _pv_bits(up25), "33554470: a tie whose even neighbour is above");
    var b25a = dcmp("33554450.000000001", m25);
    var b25b = dcmp("33554449.999999999", m25);
    assert(b25a == 1 && b25b == 0 - 1 && dcmp("33554460", m25) == 1, "and beside it");
    assert(dcmp("1e500", one) == 1 && dcmp("1e-500", one) == 0 - 1, "decided by order");
    assert(dcmp("0", one) == 0 - 1 && dcmp("-0.0e7", one) == 0 - 1, "and zero below any nonzero");
    var tiny: f64 = pow2(0 - 1074);
    assert(dcmp("5e-324", tiny) == 1 && dcmp("4.9e-324", tiny) == 0 - 1, "the smallest subnormal");
    # 900 zeros past the midpoint's digits, then a 1: past the kept 800, a nonzero digit still counts.
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "1.000000059604644775390625");
    for (var z = 0; z < 900; z = z + 1) { str_builder_add_cstr(sb, "0"); }
    var ld0 = str_builder_build(sb);
    var n0 = str_len(ld0);
    assert(_pv_dec_cmp(str_data(ld0), n0, m1) == 0, "900 trailing zeros: still the midpoint");
    str_builder_add_cstr(sb, "1");
    var ld1 = str_builder_build(sb);
    assert(_pv_dec_cmp(str_data(ld1), str_len(ld1), m1) == 1, "then a 1 past the kept digits: above it");

    var a60: f64 = pow2(60);
    var a37: f64 = pow2(37);
    var w60: f64 = a60 + a37;
    var nw60: f64 = -w60;
    var p63: f64 = pow2(63);
    var np63: f64 = -p63;
    assert(_pv_f32_of_int(1152921573326323713) == _pv_bits(w60), "2^60 + 2^36 + 1: up, once (its f64 is the tie)");
    var i60 = _pv_f32_of_int(1152921573326323712);
    var n60 = _pv_f32_of_int(0 - 1152921573326323713);
    assert(i60 == _pv_bits(a60) && n60 == _pv_bits(nw60), "the tie itself to even; the negative mirror");
    var imax = _pv_f32_of_int(9223372036854775807);
    var imin = _pv_f32_of_int(0 - 9223372036854775807 - 1);
    assert(imax == _pv_bits(p63) && imin == _pv_bits(np63), "i64::MAX and i64::MIN");
    assert(_pv_f32_of_int(16777217) == _pv_bits(16777216.0) && _pv_f32_of_int(16777219) == _pv_bits(16777220.0),
      "past 2^24, ties to even");

    var doc = "{\"a\":\"x\\\"1,2\",\"b\":[3,-4.5e1,{\"9\":\"]9\"}],\"d\":7}";
    var v = _pv_jr_parse(doc, strlen(doc));
    assert(v != 0, "the document parses");
    var arr = bayan_json_v_obj_get_by_cstr(v, "b");
    var tp, tn = _pv_jr_num_text(bayan_json_v_arr_get(arr, 1));
    assert(tn == 6 && memeq(tp, "-4.5e1", 6) == 1, "a number found past a string with an escaped quote and digits");
    var dp, dn = _pv_jr_num_text(bayan_json_v_obj_get_by_cstr(v, "d"));
    assert(dn == 1 && load8(dp) == 55, "and after a nested object whose key and value hold digits");
    var np, nn = _pv_jr_num_text(arr);
    assert(np == 0 && nn == 0, "an array is no number");

    var sp: PvSphKernelParams;
    var sbd = str_builder_new();
    str_builder_add_cstr(sbd, "{\"9e9\":\"1.0000000596046448\",\"smoothing_radius\":1.0000000596046448,");
    str_builder_add_cstr(sbd, "\"rest_density\":0,\"gas_constant\":0,\"viscosity\":0,");
    str_builder_add_cstr(sbd, "\"gravity\":[1.0000000596046447,0,-1.0000000596046448],");
    str_builder_add_cstr(sbd, "\"dt\":1.0000000596046447,\"particle_count\":0}");
    var d2s = str_builder_build(sbd);
    var rt, rv = PvSphKernelParams_from_json(str_data(d2s), str_len(d2s), &sp);
    var h: f64 = f32_to(sp.smoothing_radius);
    var gx: f64 = f32_to(sp.gravity_x);
    var gz: f64 = f32_to(sp.gravity_z);
    var dt: f64 = f32_to(sp.dt);
    assert(is_err_result(rt) == 0 && h == up1 && gx == one && gz == nup1 && dt == one,
      "each field rounded from its own text: one f64, three f32s");
    var d3 = "[1,1,1,1,[0,0,0],340282356779733661637539395458142568448.0,1]";
    var et, ev = PvSphKernelParams_from_json(d3, strlen(d3), &sp);
    assert(is_err_result(et) == 1, "the overflow midpoint itself is refused (serde_json: out of range)");
    return 0;
}

# ── Rust's doc examples: `ignore`d fences in compute.rs, written against the API and run here ────────────────────

# The module doc's skeleton of a GPU backend (soorat's, say): every operation supported, and an SPH density that
# uploads, dispatches a compute shader and reads back, all `Ok(())`.
struct DocModuleBackend {
    density_calls;
}

impl PvComputeBackend for DocModuleBackend {
    # Every operation (the doc's `true`).
    fn supports(self, op): i64 {
        return 1;
    }

    # Upload, dispatch, read back: Ok.
    fn sph_density(self, particles: *PvPackedParticles, params: *PvSphKernelParams): i64 {
        self.density_calls = self.density_calls + 1;
        return PV_ERR_NONE;
    }

    # The doc's `// ...`: Ok.
    fn sph_step(self, particles: *PvPackedParticles, params: *PvSphKernelParams): i64 {
        return PV_ERR_NONE;
    }

    # Ok.
    fn grid_advect(self, dst, src, vx, vy, n, params: *PvGridKernelParams): i64 {
        return PV_ERR_NONE;
    }

    # Ok.
    fn shallow_step(self, height, vx, vy, ground, n, params: *PvShallowKernelParams): i64 {
        return PV_ERR_NONE;
    }
}

# The `ComputeBackend` doc's backend: `supports` checks the compiled shaders, and the density uploads
# `position_mass` to a storage buffer, dispatches the density shader and reads `density_pressure` back. The device
# here is the backend's own f32 buffer, and the shader the poly6 sum ρᵢ = Σⱼ mⱼ·W(|xᵢ − xⱼ|, h) over every pair.
struct DocShaderBackend {
    compiled;
    storage: PvF32Column;
}

impl PvComputeBackend for DocShaderBackend {
    # 1 when the op's shader is compiled (a bit per `PvComputeOp`).
    fn supports(self, op): i64 {
        return (self.compiled >> op) & 1;
    }

    # Upload, dispatch, read back.
    fn sph_density(self, particles: *PvPackedParticles, params: *PvSphKernelParams): i64 {
        if (self.supports(PV_COMPUTE_OP_SPH_DENSITY) == 0) { return PV_ERR_INVALID_PARAMETER; }
        var n = particles.count;
        var src: *PvF32Column = _pv_packed_col(particles, 0);
        if (self.storage.reserve(4 * n) == 0) { return PV_ERR_OUT_OF_MEMORY; }
        self.storage.truncate(0);
        for (var k = 0; k < 4 * n; k = k + 1) {
            var v: f64 = src.at(k);
            self.storage.push_rounded(v);
        }
        var hf: f32 = params.smoothing_radius;
        var h: f64 = f32_to(hf);
        var dp: *PvF32Column = _pv_packed_col(particles, 2);
        for (var i = 0; i < n; i = i + 1) {
            var rho: f64 = 0.0;
            for (var j = 0; j < n; j = j + 1) {
                var dx: f64 = self.storage.at(4 * i) - self.storage.at(4 * j);
                var dy: f64 = self.storage.at(4 * i + 1) - self.storage.at(4 * j + 1);
                var dz: f64 = self.storage.at(4 * i + 2) - self.storage.at(4 * j + 2);
                var r2: f64 = (dx * dx + dy * dy) + dz * dz;
                var r: f64 = f64_sqrt(r2);
                var w: f64 = kernel_poly6(r, h);
                var m: f64 = self.storage.at(4 * j + 3);
                rho = rho + m * w;
            }
            var stored = dp.set(2 * i, rho);
        }
        return PV_ERR_NONE;
    }

    # Not compiled.
    fn sph_step(self, particles: *PvPackedParticles, params: *PvSphKernelParams): i64 {
        return PV_ERR_INVALID_PARAMETER;
    }

    # Not compiled.
    fn grid_advect(self, dst, src, vx, vy, n, params: *PvGridKernelParams): i64 {
        return PV_ERR_INVALID_PARAMETER;
    }

    # Not compiled.
    fn shallow_step(self, height, vx, vy, ground, n, params: *PvShallowKernelParams): i64 {
        return PV_ERR_INVALID_PARAMETER;
    }
}

# The `NeuralCorrector` doc's FNO corrector: inference on the coarse state gives the velocity and pressure
# corrections. Its model here is a fixed linear one: Δv = −damping·v, Δp = 0.
struct DocFnoCorrector {
    damping: f64;
}

impl PvNeuralCorrector for DocFnoCorrector {
    # Runs the model and fills *out.
    fn correct(self, velocities, nv, pressures, np, params: *PvGridKernelParams, out: *PvNeuralCorrection): i64 {
        var dv: *PvF32Column = _pv_as_f32_column(_pv_addr(out));
        var dp: *PvF32Column = _pv_as_f32_column(_pv_addr(out) + 24);
        if (dv.reserve(nv) == 0 || dp.reserve(np) == 0) { return PV_ERR_OUT_OF_MEMORY; }
        var vs: *f32 = _pv_as_f32s(velocities);
        var k: f64 = self.damping;
        for (var i = 0; i < nv; i = i + 1) {
            var vf: f32 = vs[i];
            var v: f64 = f32_to(vf);
            var d: f64 = -(k * v);
            dv.push_rounded(d);
        }
        for (var j = 0; j < np; j = j + 1) { dp.push_rounded(0.0); }
        return PV_ERR_NONE;
    }
}

# Runs a corrector through `dyn`, as a consumer's solver loop would.
fn doc_run_corrector(c: dyn PvNeuralCorrector, v, nv, p, np, g: *PvGridKernelParams, out: *PvNeuralCorrection): i64 {
    return c.correct(v, nv, p, np, g, out);
}

# The `autodiff_gradient` doc's function: r² from the input r.
fn doc_r2(t, vars, n): i64 {
    var r = load64(vars);
    return ad_mul(t, r, r);
}

# Rust's doc examples in compute.rs, run.
fn test_docs() {
    test_group("doc_compute_module_backend");
    var mb: DocModuleBackend;
    mb.density_calls = 0;
    var all = 1;
    for (var op = PV_COMPUTE_OP_SPH_DENSITY; op <= PV_COMPUTE_OP_SHALLOW_STEP; op = op + 1) {
        all = all & mb.supports(op);
    }
    var pb = particles(3, 0.1, 0.2, 0.0, 0.5);
    var soa: PvParticleSoa;
    soa_of(&soa, _pv_as_particles(pb), 3);
    var pk: PvPackedParticles;
    assert_eq(PvPackedParticles_from_soa(&soa, &pk), 1, "packed");
    var params: PvSphKernelParams = PvSphKernelParams_default();
    var rc = run_density(&mb, &pk, &params);
    assert(all == 1 && rc == PV_ERR_NONE && mb.density_calls == 1, "every op supported, the density Ok");
    PvPackedParticles_drop(&pk);
    PvParticleSoa_drop(&soa);
    fl_free(pb);

    test_group("doc_compute_backend");
    var two = fl_alloc(2 * sizeof(PvFluidParticle) + 8);
    var ps: *PvFluidParticle = _pv_as_particles(two);
    var p0: PvFluidParticle = PvFluidParticle_new(PvVec3_new(0.0, 0.0, 0.0), 0.5);
    var p1: PvFluidParticle = PvFluidParticle_new(PvVec3_new(0.25, 0.0, 0.0), 0.5);
    memcpy(ps, &p0, sizeof(PvFluidParticle));
    memcpy(ps + 1, &p1, sizeof(PvFluidParticle));
    soa_of(&soa, ps, 2);
    assert_eq(PvPackedParticles_from_soa(&soa, &pk), 1, "packed");
    var sb: DocShaderBackend;
    memset(&sb, 0, sizeof(DocShaderBackend));
    sb.compiled = 1 << PV_COMPUTE_OP_SPH_DENSITY;
    params.smoothing_radius = 0.5;
    var sup = sb.supports(PV_COMPUTE_OP_SPH_DENSITY) * 2 + sb.supports(PV_COMPUTE_OP_GRID_ADVECT);
    assert_eq(sup, 2, "only the density shader is compiled");
    assert_eq(run_density(&sb, &pk, &params), PV_ERR_NONE, "the density dispatched");
    var w0: f64 = kernel_poly6(0.0, 0.5);
    var w1: f64 = kernel_poly6(0.25, 0.5);
    var want: f64 = 0.5 * w0 + 0.5 * w1;
    var check: PvF32Column;
    memset(&check, 0, sizeof(PvF32Column));
    assert_eq(check.reserve(1), 1, "room");
    check.push_rounded(want);
    var want32: f64 = check.at(0);
    var d0: f64 = pk.density_pressure.at(0);
    var d1: f64 = pk.density_pressure.at(2);
    assert(d0 == want32 && d1 == want32, "each density m·W(0) + m·W(0.25), read back as f32");
    assert_eq(sb.sph_step(&pk, &params), PV_ERR_INVALID_PARAMETER, "a shader not compiled is an error");
    check.drop();
    sb.storage.drop();
    PvPackedParticles_drop(&pk);
    PvParticleSoa_drop(&soa);
    fl_free(two);

    test_group("doc_neural_corrector");
    var vel: PvF32Column;
    var pre: PvF32Column;
    memset(&vel, 0, sizeof(PvF32Column));
    memset(&pre, 0, sizeof(PvF32Column));
    assert(vel.reserve(4) == 1 && pre.reserve(2) == 1, "room");
    vel.push_rounded(1.0);
    vel.push_rounded(-2.0);
    vel.push_rounded(0.5);
    vel.push_rounded(0.0);
    pre.push_rounded(101325.0);
    pre.push_rounded(101300.0);
    var fno: DocFnoCorrector;
    fno.damping = 0.25;
    var gk: PvGridKernelParams = PvGridKernelParams_default();
    var corr: PvNeuralCorrection;
    memset(&corr, 0, sizeof(PvNeuralCorrection));
    var cr = doc_run_corrector(&fno, vel.data, vel.len, pre.data, pre.len, &gk, &corr);
    assert(cr == PV_ERR_NONE && corr.velocity_delta.len == 4 && corr.pressure_delta.len == 2, "a delta per value");
    var a0: f64 = vel.at(0) + corr.velocity_delta.at(0);
    var a1: f64 = vel.at(1) + corr.velocity_delta.at(1);
    var q0: f64 = pre.at(0) + corr.pressure_delta.at(0);
    assert(a0 == 0.75 && a1 == -1.5 && q0 == 101325.0, "added to the state: v·(1 − 0.25), p unchanged");
    PvNeuralCorrection_drop(&corr);
    vel.drop();
    pre.drop();

    test_group("doc_autodiff_gradient");
    var x[8];
    store64(&x, _pv_bits(0.5));
    var gp, gn = PvKernelDerivatives_autodiff_gradient(&doc_r2, &x, 1);
    var g: f64 = load64(gp);
    assert(gn == 1 && g == 1.0, "d(r²)/dr at r = 0.5 is 1");
    fl_free(gp);
    return 0;
}

# 1 when buffers a and b hold the same f32 bits in storage of their own (or both are empty).
fn f32_same(a: *PvF32Column, b: *PvF32Column): i64 {
    if (a.len != b.len) { return 0; }
    if (a.len == 0) { return 1; }
    if (a.data == b.data) { return 0; }
    return memeq(a.data, b.data, a.len * 4);
}

# The derived Clone of PackedParticles and NeuralCorrection (M8 part c, the full surface diff): the buffers at their
# own lengths, in storage of their own.
fn test_clone() {
    test_group("clone_packed_particles");
    var pb = particles(3, 1.0, 2.0, 3.0, 0.5);
    var soa: PvParticleSoa;
    soa_of(&soa, _pv_as_particles(pb), 3);
    var pk: PvPackedParticles;
    assert_eq(PvPackedParticles_from_soa(&soa, &pk), 1, "packed");
    var w = pk.density_pressure.set(1, 1000.0);
    var c: PvPackedParticles;
    assert_eq(PvPackedParticles_clone(&c, &pk), 1, "clone");
    var same = 1;
    for (var k = 0; k < 3; k = k + 1) {
        if (f32_same(_pv_packed_col(&c, k), _pv_packed_col(&pk, k)) == 0) { same = 0; }
    }
    assert(c.count == 3 && same == 1, "the count and all three buffers");
    w = pk.position_mass.set(0, 9.0);
    var cx: f64 = c.position_mass.at(0);
    assert(near(cx, 1.0, 0.000001) == 1, "the clone doesn't see the source's writes");
    PvPackedParticles_drop(&pk);
    var cd: f64 = c.density_pressure.at(1);
    assert(near(cd, 1000.0, 0.000001) == 1, "and outlives it");
    PvPackedParticles_drop(&c);
    var e: PvPackedParticles;
    memset(&e, 0, sizeof(PvPackedParticles));
    assert_eq(PvPackedParticles_clone(&c, &e), 1, "an empty record clones");
    assert(c.count == 0 && c.position_mass.data == 0 && c.velocity.data == 0, "to one holding no storage");
    PvParticleSoa_drop(&soa);
    fl_free(pb);

    test_group("clone_neural_correction");
    var nc: PvNeuralCorrection;
    memset(&nc, 0, sizeof(PvNeuralCorrection));
    assert(nc.velocity_delta.reserve(3) == 1 && nc.pressure_delta.reserve(1) == 1, "room");
    nc.velocity_delta.push_rounded(0.1);
    nc.velocity_delta.push_rounded(-0.2);
    nc.velocity_delta.push_rounded(0.3);
    nc.pressure_delta.push_rounded(-5.0);
    var cc: PvNeuralCorrection;
    assert_eq(PvNeuralCorrection_clone(&cc, &nc), 1, "clone");
    var vs = f32_same(_pv_as_f32_column(_pv_addr(&cc)), _pv_as_f32_column(_pv_addr(&nc)));
    var qs = f32_same(_pv_as_f32_column(_pv_addr(&cc) + 24), _pv_as_f32_column(_pv_addr(&nc) + 24));
    assert(vs == 1 && qs == 1, "the velocity and pressure deltas");
    PvNeuralCorrection_drop(&nc);
    var v1: f64 = cc.velocity_delta.at(1);
    var want: f64 = -0.2;
    var wf: f32 = want;
    var w64: f64 = f32_to(wf);
    assert(v1 == w64, "the clone outlives its source, -0.2 rounded to f32");
    PvNeuralCorrection_drop(&cc);
    return 0;
}

# y², for a gradient taken inside another function's recording.
fn ad_sq(t, vars, n): i64 {
    var y = load64(vars);
    return ad_mul(t, y, y);
}

# f(x) = x0² + c, c the gradient of y² at y = 5 (10), taken inside f by a nested call: ∂f/∂x0 = 2·x0.
fn ad_nested(t, vars, n): i64 {
    var y[8];
    store64(&y, _pv_bits(5.0));
    var gp, gn = PvKernelDerivatives_autodiff_gradient(&ad_sq, &y, 1);
    var c: f64 = 0.0;
    if (gn == 1) {
        c = load64(gp);
        fl_free(gp);
    }
    var x0 = load64(vars);
    var sq = ad_mul(t, x0, x0);
    return ad_add(t, sq, ad_var(t, c));
}

# A function whose root is no node, on a tape with room.
fn ad_bad(t, vars, n): i64 {
    return 0 - 1;
}

# 2.0.1 hardening (Cyrius-only): an f32 buffer refuses a size whose bytes overflow, and push_rounded grows it.
fn test_hardening() {
    test_group("hardening_f32_column");
    var c: PvF32Column;
    c.data = 0;
    c.len = 0;
    c.cap = 0;
    assert_eq(c.reserve(2305843009213693952), 0, "reserve refuses an n whose n · 4 overflows");
    assert(c.cap == 0 && c.data == 0, "and leaves the buffer empty");
    var ok = 1;
    for (var i = 0; i < 20; i = i + 1) { ok = ok & c.push_rounded(f64_from(i) + 0.5); }
    assert(ok == 1 && c.len == 20 && c.cap >= 20, "push_rounded grows past an unreserved capacity");
    var last: f64 = c.at(19);
    assert(last == 19.5, "and keeps every value");
    c.drop();

    test_group("hardening_autodiff_nested_and_bad_roots");
    var z[8];
    store64(&z, _pv_bits(3.0));
    var np, nn = PvKernelDerivatives_autodiff_gradient(&ad_nested, &z, 1);
    var n0: f64 = 0.0;
    if (nn == 1) { n0 = load64(np); }
    assert(nn == 1 && n0 == 6.0, "a gradient inside f keeps the outer recording: 6 at 3 (10 before 2.0.1)");
    fl_free(np);
    var before = alloc_used();
    var bp, bn = PvKernelDerivatives_autodiff_gradient(&ad_bad, &z, 1);
    assert(bp == 0 && bn == 0, "a root that isn't a node is refused");
    assert(alloc_used() - before < 1048576, "at once, without growing the tape (1.6 GB before 2.0.1)");
    return 0;
}

# Runs the ported compute tests.
fn main() {
    alloc_init();
    test_packing();
    test_regressions();
    test_cyrius();
    test_derivatives();
    test_f32_reads();
    test_docs();
    test_clone();
    test_hardening();
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
