# parity.tcyr — replays the golden corpus (tests/golden/*.tsv) against the port.
#
# Port plan §4 step 7, adapted from impetus's tests/parity_2d.tcyr (its M0 version), itself kimiya's
# and tanmatra's. Format and comparison rules: scripts/oracle/README.md. The module list is
# tests/golden/modules.txt, which the generator writes. The replay machinery is
# tests/parity_core.cyr; this file holds the hooks and the dispatchers.
#
# Every row of every module is one of:
# - ok: every output matched within its class;
# - FAILED: an output differs; the first 10 per module are printed with the row's note and both
#   bit patterns;
# - measured: class C, with no bound set yet for its function. The ulp distance is recorded but
#   not gated. Bounds are set per function before its first gated comparison (M0 step 8,
#   docs/development/port-parity.md);
# - accepted (ADR 4): a row of the corrected oracle (tests/golden/<module>.cr.tsv, ADR 0004) where the
#   oracle's libm misrounded and the port matches the correctly rounded outputs instead;
# - accepted (another ADR): a divergence an ADR accepts (none yet);
# - pending: its function isn't ported yet (no dispatcher entry).
#
# Per function it prints the row counts and the ulp histogram, which is the step 8 baseline.
# Shadow lines (`fn ~ candidate`) compare the same rows against another Cyrius candidate and are
# never gated. The exit code is the number of modules with a failure.

include "tests/ulp.cyr"
include "tests/lib.cyr"

alloc_init();

include "tests/parity_core.cyr"
include "tests/constants_rows.cyr"

# ── hooks ───────────────────────────────────────────────────────────────────────────

# The Rust variant name of an error code (src/error.cyr), which the golden `E:<Variant>` token names.
#must_use
fn _par_error_name(code): i64 {
    return pv_error_name(code);
}

# ── cross-target digests (M0 step 8) ────────────────────────────────────────────────
# A 64-bit FNV-1a fold of every output word the port returns for a function, in row order. Run on
# x86_64 ELF, x86_64 PE and aarch64: equal digests mean bit-identical results on every row, which is
# what ADR 0002 #7 promises for pravash-owned arithmetic. Histograms alone can't show that.
# Slots 0–9 are the dispatched class-C functions, 10 the class-A/B math rows together, 11 the
# constants, 12–14 the native shadows (which differ on aarch64 by design: there the builtins are
# the polyfills).
var _PAR_DG_N = 15;
var _par_dg[120];

fn _par_dg_init() {
    for (var k = 0; k < _PAR_DG_N; k = k + 1) { store64(&_par_dg + k * 8, 0xcbf29ce484222325); }
    return 0;
}

# The digest slot of a math function's dispatched outputs.
#must_use
fn _par_dg_slot(fp, fl): i64 {
    if (_par_eq(fp, fl, "f64::sin_cos") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::sin") == 1) { return 1; }
    if (_par_eq(fp, fl, "f64::cos") == 1) { return 2; }
    if (_par_eq(fp, fl, "f64::atan2") == 1) { return 3; }
    if (_par_eq(fp, fl, "f64::hypot") == 1) { return 4; }
    if (_par_eq(fp, fl, "f64::exp") == 1) { return 5; }
    if (_par_eq(fp, fl, "f64::ln") == 1) { return 6; }
    if (_par_eq(fp, fl, "f64::log10") == 1) { return 7; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { return 8; }
    if (_par_eq(fp, fl, "f64::cbrt") == 1) { return 9; }
    return 10;
}

# Folds the got list into digest `slot`.
fn _par_dg_fold(slot) {
    var at = &_par_dg + slot * 8;
    var h = load64(at);
    for (var k = 0; k < _par_got_n; k = k + 1) {
        h = (h ^ load64(_par_got_v + k * 8)) * 0x100000001b3;
    }
    store64(at, h);
    return 0;
}

# Prints digest `slot` under `name`.
fn _par_dg_print(slot, name) {
    print("  digest ", 9);
    _par_print_pad(name, strlen(name), 34);
    print(" 0x", 3);
    fmt_hex(load64(&_par_dg + slot * 8));
    println("");
    return 0;
}

# ── candidates ──────────────────────────────────────────────────────────────────────
# ganita_f64_atan2 (lib/ganita.cyr, 1.2.15) with `_f64_atan_polyfill` in place of the `f64_atan`
# builtin, which is x87 on x86_64 and the polyfill on aarch64: the same bits on every target
# (impetus port-parity §2). Words in, word out, as ganita. M1a part 1's atan2; a shadow since
# part 2, which dispatches the correctly rounded one (ledger L1).
fn _cand_atan2_poly(y, x): i64 {
    var ay = y & 0x7FFFFFFFFFFFFFFF;
    var ax = x & 0x7FFFFFFFFFFFFFFF;
    if (ay > 0x7FF0000000000000) { return y; }
    if (ax > 0x7FF0000000000000) { return x; }
    var ysign = y & 0x8000000000000000;
    var xneg = (x >> 63) & 1;
    if (ay == 0) {
        if (xneg == 1) { return F64_PI | ysign; }
        return y;
    }
    if (ax == 0) { return F64_PI_2 | ysign; }
    if ((ay == 0x7FF0000000000000) && (ax == 0x7FF0000000000000)) {
        if (xneg == 1) { return _F64_3PI_4 | ysign; }
        return F64_PI_4 | ysign;
    }
    var q = _f64_atan_polyfill(f64_div(y, x));
    if (xneg == 0) { return q; }
    if (ysign != 0) { return f64_sub(q, F64_PI); }
    return f64_add(q, F64_PI);
}

# ── dispatch ────────────────────────────────────────────────────────────────────────
# Each module's dispatcher fills the got list for one row. It returns 1 when it handled the
# function, 0 when the function is pending (not ported), or -1 when the inputs are unusable (a
# defect, counted as a failure). Add a function the moment it's ported.

# `const` rows (input `s:<path>`): src/constants.cyr's value for the path, through the generated
# lookup (tests/constants_rows.cyr). An unknown path is a defect.
fn _par_constants(fp, fl): i64 {
    if (_par_eq(fp, fl, "const") != 1 || _par_in_n != 1) { return 0 - 1; }
    return _par_constant_row(load64(_par_in_v), load64(_par_in_l));
}

# `f64::*` rows: the Rust std reference values (port plan §7.1). Dispatched:
# - the builtins (sqrt, abs, floor, ceil) and `as f32` (f32_from, f32_to);
# - src/mathx.cyr's Rust-semantics helpers (M1a part 1): min, max, clamp, is_nan, is_finite, to_radians, powi2,
#   powi8, and the saturating `as usize` / `as u32`;
# - src/mathx.cyr's correctly rounded transcendentals (M1a part 2, ADR 0004): sin_cos, sin, cos, exp, ln, log10,
#   atan2, hypot and powf on src/crmath.cyr and src/crlog.cyr (ledger L1), cbrt on ganita's.
# Pending: the SPH cell key (src/neighbor.cyr, M4).
fn _par_math(fp, fl): i64 {
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::sqrt") == 1) { var r: f64 = f64_sqrt(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::abs") == 1) { var r: f64 = f64_abs(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::floor") == 1) { var r: f64 = f64_floor(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::ceil") == 1) { var r: f64 = f64_ceil(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::is_nan") == 1) { _par_got_i(_pv_is_nan(x)); return 1; }
    if (_par_eq(fp, fl, "f64::is_finite") == 1) { _par_got_i(_pv_is_finite(x)); return 1; }
    if (_par_eq(fp, fl, "f64::as_usize") == 1) { _par_got_i(_pv_as_usize(x)); return 1; }
    if (_par_eq(fp, fl, "f64::as_u32") == 1) { _par_got_i(_pv_as_u32(x)); return 1; }
    if (_par_eq(fp, fl, "f64::to_radians") == 1) { var r: f64 = _pv_to_radians(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi2") == 1) { var r: f64 = _pv_powi2(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi8") == 1) { var r: f64 = _pv_powi8(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::as_f32") == 1) {
        var n: f32 = f32_from(x);
        var w: f64 = f32_to(n);
        _par_got_f(w);
        return 1;
    }
    if (_par_eq(fp, fl, "f64::sin_cos") == 1) {
        var s, c = _pv_sin_cos(x);
        var sv: f64 = s;
        var cv: f64 = c;
        _par_got_f(sv);
        _par_got_f(cv);
        return 1;
    }
    if (_par_eq(fp, fl, "f64::sin") == 1) { var r: f64 = _pv_sin(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::cos") == 1) { var r: f64 = _pv_cos(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::exp") == 1) { var r: f64 = _pv_exp(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::ln") == 1) { var r: f64 = _pv_ln(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::log10") == 1) { var r: f64 = _pv_log10(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::cbrt") == 1) { var r: f64 = _pv_cbrt(x); _par_got_f(r); return 1; }
    if (_par_in_n < 2) { return 0; }
    var y: f64 = _par_in(1);
    # Rust's y.atan2(x) is the golden f64::atan2(y, x): inputs in C order.
    if (_par_eq(fp, fl, "f64::atan2") == 1) { var r: f64 = _pv_atan2(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::hypot") == 1) { var r: f64 = _pv_hypot(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { var r: f64 = _pv_powf(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::max") == 1) { var r: f64 = _pv_max(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::min") == 1) { var r: f64 = _pv_min(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::rem") == 1) { var r: f64 = _pv_fmod(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "oracle::sph_cell_key") == 1) { _par_got_i(_pv_sph_cell_key(x, y)); return 1; }
    if (_par_in_n < 3) { return 0; }
    var z: f64 = _par_in(2);
    if (_par_eq(fp, fl, "f64::clamp") == 1) { var r: f64 = _pv_clamp(x, y, z); _par_got_f(r); return 1; }
    return 0;
}

# ── common (M1 part 3) ──────────────────────────────────────────────────────────────
# Token layouts: scripts/oracle/src/m_common.rs. A particle is 18 tokens, a config 14, a material 4.

# The particle whose 18 tokens start at input k, into *p.
fn _par_particle_in(k, p: *PvFluidParticle) {
    p.position = PvVec3_new(_par_in(k), _par_in(k + 1), _par_in(k + 2));
    p.velocity = PvVec3_new(_par_in(k + 3), _par_in(k + 4), _par_in(k + 5));
    p.acceleration = PvVec3_new(_par_in(k + 6), _par_in(k + 7), _par_in(k + 8));
    p.density = _par_in(k + 9);
    p.pressure = _par_in(k + 10);
    p.mass = _par_in(k + 11);
    p.phase = _par_in(k + 12);
    var c0: f64 = _par_in(k + 13);
    var c1: f64 = _par_in(k + 14);
    var c2: f64 = _par_in(k + 15);
    p.conformation = (c0, c1, c2);
    p.temperature = _par_in(k + 16);
    p.fuel = _par_in(k + 17);
    return 0;
}

# Appends the particle's 18 tokens.
fn _par_particle_out(p: *PvFluidParticle) {
    _par_got_f(_pv_bits(p.position.x));
    _par_got_f(_pv_bits(p.position.y));
    _par_got_f(_pv_bits(p.position.z));
    _par_got_f(_pv_bits(p.velocity.x));
    _par_got_f(_pv_bits(p.velocity.y));
    _par_got_f(_pv_bits(p.velocity.z));
    _par_got_f(_pv_bits(p.acceleration.x));
    _par_got_f(_pv_bits(p.acceleration.y));
    _par_got_f(_pv_bits(p.acceleration.z));
    _par_got_f(_pv_bits(p.density));
    _par_got_f(_pv_bits(p.pressure));
    _par_got_f(_pv_bits(p.mass));
    _par_got_i(p.phase);
    _par_got_f(_pv_bits(p.conformation.0));
    _par_got_f(_pv_bits(p.conformation.1));
    _par_got_f(_pv_bits(p.conformation.2));
    _par_got_f(_pv_bits(p.temperature));
    _par_got_f(_pv_bits(p.fuel));
    return 0;
}

# The config whose 14 tokens start at input k, into *c.
fn _par_config_in(k, c: *PvFluidConfig) {
    c.dt = _par_in(k);
    c.gravity = PvVec3_new(_par_in(k + 1), _par_in(k + 2), _par_in(k + 3));
    c.smoothing_radius = _par_in(k + 4);
    c.gas_constant = _par_in(k + 5);
    c.rest_density = _par_in(k + 6);
    c.bounds_min = PvVec3_new(_par_in(k + 7), _par_in(k + 8), _par_in(k + 9));
    c.bounds_max = PvVec3_new(_par_in(k + 10), _par_in(k + 11), _par_in(k + 12));
    c.boundary_damping = _par_in(k + 13);
    return 0;
}

# Appends the config's 14 tokens.
fn _par_config_out(c: *PvFluidConfig) {
    _par_got_f(_pv_bits(c.dt));
    _par_got_f(_pv_bits(c.gravity.x));
    _par_got_f(_pv_bits(c.gravity.y));
    _par_got_f(_pv_bits(c.gravity.z));
    _par_got_f(_pv_bits(c.smoothing_radius));
    _par_got_f(_pv_bits(c.gas_constant));
    _par_got_f(_pv_bits(c.rest_density));
    _par_got_f(_pv_bits(c.bounds_min.x));
    _par_got_f(_pv_bits(c.bounds_min.y));
    _par_got_f(_pv_bits(c.bounds_min.z));
    _par_got_f(_pv_bits(c.bounds_max.x));
    _par_got_f(_pv_bits(c.bounds_max.y));
    _par_got_f(_pv_bits(c.bounds_max.z));
    _par_got_f(_pv_bits(c.boundary_damping));
    return 0;
}

# Appends a unit Result: nothing for Ok, `E:<Variant>` for Err.
fn _par_unit_out(t, v) {
    if (is_err_result(t) == 1) { _par_got_err(v); }
    return 0;
}

# Particle k of a (pointer, count) view.
fn _par_pk(p, k): *PvFluidParticle {
    var ps: *PvFluidParticle = _pv_as_particles(p);
    return ps + k;
}

# A typed view of a word.
#must_use
fn _par_as_handles(p): *PvArenaHandle {
    return p;
}

# One `ParticleArena::scenario` row (the op codes: scripts/oracle/src/m_common.rs).
fn _par_arena_scenario(): i64 {
    var cap = _par_in(0);
    var a: *PvParticleArena = PvParticleArena_new(cap);
    if (a == 0) { return 0 - 1; }
    var nops = (_par_in_n - 1) / 4;
    var issued = fl_alloc(nops * sizeof(PvArenaHandle) + 8);
    var hs: *PvArenaHandle = _par_as_handles(issued);
    var ni = 0;
    for (var k = 0; k < nops; k = k + 1) {
        var code = _par_in(1 + k * 4);
        var arg = _par_in(2 + k * 4);
        if (code == 0) {
            var h: PvArenaHandle;
            if (a.alloc(arg, &h) == 1) {
                _par_got_i(1);
                _par_got_i(h.start);
                _par_got_i(h.len);
                _par_got_i(h.generation);
                var bp, bn = a.get_mut(h);
                var mass: f64 = f64_from(k + 1);
                for (var j = 0; j < bn; j = j + 1) { _par_pk(bp, j).mass = mass; }
                var slot: *PvArenaHandle = hs + ni;
                *slot = h;
                ni = ni + 1;
            } else {
                _par_got_i(0);
                _par_got_i(0);
                _par_got_i(0);
                _par_got_i(0);
            }
        } elif (code == 1 || code == 3) {
            if (ni == 0) {
                _par_got_i(0 - 1);
            } else {
                var src: *PvArenaHandle = hs + (arg % ni);
                var hi: PvArenaHandle = *src;
                if (code == 1) {
                    a.free(hi);
                    _par_got_i(a.active_count());
                } else {
                    var gp, gn = a.get(hi);
                    _par_got_i(gn);
                }
            }
        } elif (code == 2) {
            _par_got_i(a.compact());
        } else {
            var hf: PvArenaHandle;
            hf.start = arg;
            hf.len = _par_in(3 + k * 4);
            hf.generation = _par_in(4 + k * 4);
            if (code == 4) {
                a.free(hf);
                _par_got_i(a.active_count());
            } else {
                var fp2, fn2 = a.get(hf);
                _par_got_i(fn2);
            }
        }
    }
    _par_got_i(a.watermark);
    _par_got_i(a.generation);
    _par_got_seq(a.free_count * 2);
    for (var q = 0; q < a.free_count; q = q + 1) {
        _par_got_i(a._fs(q));
        _par_got_i(a._fl(q));
    }
    var rp, rn = a.raw_slice();
    _par_got_seq(rn);
    for (var r = 0; r < rn; r = r + 1) { _par_got_f(_pv_bits(_par_pk(rp, r).mass)); }
    fl_free(issued);
    PvParticleArena_drop(a);
    return 1;
}

# `common` rows: src/common.cyr.
fn _par_common(fp, fl): i64 {
    if (_par_eq(fp, fl, "FluidMaterial::custom") == 1) {
        var m: PvFluidMaterial;
        var t, v = PvFluidMaterial_custom(_par_in(0), _par_in(1), _par_in(2), _par_in(3), &m);
        if (is_err_result(t) == 1) { _par_got_err(v); return 1; }
        _par_got_f(_pv_bits(m.density));
        _par_got_f(_pv_bits(m.viscosity));
        _par_got_f(_pv_bits(m.surface_tension));
        _par_got_f(_pv_bits(m.speed_of_sound));
        return 1;
    }
    if (_par_eq(fp, fl, "FluidParticle::new") == 1) {
        var p: PvFluidParticle = PvFluidParticle_new(PvVec3_new(_par_in(0), _par_in(1), _par_in(2)), _par_in(3));
        _par_particle_out(&p);
        return 1;
    }
    if (_par_eq(fp, fl, "FluidParticle::new_2d") == 1) {
        var p2: PvFluidParticle = PvFluidParticle_new_2d(_par_in(0), _par_in(1), _par_in(2));
        _par_particle_out(&p2);
        return 1;
    }
    if (_par_eq(fp, fl, "FluidParticle::speed_squared") == 1 || _par_eq(fp, fl, "FluidParticle::speed") == 1
      || _par_eq(fp, fl, "FluidParticle::kinetic_energy") == 1) {
        var q: PvFluidParticle = PvFluidParticle_new_2d(0.0, 0.0, _par_in(3));
        q.velocity = PvVec3_new(_par_in(0), _par_in(1), _par_in(2));
        var r: f64 = q.kinetic_energy();
        if (_par_eq(fp, fl, "FluidParticle::speed_squared") == 1) { r = q.speed_squared(); }
        if (_par_eq(fp, fl, "FluidParticle::speed") == 1) { r = q.speed(); }
        _par_got_f(_pv_bits(r));
        return 1;
    }
    if (_par_eq(fp, fl, "FluidParticle::distance_squared_to") == 1
      || _par_eq(fp, fl, "FluidParticle::distance_to") == 1) {
        var a: PvFluidParticle = PvFluidParticle_new(PvVec3_new(_par_in(0), _par_in(1), _par_in(2)), 1.0);
        var b: PvFluidParticle = PvFluidParticle_new(PvVec3_new(_par_in(3), _par_in(4), _par_in(5)), 1.0);
        var d: f64 = a.distance_to(&b);
        if (_par_eq(fp, fl, "FluidParticle::distance_squared_to") == 1) { d = a.distance_squared_to(&b); }
        _par_got_f(_pv_bits(d));
        return 1;
    }
    if (_par_eq(fp, fl, "ParticleSoa::distance_squared") == 1) {
        var two = fl_alloc(2 * sizeof(PvFluidParticle));
        var pa: PvFluidParticle = PvFluidParticle_new(PvVec3_new(_par_in(0), _par_in(1), _par_in(2)), 1.0);
        var pb: PvFluidParticle = PvFluidParticle_new(PvVec3_new(_par_in(3), _par_in(4), _par_in(5)), 1.0);
        *_par_pk(two, 0) = pa;
        *_par_pk(two, 1) = pb;
        var s: PvParticleSoa;
        if (PvParticleSoa_from_aos(&s, _par_pk(two, 0), 2) == 0) { return 0 - 1; }
        var ds: f64 = s.distance_squared(0, 1);
        _par_got_f(_pv_bits(ds));
        PvParticleSoa_drop(&s);
        fl_free(two);
        return 1;
    }
    if (_par_eq(fp, fl, "FluidConfig::water_2d") == 1) {
        var c: PvFluidConfig = PvFluidConfig_water_2d();
        _par_config_out(&c);
        return 1;
    }
    if (_par_eq(fp, fl, "FluidConfig::validate") == 1) {
        var cv: PvFluidConfig;
        _par_config_in(0, &cv);
        var tv, vv = cv.validate();
        _par_unit_out(tv, vv);
        return 1;
    }
    if (_par_eq(fp, fl, "FluidConfig::check_cfl") == 1) {
        var cc: PvFluidConfig;
        _par_config_in(0, &cc);
        var tc, vc = cc.check_cfl(_par_in(14));
        _par_unit_out(tc, vc);
        return 1;
    }
    if (_par_eq(fp, fl, "ParticleSoa::roundtrip") == 1) {
        var one = fl_alloc(sizeof(PvFluidParticle));
        _par_particle_in(0, _par_pk(one, 0));
        var s1: PvParticleSoa;
        if (PvParticleSoa_from_aos(&s1, _par_pk(one, 0), 1) == 0) { return 0 - 1; }
        var bp, bn = s1.to_aos();
        if (bn != 1) { return 0 - 1; }
        _par_particle_out(_par_pk(bp, 0));
        fl_free(bp);
        PvParticleSoa_drop(&s1);
        fl_free(one);
        return 1;
    }
    if (_par_eq(fp, fl, "ParticleSoa::consistent_len") == 1) {
        var six = fl_alloc(6 * sizeof(PvFluidParticle));
        var base: PvFluidParticle = PvFluidParticle_new_2d(1.0, 2.0, 1.0);
        for (var i = 0; i < 6; i = i + 1) { *_par_pk(six, i) = base; }
        var s6: PvParticleSoa;
        if (PvParticleSoa_from_aos(&s6, _par_pk(six, 0), 6) == 0) { return 0 - 1; }
        for (var k = 0; k < 18; k = k + 1) {
            var col: *PvColumn = _pv_soa_col(&s6, k);
            col.truncate(_par_in(k));
        }
        _par_got_i(s6.len());
        _par_got_i(s6.consistent_len());
        _par_got_i(s6.is_consistent());
        var ap, an = s6.to_aos();
        _par_got_i(an);
        if (ap != 0) { fl_free(ap); }
        PvParticleSoa_drop(&s6);
        fl_free(six);
        return 1;
    }
    if (_par_eq(fp, fl, "ParticleArena::scenario") == 1) { return _par_arena_scenario(); }
    return 0;
}

# ── buoyancy, vortex, bridge (M1 part 4) ─────────────────────────────────────────────
# Token layouts: scripts/oracle/src/m_buoyancy.rs, m_vortex.rs, m_bridge.rs.

# Appends an f64 Result: `f:` for Ok, `E:<Variant>` for Err.
fn _par_f64_result(t, v) {
    if (is_err_result(t) == 1) { _par_got_err(v); return 0; }
    _par_got_f(v);
    return 0;
}

# The golden text `<Enum>.<Variant>` as a C string (the enum name is a C string literal).
fn _par_enum_text(en, variant): i64 {
    var a = strlen(en);
    var b = strlen(variant);
    var s = alloc(a + b + 2);
    memcpy(s, en, a);
    store8(s + a, 46);
    memcpy(s + a + 1, variant, b);
    store8(s + a + b + 1, 0);
    return s;
}

fn _par_buoyancy(fp, fl): i64 {
    if (_par_eq(fp, fl, "buoyancy_force") == 1) {
        var r: f64 = buoyancy_force(_par_in(0), _par_in(1), _par_in(2));
        _par_got_f(_pv_bits(r));
        return 1;
    }
    if (_par_eq(fp, fl, "drag_force") == 1) {
        var d: f64 = drag_force(_par_in(0), _par_in(1), _par_in(2), _par_in(3));
        _par_got_f(_pv_bits(d));
        return 1;
    }
    if (_par_eq(fp, fl, "terminal_velocity") == 1) {
        var t, v = terminal_velocity(_par_in(0), _par_in(1), _par_in(2), _par_in(3), _par_in(4));
        _par_f64_result(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "reynolds_number") == 1) {
        var t2, v2 = reynolds_number(_par_in(0), _par_in(1), _par_in(2), _par_in(3));
        _par_f64_result(t2, v2);
        return 1;
    }
    if (_par_eq(fp, fl, "classify_flow") == 1) {
        _par_got_e(_par_enum_text("FlowRegime", flow_regime_name(classify_flow(_par_in(0)))));
        return 1;
    }
    return 0;
}

fn _par_vortex(fp, fl): i64 {
    if (_par_eq(fp, fl, "vorticity_2d") == 1) {
        var w: f64 = vorticity_2d(_par_in(0), _par_in(1));
        _par_got_f(_pv_bits(w));
        return 1;
    }
    if (_par_eq(fp, fl, "lamb_oseen_velocity") == 1) {
        var l: f64 = lamb_oseen_velocity(_par_in(0), _par_in(1), _par_in(2), _par_in(3));
        _par_got_f(_pv_bits(l));
        return 1;
    }
    if (_par_eq(fp, fl, "rankine_velocity") == 1) {
        var r: f64 = rankine_velocity(_par_in(0), _par_in(1), _par_in(2));
        _par_got_f(_pv_bits(r));
        return 1;
    }
    if (_par_eq(fp, fl, "enstrophy") == 1) {
        var n = _par_in(0);
        var buf = alloc(n * 8 + 8);
        var k = _par_in_f64s(0, buf);
        var e: f64 = enstrophy(buf, k, _par_in(1 + n));
        _par_got_f(_pv_bits(e));
        return 1;
    }
    if (_par_eq(fp, fl, "kolmogorov_scale") == 1) {
        var s: f64 = kolmogorov_scale(_par_in(0), _par_in(1));
        _par_got_f(_pv_bits(s));
        return 1;
    }
    return 0;
}

fn _par_bridge(fp, fl): i64 {
    if (_par_eq(fp, fl, "cp_to_surface_pressure") == 1) {
        var a: f64 = cp_to_surface_pressure(_par_in(0), _par_in(1), _par_in(2));
        _par_got_f(_pv_bits(a));
        return 1;
    }
    if (_par_eq(fp, fl, "freestream_dynamic_pressure") == 1) {
        var b: f64 = freestream_dynamic_pressure(_par_in(0), _par_in(1));
        _par_got_f(_pv_bits(b));
        return 1;
    }
    if (_par_eq(fp, fl, "aero_coefficients_to_forces") == 1) {
        var l, d = aero_coefficients_to_forces(_par_in(0), _par_in(1), _par_in(2), _par_in(3));
        _par_got_f(l);
        _par_got_f(d);
        return 1;
    }
    if (_par_eq(fp, fl, "wind_to_freestream") == 1) {
        var w: f64 = wind_to_freestream(_par_in(0));
        _par_got_f(_pv_bits(w));
        return 1;
    }
    if (_par_eq(fp, fl, "temperature_to_water_viscosity") == 1) {
        var mu: f64 = temperature_to_water_viscosity(_par_in(0));
        _par_got_f(_pv_bits(mu));
        return 1;
    }
    if (_par_eq(fp, fl, "heat_to_buoyancy_forcing") == 1) {
        var h: f64 = heat_to_buoyancy_forcing(_par_in(0), _par_in(1), _par_in(2), _par_in(3), _par_in(4), _par_in(5));
        _par_got_f(_pv_bits(h));
        return 1;
    }
    if (_par_eq(fp, fl, "tke_to_eddy_diffusivity") == 1) {
        var e: f64 = tke_to_eddy_diffusivity(_par_in(0), _par_in(1));
        _par_got_f(_pv_bits(e));
        return 1;
    }
    if (_par_eq(fp, fl, "velocity_to_acoustic_source_strength") == 1) {
        var s: f64 = velocity_to_acoustic_source_strength(_par_in(0), _par_in(1));
        _par_got_f(_pv_bits(s));
        return 1;
    }
    if (_par_eq(fp, fl, "tke_to_broadband_noise_db") == 1) {
        var n: f64 = tke_to_broadband_noise_db(_par_in(0));
        _par_got_f(_pv_bits(n));
        return 1;
    }
    if (_par_eq(fp, fl, "wave_height_to_acoustic_pressure") == 1) {
        var p: f64 = wave_height_to_acoustic_pressure(_par_in(0), _par_in(1), _par_in(2));
        _par_got_f(_pv_bits(p));
        return 1;
    }
    return 0;
}

# ── json (M1 part 4) ───────────────────────────────────────────────────────────────
# Each row decodes the oracle's document (D4: the same bits), then round-trips the port's own encoding of the
# decoded value: write it, read it back, compare the bytes. A failed round trip makes the row unusable (-1, counted
# as a failure). The `_bayan_*` rows (bayan's stricter policies) have no entry: pending.

# The Str the builder sb holds.
fn _par_sb_text(sb) {
    var s = str_builder_build(sb);
    return (str_data(s), str_len(s));
}

# A round trip of the `n`-byte record at `rec` through `to_json` / `from_json`: 1 when the bytes come back.
fn _par_json_record(kind, rec, n): i64 {
    var sb = str_builder_new();
    var back = alloc(n + 8);
    var rc = 0;
    if (kind == 0) { var m: *PvFluidMaterial = _pv_as_material(rec); rc = m.to_json(sb); }
    if (kind == 1) { var q: *PvFluidParticle = _pv_as_particles(rec); rc = q.to_json(sb); }
    if (kind == 2) { var c: *PvFluidConfig = _pv_as_config(rec); rc = c.to_json(sb); }
    if (rc != 0) { return 0; }
    var d, dl = _par_sb_text(sb);
    var t = 0;
    var v = 0;
    if (kind == 0) { t, v = PvFluidMaterial_from_json(d, dl, _pv_as_material(back)); }
    if (kind == 1) { t, v = PvFluidParticle_from_json(d, dl, _pv_as_particles(back)); }
    if (kind == 2) { t, v = PvFluidConfig_from_json(d, dl, _pv_as_config(back)); }
    if (is_err_result(t) == 1) { return 0; }
    return memeq(rec, back, n);
}

fn _par_json(fp, fl): i64 {
    var doc = _par_in_cstr(0);
    if (doc == 0) { return 0 - 1; }
    var dl = strlen(doc);
    if (_par_eq(fp, fl, "FluidMaterial::from_json") == 1) {
        var m: PvFluidMaterial;
        var t, v = PvFluidMaterial_from_json(doc, dl, &m);
        if (is_err_result(t) == 1) { _par_got_err(v); return 1; }
        _par_got_f(_pv_bits(m.density));
        _par_got_f(_pv_bits(m.viscosity));
        _par_got_f(_pv_bits(m.surface_tension));
        _par_got_f(_pv_bits(m.speed_of_sound));
        if (_par_json_record(0, &m, sizeof(PvFluidMaterial)) == 0) { return 0 - 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "FluidParticle::from_json") == 1) {
        var p: PvFluidParticle;
        var t2, v2 = PvFluidParticle_from_json(doc, dl, &p);
        if (is_err_result(t2) == 1) { _par_got_err(v2); return 1; }
        _par_particle_out(&p);
        if (_par_json_record(1, &p, sizeof(PvFluidParticle)) == 0) { return 0 - 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "FluidConfig::from_json") == 1) {
        var c: PvFluidConfig;
        var t3, v3 = PvFluidConfig_from_json(doc, dl, &c);
        if (is_err_result(t3) == 1) { _par_got_err(v3); return 1; }
        _par_config_out(&c);
        if (_par_json_record(2, &c, sizeof(PvFluidConfig)) == 0) { return 0 - 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "ParticleSoa::from_json") == 1) {
        var s: PvParticleSoa;
        var t4, v4 = PvParticleSoa_from_json(doc, dl, &s);
        if (is_err_result(t4) == 1) { _par_got_err(v4); return 1; }
        for (var k = 0; k < 18; k = k + 1) {
            var col: *PvColumn = _pv_soa_col(&s, k);
            _par_got_seq(col.len);
            for (var j = 0; j < col.len; j = j + 1) {
                if (k == 12) { _par_got_i(col.get(j)); } else { _par_got_f(col.get(j)); }
            }
        }
        # The round trip: every column's length and words come back.
        var sb = str_builder_new();
        if (s.to_json(sb) != 0) { return 0 - 1; }
        var d, n = _par_sb_text(sb);
        var s2: PvParticleSoa;
        var t5, v5 = PvParticleSoa_from_json(d, n, &s2);
        if (is_err_result(t5) == 1) { return 0 - 1; }
        for (var k2 = 0; k2 < 18; k2 = k2 + 1) {
            var a: *PvColumn = _pv_soa_col(&s, k2);
            var b: *PvColumn = _pv_soa_col(&s2, k2);
            if (a.len != b.len) { return 0 - 1; }
            if (a.len > 0 && memeq(a.data, b.data, a.len * 8) != 1) { return 0 - 1; }
        }
        PvParticleSoa_drop(&s);
        PvParticleSoa_drop(&s2);
        return 1;
    }
    if (_par_eq(fp, fl, "FlowRegime::from_json") == 1) {
        var r = 0;
        var t6, v6 = flow_regime_from_json(doc, dl, &r);
        if (is_err_result(t6) == 1) { _par_got_err(v6); return 1; }
        _par_got_e(_par_enum_text("FlowRegime", flow_regime_name(r)));
        var sb2 = str_builder_new();
        if (flow_regime_to_json(r, sb2) != 0) { return 0 - 1; }
        var d2, n2 = _par_sb_text(sb2);
        var r2 = 0 - 1;
        var t7, v7 = flow_regime_from_json(d2, n2, &r2);
        if (r2 != r) { return 0 - 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "DragCoefficient::from_json") == 1) {
        var t8, v8 = drag_coefficient_from_json(doc, dl);
        if (is_err_result(t8) == 1) { _par_got_err(v8); return 1; }
        var sb3 = str_builder_new();
        if (drag_coefficient_to_json(sb3) != 0) { return 0 - 1; }
        var d3, n3 = _par_sb_text(sb3);
        var t9, v9 = drag_coefficient_from_json(d3, n3);
        if (is_err_result(t9) == 1) { return 0 - 1; }
        return 1;
    }
    return 0;
}

# ── shallow (M2) ────────────────────────────────────────────────────────────────────
# A state is 11 scalars and 5 `v:<n>` fields (scripts/oracle/src/m_shallow.rs).

# A column of `n` f64 words from the input tokens at k into *c (empty first): 1, or 0 for no memory.
fn _par_col_in(k, n, c: *PvColumn): i64 {
    c.data = 0;
    c.len = 0;
    c.cap = 0;
    if (c.resize(n, 0) == 0) { return 0; }
    for (var j = 0; j < n; j = j + 1) { store64(c.data + j * 8, _par_in(k + j)); }
    return 1;
}

# Appends a column as `v:<n>` and its f64s.
fn _par_col_out(c: *PvColumn) {
    _par_got_seq(c.len);
    for (var j = 0; j < c.len; j = j + 1) { _par_got_f(load64(c.data + j * 8)); }
    return 0;
}

# The state whose tokens start at input k into *sw (scratch empty): the index after it, or -1 for no memory.
fn _par_sw_in(k, sw: *PvShallowWater): i64 {
    sw.nx = _par_in(k);
    sw.ny = _par_in(k + 1);
    sw.dx = _par_in(k + 2);
    sw.gravity = _par_in(k + 3);
    sw.damping = _par_in(k + 4);
    sw.dry_threshold = _par_in(k + 5);
    sw.breaking_threshold = _par_in(k + 6);
    sw.breaking_dissipation = _par_in(k + 7);
    sw.dispersion_coeff = _par_in(k + 8);
    sw.use_green_naghdi = _par_in(k + 9);
    sw.use_riemann = _par_in(k + 10);
    for (var z = 5; z < _PV_SW_COLUMNS; z = z + 1) {
        var s: *PvColumn = _pv_sw_col(sw, z);
        s.data = 0;
        s.len = 0;
        s.cap = 0;
    }
    var at = k + 11;
    for (var c = 0; c < 5; c = c + 1) {
        var n = _par_in(at);
        if (_par_col_in(at + 1, n, _pv_sw_col(sw, c)) == 0) { return 0 - 1; }
        at = at + 1 + n;
    }
    return at;
}

# Appends a state's 11 scalars and 5 fields.
fn _par_sw_out(sw: *PvShallowWater) {
    _par_got_i(sw.nx);
    _par_got_i(sw.ny);
    _par_got_f(_pv_bits(sw.dx));
    _par_got_f(_pv_bits(sw.gravity));
    _par_got_f(_pv_bits(sw.damping));
    _par_got_f(_pv_bits(sw.dry_threshold));
    _par_got_f(_pv_bits(sw.breaking_threshold));
    _par_got_f(_pv_bits(sw.breaking_dissipation));
    _par_got_f(_pv_bits(sw.dispersion_coeff));
    _par_got_i(sw.use_green_naghdi);
    _par_got_i(sw.use_riemann);
    for (var c = 0; c < 5; c = c + 1) { _par_col_out(_pv_sw_col(sw, c)); }
    return 0;
}

fn _par_shallow(fp, fl): i64 {
    var sw: PvShallowWater;
    if (_par_eq(fp, fl, "ShallowWater::new") == 1) {
        var t, v = PvShallowWater_new(_par_in(0), _par_in(1), _par_in(2), _par_in(3), &sw);
        if (is_err_result(t) == 1) { _par_got_err(v); return 1; }
        _par_got_i(sw.nx);
        _par_got_i(sw.ny);
        _par_got_f(_pv_bits(sw.dx));
        _par_got_f(_pv_bits(sw.gravity));
        _par_got_f(_pv_bits(sw.damping));
        _par_got_f(_pv_bits(sw.dry_threshold));
        _par_got_f(_pv_bits(sw.breaking_threshold));
        _par_got_f(_pv_bits(sw.breaking_dissipation));
        _par_got_f(_pv_bits(sw.dispersion_coeff));
        _par_got_i(sw.use_green_naghdi);
        _par_got_i(sw.use_riemann);
        for (var c = 0; c < 5; c = c + 1) {
            var col: *PvColumn = _pv_sw_col(&sw, c);
            _par_got_i(col.len);
            _par_got_f(load64(col.data));
        }
        for (var s = 5; s < _PV_SW_COLUMNS; s = s + 1) {
            var sc: *PvColumn = _pv_sw_col(&sw, s);
            _par_got_i(sc.len);
        }
        PvShallowWater_drop(&sw);
        return 1;
    }
    if (_par_eq(fp, fl, "SedimentConfig::default") == 1) {
        var d: PvSedimentConfig = PvSedimentConfig_default();
        _par_got_f(_pv_bits(d.shields_critical));
        _par_got_f(_pv_bits(d.grain_diameter));
        _par_got_f(_pv_bits(d.sediment_density));
        _par_got_f(_pv_bits(d.water_density));
        _par_got_f(_pv_bits(d.erosion_rate));
        _par_got_f(_pv_bits(d.deposition_rate));
        return 1;
    }
    if (_par_eq(fp, fl, "ShallowWater::from_json") == 1) {
        var doc = _par_in_cstr(0);
        if (doc == 0) { return 0 - 1; }
        var tj, vj = PvShallowWater_from_json(doc, strlen(doc), &sw);
        if (is_err_result(tj) == 1) { _par_got_err(vj); return 1; }
        _par_sw_out(&sw);
        # The round trip: write it, read it back, compare every scalar and field.
        var sb = str_builder_new();
        if (sw.to_json(sb) != 0) { return 0 - 1; }
        var d2, n2 = _par_sb_text(sb);
        var sw2: PvShallowWater;
        var t2, v2 = PvShallowWater_from_json(d2, n2, &sw2);
        if (is_err_result(t2) == 1) { return 0 - 1; }
        if (memeq(&sw, &sw2, 24) != 1) { return 0 - 1; }
        for (var c2 = 0; c2 < 5; c2 = c2 + 1) {
            var a: *PvColumn = _pv_sw_col(&sw, c2);
            var b: *PvColumn = _pv_sw_col(&sw2, c2);
            if (a.len != b.len) { return 0 - 1; }
            if (a.len > 0 && memeq(a.data, b.data, a.len * 8) != 1) { return 0 - 1; }
        }
        PvShallowWater_drop(&sw);
        PvShallowWater_drop(&sw2);
        return 1;
    }
    # Every other row starts with a state.
    var k = _par_sw_in(0, &sw);
    if (k < 0) { return 0 - 1; }
    var n = sw.nx * sw.ny;
    var handled = 1;
    if (_par_eq(fp, fl, "ShallowWater::depth_at") == 1) {
        _par_got_seq(n);
        for (var i = 0; i < n; i = i + 1) {
            var dd: f64 = sw.depth_at(i % sw.nx, i / sw.nx);
            _par_got_f(_pv_bits(dd));
        }
    } elif (_par_eq(fp, fl, "ShallowWater::surface_at") == 1) {
        _par_got_seq(n);
        for (var i = 0; i < n; i = i + 1) {
            var ss: f64 = sw.surface_at(i % sw.nx, i / sw.nx);
            _par_got_f(_pv_bits(ss));
        }
    } elif (_par_eq(fp, fl, "ShallowWater::is_wet") == 1) {
        _par_got_seq(n);
        for (var i = 0; i < n; i = i + 1) { _par_got_i(sw.is_wet(i % sw.nx, i / sw.nx)); }
    } elif (_par_eq(fp, fl, "ShallowWater::is_breaking") == 1) {
        _par_got_seq(n);
        for (var i = 0; i < n; i = i + 1) { _par_got_i(sw.is_breaking(i % sw.nx, i / sw.nx)); }
    } elif (_par_eq(fp, fl, "ShallowWater::total_volume") == 1) {
        var tv: f64 = sw.total_volume();
        _par_got_f(_pv_bits(tv));
    } elif (_par_eq(fp, fl, "ShallowWater::interior_volume") == 1) {
        var iv: f64 = sw.interior_volume();
        _par_got_f(_pv_bits(iv));
    } elif (_par_eq(fp, fl, "ShallowWater::max_wave_height") == 1) {
        var mw: f64 = sw.max_wave_height(_par_in(k));
        _par_got_f(_pv_bits(mw));
    } elif (_par_eq(fp, fl, "ShallowWater::cfl_dt") == 1) {
        var cf: f64 = sw.cfl_dt(_par_in(k));
        _par_got_f(_pv_bits(cf));
    } elif (_par_eq(fp, fl, "ShallowWater::add_disturbance") == 1) {
        sw.add_disturbance(_par_in(k), _par_in(k + 1), _par_in(k + 2), _par_in(k + 3));
        _par_col_out(_pv_sw_col(&sw, 0));
    } elif (_par_eq(fp, fl, "ShallowWater::step") == 1) {
        # The state stepped nsteps times; the first failure's code if one fails.
        var dt: f64 = _par_in(k);
        var steps = _par_in(k + 1);
        var failed = 0;
        for (var s = 0; s < steps; s = s + 1) {
            var ts, vs = sw.step(dt);
            if (is_err_result(ts) == 1) {
                _par_got_err(vs);
                failed = 1;
                break;
            }
        }
        if (failed == 0) { _par_sw_out(&sw); }
    } elif (_par_eq(fp, fl, "update_sediment") == 1) {
        var nc = _par_in(k);
        var conc = alloc(nc * 8 + 8);
        for (var j = 0; j < nc; j = j + 1) { store64(conc + j * 8, _par_in(k + 1 + j)); }
        var ck = k + 1 + nc;
        var cfg: PvSedimentConfig;
        cfg.shields_critical = _par_in(ck);
        cfg.grain_diameter = _par_in(ck + 1);
        cfg.sediment_density = _par_in(ck + 2);
        cfg.water_density = _par_in(ck + 3);
        cfg.erosion_rate = _par_in(ck + 4);
        cfg.deposition_rate = _par_in(ck + 5);
        update_sediment(&sw, conc, nc, &cfg, _par_in(ck + 6));
        _par_col_out(_pv_sw_col(&sw, 3));
        _par_got_seq(nc);
        for (var j2 = 0; j2 < nc; j2 = j2 + 1) { _par_got_f(load64(conc + j2 * 8)); }
    } else {
        handled = 0;
    }
    PvShallowWater_drop(&sw);
    return handled;
}

# ── grid (M3) ───────────────────────────────────────────────────────────────────────
# A state is nx, ny, dx and 4 `v:<n>` fields; a config is 13 tokens (scripts/oracle/src/m_grid.rs).

# The state whose tokens start at input k into *g (scratch and levels empty): the index after it, or -1 for no
# memory.
fn _par_fg_in(k, g: *PvFluidGrid): i64 {
    _pv_fg_zero(g);
    g.nx = _par_in(k);
    g.ny = _par_in(k + 1);
    g.dx = _par_in(k + 2);
    var at = k + 3;
    for (var c = 0; c < 4; c = c + 1) {
        var n = _par_in(at);
        if (_par_col_in(at + 1, n, _pv_fg_col(g, c)) == 0) { return 0 - 1; }
        at = at + 1 + n;
    }
    return at;
}

# Appends a state's 3 scalars and 4 fields.
fn _par_fg_out(g: *PvFluidGrid) {
    _par_got_i(g.nx);
    _par_got_i(g.ny);
    _par_got_f(_pv_bits(g.dx));
    for (var c = 0; c < 4; c = c + 1) { _par_col_out(_pv_fg_col(g, c)); }
    return 0;
}

# Appends the scratch dump: the 4 scratch lengths, the level count, each level's 3 lengths.
fn _par_fg_dump(g: *PvFluidGrid) {
    for (var c = 4; c < 8; c = c + 1) {
        var s: *PvColumn = _pv_fg_col(g, c);
        _par_got_i(s.len);
    }
    var lv: *PvColumn = _pv_fg_col(g, 8);
    _par_got_i(lv.len);
    for (var j = 0; j < lv.len; j = j + 1) {
        var r = load64(lv.data + j * 8);
        for (var q = 0; q < 3; q = q + 1) {
            var col: *PvColumn = _pv_mg_col(r, q);
            _par_got_i(col.len);
        }
    }
    return 0;
}

# The boundary condition named by the `e:BoundaryCondition.<Variant>` token k, or -1.
fn _par_bc_in(k): i64 {
    var p = _par_in(k);
    var n = load64(_par_in_l + k * 8);
    if (_par_eq(p, n, "BoundaryCondition.NoSlip") == 1) { return PV_BOUNDARY_CONDITION_NO_SLIP; }
    if (_par_eq(p, n, "BoundaryCondition.FreeSlip") == 1) { return PV_BOUNDARY_CONDITION_FREE_SLIP; }
    if (_par_eq(p, n, "BoundaryCondition.Periodic") == 1) { return PV_BOUNDARY_CONDITION_PERIODIC; }
    return 0 - 1;
}

# The config whose 13 tokens start at input k into *c.
fn _par_gc_in(k, c: *PvGridConfig) {
    c.dt = _par_in(k);
    c.viscosity = _par_in(k + 1);
    c.diffusion_iterations = _par_in(k + 2);
    c.pressure_iterations = _par_in(k + 3);
    c.boundary = _par_bc_in(k + 4);
    c.vorticity_confinement = _par_in(k + 5);
    c.buoyancy_alpha = _par_in(k + 6);
    c.ambient_density = _par_in(k + 7);
    c.use_maccormack = _par_in(k + 8);
    c.use_bfecc = _par_in(k + 9);
    c.smagorinsky_cs = _par_in(k + 10);
    c.use_multigrid = _par_in(k + 11);
    c.use_cg = _par_in(k + 12);
    return 0;
}

# Appends a config's 13 tokens.
fn _par_gc_out(c: *PvGridConfig) {
    _par_got_f(_pv_bits(c.dt));
    _par_got_f(_pv_bits(c.viscosity));
    _par_got_i(c.diffusion_iterations);
    _par_got_i(c.pressure_iterations);
    _par_got_e(_par_enum_text("BoundaryCondition", boundary_condition_name(c.boundary)));
    _par_got_f(_pv_bits(c.vorticity_confinement));
    _par_got_f(_pv_bits(c.buoyancy_alpha));
    _par_got_f(_pv_bits(c.ambient_density));
    _par_got_i(c.use_maccormack);
    _par_got_i(c.use_bfecc);
    _par_got_f(_pv_bits(c.smagorinsky_cs));
    _par_got_i(c.use_multigrid);
    _par_got_i(c.use_cg);
    return 0;
}

# The JSON rows: decode the oracle's document, then round-trip the port's encoding of the result.
fn _par_grid_json(fp, fl): i64 {
    var doc = _par_in_cstr(0);
    if (doc == 0) { return 0 - 1; }
    var dl = strlen(doc);
    var sb = str_builder_new();
    if (_par_eq(fp, fl, "BoundaryCondition::from_json") == 1) {
        var k = 0;
        var t, v = boundary_condition_from_json(doc, dl, &k);
        if (is_err_result(t) == 1) { _par_got_err(v); return 1; }
        _par_got_e(_par_enum_text("BoundaryCondition", boundary_condition_name(k)));
        if (boundary_condition_to_json(k, sb) != 0) { return 0 - 1; }
        var d, n = _par_sb_text(sb);
        var k2 = 0 - 1;
        var t2, v2 = boundary_condition_from_json(d, n, &k2);
        if (is_err_result(t2) == 1 || k2 != k) { return 0 - 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "GridConfig::from_json") == 1) {
        var c: PvGridConfig;
        var tc, vc = PvGridConfig_from_json(doc, dl, &c);
        if (is_err_result(tc) == 1) { _par_got_err(vc); return 1; }
        _par_gc_out(&c);
        if (c.to_json(sb) != 0) { return 0 - 1; }
        var dc, nc = _par_sb_text(sb);
        var c2: PvGridConfig;
        var tc2, vc2 = PvGridConfig_from_json(dc, nc, &c2);
        if (is_err_result(tc2) == 1 || memeq(&c, &c2, 104) != 1) { return 0 - 1; }
        return 1;
    }
    var g: PvFluidGrid;
    var tg, vg = PvFluidGrid_from_json(doc, dl, &g);
    if (is_err_result(tg) == 1) { _par_got_err(vg); return 1; }
    _par_fg_out(&g);
    if (g.to_json(sb) != 0) { return 0 - 1; }
    var dg, ng = _par_sb_text(sb);
    var g2: PvFluidGrid;
    var tg2, vg2 = PvFluidGrid_from_json(dg, ng, &g2);
    if (is_err_result(tg2) == 1 || memeq(&g, &g2, 24) != 1) { return 0 - 1; }
    for (var c3 = 0; c3 < 4; c3 = c3 + 1) {
        var a: *PvColumn = _pv_fg_col(&g, c3);
        var b: *PvColumn = _pv_fg_col(&g2, c3);
        if (a.len != b.len) { return 0 - 1; }
        if (a.len > 0 && memeq(a.data, b.data, a.len * 8) != 1) { return 0 - 1; }
    }
    PvFluidGrid_drop(&g);
    PvFluidGrid_drop(&g2);
    return 1;
}

# The f64 column whose `v:<n>` token is at input k into *c: the index after it, or -1 for no memory.
fn _par_vcol_in(k, c: *PvColumn): i64 {
    var n = _par_in(k);
    if (_par_col_in(k + 1, n, c) == 0) { return 0 - 1; }
    return k + 1 + n;
}

# ── sph (M4) ────────────────────────────────────────────────────────────────────────
# scripts/oracle/src/m_sph.rs: part a, the kernels, the equations of state, the non-Newtonian viscosity models and
# the batch and whole-system helpers.

# The kernel named by fp at (r, h) (kernel_wendland_c4_grad for any other name: the caller checks the name).
#must_use
fn _par_kernel(fp, fl, r: f64, h: f64): f64 {
    if (_par_eq(fp, fl, "kernel_poly6") == 1) { var a: f64 = kernel_poly6(r, h); return a; }
    if (_par_eq(fp, fl, "kernel_spiky_grad") == 1) { var b: f64 = kernel_spiky_grad(r, h); return b; }
    if (_par_eq(fp, fl, "kernel_viscosity_laplacian") == 1) {
        var c: f64 = kernel_viscosity_laplacian(r, h);
        return c;
    }
    if (_par_eq(fp, fl, "kernel_wendland_c2") == 1) { var d: f64 = kernel_wendland_c2(r, h); return d; }
    if (_par_eq(fp, fl, "kernel_wendland_c2_grad") == 1) { var g: f64 = kernel_wendland_c2_grad(r, h); return g; }
    if (_par_eq(fp, fl, "kernel_wendland_c4") == 1) { var q: f64 = kernel_wendland_c4(r, h); return q; }
    var w: f64 = kernel_wendland_c4_grad(r, h);
    return w;
}

# The non-Newtonian kind named by the `e:NonNewtonianViscosity.<Variant>` token k, or -1.
fn _par_nn_kind(k): i64 {
    var p = _par_in(k);
    var n = load64(_par_in_l + k * 8);
    if (_par_eq(p, n, "NonNewtonianViscosity.PowerLaw") == 1) { return PV_NON_NEWTONIAN_VISCOSITY_POWER_LAW; }
    if (_par_eq(p, n, "NonNewtonianViscosity.Bingham") == 1) { return PV_NON_NEWTONIAN_VISCOSITY_BINGHAM; }
    if (_par_eq(p, n, "NonNewtonianViscosity.HerschelBulkley") == 1) {
        return PV_NON_NEWTONIAN_VISCOSITY_HERSCHEL_BULKLEY;
    }
    return 0 - 1;
}

# The CSR lists whose `v:` offsets start at input k, as two new word buffers: (offsets, indices). Their counts are
# `_par_in(k)` and `_par_in(k + 1 + offsets' count)`. The caller frees both buffers.
fn _par_lists_in(k) {
    var no = _par_in(k);
    var off = fl_alloc(no * 8 + 8);
    for (var a = 0; a < no; a = a + 1) { store64(off + a * 8, _par_in(k + 1 + a)); }
    var ni = _par_in(k + 1 + no);
    var idx = fl_alloc(ni * 8 + 8);
    for (var b = 0; b < ni; b = b + 1) { store64(idx + b * 8, _par_in(k + 2 + no + b)); }
    return (off, idx);
}

# The n particles whose 18 tokens each follow the `i:<n>` at input k, as a new buffer: (pointer, n, the input after).
fn _par_particles_in(k) {
    var n = _par_in(k);
    var buf = fl_alloc(n * sizeof(PvFluidParticle) + 8);
    var ps: *PvFluidParticle = _pv_as_particles(buf);
    for (var j = 0; j < n; j = j + 1) { _par_particle_in(k + 1 + j * 18, ps + j); }
    return (buf, n, k + 1 + n * 18);
}

# A `SecondaryType` variant's Rust name.
fn _par_secondary_name(kind): i64 {
    if (kind == PV_SECONDARY_TYPE_FOAM) { return "Foam"; }
    if (kind == PV_SECONDARY_TYPE_SPRAY) { return "Spray"; }
    if (kind == PV_SECONDARY_TYPE_BUBBLE) { return "Bubble"; }
    return "?";
}

# The secondary particle whose 8 tokens start at input k, into *s.
fn _par_secondary_in(k, s: *PvSecondaryParticle) {
    s.position = PvVec3_new(_par_in(k), _par_in(k + 1), _par_in(k + 2));
    s.velocity = PvVec3_new(_par_in(k + 3), _par_in(k + 4), _par_in(k + 5));
    s.lifetime = _par_in(k + 6);
    var p = _par_in(k + 7);
    var n = load64(_par_in_l + (k + 7) * 8);
    s.kind = 0 - 1;
    if (_par_eq(p, n, "SecondaryType.Foam") == 1) { s.kind = PV_SECONDARY_TYPE_FOAM; }
    if (_par_eq(p, n, "SecondaryType.Spray") == 1) { s.kind = PV_SECONDARY_TYPE_SPRAY; }
    if (_par_eq(p, n, "SecondaryType.Bubble") == 1) { s.kind = PV_SECONDARY_TYPE_BUBBLE; }
    return 0;
}

# Appends the secondary particle's 8 tokens.
fn _par_secondary_out(s: *PvSecondaryParticle) {
    _par_got_f(_pv_bits(s.position.x));
    _par_got_f(_pv_bits(s.position.y));
    _par_got_f(_pv_bits(s.position.z));
    _par_got_f(_pv_bits(s.velocity.x));
    _par_got_f(_pv_bits(s.velocity.y));
    _par_got_f(_pv_bits(s.velocity.z));
    _par_got_f(_pv_bits(s.lifetime));
    _par_got_e(_par_enum_text("SecondaryType", _par_secondary_name(s.kind)));
    return 0;
}

# The part d rows that take lists (M4 part d): 1 handled, 0 another function.
fn _par_sph_listed(fp, fl): i64 {
    var lead = 0;
    if (_par_eq(fp, fl, "update_viscoelastic") == 1 || _par_eq(fp, fl, "apply_delta_sph") == 1
      || _par_eq(fp, fl, "apply_implicit_viscosity") == 1) { lead = 4; }
    if (_par_eq(fp, fl, "update_heat") == 1) { lead = 3; }
    if (_par_eq(fp, fl, "compute_gradient_corrections") == 1) { lead = 1; }
    if (lead == 0) { return 0; }
    var buf, n, k = _par_particles_in(lead);
    var ps: *PvFluidParticle = _pv_as_particles(buf);
    var off, idx = _par_lists_in(k);
    var no = _par_in(k);
    var ni = _par_in(k + 1 + no);
    var h: f64 = _par_in(0);
    if (_par_eq(fp, fl, "compute_gradient_corrections") == 1) {
        var cp, cn = compute_gradient_corrections(ps, n, off, no, idx, ni, h);
        _par_got_seq(9 * cn);
        for (var c = 0; c < 9 * cn; c = c + 1) { _par_got_f(load64(cp + c * 8)); }
        if (cp != 0) { fl_free(cp); }
    } else {
        if (_par_eq(fp, fl, "update_viscoelastic") == 1) {
            var ve: PvViscoelasticConfig = PvViscoelasticConfig_new(_par_in(1), _par_in(2));
            var r1 = update_viscoelastic(ps, n, off, no, idx, ni, h, &ve, _par_in(3));
        }
        if (_par_eq(fp, fl, "update_heat") == 1) {
            var hc: PvHeatConfig = PvHeatConfig_new(_par_in(1));
            var r2 = update_heat(ps, n, off, no, idx, ni, h, &hc, _par_in(2));
        }
        if (_par_eq(fp, fl, "apply_delta_sph") == 1) {
            var r3 = apply_delta_sph(ps, n, off, no, idx, ni, h, _par_in(1), _par_in(2), _par_in(3));
        }
        if (_par_eq(fp, fl, "apply_implicit_viscosity") == 1) {
            var r4 = apply_implicit_viscosity(ps, n, off, no, idx, ni, h, _par_in(1), _par_in(2), _par_in(3));
        }
        for (var j = 0; j < n; j = j + 1) { _par_particle_out(ps + j); }
    }
    fl_free(off);
    fl_free(idx);
    fl_free(buf);
    return 1;
}

# The other part d rows (M4 part d): 1 handled, 0 another function.
fn _par_sph_d(fp, fl): i64 {
    if (_par_sph_listed(fp, fl) == 1) { return 1; }
    if (_par_eq(fp, fl, "oracle::invert_3x3") == 1) {
        var m[72];
        var out[72];
        for (var a = 0; a < 9; a = a + 1) { store64(&m + a * 8, _par_in(a)); }
        if (_pv_invert_3x3(&m, &out) == 1) {
            for (var b = 0; b < 9; b = b + 1) { _par_got_f(load64(&out + b * 8)); }
        } else {
            _par_got_none();
        }
        return 1;
    }
    if (_par_eq(fp, fl, "apply_gradient_correction") == 1) {
        var cm[72];
        for (var c = 0; c < 9; c = c + 1) { store64(&cm + c * 8, _par_in(c)); }
        var gw: PvVec3 = PvVec3_new(_par_in(9), _par_in(10), _par_in(11));
        var r: PvVec3 = apply_gradient_correction(&cm, gw);
        _par_got_f(_pv_bits(r.x));
        _par_got_f(_pv_bits(r.y));
        _par_got_f(_pv_bits(r.z));
        return 1;
    }
    if (_par_eq(fp, fl, "update_phase_change") == 1) {
        var pt: f64 = _par_in(0);
        var pl: f64 = _par_in(1);
        var pcp: f64 = _par_in(2);
        var pc: PvPhaseChangeConfig = PvPhaseChangeConfig_new(pt, pl, pcp, _par_in(3), _par_in(4));
        var pb, pn, pk = _par_particles_in(6);
        var pps: *PvFluidParticle = _pv_as_particles(pb);
        update_phase_change(pps, pn, &pc, _par_in(5));
        for (var j = 0; j < pn; j = j + 1) { _par_particle_out(pps + j); }
        fl_free(pb);
        return 1;
    }
    if (_par_eq(fp, fl, "update_reaction") == 1 || _par_eq(fp, fl, "update_combustion") == 1) {
        var cc: PvCombustionConfig;
        cc.ignition_temperature = _par_in(0);
        cc.reaction_rate = _par_in(1);
        cc.heat_release = _par_in(2);
        var cb, cn, ck = _par_particles_in(4);
        var cps: *PvFluidParticle = _pv_as_particles(cb);
        if (_par_eq(fp, fl, "update_reaction") == 1) {
            update_reaction(cps, cn, &cc, _par_in(3));
        } else {
            update_combustion(cps, cn, &cc, _par_in(3));
        }
        for (var j2 = 0; j2 < cn; j2 = j2 + 1) { _par_particle_out(cps + j2); }
        fl_free(cb);
        return 1;
    }
    if (_par_eq(fp, fl, "CombustionConfig::react") == 1) {
        var rc: PvCombustionConfig;
        rc.ignition_temperature = _par_in(0);
        rc.reaction_rate = _par_in(1);
        rc.heat_release = _par_in(2);
        var rr: PvReaction = rc.react(_par_in(3), _par_in(4), _par_in(5));
        _par_got_f(_pv_bits(rr.consumed));
        _par_got_f(_pv_bits(rr.heat));
        return 1;
    }
    if (_par_eq(fp, fl, "apply_contact_angle") == 1) {
        var ac: PvFluidConfig;
        _par_config_in(0, &ac);
        var ab, an, ak = _par_particles_in(16);
        var aps: *PvFluidParticle = _pv_as_particles(ab);
        apply_contact_angle(aps, an, &ac, _par_in(14), _par_in(15));
        for (var j3 = 0; j3 < an; j3 = j3 + 1) { _par_particle_out(aps + j3); }
        fl_free(ab);
        return 1;
    }
    if (_par_eq(fp, fl, "generate_secondary_particles") == 1) {
        var gb, gn, gk = _par_particles_in(2);
        var gps: *PvFluidParticle = _pv_as_particles(gb);
        var sp, sn = generate_secondary_particles(gps, gn, _par_in(0), _par_in(1));
        _par_got_seq(sn);
        var ss: *PvSecondaryParticle = _pv_as_secondaries(sp);
        for (var j4 = 0; j4 < sn; j4 = j4 + 1) { _par_secondary_out(ss + j4); }
        if (sp != 0) { fl_free(sp); }
        fl_free(gb);
        return 1;
    }
    if (_par_eq(fp, fl, "update_secondary_particles") == 1) {
        var g: PvVec3 = PvVec3_new(_par_in(0), _par_in(1), _par_in(2));
        var un = _par_in(4);
        var ub = fl_alloc(un * sizeof(PvSecondaryParticle) + 8);
        var us: *PvSecondaryParticle = _pv_as_secondaries(ub);
        for (var j5 = 0; j5 < un; j5 = j5 + 1) { _par_secondary_in(5 + j5 * 8, us + j5); }
        var kept = update_secondary_particles(us, un, g, _par_in(3));
        _par_got_seq(kept);
        for (var j6 = 0; j6 < kept; j6 = j6 + 1) { _par_secondary_out(us + j6); }
        fl_free(ub);
        return 1;
    }
    return 0;
}

fn _par_sph(fp, fl): i64 {
    if (_par_eq(fp, fl, "kernel_poly6") == 1 || _par_eq(fp, fl, "kernel_spiky_grad") == 1
      || _par_eq(fp, fl, "kernel_viscosity_laplacian") == 1 || _par_eq(fp, fl, "kernel_wendland_c2") == 1
      || _par_eq(fp, fl, "kernel_wendland_c2_grad") == 1 || _par_eq(fp, fl, "kernel_wendland_c4") == 1
      || _par_eq(fp, fl, "kernel_wendland_c4_grad") == 1) {
        var h: f64 = _par_in(0);
        var n = _par_in(1);
        _par_got_seq(n);
        for (var j = 0; j < n; j = j + 1) {
            var w: f64 = _par_kernel(fp, fl, _par_in(2 + j), h);
            _par_got_f(_pv_bits(w));
        }
        return 1;
    }
    if (_par_eq(fp, fl, "equation_of_state") == 1) {
        var p: f64 = equation_of_state(_par_in(0), _par_in(1), _par_in(2));
        _par_got_f(_pv_bits(p));
        return 1;
    }
    if (_par_eq(fp, fl, "equation_of_state_tait") == 1) {
        var pt: f64 = equation_of_state_tait(_par_in(0), _par_in(1), _par_in(2), _par_in(3));
        _par_got_f(_pv_bits(pt));
        return 1;
    }
    if (_par_eq(fp, fl, "NonNewtonianViscosity::effective_viscosity") == 1) {
        var m: PvNonNewtonianModel;
        m.kind = _par_nn_kind(0);
        m.consistency = _par_in(1);
        m.power_index = _par_in(2);
        m.yield_stress = _par_in(3);
        m.plastic_viscosity = _par_in(4);
        var nr = _par_in(5);
        _par_got_seq(nr);
        for (var j2 = 0; j2 < nr; j2 = j2 + 1) {
            var mu: f64 = non_newtonian_viscosity_effective_viscosity(&m, _par_in(6 + j2));
            _par_got_f(_pv_bits(mu));
        }
        return 1;
    }
    if (_par_eq(fp, fl, "batch_poly6") == 1) {
        var n2 = _par_in(0);
        var r2 = fl_alloc(n2 * 8 + 8);
        for (var j3 = 0; j3 < n2; j3 = j3 + 1) { store64(r2 + j3 * 8, _par_in(1 + j3)); }
        var bp, bn = batch_poly6(r2, n2, _par_in(1 + n2));
        _par_got_seq(bn);
        for (var j4 = 0; j4 < bn; j4 = j4 + 1) { _par_got_f(load64(bp + j4 * 8)); }
        if (bp != 0) { fl_free(bp); }
        fl_free(r2);
        return 1;
    }
    if (_par_eq(fp, fl, "batch_distance_squared") == 1) {
        var pos: PvVec3 = PvVec3_new(_par_in(0), _par_in(1), _par_in(2));
        var n3 = _par_in(3) / 3;
        var ps = fl_alloc(n3 * 24 + 8);
        for (var j5 = 0; j5 < n3 * 3; j5 = j5 + 1) { store64(ps + j5 * 8, _par_in(4 + j5)); }
        var dp, dn = batch_distance_squared(pos, ps, n3);
        _par_got_seq(dn);
        for (var j6 = 0; j6 < dn; j6 = j6 + 1) { _par_got_f(load64(dp + j6 * 8)); }
        if (dp != 0) { fl_free(dp); }
        fl_free(ps);
        return 1;
    }
    if (_par_eq(fp, fl, "SphSolver::neighbor_lists") == 1) {
        # Particles at the row's positions; a fresh grid (`SphSolver::new`'s), then one build.
        var h: f64 = _par_in(0);
        var n = _par_in(1);
        var buf = fl_alloc(n * sizeof(PvFluidParticle) + 8);
        var ps: *PvFluidParticle = _pv_as_particles(buf);
        for (var j = 0; j < n; j = j + 1) {
            var q: PvFluidParticle = PvFluidParticle_new_2d(0.0, 0.0, 0.001);
            q.position = PvVec3_new(_par_in(2 + 3 * j), _par_in(3 + 3 * j), _par_in(4 + 3 * j));
            memcpy(ps + j, &q, sizeof(PvFluidParticle));
        }
        var g: PvNeighborGrid;
        PvNeighborGrid_init(&g);
        if (_pv_nb_build(&g, ps, n, h) == 0) { return 0 - 1; }
        _par_got_f(_pv_bits(g.cell_size));
        _par_got_i(g.len);
        _par_got_i(g.cells);
        _par_col_out(_pv_nb_col(&g, 0));
        _par_got_seq(3 * n);
        for (var k = 0; k < 3 * n; k = k + 1) { _par_got_i(_pv_sph_cell_key(load64(g.pos32.data + k * 8), h)); }
        var off: *PvColumn = _pv_nb_col(&g, 5);
        _par_got_seq(off.len);
        for (var o = 0; o < off.len; o = o + 1) { _par_got_i(load64(off.data + o * 8)); }
        var idx: *PvColumn = _pv_nb_col(&g, 6);
        _par_got_seq(idx.len);
        for (var x = 0; x < idx.len; x = x + 1) { _par_got_i(load64(idx.data + x * 8)); }
        PvNeighborGrid_drop(&g);
        fl_free(buf);
        return 1;
    }
    if (_par_eq(fp, fl, "sort_by_zorder") == 1) {
        # The Morton codes of the output order (from the input's minima, as Rust's), then the particles.
        var cell: f64 = _par_in(0);
        var nz = _par_in(1);
        var zb = fl_alloc(nz * sizeof(PvFluidParticle) + 8);
        var zp: *PvFluidParticle = _pv_as_particles(zb);
        for (var j2 = 0; j2 < nz; j2 = j2 + 1) { _par_particle_in(2 + j2 * 18, zp + j2); }
        var mnx: f64 = PV_F64_MAX;
        var mny: f64 = PV_F64_MAX;
        for (var j3 = 0; j3 < nz; j3 = j3 + 1) {
            var pm: *PvFluidParticle = zp + j3;
            mnx = _pv_min(mnx, pm.position.x);
            mny = _pv_min(mny, pm.position.y);
        }
        if (sort_by_zorder(zp, nz, cell) == 1) {
            var inv: f64 = 1.0 / cell;
            _par_got_seq(nz);
            for (var j4 = 0; j4 < nz; j4 = j4 + 1) {
                var pz: *PvFluidParticle = zp + j4;
                var ddx: f64 = pz.position.x - mnx;
                var ddy: f64 = pz.position.y - mny;
                _par_got_i(_pv_morton_2d(ddx, ddy, inv));
            }
        } else {
            _par_got_seq(0);
        }
        for (var j5 = 0; j5 < nz; j5 = j5 + 1) { _par_particle_out(zp + j5); }
        fl_free(zb);
        return 1;
    }
    if (_par_eq(fp, fl, "compute_density") == 1 || _par_eq(fp, fl, "pressure_force") == 1
      || _par_eq(fp, fl, "viscosity_force") == 1) {
        # Each particle's value, in index order (part c).
        var fh: f64 = _par_in(0);
        var fmu: f64 = 0.0;
        var fk = 1;
        if (_par_eq(fp, fl, "viscosity_force") == 1) {
            fmu = _par_in(1);
            fk = 2;
        }
        var fnp = _par_in(fk);
        var fb = fl_alloc(fnp * sizeof(PvFluidParticle) + 8);
        var fps: *PvFluidParticle = _pv_as_particles(fb);
        for (var f1 = 0; f1 < fnp; f1 = f1 + 1) { _par_particle_in(fk + 1 + f1 * 18, fps + f1); }
        if (_par_eq(fp, fl, "compute_density") == 1) {
            _par_got_seq(fnp);
            for (var f2 = 0; f2 < fnp; f2 = f2 + 1) {
                var dv: f64 = compute_density(f2, fps, fnp, fh);
                _par_got_f(_pv_bits(dv));
            }
        } else {
            _par_got_seq(3 * fnp);
            for (var f3 = 0; f3 < fnp; f3 = f3 + 1) {
                var fv: PvVec3 = pressure_force(f3, fps, fnp, fh);
                if (fk == 2) { fv = viscosity_force(f3, fps, fnp, fh, fmu); }
                _par_got_f(_pv_bits(fv.x));
                _par_got_f(_pv_bits(fv.y));
                _par_got_f(_pv_bits(fv.z));
            }
        }
        fl_free(fb);
        return 1;
    }
    if (_par_eq(fp, fl, "step") == 1) {
        # The free step (`sph_step`), `steps` times, stopping at the first error.
        var sc: PvFluidConfig;
        _par_config_in(0, &sc);
        var smu: f64 = _par_in(14);
        var ssteps = _par_in(15);
        var snp = _par_in(16);
        var sb = fl_alloc(snp * sizeof(PvFluidParticle) + 8);
        var sps: *PvFluidParticle = _pv_as_particles(sb);
        for (var s1 = 0; s1 < snp; s1 = s1 + 1) { _par_particle_in(17 + s1 * 18, sps + s1); }
        for (var s2 = 0; s2 < ssteps; s2 = s2 + 1) {
            var st, sv = sph_step(sps, snp, &sc, smu);
            if (is_err_result(st) == 1) {
                _par_got_err(sv);
                fl_free(sb);
                return 1;
            }
        }
        for (var s3 = 0; s3 < snp; s3 = s3 + 1) { _par_particle_out(sps + s3); }
        fl_free(sb);
        return 1;
    }
    if (_par_eq(fp, fl, "create_particle_block") == 1) {
        var bp, bn = create_particle_block(_par_in(0), _par_in(1), _par_in(2), _par_in(3), _par_in(4), _par_in(5));
        _par_got_seq(bn);
        var bps: *PvFluidParticle = _pv_as_particles(bp);
        for (var b1 = 0; b1 < bn; b1 = b1 + 1) { _par_particle_out(bps + b1); }
        if (bp != 0) { fl_free(bp); }
        return 1;
    }
    if (_par_eq(fp, fl, "split_particle") == 1) {
        var parent: PvFluidParticle;
        _par_particle_in(0, &parent);
        var cp, cn = split_particle(&parent, _par_in(18), _par_in(19));
        _par_got_seq(cn);
        var cps: *PvFluidParticle = _pv_as_particles(cp);
        for (var c1 = 0; c1 < cn; c1 = c1 + 1) { _par_particle_out(cps + c1); }
        if (cp != 0) { fl_free(cp); }
        return 1;
    }
    if (_par_eq(fp, fl, "merge_particles") == 1) {
        var ma: PvFluidParticle;
        var mb: PvFluidParticle;
        _par_particle_in(0, &ma);
        _par_particle_in(18, &mb);
        var mm: PvFluidParticle = merge_particles(&ma, &mb);
        _par_particle_out(&mm);
        return 1;
    }
    if (_par_sph_d(fp, fl) == 1) { return 1; }
    if (_par_eq(fp, fl, "total_kinetic_energy") == 1 || _par_eq(fp, fl, "max_speed") == 1) {
        var np = _par_in(0);
        var buf = fl_alloc(np * sizeof(PvFluidParticle) + 8);
        var parts: *PvFluidParticle = _pv_as_particles(buf);
        for (var j7 = 0; j7 < np; j7 = j7 + 1) { _par_particle_in(1 + j7 * 18, parts + j7); }
        var r: f64 = 0.0;
        if (_par_eq(fp, fl, "max_speed") == 1) {
            r = max_speed(parts, np);
        } else {
            r = total_kinetic_energy(parts, np);
        }
        _par_got_f(_pv_bits(r));
        fl_free(buf);
        return 1;
    }
    return 0;
}

# ── vof and phase_field (M3 part d) ─────────────────────────────────────────────────
# A VOF state is nx, ny, dx, `v:` alpha; a phase-field state is nx, ny, dx, `v:` phi, mobility, epsilon
# (scripts/oracle/src/m_vof.rs, m_phase_field.rs). Each row's field is built as the generator's `fresh` builds it:
# `new(nx, ny, dx)`, or `new(4, 4, 0.1)` when that is refused or the size is 2^16 or more, then the public fields.

# 1 when a side is below 2^16 (as a usize), so `fresh` builds the field at its own size.
#must_use
fn _par_small(nx, ny): i64 {
    if (nx >= 0 && nx < 65536 && ny >= 0 && ny < 65536) { return 1; }
    return 0;
}

# The VOF state at input k into *v: the index after it, or -1 for no memory.
fn _par_vof_in(k, v: *PvVofField): i64 {
    var nx = _par_in(k);
    var ny = _par_in(k + 1);
    var dx: f64 = _par_in(k + 2);
    var built = 0;
    if (_par_small(nx, ny) == 1) {
        var t, e = PvVofField_new(nx, ny, dx, v);
        if (is_err_result(t) == 0) { built = 1; }
    }
    if (built == 0) {
        var t2, e2 = PvVofField_new(4, 4, 0.1, v);
        if (is_err_result(t2) == 1) { return 0 - 1; }
    }
    v.nx = nx;
    v.ny = ny;
    v.dx = dx;
    var a: *PvColumn = _pv_vof_col(v, 0);
    a.drop();
    var n = _par_in(k + 3);
    if (_par_col_in(k + 4, n, a) == 0) { return 0 - 1; }
    return k + 4 + n;
}

# Appends a VOF state.
fn _par_vof_out(v: *PvVofField) {
    _par_got_i(v.nx);
    _par_got_i(v.ny);
    _par_got_f(_pv_bits(v.dx));
    _par_col_out(_pv_vof_col(v, 0));
    return 0;
}

# The phase-field state at input k into *p: the index after it, or -1 for no memory.
fn _par_pf_in(k, p: *PvPhaseField): i64 {
    var nx = _par_in(k);
    var ny = _par_in(k + 1);
    var dx: f64 = _par_in(k + 2);
    var built = 0;
    if (_par_small(nx, ny) == 1) {
        var t, e = PvPhaseField_new(nx, ny, dx, p);
        if (is_err_result(t) == 0) { built = 1; }
    }
    if (built == 0) {
        var t2, e2 = PvPhaseField_new(4, 4, 0.1, p);
        if (is_err_result(t2) == 1) { return 0 - 1; }
    }
    p.nx = nx;
    p.ny = ny;
    p.dx = dx;
    var f: *PvColumn = _pv_pf_col(p, 0);
    f.drop();
    var n = _par_in(k + 3);
    if (_par_col_in(k + 4, n, f) == 0) { return 0 - 1; }
    p.mobility = _par_in(k + 4 + n);
    p.epsilon = _par_in(k + 5 + n);
    return k + 6 + n;
}

# Appends a phase-field state.
fn _par_pf_out(p: *PvPhaseField) {
    _par_got_i(p.nx);
    _par_got_i(p.ny);
    _par_got_f(_pv_bits(p.dx));
    _par_col_out(_pv_pf_col(p, 0));
    _par_got_f(_pv_bits(p.mobility));
    _par_got_f(_pv_bits(p.epsilon));
    return 0;
}

# The VOF query `q` (0 surface, 1 full, 2 empty) at a cell, at threshold t when `with_t`, else the default.
#must_use
fn _par_vof_q(v: *PvVofField, q, x, y, with_t, t: f64): i64 {
    if (with_t == 0) {
        if (q == 0) { return v.is_surface(x, y); }
        if (q == 1) { return v.is_full(x, y); }
        return v.is_empty(x, y);
    }
    if (q == 0) { return v.is_surface_with_threshold(x, y, t); }
    if (q == 1) { return v.is_full_with_threshold(x, y, t); }
    return v.is_empty_with_threshold(x, y, t);
}

fn _par_vof(fp, fl): i64 {
    if (_par_eq(fp, fl, "VofField::new") == 1) {
        var g: PvVofField;
        var t, e = PvVofField_new(_par_in(0), _par_in(1), _par_in(2), &g);
        if (is_err_result(t) == 1) { _par_got_err(e); return 1; }
        _par_got_i(g.nx);
        _par_got_i(g.ny);
        _par_got_f(_pv_bits(g.dx));
        _par_got_i(g.alpha.len);
        _par_got_f(load64(g.alpha.data));
        _par_got_i(g.scratch.len);
        PvVofField_drop(&g);
        return 1;
    }
    if (_par_eq(fp, fl, "VofField::from_json") == 1) {
        var doc = _par_in_cstr(0);
        if (doc == 0) { return 0 - 1; }
        var j: PvVofField;
        var tj, ej = PvVofField_from_json(doc, strlen(doc), &j);
        if (is_err_result(tj) == 1) { _par_got_err(ej); return 1; }
        _par_vof_out(&j);
        var sb = str_builder_new();
        if (j.to_json(sb) != 0) { return 0 - 1; }
        var d, n = _par_sb_text(sb);
        var j2: PvVofField;
        var tj2, ej2 = PvVofField_from_json(d, n, &j2);
        if (is_err_result(tj2) == 1 || memeq(&j, &j2, 24) != 1) { return 0 - 1; }
        if (_par_col_same(_pv_vof_col(&j, 0), _pv_vof_col(&j2, 0)) == 0) { return 0 - 1; }
        PvVofField_drop(&j);
        PvVofField_drop(&j2);
        return 1;
    }
    var v: PvVofField;
    var k = _par_vof_in(0, &v);
    if (k < 0) { return 0 - 1; }
    var nx = v.nx;
    var ny = v.ny;
    var handled = 1;
    var q = 0 - 1;
    var with_t = 0;
    if (_par_eq(fp, fl, "VofField::is_surface") == 1) { q = 0; }
    if (_par_eq(fp, fl, "VofField::is_full") == 1) { q = 1; }
    if (_par_eq(fp, fl, "VofField::is_empty") == 1) { q = 2; }
    if (_par_eq(fp, fl, "VofField::is_surface_with_threshold") == 1) { q = 0; with_t = 1; }
    if (_par_eq(fp, fl, "VofField::is_full_with_threshold") == 1) { q = 1; with_t = 1; }
    if (_par_eq(fp, fl, "VofField::is_empty_with_threshold") == 1) { q = 2; with_t = 1; }
    if (q >= 0) {
        var nt = 1;
        if (with_t == 1) { nt = _par_in(k); }
        _par_got_seq(nt * nx * ny);
        for (var it = 0; it < nt; it = it + 1) {
            var th: f64 = 0.0;
            if (with_t == 1) { th = _par_in(k + 1 + it); }
            for (var y = 0; y < ny; y = y + 1) {
                for (var x = 0; x < nx; x = x + 1) { _par_got_i(_par_vof_q(&v, q, x, y, with_t, th)); }
            }
        }
    } elif (_par_eq(fp, fl, "VofField::interface_normal") == 1) {
        _par_got_seq(2 * nx * ny);
        for (var y2 = 0; y2 < ny; y2 = y2 + 1) {
            for (var x2 = 0; x2 < nx; x2 = x2 + 1) {
                var a, c = v.interface_normal(x2, y2);
                var af: f64 = a;
                var cf: f64 = c;
                _par_got_f(_pv_bits(af));
                _par_got_f(_pv_bits(cf));
            }
        }
    } elif (_par_eq(fp, fl, "VofField::total_volume") == 1) {
        var tv: f64 = v.total_volume();
        _par_got_f(_pv_bits(tv));
    } elif (_par_eq(fp, fl, "VofField::fill_rect") == 1) {
        v.fill_rect(_par_in(k), _par_in(k + 1), _par_in(k + 2), _par_in(k + 3));
        _par_vof_out(&v);
    } elif (_par_eq(fp, fl, "VofField::fill_circle") == 1) {
        v.fill_circle(_par_in(k), _par_in(k + 1), _par_in(k + 2));
        _par_vof_out(&v);
    } elif (_par_eq(fp, fl, "VofField::advect") == 1) {
        var vx: PvColumn;
        var vy: PvColumn;
        var k1 = _par_vcol_in(k, &vx);
        if (k1 < 0) { return 0 - 1; }
        var k2 = _par_vcol_in(k1, &vy);
        if (k2 < 0) { return 0 - 1; }
        var steps = _par_in(k2 + 1);
        var failed = 0;
        for (var s = 0; s < steps; s = s + 1) {
            var ts, vs = v.advect(vx.data, vx.len, vy.data, vy.len, _par_in(k2));
            if (is_err_result(ts) == 1) {
                _par_got_err(vs);
                failed = 1;
                break;
            }
        }
        if (failed == 0) {
            _par_vof_out(&v);
            _par_got_i(v.scratch.len);
        }
        vx.drop();
        vy.drop();
    } else {
        handled = 0;
    }
    PvVofField_drop(&v);
    return handled;
}

fn _par_phase_field(fp, fl): i64 {
    if (_par_eq(fp, fl, "PhaseField::new") == 1) {
        var g: PvPhaseField;
        var t, e = PvPhaseField_new(_par_in(0), _par_in(1), _par_in(2), &g);
        if (is_err_result(t) == 1) { _par_got_err(e); return 1; }
        _par_pf_out(&g);
        _par_got_i(g.scratch.len);
        PvPhaseField_drop(&g);
        return 1;
    }
    if (_par_eq(fp, fl, "PhaseField::from_json") == 1) {
        var doc = _par_in_cstr(0);
        if (doc == 0) { return 0 - 1; }
        var j: PvPhaseField;
        var tj, ej = PvPhaseField_from_json(doc, strlen(doc), &j);
        if (is_err_result(tj) == 1) { _par_got_err(ej); return 1; }
        _par_pf_out(&j);
        var sb = str_builder_new();
        if (j.to_json(sb) != 0) { return 0 - 1; }
        var d, n = _par_sb_text(sb);
        var j2: PvPhaseField;
        var tj2, ej2 = PvPhaseField_from_json(d, n, &j2);
        if (is_err_result(tj2) == 1 || memeq(&j, &j2, 24) != 1 || memeq(&j + 48, &j2 + 48, 16) != 1) {
            return 0 - 1;
        }
        if (_par_col_same(_pv_pf_col(&j, 0), _pv_pf_col(&j2, 0)) == 0) { return 0 - 1; }
        PvPhaseField_drop(&j);
        PvPhaseField_drop(&j2);
        return 1;
    }
    var p: PvPhaseField;
    var k = _par_pf_in(0, &p);
    if (k < 0) { return 0 - 1; }
    var nx = p.nx;
    var ny = p.ny;
    var handled = 1;
    if (_par_eq(fp, fl, "PhaseField::is_phase_b") == 1) {
        _par_got_seq(nx * ny);
        for (var y = 0; y < ny; y = y + 1) {
            for (var x = 0; x < nx; x = x + 1) { _par_got_i(p.is_phase_b(x, y)); }
        }
    } elif (_par_eq(fp, fl, "PhaseField::is_interface") == 1) {
        var nt = _par_in(k);
        _par_got_seq(nt * nx * ny);
        for (var it = 0; it < nt; it = it + 1) {
            var th: f64 = _par_in(k + 1 + it);
            for (var y2 = 0; y2 < ny; y2 = y2 + 1) {
                for (var x2 = 0; x2 < nx; x2 = x2 + 1) { _par_got_i(p.is_interface(x2, y2, th)); }
            }
        }
    } elif (_par_eq(fp, fl, "PhaseField::phase_b_area") == 1) {
        var ar: f64 = p.phase_b_area();
        _par_got_f(_pv_bits(ar));
    } elif (_par_eq(fp, fl, "PhaseField::set_circle") == 1) {
        p.set_circle(_par_in(k), _par_in(k + 1), _par_in(k + 2));
        _par_pf_out(&p);
    } elif (_par_eq(fp, fl, "PhaseField::set_rect") == 1) {
        p.set_rect(_par_in(k), _par_in(k + 1), _par_in(k + 2), _par_in(k + 3));
        _par_pf_out(&p);
    } elif (_par_eq(fp, fl, "PhaseField::step") == 1) {
        var vx: PvColumn;
        var vy: PvColumn;
        var k1 = _par_vcol_in(k, &vx);
        if (k1 < 0) { return 0 - 1; }
        var k2 = _par_vcol_in(k1, &vy);
        if (k2 < 0) { return 0 - 1; }
        var steps = _par_in(k2 + 1);
        var failed = 0;
        for (var s = 0; s < steps; s = s + 1) {
            var ts, vs = p.step(vx.data, vx.len, vy.data, vy.len, _par_in(k2));
            if (is_err_result(ts) == 1) {
                _par_got_err(vs);
                failed = 1;
                break;
            }
        }
        if (failed == 0) {
            _par_pf_out(&p);
            _par_got_i(p.scratch.len);
        }
        vx.drop();
        vy.drop();
    } else {
        handled = 0;
    }
    PvPhaseField_drop(&p);
    return handled;
}

# ── grid, part c (M3): KEpsilon, apply_ghost_fluid, MacGrid ──────────────────────────
# A k-ε state is `v:` k, `v:` epsilon and the three constants; a MAC state is nx, ny, dx and 4 `v:<n>` fields
# (scripts/oracle/src/m_grid_c.rs).

# The k-ε state at input k into *m, made as the oracle makes it (`new(k.len(), 1)`, then the public fields, so the
# scratch is k's length): the index after it, or -1 for no memory.
fn _par_ke_in(k, m: *PvKEpsilon): i64 {
    var nk = _par_in(k);
    if (PvKEpsilon_new(nk, 1, m) == 0) { return 0 - 1; }
    var at = k;
    for (var j = 0; j < 2; j = j + 1) {
        var c: *PvColumn = _pv_ke_col(m, j);
        c.drop();
        var n = _par_in(at);
        if (_par_col_in(at + 1, n, c) == 0) { return 0 - 1; }
        at = at + 1 + n;
    }
    m.c_mu = _par_in(at);
    m.c_eps1 = _par_in(at + 1);
    m.c_eps2 = _par_in(at + 2);
    return at + 3;
}

# Appends a k-ε state's two columns and three constants.
fn _par_ke_out(m: *PvKEpsilon) {
    _par_col_out(_pv_ke_col(m, 0));
    _par_col_out(_pv_ke_col(m, 1));
    _par_got_f(_pv_bits(m.c_mu));
    _par_got_f(_pv_bits(m.c_eps1));
    _par_got_f(_pv_bits(m.c_eps2));
    return 0;
}

# The MAC state at input k into *g (scratch empty): the index after it, or -1 for no memory.
fn _par_mac_in(k, g: *PvMacGrid): i64 {
    _pv_mac_zero(g);
    g.nx = _par_in(k);
    g.ny = _par_in(k + 1);
    g.dx = _par_in(k + 2);
    var at = k + 3;
    for (var c = 0; c < 4; c = c + 1) {
        var n = _par_in(at);
        if (_par_col_in(at + 1, n, _pv_mac_col(g, c)) == 0) { return 0 - 1; }
        at = at + 1 + n;
    }
    return at;
}

# Appends a MAC state's 3 scalars and 4 fields.
fn _par_mac_out(g: *PvMacGrid) {
    _par_got_i(g.nx);
    _par_got_i(g.ny);
    _par_got_f(_pv_bits(g.dx));
    for (var c = 0; c < 4; c = c + 1) { _par_col_out(_pv_mac_col(g, c)); }
    return 0;
}

# 1 when two columns hold the same words.
#must_use
fn _par_col_same(a: *PvColumn, b: *PvColumn): i64 {
    if (a.len != b.len) { return 0; }
    if (a.len > 0 && memeq(a.data, b.data, a.len * 8) != 1) { return 0; }
    return 1;
}

# Part c's rows: 1 handled, -1 failed, 0 not one of them.
fn _par_grid_c(fp, fl): i64 {
    if (_par_eq(fp, fl, "KEpsilon::new") == 1) {
        var m: PvKEpsilon;
        if (PvKEpsilon_new(_par_in(0), _par_in(1), &m) == 0) { return 0 - 1; }
        _par_ke_out(&m);
        _par_got_i(m.scratch_k.len);
        _par_got_i(m.scratch_eps.len);
        PvKEpsilon_drop(&m);
        return 1;
    }
    if (_par_eq(fp, fl, "KEpsilon::turbulent_viscosity") == 1 || _par_eq(fp, fl, "KEpsilon::step") == 1) {
        var ke: PvKEpsilon;
        var k = _par_ke_in(0, &ke);
        if (k < 0) { return 0 - 1; }
        if (_par_eq(fp, fl, "KEpsilon::turbulent_viscosity") == 1) {
            _par_got_seq(ke.k.len);
            for (var i = 0; i < ke.k.len; i = i + 1) {
                var nu: f64 = ke.turbulent_viscosity(i);
                _par_got_f(_pv_bits(nu));
            }
        } else {
            var vx: PvColumn;
            var vy: PvColumn;
            var k1 = _par_vcol_in(k, &vx);
            if (k1 < 0) { return 0 - 1; }
            var k2 = _par_vcol_in(k1, &vy);
            if (k2 < 0) { return 0 - 1; }
            var steps = _par_in(k2 + 4);
            for (var s = 0; s < steps; s = s + 1) {
                var r = ke.step(vx.data, vx.len, vy.data, vy.len, _par_in(k2), _par_in(k2 + 1), _par_in(k2 + 2),
                  _par_in(k2 + 3));
            }
            _par_ke_out(&ke);
            _par_got_i(ke.scratch_k.len);
            _par_got_i(ke.scratch_eps.len);
            vx.drop();
            vy.drop();
        }
        PvKEpsilon_drop(&ke);
        return 1;
    }
    if (_par_eq(fp, fl, "apply_ghost_fluid") == 1) {
        var pc: PvColumn;
        var lc: PvColumn;
        var a1 = _par_vcol_in(0, &pc);
        if (a1 < 0) { return 0 - 1; }
        var a2 = _par_vcol_in(a1, &lc);
        if (a2 < 0) { return 0 - 1; }
        var ok = apply_ghost_fluid(pc.data, pc.len, lc.data, lc.len, _par_in(a2), _par_in(a2 + 1), _par_in(a2 + 2),
          _par_in(a2 + 3));
        _par_col_out(&pc);
        pc.drop();
        lc.drop();
        return 1;
    }
    if (_par_eq(fp, fl, "MacGrid::new") == 1) {
        var g: PvMacGrid;
        var t, v = PvMacGrid_new(_par_in(0), _par_in(1), _par_in(2), &g);
        if (is_err_result(t) == 1) { _par_got_err(v); return 1; }
        _par_got_i(g.nx);
        _par_got_i(g.ny);
        _par_got_f(_pv_bits(g.dx));
        for (var c = 0; c < 4; c = c + 1) {
            var col: *PvColumn = _pv_mac_col(&g, c);
            _par_got_i(col.len);
            _par_got_f(load64(col.data));
        }
        _par_got_i(g.scratch_div.len);
        _par_got_i(g.scratch_density.len);
        PvMacGrid_drop(&g);
        return 1;
    }
    if (_par_eq(fp, fl, "MacGrid::from_json") == 1 || _par_eq(fp, fl, "KEpsilon::from_json") == 1) {
        var doc = _par_in_cstr(0);
        if (doc == 0) { return 0 - 1; }
        var dl = strlen(doc);
        var sb = str_builder_new();
        if (_par_eq(fp, fl, "KEpsilon::from_json") == 1) {
            var m1: PvKEpsilon;
            var tk, vk = PvKEpsilon_from_json(doc, dl, &m1);
            if (is_err_result(tk) == 1) { _par_got_err(vk); return 1; }
            _par_ke_out(&m1);
            if (m1.to_json(sb) != 0) { return 0 - 1; }
            var dk, nk = _par_sb_text(sb);
            var m2: PvKEpsilon;
            var tk2, vk2 = PvKEpsilon_from_json(dk, nk, &m2);
            if (is_err_result(tk2) == 1) { return 0 - 1; }
            if (_par_col_same(_pv_ke_col(&m1, 0), _pv_ke_col(&m2, 0)) == 0) { return 0 - 1; }
            if (_par_col_same(_pv_ke_col(&m1, 1), _pv_ke_col(&m2, 1)) == 0) { return 0 - 1; }
            if (memeq(&m1 + 48, &m2 + 48, 24) != 1) { return 0 - 1; }
            PvKEpsilon_drop(&m1);
            PvKEpsilon_drop(&m2);
            return 1;
        }
        var g1: PvMacGrid;
        var tm, vm = PvMacGrid_from_json(doc, dl, &g1);
        if (is_err_result(tm) == 1) { _par_got_err(vm); return 1; }
        _par_mac_out(&g1);
        if (g1.to_json(sb) != 0) { return 0 - 1; }
        var dm, nm = _par_sb_text(sb);
        var g2: PvMacGrid;
        var tm2, vm2 = PvMacGrid_from_json(dm, nm, &g2);
        if (is_err_result(tm2) == 1 || memeq(&g1, &g2, 24) != 1) { return 0 - 1; }
        for (var c3 = 0; c3 < 4; c3 = c3 + 1) {
            if (_par_col_same(_pv_mac_col(&g1, c3), _pv_mac_col(&g2, c3)) == 0) { return 0 - 1; }
        }
        PvMacGrid_drop(&g1);
        PvMacGrid_drop(&g2);
        return 1;
    }
    if (_par_eq(fp, fl, "MacGrid::velocity_at") == 0 && _par_eq(fp, fl, "MacGrid::divergence_at") == 0
      && _par_eq(fp, fl, "MacGrid::max_speed") == 0 && _par_eq(fp, fl, "MacGrid::cfl_dt") == 0
      && _par_eq(fp, fl, "MacGrid::step") == 0) {
        return 0;
    }
    # The MAC rows that start with a state.
    var mg: PvMacGrid;
    var ks = _par_mac_in(0, &mg);
    if (ks < 0) { return 0 - 1; }
    var n = mg.nx * mg.ny;
    if (_par_eq(fp, fl, "MacGrid::velocity_at") == 1) {
        _par_got_seq(2 * n);
        for (var i2 = 0; i2 < n; i2 = i2 + 1) {
            var u, w = mg.velocity_at(i2 % mg.nx, i2 / mg.nx);
            var uf: f64 = u;
            var wf: f64 = w;
            _par_got_f(_pv_bits(uf));
            _par_got_f(_pv_bits(wf));
        }
    } elif (_par_eq(fp, fl, "MacGrid::divergence_at") == 1) {
        _par_got_seq(n);
        for (var i3 = 0; i3 < n; i3 = i3 + 1) {
            var dv: f64 = mg.divergence_at(i3 % mg.nx, i3 / mg.nx);
            _par_got_f(_pv_bits(dv));
        }
    } elif (_par_eq(fp, fl, "MacGrid::max_speed") == 1) {
        var ms: f64 = mg.max_speed();
        _par_got_f(_pv_bits(ms));
    } elif (_par_eq(fp, fl, "MacGrid::cfl_dt") == 1) {
        var m3 = _par_in(ks);
        _par_got_seq(m3);
        for (var j2 = 0; j2 < m3; j2 = j2 + 1) {
            var cf: f64 = mg.cfl_dt(_par_in(ks + 1 + j2));
            _par_got_f(_pv_bits(cf));
        }
    } else {
        var cfg: PvGridConfig;
        _par_gc_in(ks, &cfg);
        var steps2 = _par_in(ks + 13);
        var failed = 0;
        for (var s2 = 0; s2 < steps2; s2 = s2 + 1) {
            var ts, vs = mg.step(&cfg);
            if (is_err_result(ts) == 1) {
                _par_got_err(vs);
                failed = 1;
                break;
            }
        }
        if (failed == 0) {
            _par_mac_out(&mg);
            _par_got_i(mg.scratch_div.len);
            _par_got_i(mg.scratch_density.len);
        }
    }
    PvMacGrid_drop(&mg);
    return 1;
}

# ── the thread counts (M3 part e) ───────────────────────────────────────────────────
# Every `FluidGrid::step` row runs at one thread, which the golden outputs gate, and again at each count below on a
# freshly loaded grid. Each must give the one-thread words exactly: Rust's three `parallel` loops run on src/par.cyr's
# pool, and every row is written by one thread. 3 splits the rows unevenly; 8 leaves workers without rows on the
# small grids.
var _PAR_THREADS = 4;
var _par_threads[32];
var _par_mt_rows = 0;
var _par_mt_bad = 0;

# The row's state stepped nsteps times by its config (input ks on), then the state and the scratch dump, or the
# first failure's code.
fn _par_fg_steps(g: *PvFluidGrid, ks) {
    var cfg: PvGridConfig;
    _par_gc_in(ks, &cfg);
    var steps = _par_in(ks + 13);
    for (var s = 0; s < steps; s = s + 1) {
        var ts, vs = g.step(&cfg);
        if (is_err_result(ts) == 1) {
            _par_got_err(vs);
            return 0;
        }
    }
    _par_fg_out(g);
    _par_fg_dump(g);
    return 0;
}

# 1 when got word j equals the snapshot's (kind, value, length; a text by its bytes).
#must_use
fn _par_got_same(j, sk, sv, sl): i64 {
    var at = j * 8;
    var k = load64(_par_got_k + at);
    var v = load64(_par_got_v + at);
    var l = load64(_par_got_l + at);
    if (k != load64(sk + at) || l != load64(sl + at)) { return 0; }
    if (k == 102 || k == 105 || k == 118) {
        if (v != load64(sv + at)) { return 0; }
        return 1;
    }
    if (l > 0 && memeq(v, load64(sv + at), l) != 1) { return 0; }
    return 1;
}

# Re-runs the current step row at each thread count and compares every output word with the one-thread run: 1 when
# all agree. The got list is left as the one-thread run made it.
fn _par_fg_threads_agree(ks): i64 {
    if (load64(&_par_threads) == 0) {
        store64(&_par_threads, 2);
        store64(&_par_threads + 8, 3);
        store64(&_par_threads + 16, 4);
        store64(&_par_threads + 24, 8);
    }
    var n0 = _par_got_n;
    var sk = fl_alloc(n0 * 8 + 8);
    var sv = fl_alloc(n0 * 8 + 8);
    var sl = fl_alloc(n0 * 8 + 8);
    if (sk == 0 || sv == 0 || sl == 0) { return 0; }
    memcpy(sk, _par_got_k, n0 * 8);
    memcpy(sv, _par_got_v, n0 * 8);
    memcpy(sl, _par_got_l, n0 * 8);
    var ok = 1;
    for (var t = 0; t < _PAR_THREADS; t = t + 1) {
        var threads = load64(&_par_threads + t * 8);
        _par_got_n = 0;
        var g: PvFluidGrid;
        if (_par_fg_in(0, &g) < 0) { ok = 0; break; }
        var set = g.set_threads(threads);
        _par_fg_steps(&g, ks);
        PvFluidGrid_drop(&g);
        var same = 1;
        if (_par_got_n != n0) { same = 0; }
        for (var j = 0; same == 1 && j < n0; j = j + 1) {
            if (_par_got_same(j, sk, sv, sl) == 0) { same = 0; }
        }
        if (same == 0) {
            ok = 0;
            print("  FluidGrid::step: ", 18);
            fmt_int(threads);
            println(" threads differ from one");
        }
    }
    memcpy(_par_got_k, sk, n0 * 8);
    memcpy(_par_got_v, sv, n0 * 8);
    memcpy(_par_got_l, sl, n0 * 8);
    _par_got_n = n0;
    fl_free(sk);
    fl_free(sv);
    fl_free(sl);
    _par_mt_rows = _par_mt_rows + 1;
    if (ok == 0) { _par_mt_bad = _par_mt_bad + 1; }
    return ok;
}

fn _par_grid(fp, fl): i64 {
    if (_par_eq(fp, fl, "FluidGrid::new") == 1) {
        var g: PvFluidGrid;
        var t, v = PvFluidGrid_new(_par_in(0), _par_in(1), _par_in(2), &g);
        if (is_err_result(t) == 1) { _par_got_err(v); return 1; }
        _par_got_i(g.nx);
        _par_got_i(g.ny);
        _par_got_f(_pv_bits(g.dx));
        for (var c = 0; c < 4; c = c + 1) {
            var col: *PvColumn = _pv_fg_col(&g, c);
            _par_got_i(col.len);
            _par_got_f(load64(col.data));
        }
        _par_fg_dump(&g);
        PvFluidGrid_drop(&g);
        return 1;
    }
    if (_par_eq(fp, fl, "GridConfig::smoke") == 1) {
        var cs: PvGridConfig = PvGridConfig_smoke();
        _par_gc_out(&cs);
        return 1;
    }
    if (_par_eq(fp, fl, "GridConfig::default") == 1) {
        var cd: PvGridConfig = PvGridConfig_default();
        _par_gc_out(&cd);
        return 1;
    }
    if (_par_eq(fp, fl, "FluidGrid::from_json") == 1 || _par_eq(fp, fl, "GridConfig::from_json") == 1
      || _par_eq(fp, fl, "BoundaryCondition::from_json") == 1) {
        return _par_grid_json(fp, fl);
    }
    if (_par_eq(fp, fl, "FluidGrid::diffuse") == 1) {
        var fd: PvColumn;
        var k = _par_vcol_in(0, &fd);
        if (k < 0) { return 0 - 1; }
        PvFluidGrid_diffuse(fd.data, fd.len, _par_in(k), _par_in(k + 1), _par_in(k + 2), _par_in(k + 3),
          _par_in(k + 4), _par_in(k + 5));
        _par_col_out(&fd);
        fd.drop();
        return 1;
    }
    if (_par_eq(fp, fl, "oracle::pressure_solve_gauss_seidel") == 1
      || _par_eq(fp, fl, "oracle::pressure_solve_multigrid") == 1
      || _par_eq(fp, fl, "oracle::pressure_solve_dst") == 1 || _par_eq(fp, fl, "oracle::pressure_solve_cg") == 1) {
        var pc: PvColumn;
        var dc: PvColumn;
        var k1 = _par_vcol_in(0, &pc);
        if (k1 < 0) { return 0 - 1; }
        var k2 = _par_vcol_in(k1, &dc);
        if (k2 < 0) { return 0 - 1; }
        var nx = _par_in(k2);
        var ny = _par_in(k2 + 1);
        if (_par_eq(fp, fl, "oracle::pressure_solve_gauss_seidel") == 1) {
            _pv_fg_pressure_gs(pc.data, dc.data, nx, ny, _par_in(k2 + 2));
            _par_col_out(&pc);
        } elif (_par_eq(fp, fl, "oracle::pressure_solve_dst") == 1
          || _par_eq(fp, fl, "oracle::pressure_solve_cg") == 1) {
            # Fresh solver scratch per row, as the hooks' callers have none (the grid's persists across steps).
            var sa: PvColumn = PvColumn_new();
            var sb: PvColumn = PvColumn_new();
            var sc: PvColumn = PvColumn_new();
            if (_par_eq(fp, fl, "oracle::pressure_solve_dst") == 1) {
                var tx: PvColumn = PvColumn_new();
                var ty: PvColumn = PvColumn_new();
                var td, vd = _pv_fg_pressure_dst(pc.data, pc.len, dc.data, nx, ny, &sa, &sb, &sc, &tx, &ty);
                if (is_err_result(td) == 1) { _par_got_err(vd); } else { _par_col_out(&pc); }
                tx.drop();
                ty.drop();
            } else {
                var tg, vg = _pv_fg_pressure_cg(pc.data, dc.data, nx, ny, _par_in(k2 + 2), &sa, &sb, &sc);
                if (is_err_result(tg) == 1) { _par_got_err(vg); } else { _par_col_out(&pc); }
            }
            sa.drop();
            sb.drop();
            sc.drop();
        } else {
            var levels: PvColumn = PvColumn_new();
            var tm, vm = _pv_fg_pressure_mg(pc.data, dc.data, nx, ny, _par_in(k2 + 2), _par_in(k2 + 3), &levels);
            if (is_err_result(tm) == 1) {
                _par_got_err(vm);
            } else {
                _par_col_out(&pc);
                _par_got_i(levels.len);
                for (var j = 0; j < levels.len; j = j + 1) {
                    var lv = load64(levels.data + j * 8);
                    for (var q = 0; q < 3; q = q + 1) { _par_col_out(_pv_mg_col(lv, q)); }
                }
            }
            _pv_mg_levels_drop(&levels);
        }
        pc.drop();
        dc.drop();
        return 1;
    }
    # Every other row starts with a state.
    var g: PvFluidGrid;
    var ks = _par_fg_in(0, &g);
    if (ks < 0) { return 0 - 1; }
    var n = g.nx * g.ny;
    var handled = 1;
    if (_par_eq(fp, fl, "FluidGrid::cell_count") == 1) {
        _par_got_i(g.cell_count());
    } elif (_par_eq(fp, fl, "FluidGrid::idx") == 1) {
        _par_got_seq(n);
        for (var i = 0; i < n; i = i + 1) { _par_got_i(g.idx(i % g.nx, i / g.nx)); }
    } elif (_par_eq(fp, fl, "FluidGrid::velocity_at") == 1) {
        _par_got_seq(2 * n);
        for (var i2 = 0; i2 < n; i2 = i2 + 1) {
            var u, w = g.velocity_at(i2 % g.nx, i2 / g.nx);
            var uf: f64 = u;
            var wf: f64 = w;
            _par_got_f(_pv_bits(uf));
            _par_got_f(_pv_bits(wf));
        }
    } elif (_par_eq(fp, fl, "FluidGrid::speed_at") == 1) {
        _par_got_seq(n);
        for (var i3 = 0; i3 < n; i3 = i3 + 1) {
            var sp: f64 = g.speed_at(i3 % g.nx, i3 / g.nx);
            _par_got_f(_pv_bits(sp));
        }
    } elif (_par_eq(fp, fl, "FluidGrid::max_speed") == 1) {
        var ms: f64 = g.max_speed();
        _par_got_f(_pv_bits(ms));
    } elif (_par_eq(fp, fl, "FluidGrid::total_kinetic_energy") == 1) {
        var ke: f64 = g.total_kinetic_energy();
        _par_got_f(_pv_bits(ke));
    } elif (_par_eq(fp, fl, "FluidGrid::cfl_dt") == 1) {
        var m = _par_in(ks);
        _par_got_seq(m);
        for (var j2 = 0; j2 < m; j2 = j2 + 1) {
            var cf: f64 = g.cfl_dt(_par_in(ks + 1 + j2), _par_in(ks + 2 + m + j2));
            _par_got_f(_pv_bits(cf));
        }
    } elif (_par_eq(fp, fl, "FluidGrid::step") == 1) {
        # At one thread (the gated outputs), then at every count in _PAR_THREADS, each of which must give the same
        # words (port plan D6: any thread count gives the serial bits).
        _par_fg_steps(&g, ks);
        if (_par_fg_threads_agree(ks) == 0) { handled = 0 - 1; }
    } else {
        handled = 0;
    }
    PvFluidGrid_drop(&g);
    return handled;
}

fn _par_dispatch(mp, ml, fp, fl): i64 {
    _par_got_n = 0;
    if (_par_eq(mp, ml, "bridge") == 1) { return _par_bridge(fp, fl); }
    if (_par_eq(mp, ml, "buoyancy") == 1) { return _par_buoyancy(fp, fl); }
    if (_par_eq(mp, ml, "common") == 1) { return _par_common(fp, fl); }
    if (_par_eq(mp, ml, "vortex") == 1) { return _par_vortex(fp, fl); }
    if (_par_eq(mp, ml, "constants") == 1) { return _par_constants(fp, fl); }
    if (_par_eq(mp, ml, "json") == 1) { return _par_json(fp, fl); }
    if (_par_eq(mp, ml, "shallow") == 1) { return _par_shallow(fp, fl); }
    if (_par_eq(mp, ml, "grid") == 1) {
        var rc = _par_grid_c(fp, fl);
        if (rc != 0) { return rc; }
        return _par_grid(fp, fl);
    }
    if (_par_eq(mp, ml, "sph") == 1) { return _par_sph(fp, fl); }
    if (_par_eq(mp, ml, "vof") == 1) { return _par_vof(fp, fl); }
    if (_par_eq(mp, ml, "phase_field") == 1) { return _par_phase_field(fp, fl); }
    if (_par_eq(mp, ml, "math") == 1) { return _par_math(fp, fl); }
    return 0;
}

# Shadow comparisons, never gated: the same golden rows through another Cyrius candidate. On a row
# of the corrected oracle the reference is the corrected outputs, so each shadow's histogram is its
# distance from the correctly rounded value there and from glibc's elsewhere.
# - M1a part 1's counterparts, which part 2 replaced: the polyfill exp and ln, the sin and cos
#   builtins (the polyfills on every target), ganita's hypot and pow, and ganita's atan2 on the
#   polyfill atan. They are the misround counts the ganita request cites (ledger L1);
# - the native exp and ln, and ganita's atan2 on the native atan: x87 on x86_64, so their bits
#   differ between targets (digests 12–14);
# - the stdlib min / max, to show where their NaN semantics differ from Rust's.
fn _par_shadow_f(name, cls, r: f64) {
    _par_got_n = 0;
    _par_got_f(r);
    _par_shadow_record(name, cls);
    return 0;
}

fn _par_shadows(mp, ml, fp, fl, cls) {
    # The port's own outputs first (a pending row has none), before a shadow replaces them.
    if (_par_eq(mp, ml, "constants") == 1) {
        if (_par_got_n > 0) { _par_dg_fold(11); }
        return 0;
    }
    if (_par_eq(mp, ml, "math") != 1) { return 0; }
    if (_par_got_n > 0) { _par_dg_fold(_par_dg_slot(fp, fl)); }
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::exp") == 1) {
        var p: f64 = _f64_exp_polyfill(x);
        _par_shadow_f("f64::exp ~ _f64_exp_polyfill", cls, p);
        var r: f64 = f64_exp(x);
        _par_shadow_f("f64::exp ~ f64_exp (native)", cls, r);
        _par_dg_fold(12);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::ln") == 1) {
        var p: f64 = _f64_ln_polyfill(x);
        _par_shadow_f("f64::ln ~ _f64_ln_polyfill", cls, p);
        var r: f64 = f64_ln(x);
        _par_shadow_f("f64::ln ~ f64_ln (native)", cls, r);
        _par_dg_fold(13);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::sin") == 1) {
        var r: f64 = f64_sin(x);
        _par_shadow_f("f64::sin ~ f64_sin", cls, r);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::cos") == 1) {
        var r: f64 = f64_cos(x);
        _par_shadow_f("f64::cos ~ f64_cos", cls, r);
        return 0;
    }
    if (_par_in_n < 2) { return 0; }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "f64::atan2") == 1) {
        var p: f64 = _cand_atan2_poly(_par_in(0), _par_in(1));
        _par_shadow_f("f64::atan2 ~ ganita, polyfill atan", cls, p);
        var r: f64 = ganita_f64_atan2(x, y);
        _par_shadow_f("f64::atan2 ~ ganita_f64_atan2", cls, r);
        _par_dg_fold(14);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::hypot") == 1) {
        var r: f64 = ganita_f64_hypot(x, y);
        _par_shadow_f("f64::hypot ~ ganita_f64_hypot", cls, r);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::powf") == 1) {
        var r: f64 = ganita_f64_pow(x, y);
        _par_shadow_f("f64::powf ~ ganita_f64_pow", cls, r);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::max") == 1) {
        var r: f64 = f64_max(x, y);
        _par_shadow_f("f64::max ~ f64_max", cls, r);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::min") == 1) {
        var r: f64 = f64_min(x, y);
        _par_shadow_f("f64::min ~ f64_min", cls, r);
        return 0;
    }
    return 0;
}

# The class-C bound for a function, in ulps; -1 while none is set (the rows are measured). Bounds
# are set before a function's first gated comparison (M0 step 8, docs/development/port-parity.md
# §2.2) and never raised to make a row pass. They hold on x86_64 ELF, x86_64 PE and aarch64, which
# give the same bits for every dispatched function (the digests).
# - Every std transcendental gets K = 0 (ADR 0004): the port's are correctly rounded, so each row
#   must equal the corrected oracle bit for bit, which is glibc's value where glibc rounded
#   correctly and MPFR's where it didn't (tests/golden/math.cr.tsv). M0's K = 2 compared two
#   implementations each about 1 ulp from the correct value; with one side exact, any distance is a
#   defect.
# - cbrt has had K = 0 since M0: the oracle's (compiler_builtins) and ganita's are both correctly
#   rounded, and equal on every row (port-parity §3).
# - pravash's own class-C functions get K_F = 2·S·c + 2 at their milestones (port-parity, the rule).
#must_use
fn _par_c_bound(fp, fl): i64 {
    if (_par_eq(fp, fl, "f64::sin_cos") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::sin") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::cos") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::atan2") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::hypot") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::exp") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::ln") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::log10") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::cbrt") == 1) { return 0; }
    # M1 part 4's class C functions: Rust's operations on the correctly rounded primitives, so each row equals the
    # corrected oracle (the oracle's operations with every exp, ln, log10 and powf correctly rounded) bit for bit.
    if (_par_eq(fp, fl, "lamb_oseen_velocity") == 1) { return 0; }
    if (_par_eq(fp, fl, "kolmogorov_scale") == 1) { return 0; }
    if (_par_eq(fp, fl, "temperature_to_water_viscosity") == 1) { return 0; }
    if (_par_eq(fp, fl, "tke_to_broadband_noise_db") == 1) { return 0; }
    # M2: sediment's cbrt is correctly rounded on both sides (port-parity §3).
    if (_par_eq(fp, fl, "update_sediment") == 1) { return 0; }
    # The shallow-water step (class S): Rust's operations on the correctly rounded damping powf and cbrt, so every
    # field of every step row is bit for bit the oracle's (the corrected oracle's where glibc's pow misrounds).
    if (_par_eq(fp, fl, "ShallowWater::step") == 1) { return 0; }
    # The grid step (class S), on every projection (periodic Gauss–Seidel, multigrid, DST, CG): +, −, ×, ÷, √,
    # floor, the exact fmod and the DST's correctly rounded sines and cosines in Rust's order, so every field is the
    # oracle's bit for bit (the corrected oracle's where glibc misrounds one of the DST's sines or cosines).
    if (_par_eq(fp, fl, "FluidGrid::step") == 1) { return 0; }
    # M3 part b: the DST pressure solve's sines and cosines are correctly rounded (src/crmath.cyr) and everything
    # else is +, −, ×, ÷ in Rust's order, so each row equals the corrected oracle bit for bit (the oracle's own row
    # where glibc rounded every sine and cosine correctly). The DST step rows take the same bound, 0, above.
    if (_par_eq(fp, fl, "oracle::pressure_solve_dst") == 1) { return 0; }
    # M3 part c: the k-ε source step and the MAC step (class S) are +, −, ×, ÷ and the sampler's floor in Rust's
    # order, so every field is the oracle's bit for bit.
    if (_par_eq(fp, fl, "KEpsilon::step") == 1) { return 0; }
    if (_par_eq(fp, fl, "MacGrid::step") == 1) { return 0; }
    # M3 part d: the VOF advection and the phase-field step (class S) are +, −, ×, ÷, √, ceil and clamp in Rust's
    # order, so every field is the oracle's bit for bit.
    if (_par_eq(fp, fl, "VofField::advect") == 1) { return 0; }
    if (_par_eq(fp, fl, "PhaseField::step") == 1) { return 0; }
    # M4 part a: the Tait equation of state's ln and powf, and the non-Newtonian models' powf, are correctly rounded
    # (src/crmath.cyr, src/crlog.cyr) and the rest is Rust's arithmetic in order, so each row equals the corrected
    # oracle bit for bit (the oracle's own where glibc rounded correctly).
    if (_par_eq(fp, fl, "equation_of_state_tait") == 1) { return 0; }
    if (_par_eq(fp, fl, "NonNewtonianViscosity::effective_viscosity") == 1) { return 0; }
    # M4 part c: the split ring's cosines and sines are correctly rounded and the rest is Rust's arithmetic in order,
    # so each row equals the corrected oracle bit for bit. The free step (class S) is +, −, ×, ÷ and √ in Rust's
    # order, so every particle of every row is the oracle's bit for bit.
    if (_par_eq(fp, fl, "split_particle") == 1) { return 0; }
    if (_par_eq(fp, fl, "step") == 1) { return 0; }
    # M4 part d: the contact angle's cosine is correctly rounded and the rest is Rust's arithmetic in order, so each
    # row equals the corrected oracle bit for bit.
    if (_par_eq(fp, fl, "apply_contact_angle") == 1) { return 0; }
    return 0 - 1;
}

# The ADR accepting a divergent row (function and raw input field), or 0. None yet: the ADR 0002
# mappings arrive with their modules.
#must_use
fn _par_accepted(fp, fl, ip, il): i64 {
    return 0;
}

# 1 for an ADR whose accepted rows are counted but not printed row by row. None yet.
#must_use
fn _par_accepted_quiet(adr): i64 {
    return 0;
}

# After each module: its cross-target digests.
fn _par_module_done(mp, ml) {
    if (_par_eq(mp, ml, "constants") == 1) { _par_dg_print(11, "const"); return 0; }
    if (_par_eq(mp, ml, "grid") == 1) {
        print("  thread counts: FluidGrid::step at 2, 3, 4 and 8 threads: ", 59);
        fmt_int(_par_mt_rows);
        print(" rows, ", 7);
        fmt_int(_par_mt_bad);
        println(" differing from one thread");
        return 0;
    }
    if (_par_eq(mp, ml, "math") != 1) { return 0; }
    _par_dg_print(0, "f64::sin_cos");
    _par_dg_print(1, "f64::sin");
    _par_dg_print(2, "f64::cos");
    _par_dg_print(3, "f64::atan2");
    _par_dg_print(4, "f64::hypot");
    _par_dg_print(5, "f64::exp");
    _par_dg_print(6, "f64::ln");
    _par_dg_print(7, "f64::log10");
    _par_dg_print(8, "f64::powf");
    _par_dg_print(9, "f64::cbrt");
    _par_dg_print(10, "class A/B math rows");
    _par_dg_print(12, "exp ~ f64_exp (native)");
    _par_dg_print(13, "ln ~ f64_ln (native)");
    _par_dg_print(14, "atan2 ~ ganita_f64_atan2");
    return 0;
}

# Every module is replayed here.
#must_use
fn _par_skip(mp, ml): i64 {
    return 0;
}

_par_dg_init();
var exit_code = _par_main();
sys_exit_group(exit_code);
