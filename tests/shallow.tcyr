# shallow.tcyr — the ported tests of Rust 1.3.0's src/shallow.rs (M2).
#
# Every test keeps its Rust name as its group; all 44 are ported, and `wave_peak_after` is a helper. Re-expressed for
# the Cyrius shapes (ADR 0002 #1, #9, #10, #11):
# - `is_err()` is the `PV_ERR_*` code, checked against the variant Rust's code path returns (which implies is_err);
# - `.unwrap()` on `new` and `step` is an assertion that every call was Ok;
# - the private `idx(x, y)` is `idx`, y·nx + x; a `Vec<f64>` field is a PvColumn (`v[i]` is `get_f` / `set_f`,
#   `fill` takes the value's bits);
# - a closure is a helper function, which returns NaN (failing every comparison) where Rust's `unwrap` would panic;
# - Rust's per-cell assertion loops count the failing cells into one check;
# - `capacity()` is the scratch column's `cap`, and its storage pointer is checked not to move either;
# - serde_json is `to_json` / `PvShallowWater_from_json`; `&mut [f64]` is (pointer, count).
# One Cyrius-only group, `sw_layout_matches_column_offsets`, pins the record layout that src/shallow.cyr's
# `_pv_sw_col` offsets assume.

include "tests/lib.cyr"

# 1 when |a − b| < tol.
fn near(a: f64, b: f64, tol: f64): i64 {
    var d: f64 = a - b;
    var ad: f64 = f64_abs(d);
    if (ad < tol) { return 1; }
    return 0;
}

var EPS: f64 = 0.0000000001;   # the Rust tests' 1e-10

# ── helpers ─────────────────────────────────────────────────────────────────────────

# A new state into *sw, as `ShallowWater::new(..).unwrap()`: 1 when it built.
fn fresh(sw: *PvShallowWater, nx, ny, dx: f64, h: f64): i64 {
    var t, e = PvShallowWater_new(nx, ny, dx, h, sw);
    if (is_err_result(t) == 1) { return 0; }
    return 1;
}

# The error code of `PvShallowWater_new` (PV_ERR_NONE when it built: *sw then holds storage to drop).
fn new_err(sw: *PvShallowWater, nx, ny, dx: f64, h: f64): i64 {
    var t, e = PvShallowWater_new(nx, ny, dx, h, sw);
    if (is_err_result(t) == 1) { return e; }
    return PV_ERR_NONE;
}

# The error code of one step (PV_ERR_NONE for Ok).
fn step_err(sw: *PvShallowWater, dt: f64): i64 {
    var t, e = sw.step(dt);
    if (is_err_result(t) == 1) { return e; }
    return PV_ERR_NONE;
}

# n steps of dt: the number that returned Err (each is Rust's `step(dt).unwrap()`, so the tests assert 0).
fn steps(sw: *PvShallowWater, n, dt: f64): i64 {
    var bad = 0;
    for (var k = 0; k < n; k = k + 1) {
        var t, e = sw.step(dt);
        if (is_err_result(t) == 1) { bad = bad + 1; }
    }
    return bad;
}

# The cell index y·nx + x. Mirrors the private `idx`.
fn idx(sw: *PvShallowWater, x, y): i64 {
    return y * sw.nx + x;
}

# field[y·nx + x] = v for x in x0..x1, y in y0..y1 (`p` a field's storage; the rectangle lies inside it).
fn fill_rect(p, nx, x0, x1, y0, y1, v: f64) {
    for (var y = y0; y < y1; y = y + 1) {
        for (var x = x0; x < x1; x = x + 1) { store64(p + (y * nx + x) * 8, _pv_bits(v)); }
    }
    return 0;
}

# 1 when each of the n f64 words at p is finite (Rust's `iter().all(|h| h.is_finite())`).
fn all_finite(p, n): i64 {
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = load64(p + i * 8);
        if (_pv_is_finite(x) == 0) { return 0; }
    }
    return 1;
}

# Σ|x| over the n f64 words at p (Rust's `iter().map(|v| v.abs()).sum()`).
fn sum_abs(p, n): f64 {
    var s: f64 = 0.0;
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = load64(p + i * 8);
        var a: f64 = f64_abs(x);
        s = s + a;
    }
    return s;
}

# m folded with the |x| of the n f64 words at p by Rust's NaN-ignoring max (`fold(m, |m, v| m.max(v.abs()))`).
fn fold_max_abs(m0: f64, p, n): f64 {
    var m: f64 = m0;
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = load64(p + i * 8);
        var a: f64 = f64_abs(x);
        m = _pv_max(m, a);
    }
    return m;
}

# The largest |v| over vx then vy, from 0 (Rust's `vx.iter().chain(vy).map(abs).fold(0.0, f64::max)`).
fn max_v(sw: *PvShallowWater): f64 {
    var m: f64 = fold_max_abs(0.0, sw.vx.data, sw.vx.len);
    var r: f64 = fold_max_abs(m, sw.vy.data, sw.vy.len);
    return r;
}

# The number of i in 0..n where |a[i] − b[i]| < tol fails.
fn count_differ(pa, pb, n, tol: f64): i64 {
    var bad = 0;
    for (var i = 0; i < n; i = i + 1) {
        var a: f64 = load64(pa + i * 8);
        var b: f64 = load64(pb + i * 8);
        if (near(a, b, tol) == 0) { bad = bad + 1; }
    }
    return bad;
}

# ── basics ──────────────────────────────────────────────────────────────────────────

# Construction, the cell reads, the disturbance and a flat-water step.
fn test_basics() {
    var sw: PvShallowWater;
    var sw2: PvShallowWater;
    var nan: f64 = PV_F64_NAN;

    test_group("test_shallow_new");
    assert_eq(fresh(&sw, 20, 20, 0.1, 1.0), 1, "new");
    assert_eq(sw.height.len, 400, "400 cells");
    var h0: f64 = sw.height.get_f(0);
    assert(near(h0, 1.0, EPS) == 1, "height 1");
    PvShallowWater_drop(&sw);

    test_group("test_shallow_invalid");
    assert_eq(new_err(&sw, 0, 10, 0.1, 1.0), PV_ERR_INVALID_GRID_RESOLUTION, "nx = 0: InvalidGridResolution");

    test_group("test_depth_at");
    assert_eq(fresh(&sw, 10, 10, 0.1, 2.0), 1, "new");
    sw.ground.set_f(idx(&sw, 5, 5), 0.5);
    var d: f64 = sw.depth_at(5, 5);
    assert(near(d, 1.5, EPS) == 1, "2 − 0.5");
    PvShallowWater_drop(&sw);

    test_group("test_depth_at_dry");
    assert_eq(fresh(&sw, 10, 10, 0.1, 1.0), 1, "new");
    sw.ground.set_f(idx(&sw, 5, 5), 2.0);
    var dd: f64 = sw.depth_at(5, 5);
    assert(near(dd, 0.0, EPS) == 1, "ground above the water: clamped to 0");
    PvShallowWater_drop(&sw);

    test_group("test_add_disturbance");
    assert_eq(fresh(&sw, 20, 20, 0.1, 1.0), 1, "new");
    var before: f64 = sw.height.get_f(idx(&sw, 10, 10));
    sw.add_disturbance(1.0, 1.0, 0.3, 0.5);
    var after: f64 = sw.height.get_f(idx(&sw, 10, 10));
    assert(after > before, "the centre rises");
    PvShallowWater_drop(&sw);

    test_group("test_step_flat_stays_flat");
    assert_eq(fresh(&sw, 20, 20, 0.1, 1.0), 1, "new");
    assert_eq(step_err(&sw, 0.001), PV_ERR_NONE, "step");
    var dev: f64 = sw.max_wave_height(1.0);
    assert(dev < 0.000001, "no gradients, no forces");
    PvShallowWater_drop(&sw);

    test_group("test_step_disturbance_propagates");
    assert_eq(fresh(&sw, 20, 20, 0.1, 1.0), 1, "new");
    sw.add_disturbance(1.0, 1.0, 0.2, 0.5);
    var initial_max: f64 = sw.max_wave_height(1.0);
    assert_eq(steps(&sw, 100, 0.001), 0, "100 steps");
    var final_max: f64 = sw.max_wave_height(1.0);
    assert(final_max < initial_max, "the wave spreads out");
    PvShallowWater_drop(&sw);

    test_group("test_step_invalid_dt");
    assert_eq(fresh(&sw, 10, 10, 0.1, 1.0), 1, "new");
    assert_eq(step_err(&sw, -0.001), PV_ERR_INVALID_TIMESTEP, "dt < 0: InvalidTimestep");
    PvShallowWater_drop(&sw);

    test_group("test_step_nan_dt");
    assert_eq(fresh(&sw, 10, 10, 0.1, 1.0), 1, "new");
    assert_eq(step_err(&sw, nan), PV_ERR_INVALID_TIMESTEP, "NaN dt: InvalidTimestep");
    PvShallowWater_drop(&sw);

    test_group("test_total_volume");
    assert_eq(fresh(&sw, 10, 10, 0.1, 1.0), 1, "new");
    var expected: f64 = (((10.0 * 10.0) * 0.1) * 0.1) * 1.0;
    var vol: f64 = sw.total_volume();
    assert(near(vol, expected, 0.000001) == 1, "10 × 10 cells of 0.1², 1 deep");
    PvShallowWater_drop(&sw);

    test_group("test_volume_conservation");
    assert_eq(fresh(&sw, 20, 20, 0.1, 1.0), 1, "new");
    var vol_before: f64 = sw.total_volume();
    sw.add_disturbance(1.0, 1.0, 0.2, 0.1);
    assert_eq(steps(&sw, 50, 0.001), 0, "50 steps");
    var vol_after: f64 = sw.total_volume();
    var dv: f64 = vol_after - vol_before;
    var adv: f64 = f64_abs(dv);
    var rel: f64 = adv / vol_before;
    assert(rel < 0.05, "volume approximately conserved");
    PvShallowWater_drop(&sw);

    test_group("test_serde_roundtrip");
    assert_eq(fresh(&sw, 5, 5, 0.2, 1.5), 1, "new");
    var sb = str_builder_new();
    assert_eq(sw.to_json(sb), 0, "written");
    var s = str_builder_build(sb);
    var t, e = PvShallowWater_from_json(str_data(s), str_len(s), &sw2);
    assert_eq(is_err_result(t), 0, "read back");
    if (is_err_result(t) == 0) {
        assert_eq(sw2.nx, 5, "nx 5");
        var h2: f64 = sw2.height.get_f(0);
        assert(near(h2, 1.5, EPS) == 1, "height 1.5");
        PvShallowWater_drop(&sw2);
    }
    PvShallowWater_drop(&sw);

    test_group("test_no_alloc_after_first_step");
    assert_eq(fresh(&sw, 10, 10, 0.1, 1.0), 1, "new");
    assert_eq(step_err(&sw, 0.001), PV_ERR_NONE, "first step");
    var cap_vx = sw.scratch_vx.cap;
    var cap_vy = sw.scratch_vy.cap;
    var buf_vx = sw.scratch_vx.data;
    var buf_vy = sw.scratch_vy.data;
    assert_eq(step_err(&sw, 0.001), PV_ERR_NONE, "second step");
    assert_eq(sw.scratch_vx.cap, cap_vx, "scratch_vx capacity unchanged");
    assert_eq(sw.scratch_vy.cap, cap_vy, "scratch_vy capacity unchanged");
    assert_eq(sw.scratch_vx.data, buf_vx, "scratch_vx not reallocated");
    assert_eq(sw.scratch_vy.data, buf_vy, "scratch_vy not reallocated");
    PvShallowWater_drop(&sw);
    return 0;
}

# Wave reflection, convective transport and the dam break.
fn test_flow() {
    var sw: PvShallowWater;
    var pi: f64 = PV_F64_PI;
    var two: f64 = 2.0;

    test_group("test_boundary_reflects_waves");
    assert_eq(fresh(&sw, 20, 20, 0.1, 1.0), 1, "new");
    sw.add_disturbance(0.2, 1.0, 0.15, 0.5);
    assert_eq(steps(&sw, 200, 0.001), 0, "200 steps");
    var left_height: f64 = sw.height.get_f(idx(&sw, 0, 10));
    var interior_height: f64 = sw.height.get_f(idx(&sw, 1, 10));
    assert(near(left_height, interior_height, 0.000001) == 1, "Neumann: the boundary tracks its interior neighbour");
    PvShallowWater_drop(&sw);

    test_group("test_convective_transport");
    assert_eq(fresh(&sw, 40, 10, 0.1, 1.0), 1, "new");
    sw.damping = 1.0;
    sw.vx.fill(_pv_bits(two));
    var bump_x = 10;
    for (var y = 3; y < 7; y = y + 1) {
        var i = idx(&sw, bump_x, y);
        var hb: f64 = sw.height.get_f(i);
        sw.height.set_f(i, hb + 0.1);
    }
    var initial_bump_center: f64 = sw.height.get_f(idx(&sw, bump_x, 5));
    assert_eq(steps(&sw, 100, 0.001), 0, "100 steps");
    var bump_after: f64 = sw.height.get_f(idx(&sw, bump_x, 5));
    assert(bump_after < initial_bump_center, "the bump advects away");
    PvShallowWater_drop(&sw);

    test_group("test_dam_break_asymmetry");
    assert_eq(fresh(&sw, 60, 6, 0.1, 0.5), 1, "new");
    sw.damping = 1.0;
    fill_rect(sw.height.data, sw.nx, 0, 30, 0, 6, 2.0);
    assert_eq(steps(&sw, 200, 0.0005), 0, "200 steps");
    var mid_vx: f64 = sw.vx.get_f(idx(&sw, 30, 3));
    assert(mid_vx > 0.0, "rightward flow at the break point");
    assert_eq(all_finite(sw.height.data, sw.height.len), 1, "all heights finite");
    PvShallowWater_drop(&sw);

    test_group("test_nonlinear_steepening");
    assert_eq(fresh(&sw, 80, 6, 0.05, 1.0), 1, "new");
    sw.damping = 1.0;
    for (var x = 0; x < 80; x = x + 1) {
        var fx: f64 = f64_from(x);
        var phase: f64 = ((pi * 2.0) * fx) / 40.0;
        var sn: f64 = _pv_sin(phase);
        for (var y = 0; y < 6; y = y + 1) {
            var i = idx(&sw, x, y);
            var hs: f64 = sw.height.get_f(i);
            sw.height.set_f(i, hs + (0.2 * sn));
        }
    }
    assert_eq(steps(&sw, 300, 0.0005), 0, "300 steps");
    assert_eq(all_finite(sw.height.data, sw.height.len), 1, "stable and finite");
    var max_vx: f64 = fold_max_abs(0.0, sw.vx.data, sw.vx.len);
    assert(max_vx > 0.01, "the wave generates velocity");
    PvShallowWater_drop(&sw);
    return 0;
}

# ── Manning's friction ──────────────────────────────────────────────────────────────

# Σ|vx| after 100 steps of a uniform rightward flow (1 m/s) over a bed of Manning n, or NaN when a step fails. The
# Rust test's `make_flow` closure.
fn friction_flow(n: f64): f64 {
    var sw: PvShallowWater;
    var nan: f64 = PV_F64_NAN;
    var one: f64 = 1.0;
    if (fresh(&sw, 20, 6, 0.1, 1.0) == 0) { return nan; }
    sw.damping = 1.0;
    sw.vx.fill(_pv_bits(one));
    sw.manning_n.fill_f(n);
    var bad = steps(&sw, 100, 0.001);
    var s: f64 = sum_abs(sw.vx.data, sw.vx.len);
    PvShallowWater_drop(&sw);
    if (bad != 0) { return nan; }
    return s;
}

# Manning friction: deceleration, its roughness scaling, and none at zero.
fn test_friction() {
    var sw: PvShallowWater;
    var sw_b: PvShallowWater;
    var two: f64 = 2.0;
    var one: f64 = 1.0;
    var rough: f64 = 0.05;

    test_group("test_friction_decelerates_flow");
    assert_eq(fresh(&sw, 30, 6, 0.1, 1.0), 1, "new");
    sw.damping = 1.0;
    sw.vx.fill(_pv_bits(two));
    sw.manning_n.fill(_pv_bits(rough));
    var speed_before: f64 = sum_abs(sw.vx.data, sw.vx.len);
    assert_eq(steps(&sw, 200, 0.001), 0, "200 steps");
    var speed_after: f64 = sum_abs(sw.vx.data, sw.vx.len);
    assert(speed_after < speed_before * 0.8, "friction decelerates");
    PvShallowWater_drop(&sw);

    test_group("test_friction_scales_with_roughness");
    var speed_smooth: f64 = friction_flow(0.01);
    var speed_rough: f64 = friction_flow(0.05);
    assert(speed_rough < speed_smooth, "a rougher bed slows the flow more");

    test_group("test_zero_friction_no_effect");
    assert_eq(fresh(&sw, 20, 6, 0.1, 1.0) + fresh(&sw_b, 20, 6, 0.1, 1.0), 2, "new, twice");
    sw.damping = 1.0;
    sw_b.damping = 1.0;
    sw.add_disturbance(1.0, 0.3, 0.2, 0.3);
    sw_b.add_disturbance(1.0, 0.3, 0.2, 0.3);
    var bad = 0;
    for (var k = 0; k < 50; k = k + 1) {
        bad = bad + steps(&sw, 1, 0.001);
        bad = bad + steps(&sw_b, 1, 0.001);
    }
    assert_eq(bad, 0, "50 steps each");
    assert_eq(count_differ(sw.height.data, sw_b.height.data, sw.height.len, 0.000000000001), 0,
      "zero manning_n is identical to the default");
    PvShallowWater_drop(&sw);
    PvShallowWater_drop(&sw_b);

    test_group("test_friction_dry_cells_safe");
    assert_eq(fresh(&sw, 20, 6, 0.1, 0.5), 1, "new");
    sw.damping = 1.0;
    sw.manning_n.fill(_pv_bits(rough));
    fill_rect(sw.ground.data, sw.nx, 10, 15, 0, 6, 1.0);
    sw.vx.fill(_pv_bits(one));
    assert_eq(steps(&sw, 100, 0.001), 0, "100 steps");
    assert_eq(all_finite(sw.vx.data, sw.vx.len), 1, "friction near dry cells stays finite");
    assert_eq(all_finite(sw.height.data, sw.height.len), 1, "heights finite");
    PvShallowWater_drop(&sw);
    return 0;
}

# ── wetting and drying ──────────────────────────────────────────────────────────────

# Wetting and drying: dry cells, depth never negative, an advancing front.
fn test_wetting() {
    var sw: PvShallowWater;
    var one: f64 = 1.0;
    var half: f64 = 0.5;
    var three: f64 = 3.0;

    test_group("test_dry_cells_zero_velocity");
    assert_eq(fresh(&sw, 20, 6, 0.1, 1.0), 1, "new");
    sw.damping = 1.0;
    fill_rect(sw.ground.data, sw.nx, 10, 20, 0, 6, 2.0);
    sw.vx.fill(_pv_bits(one));
    sw.vy.fill(_pv_bits(half));
    assert_eq(step_err(&sw, 0.001), PV_ERR_NONE, "step");
    var wet = 0;
    for (var y = 1; y < 5; y = y + 1) {
        for (var x = 11; x < 19; x = x + 1) { wet = wet + sw.is_wet(x, y); }
    }
    assert_eq(wet, 0, "every cell over the raised ground is dry");
    PvShallowWater_drop(&sw);

    test_group("test_depth_never_negative");
    assert_eq(fresh(&sw, 30, 6, 0.1, 0.5), 1, "new");
    sw.damping = 1.0;
    fill_rect(sw.ground.data, sw.nx, 12, 18, 0, 6, 0.45);
    sw.vx.fill(_pv_bits(three));
    assert_eq(steps(&sw, 500, 0.0005), 0, "500 steps");
    var neg = 0;
    for (var i = 0; i < sw.height.len; i = i + 1) {
        var hi: f64 = sw.height.get_f(i);
        var gi: f64 = sw.ground.get_f(i);
        var depth: f64 = hi - gi;
        if (depth >= -0.0000000001) {} else { neg = neg + 1; }
    }
    assert_eq(neg, 0, "no cell's depth is negative");
    PvShallowWater_drop(&sw);

    test_group("test_water_advances_onto_dry_bed");
    assert_eq(fresh(&sw, 40, 6, 0.1, 0.0), 1, "new");
    sw.damping = 1.0;
    sw.breaking_threshold = 0.0;
    fill_rect(sw.height.data, sw.nx, 0, 15, 0, 6, 1.0);
    assert_eq(sw.is_wet(30, 3), 0, "the right side starts dry");
    assert_eq(steps(&sw, 2000, 0.0005), 0, "2000 steps");
    var any_wet = 0;
    for (var x = 15; x < 25; x = x + 1) {
        var dx: f64 = sw.depth_at(x, 3);
        if (dx > sw.dry_threshold) { any_wet = 1; }
    }
    assert_eq(any_wet, 1, "the water advances");
    assert_eq(all_finite(sw.height.data, sw.height.len), 1, "heights finite");
    assert_eq(all_finite(sw.vx.data, sw.vx.len), 1, "vx finite");
    PvShallowWater_drop(&sw);

    test_group("test_is_wet_helper");
    assert_eq(fresh(&sw, 10, 10, 0.1, 1.0), 1, "new");
    assert_eq(sw.is_wet(5, 5), 1, "wet");
    sw.ground.set_f(idx(&sw, 5, 5), 1.5);
    assert_eq(sw.is_wet(5, 5), 0, "dry with the ground above the water");
    PvShallowWater_drop(&sw);
    return 0;
}

# ── wave breaking ───────────────────────────────────────────────────────────────────

# Σ(u² + v²) after a 300-step dam break, breaking on or off, or NaN when a step fails. The Rust test's `run` closure.
fn breaking_ke(breaking): f64 {
    var sw: PvShallowWater;
    var nan: f64 = PV_F64_NAN;
    if (fresh(&sw, 40, 6, 0.1, 0.5) == 0) { return nan; }
    sw.damping = 1.0;
    if (breaking == 0) { sw.breaking_threshold = 0.0; }
    fill_rect(sw.height.data, sw.nx, 0, 15, 0, 6, 2.0);
    var bad = steps(&sw, 300, 0.0005);
    var ke: f64 = 0.0;
    for (var i = 0; i < sw.vx.len; i = i + 1) {
        var u: f64 = sw.vx.get_f(i);
        var v: f64 = sw.vy.get_f(i);
        ke = ke + ((u * u) + (v * v));
    }
    PvShallowWater_drop(&sw);
    if (bad != 0) { return nan; }
    return ke;
}

# Wave breaking: detection, dissipation, and the zero threshold.
fn test_breaking() {
    var sw: PvShallowWater;
    var pi: f64 = PV_F64_PI;

    test_group("test_steep_wave_detected_as_breaking");
    assert_eq(fresh(&sw, 20, 6, 0.1, 1.0), 1, "new");
    fill_rect(sw.height.data, sw.nx, 0, 10, 0, 6, 3.0);
    assert_eq(sw.is_breaking(10, 3), 1, "the steep front breaks");
    PvShallowWater_drop(&sw);

    test_group("test_gentle_wave_not_breaking");
    assert_eq(fresh(&sw, 40, 6, 0.1, 1.0), 1, "new");
    for (var x = 0; x < 40; x = x + 1) {
        var fx: f64 = f64_from(x);
        var phase: f64 = ((pi * 2.0) * fx) / 40.0;
        var sn: f64 = _pv_sin(phase);
        for (var y = 0; y < 6; y = y + 1) {
            var i = idx(&sw, x, y);
            var h: f64 = sw.height.get_f(i);
            sw.height.set_f(i, h + (0.001 * sn));
        }
    }
    var breaking = 0;
    for (var x = 1; x < 39; x = x + 1) { breaking = breaking + sw.is_breaking(x, 3); }
    assert_eq(breaking, 0, "a gentle wave breaks nowhere");
    PvShallowWater_drop(&sw);

    test_group("test_breaking_dissipates_energy");
    var ke_with_breaking: f64 = breaking_ke(1);
    var ke_without: f64 = breaking_ke(0);
    assert(ke_with_breaking < ke_without, "breaking dissipates energy");

    test_group("test_breaking_disabled_when_threshold_zero");
    assert_eq(fresh(&sw, 20, 6, 0.1, 1.0), 1, "new");
    sw.breaking_threshold = 0.0;
    fill_rect(sw.height.data, sw.nx, 0, 10, 0, 6, 5.0);
    assert_eq(sw.is_breaking(10, 3), 0, "threshold 0 disables breaking");
    PvShallowWater_drop(&sw);
    return 0;
}

# ── dispersive correction ───────────────────────────────────────────────────────────

# The y = 3 height profile (40 words at out) after 200 steps of a pulse with dispersion coefficient `disp`: 1, or 0
# when a step fails. The Rust test's `run` closure.
fn disp_profile(disp: f64, out): i64 {
    var sw: PvShallowWater;
    if (fresh(&sw, 40, 6, 0.1, 1.0) == 0) { return 0; }
    sw.damping = 1.0;
    sw.breaking_threshold = 0.0;
    sw.dispersion_coeff = disp;
    sw.add_disturbance(2.0, 0.3, 0.2, 0.1);
    var bad = steps(&sw, 200, 0.0001);
    for (var x = 0; x < 40; x = x + 1) {
        var h: f64 = sw.height.get_f(idx(&sw, x, 3));
        store64(out + x * 8, _pv_bits(h));
    }
    PvShallowWater_drop(&sw);
    if (bad != 0) { return 0; }
    return 1;
}

# Dispersion: off by default, its effect on a wave, a long stable run.
fn test_dispersion() {
    var sw: PvShallowWater;
    var sw_b: PvShallowWater;

    test_group("test_dispersion_disabled_by_default");
    assert_eq(fresh(&sw, 30, 6, 0.1, 1.0) + fresh(&sw_b, 30, 6, 0.1, 1.0), 2, "new, twice");
    sw.damping = 1.0;
    sw_b.damping = 1.0;
    sw.breaking_threshold = 0.0;
    sw_b.breaking_threshold = 0.0;
    sw.add_disturbance(1.5, 0.3, 0.2, 0.3);
    sw_b.add_disturbance(1.5, 0.3, 0.2, 0.3);
    var bad = 0;
    for (var k = 0; k < 50; k = k + 1) {
        bad = bad + steps(&sw, 1, 0.001);
        bad = bad + steps(&sw_b, 1, 0.001);
    }
    assert_eq(bad, 0, "50 steps each");
    assert_eq(count_differ(sw.height.data, sw_b.height.data, sw.height.len, 0.000000000001), 0,
      "zero dispersion is identical");
    PvShallowWater_drop(&sw);
    PvShallowWater_drop(&sw_b);

    test_group("test_dispersion_changes_wave_shape");
    var profile_no_disp = alloc(320);
    var profile_with_disp = alloc(320);
    assert_eq(disp_profile(0.0, profile_no_disp), 1, "without dispersion: 200 steps");
    assert_eq(disp_profile(0.05, profile_with_disp), 1, "with dispersion: 200 steps");
    var diff: f64 = 0.0;
    for (var x = 0; x < 40; x = x + 1) {
        var a: f64 = load64(profile_no_disp + x * 8);
        var b: f64 = load64(profile_with_disp + x * 8);
        var ab: f64 = a - b;
        var aab: f64 = f64_abs(ab);
        diff = diff + aab;
    }
    assert(diff > 0.000001, "dispersion changes the wave profile");
    assert_eq(all_finite(profile_with_disp, 40), 1, "the dispersive profile is finite");

    test_group("test_dispersion_stable_long_run");
    assert_eq(fresh(&sw, 30, 6, 0.1, 1.0), 1, "new");
    sw.damping = 1.0;
    sw.dispersion_coeff = 0.01;
    sw.add_disturbance(1.5, 0.3, 0.2, 0.05);
    assert_eq(steps(&sw, 500, 0.00005), 0, "500 steps");
    assert_eq(all_finite(sw.height.data, sw.height.len), 1, "the dispersive sim stays finite");
    assert_eq(all_finite(sw.vx.data, sw.vx.len), 1, "vx finite");
    PvShallowWater_drop(&sw);
    return 0;
}

# ── terrain-following / well-balanced ───────────────────────────────────────────────

# Terrain: a lake at rest over a slope, flow over a bump.
fn test_terrain() {
    var sw: PvShallowWater;
    var one: f64 = 1.0;

    test_group("test_lake_at_rest_over_slope");
    assert_eq(fresh(&sw, 30, 6, 0.1, 2.0), 1, "new");
    sw.damping = 1.0;
    sw.breaking_threshold = 0.0;
    for (var y = 0; y < 6; y = y + 1) {
        for (var x = 0; x < 30; x = x + 1) {
            var fx: f64 = f64_from(x);
            sw.ground.set_f(y * sw.nx + x, fx / 30.0);
        }
    }
    var max_v_before: f64 = max_v(&sw);
    assert(max_v_before < 0.000000000000001, "starts at rest");
    assert_eq(steps(&sw, 500, 0.001), 0, "500 steps");
    var mv: f64 = max_v(&sw);
    assert(mv < 0.000001, "a lake at rest over a slope stays still");
    PvShallowWater_drop(&sw);

    test_group("test_flow_over_bump_stable");
    assert_eq(fresh(&sw, 40, 6, 0.1, 1.0), 1, "new");
    sw.damping = 1.0;
    sw.breaking_threshold = 0.0;
    for (var y = 0; y < 6; y = y + 1) {
        for (var x = 0; x < 40; x = x + 1) {
            var fx: f64 = f64_from(x);
            var cx: f64 = (fx - 20.0) * 0.1;
            var arg: f64 = ((-cx) * cx) * 4.0;
            var ex: f64 = _pv_exp(arg);
            sw.ground.set_f(y * sw.nx + x, 0.5 * ex);
        }
    }
    sw.vx.fill(_pv_bits(one));
    assert_eq(steps(&sw, 500, 0.0005), 0, "500 steps");
    assert_eq(all_finite(sw.height.data, sw.height.len), 1, "flow over the bump stays finite");
    assert_eq(all_finite(sw.vx.data, sw.vx.len), 1, "vx finite");
    PvShallowWater_drop(&sw);

    test_group("test_well_balanced_step_bathymetry");
    assert_eq(fresh(&sw, 30, 6, 0.1, 2.0), 1, "new");
    sw.damping = 1.0;
    sw.breaking_threshold = 0.0;
    fill_rect(sw.ground.data, sw.nx, 15, 30, 0, 6, 0.5);
    assert_eq(steps(&sw, 200, 0.001), 0, "200 steps");
    var mvs: f64 = max_v(&sw);
    assert(mvs < 0.01, "a lake at rest over a step stays nearly still");
    PvShallowWater_drop(&sw);

    test_group("test_boundary_zero_normal_velocity");
    assert_eq(fresh(&sw, 20, 20, 0.1, 1.0), 1, "new");
    sw.add_disturbance(1.0, 1.0, 0.3, 0.5);
    assert_eq(steps(&sw, 50, 0.001), 0, "50 steps");
    var left = 0;
    for (var y = 0; y < sw.ny; y = y + 1) {
        var u: f64 = sw.vx.get_f(idx(&sw, 0, y));
        if (near(u, 0.0, EPS) == 0) { left = left + 1; }
    }
    assert_eq(left, 0, "the left wall's vx is 0");
    var bottom = 0;
    for (var x = 0; x < sw.nx; x = x + 1) {
        var v: f64 = sw.vy.get_f(idx(&sw, x, 0));
        if (near(v, 0.0, EPS) == 0) { bottom = bottom + 1; }
    }
    assert_eq(bottom, 0, "the bottom wall's vy is 0");
    PvShallowWater_drop(&sw);
    return 0;
}

# ── audit regressions (1.3.0) ───────────────────────────────────────────────────────

# Narrow 1D channel with a Gaussian bump; returns x of the right-moving peak (NaN when a step fails). Mirrors the
# Rust tests' `wave_peak_after`. Rust's `(t_end / dt).round()` rounds ties away from zero and f64_round to even:
# t_end / dt is never a tie here.
fn wave_peak_after(use_riemann, t_end: f64): f64 {
    var sw: PvShallowWater;
    var nan: f64 = PV_F64_NAN;
    var nx = 300;
    var dx: f64 = 0.05;
    var h0: f64 = 1.0;
    if (fresh(&sw, nx, 3, dx, h0) == 0) { return nan; }
    sw.damping = 1.0;
    sw.breaking_threshold = 0.0;
    sw.use_riemann = use_riemann;
    var x0: f64 = 5.0;
    for (var x = 0; x < nx; x = x + 1) {
        var fx: f64 = f64_from(x);
        var px: f64 = fx * dx;
        var off: f64 = px - x0;
        var sq: f64 = _pv_powi2(off);
        var arg: f64 = (-sq) / 0.1;
        var ex: f64 = _pv_exp(arg);
        var bump: f64 = 0.01 * ex;
        for (var y = 0; y < 3; y = y + 1) { sw.height.set_f(y * nx + x, h0 + bump); }
    }
    var dt: f64 = 0.002;
    var q: f64 = t_end / dt;
    var qr: f64 = f64_round(q);
    var n = f64_to(qr);
    var bad = steps(&sw, n, dt);
    var mx: f64 = PV_F64_MAX;
    var best_x = 0;
    var best_e: f64 = -mx;   # f64::MIN
    for (var x = nx / 2; x < nx - 1; x = x + 1) {
        var e: f64 = sw.height.get_f(nx + x);
        if (e > best_e) {
            best_x = x;
            best_e = e;
        }
    }
    PvShallowWater_drop(&sw);
    if (bad != 0) { return nan; }
    var bx: f64 = f64_from(best_x);
    var r: f64 = bx * dx;
    return r;
}

# The audit tests of wave speed, volume conservation and the HLL lake at rest.
fn test_audit_waves() {
    var sw: PvShallowWater;

    test_group("test_gravity_wave_speed_is_sqrt_gh");
    var c: f64 = f64_sqrt(9.81 * 1.0);
    var expected: f64 = 5.0 + c;
    var x_default: f64 = wave_peak_after(0, 1.0);
    var x_riemann: f64 = wave_peak_after(1, 1.0);
    assert(near(x_default, expected, 0.35) == 1, "riemann = false: the peak travels at √(g·h)");
    assert(near(x_riemann, expected, 0.35) == 1, "riemann = true: the peak travels at √(g·h)");

    test_group("test_interior_volume_conserved_with_walls");
    for (var riemann = 0; riemann < 2; riemann = riemann + 1) {
        assert_eq(fresh(&sw, 30, 30, 0.1, 1.0), 1, "new");
        sw.use_riemann = riemann;
        sw.add_disturbance(1.5, 1.5, 0.5, 0.2);
        var v0: f64 = sw.interior_volume();
        assert_eq(steps(&sw, 400, 0.005), 0, "400 steps");
        var v1: f64 = sw.interior_volume();
        var tol: f64 = 0.000000001 * v0;
        if (riemann == 0) {
            assert(near(v1, v0, tol) == 1, "riemann = false: the walls conserve the interior volume");
        } else {
            assert(near(v1, v0, tol) == 1, "riemann = true: the walls conserve the interior volume");
        }
        PvShallowWater_drop(&sw);
    }

    test_group("test_riemann_lake_at_rest_over_slope");
    assert_eq(fresh(&sw, 20, 20, 0.1, 1.0), 1, "new");
    sw.use_riemann = 1;
    for (var y = 0; y < 20; y = y + 1) {
        for (var x = 0; x < 20; x = x + 1) {
            var fx: f64 = f64_from(x);
            var fy: f64 = f64_from(y);
            sw.ground.set_f(y * 20 + x, (0.03 * fx) + (0.01 * fy));
        }
    }
    assert_eq(steps(&sw, 200, 0.005), 0, "200 steps");
    var mv: f64 = max_v(&sw);
    assert(mv < 0.0000000001, "a lake at rest must stay at rest");
    PvShallowWater_drop(&sw);

    test_group("test_riemann_dam_break_onto_dry_bed");
    assert_eq(fresh(&sw, 60, 3, 0.05, 0.0), 1, "new");
    sw.use_riemann = 1;
    fill_rect(sw.height.data, 60, 0, 20, 0, 3, 0.5);
    assert_eq(steps(&sw, 100, 0.002), 0, "100 steps");
    var bad = 0;
    for (var i = 0; i < sw.height.len; i = i + 1) {
        var h: f64 = sw.height.get_f(i);
        if (_pv_is_finite(h) == 1 && h >= 0.0) {} else { bad = bad + 1; }
    }
    assert_eq(bad, 0, "every height finite and ≥ 0");
    var d: f64 = sw.depth_at(25, 1);
    assert(d > 0.0, "the water advances onto the dry bed");
    PvShallowWater_drop(&sw);

    test_group("test_dispersion_stable_long_run_peregrine");
    assert_eq(fresh(&sw, 40, 40, 0.1, 1.0), 1, "new");
    sw.dispersion_coeff = 1.0 / 3.0;
    sw.add_disturbance(2.0, 2.0, 0.4, 0.05);
    assert_eq(steps(&sw, 1000, 0.005), 0, "1000 steps");
    var m1: f64 = sw.max_wave_height(1.0);
    assert(m1 < 0.1, "dispersion stays bounded");
    sw.use_green_naghdi = 1;
    assert_eq(steps(&sw, 500, 0.005), 0, "500 Green–Naghdi steps");
    var m2: f64 = sw.max_wave_height(1.0);
    assert(m2 < 0.1, "and with the face-averaged depth");
    PvShallowWater_drop(&sw);
    return 0;
}

# The bed plus the suspended sediment, Σ z + c·max(η − z, 0) over the interior of the 10 × 10 grid. The Rust test's
# `total` closure.
fn sed_total(sw: *PvShallowWater, conc): f64 {
    var t: f64 = 0.0;
    for (var y = 1; y < 9; y = y + 1) {
        for (var x = 1; x < 9; x = x + 1) {
            var i = y * 10 + x;
            var hi: f64 = sw.height.get_f(i);
            var gi: f64 = sw.ground.get_f(i);
            var d: f64 = hi - gi;
            var h: f64 = _pv_max(d, 0.0);
            var ci: f64 = load64(conc + i * 8);
            t = t + (gi + (ci * h));
        }
    }
    return t;
}

# The audit tests of breaking at the shoreline, sediment volume and invalid states.
fn test_audit_state() {
    var sw: PvShallowWater;
    var three: f64 = 3.0;
    var rough: f64 = 0.05;
    var nan: f64 = PV_F64_NAN;

    test_group("test_breaking_is_dimensionless_at_shoreline");
    assert_eq(fresh(&sw, 10, 10, 0.1, 0.0), 1, "new");
    for (var y = 0; y < 10; y = y + 1) {
        for (var x = 0; x < 10; x = x + 1) {
            var fx: f64 = f64_from(x);
            sw.height.set_f(y * 10 + x, 0.001 + (0.0001 * fx));
        }
    }
    assert_eq(sw.is_breaking(5, 5), 0, "a very shallow cell on a gentle slope does not break");
    PvShallowWater_drop(&sw);

    test_group("test_sediment_conserves_volume");
    assert_eq(fresh(&sw, 10, 10, 0.1, 0.01), 1, "new");
    sw.vx.fill(_pv_bits(three));
    sw.manning_n.fill(_pv_bits(rough));
    var conc = alloc(800);
    for (var i = 0; i < 100; i = i + 1) { store64(conc + i * 8, 0); }
    var config: PvSedimentConfig = PvSedimentConfig_default();
    config.erosion_rate = 0.05;
    var before: f64 = sed_total(&sw, conc);
    for (var k = 0; k < 50; k = k + 1) { update_sediment(&sw, conc, 100, &config, 0.01); }
    var after: f64 = sed_total(&sw, conc);
    assert(near(after, before, 0.000000000001) == 1, "bed + suspended is conserved");
    var above = 0;
    for (var i = 0; i < sw.ground.len; i = i + 1) {
        var g: f64 = sw.ground.get_f(i);
        var h: f64 = sw.height.get_f(i);
        if (g <= h) {} else { above = above + 1; }
    }
    assert_eq(above, 0, "the bed never rises above the surface");
    PvShallowWater_drop(&sw);

    test_group("test_invalid_state_is_error");
    assert_eq(new_err(&sw, 10, 10, 0.0, 1.0), PV_ERR_INVALID_PARAMETER, "dx = 0: InvalidParameter");
    assert_eq(new_err(&sw, 10, 10, 0.1, nan), PV_ERR_INVALID_PARAMETER, "NaN height: InvalidParameter");
    assert_eq(fresh(&sw, 10, 10, 0.1, 1.0), 1, "new");
    sw.ground.truncate(50);
    assert_eq(step_err(&sw, 0.01), PV_ERR_INVALID_GRID_RESOLUTION, "a short ground: InvalidGridResolution");
    PvShallowWater_drop(&sw);
    assert_eq(fresh(&sw, 10, 10, 0.1, 1.0), 1, "new");
    sw.nx = 0;
    assert_eq(step_err(&sw, 0.01), PV_ERR_INVALID_GRID_RESOLUTION, "nx = 0: InvalidGridResolution");
    PvShallowWater_drop(&sw);
    return 0;
}

# ── Cyrius-only: the record layout ──────────────────────────────────────────────────

# Column k's storage pointer through `_pv_sw_col`'s byte offsets.
fn col_data(sw: *PvShallowWater, k): i64 {
    var c: *PvColumn = _pv_sw_col(sw, k);
    return c.data;
}

# Cyrius-only: the record layout the column offsets assume.
fn test_layout() {
    var sw: PvShallowWater;

    test_group("sw_layout_matches_column_offsets");
    assert_eq(sizeof(PvShallowWater), 328, "328 bytes");
    assert_eq(fresh(&sw, 5, 5, 0.1, 1.0), 1, "new");
    sw.dispersion_coeff = 0.1;
    assert_eq(step_err(&sw, 0.001), PV_ERR_NONE, "a dispersive step sizes scratch_line");
    assert(sw.scratch_line.data != 0, "scratch_line has storage");
    assert_eq(col_data(&sw, 0), sw.height.data, "0: height");
    assert_eq(col_data(&sw, 1), sw.vx.data, "1: vx");
    assert_eq(col_data(&sw, 2), sw.vy.data, "2: vy");
    assert_eq(col_data(&sw, 3), sw.ground.data, "3: ground");
    assert_eq(col_data(&sw, 4), sw.manning_n.data, "4: manning_n");
    assert_eq(col_data(&sw, 5), sw.scratch_vx.data, "5: scratch_vx");
    assert_eq(col_data(&sw, 6), sw.scratch_vy.data, "6: scratch_vy");
    assert_eq(col_data(&sw, 7), sw.scratch_h.data, "7: scratch_h");
    assert_eq(col_data(&sw, 8), sw.scratch_lap.data, "8: scratch_lap");
    assert_eq(col_data(&sw, 9), sw.scratch_line.data, "9: scratch_line");
    PvShallowWater_drop(&sw);
    return 0;
}

# 2.0.1 hardening (Cyrius-only): sizes that disagree with the fields can't read outside them or make a loop spin.
fn test_hardening() {
    test_group("hardening_shallow_inconsistent_sizes");
    var sw: PvShallowWater;
    var st, sv = PvShallowWater_new(4, 4, 0.1, 1.0, &sw);
    assert(is_err_result(st) == 0, "a 4 × 4 basin");
    var h1: f64 = sw.height.get_f(1);
    sw.nx = 4294967296;
    sw.ny = 4294967296;
    var got: f64 = sw.interior_volume();
    assert(got == 0.0, "interior_volume: an nx · ny that overflows is refused, not read past the fields");
    sw.add_disturbance(0.1, 0.1, 0.15, 0.5);
    assert(sw.height.len == 16, "add_disturbance stops at the field's end (2^64 cells otherwise)");
    sw.nx = 4;
    sw.ny = 4;
    var h1b: f64 = sw.height.get_f(1);
    assert(h1b > h1, "and a cell it reached (word 1, within 0.15 of the drop) rose");
    PvShallowWater_drop(&sw);
    return 0;
}

# Runs the ported shallow water tests.
fn main() {
    alloc_init();
    test_basics();
    test_flow();
    test_friction();
    test_wetting();
    test_breaking();
    test_dispersion();
    test_terrain();
    test_audit_waves();
    test_audit_state();
    test_layout();
    test_hardening();
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
