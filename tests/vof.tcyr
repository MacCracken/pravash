# vof.tcyr — the ported tests of Rust 1.3.0's src/vof.rs (M3 part d).
#
# Every test keeps its Rust name as its group, in Rust's order: all 8. Re-expressed for the Cyrius shapes (ADR 0002
# #1, #8, #14): `.unwrap()` on `new` and `advect` is an assertion that the call was Ok; `is_err()` is the `PV_ERR_*`
# code Rust's path returns; `advect` takes (pointer, count) for each velocity; the cellular flow's sin and cos are
# the correctly rounded ones (src/crmath.cyr), where Rust's are glibc's (the test's own 1% tolerance, class R).
# One Cyrius-only group, `vof_layout_matches_column_offsets`, pins the record layout `_pv_vof_col` assumes.

include "tests/lib.cyr"

# 1 when |a − b| < tol.
fn near(a: f64, b: f64, tol: f64): i64 {
    var d: f64 = a - b;
    var ad: f64 = f64_abs(d);
    if (ad < tol) { return 1; }
    return 0;
}

# 1 when `PvVofField_new` built *v (Rust's `VofField::new(…).unwrap()`).
fn fresh(v: *PvVofField, nx, ny, dx: f64): i64 {
    var t, e = PvVofField_new(nx, ny, dx, v);
    if (is_err_result(t) == 1) { return 0; }
    return 1;
}

# The error code of one `advect` (PV_ERR_NONE when it was Ok).
fn advect_err(v: *PvVofField, vx, vx_len, vy, vy_len, dt: f64): i64 {
    var t, e = v.advect(vx, vx_len, vy, vy_len, dt);
    if (is_err_result(t) == 1) { return e; }
    return PV_ERR_NONE;
}

# n f64 words, each x.
fn filled(n, x: f64): i64 {
    var p = alloc(n * 8);
    for (var i = 0; i < n; i = i + 1) { store64(p + i * 8, _pv_bits(x)); }
    return p;
}

# Runs the ported VofField tests.
fn main() {
    alloc_init();
    var v: PvVofField;

    test_group("test_vof_new");
    assert_eq(fresh(&v, 10, 10, 0.1), 1, "new");
    assert_eq(v.alpha.len, 100, "100 cells");
    assert_eq(v.is_empty(5, 5), 1, "empty");
    PvVofField_drop(&v);

    test_group("test_vof_fill_rect");
    assert_eq(fresh(&v, 10, 10, 0.1), 1, "new");
    v.fill_rect(0.2, 0.2, 0.5, 0.5);
    assert_eq(v.is_full(3, 3), 1, "(3, 3) full");
    assert_eq(v.is_empty(0, 0), 1, "(0, 0) empty");
    PvVofField_drop(&v);

    test_group("test_vof_fill_circle");
    assert_eq(fresh(&v, 20, 20, 0.1), 1, "new");
    v.fill_circle(1.0, 1.0, 0.3);
    assert_eq(v.is_full(10, 10), 1, "the centre full");
    assert_eq(v.is_empty(0, 0), 1, "the corner empty");
    PvVofField_drop(&v);

    test_group("test_vof_total_volume");
    assert_eq(fresh(&v, 10, 10, 0.1), 1, "new");
    v.alpha.fill(_pv_bits(1.0));
    var expected: f64 = ((10.0 * 10.0) * 0.1) * 0.1;
    var tv: f64 = v.total_volume();
    assert_eq(near(tv, expected, 0.000001), 1, "nx·ny·dx²");
    PvVofField_drop(&v);

    test_group("test_vof_advect_stationary");
    assert_eq(fresh(&v, 10, 10, 0.1), 1, "new");
    v.fill_rect(0.3, 0.3, 0.6, 0.6);
    var before: f64 = v.total_volume();
    var zero = filled(100, 0.0);
    assert_eq(advect_err(&v, zero, 100, zero, 100, 0.01), PV_ERR_NONE, "advect");
    var after: f64 = v.total_volume();
    assert_eq(near(before, after, 0.0000000001), 1, "still fluid keeps its volume");
    PvVofField_drop(&v);

    test_group("test_vof_interface_normal");
    assert_eq(fresh(&v, 20, 20, 0.1), 1, "new");
    for (var y = 0; y < 20; y = y + 1) {
        for (var x = 0; x < 10; x = x + 1) { v.alpha.set_f(y * 20 + x, 1.0); }
    }
    var nxv, nyv = v.interface_normal(10, 10);
    var nxf: f64 = nxv;
    var anx: f64 = f64_abs(nxf);
    assert(anx > 0.5, "a strong x component at the interface");
    PvVofField_drop(&v);

    test_group("test_vof_conserves_volume_cellular_flow");
    var nx = 34;
    var ny = 34;
    var dx: f64 = 0.1;
    var l: f64 = f64_from(nx - 2) * dx;
    assert_eq(fresh(&v, nx, ny, dx), 1, "new");
    var top: f64 = l + 0.05;
    var half: f64 = 0.5 * l;
    v.fill_rect(0.1, 0.1, half, top);
    var v0: f64 = v.total_volume();
    var n = nx * ny;
    var vx = filled(n, 0.0);
    var vy = filled(n, 0.0);
    var pi: f64 = PV_F64_PI;
    for (var cy = 0; cy < ny; cy = cy + 1) {
        for (var cx = 0; cx < nx; cx = cx + 1) {
            var px: f64 = (f64_from(cx) - 0.5) * dx;
            var py: f64 = (f64_from(cy) - 0.5) * dx;
            var ax: f64 = (pi * px) / l;
            var ay: f64 = (pi * py) / l;
            var sx: f64 = _pv_sin(ax);
            var cxv: f64 = _pv_cos(ax);
            var sy: f64 = _pv_sin(ay);
            var cyv: f64 = _pv_cos(ay);
            var u: f64 = sx * cyv;
            var w: f64 = -(cxv * sy);
            store64(vx + (cy * nx + cx) * 8, _pv_bits(u));
            store64(vy + (cy * nx + cx) * 8, _pv_bits(w));
        }
    }
    var ok40 = 1;
    for (var s = 0; s < 40; s = s + 1) {
        if (advect_err(&v, vx, n, vy, n, 0.05) != PV_ERR_NONE) { ok40 = 0; }
    }
    assert_eq(ok40, 1, "40 advections");
    var v1: f64 = v.total_volume();
    var tol: f64 = 0.01 * v0;
    assert_eq(near(v1, v0, tol), 1, "volume within 1%");
    var outside = 0;
    for (var i = 0; i < n; i = i + 1) {
        var a: f64 = v.alpha.get_f(i);
        if (a < 0.0 || a > 1.0 || a != a) { outside = outside + 1; }
    }
    assert_eq(outside, 0, "every α in [0, 1]");
    PvVofField_drop(&v);

    test_group("test_vof_rejects_short_velocity");
    assert_eq(fresh(&v, 8, 8, 0.1), 1, "new");
    var z64 = filled(64, 0.0);
    var nan: f64 = PV_F64_NAN;
    var n64 = filled(64, nan);
    assert_eq(advect_err(&v, z64, 10, z64, 64, 0.01), PV_ERR_INVALID_PARAMETER, "10 velocities: InvalidParameter");
    assert_eq(advect_err(&v, n64, 64, z64, 64, 0.01), PV_ERR_DIVERGED, "NaN velocities: Diverged");
    PvVofField_drop(&v);

    # ── Cyrius-only: the record layout ──
    test_group("vof_layout_matches_column_offsets");
    assert_eq(sizeof(PvVofField), 72, "PvVofField: 72 bytes");
    assert_eq(fresh(&v, 5, 4, 0.1), 1, "new");
    var c0: *PvColumn = _pv_vof_col(&v, 0);
    var c1: *PvColumn = _pv_vof_col(&v, 1);
    assert(c0.data == v.alpha.data && c1.data == v.scratch.data, "0: alpha, 1: scratch");
    assert(v.alpha.len == 20 && v.scratch.len == 20, "nx·ny each");
    PvVofField_drop(&v);
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
