# pravash benchmarks
# Stdlib auto-included via cyrius.cyml
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop -> bench_report.
# For sub-1us ops use batch_size >= 1000 to amortize the clock read (lib/bench.cyr measures its floor
# and subtracts it). Results: docs/benchmarks-rust-v-cyrius.md. Run pinned on the shared host:
#   taskset -c 15 cyrius bench tests/pravash.bcyr

include "tests/lib.cyr"

var NS = 1000000;
var g_sink = 0;

# The benchmark loop's empty body, which measures the harness overhead.
fn bench_noop(): i64 { return 0; }

# ── the std transcendentals (M1a part 2, ADR 0004) ─────────────────────────────────────────────
# Each function runs on 1,024 seeded arguments, cycled: the same arguments as Rust's twin
# (scripts/probes/rust/src/bin/bench_libm.rs, which times glibc, what Rust's std calls). The xorshift64
# draw u in [0, 1) maps to lo + (hi − lo)·u in both, so the tables are bit-identical. Beside each correctly
# rounded function, the counterpart M1a part 1 used, which it replaced (not correctly rounded), for scale.
var _bx = 0;   # 1,024 f64 x arguments (alloc'd in main)
var _by = 0;   # and y arguments
var _bs = 0;

# The next xorshift64 draw, as a double in [0, 1).
fn _bench_u(): f64 {
    var s = _bs;
    s = s ^ (s << 13);
    s = s ^ (s >> 7);
    s = s ^ (s << 17);
    _bs = s;
    var m: f64 = f64_from(s >> 11);
    var u: f64 = m * 0.00000000000000011102230246251565404236316680908203125;   # 2^-53
    return u;
}

# Fills the 1,024 x arguments with [xlo, xhi) and the y arguments with [ylo, yhi), from the fixed seed.
fn _bench_args(xlo: f64, xhi: f64, ylo: f64, yhi: f64) {
    _bs = 0x9E3779B97F4A7C15;
    for (var k = 0; k < 1024; k = k + 1) {
        var u: f64 = _bench_u();
        var x: f64 = xlo + (xhi - xlo) * u;
        store64(_bx + k * 8, x);
        var v: f64 = _bench_u();
        var y: f64 = ylo + (yhi - ylo) * v;
        store64(_by + k * 8, y);
    }
    return 0;
}

# One timed row: NS calls of unary function `id` over the x arguments.
fn _bench_unary(name, id) {
    var b = bench_new(name);
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var x: f64 = load64(_bx + (i & 1023) * 8);
        var r: f64 = 0.0;
        if (id == 0) { r = _pv_exp(x); }
        elif (id == 1) { r = _f64_exp_polyfill(x); }
        elif (id == 2) { r = _pv_ln(x); }
        elif (id == 3) { r = _f64_ln_polyfill(x); }
        elif (id == 4) { r = _pv_log10(x); }
        elif (id == 5) { r = _pv_sin(x); }
        elif (id == 6) { r = f64_sin(x); }
        elif (id == 7) { r = _pv_cos(x); }
        elif (id == 8) { r = _pv_cbrt(x); }
        g_sink = g_sink ^ _pv_bits(r);
    }
    bench_batch_stop(b, NS);
    bench_report(b);
    return 0;
}

# One timed row: NS calls of binary function `id` over the (x, y) arguments.
fn _bench_binary(name, id) {
    var b = bench_new(name);
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var x: f64 = load64(_bx + (i & 1023) * 8);
        var y: f64 = load64(_by + (i & 1023) * 8);
        var r: f64 = 0.0;
        if (id == 0) { r = _pv_hypot(x, y); }
        elif (id == 1) { r = ganita_f64_hypot(x, y); }
        elif (id == 2) { r = _pv_powf(x, y); }
        elif (id == 3) { r = ganita_f64_pow(x, y); }
        elif (id == 4) { r = _pv_atan2(x, y); }
        elif (id == 5) { r = ganita_f64_atan2(x, y); }
        g_sink = g_sink ^ _pv_bits(r);
    }
    bench_batch_stop(b, NS);
    bench_report(b);
    return 0;
}

# sin_cos: both results of one argument, against the two builtins it replaced.
fn _bench_sin_cos() {
    var b = bench_new("math/sin_cos_cr");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var x: f64 = load64(_bx + (i & 1023) * 8);
        var s, c = _pv_sin_cos(x);
        g_sink = g_sink ^ s ^ c;
    }
    bench_batch_stop(b, NS);
    bench_report(b);
    var g = bench_new("math/sin_cos_builtin");
    bench_batch_start(g);
    for (var j = 0; j < NS; j = j + 1) {
        var x2: f64 = load64(_bx + (j & 1023) * 8);
        var s2: f64 = f64_sin(x2);
        var c2: f64 = f64_cos(x2);
        g_sink = g_sink ^ _pv_bits(s2) ^ _pv_bits(c2);
    }
    bench_batch_stop(g, NS);
    bench_report(g);
    return 0;
}

fn bench_math() {
    # The dispatch loop alone (an if chain falling through to its end), for the rows' overhead.
    _bench_args(-20.0, 20.0, 0.0, 1.0);
    _bench_unary("math/dispatch_floor", 99);
    _bench_unary("math/exp_cr", 0);
    _bench_unary("math/exp_polyfill", 1);
    _bench_args(0.001, 1000.0, 0.0, 1.0);
    _bench_unary("math/ln_cr", 2);
    _bench_unary("math/ln_polyfill", 3);
    _bench_unary("math/log10_cr", 4);
    _bench_args(-10.0, 10.0, 0.0, 1.0);
    _bench_unary("math/sin_cr", 5);
    _bench_unary("math/sin_builtin", 6);
    _bench_unary("math/cos_cr", 7);
    _bench_sin_cos();
    _bench_args(-1000.0, 1000.0, 0.0, 1.0);
    _bench_unary("math/cbrt_ganita", 8);
    _bench_args(-100.0, 100.0, -100.0, 100.0);
    _bench_binary("math/hypot_cr", 0);
    _bench_binary("math/hypot_ganita", 1);
    _bench_args(0.1, 10.0, -10.0, 10.0);
    _bench_binary("math/powf_cr", 2);
    _bench_binary("math/powf_ganita", 3);
    _bench_args(-1.0, 1.0, -1.0, 1.0);
    _bench_binary("math/atan2_cr", 4);
    _bench_binary("math/atan2_ganita", 5);
    return 0;
}

# ── common, ParticleSoa, ParticleArena (M1 part 3) ─────────────────────────────────────────────
# The bodies of scripts/probes/rust/src/bin/bench_common.rs, on the same inputs.

var NB = 10000;

# 1,000 particles on a 40-wide lattice, each with a velocity (the Rust twin's `particles()`).
fn _bench_particles(): i64 {
    var buf = fl_alloc(1000 * sizeof(PvFluidParticle));
    var ps: *PvFluidParticle = _pv_as_particles(buf);
    for (var i = 0; i < 1000; i = i + 1) {
        var x: f64 = f64_from(i % 40) * 0.025;
        var y: f64 = f64_from(i / 40) * 0.025;
        var p: PvFluidParticle = PvFluidParticle_new_2d(x, y, 0.001);
        var vx: f64 = f64_from(i % 7) * 0.1;
        var vy: f64 = f64_from(i % 5) * 0.2;
        p.velocity = PvVec3_new(vx, -vy, 0.0);
        var q: *PvFluidParticle = ps + i;
        *q = p;
    }
    return buf;
}

fn bench_common() {
    var buf = _bench_particles();
    var ps: *PvFluidParticle = _pv_as_particles(buf);

    var b = bench_new("common/particle_new_2d");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var x: f64 = f64_from(i & 1023);
        var p: PvFluidParticle = PvFluidParticle_new_2d(x, 0.5, 0.001);
        g_sink = g_sink ^ _pv_bits(p.position.x);
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    b = bench_new("common/kinetic_energy");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var q: *PvFluidParticle = ps + (i % 1000);
        var e: f64 = q.kinetic_energy();
        g_sink = g_sink ^ _pv_bits(e);
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    var cfg: PvFluidConfig = PvFluidConfig_water_2d();
    b = bench_new("common/config_validate");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var t, v = cfg.validate();
        g_sink = g_sink ^ t;
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    b = bench_new("common/check_cfl");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var sp: f64 = f64_from(i & 63);
        var t2, v2 = cfg.check_cfl(sp);
        g_sink = g_sink ^ t2;
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    b = bench_new("common/material_custom");
    var m: PvFluidMaterial;
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var t3, v3 = PvFluidMaterial_custom(800.0, 0.01, 0.05, 1400.0, &m);
        g_sink = g_sink ^ _pv_bits(m.density);
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    var s: PvParticleSoa;
    b = bench_new("soa/from_aos_1000");
    bench_batch_start(b);
    for (var i = 0; i < NB; i = i + 1) {
        var ok = PvParticleSoa_from_aos(&s, ps, 1000);
        g_sink = g_sink ^ _pv_bits(s.pos_x.get_f(999));
        PvParticleSoa_drop(&s);
    }
    bench_batch_stop(b, NB);
    bench_report(b);

    var ok2 = PvParticleSoa_from_aos(&s, ps, 1000);
    b = bench_new("soa/to_aos_1000");
    bench_batch_start(b);
    for (var i = 0; i < NB; i = i + 1) {
        var bp, bn = s.to_aos();
        var last: *PvFluidParticle = _pv_as_particles(bp) + 999;
        g_sink = g_sink ^ _pv_bits(last.position.x);
        fl_free(bp);
    }
    bench_batch_stop(b, NB);
    bench_report(b);

    var outb = _bench_particles();
    var outp: *PvFluidParticle = _pv_as_particles(outb);
    b = bench_new("soa/write_to_aos_1000");
    bench_batch_start(b);
    for (var i = 0; i < NB; i = i + 1) {
        s.write_to_aos(outp, 1000);
        var lw: *PvFluidParticle = outp + 999;
        g_sink = g_sink ^ _pv_bits(lw.position.x);
    }
    bench_batch_stop(b, NB);
    bench_report(b);
    PvParticleSoa_drop(&s);

    # new(1000), 100 blocks of 10, every other one freed, then compact (500 records moved).
    var hs = fl_alloc(100 * sizeof(PvArenaHandle));
    b = bench_new("arena/cycle_1000");
    bench_batch_start(b);
    for (var i = 0; i < NB; i = i + 1) {
        var a: *PvParticleArena = PvParticleArena_new(1000);
        var hp: *PvArenaHandle = _bench_handles(hs);
        for (var k = 0; k < 100; k = k + 1) { var got = a.alloc(10, hp + k); }
        for (var k = 0; k < 100; k = k + 2) {
            var h: *PvArenaHandle = hp + k;
            a.free(*h);
        }
        g_sink = g_sink ^ a.compact();
        PvParticleArena_drop(a);
    }
    bench_batch_stop(b, NB);
    bench_report(b);
    fl_free(hs);
    fl_free(outb);
    fl_free(buf);
    return 0;
}

# ── buoyancy, vortex, bridge, JSON (M1 part 4) ──────────────────────────────────────────────────
# The bodies of bench_common.rs's m1/* and json/* rows, on the same inputs (k & 1023 scaled per row).

fn bench_m1b() {
    var b = bench_new("m1/terminal_velocity");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var m: f64 = 1.0 + f64_from(i & 1023) * 0.001;
        var t, v = terminal_velocity(m, 9.81, 1.225, 0.47, 0.01);
        g_sink = g_sink ^ v;
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    b = bench_new("m1/reynolds_number");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var u: f64 = f64_from(i & 1023) * 0.01;
        var t2, v2 = reynolds_number(1000.0, u, 0.1, 0.001);
        g_sink = g_sink ^ v2;
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    b = bench_new("m1/lamb_oseen_velocity");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var r: f64 = 0.01 + f64_from(i & 1023) * 0.0001;
        var l: f64 = lamb_oseen_velocity(1.0, r, 0.001, 1.0);
        g_sink = g_sink ^ _pv_bits(l);
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    b = bench_new("m1/kolmogorov_scale");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var e: f64 = 0.001 + f64_from(i & 1023) * 0.001;
        var k: f64 = kolmogorov_scale(0.000001, e);
        g_sink = g_sink ^ _pv_bits(k);
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    var field = fl_alloc(8000);
    for (var j = 0; j < 1000; j = j + 1) {
        var w: f64 = f64_from(j % 17) * 0.1 - 0.8;
        store64(field + j * 8, w);
    }
    b = bench_new("m1/enstrophy_1000");
    bench_batch_start(b);
    for (var i = 0; i < 100000; i = i + 1) {
        var en: f64 = enstrophy(field, 1000, 0.01);
        g_sink = g_sink ^ _pv_bits(en);
    }
    bench_batch_stop(b, 100000);
    bench_report(b);
    fl_free(field);

    b = bench_new("m1/water_viscosity");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var tk: f64 = 273.0 + f64_from(i & 1023) * 0.0977;
        var mu: f64 = temperature_to_water_viscosity(tk);
        g_sink = g_sink ^ _pv_bits(mu);
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    b = bench_new("m1/broadband_noise_db");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var ke: f64 = 0.001 + f64_from(i & 1023) * 0.01;
        var db: f64 = tke_to_broadband_noise_db(ke);
        g_sink = g_sink ^ _pv_bits(db);
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    # JSON: a config written and read, a particle read, a 100-particle SoA read (serde_json's documents).
    var cfg: PvFluidConfig = PvFluidConfig_water_2d();
    b = bench_new("json/config_write");
    bench_batch_start(b);
    for (var i = 0; i < 100000; i = i + 1) {
        var sb = str_builder_new();
        var rc = cfg.to_json(sb);
        g_sink = g_sink ^ rc;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    var sbc = str_builder_new();
    var rcc = cfg.to_json(sbc);
    var cdoc = str_builder_build(sbc);
    var c2: PvFluidConfig;
    b = bench_new("json/config_read");
    bench_batch_start(b);
    for (var i = 0; i < 100000; i = i + 1) {
        var t3, v3 = PvFluidConfig_from_json(str_data(cdoc), str_len(cdoc), &c2);
        g_sink = g_sink ^ t3;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    var buf = _bench_particles();
    var ps: *PvFluidParticle = _pv_as_particles(buf);
    var p17: *PvFluidParticle = ps + 17;
    var sbp = str_builder_new();
    var rcp = p17.to_json(sbp);
    var pdoc = str_builder_build(sbp);
    var q: PvFluidParticle;
    b = bench_new("json/particle_read");
    bench_batch_start(b);
    for (var i = 0; i < 100000; i = i + 1) {
        var t4, v4 = PvFluidParticle_from_json(str_data(pdoc), str_len(pdoc), &q);
        g_sink = g_sink ^ t4;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    var small: PvParticleSoa;
    var okf = PvParticleSoa_from_aos(&small, ps, 100);
    var sbs = str_builder_new();
    var rcs = small.to_json(sbs);
    var sdoc = str_builder_build(sbs);
    var s2: PvParticleSoa;
    b = bench_new("json/soa_read_100");
    bench_batch_start(b);
    for (var i = 0; i < NB; i = i + 1) {
        var t5, v5 = PvParticleSoa_from_json(str_data(sdoc), str_len(sdoc), &s2);
        g_sink = g_sink ^ s2.len();
        PvParticleSoa_drop(&s2);
    }
    bench_batch_stop(b, NB);
    bench_report(b);
    PvParticleSoa_drop(&small);
    fl_free(buf);
    return 0;
}

# A typed view of a word.
#must_use
fn _bench_handles(p): *PvArenaHandle {
    return p;
}

fn main(): i64 {
    alloc_init();
    _bx = alloc(8192);
    _by = alloc(8192);
    var b = bench_new("noop");
    bench_batch_start(b);
    var i = 0;
    while (i < NS) { bench_noop(); i = i + 1; }
    bench_batch_stop(b, NS);
    bench_report(b);
    bench_math();
    bench_common();
    bench_m1b();
    return 0;
}

var r = main();
sys_exit_group(r);
