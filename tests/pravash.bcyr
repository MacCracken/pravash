# pravash benchmarks
# Stdlib auto-included via cyrius.cyml
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop -> bench_report.
# For sub-1us ops use batch_size >= 1000 to amortize the clock read (lib/bench.cyr measures its floor
# and subtracts it). Results: docs/benchmarks-rust-v-cyrius.md. Run pinned on the shared host:
#   taskset -c 15 cyrius bench tests/pravash.bcyr

include "tests/lib.cyr"
include "src/compute_ad.cyr"

var NS = 1000000;
var g_sink = 0;

# The benchmark loop's empty body, which measures the harness overhead.
fn bench_noop(): i64 { return 0; }

# ── the std transcendentals (M1a part 2, ADR 0004) ─────────────────────────────────────────────
# Each function runs on 1,024 seeded arguments, cycled: the same arguments as Rust's twin
# (scripts/probes/rust/src/bin/bench_libm.rs, which times glibc, what Rust's std calls). The xorshift64
# draw u in [0, 1) maps to lo + (hi − lo)·u in both, so the tables are bit-identical. Beside each correctly
# rounded function, the counterpart M1a part 1 used, which it replaced (not correctly rounded), for scale.
var _bx = 0;   # 1,024 f64 x arguments (alloc'd in main)
var _by = 0;   # and y arguments
var _bs = 0;

# The next xorshift64 draw, as a double in [0, 1).
fn _bench_u(): f64 {
    var s = _bs;
    s = s ^ (s << 13);
    s = s ^ (s >> 7);
    s = s ^ (s << 17);
    _bs = s;
    var m: f64 = f64_from(s >> 11);
    var u: f64 = m * 0.00000000000000011102230246251565404236316680908203125;   # 2^-53
    return u;
}

# Fills the 1,024 x arguments with [xlo, xhi) and the y arguments with [ylo, yhi), from the fixed seed.
fn _bench_args(xlo: f64, xhi: f64, ylo: f64, yhi: f64) {
    _bs = 0x9E3779B97F4A7C15;
    for (var k = 0; k < 1024; k = k + 1) {
        var u: f64 = _bench_u();
        var x: f64 = xlo + (xhi - xlo) * u;
        store64(_bx + k * 8, x);
        var v: f64 = _bench_u();
        var y: f64 = ylo + (yhi - ylo) * v;
        store64(_by + k * 8, y);
    }
    return 0;
}

# One timed row: NS calls of unary function `id` over the x arguments.
fn _bench_unary(name, id) {
    var b = bench_new(name);
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var x: f64 = load64(_bx + (i & 1023) * 8);
        var r: f64 = 0.0;
        if (id == 0) { r = _pv_exp(x); }
        elif (id == 1) { r = _f64_exp_polyfill(x); }
        elif (id == 2) { r = _pv_ln(x); }
        elif (id == 3) { r = _f64_ln_polyfill(x); }
        elif (id == 4) { r = _pv_log10(x); }
        elif (id == 5) { r = _pv_sin(x); }
        elif (id == 6) { r = f64_sin(x); }
        elif (id == 7) { r = _pv_cos(x); }
        elif (id == 8) { r = _pv_cbrt(x); }
        g_sink = g_sink ^ _pv_bits(r);
    }
    bench_batch_stop(b, NS);
    bench_report(b);
    return 0;
}

# One timed row: NS calls of binary function `id` over the (x, y) arguments.
fn _bench_binary(name, id) {
    var b = bench_new(name);
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var x: f64 = load64(_bx + (i & 1023) * 8);
        var y: f64 = load64(_by + (i & 1023) * 8);
        var r: f64 = 0.0;
        if (id == 0) { r = _pv_hypot(x, y); }
        elif (id == 1) { r = ganita_f64_hypot(x, y); }
        elif (id == 2) { r = _pv_powf(x, y); }
        elif (id == 3) { r = ganita_f64_pow(x, y); }
        elif (id == 4) { r = _pv_atan2(x, y); }
        elif (id == 5) { r = ganita_f64_atan2(x, y); }
        elif (id == 6) { r = _pv_fmod(x, y); }
        g_sink = g_sink ^ _pv_bits(r);
    }
    bench_batch_stop(b, NS);
    bench_report(b);
    return 0;
}

# sin_cos: both results of one argument, against the two builtins it replaced.
fn _bench_sin_cos() {
    var b = bench_new("math/sin_cos_cr");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var x: f64 = load64(_bx + (i & 1023) * 8);
        var s, c = _pv_sin_cos(x);
        g_sink = g_sink ^ s ^ c;
    }
    bench_batch_stop(b, NS);
    bench_report(b);
    var g = bench_new("math/sin_cos_builtin");
    bench_batch_start(g);
    for (var j = 0; j < NS; j = j + 1) {
        var x2: f64 = load64(_bx + (j & 1023) * 8);
        var s2: f64 = f64_sin(x2);
        var c2: f64 = f64_cos(x2);
        g_sink = g_sink ^ _pv_bits(s2) ^ _pv_bits(c2);
    }
    bench_batch_stop(g, NS);
    bench_report(g);
    return 0;
}

# The primitives' benches (M1 part 2), against Rust's glibc twins on the same arguments.
fn bench_math() {
    # The dispatch loop alone (an if chain falling through to its end), for the rows' overhead.
    _bench_args(-20.0, 20.0, 0.0, 1.0);
    _bench_unary("math/dispatch_floor", 99);
    _bench_unary("math/exp_cr", 0);
    _bench_unary("math/exp_polyfill", 1);
    _bench_args(0.001, 1000.0, 0.0, 1.0);
    _bench_unary("math/ln_cr", 2);
    _bench_unary("math/ln_polyfill", 3);
    _bench_unary("math/log10_cr", 4);
    _bench_args(-10.0, 10.0, 0.0, 1.0);
    _bench_unary("math/sin_cr", 5);
    _bench_unary("math/sin_builtin", 6);
    _bench_unary("math/cos_cr", 7);
    _bench_sin_cos();
    _bench_args(-1000.0, 1000.0, 0.0, 1.0);
    _bench_unary("math/cbrt_ganita", 8);
    _bench_args(-100.0, 100.0, -100.0, 100.0);
    _bench_binary("math/hypot_cr", 0);
    _bench_binary("math/hypot_ganita", 1);
    _bench_args(0.1, 10.0, -10.0, 10.0);
    _bench_binary("math/powf_cr", 2);
    _bench_binary("math/powf_ganita", 3);
    _bench_args(-1.0, 1.0, -1.0, 1.0);
    _bench_binary("math/atan2_cr", 4);
    _bench_binary("math/atan2_ganita", 5);
    # x % y: the periodic grid sampler's wrap, a backtraced coordinate against the grid size (M3).
    _bench_args(-200.0, 200.0, 4.0, 64.0);
    _bench_binary("math/fmod_stand_in", 6);
    return 0;
}

# ── common, ParticleSoa, ParticleArena (M1 part 3) ─────────────────────────────────────────────
# The bodies of scripts/probes/rust/src/bin/bench_common.rs, on the same inputs.

var NB = 10000;

# 1,000 particles on a 40-wide lattice, each with a velocity (the Rust twin's `particles()`).
fn _bench_particles(): i64 {
    var buf = fl_alloc(1000 * sizeof(PvFluidParticle));
    var ps: *PvFluidParticle = _pv_as_particles(buf);
    for (var i = 0; i < 1000; i = i + 1) {
        var x: f64 = f64_from(i % 40) * 0.025;
        var y: f64 = f64_from(i / 40) * 0.025;
        var p: PvFluidParticle = PvFluidParticle_new_2d(x, y, 0.001);
        var vx: f64 = f64_from(i % 7) * 0.1;
        var vy: f64 = f64_from(i % 5) * 0.2;
        p.velocity = PvVec3_new(vx, -vy, 0.0);
        var q: *PvFluidParticle = ps + i;
        *q = p;
    }
    return buf;
}

# The common module's benches (M1 part 3): validation, energy, the SoA and the arena.
fn bench_common() {
    var buf = _bench_particles();
    var ps: *PvFluidParticle = _pv_as_particles(buf);

    var b = bench_new("common/particle_new_2d");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var x: f64 = f64_from(i & 1023);
        var p: PvFluidParticle = PvFluidParticle_new_2d(x, 0.5, 0.001);
        g_sink = g_sink ^ _pv_bits(p.position.x);
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    b = bench_new("common/kinetic_energy");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var q: *PvFluidParticle = ps + (i % 1000);
        var e: f64 = q.kinetic_energy();
        g_sink = g_sink ^ _pv_bits(e);
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    var cfg: PvFluidConfig = PvFluidConfig_water_2d();
    b = bench_new("common/config_validate");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var t, v = cfg.validate();
        g_sink = g_sink ^ t;
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    b = bench_new("common/check_cfl");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var sp: f64 = f64_from(i & 63);
        var t2, v2 = cfg.check_cfl(sp);
        g_sink = g_sink ^ t2;
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    b = bench_new("common/material_custom");
    var m: PvFluidMaterial;
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var t3, v3 = PvFluidMaterial_custom(800.0, 0.01, 0.05, 1400.0, &m);
        g_sink = g_sink ^ _pv_bits(m.density);
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    var s: PvParticleSoa;
    b = bench_new("soa/from_aos_1000");
    bench_batch_start(b);
    for (var i = 0; i < NB; i = i + 1) {
        var ok = PvParticleSoa_from_aos(&s, ps, 1000);
        g_sink = g_sink ^ _pv_bits(s.pos_x.get_f(999));
        PvParticleSoa_drop(&s);
    }
    bench_batch_stop(b, NB);
    bench_report(b);

    var ok2 = PvParticleSoa_from_aos(&s, ps, 1000);
    b = bench_new("soa/to_aos_1000");
    bench_batch_start(b);
    for (var i = 0; i < NB; i = i + 1) {
        var bp, bn = s.to_aos();
        var last: *PvFluidParticle = _pv_as_particles(bp) + 999;
        g_sink = g_sink ^ _pv_bits(last.position.x);
        fl_free(bp);
    }
    bench_batch_stop(b, NB);
    bench_report(b);

    var outb = _bench_particles();
    var outp: *PvFluidParticle = _pv_as_particles(outb);
    b = bench_new("soa/write_to_aos_1000");
    bench_batch_start(b);
    for (var i = 0; i < NB; i = i + 1) {
        s.write_to_aos(outp, 1000);
        var lw: *PvFluidParticle = outp + 999;
        g_sink = g_sink ^ _pv_bits(lw.position.x);
    }
    bench_batch_stop(b, NB);
    bench_report(b);
    PvParticleSoa_drop(&s);

    # new(1000), 100 blocks of 10, every other one freed, then compact (500 records moved).
    var hs = fl_alloc(100 * sizeof(PvArenaHandle));
    b = bench_new("arena/cycle_1000");
    bench_batch_start(b);
    for (var i = 0; i < NB; i = i + 1) {
        var a: *PvParticleArena = PvParticleArena_new(1000);
        var hp: *PvArenaHandle = _bench_handles(hs);
        for (var k = 0; k < 100; k = k + 1) { var got = a.alloc(10, hp + k); }
        for (var k = 0; k < 100; k = k + 2) {
            var h: *PvArenaHandle = hp + k;
            a.free(*h);
        }
        g_sink = g_sink ^ a.compact();
        PvParticleArena_drop(a);
    }
    bench_batch_stop(b, NB);
    bench_report(b);
    fl_free(hs);
    fl_free(outb);
    fl_free(buf);
    return 0;
}

# ── buoyancy, vortex, bridge, JSON (M1 part 4) ──────────────────────────────────────────────────
# The bodies of bench_common.rs's m1/* and json/* rows, on the same inputs (k & 1023 scaled per row).

# The buoyancy, vortex, bridge and JSON benches (M1 part 4).
fn bench_m1b() {
    var b = bench_new("m1/terminal_velocity");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var m: f64 = 1.0 + f64_from(i & 1023) * 0.001;
        var t, v = terminal_velocity(m, 9.81, 1.225, 0.47, 0.01);
        g_sink = g_sink ^ v;
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    b = bench_new("m1/reynolds_number");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var u: f64 = f64_from(i & 1023) * 0.01;
        var t2, v2 = reynolds_number(1000.0, u, 0.1, 0.001);
        g_sink = g_sink ^ v2;
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    b = bench_new("m1/lamb_oseen_velocity");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var r: f64 = 0.01 + f64_from(i & 1023) * 0.0001;
        var l: f64 = lamb_oseen_velocity(1.0, r, 0.001, 1.0);
        g_sink = g_sink ^ _pv_bits(l);
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    b = bench_new("m1/kolmogorov_scale");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var e: f64 = 0.001 + f64_from(i & 1023) * 0.001;
        var k: f64 = kolmogorov_scale(0.000001, e);
        g_sink = g_sink ^ _pv_bits(k);
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    var field = fl_alloc(8000);
    for (var j = 0; j < 1000; j = j + 1) {
        var w: f64 = f64_from(j % 17) * 0.1 - 0.8;
        store64(field + j * 8, w);
    }
    b = bench_new("m1/enstrophy_1000");
    bench_batch_start(b);
    for (var i = 0; i < 100000; i = i + 1) {
        var en: f64 = enstrophy(field, 1000, 0.01);
        g_sink = g_sink ^ _pv_bits(en);
    }
    bench_batch_stop(b, 100000);
    bench_report(b);
    fl_free(field);

    b = bench_new("m1/water_viscosity");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var tk: f64 = 273.0 + f64_from(i & 1023) * 0.0977;
        var mu: f64 = temperature_to_water_viscosity(tk);
        g_sink = g_sink ^ _pv_bits(mu);
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    b = bench_new("m1/broadband_noise_db");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var ke: f64 = 0.001 + f64_from(i & 1023) * 0.01;
        var db: f64 = tke_to_broadband_noise_db(ke);
        g_sink = g_sink ^ _pv_bits(db);
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    # JSON: a config written and read, a particle read, a 100-particle SoA read (serde_json's documents).
    var cfg: PvFluidConfig = PvFluidConfig_water_2d();
    b = bench_new("json/config_write");
    bench_batch_start(b);
    for (var i = 0; i < 100000; i = i + 1) {
        var sb = str_builder_new();
        var rc = cfg.to_json(sb);
        g_sink = g_sink ^ rc;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    var sbc = str_builder_new();
    var rcc = cfg.to_json(sbc);
    var cdoc = str_builder_build(sbc);
    var c2: PvFluidConfig;
    b = bench_new("json/config_read");
    bench_batch_start(b);
    for (var i = 0; i < 100000; i = i + 1) {
        var t3, v3 = PvFluidConfig_from_json(str_data(cdoc), str_len(cdoc), &c2);
        g_sink = g_sink ^ t3;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    var buf = _bench_particles();
    var ps: *PvFluidParticle = _pv_as_particles(buf);
    var p17: *PvFluidParticle = ps + 17;
    var sbp = str_builder_new();
    var rcp = p17.to_json(sbp);
    var pdoc = str_builder_build(sbp);
    var q: PvFluidParticle;
    b = bench_new("json/particle_read");
    bench_batch_start(b);
    for (var i = 0; i < 100000; i = i + 1) {
        var t4, v4 = PvFluidParticle_from_json(str_data(pdoc), str_len(pdoc), &q);
        g_sink = g_sink ^ t4;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);

    var small: PvParticleSoa;
    var okf = PvParticleSoa_from_aos(&small, ps, 100);
    var sbs = str_builder_new();
    var rcs = small.to_json(sbs);
    var sdoc = str_builder_build(sbs);
    var s2: PvParticleSoa;
    b = bench_new("json/soa_read_100");
    bench_batch_start(b);
    for (var i = 0; i < NB; i = i + 1) {
        var t5, v5 = PvParticleSoa_from_json(str_data(sdoc), str_len(sdoc), &s2);
        g_sink = g_sink ^ s2.len();
        PvParticleSoa_drop(&s2);
    }
    bench_batch_stop(b, NB);
    bench_report(b);
    PvParticleSoa_drop(&small);
    fl_free(buf);
    return 0;
}

# ── shallow water (M2): Rust's criterion benches shallow_step, shallow_volume, shallow_disturbance ──
# rust-old/benches/benchmarks.rs: an n × n grid (n = 32, 64, 128) at dx 0.1 and depth 1. The step and disturbance
# benches time a fresh clone each iteration (criterion's iter_batched excludes the clone; so does this: it clones
# outside the timed batch, into a pool).

fn _bench_sw_step(n, iters) {
    var base: PvShallowWater;
    var t, v = PvShallowWater_new(n, n, 0.1, 1.0, &base);
    var c: f64 = f64_from(n) * 0.1 / 2.0;
    base.add_disturbance(c, c, 0.5, 0.3);
    var pool = fl_alloc(iters * sizeof(PvShallowWater));
    for (var k = 0; k < iters; k = k + 1) { var ok = PvShallowWater_clone(_bench_sw(pool, k), &base); }
    var b = bench_new(_bench_name("shallow_step/", n));
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        var s: *PvShallowWater = _bench_sw(pool, k);
        var ts, vs = s.step(0.001);
        g_sink = g_sink ^ ts;
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    for (var k = 0; k < iters; k = k + 1) { PvShallowWater_drop(_bench_sw(pool, k)); }
    fl_free(pool);
    PvShallowWater_drop(&base);
    return 0;
}

fn _bench_sw_volume(n, iters) {
    var sw: PvShallowWater;
    var t, v = PvShallowWater_new(n, n, 0.1, 1.0, &sw);
    var b = bench_new(_bench_name("shallow_volume/", n));
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        var tv: f64 = sw.total_volume();
        g_sink = g_sink ^ _pv_bits(tv);
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    PvShallowWater_drop(&sw);
    return 0;
}

fn _bench_sw_disturbance(n, iters) {
    var base: PvShallowWater;
    var t, v = PvShallowWater_new(n, n, 0.1, 1.0, &base);
    var c: f64 = f64_from(n) * 0.1 / 2.0;
    var pool = fl_alloc(iters * sizeof(PvShallowWater));
    for (var k = 0; k < iters; k = k + 1) { var ok = PvShallowWater_clone(_bench_sw(pool, k), &base); }
    var b = bench_new(_bench_name("shallow_disturbance/", n));
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        var s: *PvShallowWater = _bench_sw(pool, k);
        s.add_disturbance(c, c, 0.3, 0.5);
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    for (var k = 0; k < iters; k = k + 1) { PvShallowWater_drop(_bench_sw(pool, k)); }
    fl_free(pool);
    PvShallowWater_drop(&base);
    return 0;
}

# State k of a pool of states.
#must_use
fn _bench_sw(pool, k): *PvShallowWater {
    var p: *PvShallowWater = _bench_as_sw(pool);
    return p + k;
}

#must_use
fn _bench_as_sw(p): *PvShallowWater {
    return p;
}

# `prefix` followed by `n`x`n`, as a fresh C string.
fn _bench_name(prefix, n): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, prefix);
    str_builder_add_int(sb, n);
    str_builder_add_cstr(sb, "x");
    str_builder_add_int(sb, n);
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

# The shallow-water benches (M2): Rust's criterion step, volume and disturbance.
fn bench_shallow() {
    _bench_sw_step(32, 200);
    _bench_sw_step(64, 100);
    _bench_sw_step(128, 20);
    _bench_sw_volume(32, 100000);
    _bench_sw_volume(64, 20000);
    _bench_sw_volume(128, 5000);
    _bench_sw_disturbance(32, 400);
    _bench_sw_disturbance(64, 200);
    _bench_sw_disturbance(128, 50);
    return 0;
}

# ── grid (M3): Rust's criterion benches grid_diffuse, grid_max_speed, grid_step, grid_step_maccormack,
# grid_step_periodic ──
# rust-old/benches/benchmarks.rs. diffuse: an n × n field of zeros with 100 at n²/2, rate 0.1, dt 0.01, dx 0.1, 20
# sweeps, on a fresh copy each time. max_speed: vx = sin(0.01·i), vy = cos(0.01·i) at dx 0.01. The steps: the smoke
# config (the DST projection), with MacCormack at dt 0.01, or on periodic walls (Gauss–Seidel), on an n × n grid
# (n = 15, 30, 63) at dx 0.1 with density 1 and vy 1 on four cells of row 2. Clones are made outside the timed batch,
# as criterion's iter_batched excludes them.

fn _bench_fg_diffuse(n, iters) {
    var cells = n * n;
    var pool = fl_alloc(iters * cells * 8);
    for (var k = 0; k < iters; k = k + 1) {
        var f = pool + k * cells * 8;
        for (var i = 0; i < cells; i = i + 1) { store64(f + i * 8, 0); }
        store64(f + (cells / 2) * 8, _pv_bits(100.0));
    }
    var b = bench_new(_bench_name("grid_diffuse/", n));
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        var ok = PvFluidGrid_diffuse(pool + k * cells * 8, cells, n, n, 0.1, 0.01, 0.1, 20);
        g_sink = g_sink ^ ok;
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    fl_free(pool);
    return 0;
}

fn _bench_fg_max_speed(n, iters) {
    var g: PvFluidGrid;
    var t, v = PvFluidGrid_new(n, n, 0.01, &g);
    for (var i = 0; i < n * n; i = i + 1) {
        var a: f64 = f64_from(i) * 0.01;
        var sa: f64 = _pv_sin(a);
        var ca: f64 = _pv_cos(a);
        store64(g.vx.data + i * 8, _pv_bits(sa));
        store64(g.vy.data + i * 8, _pv_bits(ca));
    }
    var b = bench_new(_bench_name("grid_max_speed/", n));
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        var ms: f64 = g.max_speed();
        g_sink = g_sink ^ _pv_bits(ms);
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    PvFluidGrid_drop(&g);
    return 0;
}

# kind 0: grid_step (smoke), 1: grid_step_maccormack (dt 0.01), 2: grid_step_periodic, 3: grid_step_warm (Cyrius
# only: the smoke step from a base stepped once, so each clone carries the DST plans, as every step after a grid's
# first does; kinds 0 and 1 time the first step, which builds them).
fn _bench_fg_step(n, iters, kind) {
    var base: PvFluidGrid;
    var t, v = PvFluidGrid_new(n, n, 0.1, &base);
    var mid = n / 2;
    for (var x = mid - 2; x < mid + 2; x = x + 1) {
        var i = 2 * n + x;
        store64(base.density.data + i * 8, _pv_bits(1.0));
        store64(base.vy.data + i * 8, _pv_bits(1.0));
    }
    var c: PvGridConfig = PvGridConfig_smoke();
    var name = "grid_step/";
    if (kind == 1) {
        c.use_maccormack = 1;
        c.dt = 0.01;
        name = "grid_step_maccormack/";
    }
    if (kind == 2) {
        c.boundary = PV_BOUNDARY_CONDITION_PERIODIC;
        name = "grid_step_periodic/";
    }
    if (kind == 3) {
        var tw, vw = base.step(&c);
        name = "grid_step_warm/";
    }
    var pool = fl_alloc(iters * sizeof(PvFluidGrid));
    for (var k = 0; k < iters; k = k + 1) { var ok = PvFluidGrid_clone(_bench_fg(pool, k), &base); }
    var b = bench_new(_bench_name(name, n));
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        var s: *PvFluidGrid = _bench_fg(pool, k);
        var ts, vs = s.step(&c);
        g_sink = g_sink ^ ts;
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    for (var k = 0; k < iters; k = k + 1) { PvFluidGrid_drop(_bench_fg(pool, k)); }
    fl_free(pool);
    PvFluidGrid_drop(&base);
    return 0;
}

# `prefix` followed by `t`, "/" and `n`x`n`, as a fresh C string (a thread-count bench's label).
fn _bench_name_t(prefix, t, n): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, prefix);
    str_builder_add_int(sb, t);
    str_builder_add_cstr(sb, "/");
    str_builder_add_int(sb, n);
    str_builder_add_cstr(sb, "x");
    str_builder_add_int(sb, n);
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

# The grid step at a thread count (M3 part e; Cyrius-only): kind 0 the smoke step (the DST projection), 2 the
# periodic one, on the bench's plume, `iters` steps of one grid after a first that starts its pool (a clone per step
# would time a pool start each time). The bits are the one-thread ones at every count.
fn _bench_fg_threads(n, iters, kind, threads) {
    var g: PvFluidGrid;
    var t, v = PvFluidGrid_new(n, n, 0.1, &g);
    var mid = n / 2;
    for (var x = mid - 2; x < mid + 2; x = x + 1) {
        var i = 2 * n + x;
        store64(g.density.data + i * 8, _pv_bits(1.0));
        store64(g.vy.data + i * 8, _pv_bits(1.0));
    }
    var c: PvGridConfig = PvGridConfig_smoke();
    var name = "grid_step_t";
    if (kind == 2) {
        c.boundary = PV_BOUNDARY_CONDITION_PERIODIC;
        name = "grid_step_periodic_t";
    }
    var set = g.set_threads(threads);
    var t0, v0 = g.step(&c);
    var b = bench_new(_bench_name_t(name, threads, n));
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        var ts, vs = g.step(&c);
        g_sink = g_sink ^ ts;
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    PvFluidGrid_drop(&g);
    return 0;
}

# Grid k of a pool of grids.
#must_use
fn _bench_fg(pool, k): *PvFluidGrid {
    var p: *PvFluidGrid = _bench_as_fg(pool);
    return p + k;
}

#must_use
fn _bench_as_fg(p): *PvFluidGrid {
    return p;
}

# The grid benches (M3): Rust's criterion diffuse, max_speed and steps, and the warm step.
fn bench_grid() {
    _bench_fg_diffuse(32, 200);
    _bench_fg_diffuse(64, 50);
    _bench_fg_diffuse(128, 20);
    _bench_fg_max_speed(32, 100000);
    _bench_fg_max_speed(64, 20000);
    _bench_fg_max_speed(128, 5000);
    for (var kind = 0; kind < 4; kind = kind + 1) {
        _bench_fg_step(15, 100, kind);
        _bench_fg_step(30, 20, kind);
        _bench_fg_step(63, 5, kind);
    }
    return 0;
}

# ── grid, part c (M3): MacGrid, KEpsilon, apply_ghost_fluid ──
# Rust has no criterion bench for these; scripts/probes/rust/src/bin/bench_grid_c.rs times the same bodies on the
# oracle. Each times `iters` calls on one state (which evolves the same way on both sides): mac_step on an n × n grid
# at dx 0.1 with a 4 × 2 density blob at the floor's centre and the smoke config; kepsilon_step from `new(n, n)`
# under a solid-body rotation, dx 0.1, dt 0.01; ghost_fluid on a zero pressure and a circle's signed distance.

fn _bench_mac_step(n, iters) {
    var g: PvMacGrid;
    var t, v = PvMacGrid_new(n, n, 0.1, &g);
    for (var x = n / 2 - 2; x < n / 2 + 2; x = x + 1) {
        store64(g.density.data + (n + x) * 8, _pv_bits(1.0));
        store64(g.density.data + (2 * n + x) * 8, _pv_bits(1.0));
    }
    var c: PvGridConfig = PvGridConfig_smoke();
    var b = bench_new(_bench_name("mac_step/", n));
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        var ts, vs = g.step(&c);
        g_sink = g_sink ^ ts;
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    PvMacGrid_drop(&g);
    return 0;
}

fn _bench_ke_step(n, iters) {
    var ke: PvKEpsilon;
    var ok = PvKEpsilon_new(n, n, &ke);
    var vx = fl_alloc(n * n * 8);
    var vy = fl_alloc(n * n * 8);
    var c: f64 = (f64_from(n) - 1.0) * 0.5;
    for (var i = 0; i < n * n; i = i + 1) {
        var y: f64 = f64_from(i / n) - c;
        var x: f64 = f64_from(i % n) - c;
        var u: f64 = -y * 0.5;
        var w: f64 = x * 0.5;
        store64(vx + i * 8, _pv_bits(u));
        store64(vy + i * 8, _pv_bits(w));
    }
    var b = bench_new(_bench_name("kepsilon_step/", n));
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        var r = ke.step(vx, n * n, vy, n * n, n, n, 0.1, 0.01);
        g_sink = g_sink ^ load64(ke.k.data + (n + 1) * 8);
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    fl_free(vx);
    fl_free(vy);
    PvKEpsilon_drop(&ke);
    return 0;
}

fn _bench_ghost(n, iters) {
    var nf: f64 = f64_from(n);
    var cx: f64 = (nf * 0.5) + 0.3;
    var cy: f64 = (nf * 0.5) - 0.2;
    var r: f64 = (nf * 0.1) * 0.25;
    var ls = fl_alloc(n * n * 8);
    var p = fl_alloc(n * n * 8);
    for (var i = 0; i < n * n; i = i + 1) {
        var x: f64 = f64_from(i % n) - cx;
        var y: f64 = f64_from(i / n) - cy;
        var d: f64 = f64_sqrt((x * x) + (y * y));
        var s: f64 = (d * 0.1) - r;
        store64(ls + i * 8, _pv_bits(s));
        store64(p + i * 8, 0);
    }
    var b = bench_new(_bench_name("ghost_fluid/", n));
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        var ok = apply_ghost_fluid(p, n * n, ls, n * n, n, n, 0.1, 0.07);
        g_sink = g_sink ^ load64(p + (n * n / 2) * 8);
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    fl_free(ls);
    fl_free(p);
    return 0;
}

# The grid step at 1, 2, 4 and 8 threads (M3 part e), on Rust's 63 × 63 bench grid and a 255 × 255 one.
fn bench_threads() {
    for (var k = 0; k < 4; k = k + 1) {
        var t = 1;
        if (k == 1) { t = 2; }
        if (k == 2) { t = 4; }
        if (k == 3) { t = 8; }
        _bench_fg_threads(63, 50, 2, t);
        _bench_fg_threads(255, 10, 2, t);
        _bench_fg_threads(63, 50, 0, t);
    }
    return 0;
}

# The part c benches (M3 part c): MacGrid, KEpsilon and the ghost fluid, against the Rust twins in bench_grid_c.rs.
fn bench_grid_c() {
    _bench_mac_step(16, 2000);
    _bench_mac_step(32, 500);
    _bench_mac_step(64, 100);
    _bench_ke_step(32, 2000);
    _bench_ke_step(64, 500);
    _bench_ke_step(128, 100);
    _bench_ghost(32, 5000);
    _bench_ghost(64, 1000);
    _bench_ghost(128, 200);
    return 0;
}

# ── vof and phase_field (M3 part d) ──
# Rust has no criterion bench for these; scripts/probes/rust/src/bin/bench_vof_pf.rs times the same bodies on the
# oracle. Each times `iters` calls on one state: vof_advect on an n × n field at dx 0.1 with [0.2·L, 0.6·L]² filled
# (L = n·dx), in the rotation u = −0.1·(y − c), v = 0.1·(x − c), dt 0.01; phase_field_step with a disc of radius
# 0.25·L at the centre, in the same rotation, dt 0.001.

# The rotation u = −0.1·(y − c), v = 0.1·(x − c) on an n × n grid into the n² words at vx and vy.
fn _bench_rotation(n, vx, vy) {
    var c: f64 = (f64_from(n) - 1.0) * 0.5;
    for (var i = 0; i < n * n; i = i + 1) {
        var y: f64 = f64_from(i / n) - c;
        var x: f64 = f64_from(i % n) - c;
        var u: f64 = -y * 0.1;
        var w: f64 = x * 0.1;
        store64(vx + i * 8, _pv_bits(u));
        store64(vy + i * 8, _pv_bits(w));
    }
    return 0;
}

fn _bench_vof(n, iters) {
    var v: PvVofField;
    var t, e = PvVofField_new(n, n, 0.1, &v);
    var l: f64 = f64_from(n) * 0.1;
    var lo: f64 = 0.2 * l;
    var hi: f64 = 0.6 * l;
    v.fill_rect(lo, lo, hi, hi);
    var vx = fl_alloc(n * n * 8);
    var vy = fl_alloc(n * n * 8);
    _bench_rotation(n, vx, vy);
    var b = bench_new(_bench_name("vof_advect/", n));
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        var ta, va = v.advect(vx, n * n, vy, n * n, 0.01);
        g_sink = g_sink ^ ta;
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    fl_free(vx);
    fl_free(vy);
    PvVofField_drop(&v);
    return 0;
}

fn _bench_pf(n, iters) {
    var p: PvPhaseField;
    var t, e = PvPhaseField_new(n, n, 0.1, &p);
    var l: f64 = f64_from(n) * 0.1;
    var c: f64 = 0.5 * l;
    var r: f64 = 0.25 * l;
    p.set_circle(c, c, r);
    var vx = fl_alloc(n * n * 8);
    var vy = fl_alloc(n * n * 8);
    _bench_rotation(n, vx, vy);
    var b = bench_new(_bench_name("phase_field_step/", n));
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        var ts, vs = p.step(vx, n * n, vy, n * n, 0.001);
        g_sink = g_sink ^ ts;
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    fl_free(vx);
    fl_free(vy);
    PvPhaseField_drop(&p);
    return 0;
}

# The part d benches (M3 part d): VOF advection and the phase-field step, against the Rust twins in bench_vof_pf.rs.
fn bench_m3d() {
    _bench_vof(32, 2000);
    _bench_vof(64, 500);
    _bench_vof(128, 100);
    _bench_pf(32, 2000);
    _bench_pf(64, 500);
    _bench_pf(128, 100);
    return 0;
}

# ── sph, part a (M4) ──
# sph_kernels/*: Rust's criterion group (poly6, spiky_grad, viscosity_laplacian at (0.3, 1.0)). sph_a/*: the rest of
# part a, against scripts/probes/rust/src/bin/bench_sph_a.rs on the same arguments: the Wendland kernels at (0.3, 1),
# Tait at (1010, 1000, 1480, 7) and γ = 0, the power law (0.5, 0.7) at 2, batch_poly6 over 1,000 squared distances
# k·0.0012 at h 1, and the totals over a 1,000-particle 40-wide lattice. The arguments are globals, so no call folds.
var g_r: f64 = 0.3;
var g_h: f64 = 1.0;

# One kernel or equation of state `which` (0–6), `iters` calls at the fixed arguments.
fn _bench_sph_kernel(name, which, iters) {
    var b = bench_new(name);
    var acc = 0;
    bench_batch_start(b);
    # One loop per function, so the timed body is the call alone (as Rust's).
    if (which == 0) {
        for (var k = 0; k < iters; k = k + 1) {
            var w0: f64 = kernel_poly6(g_r, g_h);
            acc = acc ^ _pv_bits(w0);
        }
    }
    if (which == 1) {
        for (var k1 = 0; k1 < iters; k1 = k1 + 1) {
            var w1: f64 = kernel_spiky_grad(g_r, g_h);
            acc = acc ^ _pv_bits(w1);
        }
    }
    if (which == 2) {
        for (var k2 = 0; k2 < iters; k2 = k2 + 1) {
            var w2: f64 = kernel_viscosity_laplacian(g_r, g_h);
            acc = acc ^ _pv_bits(w2);
        }
    }
    if (which == 3) {
        for (var k3 = 0; k3 < iters; k3 = k3 + 1) {
            var w3: f64 = kernel_wendland_c2(g_r, g_h);
            acc = acc ^ _pv_bits(w3);
        }
    }
    if (which == 4) {
        for (var k4 = 0; k4 < iters; k4 = k4 + 1) {
            var w4: f64 = kernel_wendland_c4_grad(g_r, g_h);
            acc = acc ^ _pv_bits(w4);
        }
    }
    if (which == 5) {
        for (var k5 = 0; k5 < iters; k5 = k5 + 1) {
            var w5: f64 = equation_of_state_tait(1010.0, 1000.0, 1480.0, 7.0);
            acc = acc ^ _pv_bits(w5);
        }
    }
    if (which == 6) {
        for (var k6 = 0; k6 < iters; k6 = k6 + 1) {
            var w6: f64 = equation_of_state_tait(1010.0, 1000.0, 1480.0, 0.0);
            acc = acc ^ _pv_bits(w6);
        }
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    g_sink = g_sink ^ acc;
    return 0;
}

# The part a benches (M4 part a): Rust's sph_kernels group and the bench_sph_a.rs twins.
fn bench_sph_a() {
    _bench_sph_kernel("sph_kernels/poly6", 0, 1000000);
    _bench_sph_kernel("sph_kernels/spiky_grad", 1, 1000000);
    _bench_sph_kernel("sph_kernels/viscosity_laplacian", 2, 1000000);
    _bench_sph_kernel("sph_a/wendland_c2", 3, 1000000);
    _bench_sph_kernel("sph_a/wendland_c4_grad", 4, 1000000);
    _bench_sph_kernel("sph_a/tait", 5, 200000);
    _bench_sph_kernel("sph_a/tait_gamma0", 6, 200000);
    var nn: PvNonNewtonianModel = PvNonNewtonianModel_power_law(0.5, 0.7);
    var bn = bench_new("sph_a/power_law");
    bench_batch_start(bn);
    for (var k = 0; k < 200000; k = k + 1) {
        var mu: f64 = non_newtonian_viscosity_effective_viscosity(&nn, 2.0);
        g_sink = g_sink ^ _pv_bits(mu);
    }
    bench_batch_stop(bn, 200000);
    bench_report(bn);
    var r2 = fl_alloc(8000);
    for (var i = 0; i < 1000; i = i + 1) {
        var x: f64 = f64_from(i) * 0.0012;
        store64(r2 + i * 8, _pv_bits(x));
    }
    var bb = bench_new("sph_a/batch_poly6_1000");
    bench_batch_start(bb);
    for (var k2 = 0; k2 < 5000; k2 = k2 + 1) {
        var wp, wn = batch_poly6(r2, 1000, 1.0);
        g_sink = g_sink ^ load64(wp + 999 * 8);
        fl_free(wp);
    }
    bench_batch_stop(bb, 5000);
    bench_report(bb);
    fl_free(r2);
    var buf = fl_alloc(1000 * sizeof(PvFluidParticle));
    var ps: *PvFluidParticle = _pv_as_particles(buf);
    for (var j = 0; j < 1000; j = j + 1) {
        var q: PvFluidParticle = PvFluidParticle_new_2d(f64_from(j % 40) * 0.025, f64_from(j / 40) * 0.025, 0.001);
        var vx: f64 = f64_from(j % 7) * 0.1;
        var vy: f64 = f64_from(j % 5) * 0.2;
        var nvy: f64 = -vy;
        q.velocity = PvVec3_new(vx, nvy, 0.0);
        memcpy(ps + j, &q, sizeof(PvFluidParticle));
    }
    var bk = bench_new("sph_a/total_kinetic_energy_1000");
    bench_batch_start(bk);
    for (var k3 = 0; k3 < 20000; k3 = k3 + 1) {
        var ke: f64 = total_kinetic_energy(ps, 1000);
        g_sink = g_sink ^ _pv_bits(ke);
    }
    bench_batch_stop(bk, 20000);
    bench_report(bk);
    var bm = bench_new("sph_a/max_speed_1000");
    bench_batch_start(bm);
    for (var k4 = 0; k4 < 20000; k4 = k4 + 1) {
        var ms: f64 = max_speed(ps, 1000);
        g_sink = g_sink ^ _pv_bits(ms);
    }
    bench_batch_stop(bm, 20000);
    bench_report(bm);
    fl_free(buf);
    return 0;
}

# ── sph, part b (M4) ──
# sph_b/*: against scripts/probes/rust/src/bin/bench_sph_b.rs on the same inputs: the neighbour build (a grid kept
# across builds, as the solver's) on a 40-wide 2D lattice of 1,000 at spacing 0.025 and on a 10³ one, both at h 0.05;
# `sort_by_zorder` on the 2D lattice in a fixed shuffle (k → k·389 mod 1000), copied in (record assignments, the
# Cyrius form of Rust's `copy_from_slice`; `memcpy` goes byte by byte) and sorted at cell 0.025 per call.

# A 1,000-particle lattice at spacing 0.025 into a new buffer: 40 wide in 2D, or 10³.
fn _bench_lattice(three_d) {
    var buf = fl_alloc(1000 * sizeof(PvFluidParticle));
    var ps: *PvFluidParticle = _pv_as_particles(buf);
    for (var k = 0; k < 1000; k = k + 1) {
        var x: f64 = f64_from(k % 40) * 0.025;
        var y: f64 = f64_from(k / 40) * 0.025;
        var z: f64 = 0.0;
        if (three_d == 1) {
            x = f64_from(k % 10) * 0.025;
            y = f64_from((k / 10) % 10) * 0.025;
            z = f64_from(k / 100) * 0.025;
        }
        var q: PvFluidParticle = PvFluidParticle_new_2d(x, y, 0.001);
        q.position = PvVec3_new(x, y, z);
        memcpy(ps + k, &q, sizeof(PvFluidParticle));
    }
    return buf;
}

# One neighbour-build row: `iters` builds of the lattice at h 0.05 after one that sizes the grid.
fn _bench_nb(name, three_d, iters) {
    var buf = _bench_lattice(three_d);
    var ps: *PvFluidParticle = _pv_as_particles(buf);
    var g: PvNeighborGrid;
    PvNeighborGrid_init(&g);
    g_sink = g_sink ^ _pv_nb_build(&g, ps, 1000, 0.05);
    var b = bench_new(name);
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        g_sink = g_sink ^ _pv_nb_build(&g, ps, 1000, 0.05);
        g_sink = g_sink ^ g.indices.len;
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    PvNeighborGrid_drop(&g);
    fl_free(buf);
    return 0;
}

# The part b benches (M4 part b): the bench_sph_b.rs twins.
fn bench_sph_b() {
    _bench_nb("sph_b/neighbor_build_2d_1000", 0, 500);
    _bench_nb("sph_b/neighbor_build_3d_1000", 1, 200);
    var lat = _bench_lattice(0);
    var sz = sizeof(PvFluidParticle);
    var shuf = fl_alloc(1000 * sz);
    var work = fl_alloc(1000 * sz);
    for (var k = 0; k < 1000; k = k + 1) { memcpy(shuf + ((k * 389) % 1000) * sz, lat + k * sz, sz); }
    var wp: *PvFluidParticle = _pv_as_particles(work);
    var sp: *PvFluidParticle = _pv_as_particles(shuf);
    var bz = bench_new("sph_b/zorder_1000");
    bench_batch_start(bz);
    for (var k2 = 0; k2 < 1000; k2 = k2 + 1) {
        for (var c = 0; c < 1000; c = c + 1) {
            var d: *PvFluidParticle = wp + c;
            var e: *PvFluidParticle = sp + c;
            *d = *e;
        }
        g_sink = g_sink ^ sort_by_zorder(wp, 1000, 0.025);
        g_sink = g_sink ^ _pv_bits(wp.position.x);
    }
    bench_batch_stop(bz, 1000);
    bench_report(bz);
    fl_free(work);
    fl_free(shuf);
    fl_free(lat);
    return 0;
}

# ── sph, part c (M4) ──
# Rust's criterion groups on the same inputs: `sph_density/<n>_particles` (particle 0's density in a unit block at
# spacing 1/√n, h 0.05), `sph_step/<count>_particles` (one free step of the block at (0.1, 0.3), size 0.5, spacing
# 1/√n for n = 25, 100, 225, under water_2d at water's viscosity) and `sph_pressure_force/625_particles` (the 0.5
# block at 0.02, density 1000, pressure 100). Criterion's `iter_batched` clones the step's particles outside the
# timing; here each step copies them in by assignment, about 12 ns a particle. sph_c/*: against
# scripts/probes/rust/src/bin/bench_sph_c.rs (bodies in its header).

# "<prefix><n><suffix>" as a C string (criterion's `{n}_particles` names).
fn _bench_name_n(prefix, n, suffix): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, prefix);
    str_builder_add_int(sb, n);
    str_builder_add_cstr(sb, suffix);
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

# One `sph_density` row: `iters` calls on a unit block at spacing 1/√n.
fn _bench_density(n, iters) {
    var nf: f64 = f64_from(n);
    var rt: f64 = f64_sqrt(nf);
    var sp: f64 = 1.0 / rt;
    var bp, bn = create_particle_block(0.0, 0.0, 1.0, 1.0, sp, 0.001);
    var ps: *PvFluidParticle = _pv_as_particles(bp);
    var b = bench_new(_bench_name_n("sph_density/", n, "_particles"));
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        var d: f64 = compute_density(0, ps, bn, 0.05);
        g_sink = g_sink ^ _pv_bits(d);
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    fl_free(bp);
    return 0;
}

# One `sph_step` row: `iters` steps of a fresh copy of the block at spacing 1/√n.
fn _bench_free_step(n, iters) {
    var nf: f64 = f64_from(n);
    var rt: f64 = f64_sqrt(nf);
    var sp: f64 = 1.0 / rt;
    var bp, bn = create_particle_block(0.1, 0.3, 0.5, 0.5, sp, 0.001);
    var src: *PvFluidParticle = _pv_as_particles(bp);
    var work: *PvFluidParticle = _pv_as_particles(fl_alloc(bn * sizeof(PvFluidParticle)));
    var cfg: PvFluidConfig = PvFluidConfig_water_2d();
    var mu: f64 = PV_FLUID_MATERIAL_WATER_VISCOSITY;
    var b = bench_new(_bench_name_n("sph_step/", bn, "_particles"));
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        for (var c = 0; c < bn; c = c + 1) {
            var d: *PvFluidParticle = work + c;
            var e: *PvFluidParticle = src + c;
            *d = *e;
        }
        var t, v = sph_step(work, bn, &cfg, mu);
        g_sink = g_sink ^ t;
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    fl_free(work);
    fl_free(bp);
    return 0;
}

# The part c benches (M4 part c): Rust's criterion groups and the bench_sph_c.rs twins.
fn bench_sph_c() {
    _bench_density(100, 200000);
    _bench_density(500, 50000);
    _bench_density(1000, 20000);
    _bench_free_step(25, 20000);
    _bench_free_step(100, 5000);
    _bench_free_step(225, 1000);
    var fp, fcount = create_particle_block(0.0, 0.0, 0.5, 0.5, 0.02, 0.001);
    var f: *PvFluidParticle = _pv_as_particles(fp);
    for (var i = 0; i < fcount; i = i + 1) {
        var q: *PvFluidParticle = f + i;
        q.density = 1000.0;
        q.pressure = 100.0;
    }
    var bf = bench_new("sph_pressure_force/625_particles");
    bench_batch_start(bf);
    for (var k = 0; k < 20000; k = k + 1) {
        var pv: PvVec3 = pressure_force(0, f, fcount, 0.05);
        g_sink = g_sink ^ _pv_bits(pv.x);
    }
    bench_batch_stop(bf, 20000);
    bench_report(bf);
    var bv = bench_new("sph_c/viscosity_force_625");
    bench_batch_start(bv);
    for (var k2 = 0; k2 < 20000; k2 = k2 + 1) {
        var vv: PvVec3 = viscosity_force(0, f, fcount, 0.05, 0.001);
        g_sink = g_sink ^ _pv_bits(vv.x);
    }
    bench_batch_stop(bv, 20000);
    bench_report(bv);
    fl_free(fp);
    var bb = bench_new("sph_c/create_particle_block_1000");
    bench_batch_start(bb);
    for (var k3 = 0; k3 < 2000; k3 = k3 + 1) {
        var cp, cn = create_particle_block(0.1, 0.3, 1.0, 0.625, 0.025, 0.001);
        var c999: *PvFluidParticle = _pv_as_particles(cp) + 999;
        g_sink = g_sink ^ cn ^ _pv_bits(c999.position.x);
        fl_free(cp);
    }
    bench_batch_stop(bb, 2000);
    bench_report(bb);
    var parent: PvFluidParticle = PvFluidParticle_new_2d(0.3, 0.7, 0.04);
    parent.velocity = PvVec3_new(1.5, -0.5, 0.25);
    var bs = bench_new("sph_c/split_particle_8");
    bench_batch_start(bs);
    for (var k4 = 0; k4 < 200000; k4 = k4 + 1) {
        var sp, sn = split_particle(&parent, 8, 0.01);
        var s7: *PvFluidParticle = _pv_as_particles(sp) + 7;
        g_sink = g_sink ^ _pv_bits(s7.position.y);
        fl_free(sp);
    }
    bench_batch_stop(bs, 200000);
    bench_report(bs);
    var ma: PvFluidParticle = PvFluidParticle_new_2d(0.1, 0.2, 0.01);
    ma.velocity = PvVec3_new(1.0, 2.0, 0.0);
    var mb: PvFluidParticle = PvFluidParticle_new_2d(0.3, 0.1, 0.03);
    mb.velocity = PvVec3_new(-1.0, 0.5, 0.0);
    var bm = bench_new("sph_c/merge_particles");
    bench_batch_start(bm);
    for (var k5 = 0; k5 < 1000000; k5 = k5 + 1) {
        var mm: PvFluidParticle = merge_particles(&ma, &mb);
        g_sink = g_sink ^ _pv_bits(mm.position.x);
    }
    bench_batch_stop(bm, 1000000);
    bench_report(bm);
    return 0;
}

# ── sph, part d (M4) ──
# sph_d/*: against scripts/probes/rust/src/bin/bench_sph_d.rs (bodies in its header): the 25 × 25 block at spacing 0.02
# (density 1000, velocity (sin 0.1i, cos 0.1i, 0)), brute-force lists at h 0.05, and the same sequence of calls on a
# fresh copy per row. Also two of Rust's criterion groups part c's record missed: `sph_viscosity_force/625_particles`
# (the same block) and `create_particle_block/<n>_particles` (a unit block at spacing 1/√n).

# The part d bench block: 625 particles, the fields the functions read set; `hot` 1 for 600–610 K (above ignition).
fn _bench_d_block(hot) {
    var bp, bn = create_particle_block(0.0, 0.0, 0.5, 0.5, 0.02, 0.001);
    var ps: *PvFluidParticle = _pv_as_particles(bp);
    for (var i = 0; i < bn; i = i + 1) {
        var p: *PvFluidParticle = ps + i;
        var a: f64 = f64_from(i) * 0.1;
        var sv: f64 = _pv_sin(a);
        var cv: f64 = _pv_cos(a);
        p.density = 1000.0;
        p.velocity = PvVec3_new(sv, cv, 0.0);
        var t: f64 = 293.15 + f64_from(i % 11);
        if (hot == 1) { t = 600.0 + f64_from(i % 11); }
        p.temperature = t;
        p.fuel = 0.5;
        p.acceleration = PvVec3_new(0.0, -9.81, 0.0);
    }
    return bp;
}

# Every pair of the n particles at ps within h (itself included), in index order: (offsets, indices, index count).
fn _bench_brute(ps: *PvFluidParticle, n, h: f64) {
    var off = fl_alloc((n + 1) * 8);
    var idx = fl_alloc(n * n * 8 + 8);
    var m = 0;
    store64(off, 0);
    for (var i = 0; i < n; i = i + 1) {
        var pi: *PvFluidParticle = ps + i;
        for (var j = 0; j < n; j = j + 1) {
            var pj: *PvFluidParticle = ps + j;
            var d: f64 = pi.distance_to(pj);
            if (d <= h) {
                store64(idx + m * 8, j);
                m = m + 1;
            }
        }
        store64(off + (i + 1) * 8, m);
    }
    return (off, idx, m);
}

# One listed part d row: `iters` calls of function `which` (0 viscoelastic, 1 heat, 2 delta-SPH, 3 implicit viscosity,
# 4 the gradient corrections) on a fresh copy of the block.
fn _bench_d_listed(name, which, iters) {
    var bp = _bench_d_block(0);
    var ps: *PvFluidParticle = _pv_as_particles(bp);
    var off, idx, m = _bench_brute(ps, 625, 0.05);
    var ve: PvViscoelasticConfig = PvViscoelasticConfig_new(100.0, 0.05);
    var hc: PvHeatConfig = PvHeatConfig_new(0.01);
    var b = bench_new(name);
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        if (which == 0) { g_sink = g_sink ^ update_viscoelastic(ps, 625, off, 626, idx, m, 0.05, &ve, 0.001); }
        if (which == 1) { g_sink = g_sink ^ update_heat(ps, 625, off, 626, idx, m, 0.05, &hc, 0.001); }
        if (which == 2) { g_sink = g_sink ^ apply_delta_sph(ps, 625, off, 626, idx, m, 0.05, 10.0, 0.1, 0.001); }
        if (which == 3) { g_sink = g_sink ^ apply_implicit_viscosity(ps, 625, off, 626, idx, m, 0.05, 0.5, 0.01, 5); }
        if (which == 4) {
            var cp, cn = compute_gradient_corrections(ps, 625, off, 626, idx, m, 0.05);
            g_sink = g_sink ^ load64(cp + (312 * 9 + 4) * 8);
            fl_free(cp);
        }
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    fl_free(off);
    fl_free(idx);
    fl_free(bp);
    return 0;
}

# One per-particle part d row: `iters` calls of function `which` (0 phase change, 1 combustion, 2 reaction through a
# `dyn`, 3 contact angle, 4 generate secondaries) on a fresh copy of the block (hot for 1 and 2).
fn _bench_d_each(name, which, iters) {
    var hot = 0;
    if (which == 1 || which == 2) { hot = 1; }
    var bp = _bench_d_block(hot);
    var ps: *PvFluidParticle = _pv_as_particles(bp);
    var pc: PvPhaseChangeConfig = PvPhaseChangeConfig_water_ice(0, 1);
    var cc: PvCombustionConfig = PvCombustionConfig_default();
    var water: PvFluidConfig = PvFluidConfig_water_2d();
    var quarter: f64 = PV_F64_PI * 0.25;
    var b = bench_new(name);
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        if (which == 0) { update_phase_change(ps, 625, &pc, 0.001); }
        if (which == 1) { update_combustion(ps, 625, &cc, 0.001); }
        if (which == 2) { update_reaction(ps, 625, &cc, 0.001); }
        if (which == 3) { apply_contact_angle(ps, 625, &water, quarter, 0.07); }
        if (which == 4) {
            var sp, sn = generate_secondary_particles(ps, 625, 0.5, 2.0);
            g_sink = g_sink ^ sn;
            fl_free(sp);
        }
        g_sink = g_sink ^ _pv_bits(ps.fuel);
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    fl_free(bp);
    return 0;
}

# The part d benches (M4 part d): the bench_sph_d.rs twins, and the two criterion groups part c missed.
fn bench_sph_d() {
    _bench_d_listed("sph_d/viscoelastic_625", 0, 200);
    _bench_d_listed("sph_d/heat_625", 1, 500);
    _bench_d_listed("sph_d/delta_sph_625", 2, 500);
    _bench_d_listed("sph_d/implicit_viscosity_625", 3, 100);
    _bench_d_listed("sph_d/gradient_corrections_625", 4, 200);
    var m[72];
    var out[72];
    var mv[9];
    store64(&m, _pv_bits(2.0));
    store64(&m + 8, _pv_bits(0.5));
    store64(&m + 16, _pv_bits(0.1));
    store64(&m + 24, _pv_bits(0.3));
    store64(&m + 32, _pv_bits(3.0));
    store64(&m + 40, _pv_bits(0.7));
    store64(&m + 48, _pv_bits(0.2));
    store64(&m + 56, _pv_bits(0.4));
    store64(&m + 64, _pv_bits(5.0));
    var bi = bench_new("sph_d/invert_3x3");
    bench_batch_start(bi);
    for (var k = 0; k < 200000; k = k + 1) {
        g_sink = g_sink ^ _pv_invert_3x3(&m, &out);
        g_sink = g_sink ^ load64(&out + 32);
    }
    bench_batch_stop(bi, 200000);
    bench_report(bi);
    _bench_d_each("sph_d/phase_change_625", 0, 20000);
    _bench_d_each("sph_d/combustion_625", 1, 20000);
    _bench_d_each("sph_d/reaction_625", 2, 20000);
    _bench_d_each("sph_d/contact_angle_625", 3, 20000);
    _bench_d_each("sph_d/generate_secondary_625", 4, 20000);
    var gp = _bench_d_block(0);
    var ss, sn = generate_secondary_particles(_pv_as_particles(gp), 625, 0.5, 2.0);
    var sv: *PvSecondaryParticle = _pv_as_secondaries(ss);
    for (var j = 0; j < sn; j = j + 1) {
        var q: *PvSecondaryParticle = sv + j;
        q.lifetime = 1000000000.0;
    }
    var grav: PvVec3 = PvVec3_new(0.0, -9.81, 0.0);
    var bu = bench_new("sph_d/update_secondary_625");
    bench_batch_start(bu);
    for (var k2 = 0; k2 < 20000; k2 = k2 + 1) { g_sink = g_sink ^ update_secondary_particles(sv, sn, grav, 0.001); }
    bench_batch_stop(bu, 20000);
    bench_report(bu);
    fl_free(ss);
    fl_free(gp);
    # Rust's criterion `sph_viscosity_force/625_particles` and `create_particle_block/<n>_particles`.
    var vp = _bench_d_block(0);
    var vps: *PvFluidParticle = _pv_as_particles(vp);
    var bv = bench_new("sph_viscosity_force/625_particles");
    bench_batch_start(bv);
    for (var k3 = 0; k3 < 20000; k3 = k3 + 1) {
        var vf: PvVec3 = viscosity_force(0, vps, 625, 0.05, 0.001);
        g_sink = g_sink ^ _pv_bits(vf.x);
    }
    bench_batch_stop(bv, 20000);
    bench_report(bv);
    fl_free(vp);
    _bench_block_n(100, 20000);
    _bench_block_n(500, 5000);
    _bench_block_n(1000, 2000);
    return 0;
}

# One `create_particle_block/<n>_particles` row: a unit block at spacing 1/√n, freed per call.
fn _bench_block_n(n, iters) {
    var nf: f64 = f64_from(n);
    var rt: f64 = f64_sqrt(nf);
    var sp: f64 = 1.0 / rt;
    var b = bench_new(_bench_name_n("create_particle_block/", n, "_particles"));
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        var bp, bn = create_particle_block(0.0, 0.0, 1.0, 1.0, sp, 0.001);
        g_sink = g_sink ^ bn;
        fl_free(bp);
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    return 0;
}

# ── sph, M5 part a ──
# solver_step/<count>_particles and solver_step_st/<count>_particles: Rust's criterion groups (one solver; the block
# at (0.1, 0.3), size 0.5, spacing 1/√n, copied in before each step; water_2d at water's viscosity; σ 0.072 for _st).
# sph_m5a/*: against scripts/probes/rust/src/bin/bench_sph_m5a.rs, a dense 25 × 25 block at spacing 0.02.

# One solver row: `iters` steps of one solver (σ, Verlet as given) on a fresh copy of the block (origin (ox, oy), size
# 0.5, spacing sp) before each, named by `name` or, for 0, by the criterion group and the count.
fn _bench_solver(name, group, sp: f64, ox: f64, oy: f64, st: f64, verlet, iters) {
    var bp, bn = create_particle_block(ox, oy, 0.5, 0.5, sp, 0.001);
    var src: *PvFluidParticle = _pv_as_particles(bp);
    var work: *PvFluidParticle = _pv_as_particles(fl_alloc(bn * sizeof(PvFluidParticle)));
    var cfg: PvFluidConfig = PvFluidConfig_water_2d();
    var mu: f64 = PV_FLUID_MATERIAL_WATER_VISCOSITY;
    var s: PvSphSolver = PvSphSolver_with_surface_tension(st);
    s.use_verlet = verlet;
    var label = name;
    if (name == 0) { label = _bench_name_n(group, bn, "_particles"); }
    var b = bench_new(label);
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        for (var c = 0; c < bn; c = c + 1) {
            var d: *PvFluidParticle = work + c;
            var e: *PvFluidParticle = src + c;
            *d = *e;
        }
        var t, v = s.step(work, bn, &cfg, mu);
        g_sink = g_sink ^ t;
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    PvSphSolver_drop(&s);
    fl_free(work);
    fl_free(bp);
    return 0;
}

# The spacing 1/√n of Rust's criterion blocks.
fn _bench_inv_sqrt(n): f64 {
    var nf: f64 = f64_from(n);
    var rt: f64 = f64_sqrt(nf);
    var sp: f64 = 1.0 / rt;
    return sp;
}

# The M5 part a benches: Rust's criterion `solver_step` and `solver_step_st`, and the bench_sph_m5a.rs twins.
fn bench_sph_m5a() {
    var ns[40];
    store64(&ns, 25);
    store64(&ns + 8, 100);
    store64(&ns + 16, 225);
    store64(&ns + 24, 625);
    store64(&ns + 32, 1000);
    for (var i = 0; i < 5; i = i + 1) {
        var n = load64(&ns + i * 8);
        _bench_solver(0, "solver_step/", _bench_inv_sqrt(n), 0.1, 0.3, 0.0, 0, 2000);
    }
    for (var j = 1; j < 4; j = j + 1) {
        var n2 = load64(&ns + j * 8);
        _bench_solver(0, "solver_step_st/", _bench_inv_sqrt(n2), 0.1, 0.3, 0.072, 0, 2000);
    }
    _bench_solver("sph_m5a/dense_625", 0, 0.02, 0.1, 0.1, 0.0, 0, 100);
    _bench_solver("sph_m5a/dense_625_st", 0, 0.02, 0.1, 0.1, 0.072, 0, 100);
    _bench_solver("sph_m5a/dense_625_verlet", 0, 0.02, 0.1, 0.1, 0.0, 1, 100);
    return 0;
}

# ── sph, M5 part b ──
# pcisph_step/<count>_particles: Rust's criterion group (the solver_step blocks, at most 5 iterations to 1%).
# sph_m5b/*: against scripts/probes/rust/src/bin/bench_sph_m5b.rs, the dense 25 × 25 block at spacing 0.02.

# One PCISPH row: `iters` PCISPH steps of one solver on a fresh copy of the block before each, as `_bench_solver`.
fn _bench_pcisph(name, group, sp: f64, ox: f64, oy: f64, max_err: f64, iters) {
    var bp, bn = create_particle_block(ox, oy, 0.5, 0.5, sp, 0.001);
    var src: *PvFluidParticle = _pv_as_particles(bp);
    var work: *PvFluidParticle = _pv_as_particles(fl_alloc(bn * sizeof(PvFluidParticle)));
    var cfg: PvFluidConfig = PvFluidConfig_water_2d();
    var mu: f64 = PV_FLUID_MATERIAL_WATER_VISCOSITY;
    var s: PvSphSolver = PvSphSolver_new();
    var label = name;
    if (name == 0) { label = _bench_name_n(group, bn, "_particles"); }
    var b = bench_new(label);
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        for (var c = 0; c < bn; c = c + 1) {
            var d: *PvFluidParticle = work + c;
            var e: *PvFluidParticle = src + c;
            *d = *e;
        }
        var t, v = s.step_pcisph(work, bn, &cfg, mu, 5, max_err);
        g_sink = g_sink ^ t;
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    PvSphSolver_drop(&s);
    fl_free(work);
    fl_free(bp);
    return 0;
}

# The M5 part b benches: Rust's criterion `pcisph_step` and the bench_sph_m5b.rs twins.
fn bench_sph_m5b() {
    var ns[24];
    store64(&ns, 25);
    store64(&ns + 8, 100);
    store64(&ns + 16, 225);
    for (var i = 0; i < 3; i = i + 1) {
        var n = load64(&ns + i * 8);
        _bench_pcisph(0, "pcisph_step/", _bench_inv_sqrt(n), 0.1, 0.3, 0.01, 2000);
    }
    _bench_pcisph("sph_m5b/pcisph_dense_625", 0, 0.02, 0.1, 0.1, 0.01, 50);
    _bench_pcisph("sph_m5b/pcisph_dense_625_5it", 0, 0.02, 0.1, 0.1, 0.0, 50);
    return 0;
}

# ── sph, M5 part c ──
# sph_m5c/*: against scripts/probes/rust/src/bin/bench_sph_m5c.rs (bodies in its header): DFSPH on the solver_step
# bench's 64-particle block and on the dense 625-particle block, at most 3 rounds of each solver.

# One DFSPH row: `iters` DFSPH steps of one solver on a fresh copy of the block (origin (ox, oy), size 0.5, spacing
# sp) before each.
fn _bench_dfsph(name, sp: f64, ox: f64, oy: f64, max_err: f64, iters) {
    var bp, bn = create_particle_block(ox, oy, 0.5, 0.5, sp, 0.001);
    var src: *PvFluidParticle = _pv_as_particles(bp);
    var work: *PvFluidParticle = _pv_as_particles(fl_alloc(bn * sizeof(PvFluidParticle)));
    var cfg: PvFluidConfig = PvFluidConfig_water_2d();
    var mu: f64 = PV_FLUID_MATERIAL_WATER_VISCOSITY;
    var s: PvSphSolver = PvSphSolver_new();
    var b = bench_new(name);
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        for (var c = 0; c < bn; c = c + 1) {
            var d: *PvFluidParticle = work + c;
            var e: *PvFluidParticle = src + c;
            *d = *e;
        }
        var t, v = s.step_dfsph(work, bn, &cfg, mu, 3, max_err);
        g_sink = g_sink ^ t;
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    PvSphSolver_drop(&s);
    fl_free(work);
    fl_free(bp);
    return 0;
}

# The M5 part c benches: the bench_sph_m5c.rs twins.
fn bench_sph_m5c() {
    var third: f64 = 1.0 / 15.0;
    _bench_dfsph("sph_m5c/dfsph_sparse_64", third, 0.1, 0.3, 0.01, 2000);
    _bench_dfsph("sph_m5c/dfsph_dense_625", 0.02, 0.1, 0.1, 0.01, 50);
    _bench_dfsph("sph_m5c/dfsph_dense_625_3it", 0.02, 0.1, 0.1, 0.0, 50);
    return 0;
}

# sph_m5d/*: against scripts/probes/rust/src/bin/bench_sph_m5d.rs (bodies in its header): the multiphase step on the
# dense 25 × 25 block at spacing 0.02, one solver, the block copied in before each step. `two` = 1 puts the particles
# above y = 0.35 in phase 1.
fn _bench_multiphase(name, mp: *PvMultiPhaseConfig, two, st: f64) {
    var bp, bn = create_particle_block(0.1, 0.1, 0.5, 0.5, 0.02, 0.001);
    var src: *PvFluidParticle = _pv_as_particles(bp);
    if (two == 1) {
        for (var i = 0; i < bn; i = i + 1) {
            var q: *PvFluidParticle = src + i;
            if (q.position.y > 0.35) { q.phase = 1; }
        }
    }
    var work: *PvFluidParticle = _pv_as_particles(fl_alloc(bn * sizeof(PvFluidParticle)));
    var cfg: PvFluidConfig = PvFluidConfig_water_2d();
    var s: PvSphSolver = PvSphSolver_with_surface_tension(st);
    var b = bench_new(name);
    bench_batch_start(b);
    for (var k = 0; k < 100; k = k + 1) {
        for (var c = 0; c < bn; c = c + 1) {
            var d: *PvFluidParticle = work + c;
            var e: *PvFluidParticle = src + c;
            *d = *e;
        }
        var t, v = s.step_multiphase(work, bn, &cfg, mp);
        g_sink = g_sink ^ t;
    }
    bench_batch_stop(b, 100);
    bench_report(b);
    PvSphSolver_drop(&s);
    fl_free(work);
    fl_free(bp);
    return 0;
}

# The M5 part d benches: the bench_sph_m5d.rs twins.
fn bench_sph_m5d() {
    var cfg: PvFluidConfig = PvFluidConfig_water_2d();
    var mu: f64 = PV_FLUID_MATERIAL_WATER_VISCOSITY;
    var one: PvMultiPhaseConfig = PvMultiPhaseConfig_single(cfg.rest_density, cfg.gas_constant, mu);
    var water: PvPhaseProperties;
    water.rest_density = cfg.rest_density;
    water.gas_constant = cfg.gas_constant;
    water.viscosity = mu;
    var light: PvPhaseProperties;
    light.rest_density = 800.0;
    light.gas_constant = 2000.0;
    light.viscosity = 0.002;
    var two: PvMultiPhaseConfig = PvMultiPhaseConfig_two_phase(water, light, 0.05);
    _bench_multiphase("sph_m5d/multiphase_one_625", &one, 0, 0.0);
    _bench_multiphase("sph_m5d/multiphase_two_625", &two, 1, 0.0);
    _bench_multiphase("sph_m5d/multiphase_two_625_st", &two, 1, 0.072);
    PvMultiPhaseConfig_drop(&one);
    PvMultiPhaseConfig_drop(&two);
    return 0;
}

# sph_m5e/*: against scripts/probes/rust/src/bin/bench_sph_m5e.rs (bodies in its header), built with `parallel`: the
# solver's three `parallel` loops at T threads. One solver (σ 0.072) at T, after a first step that starts its pool;
# the block copied in before each step. kind 0 `step`, 1 `step_multiphase` on the two-phase layer of `bench_sph_m5d`.
fn _bench_sph_threads(name, sp: f64, kind, threads, iters, mp: *PvMultiPhaseConfig) {
    var bp, bn = create_particle_block(0.1, 0.1, 0.5, 0.5, sp, 0.001);
    var src: *PvFluidParticle = _pv_as_particles(bp);
    if (kind == 1) {
        for (var i = 0; i < bn; i = i + 1) {
            var q: *PvFluidParticle = src + i;
            if (q.position.y > 0.35) { q.phase = 1; }
        }
    }
    var work: *PvFluidParticle = _pv_as_particles(fl_alloc(bn * sizeof(PvFluidParticle)));
    var cfg: PvFluidConfig = PvFluidConfig_water_2d();
    var mu: f64 = PV_FLUID_MATERIAL_WATER_VISCOSITY;
    var s: PvSphSolver = PvSphSolver_with_surface_tension(0.072);
    var set = s.set_threads(threads);
    var label = _bench_name_n(name, threads, "");
    var b = bench_new(label);
    for (var k = 0; k <= iters; k = k + 1) {
        if (k == 1) { bench_batch_start(b); }
        for (var c = 0; c < bn; c = c + 1) {
            var d: *PvFluidParticle = work + c;
            var e: *PvFluidParticle = src + c;
            *d = *e;
        }
        if (kind == 0) {
            var t, v = s.step(work, bn, &cfg, mu);
            g_sink = g_sink ^ t;
        } else {
            var t2, v2 = s.step_multiphase(work, bn, &cfg, mp);
            g_sink = g_sink ^ t2;
        }
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    PvSphSolver_drop(&s);
    fl_free(work);
    fl_free(bp);
    return 0;
}

# The M5 part e benches: the bench_sph_m5e.rs twins at T = 1, 2, 4 and 8.
fn bench_sph_m5e() {
    var cfg: PvFluidConfig = PvFluidConfig_water_2d();
    var water: PvPhaseProperties;
    water.rest_density = cfg.rest_density;
    water.gas_constant = cfg.gas_constant;
    water.viscosity = PV_FLUID_MATERIAL_WATER_VISCOSITY;
    var light: PvPhaseProperties;
    light.rest_density = 800.0;
    light.gas_constant = 2000.0;
    light.viscosity = 0.002;
    var two: PvMultiPhaseConfig = PvMultiPhaseConfig_two_phase(water, light, 0.05);
    for (var k = 0; k < 4; k = k + 1) {
        var t = 1;
        if (k == 1) { t = 2; }
        if (k == 2) { t = 4; }
        if (k == 3) { t = 8; }
        _bench_sph_threads("sph_m5e/step_625_t", 0.02, 0, t, 100, &two);
        _bench_sph_threads("sph_m5e/multiphase_625_t", 0.02, 1, t, 100, &two);
        _bench_sph_threads("sph_m5e/step_2500_t", 0.01, 0, t, 20, &two);
    }
    PvMultiPhaseConfig_drop(&two);
    return 0;
}

# A typed view of a word.
#must_use
fn _bench_handles(p): *PvArenaHandle {
    return p;
}

# ── coupling (M6 part a) ──
# Rust's criterion groups on the same inputs: `coupling_sph_bodies/<n>_particles` (the 0.5 block at (0.1, 0.1),
# spacing 0.02, about a sphere of 0.1 at (0.3, 0.3) and a box of half-extents 0.05 at (0.5, 0.3); h 0.05, k 1000,
# c 10), `particle_level_set/<g>x<g>_<n>_particles` (the 0.5 block at (0.1, 0.1), spacing 0.5/√n, onto a g × g grid at
# dx 0.1, radius 0.05, for (32, 100), (64, 500) and (32, 1000)) and `drag_from_particles/<n>_particles` (the
# coupling block about the sphere moving at (1, 0, 0); ρ 1000, C_d 0.47, sample radius 0.15). Criterion's
# `iter_batched` clones the coupling's particles and bodies outside the timing; here the calls repeat on the same
# ones, whose work doesn't depend on the accelerations they accumulate. coupling_a/*: against
# scripts/probes/rust/src/bin/bench_coupling_a.rs (bodies in its header).

# A body at (x, y, 0) of the given shape and mass 1, moving at (vx, 0, 0), into the body array at bs + k.
fn _bench_body(bs, k, x: f64, y: f64, sh: PvShape, vx: f64) {
    var b: PvRigidBody = PvRigidBody_new(PvVec3_new(x, y, 0.0), 1.0, sh);
    b.velocity = PvVec3_new(vx, 0.0, 0.0);
    memcpy(bs + k * sizeof(PvRigidBody), &b, sizeof(PvRigidBody));
    return 0;
}

# One `particle_level_set` row: `iters` fills of a g × g grid from the 0.5 block at spacing 0.5/√n.
fn _bench_level_set(g, n, iters) {
    var nf: f64 = f64_from(n);
    var rt: f64 = f64_sqrt(nf);
    var sp: f64 = 0.5 / rt;
    var bp, bn = create_particle_block(0.1, 0.1, 0.5, 0.5, sp, 0.001);
    var ls = fl_alloc(g * g * 8);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "particle_level_set/");
    str_builder_add_int(sb, g);
    str_builder_add_cstr(sb, "x");
    str_builder_add_int(sb, g);
    str_builder_add_cstr(sb, "_");
    str_builder_add_int(sb, bn);
    str_builder_add_cstr(sb, "_particles");
    var s = str_builder_build(sb);
    var name = alloc(str_len(s) + 1);
    memcpy(name, str_data(s), str_len(s));
    store8(name + str_len(s), 0);
    var b = bench_new(name);
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        g_sink = g_sink ^ particle_level_set(ls, g * g, g, g, 0.1, _pv_as_particles(bp), bn, 0.05);
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    fl_free(ls);
    fl_free(bp);
    return 0;
}

# The coupling rows: the three criterion groups, then the twins.
fn bench_coupling_a() {
    var bp, bn = create_particle_block(0.1, 0.1, 0.5, 0.5, 0.02, 0.001);
    var ps: *PvFluidParticle = _pv_as_particles(bp);
    var bodies = fl_alloc(2 * sizeof(PvRigidBody));
    _bench_body(bodies, 0, 0.3, 0.3, PvShape_sphere(0.1), 0.0);
    _bench_body(bodies, 1, 0.5, 0.3, PvShape_box(0.05, 0.05, 0.05), 0.0);
    var bs: *PvRigidBody = _pv_as_bodies(bodies);
    var b = bench_new(_bench_name_n("coupling_sph_bodies/", bn, "_particles"));
    bench_batch_start(b);
    for (var k = 0; k < 2000; k = k + 1) {
        couple_sph_bodies(ps, bn, bs, 2, 0.05, 1000.0, 10.0);
    }
    bench_batch_stop(b, 2000);
    bench_report(b);
    _bench_level_set(32, 100, 200);
    _bench_level_set(64, 500, 20);
    _bench_level_set(32, 1000, 20);
    _bench_body(bodies, 0, 0.3, 0.3, PvShape_sphere(0.1), 1.0);
    var b2 = bench_new(_bench_name_n("drag_from_particles/", bn, "_particles"));
    bench_batch_start(b2);
    for (var k2 = 0; k2 < 20000; k2 = k2 + 1) {
        var d: PvVec3 = drag_from_particles(bs, ps, bn, 1000.0, 0.47, 0.15);
        g_sink = g_sink ^ _pv_bits(d.x);
    }
    bench_batch_stop(b2, 20000);
    bench_report(b2);
    # The twins: the cells-only grid's build and the indexed drag, on this block and a unit block at 0.01.
    var up, un = create_particle_block(0.0, 0.0, 1.0, 1.0, 0.01, 0.001);
    var ub = fl_alloc(sizeof(PvRigidBody));
    _bench_body(ub, 0, 0.5, 0.5, PvShape_sphere(0.1), 1.0);
    var grid: PvNeighborGrid;
    PvNeighborGrid_init(&grid);
    for (var c = 0; c < 2; c = c + 1) {
        var cp = bp;
        var cn = bn;
        var body = bodies;
        var iters = 2000;
        if (c == 1) {
            cp = up;
            cn = un;
            body = ub;
            iters = 200;
        }
        var cs: *PvFluidParticle = _pv_as_particles(cp);
        var bh = bench_new(_bench_name_n("coupling_a/hash_build_", cn, ""));
        bench_batch_start(bh);
        for (var h = 0; h < iters / 4; h = h + 1) {
            var gt, gv = PvNeighborGrid_build(&grid, cs, cn, 0.05);
            g_sink = g_sink ^ gt;
        }
        bench_batch_stop(bh, iters / 4);
        bench_report(bh);
        var bi = bench_new(_bench_name_n("coupling_a/drag_indexed_", cn, ""));
        bench_batch_start(bi);
        for (var q = 0; q < iters * 4; q = q + 1) {
            var di: PvVec3 = drag_from_particles_indexed(_pv_as_bodies(body), cs, cn, &grid, 1000.0, 0.47, 0.15);
            g_sink = g_sink ^ _pv_bits(di.x);
        }
        bench_batch_stop(bi, iters * 4);
        bench_report(bi);
        if (cn > 1000) {
            var bb = bench_new(_bench_name_n("coupling_a/drag_brute_", cn, ""));
            bench_batch_start(bb);
            for (var r = 0; r < iters; r = r + 1) {
                var db: PvVec3 = drag_from_particles(_pv_as_bodies(body), cs, cn, 1000.0, 0.47, 0.15);
                g_sink = g_sink ^ _pv_bits(db.x);
            }
            bench_batch_stop(bb, iters);
            bench_report(bb);
        }
    }
    PvNeighborGrid_drop(&grid);
    fl_free(ub);
    fl_free(up);
    fl_free(bodies);
    fl_free(bp);
    return 0;
}

# ── coupling (M6 part b): the FLIP solver ──
# Rust's criterion group `flip_step/<n>_particles`: one 16 × 16 solver (dx 0.1, blend 0.95) kept across iterations, n
# particles on a √n-wide lattice from (0.3, 0.3) at spacing 1/√n, mass 0.001, one step under (0, −9.81, 0) at dt 0.01.
# Criterion's `iter_batched` clones the particles outside the timing; here each iteration copies them in by assignment
# (about 12 ns a particle). The kept solver warm-starts its pressure, so after the first iterations the Gauss–Seidel
# sweeps stop early in both.
fn _bench_flip(n, iters) {
    var nf: f64 = f64_from(n);
    var rt: f64 = f64_sqrt(nf);
    var side = f64_to(rt);
    var sp: f64 = 1.0 / rt;
    var src: *PvFluidParticle = _pv_as_particles(fl_alloc(n * sizeof(PvFluidParticle)));
    var work: *PvFluidParticle = _pv_as_particles(fl_alloc(n * sizeof(PvFluidParticle)));
    for (var i = 0; i < n; i = i + 1) {
        var cx: f64 = f64_from(i % side);
        var cy: f64 = f64_from(i / side);
        var x: f64 = 0.3 + cx * sp;
        var y: f64 = 0.3 + cy * sp;
        var q: PvFluidParticle = PvFluidParticle_new_2d(x, y, 0.001);
        var d: *PvFluidParticle = src + i;
        *d = q;
    }
    var s: PvFlipSolver;
    var nt, nv = PvFlipSolver_new(16, 16, 0.1, 0.95, &s);
    var g: PvVec3 = PvVec3_new(0.0, -9.81, 0.0);
    var b = bench_new(_bench_name_n("flip_step/", n, "_particles"));
    bench_batch_start(b);
    for (var k = 0; k < iters; k = k + 1) {
        for (var c = 0; c < n; c = c + 1) {
            var w: *PvFluidParticle = work + c;
            var e: *PvFluidParticle = src + c;
            *w = *e;
        }
        var t, v = s.step(work, n, g, 0.01);
        g_sink = g_sink ^ t;
    }
    bench_batch_stop(b, iters);
    bench_report(b);
    PvFlipSolver_drop(&s);
    fl_free(work);
    fl_free(src);
    return 0;
}

# The FLIP rows: criterion's three sizes.
fn bench_coupling_b() {
    _bench_flip(25, 2000);
    _bench_flip(100, 2000);
    _bench_flip(225, 2000);
    return 0;
}

# ── mpm (M6 part c) ──
# mpm_c/*: against scripts/probes/rust/src/bin/bench_mpm_c.rs (bodies in its header): one step of the plan's three
# scenes on a 16 × 16 solver (dx 0.05), the particles and MPM states copied in before each step.

# One `mpm_c` row: 100 steps of the block [x0, x1] × [y0, y1] at spacing 0.025 and density 1000, all of `law`.
fn _bench_mpm(name, x0: f64, x1: f64, y0: f64, y1: f64, law: PvConstitutiveLaw) {
    var sp: f64 = 0.025;
    var v0: f64 = sp * sp;
    var n = 0;
    var ps: *PvFluidParticle = _pv_as_particles(fl_alloc(200 * sizeof(PvFluidParticle)));
    var ms: *PvMpmParticle = _pv_as_mpm_particles(fl_alloc(200 * sizeof(PvMpmParticle)));
    var tol: f64 = 0.000000000001;
    var jy: f64 = 0.0;
    var yy: f64 = y0;
    while (yy <= y1 + tol) {
        var ix: f64 = 0.0;
        var xx: f64 = x0;
        while (xx <= x1 + tol) {
            var m: f64 = 1000.0 * v0;
            var q: PvFluidParticle = PvFluidParticle_new_2d(xx, yy, m);
            var d: *PvFluidParticle = ps + n;
            *d = q;
            var mq: PvMpmParticle = PvMpmParticle_new(law, v0);
            var e: *PvMpmParticle = ms + n;
            *e = mq;
            n = n + 1;
            ix = ix + 1.0;
            xx = x0 + ix * sp;
        }
        jy = jy + 1.0;
        yy = y0 + jy * sp;
    }
    var wp: *PvFluidParticle = _pv_as_particles(fl_alloc(n * sizeof(PvFluidParticle)));
    var wm: *PvMpmParticle = _pv_as_mpm_particles(fl_alloc(n * sizeof(PvMpmParticle)));
    var s: PvMpmSolver;
    var nt, nv = PvMpmSolver_new(16, 16, 0.05, &s);
    var g: PvVec3 = PvVec3_new(0.0, -9.81, 0.0);
    var b = bench_new(_bench_name_n(name, n, ""));
    bench_batch_start(b);
    for (var k = 0; k < 100; k = k + 1) {
        for (var c = 0; c < n; c = c + 1) {
            var a: *PvFluidParticle = wp + c;
            var a0: *PvFluidParticle = ps + c;
            *a = *a0;
            var w: *PvMpmParticle = wm + c;
            var w0: *PvMpmParticle = ms + c;
            *w = *w0;
        }
        var t, v = s.step(wp, n, wm, n, g, 0.001);
        g_sink = g_sink ^ t;
    }
    bench_batch_stop(b, 100);
    bench_report(b);
    PvMpmSolver_drop(&s);
    fl_free(wm);
    fl_free(wp);
    fl_free(ms);
    fl_free(ps);
    return 0;
}

# The MPM rows: the plan's three scenes.
fn bench_mpm_c() {
    _bench_mpm("mpm_c/elastic_", 0.3, 0.5, 0.45, 0.65, PvConstitutiveLaw_neo_hookean(10000.0, 0.3));
    _bench_mpm("mpm_c/sand_", 0.35, 0.45, 0.025, 0.4, PvConstitutiveLaw_drucker_prager(10000.0, 0.3, 30.0));
    _bench_mpm("mpm_c/fluid_", 0.05, 0.25, 0.025, 0.4, PvConstitutiveLaw_fluid(1000.0, 0.0));
    return 0;
}

# compute_a/*: against scripts/probes/rust/src/bin/bench_compute_a.rs (bodies in its header): the packing of 1,000
# particles, the closed-form derivatives, the autodiff gradient of the poly6 kernel, and an `SphKernelParams` read.

# m_compute.rs's catalogue function 2 (the poly6 kernel of r = x0 at h = x1) on hisab's tape.
fn _bench_ad2(t, v, n): i64 {
    var h2 = ad_mul(t, load64(v + 8), load64(v + 8));
    var r2 = ad_mul(t, load64(v), load64(v));
    var d = ad_sub(t, h2, r2);
    var d2 = ad_mul(t, d, d);
    var d3 = ad_mul(t, d2, d);
    var h3 = ad_mul(t, h2, load64(v + 8));
    var h6 = ad_mul(t, h3, h3);
    var h9 = ad_mul(t, h6, h3);
    var sf: f64 = 64.0;
    var den: f64 = sf * PV_F64_PI;
    var kv: f64 = 315.0 / den;
    var k = ad_const(t, kv);
    var c = ad_div(t, k, h9);
    return ad_mul(t, c, d3);
}

# The compute rows.
fn bench_compute_a() {
    var buf = fl_alloc(1000 * sizeof(PvFluidParticle));
    var ps: *PvFluidParticle = _pv_as_particles(buf);
    for (var i = 0; i < 1000; i = i + 1) {
        var x: f64 = f64_from(i % 10) * 0.01;
        var y: f64 = f64_from((i / 10) % 10) * 0.01;
        var z: f64 = f64_from(i / 100) * 0.01;
        var q: PvFluidParticle = PvFluidParticle_new(PvVec3_new(x, y, z), 0.001);
        q.velocity = PvVec3_new(0.1, -0.2, 0.3);
        var rho: f64 = 1000.0 + f64_from(i);
        var pr: f64 = 0.5 * f64_from(i);
        q.density = rho;
        q.pressure = pr;
        var d: *PvFluidParticle = ps + i;
        *d = q;
    }
    var soa: PvParticleSoa;
    var ok = PvParticleSoa_from_aos(&soa, ps, 1000);
    var pk: PvPackedParticles;
    var b = bench_new("compute_a/from_soa_1000");
    bench_batch_start(b);
    for (var k = 0; k < 2000; k = k + 1) {
        var r = PvPackedParticles_from_soa(&soa, &pk);
        g_sink = g_sink ^ pk.count ^ r;
        PvPackedParticles_drop(&pk);
    }
    bench_batch_stop(b, 2000);
    bench_report(b);

    var r0 = PvPackedParticles_from_soa(&soa, &pk);
    var dst: PvParticleSoa;
    var ok2 = PvParticleSoa_from_aos(&dst, ps, 1000);
    b = bench_new("compute_a/unpack_1000");
    bench_batch_start(b);
    for (var k = 0; k < 2000; k = k + 1) {
        pk.unpack_density_pressure(&dst);
        pk.unpack_velocity(&dst);
        pk.unpack_positions(&dst);
        g_sink = g_sink ^ dst.density.get(7);
    }
    bench_batch_stop(b, 2000);
    bench_report(b);
    PvPackedParticles_drop(&pk);
    PvParticleSoa_drop(&dst);
    PvParticleSoa_drop(&soa);
    fl_free(buf);
    g_sink = g_sink ^ ok ^ ok2 ^ r0;

    b = bench_new("compute_a/dpoly6_dr2");
    bench_batch_start(b);
    for (var k = 0; k < NS; k = k + 1) {
        var r2: f64 = f64_from(k % 1024) * 0.000001;
        var w: f64 = PvKernelDerivatives_dpoly6_dr2(r2, 0.04);
        g_sink = g_sink ^ _pv_bits(w);
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    b = bench_new("compute_a/dtait_drho");
    bench_batch_start(b);
    for (var k = 0; k < NS; k = k + 1) {
        var dk: f64 = f64_from(k % 1024) / 50.0;
        var rho2: f64 = 990.0 + dk;
        var w2: f64 = PvKernelDerivatives_dtait_drho(rho2, 1000.0, 1480.0, 7.0);
        g_sink = g_sink ^ _pv_bits(w2);
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    b = bench_new("compute_a/dwendland_c2_dr");
    bench_batch_start(b);
    for (var k = 0; k < NS; k = k + 1) {
        var rr: f64 = f64_from(k % 1024) * 0.0001;
        var w3: f64 = PvKernelDerivatives_dwendland_c2_dr(rr, 0.05);
        g_sink = g_sink ^ _pv_bits(w3);
    }
    bench_batch_stop(b, NS);
    bench_report(b);

    var xs[16];
    var a0: f64 = 0.02;
    var a1: f64 = 0.06;
    store64(&xs, _pv_bits(a0));
    store64(&xs + 8, _pv_bits(a1));
    b = bench_new("compute_a/autodiff_poly6");
    bench_batch_start(b);
    for (var k = 0; k < 200000; k = k + 1) {
        var gp, gn = PvKernelDerivatives_autodiff_gradient(&_bench_ad2, &xs, 2);
        g_sink = g_sink ^ load64(gp) ^ gn;
        fl_free(gp);
    }
    bench_batch_stop(b, 200000);
    bench_report(b);

    # serde_json's document for the parameters, and the same with dt on an f32 midpoint.
    var sbd = str_builder_new();
    str_builder_add_cstr(sbd, "{\"smoothing_radius\":0.05,\"rest_density\":1000.0,\"gas_constant\":2000.0,");
    str_builder_add_cstr(sbd, "\"viscosity\":0.001,\"gravity\":[0.0,-9.81,0.0],\"dt\":0.001,\"particle_count\":1000}");
    var docs = str_builder_build(sbd);
    var sbt = str_builder_new();
    str_builder_add_cstr(sbt, "{\"smoothing_radius\":0.05,\"rest_density\":1000.0,\"gas_constant\":2000.0,");
    str_builder_add_cstr(sbt, "\"viscosity\":0.001,\"gravity\":[0.0,-9.81,0.0],\"dt\":1.0000000596046448,");
    str_builder_add_cstr(sbt, "\"particle_count\":1000}");
    var ties = str_builder_build(sbt);
    var doc = str_data(docs);
    var tie = str_data(ties);
    var sp: PvSphKernelParams;
    var dl = str_len(docs);
    b = bench_new("compute_a/sph_params_read");
    bench_batch_start(b);
    for (var k = 0; k < 200000; k = k + 1) {
        var t1, v1 = PvSphKernelParams_from_json(doc, dl, &sp);
        g_sink = g_sink ^ t1 ^ sp.particle_count;
    }
    bench_batch_stop(b, 200000);
    bench_report(b);
    var tl = str_len(ties);
    b = bench_new("compute_a/sph_params_read_tie");
    bench_batch_start(b);
    for (var k = 0; k < 200000; k = k + 1) {
        var t2, v2 = PvSphKernelParams_from_json(tie, tl, &sp);
        g_sink = g_sink ^ t2 ^ sp.particle_count;
    }
    bench_batch_stop(b, 200000);
    bench_report(b);
    return 0;
}

# Runs every bench, after the timer's noop baseline.
fn main(): i64 {
    alloc_init();
    _bx = alloc(8192);
    _by = alloc(8192);
    var b = bench_new("noop");
    bench_batch_start(b);
    var i = 0;
    while (i < NS) { bench_noop(); i = i + 1; }
    bench_batch_stop(b, NS);
    bench_report(b);
    bench_math();
    bench_common();
    bench_m1b();
    bench_shallow();
    bench_grid();
    bench_grid_c();
    bench_m3d();
    bench_threads();
    bench_sph_a();
    bench_sph_b();
    bench_sph_c();
    bench_sph_d();
    bench_sph_m5a();
    bench_sph_m5b();
    bench_sph_m5c();
    bench_sph_m5d();
    bench_sph_m5e();
    bench_coupling_a();
    bench_coupling_b();
    bench_mpm_c();
    bench_compute_a();
    return 0;
}

var r = main();
sys_exit_group(r);
