# par.tcyr — the worker pool (src/par.cyr), the grid's thread count (M3 part e) and the SPH solver's (M5 part e).
# Cyrius-only: Rust's
# `parallel` feature is compile-time rayon, with no tests of its own (port plan D6, ADR 0002 #4).
#
# The pool's contract: `_pv_par_for` runs fp(ctx, a, b) over slices that cover [lo, hi) exactly once, on T distinct
# threads (the caller's first), allocates nothing per call, and returns when every slice is done. A pool of 0 runs
# the whole range on the caller. On this target (Linux, THREADS_CONCURRENT = CHAN_BLOCKING = 1) the pools are real.

include "tests/lib.cyr"

# Kernel: slot i += 1 and tid[i] = the running thread's id, for i in [a, b). ctx: the slot base, then the tid base.
fn mark(ctx, a, b) {
    var slots = load64(ctx);
    var tids = load64(ctx + 8);
    for (var i = a; i < b; i = i + 1) {
        store64(slots + i * 8, load64(slots + i * 8) + 1);
        store64(tids + i * 8, gettid());
    }
    return 0;
}

# The number of distinct words among the n at p (n is small).
fn distinct(p, n): i64 {
    var d = 0;
    for (var i = 0; i < n; i = i + 1) {
        var seen = 0;
        for (var j = 0; j < i; j = j + 1) {
            if (load64(p + j * 8) == load64(p + i * 8)) { seen = 1; }
        }
        if (seen == 0) { d = d + 1; }
    }
    return d;
}

# 1 when each of the n slots at p holds exactly `want`.
fn all_eq(p, n, want): i64 {
    for (var i = 0; i < n; i = i + 1) {
        if (load64(p + i * 8) != want) { return 0; }
    }
    return 1;
}

# The error code of one grid step (PV_ERR_NONE when it was Ok).
fn step_err(g: *PvFluidGrid, c: *PvGridConfig): i64 {
    var t, e = g.step(c);
    if (is_err_result(t) == 1) { return e; }
    return PV_ERR_NONE;
}

# `steps` steps of a copy of the n particles at src by a fresh solver (σ 0.072) at `threads` threads, into dst:
# `step` (Verlet when verlet is 1), or `step_multiphase` by mp when mp isn't 0. The number that failed.
fn solver_steps(dst: *PvFluidParticle, src: *PvFluidParticle, n, threads, steps, verlet, mp): i64 {
    for (var i = 0; i < n; i = i + 1) {
        var d: *PvFluidParticle = dst + i;
        var e: *PvFluidParticle = src + i;
        *d = *e;
    }
    var cfg: PvFluidConfig = PvFluidConfig_water_2d();
    var s: PvSphSolver = PvSphSolver_with_surface_tension(0.072);
    s.use_verlet = verlet;
    var set = s.set_threads(threads);
    var errs = 0;
    for (var k = 0; k < steps; k = k + 1) {
        if (mp == 0) {
            var t, v = s.step(dst, n, &cfg, 0.001);
            if (is_err_result(t) == 1) { errs = errs + 1; }
        } else {
            var t2, v2 = s.step_multiphase(dst, n, &cfg, _pv_as_mp(mp));
            if (is_err_result(t2) == 1) { errs = errs + 1; }
        }
    }
    PvSphSolver_drop(&s);
    return errs;
}

# 1 when the n particles at a and b are the same words.
fn same_words(a: *PvFluidParticle, b: *PvFluidParticle, n): i64 {
    var wa = _pv_addr(a);
    var wb = _pv_addr(b);
    for (var i = 0; i < n * 18; i = i + 1) {
        if (load64(wa + i * 8) != load64(wb + i * 8)) { return 0; }
    }
    return 1;
}

# Runs the pool and thread-count tests.
fn main() {
    alloc_init();
    var n = 1000;
    var slots = alloc(n * 8);
    var tids = alloc(n * 8);
    var ctx[16];
    store64(&ctx, slots);
    store64(&ctx + 8, tids);

    test_group("pool_none_below_two_threads");
    assert_eq(_pv_pool_new(1), 0, "1 thread: no pool (serial)");
    assert_eq(_pv_pool_new(0), 0, "0: no pool");
    assert_eq(_pv_pool_new(0 - 3), 0, "negative: no pool");
    for (var i = 0; i < n; i = i + 1) { store64(slots + i * 8, 0); }
    _pv_par_for(0, 0, n, &mark, &ctx);
    assert_eq(all_eq(slots, n, 1), 1, "a pool of 0 runs the whole range once");
    assert_eq(distinct(tids, n), 1, "on the calling thread");

    test_group("pool_covers_the_range_once_on_t_threads");
    var counts[40];
    store64(&counts, 2);
    store64(&counts + 8, 3);
    store64(&counts + 16, 4);
    store64(&counts + 24, 8);
    store64(&counts + 32, 16);
    for (var c = 0; c < 5; c = c + 1) {
        var t = load64(&counts + c * 8);
        var p = _pv_pool_new(t);
        assert(p != 0, "a pool starts");
        for (var i2 = 0; i2 < n; i2 = i2 + 1) { store64(slots + i2 * 8, 0); }
        _pv_par_for(p, 0, n, &mark, &ctx);
        assert_eq(all_eq(slots, n, 1), 1, "every index exactly once");
        assert_eq(distinct(tids, n), t, "on T distinct threads");
        _pv_pool_drop(p);
    }

    test_group("pool_short_and_empty_ranges");
    var p8 = _pv_pool_new(8);
    for (var i3 = 0; i3 < n; i3 = i3 + 1) { store64(slots + i3 * 8, 0); }
    _pv_par_for(p8, 10, 13, &mark, &ctx);
    assert(load64(slots + 10 * 8) == 1 && load64(slots + 11 * 8) == 1 && load64(slots + 12 * 8) == 1,
      "3 indices on 8 threads: each once");
    assert(load64(slots + 9 * 8) == 0 && load64(slots + 13 * 8) == 0, "nothing outside [10, 13)");
    _pv_par_for(p8, 20, 20, &mark, &ctx);
    _pv_par_for(p8, 30, 25, &mark, &ctx);
    assert_eq(load64(slots + 20 * 8) + load64(slots + 25 * 8), 0, "an empty or inverted range runs nothing");

    test_group("pool_reused_without_allocating");
    for (var i4 = 0; i4 < n; i4 = i4 + 1) { store64(slots + i4 * 8, 0); }
    var before = alloc_used();
    for (var r = 0; r < 500; r = r + 1) { _pv_par_for(p8, 0, n, &mark, &ctx); }
    var after = alloc_used();
    assert_eq(after - before, 0, "500 calls take no heap");
    assert_eq(all_eq(slots, n, 500), 1, "and each index ran in every one");
    _pv_pool_drop(p8);
    _pv_pool_drop(0);

    test_group("grid_thread_count_lifecycle");
    var g: PvFluidGrid;
    var tn, en = PvFluidGrid_new(10, 10, 0.1, &g);
    assert_eq(g.threads, 1, "new: one thread");
    assert_eq(g.pool, 0, "and no pool");
    assert_eq(g.set_threads(4), 4, "set_threads(4)");
    assert_eq(g.pool, 0, "the pool starts with the next step");
    var cfg: PvGridConfig = PvGridConfig_smoke();
    cfg.boundary = PV_BOUNDARY_CONDITION_PERIODIC;
    assert_eq(step_err(&g, &cfg), PV_ERR_NONE, "a step at 4 threads");
    assert(g.pool != 0 && g.threads == 4, "it started a pool of 4");
    var h: PvFluidGrid;
    assert_eq(PvFluidGrid_clone(&h, &g), 1, "clone");
    assert(h.threads == 4 && h.pool == 0, "a clone keeps the count, not the pool");
    assert_eq(g.set_threads(0), 1, "a count below 1 is 1");
    assert(g.pool == 0 && g.threads == 1, "and stops the pool");
    assert_eq(step_err(&g, &cfg), PV_ERR_NONE, "a serial step");
    assert_eq(step_err(&h, &cfg), PV_ERR_NONE, "the clone's first step starts its own pool");
    assert(h.pool != 0, "it did");
    var same = 1;
    for (var i5 = 0; i5 < 100; i5 = i5 + 1) {
        if (load64(g.vx.data + i5 * 8) != load64(h.vx.data + i5 * 8)) { same = 0; }
        if (load64(g.density.data + i5 * 8) != load64(h.density.data + i5 * 8)) { same = 0; }
    }
    assert_eq(same, 1, "one thread and four give the same bits");
    PvFluidGrid_drop(&g);
    PvFluidGrid_drop(&h);
    assert_eq(h.pool, 0, "drop stops the pool");

    test_group("solver_thread_count_lifecycle");
    var bp, bn = create_particle_block(0.1, 0.1, 0.5, 0.5, 0.02, 0.001);
    var block: *PvFluidParticle = _pv_as_particles(bp);
    var wp = fl_alloc(bn * sizeof(PvFluidParticle));
    var work: *PvFluidParticle = _pv_as_particles(wp);
    for (var i6 = 0; i6 < bn; i6 = i6 + 1) {
        var d: *PvFluidParticle = work + i6;
        var e: *PvFluidParticle = block + i6;
        *d = *e;
    }
    var scfg: PvFluidConfig = PvFluidConfig_water_2d();
    var s: PvSphSolver = PvSphSolver_new();
    assert(s.threads == 1 && s.pool == 0, "new: one thread, no pool");
    assert_eq(s.set_threads(4), 4, "set_threads(4)");
    assert_eq(s.pool, 0, "the pool starts with the next step");
    var t1, v1 = s.step(work, bn, &scfg, 0.001);
    assert(is_ok(t1) == 1 && s.pool != 0 && s.threads == 4, "a step at 4 threads started a pool of 4");
    var used = alloc_used();
    for (var r2 = 0; r2 < 20; r2 = r2 + 1) { var t2, v2 = s.step(work, bn, &scfg, 0.001); }
    assert_eq(alloc_used() - used, 0, "20 more steps at 4 threads take no heap");
    assert_eq(s.set_threads(0), 1, "a count below 1 is 1");
    assert(s.pool == 0 && s.threads == 1, "and stops the pool");
    var t3 = s.set_threads(3);
    var t4, v4 = s.step(work, bn, &scfg, 0.001);
    PvSphSolver_drop(&s);
    assert(s.pool == 0 && s.threads == 3, "drop stops the pool and keeps the count");

    test_group("solver_threads_give_serial_bits");
    var ap = fl_alloc(bn * sizeof(PvFluidParticle));
    var a: *PvFluidParticle = _pv_as_particles(ap);
    var two: PvMultiPhaseConfig = _pv_mp_empty(0.05);
    var water: PvPhaseProperties;
    water.rest_density = 1000.0;
    water.gas_constant = 2000.0;
    water.viscosity = 0.001;
    var light: PvPhaseProperties;
    light.rest_density = 800.0;
    light.gas_constant = 2000.0;
    light.viscosity = 0.002;
    assert(two.push_phase(water) == 1 && two.push_phase(light) == 1, "two phases");
    for (var i7 = 0; i7 < bn; i7 = i7 + 1) {
        var q: *PvFluidParticle = block + i7;
        if (q.position.y > 0.35) { q.phase = 1; }
    }
    var tcounts[40];
    store64(&tcounts, 2);
    store64(&tcounts + 8, 3);
    store64(&tcounts + 16, 4);
    store64(&tcounts + 24, 8);
    store64(&tcounts + 32, 16);
    var kinds = 0;
    for (var kind = 0; kind < 3; kind = kind + 1) {
        var verlet = 0;
        var mp = 0;
        if (kind == 1) { verlet = 1; }
        if (kind == 2) { mp = &two; }
        var e0 = solver_steps(work, block, bn, 1, 10, verlet, mp);
        var agree = 1;
        for (var ci = 0; ci < 5; ci = ci + 1) {
            var e1 = solver_steps(a, block, bn, load64(&tcounts + ci * 8), 10, verlet, mp);
            if (e0 != 0 || e1 != 0 || same_words(work, a, bn) == 0) { agree = 0; }
        }
        kinds = kinds + agree;
    }
    assert_eq(kinds, 3, "Euler, Verlet and multiphase: 2, 3, 4, 8 and 16 threads give one thread's bits");
    PvMultiPhaseConfig_drop(&two);
    fl_free(ap);
    fl_free(wp);
    fl_free(bp);
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
