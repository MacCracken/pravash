# integration.tcyr — the ported tests of rust-old/tests/integration.rs, as their modules land.
#
# M1 (part 4): the eleven that use only M1 modules. M2: the three shallow water tests (`.unwrap()` on `new` and
# `step` is an assertion that every call was Ok). M3 (parts a–b): the five grid tests, in `test_grid` (Rust's two
# grid sections, then grid_invalid_dx_rejected from its edge cases; `is_err()` is the `PV_ERR_*` code Rust's path
# returns), and serde_roundtrip_all_types, whose four types all read and write JSON now (serde_json is `to_json` /
# `Pv*_from_json`). M4 part c: the four free-function SPH tests, in `test_sph` (Rust's `sph::step` is `sph_step`,
# ADR 0002 #17; `.unwrap()` asserts every step was Ok). M5 part a: the five solver tests, in `test_solver`. M6 part a:
# the two coupling tests, in `test_coupling`. The rest arrive with their milestones:
# - the two FLIP tests: M6 part b.

include "tests/lib.cyr"

# 1 when |a − b| < tol.
fn near(a: f64, b: f64, tol: f64): i64 {
    var d: f64 = a - b;
    var ad: f64 = f64_abs(d);
    if (ad < tol) { return 1; }
    return 0;
}

var F64_EPS: f64 = 0.0000000000000002220446049250313;   # f64::EPSILON

# `steps` free SPH steps of the n particles at ps under water_2d at viscosity mu: the number that returned Err. With
# `ke` 1, also the largest total kinetic energy seen, and whether every one was finite.
fn sph_run(ps: *PvFluidParticle, n, steps, mu: f64, ke) {
    var cfg: PvFluidConfig = PvFluidConfig_water_2d();
    var errs = 0;
    var max_ke: f64 = 0.0;
    var finite = 1;
    for (var k = 0; k < steps; k = k + 1) {
        var t, v = sph_step(ps, n, &cfg, mu);
        if (is_err_result(t) == 1) { errs = errs + 1; }
        if (ke == 1) {
            var e: f64 = total_kinetic_energy(ps, n);
            if (_pv_is_finite(e) == 0) { finite = 0; }
            max_ke = _pv_max(max_ke, e);
        }
    }
    return (errs, _pv_bits(max_ke), finite);
}

# The four SPH tests of the free functions (M4 part c), in Rust's order.
fn test_sph() {
    var mu: f64 = PV_FLUID_MATERIAL_WATER_VISCOSITY;

    test_group("sph_dam_break_energy_bounded");
    var dp, dn = create_particle_block(0.1, 0.3, 0.2, 0.3, 0.02, 0.001);
    var d: *PvFluidParticle = _pv_as_particles(dp);
    var de, dk, df = sph_run(d, dn, 200, mu, 1);
    var max_ke: f64 = dk;
    assert_eq(de, 0, "200 steps, every one Ok");
    assert_eq(df, 1, "the kinetic energy stays finite");
    assert(max_ke < 1000000.0, "the kinetic energy stays bounded");
    fl_free(dp);

    test_group("sph_particles_stay_in_bounds");
    var bp, bn = create_particle_block(0.1, 0.5, 0.3, 0.3, 0.02, 0.001);
    var b: *PvFluidParticle = _pv_as_particles(bp);
    var be, bk, bf = sph_run(b, bn, 500, mu, 0);
    assert_eq(be, 0, "500 steps, every one Ok");
    var out = 0;
    for (var i = 0; i < bn; i = i + 1) {
        var p: *PvFluidParticle = b + i;
        var x: f64 = p.position.x;
        var y: f64 = p.position.y;
        if (x >= 0.0 && x <= 1.0 && y >= 0.0 && y <= 1.0) {} else { out = out + 1; }
    }
    assert_eq(out, 0, "every particle inside [0, 1]²");
    fl_free(bp);

    test_group("sph_config_validation_catches_bad_params");
    var cfg: PvFluidConfig = PvFluidConfig_water_2d();
    cfg.dt = 0.0;
    var vp, vn = create_particle_block(0.1, 0.1, 0.1, 0.1, 0.05, 0.001);
    var vt, vv = sph_step(_pv_as_particles(vp), vn, &cfg, 0.001);
    assert_eq(is_err_result(vt), 1, "dt = 0 is refused");
    fl_free(vp);

    test_group("sph_single_particle_gravity");
    var one: PvFluidParticle = PvFluidParticle_new_2d(0.5, 0.8, 0.01);
    one.density = 1000.0;
    var y0: f64 = one.position.y;
    var oe, ok, of = sph_run(&one, 1, 10, 0.001, 0);
    assert(oe == 0 && one.position.y < y0, "it falls under gravity");
    return 0;
}

# `steps` solver steps of the n particles at ps under cfg at viscosity mu by *s: the number that returned Err; with
# `ke` 1 also the largest total kinetic energy (as bits) and whether every one was finite.
fn solver_steps(s: *PvSphSolver, ps: *PvFluidParticle, n, steps, cfg: *PvFluidConfig, mu: f64, ke) {
    var errs = 0;
    var max_ke: f64 = 0.0;
    var finite = 1;
    for (var k = 0; k < steps; k = k + 1) {
        var t, v = s.step(ps, n, cfg, mu);
        if (is_err_result(t) == 1) { errs = errs + 1; }
        if (ke == 1) {
            var e: f64 = total_kinetic_energy(ps, n);
            if (_pv_is_finite(e) == 0) { finite = 0; }
            max_ke = _pv_max(max_ke, e);
        }
    }
    return (errs, _pv_bits(max_ke), finite);
}

# 1 when every position of the n particles at ps is finite.
fn positions_ok(ps: *PvFluidParticle, n): i64 {
    for (var i = 0; i < n; i = i + 1) {
        var p: *PvFluidParticle = ps + i;
        if (_pv_is_finite(p.position.x) == 0 || _pv_is_finite(p.position.y) == 0) { return 0; }
    }
    return 1;
}

# The five solver tests (M5 part a), in Rust's order.
fn test_solver() {
    var cfg: PvFluidConfig = PvFluidConfig_water_2d();
    var mu: f64 = PV_FLUID_MATERIAL_WATER_VISCOSITY;

    test_group("solver_dam_break_energy_bounded");
    var dp, dn = create_particle_block(0.1, 0.3, 0.2, 0.3, 0.02, 0.001);
    var d: *PvFluidParticle = _pv_as_particles(dp);
    var s1: PvSphSolver = PvSphSolver_new();
    var de, dk, df = solver_steps(&s1, d, dn, 200, &cfg, mu, 1);
    var max_ke: f64 = dk;
    assert(de == 0 && df == 1, "200 steps, every one Ok, the energy finite");
    assert(max_ke < 1000000.0, "the kinetic energy stays bounded");
    PvSphSolver_drop(&s1);
    fl_free(dp);

    test_group("solver_particles_stay_in_bounds");
    var bp, bn = create_particle_block(0.1, 0.5, 0.3, 0.3, 0.02, 0.001);
    var b: *PvFluidParticle = _pv_as_particles(bp);
    var s2: PvSphSolver = PvSphSolver_new();
    var be, bk, bf = solver_steps(&s2, b, bn, 500, &cfg, mu, 0);
    assert_eq(be, 0, "500 steps, every one Ok");
    var out = 0;
    for (var i = 0; i < bn; i = i + 1) {
        var p: *PvFluidParticle = b + i;
        var x: f64 = p.position.x;
        var y: f64 = p.position.y;
        if (x >= 0.0 && x <= 1.0 && y >= 0.0 && y <= 1.0) {} else { out = out + 1; }
    }
    assert_eq(out, 0, "every particle inside [0, 1]²");
    PvSphSolver_drop(&s2);
    fl_free(bp);

    test_group("solver_surface_tension_keeps_blob_compact");
    var np, nn = create_particle_block(0.3, 0.3, 0.2, 0.2, 0.02, 0.001);
    var tp, tn = create_particle_block(0.3, 0.3, 0.2, 0.2, 0.02, 0.001);
    var no_st: *PvFluidParticle = _pv_as_particles(np);
    var with_st: *PvFluidParticle = _pv_as_particles(tp);
    var s3: PvSphSolver = PvSphSolver_new();
    var s4: PvSphSolver = PvSphSolver_with_surface_tension(0.072);
    var ne, nk, nf = solver_steps(&s3, no_st, nn, 50, &cfg, mu, 0);
    var te, tk, tf = solver_steps(&s4, with_st, tn, 50, &cfg, mu, 0);
    var spread: f64 = 0.0;
    for (var j = 0; j < nn; j = j + 1) {
        var q: *PvFluidParticle = no_st + j;
        var sq: f64 = q.speed_squared();
        spread = spread + sq;
    }
    assert(ne == 0 && te == 0 && _pv_is_finite(spread) == 1, "both runs Ok, the spread finite");
    assert_eq(positions_ok(with_st, tn), 1, "with surface tension every position stays finite");
    PvSphSolver_drop(&s3);
    PvSphSolver_drop(&s4);
    fl_free(np);
    fl_free(tp);

    test_group("solver_multi_step_consistency");
    var mp, mn = create_particle_block(0.2, 0.5, 0.3, 0.3, 0.03, 0.001);
    var m: *PvFluidParticle = _pv_as_particles(mp);
    var s5: PvSphSolver = PvSphSolver_new();
    var bad = 0;
    for (var k = 0; k < 1000; k = k + 1) {
        var t, v = s5.step(m, mn, &cfg, 0.001);
        if (is_err_result(t) == 1) { bad = bad + 1; }
        if (k % 100 == 0 && positions_ok(m, mn) == 0) { bad = bad + 1; }
    }
    assert_eq(bad, 0, "1,000 steps, every one Ok and finite");
    PvSphSolver_drop(&s5);
    fl_free(mp);

    test_group("solver_symmetric_pressure_conserves_momentum");
    var zg: PvFluidConfig = PvFluidConfig_water_2d();
    zg.gravity = PvVec3_zero();
    var pp, pn = create_particle_block(0.4, 0.4, 0.2, 0.2, 0.02, 0.001);
    var ps: *PvFluidParticle = _pv_as_particles(pp);
    var s6: PvSphSolver = PvSphSolver_new();
    var pe, pk, pf = solver_steps(&s6, ps, pn, 1, &zg, 0.001, 0);
    var px: f64 = 0.0;
    var py: f64 = 0.0;
    for (var c = 0; c < pn; c = c + 1) {
        var w: *PvFluidParticle = ps + c;
        px = px + (w.velocity.x * w.mass);
        py = py + (w.velocity.y * w.mass);
    }
    var apx: f64 = f64_abs(px);
    var apy: f64 = f64_abs(py);
    assert(pe == 0 && apx < 0.00000001 && apy < 0.00000001, "the net momentum stays near 0");
    PvSphSolver_drop(&s6);
    fl_free(pp);
    return 0;
}

# The error code of `PvFluidGrid_new` (PV_ERR_NONE when it built: *g then holds storage to drop).
fn grid_new_err(g: *PvFluidGrid, nx, ny, dx: f64): i64 {
    var t, e = PvFluidGrid_new(nx, ny, dx, g);
    if (is_err_result(t) == 1) { return e; }
    return PV_ERR_NONE;
}

# n steps by config c: the number that returned Err (each is Rust's `step(&config).unwrap()`).
fn grid_steps(g: *PvFluidGrid, c: *PvGridConfig, n): i64 {
    var bad = 0;
    for (var k = 0; k < n; k = k + 1) {
        var t, e = g.step(c);
        if (is_err_result(t) == 1) { bad = bad + 1; }
    }
    return bad;
}

# 1 when each of the n f64 words at p is finite (Rust's `for v in &g.vx { assert!(v.is_finite()) }`).
fn all_finite(p, n): i64 {
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = load64(p + i * 8);
        if (_pv_is_finite(x) == 0) { return 0; }
    }
    return 1;
}

# Σ of the n f64 words at p in index order, folded from −0 as Rust's `f64::sum` is.
fn fsum(p, n): f64 {
    var s: f64 = 0x8000000000000000;
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = load64(p + i * 8);
        s = s + x;
    }
    return s;
}

# The grid tests (M3 parts a–b), in Rust's order; grid_invalid_dx_rejected, from the edge-case section, closes them.
fn test_grid() {
    var g: PvFluidGrid;
    var c: PvGridConfig = PvGridConfig_smoke();

    test_group("grid_diffusion_conserves_total");
    var nx = 20;
    var ny = 20;
    var n = nx * ny;
    var field = alloc(n * 8);
    for (var i = 0; i < n; i = i + 1) { store64(field + i * 8, 0); }
    var peak: f64 = 100.0;
    store64(field + (nx * 10 + 10) * 8, _pv_bits(peak));
    var total_before: f64 = fsum(field, n);
    assert_eq(PvFluidGrid_diffuse(field, n, nx, ny, 0.1, 0.01, 0.1, 50), 1, "diffused");
    var total_after: f64 = fsum(field, n);
    var dt: f64 = total_after - total_before;
    var adt: f64 = f64_abs(dt);
    var ab: f64 = f64_abs(total_before);
    var rel: f64 = adt / ab;
    assert(rel < 0.5, "diffusion keeps the total within the same order of magnitude");

    test_group("grid_large_grid_creation");
    assert_eq(grid_new_err(&g, 256, 256, 0.01), PV_ERR_NONE, "new");
    assert_eq(g.cell_count(), 256 * 256, "256 × 256 cells");
    var ms0: f64 = g.max_speed();
    var ams0: f64 = f64_abs(ms0);
    assert(ams0 < F64_EPS, "a new grid is still");
    PvFluidGrid_drop(&g);

    test_group("grid_navier_stokes_smoke_rises");
    assert_eq(grid_new_err(&g, 30, 30, 0.1), PV_ERR_NONE, "new");
    for (var x = 12; x < 18; x = x + 1) {
        var j = 2 * 30 + x;
        g.density.set_f(j, 1.0);
        g.vy.set_f(j, 2.0);
    }
    var bad = 0;
    for (var k = 0; k < 50; k = k + 1) {
        for (var x2 = 12; x2 < 18; x2 = x2 + 1) { g.density.set_f(2 * 30 + x2, 1.0); }
        bad = bad + grid_steps(&g, &c, 1);
    }
    assert_eq(bad, 0, "50 steps");
    var ms1: f64 = g.max_speed();
    assert(ms1 > 0.01, "the plume moves");
    assert_eq(_pv_is_finite(ms1), 1, "the speed is finite");
    assert_eq(all_finite(g.vx.data, g.vx.len), 1, "every vx is finite");
    assert_eq(all_finite(g.vy.data, g.vy.len), 1, "every vy is finite");
    PvFluidGrid_drop(&g);

    test_group("grid_navier_stokes_stable_empty");
    assert_eq(grid_new_err(&g, 20, 20, 0.1), PV_ERR_NONE, "new");
    assert_eq(grid_steps(&g, &c, 100), 0, "100 steps");
    var ms2: f64 = g.max_speed();
    assert(ms2 < F64_EPS, "an empty grid stays at zero");
    PvFluidGrid_drop(&g);

    test_group("grid_invalid_dx_rejected");
    assert_eq(grid_new_err(&g, 10, 10, 0.0), PV_ERR_INVALID_PARAMETER, "dx = 0: InvalidParameter");
    assert_eq(grid_new_err(&g, 10, 10, -1.0), PV_ERR_INVALID_PARAMETER, "dx < 0: InvalidParameter");
    return 0;
}

# serde_roundtrip_all_types (Rust's cross-module section, after materials_have_consistent_physics): each type through
# its JSON and back.
fn test_serde_all_types() {
    test_group("serde_roundtrip_all_types");
    var config: PvFluidConfig = PvFluidConfig_water_2d();
    var sb1 = str_builder_new();
    assert_eq(config.to_json(sb1), 0, "FluidConfig written");
    var s1 = str_builder_build(sb1);
    var config2: PvFluidConfig;
    var t1, e1 = PvFluidConfig_from_json(str_data(s1), str_len(s1), &config2);
    assert_eq(is_err_result(t1), 0, "FluidConfig read back");
    assert(near(config2.dt, config.dt, F64_EPS) == 1, "FluidConfig: dt round-trips");

    var mat: PvFluidMaterial = PV_FLUID_MATERIAL_WATER;
    var sb2 = str_builder_new();
    assert_eq(mat.to_json(sb2), 0, "FluidMaterial written");
    var s2 = str_builder_build(sb2);
    var mat2: PvFluidMaterial;
    var t2, e2 = PvFluidMaterial_from_json(str_data(s2), str_len(s2), &mat2);
    assert_eq(is_err_result(t2), 0, "FluidMaterial read back");
    assert(near(mat2.density, mat.density, F64_EPS) == 1, "FluidMaterial: density round-trips");

    var grid: PvFluidGrid;
    var grid2: PvFluidGrid;
    assert_eq(grid_new_err(&grid, 5, 5, 0.1), PV_ERR_NONE, "FluidGrid new");
    var sb3 = str_builder_new();
    assert_eq(grid.to_json(sb3), 0, "FluidGrid written");
    var s3 = str_builder_build(sb3);
    var t3, e3 = PvFluidGrid_from_json(str_data(s3), str_len(s3), &grid2);
    assert_eq(is_err_result(t3), 0, "FluidGrid read back");
    if (is_err_result(t3) == 0) {
        assert_eq(grid2.nx, grid.nx, "FluidGrid: nx round-trips");
        PvFluidGrid_drop(&grid2);
    }
    PvFluidGrid_drop(&grid);

    var sw: PvShallowWater;
    var sw2: PvShallowWater;
    var t4, e4 = PvShallowWater_new(5, 5, 0.1, 1.0, &sw);
    assert_eq(is_err_result(t4), 0, "ShallowWater new");
    var sb4 = str_builder_new();
    assert_eq(sw.to_json(sb4), 0, "ShallowWater written");
    var s4 = str_builder_build(sb4);
    var t5, e5 = PvShallowWater_from_json(str_data(s4), str_len(s4), &sw2);
    assert_eq(is_err_result(t5), 0, "ShallowWater read back");
    if (is_err_result(t5) == 0) {
        assert_eq(sw2.nx, sw.nx, "ShallowWater: nx round-trips");
        PvShallowWater_drop(&sw2);
    }
    PvShallowWater_drop(&sw);
    return 0;
}

# 1 when the config fails validation.
fn invalid(c: PvFluidConfig): i64 {
    var t, e = c.validate();
    return is_err_result(t);
}

# 1 when `PvFluidMaterial_custom` refuses the properties.
fn custom_err(d: f64, v: f64, s: f64, c: f64): i64 {
    var m: PvFluidMaterial;
    var t, e = PvFluidMaterial_custom(d, v, s, c, &m);
    return is_err_result(t);
}

# n steps of dt: the number that returned Err (each is Rust's `step(dt).unwrap()`).
fn sw_steps(sw: *PvShallowWater, n, dt: f64): i64 {
    var bad = 0;
    for (var k = 0; k < n; k = k + 1) {
        var t, e = sw.step(dt);
        if (is_err_result(t) == 1) { bad = bad + 1; }
    }
    return bad;
}

# The shallow water tests (M2), in Rust's order (before the cross-module ones).
fn test_shallow() {
    var sw: PvShallowWater;

    test_group("shallow_wave_propagation");
    var t1, e1 = PvShallowWater_new(20, 20, 0.1, 1.0, &sw);
    assert_eq(is_err_result(t1), 0, "new");
    sw.add_disturbance(1.0, 1.0, 0.3, 0.5);
    var near_before: f64 = sw.surface_at(5, 5);
    assert_eq(sw_steps(&sw, 500, 0.001), 0, "500 steps");
    var near_after: f64 = sw.surface_at(5, 5);
    var dn: f64 = near_after - near_before;
    var adn: f64 = f64_abs(dn);
    assert(adn > 0.00000001, "the wave reaches (5, 5)");
    PvShallowWater_drop(&sw);

    test_group("shallow_volume_approximately_conserved");
    var t2, e2 = PvShallowWater_new(30, 30, 0.1, 1.0, &sw);
    assert_eq(is_err_result(t2), 0, "new");
    sw.add_disturbance(1.5, 1.5, 0.3, 0.2);
    var vol_before: f64 = sw.total_volume();
    assert_eq(sw_steps(&sw, 100, 0.001), 0, "100 steps");
    var vol_after: f64 = sw.total_volume();
    var dv: f64 = vol_after - vol_before;
    var adv: f64 = f64_abs(dv);
    var relative_change: f64 = adv / vol_before;
    assert(relative_change < 0.1, "the volume changes by under 10%");
    PvShallowWater_drop(&sw);

    test_group("shallow_flat_surface_stable");
    var t3, e3 = PvShallowWater_new(20, 20, 0.1, 1.0, &sw);
    assert_eq(is_err_result(t3), 0, "new");
    assert_eq(sw_steps(&sw, 1000, 0.001), 0, "1000 steps");
    var max_dev: f64 = sw.max_wave_height(1.0);
    assert(max_dev < 0.0000000001, "a flat surface doesn't drift");
    PvShallowWater_drop(&sw);
    return 0;
}

# M6 part a: the coupling tests. Rust's first couples a clone of the body (`&mut [body.clone()]`), so the body's own
# force stays zero and it falls under gravity alone while the particles feel it; the port couples a copy too.
fn test_coupling() {
    var cfg: PvFluidConfig = PvFluidConfig_water_2d();
    test_group("coupling_sphere_falls_through_fluid");
    var bp, bn = create_particle_block(0.2, 0.1, 0.6, 0.4, 0.03, 0.001);
    var ps: *PvFluidParticle = _pv_as_particles(bp);
    var s: PvSphSolver = PvSphSolver_new();
    var body: PvRigidBody = PvRigidBody_new(PvVec3_new(0.5, 0.7, 0.0), 0.1, PvShape_sphere(0.05));
    var y_start: f64 = body.position.y;
    var errs = 0;
    var copy: PvRigidBody;
    for (var k = 0; k < 50; k = k + 1) {
        var st, sv = s.step(ps, bn, &cfg, 0.001);
        if (is_err_result(st) == 1) { errs = errs + 1; }
        copy = body;
        couple_sph_bodies(ps, bn, &copy, 1, 0.05, 500.0, 5.0);
        integrate_bodies(&body, 1, cfg.gravity, cfg.dt);
    }
    assert_eq(errs, 0, "50 steps, every one Ok");
    assert(body.position.y < y_start && _pv_is_finite(body.position.y) == 1, "the body falls, and stays finite");
    PvSphSolver_drop(&s);
    fl_free(bp);

    test_group("coupling_body_receives_force");
    var one: PvFluidParticle = PvFluidParticle_new(PvVec3_new(0.55, 0.0, 0.0), 1.0);
    one.density = 1000.0;
    one.velocity = PvVec3_new(1.0, 0.0, 0.0);
    var b2: PvRigidBody = PvRigidBody_new(PvVec3_new(0.5, 0.0, 0.0), 10.0, PvShape_sphere(0.1));
    couple_sph_bodies(&one, 1, &b2, 1, 0.15, 1000.0, 10.0);
    var fm: f64 = b2.force.length();
    assert(fm > 0.0, "the body receives a force from the particle");
    return 0;
}

# Runs the ported integration tests.
fn main() {
    alloc_init();
    test_sph();
    test_grid();
    test_shallow();
    var pi: f64 = PV_F64_PI;
    var w: PvFluidMaterial = PV_FLUID_MATERIAL_WATER;
    var air: PvFluidMaterial = PV_FLUID_MATERIAL_AIR;
    var honey: PvFluidMaterial = PV_FLUID_MATERIAL_HONEY;

    test_group("materials_have_consistent_physics");
    var bad = 0;
    for (var k = 0; k < 5; k = k + 1) {
        var m: PvFluidMaterial = PV_FLUID_MATERIAL_WATER;
        if (k == 1) { m = PV_FLUID_MATERIAL_OIL; }
        if (k == 2) { m = PV_FLUID_MATERIAL_HONEY; }
        if (k == 3) { m = PV_FLUID_MATERIAL_AIR; }
        if (k == 4) { m = PV_FLUID_MATERIAL_LAVA; }
        var d: f64 = m.density;
        var v: f64 = m.viscosity;
        var c: f64 = m.speed_of_sound;
        if (d > 0.0 && v >= 0.0 && c > 0.0) {} else { bad = bad + 1; }
    }
    assert_eq(bad, 0, "every preset is physical");
    var ad: f64 = air.density;
    var wd: f64 = w.density;
    var wv: f64 = w.viscosity;
    var hv: f64 = honey.viscosity;
    var ac: f64 = air.speed_of_sound;
    var wc: f64 = w.speed_of_sound;
    assert(ad < wd && wv < hv && ac < wc, "air lighter than water, water thinner than honey, sound slower in air");

    test_serde_all_types();

    test_group("buoyancy_sphere_in_water");
    var r: f64 = 0.062;
    var vol: f64 = ((4.0 / 3.0) * pi) * ((r * r) * r);
    var fb: f64 = buoyancy_force(w.density, 9.81, vol);
    var weight: f64 = 1.0 * 9.81;
    assert(fb > weight * 0.9, "a 1 kg sphere of radius 0.062 m floats");

    test_group("buoyancy_terminal_velocity_validation");
    var sphere: f64 = PV_DRAG_COEFFICIENT_SPHERE;
    var t1, v1 = terminal_velocity(1.0, 9.81, 1.225, sphere, 0.01);
    var vt: f64 = v1;
    assert(is_err_result(t1) == 0 && vt > 0.0, "valid");
    var t2, v2 = terminal_velocity(1.0, 9.81, 0.0, sphere, 0.01);
    var t3, v3 = terminal_velocity(1.0, -9.81, 1.225, sphere, 0.01);
    assert(is_err_result(t2) == 1 && is_err_result(t3) == 1, "zero density and negative m·g refused");

    test_group("buoyancy_reynolds_flow_regime");
    var ts, vs = reynolds_number(w.density, 0.001, 0.01, w.viscosity);
    var tf, vf = reynolds_number(w.density, 10.0, 0.1, w.viscosity);
    var tz, vz = reynolds_number(w.density, 1.0, 0.1, 0.0);
    var res: f64 = vs;
    var ref: f64 = vf;
    assert_eq(classify_flow(res), PV_FLOW_REGIME_LAMINAR, "slow flow is laminar");
    assert_eq(classify_flow(ref), PV_FLOW_REGIME_TURBULENT, "fast flow is turbulent");
    assert_eq(is_err_result(tz), 1, "zero viscosity refused");

    test_group("vortex_lamb_oseen_decays");
    var early: f64 = lamb_oseen_velocity(1.0, 0.1, 0.01, 0.1);
    var late: f64 = lamb_oseen_velocity(1.0, 0.1, 0.01, 10.0);
    assert(_pv_is_finite(early) == 1 && _pv_is_finite(late) == 1, "finite early and late");

    test_group("vortex_rankine_vs_lamb_oseen_convergence");
    var vr: f64 = rankine_velocity(5.0, 100.0, 1.0);
    var vl: f64 = lamb_oseen_velocity(5.0, 100.0, 0.001, 1.0);
    var irr: f64 = 5.0 / ((2.0 * pi) * 100.0);
    assert(near(vr, irr, 0.000001) == 1 && near(vl, irr, 0.001) == 1, "both approach Γ/(2πr) far out");

    test_group("vortex_enstrophy_scales_with_dx");
    var field = alloc(800);
    var one: f64 = 1.0;
    for (var i = 0; i < 100; i = i + 1) { store64(field + i * 8, one); }
    var e1: f64 = enstrophy(field, 100, 0.1);
    var e2: f64 = enstrophy(field, 100, 0.2);
    var ratio: f64 = e2 / e1;
    assert(near(ratio, 4.0, 0.0000000001) == 1, "enstrophy scales as dx²");

    test_group("config_validation_comprehensive");
    var c: PvFluidConfig = PvFluidConfig_water_2d();
    assert_eq(invalid(c), 0, "valid");
    c.gas_constant = 0.0;
    assert_eq(invalid(c), 1, "k = 0");
    c = PvFluidConfig_water_2d();
    c.boundary_damping = 1.5;
    assert_eq(invalid(c), 1, "damping 1.5");
    c = PvFluidConfig_water_2d();
    c.boundary_damping = -0.1;
    assert_eq(invalid(c), 1, "damping -0.1");

    test_group("custom_material_speed_of_sound_validated");
    assert_eq(custom_err(1000.0, 0.001, 0.072, 0.0), 1, "c = 0");
    assert_eq(custom_err(1000.0, 0.001, 0.072, -1.0), 1, "c < 0");
    assert_eq(custom_err(1000.0, 0.001, 0.072, 1480.0), 0, "water's");

    test_group("particle_is_copy");
    var p: PvFluidParticle = PvFluidParticle_new_2d(1.0, 2.0, 0.01);
    var p2: PvFluidParticle = p;
    p2.mass = 5.0;
    assert(near(p.mass, 0.01, 0.0000000001) == 1, "a copy, not an alias");

    test_group("config_is_copy");
    var c1: PvFluidConfig = PvFluidConfig_water_2d();
    var c2: PvFluidConfig = c1;
    c2.dt = 1.0;
    assert(near(c1.dt, 0.001, 0.0000000001) == 1, "a copy, not an alias");
    test_solver();
    test_coupling();
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
