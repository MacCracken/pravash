# p0_semantics.cyr — M0 step 4: the Cyrius counterpart of every Rust f64 / f32 operation pravash 1.3.0 uses
# (port plan §7.1), probed on the pinned toolchain.
#
# Prints one line per probe: case <TAB> variant <TAB> type <TAB> bits (0x hex of the word). Its twin
# p0_semantics.rs prints Rust's value for each case, and p0_compare.py joins the two. Build and run:
#   cyrius build scripts/probes/p0_semantics.cyr build/p0_semantics && ./build/p0_semantics > build/p0_cyrius.tsv
# Types: f64 / f32 (bits compared by ulp), i32 / u32 / u64 (the word compared at that width).

# Write a C string to stdout.
fn put(s: cstring): i64 {
    print(s, strlen(s));
    return 0;
}

# One probe line: name, variant, type, the word's bits in hex.
fn show(name: cstring, variant: cstring, ty: cstring, bits): i64 {
    put(name);
    put("\t");
    put(variant);
    put("\t");
    put(ty);
    put("\t");
    fmt_hex0x(bits);
    println("");
    return 0;
}

# A saturating f64 → i32, as Rust's `as i32` (NaN → 0). Probed here; the port's helper lives in src/mathx.cyr.
fn sat_i32(x: f64): i64 {
    if (x != x) { return 0; }
    if (x >= 2147483647.0) { return 2147483647; }
    if (x <= -2147483648.0) { return 0 - 2147483648; }
    return f64_to(x);
}

# A saturating f64 → u64, as Rust's `as usize` on 64-bit (NaN and negatives → 0, ≥ 2^64 → u64::MAX).
fn sat_u64(x: f64): i64 {
    if (x != x) { return 0; }
    if (x <= 0.0) { return 0; }
    if (x >= 18446744073709551616.0) { return 0 - 1; }
    if (x >= 9223372036854775808.0) {
        var hi: f64 = x - 9223372036854775808.0;
        return f64_to(hi) | 0x8000000000000000;
    }
    return f64_to(x);
}

# A saturating f64 → u32, as Rust's `as u32` (NaN and negatives → 0, ≥ 2^32 → u32::MAX).
fn sat_u32(x: f64): i64 {
    if (x != x) { return 0; }
    if (x <= 0.0) { return 0; }
    if (x >= 4294967295.0) { return 4294967295; }
    return f64_to(x);
}

# The SPH cell key: floor(p_f32 · (1 / h_f32)) as i32, in f32 as `build_neighbors` computes it.
fn sph_key(p: f64, h: f64): i64 {
    var h32: f32 = f32_from(h);
    var one32: f32 = f32_from(1.0);
    var inv: f32 = one32 / h32;
    var p32: f32 = f32_from(p);
    var prod: f32 = p32 * inv;
    var w: f64 = f32_to(prod);
    var fl: f64 = f64_floor(w);
    return sat_i32(fl);
}

# exp through the builtin and the polyfill.
fn p_exp(name: cstring, x: f64): i64 {
    var a: f64 = f64_exp(x);
    show(name, "f64_exp", "f64", a);
    var b: f64 = _f64_exp_polyfill(x);
    show(name, "_f64_exp_polyfill", "f64", b);
    return 0;
}

# ln through the builtin and the polyfill.
fn p_ln(name: cstring, x: f64): i64 {
    var a: f64 = f64_ln(x);
    show(name, "f64_ln", "f64", a);
    var b: f64 = _f64_ln_polyfill(x);
    show(name, "_f64_ln_polyfill", "f64", b);
    return 0;
}

# log10 as ln / ln 10: neither the stdlib nor ganita has a log10.
fn p_log10(name: cstring, x: f64): i64 {
    var l: f64 = _f64_ln_polyfill(x);
    var ln10: f64 = F64_LN10;
    var r: f64 = l / ln10;
    show(name, "ln/LN10 (no log10 in the stdlib or ganita)", "f64", r);
    return 0;
}

# sin through the builtin and the polyfill, and cos.
fn p_sincos(sname: cstring, cname: cstring, x: f64): i64 {
    var a: f64 = f64_sin(x);
    show(sname, "f64_sin", "f64", a);
    var b: f64 = _f64_sin_polyfill(x);
    show(sname, "_f64_sin_polyfill", "f64", b);
    var c: f64 = f64_cos(x);
    show(cname, "f64_cos", "f64", c);
    return 0;
}

# The SPH cell key at h = 0.05.
fn p_key(name: cstring, p: f64): i64 {
    show(name, "f32 mul + f64_floor + sat_i32", "i32", sph_key(p, 0.05));
    return 0;
}

# floor(x) as usize, saturating and raw.
fn p_usize(name: cstring, x: f64): i64 {
    var fl: f64 = f64_floor(x);
    show(name, "sat_u64", "u64", sat_u64(fl));
    show(name, "f64_to (no saturation)", "u64", f64_to(fl));
    return 0;
}

fn main(): i64 {
    alloc_init();
    var nan: f64 = 0x7FF8000000000000;
    var inf: f64 = 0x7FF0000000000000;
    var r: f64 = 0.0;

    # min / max / clamp
    r = f64_min(nan, 1.0);
    show("min(nan,1)", "f64_min", "f64", r);
    r = f64_min(1.0, nan);
    show("min(1,nan)", "f64_min", "f64", r);
    r = f64_max(nan, 1.0);
    show("max(nan,1)", "f64_max", "f64", r);
    r = f64_max(1.0, nan);
    show("max(1,nan)", "f64_max", "f64", r);
    r = f64_min(0.0, -0.0);
    show("min(+0,-0)", "f64_min", "f64", r);
    r = f64_max(0.0, -0.0);
    show("max(+0,-0)", "f64_max", "f64", r);
    r = f64_clamp(nan, 0.0, 1.0);
    show("clamp(nan,0,1)", "f64_clamp", "f64", r);
    r = f64_clamp(2.0, 0.0, 1.0);
    show("clamp(2,0,1)", "f64_clamp", "f64", r);

    # rounding and exact ops
    r = f64_floor(-0.5);
    show("floor(-0.5)", "f64_floor", "f64", r);
    r = f64_floor(-0.0);
    show("floor(-0)", "f64_floor", "f64", r);
    r = f64_ceil(-0.5);
    show("ceil(-0.5)", "f64_ceil", "f64", r);
    r = f64_sqrt(2.0);
    show("sqrt(2)", "f64_sqrt", "f64", r);
    r = f64_abs(-0.0);
    show("abs(-0)", "f64_abs", "f64", r);

    # exp, ln, log10
    p_exp("exp(-0.7)", -0.7);
    p_exp("exp(1)", 1.0);
    p_exp("exp(5.3)", 5.3);
    p_ln("ln(0.3)", 0.3);
    p_ln("ln(2)", 2.0);
    p_ln("ln(10)", 10.0);
    p_log10("log10(0.25)", 0.25);
    p_log10("log10(3)", 3.0);

    # pow, atan2, hypot, cbrt (ganita)
    r = ganita_f64_pow(2.0, 0.5);
    show("pow(2,0.5)", "ganita_f64_pow", "f64", r);
    r = ganita_f64_pow(1.5, 2.3);
    show("pow(1.5,2.3)", "ganita_f64_pow", "f64", r);
    r = ganita_f64_pow(0.9, 0.333);
    show("pow(0.9,0.333)", "ganita_f64_pow", "f64", r);
    r = ganita_f64_atan2(1.0, -1.0);
    show("atan2(1,-1)", "ganita_f64_atan2", "f64", r);
    r = ganita_f64_atan2(0.3, 0.7);
    show("atan2(0.3,0.7)", "ganita_f64_atan2", "f64", r);
    r = ganita_f64_atan2(-2.0, -0.5);
    show("atan2(-2,-0.5)", "ganita_f64_atan2", "f64", r);
    r = ganita_f64_hypot(3.0, 4.0);
    show("hypot(3,4)", "ganita_f64_hypot", "f64", r);
    r = ganita_f64_hypot(0.001, 2.5);
    show("hypot(0.001,2.5)", "ganita_f64_hypot", "f64", r);
    r = ganita_f64_hypot(1.1, 2.2);
    show("hypot(1.1,2.2)", "ganita_f64_hypot", "f64", r);
    r = ganita_f64_cbrt(2.0);
    show("cbrt(2)", "ganita_f64_cbrt", "f64", r);
    r = ganita_f64_cbrt(0.001);
    show("cbrt(0.001)", "ganita_f64_cbrt", "f64", r);
    r = ganita_f64_cbrt(27.0);
    show("cbrt(27)", "ganita_f64_cbrt", "f64", r);

    # sin, cos
    p_sincos("sin(0.5)", "cos(0.5)", 0.5);
    p_sincos("sin(1)", "cos(1)", 1.0);
    p_sincos("sin(3)", "cos(3)", 3.0);

    # to_radians, powi
    var pi: f64 = F64_PI;
    var k: f64 = pi / 180.0;
    r = 30.0 * k;
    show("to_radians(30)", "x * (PI / 180)", "f64", r);
    show("PI", "F64_PI", "f64", pi);
    var b: f64 = 1.1;
    r = b * b;
    show("powi(1.1,2)", "x * x", "f64", r);
    var b2: f64 = b * b;
    var b4: f64 = b2 * b2;
    r = b4 * b4;
    show("powi(1.1,8)", "((x^2)^2)^2", "f64", r);

    # f32: rounding, the SPH cell key, saturation
    var f: f32 = f32_from(0.1);
    show("f32(0.1)", "f32_from", "f32", f);
    p_key("key(1.37)", 1.37);
    p_key("key(0.475)", 0.475);
    p_key("key(12345.678)", 12345.678);
    p_key("key(-0.0001)", -0.0001);
    p_key("key(1e10)", 10000000000.0);
    p_key("key(0.15)", 0.15);
    p_key("key(nan)", nan);
    var big: f64 = 10000000000.0;
    show("i32(1e10)", "f64_to (no saturation)", "i32", f64_to(big));

    # f64 → usize / u32 casts
    p_usize("usize(floor(-3.7))", -3.7);
    p_usize("usize(floor(7.9))", 7.9);
    p_usize("usize(1e29)", 100000000000000000000000000000.0);
    p_usize("usize(0)", 0.0);
    show("usize(nan)", "sat_u64", "u64", sat_u64(nan));
    show("usize(inf)", "sat_u64", "u64", sat_u64(inf));
    var m: f64 = 5000000000.0;
    show("u32(5e9)", "sat_u32", "u32", sat_u32(m));
    show("u32(5e9)", "f64_to (no saturation)", "u32", f64_to(m));
    return 0;
}

var rc = main();
sys_exit_group(rc);
