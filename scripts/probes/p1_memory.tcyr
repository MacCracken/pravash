# Probe 1 (port plan §4 step 9.1): what pravash's step path would cost the heap.
#
# The global `alloc` is a bump allocator with no free and no redirection hook, and hisab and ganita
# call it directly. A library must never `alloc_reset` (it wipes the consumer's heap too). So every
# library call that allocates, run once per step, leaks for the life of the process. This measures
# how much, for the calls pravash's step paths would make (SPH's neighbour-hash rebuild and queries,
# the DST pressure solve, the MLS 3×3 inverse, vector math, an autodiff gradient). It also checks
# the two allocators pravash can own instead: freelist (solver storage) and a growable arena reset
# every step (scratch).
#
# A .tcyr so the test-scoped hisab is in scope:  cyrius test scripts/probes/p1_memory.tcyr
# Adapted from impetus's scripts/probes/p1_memory.cyr.

fn put(s: cstring): i64 {
    print(s, strlen(s));
    return 0;
}

# One result line: name, then bytes of global heap per call that are never returned.
fn report(name: cstring, before, calls): i64 {
    var per = (alloc_used() - before) / calls;
    put(name);
    put(": ");
    fmt_int(per);
    println(" bytes of global heap per call, never returned");
    return 0;
}

fn main(): i64 {
    alloc_init();
    var n = 1000;
    var sink = 0;

    # Vector math: glam's DVec3 arithmetic through hisab.
    var a = hvec3_new(1.0, 2.0, 3.0);
    var b = hvec3_new(0.5, -1.0, 2.0);
    var before = alloc_used();
    for (var k = 0; k < n; k = k + 1) { sink = hvec3_add(a, b); }
    report("hvec3_add", before, n);

    # SPH's neighbour build, once per step: clear the hash, insert 1,000 particles, then query the
    # 27 cells around each one. hisab's hash is built once and reused, as SphSolver reuses its own.
    var np = 1000;
    var pts = alloc(np * 8);
    for (var i = 0; i < np; i = i + 1) {
        var fx: f64 = f64_from(i % 10) * 0.05;
        var fy: f64 = f64_from((i / 10) % 10) * 0.05;
        var fz: f64 = f64_from(i / 100) * 0.05;
        store64(pts + i * 8, hvec3_new(fx, fy, fz));
    }
    var sh = spatial_hash_new(0.05);
    var steps = 10;
    before = alloc_used();
    for (var s = 0; s < steps; s = s + 1) {
        spatial_hash_clear(sh);
        for (var i = 0; i < np; i = i + 1) { spatial_hash_insert(sh, load64(pts + i * 8), i); }
        for (var i = 0; i < np; i = i + 1) {
            for (var c = 0; c < 27; c = c + 1) { sink = spatial_hash_query_cell(sh, load64(pts + i * 8)); }
        }
    }
    report("spatial_hash rebuild + 27 cell queries per particle, per step of 1,000 particles", before, steps);

    # The DST pressure solve transforms every row and column of the interior: n = 62 for a 64² grid,
    # 126 for 128².
    var dn = 62;
    var row = alloc(dn * 8);
    for (var i = 0; i < dn; i = i + 1) { var v: f64 = f64_from(i) * 0.01; store64(row + i * 8, v); }
    before = alloc_used();
    for (var k = 0; k < n; k = k + 1) { var t, e = num_dst(row, dn); sink = t + e; }
    report("num_dst, n = 62", before, n);
    before = alloc_used();
    for (var k = 0; k < n; k = k + 1) { var t, e = num_idst(row, dn); sink = t + e; }
    report("num_idst, n = 62", before, n);
    var dn2 = 126;
    var row2 = alloc(dn2 * 8);
    for (var i = 0; i < dn2; i = i + 1) { var v: f64 = f64_from(i) * 0.01; store64(row2 + i * 8, v); }
    before = alloc_used();
    for (var k = 0; k < n; k = k + 1) { var t, e = num_dst(row2, dn2); sink = t + e; }
    report("num_dst, n = 126", before, n);

    # The MLS gradient correction inverts one 3×3 moment matrix per particle per step.
    var m = mat_new(3, 3);
    mat_set(m, 0, 0, 2.0);
    mat_set(m, 1, 1, 3.0);
    mat_set(m, 2, 2, 4.0);
    mat_set(m, 0, 1, 0.5);
    mat_set(m, 1, 0, 0.5);
    before = alloc_used();
    for (var k = 0; k < n; k = k + 1) { sink = mat_inv(m); }
    report("ganita mat_inv, 3x3", before, n);

    # An autodiff gradient (KernelDerivatives::autodiff_gradient): a tape made once, reset per
    # evaluation, ten operations, then the reverse pass.
    var tape = ad_tape_new(64);
    before = alloc_used();
    for (var k = 0; k < n; k = k + 1) {
        ad_tape_reset(tape);
        var x0 = ad_var(tape, 1.5);
        var x1 = ad_var(tape, 0.5);
        var p = ad_mul(tape, x0, x1);
        for (var j = 0; j < 8; j = j + 1) { p = ad_add(tape, p, ad_mul(tape, p, x1)); }
        var gt, gv = ad_grad(tape, p);
        sink = gt + gv;
    }
    report("ad_tape gradient (reset + 18 ops + ad_grad)", before, n);

    # The allocators pravash can own.
    fl_init();
    before = alloc_used();
    for (var k = 0; k < 100000; k = k + 1) { var q = fl_alloc(64); fl_free(q); }
    put("freelist, 100,000 alloc/free pairs of 64 B: the global heap grew by ");
    fmt_int(alloc_used() - before);
    println(" bytes");

    # SPH-sized step scratch: 10,000 particles × 30 candidate indices, in an arena reset every step.
    var arena = arena_new_growable(65536);
    var cap1 = 0;
    for (var s = 0; s < 300; s = s + 1) {
        arena_reset(arena);
        for (var i = 0; i < 10000; i = i + 1) {
            var lst = arena_alloc(arena, 30 * 8);
            store64(lst, i);
        }
        if (s == 0) { cap1 = arena_capacity_total(arena); }
    }
    put("step arena, 300 steps of 10,000 × 240 B: capacity after step 1 ");
    fmt_int(cap1);
    put(" bytes, after step 300 ");
    fmt_int(arena_capacity_total(arena));
    println(" bytes");
    return 0;
}

var rc = main();
sys_exit_group(rc);
