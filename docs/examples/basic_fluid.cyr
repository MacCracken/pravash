# pravash 2.0: Rust 1.3.0's `examples/basic_fluid.rs` in Cyrius. An SPH dam break: a block of 225 water particles
# stepped 100 times by the WCSPH solver, with the kinetic energy and the fastest particle every 10 frames. It prints
# what the Rust example prints (docs/examples/basic_fluid.out).
include "lib/pravash.cyr"

# Prints the text.
fn put(s) {
    print(s, strlen(s));
    return 0;
}

# Prints n right-aligned in `width` columns: Rust's `{:>width}`.
fn put_int(n, width) {
    var buf[24];
    var len = fmt_int_buf(n, &buf);
    for (var i = len; i < width; i = i + 1) { print(" ", 1); }
    print(&buf, len);
    return 0;
}

# Prints x with `decimals` places, right-aligned in `width` columns: Rust's `{:>width.decimals}`.
fn put_f64(x: f64, width, decimals) {
    var buf[64];
    var len = fmt_float_buf(x, &buf, decimals);
    for (var i = len; i < width; i = i + 1) { print(" ", 1); }
    print(&buf, len);
    return 0;
}

fn main(): i64 {
    alloc_init();
    var particles, n = create_particle_block(0.2, 0.5, 0.3, 0.3, 0.02, 0.001);
    var config: PvFluidConfig = PvFluidConfig_water_2d();
    var viscosity: f64 = PV_FLUID_MATERIAL_WATER.viscosity;
    var solver: PvSphSolver = PvSphSolver_new();

    println("Pravash — SPH fluid simulation (SphSolver with spatial hash)");
    put("Particles: ");
    put_int(n, 0);
    put("\nTimestep:  ");
    put_f64(config.dt, 0, 3);
    println(" s");
    println("");

    for (var frame = 0; frame < 100; frame = frame + 1) {
        # Rust's `.unwrap()`: stop on an Err (its code names the failure).
        var t, err = solver.step(particles, n, &config, viscosity);
        if (is_ok(t) == 0) { return 1; }
        if (frame % 10 == 0) {
            var ke: f64 = total_kinetic_energy(particles, n);
            var ms: f64 = max_speed(particles, n);
            put("Frame ");
            put_int(frame, 4);
            put("  KE: ");
            put_f64(ke, 10, 4);
            put("  max_speed: ");
            put_f64(ms, 8, 4);
            println("");
        }
    }

    println("");
    println("Done.");
    PvSphSolver_drop(&solver);
    fl_free(particles);
    return 0;
}

var r = main();
sys_exit_group(r);
